{
  "id": "apxium-active-matters",
  "title": "Active Matters (Demo)",
  "description": "Static demo of an Apxium (Practice Engine) Active Matters tile — sample jobs/matters ('Job' is Practice Engine's term for a matter or engagement) with status, pending a live connection. All data shown is illustrative, not from a real practice.",
  "category": "accounting",
  "tags": ["apxium", "practice engine", "matters", "jobs", "accounting-practice", "demo"],
  "keywords": ["matters", "jobs", "engagements", "practice management", "demo"],
  "connectorsUsed": ["apxium"],
  "sizing": {
    "preferred": { "colSpan": 4, "rowSpan": 5 },
    "min": { "colSpan": 3, "rowSpan": 4 },
    "max": { "colSpan": 6, "rowSpan": 8 }
  },
  "branding": { "color": "#1f6f54" },
  "spec": {
    "root": "card",
    "elements": {
      "card": { "type": "Card", "props": {}, "children": ["headerRow", "sub", "div0", "body", "div1", "footer"] },

      "headerRow": { "type": "Row", "props": { "justify": "between", "align": "center" }, "children": ["titleGroup"] },
      "titleGroup": { "type": "Row", "props": { "gap": "sm", "align": "center" }, "children": ["titleIcon", "titleStack"] },
      "titleIcon": { "type": "Icon", "props": { "name": "Briefcase", "tone": "brand", "size": "sm" } },
      "titleStack": { "type": "Stack", "props": { "gap": "none" }, "children": ["title", "eyebrow"] },
      "title": { "type": "Heading", "props": { "text": "Active Matters", "level": "h2" } },
      "eyebrow": { "type": "Eyebrow", "props": { "text": "5 shown · sample data" } },

      "sub": { "type": "Text", "props": { "text": "Open jobs across all clients", "size": "xs", "tone": "muted" } },
      "div0": { "type": "Divider", "props": {} },

      "body": { "type": "Body", "props": {}, "children": ["rows"] },
      "rows": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["r1", "rd1", "r2", "rd2", "r3", "rd3", "r4", "rd4", "r5"]
      },
      "rd1": { "type": "Divider", "props": {} },
      "rd2": { "type": "Divider", "props": {} },
      "rd3": { "type": "Divider", "props": {} },
      "rd4": { "type": "Divider", "props": {} },

      "r1": { "type": "Row", "props": { "gap": "sm", "align": "center" }, "children": ["r1Stack", "r1Badge"] },
      "r1Stack": { "type": "Stack", "props": { "gap": "none", "grow": true }, "children": ["r1Name", "r1Sub"] },
      "r1Name": { "type": "Text", "props": { "text": "FY26 Financial Statements", "size": "sm", "weight": "medium" } },
      "r1Sub": { "type": "Caption", "props": { "text": "Harbour Logistics Pty Ltd · Priya Nair" } },
      "r1Badge": { "type": "Badge", "props": { "text": "On Track", "tone": "success", "variant": "soft" } },

      "r2": { "type": "Row", "props": { "gap": "sm", "align": "center" }, "children": ["r2Stack", "r2Badge"] },
      "r2Stack": { "type": "Stack", "props": { "gap": "none", "grow": true }, "children": ["r2Name", "r2Sub"] },
      "r2Name": { "type": "Text", "props": { "text": "Trust Deed Variation", "size": "sm", "weight": "medium" } },
      "r2Sub": { "type": "Caption", "props": { "text": "Mercer Family Trust · Sarah Chen" } },
      "r2Badge": { "type": "Badge", "props": { "text": "At Risk", "tone": "warning", "variant": "soft" } },

      "r3": { "type": "Row", "props": { "gap": "sm", "align": "center" }, "children": ["r3Stack", "r3Badge"] },
      "r3Stack": { "type": "Stack", "props": { "gap": "none", "grow": true }, "children": ["r3Name", "r3Sub"] },
      "r3Name": { "type": "Text", "props": { "text": "Quarterly BAS Lodgement", "size": "sm", "weight": "medium" } },
      "r3Sub": { "type": "Caption", "props": { "text": "Okafor Civil Engineering · Ben Torres" } },
      "r3Badge": { "type": "Badge", "props": { "text": "Overdue", "tone": "destructive", "variant": "soft" } },

      "r4": { "type": "Row", "props": { "gap": "sm", "align": "center" }, "children": ["r4Stack", "r4Badge"] },
      "r4Stack": { "type": "Stack", "props": { "gap": "none", "grow": true }, "children": ["r4Name", "r4Sub"] },
      "r4Name": { "type": "Text", "props": { "text": "Shareholder Agreement Review", "size": "sm", "weight": "medium" } },
      "r4Sub": { "type": "Caption", "props": { "text": "Fenwick & Associates · Tom Blackwell" } },
      "r4Badge": { "type": "Badge", "props": { "text": "On Track", "tone": "success", "variant": "soft" } },

      "r5": { "type": "Row", "props": { "gap": "sm", "align": "center" }, "children": ["r5Stack", "r5Badge"] },
      "r5Stack": { "type": "Stack", "props": { "gap": "none", "grow": true }, "children": ["r5Name", "r5Sub"] },
      "r5Name": { "type": "Text", "props": { "text": "Annual Tax Return FY26", "size": "sm", "weight": "medium" } },
      "r5Sub": { "type": "Caption", "props": { "text": "Harbour Logistics Pty Ltd · Josh Whitfield" } },
      "r5Badge": { "type": "Badge", "props": { "text": "On Track", "tone": "success", "variant": "soft" } },

      "div1": { "type": "Divider", "props": {} },
      "footer": { "type": "Row", "props": { "gap": "xs", "align": "center" }, "children": ["footerIcon", "footerNote"] },
      "footerIcon": { "type": "Icon", "props": { "name": "Info", "tone": "muted", "size": "xs" } },
      "footerNote": { "type": "Text", "props": { "text": "Static demo data — will show live matters once Apxium is connected", "size": "xs", "tone": "muted" } }
    }
  },
  "status": "published"
}
