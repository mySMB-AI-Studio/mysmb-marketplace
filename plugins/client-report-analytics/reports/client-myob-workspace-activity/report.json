{
  "title": "MYOB Workspace User Activity",
  "description": "Client Report Analytics CRA-15 for one MYOB client: this client's WorkQ tasks and findings activity in mySMB Workspace; mostly empty until the checks engine (WL-00) ships findings. Live and validated on every open; mySMB branding by default.",
  "tags": [
    "client-report-analytics",
    "CRA-15",
    "myob",
    "workspace-activity"
  ],
  "fileName": "client-myob-workspace-activity.html",
  "dataBindings": {
    "inputs": [
      {
        "name": "from_date",
        "label": "From",
        "type": "date",
        "default": "2026-07-01"
      },
      {
        "name": "to_date",
        "label": "To",
        "type": "date",
        "default": "2026-09-30"
      },
      {
        "name": "company_file",
        "label": "Client (MYOB company file)",
        "type": "string",
        "maxLength": 64,
        "default": ""
      },
      {
        "name": "persona",
        "label": "View as",
        "type": "enum",
        "options": [
          "Client",
          "Bookkeeper",
          "Practitioner",
          "Executive"
        ],
        "default": "Bookkeeper"
      },
      {
        "name": "display",
        "label": "Display settings",
        "type": "string",
        "maxLength": 300,
        "default": "{\"cents\":0,\"k\":0,\"zeros\":1,\"neg\":\"paren\",\"red\":0,\"hdr\":1,\"ftr\":1,\"style\":\"mysmb\",\"dens\":\"100\",\"p\":\"this_quarter\",\"a\":\"custom\",\"c\":\"none\",\"v\":\"\"}"
      }
    ],
    "bindings": [
      {
        "id": "activity",
        "tool": {
          "mcp": "workspace",
          "name": "workq_activity"
        },
        "params": {
          "from": {
            "kind": "input",
            "input": "from_date"
          },
          "to": {
            "kind": "input",
            "input": "to_date"
          }
        }
      },
      {
        "id": "company_files",
        "tool": {
          "mcp": "myob-accounting",
          "name": "list_company_files"
        },
        "params": {}
      }
    ]
  }
}
