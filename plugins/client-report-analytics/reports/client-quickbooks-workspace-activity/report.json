{
  "title": "QuickBooks Workspace User Activity",
  "description": "Client Report Analytics CRA-15 for one QuickBooks client: this client's WorkQ tasks and findings activity in mySMB Workspace; mostly empty until the checks engine (WL-00) ships findings. Live and validated on every open; mySMB branding by default.",
  "tags": [
    "client-report-analytics",
    "CRA-15",
    "quickbooks",
    "workspace-activity"
  ],
  "fileName": "client-quickbooks-workspace-activity.html",
  "dataBindings": {
    "inputs": [
      {
        "name": "start_date",
        "label": "From",
        "type": "date",
        "default": "2026-07-01"
      },
      {
        "name": "end_date",
        "label": "To",
        "type": "date",
        "default": "2026-09-30"
      },
      {
        "name": "persona",
        "label": "View as",
        "type": "enum",
        "options": [
          "Client",
          "Bookkeeper",
          "Practitioner",
          "Executive"
        ],
        "default": "Practitioner"
      },
      {
        "name": "display",
        "label": "Display settings",
        "type": "string",
        "maxLength": 300,
        "default": "{\"cents\":0,\"k\":0,\"zeros\":1,\"neg\":\"paren\",\"red\":0,\"hdr\":1,\"ftr\":1,\"style\":\"mysmb\",\"dens\":\"100\",\"p\":\"this_quarter\",\"a\":\"custom\",\"c\":\"none\",\"v\":\"\",\"x\":\"\"}"
      }
    ],
    "bindings": [
      {
        "id": "activity",
        "tool": {
          "mcp": "workspace",
          "name": "workq_activity"
        },
        "params": {
          "from": {
            "kind": "input",
            "input": "start_date"
          },
          "to": {
            "kind": "input",
            "input": "end_date"
          }
        }
      },
      {
        "id": "company_info",
        "tool": {
          "mcp": "quickbooks-accounting",
          "name": "qbo_query"
        },
        "params": {
          "query": {
            "kind": "static",
            "value": "SELECT * FROM CompanyInfo"
          }
        }
      },
      {
        "id": "prefs",
        "tool": {
          "mcp": "quickbooks-accounting",
          "name": "get_preferences"
        },
        "params": {}
      }
    ]
  }
}
