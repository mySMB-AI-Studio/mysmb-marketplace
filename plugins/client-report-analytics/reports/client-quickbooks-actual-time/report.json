{
  "dataBindings": {
    "bindings": [
      {
        "id": "time_activities",
        "params": {
          "maxResults": {
            "kind": "static",
            "value": 1000
          },
          "where": {
            "input": "txn_where",
            "kind": "input"
          }
        },
        "tool": {
          "mcp": "quickbooks-accounting",
          "name": "list_time_activity"
        }
      },
      {
        "id": "company_info",
        "params": {
          "query": {
            "kind": "static",
            "value": "SELECT * FROM CompanyInfo"
          }
        },
        "tool": {
          "mcp": "quickbooks-accounting",
          "name": "qbo_query"
        }
      },
      {
        "id": "prefs",
        "params": {},
        "tool": {
          "mcp": "quickbooks-accounting",
          "name": "get_preferences"
        }
      }
    ],
    "inputs": [
      {
        "default": "2026-07-01",
        "label": "From",
        "name": "start_date",
        "type": "date"
      },
      {
        "default": "2026-09-30",
        "label": "To",
        "name": "end_date",
        "type": "date"
      },
      {
        "default": "TxnDate >= '2026-07-01' AND TxnDate <= '2026-09-30'",
        "label": "Transaction filter",
        "maxLength": 120,
        "name": "txn_where",
        "type": "string"
      },
      {
        "default": "Practitioner",
        "label": "View as",
        "name": "persona",
        "options": [
          "Client",
          "Bookkeeper",
          "Practitioner",
          "Executive"
        ],
        "type": "enum"
      },
      {
        "default": "{\"cents\":1,\"k\":0,\"zeros\":1,\"neg\":\"paren\",\"red\":0,\"hdr\":1,\"ftr\":1,\"style\":\"mysmb\",\"dens\":\"100\",\"p\":\"this_quarter\",\"a\":\"custom\",\"c\":\"none\",\"v\":\"\",\"x\":\"\"}",
        "label": "Display settings",
        "maxLength": 300,
        "name": "display",
        "type": "string"
      }
    ]
  },
  "description": "Client Report Analytics CRA-12 for one QuickBooks client: hours recorded in the client's own file by person, job or customer and activity, by month (the client's staff time, not the practice's time on the client). Live and validated on every open; mySMB branding by default.",
  "fileName": "client-quickbooks-actual-time.html",
  "tags": [
    "client-report-analytics",
    "CRA-12",
    "quickbooks",
    "actual-time"
  ],
  "title": "QuickBooks Actual Time"
}
