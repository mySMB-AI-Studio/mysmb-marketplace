{
  "title": "Xero Health Check",
  "description": "Client Report Analytics CRA-09 for one Xero client: income, profit, bank, overdue receivables and payables, and the data quality findings, on one page. Live and validated on every open; mySMB branding by default.",
  "tags": [
    "client-report-analytics",
    "CRA-09",
    "xero",
    "health-check"
  ],
  "fileName": "client-xero-health-check.html",
  "dataBindings": {
    "inputs": [
      {
        "name": "from_date",
        "label": "From",
        "type": "date",
        "default": "2026-07-01"
      },
      {
        "name": "to_date",
        "label": "To",
        "type": "date",
        "default": "today"
      },
      {
        "name": "date_where",
        "label": "Period filter",
        "type": "string",
        "maxLength": 200,
        "default": "Date>=DateTime(2026,07,01) AND Date<=DateTime(2026,09,25)"
      },
      {
        "name": "from12",
        "label": "Start of the 12 months",
        "type": "date",
        "default": "2025-09-26"
      },
      {
        "name": "org",
        "label": "Organisation",
        "type": "string",
        "maxLength": 64,
        "default": ""
      },
      {
        "name": "page",
        "label": "Page",
        "type": "number",
        "min": 1,
        "max": 20,
        "default": 1
      },
      {
        "name": "display",
        "label": "Display settings",
        "type": "string",
        "maxLength": 300,
        "default": "{\"cents\":1,\"k\":0,\"zeros\":1,\"neg\":\"paren\",\"red\":1,\"hdr\":1,\"ftr\":1,\"style\":\"mysmb\",\"dens\":\"100\",\"p\":\"this_fy_td\",\"a\":\"custom\",\"c\":\"none\",\"v\":\"\"}"
      }
    ],
    "bindings": [
      {
        "id": "contacts",
        "tool": {
          "mcp": "xero-accounting",
          "name": "list_contacts"
        },
        "params": {
          "where": {
            "kind": "static",
            "value": "ContactStatus==\"ACTIVE\""
          },
          "page": {
            "kind": "input",
            "input": "page"
          },
          "xero_tenant_id": {
            "kind": "input",
            "input": "org"
          }
        }
      },
      {
        "id": "invoices",
        "tool": {
          "mcp": "xero-accounting",
          "name": "list_invoices"
        },
        "params": {
          "where": {
            "kind": "input",
            "input": "date_where"
          },
          "page": {
            "kind": "input",
            "input": "page"
          },
          "xero_tenant_id": {
            "kind": "input",
            "input": "org"
          }
        }
      },
      {
        "id": "open_inv",
        "tool": {
          "mcp": "xero-accounting",
          "name": "list_invoices"
        },
        "params": {
          "statuses": {
            "kind": "static",
            "value": "AUTHORISED"
          },
          "page": {
            "kind": "input",
            "input": "page"
          },
          "xero_tenant_id": {
            "kind": "input",
            "input": "org"
          }
        }
      },
      {
        "id": "bank_tx",
        "tool": {
          "mcp": "xero-accounting",
          "name": "list_bank_transactions"
        },
        "params": {
          "where": {
            "kind": "input",
            "input": "date_where"
          },
          "page": {
            "kind": "input",
            "input": "page"
          },
          "xero_tenant_id": {
            "kind": "input",
            "input": "org"
          }
        }
      },
      {
        "id": "accounts",
        "tool": {
          "mcp": "xero-accounting",
          "name": "list_accounts"
        },
        "params": {
          "xero_tenant_id": {
            "kind": "input",
            "input": "org"
          }
        }
      },
      {
        "id": "tax_rates",
        "tool": {
          "mcp": "xero-accounting",
          "name": "list_tax_rates"
        },
        "params": {
          "xero_tenant_id": {
            "kind": "input",
            "input": "org"
          }
        }
      },
      {
        "id": "tb",
        "tool": {
          "mcp": "xero-accounting",
          "name": "get_trial_balance"
        },
        "params": {
          "date": {
            "kind": "input",
            "input": "to_date"
          },
          "paymentsOnly": {
            "kind": "static",
            "value": false
          },
          "xero_tenant_id": {
            "kind": "input",
            "input": "org"
          }
        }
      },
      {
        "id": "pnl",
        "tool": {
          "mcp": "xero-accounting",
          "name": "get_profit_and_loss"
        },
        "params": {
          "fromDate": {
            "kind": "input",
            "input": "from_date"
          },
          "toDate": {
            "kind": "input",
            "input": "to_date"
          },
          "standardLayout": {
            "kind": "static",
            "value": true
          },
          "paymentsOnly": {
            "kind": "static",
            "value": false
          },
          "xero_tenant_id": {
            "kind": "input",
            "input": "org"
          }
        }
      },
      {
        "id": "pnl12",
        "tool": {
          "mcp": "xero-accounting",
          "name": "get_profit_and_loss"
        },
        "params": {
          "fromDate": {
            "kind": "input",
            "input": "from12"
          },
          "toDate": {
            "kind": "input",
            "input": "to_date"
          },
          "standardLayout": {
            "kind": "static",
            "value": true
          },
          "paymentsOnly": {
            "kind": "static",
            "value": false
          },
          "xero_tenant_id": {
            "kind": "input",
            "input": "org"
          }
        }
      },
      {
        "id": "bank",
        "tool": {
          "mcp": "xero-accounting",
          "name": "get_bank_summary"
        },
        "params": {
          "fromDate": {
            "kind": "input",
            "input": "from_date"
          },
          "toDate": {
            "kind": "input",
            "input": "to_date"
          },
          "xero_tenant_id": {
            "kind": "input",
            "input": "org"
          }
        }
      },
      {
        "id": "org",
        "tool": {
          "mcp": "xero-accounting",
          "name": "get_organisation"
        },
        "params": {
          "xero_tenant_id": {
            "kind": "input",
            "input": "org"
          }
        }
      },
      {
        "id": "connections",
        "tool": {
          "mcp": "xero-accounting",
          "name": "list_connections"
        },
        "params": {}
      }
    ]
  }
}
