{
  "title": "QuickBooks Estimate Accuracy",
  "description": "Client Report Analytics CRA-13 for one QuickBooks client: each estimate against the invoices raised from it, with the variance in dollars (QuickBooks has no time estimates). Live and validated on every open; mySMB branding by default.",
  "tags": [
    "client-report-analytics",
    "CRA-13",
    "quickbooks",
    "estimate-accuracy"
  ],
  "fileName": "client-quickbooks-estimate-accuracy.html",
  "dataBindings": {
    "inputs": [
      {
        "name": "start_date",
        "label": "From",
        "type": "date",
        "default": "2026-07-01"
      },
      {
        "name": "end_date",
        "label": "To",
        "type": "date",
        "default": "2026-09-30"
      },
      {
        "name": "txn_where",
        "label": "Transaction filter",
        "type": "string",
        "maxLength": 120,
        "default": "TxnDate >= '2026-07-01' AND TxnDate <= '2026-09-30'"
      },
      {
        "name": "inv_where",
        "label": "Invoices from",
        "type": "string",
        "maxLength": 60,
        "default": "TxnDate >= '2026-07-01'"
      },
      {
        "name": "persona",
        "label": "View as",
        "type": "enum",
        "options": [
          "Client",
          "Bookkeeper",
          "Practitioner",
          "Executive"
        ],
        "default": "Practitioner"
      },
      {
        "name": "display",
        "label": "Display settings",
        "type": "string",
        "maxLength": 300,
        "default": "{\"cents\":1,\"k\":0,\"zeros\":1,\"neg\":\"paren\",\"red\":0,\"hdr\":1,\"ftr\":1,\"style\":\"mysmb\",\"dens\":\"100\",\"p\":\"this_quarter\",\"a\":\"custom\",\"c\":\"none\",\"v\":\"\",\"x\":\"\"}"
      }
    ],
    "bindings": [
      {
        "id": "estimates",
        "tool": {
          "mcp": "quickbooks-accounting",
          "name": "list_estimate"
        },
        "params": {
          "where": {
            "kind": "input",
            "input": "txn_where"
          },
          "maxResults": {
            "kind": "static",
            "value": 1000
          }
        }
      },
      {
        "id": "invoices",
        "tool": {
          "mcp": "quickbooks-accounting",
          "name": "list_invoice"
        },
        "params": {
          "where": {
            "kind": "input",
            "input": "inv_where"
          },
          "maxResults": {
            "kind": "static",
            "value": 1000
          }
        }
      },
      {
        "id": "company_info",
        "tool": {
          "mcp": "quickbooks-accounting",
          "name": "qbo_query"
        },
        "params": {
          "query": {
            "kind": "static",
            "value": "SELECT * FROM CompanyInfo"
          }
        }
      },
      {
        "id": "prefs",
        "tool": {
          "mcp": "quickbooks-accounting",
          "name": "get_preferences"
        },
        "params": {}
      }
    ]
  }
}
