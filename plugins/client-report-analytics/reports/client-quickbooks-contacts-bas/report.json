{
  "title": "QuickBooks Contact Details for BAS Preparation",
  "description": "Client Report Analytics CRA-06 for one QuickBooks client: every contact with the tax types used on their transactions and GST evidence on file, and on Xero each ABN's Australian Business Register record (needs ABR Lookup connected). Live and validated on every open; mySMB branding by default.",
  "tags": [
    "client-report-analytics",
    "CRA-06",
    "quickbooks",
    "contacts-bas"
  ],
  "fileName": "client-quickbooks-contacts-bas.html",
  "dataBindings": {
    "inputs": [
      {
        "name": "start_date",
        "label": "From",
        "type": "date",
        "default": "2026-04-01"
      },
      {
        "name": "end_date",
        "label": "To",
        "type": "date",
        "default": "2026-06-30"
      },
      {
        "name": "txn_where",
        "label": "Transaction date filter",
        "type": "string",
        "maxLength": 80,
        "default": "TxnDate >= '2026-04-01' AND TxnDate <= '2026-06-30'"
      },
      {
        "name": "persona",
        "label": "View as",
        "type": "enum",
        "options": [
          "Client",
          "Bookkeeper",
          "Practitioner",
          "Executive"
        ],
        "default": "Practitioner"
      },
      {
        "name": "display",
        "label": "Display settings",
        "type": "string",
        "maxLength": 300,
        "default": "{\"cents\":0,\"k\":0,\"zeros\":1,\"neg\":\"paren\",\"red\":0,\"hdr\":1,\"ftr\":1,\"style\":\"mysmb\",\"dens\":\"100\",\"p\":\"last_quarter\",\"a\":\"custom\",\"c\":\"none\",\"v\":\"\",\"x\":\"\"}"
      }
    ],
    "bindings": [
      {
        "id": "customers",
        "tool": {
          "mcp": "quickbooks-accounting",
          "name": "qbo_query"
        },
        "params": {
          "query": {
            "kind": "static",
            "value": "SELECT * FROM Customer"
          }
        }
      },
      {
        "id": "vendors",
        "tool": {
          "mcp": "quickbooks-accounting",
          "name": "qbo_query"
        },
        "params": {
          "query": {
            "kind": "static",
            "value": "SELECT * FROM Vendor"
          }
        }
      },
      {
        "id": "company_info",
        "tool": {
          "mcp": "quickbooks-accounting",
          "name": "qbo_query"
        },
        "params": {
          "query": {
            "kind": "static",
            "value": "SELECT * FROM CompanyInfo"
          }
        }
      },
      {
        "id": "prefs",
        "tool": {
          "mcp": "quickbooks-accounting",
          "name": "get_preferences"
        },
        "params": {}
      },
      {
        "id": "tax_codes",
        "tool": {
          "mcp": "quickbooks-accounting",
          "name": "list_tax_code"
        },
        "params": {
          "maxResults": {
            "kind": "static",
            "value": 1000
          }
        }
      },
      {
        "id": "invoices",
        "tool": {
          "mcp": "quickbooks-accounting",
          "name": "list_invoice"
        },
        "params": {
          "where": {
            "kind": "input",
            "input": "txn_where"
          },
          "maxResults": {
            "kind": "static",
            "value": 1000
          }
        }
      },
      {
        "id": "credit_memos",
        "tool": {
          "mcp": "quickbooks-accounting",
          "name": "list_credit_memo"
        },
        "params": {
          "where": {
            "kind": "input",
            "input": "txn_where"
          },
          "maxResults": {
            "kind": "static",
            "value": 1000
          }
        }
      },
      {
        "id": "sales_receipts",
        "tool": {
          "mcp": "quickbooks-accounting",
          "name": "list_sales_receipt"
        },
        "params": {
          "where": {
            "kind": "input",
            "input": "txn_where"
          },
          "maxResults": {
            "kind": "static",
            "value": 1000
          }
        }
      },
      {
        "id": "bills",
        "tool": {
          "mcp": "quickbooks-accounting",
          "name": "list_bill"
        },
        "params": {
          "where": {
            "kind": "input",
            "input": "txn_where"
          },
          "maxResults": {
            "kind": "static",
            "value": 1000
          }
        }
      },
      {
        "id": "vendor_credits",
        "tool": {
          "mcp": "quickbooks-accounting",
          "name": "list_vendor_credit"
        },
        "params": {
          "where": {
            "kind": "input",
            "input": "txn_where"
          },
          "maxResults": {
            "kind": "static",
            "value": 1000
          }
        }
      },
      {
        "id": "purchases",
        "tool": {
          "mcp": "quickbooks-accounting",
          "name": "list_purchase"
        },
        "params": {
          "where": {
            "kind": "input",
            "input": "txn_where"
          },
          "maxResults": {
            "kind": "static",
            "value": 1000
          }
        }
      },
      {
        "id": "journal_entries",
        "tool": {
          "mcp": "quickbooks-accounting",
          "name": "list_journal_entry"
        },
        "params": {
          "where": {
            "kind": "input",
            "input": "txn_where"
          },
          "maxResults": {
            "kind": "static",
            "value": 1000
          }
        }
      }
    ]
  }
}
