{
  "id": "worx-safety-open-issues-demo",
  "title": "Open Safety Issues (Demo)",
  "description": "Sample active safety issues, hazards, and incidents with priority and type.",
  "category": "operations",
  "tags": ["worx-safety", "whs", "safety", "issues", "incidents", "hazards", "australia", "demo"],
  "keywords": ["issues", "incidents", "hazards", "safety", "whs", "worx", "demo"],
  "connectorsUsed": [],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 4, "rowSpan": 6 },
    "min":       { "colSpan": 3, "rowSpan": 4 },
    "max":       { "colSpan": 6, "rowSpan": 10 }
  },
  "spec": {
    "root": "card",
    "elements": {

      "card": {
        "type": "Card",
        "props": {},
        "children": ["titleRow", "divider", "body"]
      },

      "titleRow": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "TriangleAlert", "tone": "destructive", "size": "sm" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "eyebrow"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Open Safety Issues", "level": "h2" }
      },
      "eyebrow": {
        "type": "Eyebrow",
        "props": { "text": "Worx Safety" }
      },

      "divider": { "type": "Divider", "props": {} },

      "body": {
        "type": "Body",
        "props": {},
        "children": ["items"]
      },

      "items": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["row1", "div1", "row2", "div2", "row3"]
      },

      "row1": {
        "type": "Row",
        "props": { "justify": "between", "align": "start" },
        "children": ["r1left", "r1dot"]
      },
      "r1left": {
        "type": "Stack",
        "props": { "gap": "none", "grow": true },
        "children": ["r1desc", "r1meta"]
      },
      "r1desc": { "type": "Text", "props": { "text": "Damaged guardrail — loading dock", "size": "sm", "weight": "medium" } },
      "r1meta": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["r1type", "r1loc"]
      },
      "r1type": { "type": "Badge", "props": { "text": "Hazard", "tone": "accent", "variant": "soft" } },
      "r1loc": { "type": "Text", "props": { "text": "Bay 2", "size": "xs", "tone": "muted" } },
      "r1dot": { "type": "Dot", "props": { "tone": "destructive" } },

      "div1": { "type": "Divider", "props": {} },

      "row2": {
        "type": "Row",
        "props": { "justify": "between", "align": "start" },
        "children": ["r2left", "r2dot"]
      },
      "r2left": {
        "type": "Stack",
        "props": { "gap": "none", "grow": true },
        "children": ["r2desc", "r2meta"]
      },
      "r2desc": { "type": "Text", "props": { "text": "Forklift near-miss", "size": "sm", "weight": "medium" } },
      "r2meta": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["r2type", "r2loc"]
      },
      "r2type": { "type": "Badge", "props": { "text": "Incident", "tone": "accent", "variant": "soft" } },
      "r2loc": { "type": "Text", "props": { "text": "Warehouse", "size": "xs", "tone": "muted" } },
      "r2dot": { "type": "Dot", "props": { "tone": "warning" } },

      "div2": { "type": "Divider", "props": {} },

      "row3": {
        "type": "Row",
        "props": { "justify": "between", "align": "start" },
        "children": ["r3left", "r3dot"]
      },
      "r3left": {
        "type": "Stack",
        "props": { "gap": "none", "grow": true },
        "children": ["r3desc", "r3meta"]
      },
      "r3desc": { "type": "Text", "props": { "text": "Spill cleanup incomplete", "size": "sm", "weight": "medium" } },
      "r3meta": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["r3type", "r3loc"]
      },
      "r3type": { "type": "Badge", "props": { "text": "Hazard", "tone": "accent", "variant": "soft" } },
      "r3loc": { "type": "Text", "props": { "text": "Storeroom", "size": "xs", "tone": "muted" } },
      "r3dot": { "type": "Dot", "props": { "tone": "positive" } }

    }
  },
  "status": "published"
}
