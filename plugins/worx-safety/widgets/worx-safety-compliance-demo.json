{
  "id": "worx-safety-compliance-demo",
  "title": "Compliance & Safety Summary",
  "description": "Static compliance checklist demo — overdue, action needed, and up-to-date status items at a glance.",
  "category": "operations",
  "tags": ["worx-safety", "whs", "compliance", "demo", "checklist", "australia"],
  "keywords": ["compliance", "safety", "summary", "checklist", "whs", "worx"],
  "connectorsUsed": [],
