{
  "id": "worx-safety-compliance",
  "title": "Compliance & Safety",
  "description": "Live compliance status across documents, workers, contractors, and issues — overdue, action needed, and up to date.",
  "category": "operations",
  "tags": ["worx-safety", "whs", "compliance", "safety", "documents", "issues", "australia"],
  "keywords": ["compliance", "safety", "overdue", "documents", "issues", "whs", "worx"],
  "connectorsUsed": ["worx-safety"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 4, "rowSpan": 6 },
    "min":       { "colSpan": 3, "rowSpan": 4 },
    "max":       { "colSpan": 6, "rowSpan": 12 }
  },
  "dataProvider": {
    "mcp": "worx-safety",
    "tool": "get_compliance_summary",
    "params": {}
  },
  "spec": {
    "root": "card",
    "elements": {

      "card": {
        "type": "Card",
        "props": {},
        "children": ["titleRow", "divider", "summaryRow", "divider2", "loading", "empty", "scrollBody"]
      },

      "titleRow": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "ShieldCheck", "tone": "positive", "size": "sm" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "eyebrow"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Compliance & Safety", "level": "h2" }
      },
      "eyebrow": {
        "type": "Eyebrow",
        "props": { "text": "Worx Safety" }
      },

      "divider": { "type": "Divider", "props": {} },

      "summaryRow": {
        "type": "Row",
        "props": { "gap": "sm", "justify": "between" },
        "children": ["statOverdue", "statAction", "statOk"]
      },
      "statOverdue": {
        "type": "Stat",
        "props": {
          "label": "Overdue",
          "value": { "$state": "/worx-safety/get_compliance_summary/summary/overdue" },
          "tone": "destructive"
        }
      },
      "statAction": {
        "type": "Stat",
        "props": {
          "label": "Action needed",
          "value": { "$state": "/worx-safety/get_compliance_summary/summary/action_needed" },
          "tone": "warning"
        }
      },
      "statOk": {
        "type": "Stat",
        "props": {
          "label": "Up to date",
          "value": { "$state": "/worx-safety/get_compliance_summary/summary/up_to_date" },
          "tone": "positive"
        }
      },

      "divider2": { "type": "Divider", "props": {} },

      "loading": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "visible": { "$state": "/_loading/worx-safety.get_compliance_summary" },
        "children": ["sk1", "sk2", "sk3"]
      },
      "sk1": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "sk2": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "sk3": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },

      "empty": {
        "type": "Empty",
        "props": { "message": "No compliance items found — all clear." },
        "visible": {
          "$and": [
            { "$state": "/_loading/worx-safety.get_compliance_summary", "not": true },
            { "$state": "/worx-safety/get_compliance_summary/items/0", "not": true }
          ]
        }
      },

      "scrollBody": {
        "type": "Body",
        "props": {},
        "visible": { "$state": "/_loading/worx-safety.get_compliance_summary", "not": true },
        "children": ["list"]
      },

      "list": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "repeat": {
          "statePath": "/worx-safety/get_compliance_summary/items",
          "key": "entity_id"
        },
        "children": ["row"]
      },

      "row": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["rowContent", "rowDivider"]
      },
      "rowContent": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["rowLeft", "rowBadge"]
      },
      "rowLeft": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center", "grow": true },
        "children": ["rowDot", "rowText"]
      },
      "rowDot": {
        "type": "Dot",
        "props": {
          "tone": {
            "$computed": "todo_status_tone",
            "args": { "value": { "$item": "status" } }
          }
        }
      },
      "rowText": {
        "type": "Stack",
        "props": { "gap": "none", "grow": true },
        "children": ["rowName", "rowDetail"]
      },
      "rowName": {
        "type": "Text",
        "props": {
          "text": { "$item": "name" },
          "size": "sm",
          "weight": "medium",
          "truncate": true
        }
      },
      "rowDetail": {
        "type": "Text",
        "props": {
          "text": { "$item": "detail" },
          "size": "xs",
          "tone": "muted"
        },
        "visible": { "$item": "detail" }
      },
      "rowBadge": {
        "type": "Badge",
        "props": {
          "text": {
            "$computed": "status_label",
            "args": { "value": { "$item": "status" } }
          },
          "tone": {
            "$computed": "todo_status_tone",
            "args": { "value": { "$item": "status" } }
          },
          "variant": "soft"
        }
      },
      "rowDivider": { "type": "Divider", "props": {} }

    }
  },
  "status": "published"
}
