{
  "id": "worx-safety-open-issues",
  "title": "Open Safety Issues",
  "description": "Active safety issues, hazards, and incidents with priority and status.",
  "category": "operations",
  "tags": ["worx-safety", "whs", "safety", "issues", "incidents", "hazards", "australia"],
  "keywords": ["issues", "incidents", "hazards", "safety", "whs", "worx"],
  "connectorsUsed": ["worx-safety"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 4, "rowSpan": 6 },
    "min":       { "colSpan": 3, "rowSpan": 4 },
    "max":       { "colSpan": 8, "rowSpan": 12 }
  },
  "dataProvider": {
    "mcp": "worx-safety",
    "tool": "list_issues",
    "params": {}
  },
  "spec": {
    "root": "card",
    "elements": {

      "card": {
        "type": "Card",
        "props": {},
        "children": ["titleRow", "divider", "loading", "empty", "scrollBody"]
      },

      "titleRow": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "TriangleAlert", "tone": "destructive", "size": "sm" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "eyebrow"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Open Safety Issues", "level": "h2" }
      },
      "eyebrow": {
        "type": "Eyebrow",
        "props": { "text": "Worx Safety" }
      },

      "divider": { "type": "Divider", "props": {} },

      "loading": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "visible": { "$state": "/_loading/worx-safety.list_issues" },
        "children": ["sk1", "sk2", "sk3"]
      },
      "sk1": { "type": "Skeleton", "props": { "height": "3.5rem", "rounded": "md" } },
      "sk2": { "type": "Skeleton", "props": { "height": "3.5rem", "rounded": "md" } },
      "sk3": { "type": "Skeleton", "props": { "height": "3.5rem", "rounded": "md" } },

      "empty": {
        "type": "Empty",
        "props": { "message": "No open safety issues — all clear." },
        "visible": {
          "$and": [
            { "$state": "/_loading/worx-safety.list_issues", "not": true },
            { "$state": "/worx-safety/list_issues/data/0", "not": true }
          ]
        }
      },

      "scrollBody": {
        "type": "Body",
        "props": {},
        "visible": { "$state": "/_loading/worx-safety.list_issues", "not": true },
        "children": ["list"]
      },

      "list": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "repeat": {
          "statePath": "/worx-safety/list_issues/data",
          "key": "id"
        },
        "children": ["row"]
      },

      "row": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["rowContent", "rowDivider"]
      },
      "rowContent": {
        "type": "Row",
        "props": { "justify": "between", "align": "start" },
        "children": ["rowLeft", "rowPriority"]
      },
      "rowLeft": {
        "type": "Stack",
        "props": { "gap": "none", "grow": true },
        "children": ["rowDesc", "rowMeta"]
      },
      "rowDesc": {
        "type": "Text",
        "props": {
          "text": { "$item": "description" },
          "size": "sm",
          "weight": "medium",
          "truncate": true
        }
      },
      "rowMeta": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center", "wrap": true },
        "children": ["rowType", "rowRelation"]
      },
      "rowType": {
        "type": "Badge",
        "props": {
          "text": { "$item": "issue_type" },
          "tone": "accent",
          "variant": "soft"
        },
        "visible": { "$item": "issue_type" }
      },
      "rowRelation": {
        "type": "Text",
        "props": {
          "text": { "$item": "relation_name" },
          "size": "xs",
          "tone": "muted",
          "truncate": true
        },
        "visible": { "$item": "relation_name" }
      },
      "rowPriority": {
        "type": "Dot",
        "props": {
          "tone": {
            "$computed": "todo_priority_tone",
            "args": { "value": { "$item": "priority" } }
          }
        }
      },
      "rowDivider": { "type": "Divider", "props": {} }

    }
  },
  "status": "published"
}
