{
  "id": "worx-safety-projects-demo",
  "title": "Active Projects (Demo)",
  "description": "Sample active Worx Safety projects and sites with status and location.",
  "category": "operations",
  "tags": ["worx-safety", "whs", "projects", "sites", "australia", "demo"],
  "keywords": ["projects", "sites", "active", "safety", "whs", "worx", "demo"],
  "connectorsUsed": [],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 4, "rowSpan": 6 },
    "min":       { "colSpan": 3, "rowSpan": 4 },
    "max":       { "colSpan": 6, "rowSpan": 10 }
  },
  "spec": {
    "root": "card",
    "elements": {

      "card": {
        "type": "Card",
        "props": {},
        "children": ["titleRow", "divider", "body"]
      },

      "titleRow": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "HardHat", "tone": "accent", "size": "sm" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "eyebrow"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Active Projects", "level": "h2" }
      },
      "eyebrow": {
        "type": "Eyebrow",
        "props": { "text": "Worx Safety" }
      },

      "divider": { "type": "Divider", "props": {} },

      "body": {
        "type": "Body",
        "props": {},
        "children": ["items"]
      },

      "items": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["row1", "div1", "row2", "div2", "row3"]
      },

      "row1": {
        "type": "Row",
        "props": { "justify": "between", "align": "start" },
        "children": ["r1left", "r1badge"]
      },
      "r1left": {
        "type": "Stack",
        "props": { "gap": "none", "grow": true },
        "children": ["r1name", "r1addr"]
      },
      "r1name": { "type": "Text", "props": { "text": "CBD Office Fitout", "size": "sm", "weight": "medium" } },
      "r1addr": { "type": "Text", "props": { "text": "123 Collins St, Melbourne", "size": "xs", "tone": "muted" } },
      "r1badge": { "type": "Badge", "props": { "text": "Active", "tone": "positive", "variant": "soft" } },

      "div1": { "type": "Divider", "props": {} },

      "row2": {
        "type": "Row",
        "props": { "justify": "between", "align": "start" },
        "children": ["r2left", "r2badge"]
      },
      "r2left": {
        "type": "Stack",
        "props": { "gap": "none", "grow": true },
        "children": ["r2name", "r2addr"]
      },
      "r2name": { "type": "Text", "props": { "text": "Warehouse Expansion", "size": "sm", "weight": "medium" } },
      "r2addr": { "type": "Text", "props": { "text": "14 Enterprise Dr, Dandenong", "size": "xs", "tone": "muted" } },
      "r2badge": { "type": "Badge", "props": { "text": "Active", "tone": "positive", "variant": "soft" } },

      "div2": { "type": "Divider", "props": {} },

      "row3": {
        "type": "Row",
        "props": { "justify": "between", "align": "start" },
        "children": ["r3left", "r3badge"]
      },
      "r3left": {
        "type": "Stack",
        "props": { "gap": "none", "grow": true },
        "children": ["r3name", "r3addr"]
      },
      "r3name": { "type": "Text", "props": { "text": "Rooftop Solar Install", "size": "sm", "weight": "medium" } },
      "r3addr": { "type": "Text", "props": { "text": "Moorabbin Airport Rd", "size": "xs", "tone": "muted" } },
      "r3badge": { "type": "Badge", "props": { "text": "Active", "tone": "positive", "variant": "soft" } }

    }
  },
  "status": "published"
}
