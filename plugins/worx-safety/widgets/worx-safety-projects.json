{
  "id": "worx-safety-projects",
  "title": "Active Projects",
  "description": "Active Worx Safety projects and site events with status and location.",
  "category": "operations",
  "tags": ["worx-safety", "whs", "projects", "sites", "australia"],
  "keywords": ["projects", "sites", "active", "safety", "whs", "worx"],
  "connectorsUsed": ["worx-safety"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 4, "rowSpan": 6 },
    "min":       { "colSpan": 3, "rowSpan": 4 },
    "max":       { "colSpan": 8, "rowSpan": 12 }
  },
  "dataProvider": {
    "mcp": "worx-safety",
    "tool": "list_projects",
    "params": {}
  },
  "spec": {
    "root": "card",
    "elements": {

      "card": {
        "type": "Card",
        "props": {},
        "children": ["titleRow", "divider", "loading", "empty", "scrollBody"]
      },

      "titleRow": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "HardHat", "tone": "accent", "size": "sm" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "eyebrow"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Active Projects", "level": "h2" }
      },
      "eyebrow": {
        "type": "Eyebrow",
        "props": { "text": "Worx Safety" }
      },

      "divider": { "type": "Divider", "props": {} },

      "loading": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "visible": { "$state": "/_loading/worx-safety.list_projects" },
        "children": ["sk1", "sk2", "sk3"]
      },
      "sk1": { "type": "Skeleton", "props": { "height": "3.5rem", "rounded": "md" } },
      "sk2": { "type": "Skeleton", "props": { "height": "3.5rem", "rounded": "md" } },
      "sk3": { "type": "Skeleton", "props": { "height": "3.5rem", "rounded": "md" } },

      "empty": {
        "type": "Empty",
        "props": { "message": "No active projects found." },
        "visible": {
          "$and": [
            { "$state": "/_loading/worx-safety.list_projects", "not": true },
            { "$state": "/worx-safety/list_projects/data/0", "not": true }
          ]
        }
      },

      "scrollBody": {
        "type": "Body",
        "props": {},
        "visible": { "$state": "/_loading/worx-safety.list_projects", "not": true },
        "children": ["list"]
      },

      "list": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "repeat": {
          "statePath": "/worx-safety/list_projects/data",
          "key": "id"
        },
        "children": ["row"]
      },

      "row": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["rowContent", "rowDivider"]
      },
      "rowContent": {
        "type": "Row",
        "props": { "justify": "between", "align": "start" },
        "children": ["rowLeft", "rowStatus"]
      },
      "rowLeft": {
        "type": "Stack",
        "props": { "gap": "none", "grow": true },
        "children": ["rowName", "rowMeta"]
      },
      "rowName": {
        "type": "Text",
        "props": {
          "text": { "$item": "name" },
          "size": "sm",
          "weight": "medium",
          "truncate": true
        }
      },
      "rowMeta": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center", "wrap": true },
        "children": ["rowLocation", "rowDate"]
      },
      "rowLocation": {
        "type": "Text",
        "props": {
          "text": { "$item": "address" },
          "size": "xs",
          "tone": "muted",
          "truncate": true
        },
        "visible": { "$item": "address" }
      },
      "rowDate": {
        "type": "Text",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "Start: {start_date}",
              "start_date": { "$item": "start_date" }
            }
          },
          "size": "xs",
          "tone": "muted"
        },
        "visible": { "$item": "start_date" }
      },
      "rowStatus": {
        "type": "Badge",
        "props": {
          "text": { "$item": "status" },
          "tone": "positive",
          "variant": "soft"
        },
        "visible": { "$item": "status" }
      },
      "rowDivider": { "type": "Divider", "props": {} }

    }
  },
  "status": "published"
}
