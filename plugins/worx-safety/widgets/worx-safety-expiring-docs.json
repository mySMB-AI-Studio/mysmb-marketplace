{
  "id": "worx-safety-expiring-docs",
  "title": "Expiring Documents",
  "description": "Compliance documents expiring within 10 days — worker name, document type, and days remaining.",
  "category": "operations",
  "tags": ["worx-safety", "whs", "compliance", "documents", "expiry", "australia"],
  "keywords": ["expiring", "documents", "compliance", "whs", "safety", "worx"],
  "connectorsUsed": ["worx-safety"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 4, "rowSpan": 6 },
    "min":       { "colSpan": 3, "rowSpan": 4 },
    "max":       { "colSpan": 8, "rowSpan": 12 }
  },
  "dataProvider": {
    "mcp": "worx-safety",
    "tool": "list_expiring_documents",
    "params": {}
  },
  "spec": {
    "root": "card",
    "elements": {

      "card": {
        "type": "Card",
        "props": {},
        "children": ["titleRow", "divider", "loading", "empty", "scrollBody"]
      },

      "titleRow": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "FileWarning", "tone": "warning", "size": "sm" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "eyebrow"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Expiring Documents", "level": "h2" }
      },
      "eyebrow": {
        "type": "Eyebrow",
        "props": { "text": "Worx Safety · next 10 days" }
      },

      "divider": { "type": "Divider", "props": {} },

      "loading": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "visible": { "$state": "/_loading/worx-safety.list_expiring_documents" },
        "children": ["sk1", "sk2", "sk3"]
      },
      "sk1": { "type": "Skeleton", "props": { "height": "3rem", "rounded": "md" } },
      "sk2": { "type": "Skeleton", "props": { "height": "3rem", "rounded": "md" } },
      "sk3": { "type": "Skeleton", "props": { "height": "3rem", "rounded": "md" } },

      "empty": {
        "type": "Empty",
        "props": { "message": "No documents expiring in the next 10 days." },
        "visible": {
          "$and": [
            { "$state": "/_loading/worx-safety.list_expiring_documents", "not": true },
            { "$state": "/worx-safety/list_expiring_documents/data/0", "not": true }
          ]
        }
      },

      "scrollBody": {
        "type": "Body",
        "props": {},
        "visible": { "$state": "/_loading/worx-safety.list_expiring_documents", "not": true },
        "children": ["list"]
      },

      "list": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "repeat": {
          "statePath": "/worx-safety/list_expiring_documents/data",
          "key": "id"
        },
        "children": ["row"]
      },

      "row": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["rowContent", "rowDivider"]
      },
      "rowContent": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["rowLeft", "rowExpiry"]
      },
      "rowLeft": {
        "type": "Stack",
        "props": { "gap": "none", "grow": true },
        "children": ["rowName", "rowType"]
      },
      "rowName": {
        "type": "Text",
        "props": {
          "text": { "$item": "inductee_name" },
          "size": "sm",
          "weight": "medium",
          "truncate": true
        }
      },
      "rowType": {
        "type": "Text",
        "props": {
          "text": { "$item": "name" },
          "size": "xs",
          "tone": "muted",
          "truncate": true
        }
      },
      "rowExpiry": {
        "type": "Badge",
        "props": {
          "text": { "$item": "expiry_date" },
          "tone": "warning",
          "variant": "soft"
        }
      },
      "rowDivider": { "type": "Divider", "props": {} }

    }
  },
  "status": "published"
}
