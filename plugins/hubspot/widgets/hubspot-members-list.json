{
  "id": "hubspot-members-list",
  "title": "Members",
  "description": "Records from a HubSpot custom object (e.g. a Members object for association-management customers). Requires the connected portal to be on HubSpot Enterprise tier on at least one Hub; on lower tiers this returns no results, not an error.",
  "category": "crm",
  "tags": ["hubspot", "membership", "custom-object", "association"],
  "keywords": ["members", "membership", "custom object", "association", "roster"],
  "connectorsUsed": ["hubspot"],
  "popularity": 40,
  "sizing": {
    "preferred": { "colSpan": 4, "rowSpan": 5 },
    "min": { "colSpan": 3, "rowSpan": 4 },
    "max": { "colSpan": 10, "rowSpan": 10 }
  },
  "dataProvider": {
    "mcp": "hubspot",
    "tool": "list_custom_objects",
    "params": {
      "objectTypeId": "2-00000",
      "properties": ["name", "email"],
      "limit": 20
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "children": ["header", "body"]
      },
      "header": {
        "type": "Header",
        "children": ["titleGroup"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "start" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "IdCard", "tone": "accent", "size": "sm" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "subtitle"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Members", "level": "h2" }
      },
      "subtitle": {
        "type": "Eyebrow",
        "props": { "text": "Custom object — configure objectTypeId in tile settings" }
      },
      "body": {
        "type": "Body",
        "children": ["loading", "empty", "memberList"]
      },
      "loading": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["sk1", "sk2", "sk3", "sk4"],
        "visible": { "$state": "/_loading/hubspot.list_custom_objects" }
      },
      "sk1": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "sk2": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "sk3": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "sk4": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "empty": {
        "type": "Empty",
        "props": {
          "message": "No member records found. Confirm objectTypeId matches your portal's Members object (see list_object_schemas), and that the portal is on HubSpot Enterprise tier."
        },
        "visible": {
          "$and": [
            { "$state": "/_loading/hubspot.list_custom_objects", "not": true },
            { "$state": "/hubspot/list_custom_objects/items/0", "not": true }
          ]
        }
      },
      "memberList": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["memberRow"],
        "repeat": {
          "statePath": "/hubspot/list_custom_objects/items",
          "key": "id"
        },
        "visible": {
          "$and": [
            { "$state": "/_loading/hubspot.list_custom_objects", "not": true },
            { "$state": "/hubspot/list_custom_objects/items/0" }
          ]
        }
      },
      "memberRow": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center", "hover": true },
        "children": ["memberInfo"]
      },
      "memberInfo": {
        "type": "Stack",
        "props": { "gap": "none", "grow": true },
        "children": ["memberName", "memberMeta"]
      },
      "memberName": {
        "type": "Text",
        "props": {
          "text": { "$item": "properties/name" },
          "size": "sm",
          "weight": "medium",
          "truncate": true
        }
      },
      "memberMeta": {
        "type": "Caption",
        "props": {
          "text": { "$item": "properties/email" }
        }
      }
    }
  }
}
