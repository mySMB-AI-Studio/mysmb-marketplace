{
  "id": "hubspot-contacts-recent",
  "title": "Recent Contacts",
  "description": "The most recently created HubSpot contacts, in a table layout matching HubSpot's own Contacts view — name, email, phone, and create date.",
  "category": "crm",
  "tags": ["hubspot", "crm", "contacts", "leads"],
  "keywords": ["contacts", "leads", "recent", "new", "table"],
  "connectorsUsed": ["hubspot"],
  "popularity": 65,
  "sizing": {
    "preferred": { "colSpan": 5, "rowSpan": 5 },
    "min": { "colSpan": 3, "rowSpan": 4 },
    "max": { "colSpan": 10, "rowSpan": 10 }
  },
  "dataProvider": {
    "mcp": "hubspot",
    "tool": "search_contacts",
    "params": {
      "properties": ["firstname", "lastname", "email", "phone", "createdate"],
      "sorts": ["createdate DESC"],
      "limit": 20
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "children": ["header", "body"]
      },
      "header": {
        "type": "Header",
        "children": ["titleGroup"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "start" },
        "children": ["titleIcon", "title"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "Users", "tone": "accent", "size": "sm" }
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Recent Contacts", "level": "h2" }
      },
      "body": {
        "type": "Body",
        "children": ["empty", "table"]
      },
      "empty": {
        "type": "Empty",
        "props": { "message": "No contacts found in HubSpot." },
        "visible": {
          "$and": [
            { "$state": "/_loading/hubspot.search_contacts", "not": true },
            { "$state": "/hubspot/search_contacts/items/0", "not": true }
          ]
        }
      },
      "table": {
        "type": "Table",
        "props": {
          "loading": { "$state": "/_loading/hubspot.search_contacts" },
          "skeletonRows": 6,
          "rows": {
            "$computed": "hubspot_contacts_with_full_name",
            "args": { "items": { "$state": "/hubspot/search_contacts/items" } }
          },
          "columns": [
            { "id": "name", "header": "Name", "field": "properties.full_name", "width": 120, "priority": 1 },
            { "id": "email", "header": "Email", "field": "properties.email", "width": 150, "priority": 1 },
            { "id": "phone", "header": "Phone", "field": "properties.phone", "width": 90, "priority": 2 },
            { "id": "created", "header": "Created", "field": "properties.createdate", "width": 80, "priority": 2, "format": "dd_mmm_yy" }
          ]
        },
        "visible": {
          "$or": [
            { "$state": "/_loading/hubspot.search_contacts" },
            { "$state": "/hubspot/search_contacts/items/0" }
          ]
        }
      }
    }
  }
}
