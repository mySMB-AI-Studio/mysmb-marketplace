{
  "id": "hubspot-contacts-recent",
  "title": "Recent Contacts",
  "description": "The most recently created HubSpot contacts with name, company, email, and lifecycle stage.",
  "category": "crm",
  "tags": ["hubspot", "crm", "contacts", "leads"],
  "keywords": ["contacts", "leads", "recent", "new", "lifecycle"],
  "connectorsUsed": ["hubspot"],
  "popularity": 65,
  "sizing": {
    "preferred": { "colSpan": 4, "rowSpan": 5 },
    "min": { "colSpan": 3, "rowSpan": 4 },
    "max": { "colSpan": 10, "rowSpan": 10 }
  },
  "dataProvider": {
    "mcp": "hubspot",
    "tool": "search_crm_objects",
    "params": {
      "objectType": "contacts",
      "properties": ["firstname", "lastname", "email", "company", "lifecyclestage", "createdate"],
      "sorts": [{ "propertyName": "createdate", "direction": "DESCENDING" }],
      "limit": 20
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "children": ["header", "body"]
      },
      "header": {
        "type": "Header",
        "children": ["titleGroup"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "start" },
        "children": ["titleIcon", "title"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "Users", "tone": "accent", "size": "sm" }
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Recent Contacts", "level": "h2" }
      },
      "body": {
        "type": "Body",
        "children": ["loading", "empty", "contactList"]
      },
      "loading": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["sk1", "sk2", "sk3", "sk4"],
        "visible": { "$state": "/_loading/hubspot.search_crm_objects" }
      },
      "sk1": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "sk2": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "sk3": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "sk4": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "empty": {
        "type": "Empty",
        "props": { "message": "No contacts found in HubSpot." },
        "visible": {
          "$and": [
            { "$state": "/_loading/hubspot.search_crm_objects", "not": true },
            { "$state": "/hubspot/search_crm_objects/results/0", "not": true }
          ]
        }
      },
      "contactList": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["contactRow"],
        "repeat": {
          "statePath": "/hubspot/search_crm_objects/results",
          "key": "id"
        },
        "visible": {
          "$and": [
            { "$state": "/_loading/hubspot.search_crm_objects", "not": true },
            { "$state": "/hubspot/search_crm_objects/results/0" }
          ]
        }
      },
      "contactRow": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center", "hover": true },
        "children": ["contactInfo", "stageBadge"]
      },
      "contactInfo": {
        "type": "Stack",
        "props": { "gap": "none", "grow": true },
        "children": ["contactName", "contactMeta"]
      },
      "contactName": {
        "type": "Text",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{first} {last}",
              "first": { "$item": "properties/firstname" },
              "last": { "$item": "properties/lastname" }
            }
          },
          "size": "sm",
          "weight": "medium",
          "truncate": true
        }
      },
      "contactMeta": {
        "type": "Caption",
        "props": {
          "text": { "$item": "properties/company" }
        }
      },
      "stageBadge": {
        "type": "Badge",
        "props": {
          "label": { "$item": "properties/lifecyclestage" },
          "tone": "neutral"
        }
      }
    }
  }
}
