{
  "id": "hubspot-support-tickets",
  "title": "Support Tickets",
  "description": "Recent HubSpot support tickets with subject, pipeline stage, and a colour-coded priority badge. Click a ticket to expand it and see its description, ticket ID, owner, and created date.",
  "category": "support",
  "tags": ["hubspot", "tickets", "support", "helpdesk"],
  "keywords": ["tickets", "support", "helpdesk", "open tickets", "priority", "queue"],
  "connectorsUsed": ["hubspot"],
  "popularity": 60,
  "sizing": {
    "preferred": { "colSpan": 5, "rowSpan": 5 },
    "min": { "colSpan": 3, "rowSpan": 4 },
    "max": { "colSpan": 12, "rowSpan": 10 }
  },
  "dataProvider": {
    "mcp": "hubspot",
    "tool": "search_tickets",
    "params": {
      "properties": ["subject", "content", "hs_pipeline_stage", "hs_ticket_priority", "createdate", "hubspot_owner_id"],
      "sorts": ["createdate DESC"],
      "limit": 20
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "children": ["header", "body"],
        "watch": {
          "/hubspot/search_tickets/items": {
            "action": "hubspot.list_owners",
            "params": { "limit": 100 }
          }
        }
      },
      "header": {
        "type": "Header",
        "children": ["titleGroup"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "start" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "LifeBuoy", "tone": "accent", "size": "sm" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "subtitle"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Support Tickets", "level": "h2" }
      },
      "subtitle": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{n} recent tickets",
              "n": {
                "$computed": "count",
                "args": {
                  "value": { "$state": "/hubspot/search_tickets/items" }
                }
              }
            }
          }
        }
      },
      "body": {
        "type": "Body",
        "children": ["loading", "empty", "ticketList"]
      },
      "loading": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["sk1", "sk2", "sk3", "sk4"],
        "visible": { "$state": "/_loading/hubspot.search_tickets" }
      },
      "sk1": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "sk2": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "sk3": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "sk4": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "empty": {
        "type": "Empty",
        "props": { "message": "No tickets found in HubSpot." },
        "visible": {
          "$and": [
            { "$state": "/_loading/hubspot.search_tickets", "not": true },
            { "$state": "/hubspot/search_tickets/items/0", "not": true }
          ]
        }
      },
      "ticketList": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["ticketRow"],
        "repeat": {
          "statePath": "/hubspot/search_tickets/items",
          "key": "id"
        },
        "visible": {
          "$and": [
            { "$state": "/_loading/hubspot.search_tickets", "not": true },
            { "$state": "/hubspot/search_tickets/items/0" }
          ]
        }
      },
      "ticketRow": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["ticketTopRow", "ticketDetail"]
      },
      "ticketTopRow": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center", "justify": "between", "hover": true, "clickable": true },
        "children": ["ticketLeft", "priorityBadge"],
        "on": {
          "click": {
            "action": "setState",
            "params": {
              "statePath": "/ui/selectedTicketId",
              "value": {
                "$cond": { "$item": "id", "eq": { "$state": "/ui/selectedTicketId" } },
                "$then": "",
                "$else": { "$item": "id" }
              }
            }
          }
        }
      },
      "ticketLeft": {
        "type": "Stack",
        "props": { "gap": "none", "grow": true },
        "children": ["ticketSubject", "ticketMeta"]
      },
      "ticketSubject": {
        "type": "Text",
        "props": {
          "text": { "$item": "properties/subject" },
          "size": "sm",
          "weight": "medium",
          "truncate": true
        }
      },
      "ticketMeta": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "hubspot_ticket_stage_label",
            "args": { "value": { "$item": "properties/hs_pipeline_stage" } }
          }
        }
      },
      "priorityBadge": {
        "type": "Badge",
        "props": {
          "text": {
            "$computed": "hubspot_ticket_priority_label",
            "args": { "value": { "$item": "properties/hs_ticket_priority" } }
          },
          "tone": {
            "$computed": "hubspot_ticket_priority_tone",
            "args": { "value": { "$item": "properties/hs_ticket_priority" } }
          }
        }
      },
      "ticketDetail": {
        "type": "Section",
        "props": { "variant": "muted" },
        "visible": { "$item": "id", "eq": { "$state": "/ui/selectedTicketId" } },
        "children": ["ticketDetailMeta", "ticketDetailText"]
      },
      "ticketDetailMeta": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["ticketDetailId", "ticketDetailOwner", "ticketDetailCreated"]
      },
      "ticketDetailId": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "Ticket ID: {id}",
              "id": { "$item": "id" }
            }
          }
        }
      },
      "ticketDetailOwner": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "Owner: {name}",
              "name": {
                "$computed": "hubspot_ticket_owner_name",
                "args": {
                  "ownerId": { "$item": "properties/hubspot_owner_id" },
                  "owners": { "$state": "/hubspot/list_owners/items" }
                }
              }
            }
          }
        }
      },
      "ticketDetailCreated": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "Created: {date}",
              "date": {
                "$computed": "hubspot_format_date",
                "args": { "value": { "$item": "properties/createdate" } }
              }
            }
          }
        }
      },
      "ticketDetailText": {
        "type": "Text",
        "props": {
          "text": {
            "$computed": "hubspot_ticket_content_or_fallback",
            "args": { "value": { "$item": "properties/content" } }
          },
          "size": "sm",
          "tone": "muted",
          "preserveLines": true
        }
      }
    }
  }
}
