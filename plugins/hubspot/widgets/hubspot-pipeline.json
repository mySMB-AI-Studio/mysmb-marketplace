{
  "id": "hubspot-pipeline",
  "title": "Deals Pipeline",
  "description": "Open deals grouped by pipeline stage — count and total deal value per stage.",
  "category": "crm",
  "tags": ["hubspot", "crm", "deals", "pipeline", "sales"],
  "keywords": ["deals", "pipeline", "stage", "forecast", "revenue"],
  "connectorsUsed": ["hubspot"],
  "popularity": 72,
  "sizing": {
    "preferred": { "colSpan": 4, "rowSpan": 5 },
    "min": { "colSpan": 3, "rowSpan": 4 },
    "max": { "colSpan": 10, "rowSpan": 10 }
  },
  "dataProvider": {
    "mcp": "hubspot",
    "tool": "search_crm_objects",
    "params": {
      "objectType": "deals",
      "filterGroups": [
        {
          "filters": [
            { "propertyName": "dealstage", "operator": "NEQ", "value": "closedwon" },
            { "propertyName": "dealstage", "operator": "NEQ", "value": "closedlost" }
          ]
        }
      ],
      "properties": ["dealname", "dealstage", "amount", "closedate", "hubspot_owner_id"],
      "limit": 200
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "children": ["header", "body"]
      },
      "header": {
        "type": "Header",
        "children": ["titleGroup"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "start" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "TrendingUp", "tone": "accent", "size": "sm" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "subtitle"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Deals Pipeline", "level": "h2" }
      },
      "subtitle": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{n} open deals",
              "n": {
                "$computed": "count",
                "args": {
                  "value": { "$state": "/hubspot/search_crm_objects/results" }
                }
              }
            }
          }
        }
      },
      "body": {
        "type": "Body",
        "children": ["loading", "empty", "stageList"]
      },
      "loading": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["sk1", "sk2", "sk3", "sk4", "sk5"],
        "visible": { "$state": "/_loading/hubspot.search_crm_objects" }
      },
      "sk1": { "type": "Skeleton", "props": { "height": "2rem", "rounded": "md" } },
      "sk2": { "type": "Skeleton", "props": { "height": "2rem", "rounded": "md" } },
      "sk3": { "type": "Skeleton", "props": { "height": "2rem", "rounded": "md" } },
      "sk4": { "type": "Skeleton", "props": { "height": "2rem", "rounded": "md" } },
      "sk5": { "type": "Skeleton", "props": { "height": "2rem", "rounded": "md" } },
      "empty": {
        "type": "Empty",
        "props": { "message": "No open deals found in HubSpot." },
        "visible": {
          "$and": [
            { "$state": "/_loading/hubspot.search_crm_objects", "not": true },
            { "$state": "/hubspot/search_crm_objects/results/0", "not": true }
          ]
        }
      },
      "stageList": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["stageRow"],
        "repeat": {
          "statePath": "/hubspot/search_crm_objects/results",
          "key": "id"
        },
        "visible": {
          "$and": [
            { "$state": "/_loading/hubspot.search_crm_objects", "not": true },
            { "$state": "/hubspot/search_crm_objects/results/0" }
          ]
        }
      },
      "stageRow": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center", "justify": "between", "hover": true },
        "children": ["stageLeft", "stageRight"]
      },
      "stageLeft": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["dealName", "stageMeta"]
      },
      "dealName": {
        "type": "Text",
        "props": {
          "text": { "$item": "properties/dealname" },
          "size": "sm",
          "weight": "medium",
          "truncate": true
        }
      },
      "stageMeta": {
        "type": "Caption",
        "props": {
          "text": { "$item": "properties/dealstage" }
        }
      },
      "stageRight": {
        "type": "Text",
        "props": {
          "text": {
            "$computed": "format_currency",
            "args": {
              "value": { "$item": "properties/amount" }
            }
          },
          "size": "sm",
          "weight": "semibold"
        }
      }
    }
  }
}
