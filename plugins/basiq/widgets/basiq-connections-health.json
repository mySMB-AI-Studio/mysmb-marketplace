{
  "id": "basiq-connections-health",
  "title": "Basiq — Connections Health",
  "description": "Bank connection health at a glance — success, running, and failed counts with overall status and last refresh time.",
  "category": "finance",
  "tags": ["basiq", "connections", "banking", "health", "open-banking"],
  "keywords": ["connections", "bank", "health", "success", "failed", "running", "basiq", "open banking"],
  "connectorsUsed": ["basiq"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 4, "rowSpan": 3 },
    "min": { "colSpan": 3, "rowSpan": 3 },
    "max": { "colSpan": 6, "rowSpan": 4 }
  },
  "dataProvider": {
    "mcp": "basiq",
    "tool": "get_jobs",
    "params": {}
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": ["header", "body"]
      },

      "header": {
        "type": "Header",
        "children": ["titleGroup", "connectBtn"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIconBox", "titleStack"]
      },
      "titleIconBox": {
        "type": "Section",
        "props": { "tone": "info" },
        "children": ["titleIcon"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "Wifi", "tone": "info", "size": "md" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "eyebrow"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Connections Health", "level": "h2" }
      },
      "eyebrow": {
        "type": "Eyebrow",
        "props": { "text": "Basiq", "tone": "info" }
      },
      "connectBtn": {
        "type": "Button",
        "props": { "label": "Connect", "variant": "ghost", "size": "sm", "tone": "info" },
        "on": { "click": [{ "action": "open_url", "params": { "url": "https://dashboard.basiq.io" } }] }
      },

      "body": {
        "type": "Body",
        "props": {},
        "children": ["loading", "content"]
      },

      "loading": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["sk1", "sk2"],
        "visible": { "$state": "/_loading/basiq.get_jobs" }
      },
      "sk1": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "sk2": { "type": "Skeleton", "props": { "height": "1.5rem", "rounded": "md" } },

      "content": {
        "type": "Stack",
        "props": { "gap": "md" },
        "children": ["statsRow", "footerRow"],
        "visible": { "$state": "/_loading/basiq.get_jobs", "not": true }
      },

      "statsRow": {
        "type": "Grid",
        "props": { "cols": 3, "gap": "md" },
        "children": ["successCol", "runningCol", "failedCol"]
      },

      "successCol": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["successVal", "successMeta"]
      },
      "successVal": {
        "type": "Stat",
        "props": { "value": { "$state": "/basiq/get_jobs/success_count" }, "size": "lg", "tone": "success" }
      },
      "successMeta": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["successDot", "successLbl"]
      },
      "successDot": { "type": "Dot", "props": { "tone": "success" } },
      "successLbl": { "type": "Caption", "props": { "text": "Success" } },

      "runningCol": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["runningVal", "runningMeta"]
      },
      "runningVal": {
        "type": "Stat",
        "props": { "value": { "$state": "/basiq/get_jobs/running_count" }, "size": "lg", "tone": "info" }
      },
      "runningMeta": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["runningDot", "runningLbl"]
      },
      "runningDot": { "type": "Dot", "props": { "tone": "info" } },
      "runningLbl": { "type": "Caption", "props": { "text": "Running" } },

      "failedCol": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["failedVal", "failedMeta"]
      },
      "failedVal": {
        "type": "Stat",
        "props": { "value": { "$state": "/basiq/get_jobs/failed_count" }, "size": "lg", "tone": "destructive" }
      },
      "failedMeta": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["failedDot", "failedLbl"]
      },
      "failedDot": { "type": "Dot", "props": { "tone": "destructive" } },
      "failedLbl": { "type": "Caption", "props": { "text": "Failed" } },

      "footerRow": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["healthBadge", "refreshLbl", "refreshTime"]
      },
      "healthBadge": {
        "type": "Badge",
        "props": {
          "label": { "$state": "/basiq/get_jobs/overall_status_label" },
          "tone": { "$state": "/basiq/get_jobs/overall_status_tone" }
        }
      },
      "refreshLbl": {
        "type": "Caption",
        "props": { "text": "last refresh" }
      },
      "refreshTime": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "relative_time",
            "args": { "value": { "$state": "/basiq/get_jobs/last_updated" } }
          }
        }
      }
    }
  },
  "status": "draft"
}
