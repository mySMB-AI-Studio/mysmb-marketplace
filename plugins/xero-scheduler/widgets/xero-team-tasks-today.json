{
  "id": "xero-team-tasks-today",
  "title": "Team Tasks Today",
  "description": "All active tasks due today across every in-progress Xero project — a shared daily work queue for managers to track team workload and progress.",
  "category": "productivity",
  "tags": [
    "xero",
    "tasks",
    "team",
    "today",
    "workload",
    "projects",
    "collaboration",
    "scheduler"
  ],
  "keywords": [
    "tasks",
    "team",
    "today",
    "workload",
    "progress",
    "projects",
    "active",
    "due",
    "scheduler",
    "work queue",
    "billable",
    "time"
  ],
  "connectorsUsed": [
    "xero-scheduler"
  ],
  "popularity": 0,
  "sizing": {
    "preferred": {
      "colSpan": 6,
      "rowSpan": 6
    },
    "min": {
      "colSpan": 4,
      "rowSpan": 5
    },
    "max": {
      "colSpan": 12,
      "rowSpan": 12
    }
  },
  "dataProvider": {
    "mcp": "xero-scheduler",
    "tool": "list_all_tasks",
    "params": {
      "deadlineDate": "$today",
      "taskStatus": "ACTIVE"
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "children": [
          "header",
          "body"
        ]
      },
      "header": {
        "type": "Header",
        "children": [
          "titleGroup"
        ]
      },
      "titleGroup": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "start"
        },
        "children": [
          "titleIcon",
          "titleStack"
        ]
      },
      "titleIcon": {
        "type": "Icon",
        "props": {
          "name": "ClipboardCheck",
          "tone": "accent",
          "size": "sm"
        }
      },
      "titleStack": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "children": [
          "title",
          "eyebrow"
        ]
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "Team Tasks Today",
          "level": "h2"
        }
      },
      "eyebrow": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{tasks} tasks · {projects} projects",
              "tasks": {
                "$state": "/xero-scheduler/list_all_tasks/taskCount"
              },
              "projects": {
                "$state": "/xero-scheduler/list_all_tasks/projectCount"
              }
            }
          }
        },
        "visible": {
          "$state": "/xero-scheduler/list_all_tasks/tasks/0"
        }
      },
      "body": {
        "type": "Body",
        "children": [
          "noTasks",
          "summary",
          "taskTable",
          "footer",
          "taskOverlay"
        ]
      },
      "noTasks": {
        "type": "Empty",
        "props": {
          "message": "No active tasks due today — team is ahead of schedule."
        },
        "visible": {
          "$and": [
            {
              "$state": "/_loading/xero-scheduler.list_all_tasks",
              "not": true
            },
            {
              "$state": "/xero-scheduler/list_all_tasks/tasks/0",
              "not": true
            }
          ]
        }
      },
      "summary": {
        "type": "Section",
        "props": {
          "variant": "muted"
        },
        "children": [
          "summaryRow"
        ],
        "visible": {
          "$state": "/xero-scheduler/list_all_tasks/tasks/0"
        }
      },
      "summaryRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center"
        },
        "children": [
          "summaryLabel",
          "summaryBar",
          "summaryPct"
        ]
      },
      "summaryLabel": {
        "type": "Caption",
        "props": {
          "text": "Team progress"
        }
      },
      "summaryBar": {
        "type": "ProgressBar",
        "props": {
          "value": {
            "$computed": "pct",
            "args": {
              "part": {
                "$computed": "sum",
                "args": {
                  "value": {
                    "$state": "/xero-scheduler/list_all_tasks/tasks"
                  },
                  "field": "totalMinutes"
                }
              },
              "whole": {
                "$computed": "sum",
                "args": {
                  "value": {
                    "$state": "/xero-scheduler/list_all_tasks/tasks"
                  },
                  "field": "estimateMinutes"
                }
              }
            }
          },
          "tone": "accent"
        }
      },
      "summaryPct": {
        "type": "Text",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{n}%",
              "n": {
                "$computed": "pct",
                "args": {
                  "part": {
                    "$computed": "sum",
                    "args": {
                      "value": {
                        "$state": "/xero-scheduler/list_all_tasks/tasks"
                      },
                      "field": "totalMinutes"
                    }
                  },
                  "whole": {
                    "$computed": "sum",
                    "args": {
                      "value": {
                        "$state": "/xero-scheduler/list_all_tasks/tasks"
                      },
                      "field": "estimateMinutes"
                    }
                  }
                }
              }
            }
          },
          "size": "sm",
          "weight": "medium"
        }
      },
      "taskTable": {
        "type": "Table",
        "props": {
          "loading": {
            "$state": "/_loading/xero-scheduler.list_all_tasks"
          },
          "skeletonRows": 6,
          "rows": {
            "$state": "/xero-scheduler/list_all_tasks/tasks"
          },
          "rowAction": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/task/name"
              },
              "fromRow": {
                "value": "name"
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/task/projectName"
              },
              "fromRow": {
                "value": "projectName"
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/task/projectDeadline"
              },
              "fromRow": {
                "value": "projectDeadline"
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/task/status"
              },
              "fromRow": {
                "value": "status"
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/task/chargeType"
              },
              "fromRow": {
                "value": "chargeType"
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/task/estimateMinutes"
              },
              "fromRow": {
                "value": "estimateMinutes"
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/task/totalMinutes"
              },
              "fromRow": {
                "value": "totalMinutes"
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/task/rateValue"
              },
              "fromRow": {
                "value": "rate.value"
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/task/currency"
              },
              "fromRow": {
                "value": "totalAmount.currency"
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/task/totalAmountValue"
              },
              "fromRow": {
                "value": "totalAmount.value"
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/task/amountToBeInvoicedValue"
              },
              "fromRow": {
                "value": "amountToBeInvoiced.value"
              }
            }
          ],
          "columns": [
            {
              "id": "name",
              "header": "Task",
              "field": "name",
              "width": 160,
              "priority": 1
            },
            {
              "id": "project",
              "header": "Project",
              "field": "projectName",
              "width": 140,
              "priority": 1
            },
            {
              "id": "type",
              "header": "Type",
              "field": "chargeType",
              "variant": "badge",
              "toneFormat": "xero_chargetype",
              "width": 110,
              "priority": 3
            },
            {
              "id": "status",
              "header": "Status",
              "field": "status",
              "variant": "badge",
              "toneFormat": "xero_projects_status",
              "width": 100,
              "priority": 2
            },
            {
              "id": "est",
              "header": "Est",
              "field": "estimateMinutes",
              "format": "xero_minutes",
              "align": "right",
              "width": 70,
              "priority": 3
            },
            {
              "id": "logged",
              "header": "Logged",
              "field": "totalMinutes",
              "format": "xero_minutes",
              "align": "right",
              "width": 80,
              "priority": 2
            },
            {
              "id": "amount",
              "header": "Amount",
              "field": "totalAmount.value",
              "format": "currency",
              "align": "right",
              "width": 90,
              "priority": 2
            },
            {
              "id": "toinvoice",
              "header": "To invoice",
              "field": "amountToBeInvoiced.value",
              "format": "currency",
              "align": "right",
              "width": 100,
              "priority": 3
            }
          ]
        }
      },
      "footer": {
        "type": "Row",
        "props": {
          "justify": "end",
          "gap": "xs",
          "align": "center"
        },
        "children": [
          "footerBtn"
        ],
        "visible": {
          "$state": "/xero-scheduler/list_all_tasks/tasks/0"
        }
      },
      "footerBtn": {
        "type": "Button",
        "props": {
          "label": "Open in Xero",
          "variant": "ghost",
          "size": "sm",
          "leadingIcon": "ExternalLink"
        },
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "url": "https://go.xero.com/app/projects",
              "target": "_blank"
            }
          }
        }
      },
      "taskOverlay": {
        "type": "Overlay",
        "props": {
          "maxWidth": "26rem"
        },
        "visible": {
          "$state": "/ui/task/name"
        },
        "on": {
          "backdropClick": {
            "action": "setState",
            "params": {
              "statePath": "/ui/task/name",
              "value": ""
            }
          }
        },
        "children": [
          "overlayHeader",
          "overlayProject",
          "overlayMeta",
          "overlayDiv1",
          "overlayTimeCaption",
          "overlayEstKV",
          "overlayLoggedKV",
          "overlayTimeBar",
          "overlayDiv2",
          "overlayBillingCaption",
          "overlayRateKV",
          "overlayTotalKV",
          "overlayToInvoiceKV"
        ]
      },
      "overlayHeader": {
        "type": "Row",
        "props": {
          "justify": "between",
          "align": "center"
        },
        "children": [
          "overlayName",
          "overlayClose"
        ]
      },
      "overlayName": {
        "type": "Heading",
        "props": {
          "text": {
            "$state": "/ui/task/name"
          },
          "level": "h3"
        }
      },
      "overlayClose": {
        "type": "OverlayClose",
        "on": {
          "click": {
            "action": "setState",
            "params": {
              "statePath": "/ui/task/name",
              "value": ""
            }
          }
        }
      },
      "overlayProject": {
        "type": "Caption",
        "props": {
          "text": {
            "$state": "/ui/task/projectName"
          }
        }
      },
      "overlayMeta": {
        "type": "Row",
        "props": {
          "gap": "xs",
          "align": "center"
        },
        "children": [
          "overlayStatusBadge",
          "overlayTypeBadge"
        ]
      },
      "overlayStatusBadge": {
        "type": "Badge",
        "props": {
          "text": {
            "$state": "/ui/task/status"
          }
        }
      },
      "overlayTypeBadge": {
        "type": "Badge",
        "props": {
          "text": {
            "$state": "/ui/task/chargeType"
          }
        }
      },
      "overlayDiv1": {
        "type": "Divider"
      },
      "overlayTimeCaption": {
        "type": "Caption",
        "props": {
          "text": "Time"
        }
      },
      "overlayEstKV": {
        "type": "KeyValue",
        "props": {
          "label": "Estimated",
          "value": {
            "$computed": "xero_minutes",
            "args": {
              "value": {
                "$state": "/ui/task/estimateMinutes"
              }
            }
          }
        }
      },
      "overlayLoggedKV": {
        "type": "KeyValue",
        "props": {
          "label": "Logged",
          "value": {
            "$computed": "xero_minutes",
            "args": {
              "value": {
                "$state": "/ui/task/totalMinutes"
              }
            }
          }
        }
      },
      "overlayTimeBar": {
        "type": "ProgressBar",
        "props": {
          "tone": "accent",
          "value": {
            "$computed": "pct",
            "args": {
              "part": {
                "$state": "/ui/task/totalMinutes"
              },
              "whole": {
                "$state": "/ui/task/estimateMinutes"
              }
            }
          }
        }
      },
      "overlayDiv2": {
        "type": "Divider"
      },
      "overlayBillingCaption": {
        "type": "Caption",
        "props": {
          "text": "Billing"
        }
      },
      "overlayRateKV": {
        "type": "KeyValue",
        "props": {
          "label": "Rate / hr",
          "value": {
            "$computed": "format_currency",
            "args": {
              "value": {
                "$state": "/ui/task/rateValue"
              },
              "currency": {
                "$state": "/ui/task/currency"
              }
            }
          }
        },
        "visible": {
          "$state": "/ui/task/rateValue"
        }
      },
      "overlayTotalKV": {
        "type": "KeyValue",
        "props": {
          "label": "Total",
          "value": {
            "$computed": "format_currency",
            "args": {
              "value": {
                "$state": "/ui/task/totalAmountValue"
              },
              "currency": {
                "$state": "/ui/task/currency"
              }
            }
          }
        }
      },
      "overlayToInvoiceKV": {
        "type": "KeyValue",
        "props": {
          "label": "To invoice",
          "value": {
            "$computed": "format_currency",
            "args": {
              "value": {
                "$state": "/ui/task/amountToBeInvoicedValue"
              },
              "currency": {
                "$state": "/ui/task/currency"
              }
            }
          }
        }
      }
    }
  },
  "status": "draft"
}
