{
  "contentHash": "96086e3602cde39e682619d20fde0caf09fc478a970d0bddd3cbe67020adeee0",
  "definition": {
    "capabilities": [
      "accounting.read_invoices",
      "accounting.post_adjustment",
      "workq.create"
    ],
    "description": "Matches an invoice to the payment received against it, works out any difference exactly, asks a named reviewer how to treat a short payment, and ends either reconciled or with a documented exception. The agent only reads the ledger; nothing is posted without a recorded decision.",
    "exceptions": [
      {
        "allowedPaths": [
          "treatment",
          "followUp",
          "documentedException"
        ],
        "blocks": [
          "reconciled"
        ],
        "key": "paymentNotInLedger"
      }
    ],
    "inputs": [
      {
        "freshness": {
          "live": true,
          "maxAgeMinutes": 60
        },
        "key": "invoiceRef",
        "label": "Invoice reference",
        "required": true,
        "type": "string"
      },
      {
        "freshness": {
          "live": true,
          "maxAgeMinutes": 60
        },
        "key": "paymentRef",
        "label": "Payment reference",
        "required": true,
        "type": "string"
      },
      {
        "key": "ledgerEvidence",
        "label": "Ledger or bank extract",
        "required": false,
        "type": "evidence"
      }
    ],
    "key": "invoice-reconciliation",
    "kind": "process",
    "limits": {
      "maxActiveHours": 1,
      "maxAgentTurnsPerStep": 6,
      "maxAiUnits": 200,
      "maxSteps": 30,
      "maxWaitingDays": 30
    },
    "modelPolicy": {
      "brief": "haiku",
      "judgement": "sonnet",
      "plan": "sonnet"
    },
    "originKey": "7525b98b-bddd-4fa3-b152-17f0b8fd4f72",
    "outcomes": [
      {
        "evidence": [
          "reconciled_balance",
          "ledger_extract"
        ],
        "key": "reconciled",
        "terminal": true
      },
      {
        "evidence": [
          "exception_note",
          "decision_record"
        ],
        "key": "documentedException",
        "terminal": true
      },
      {
        "evidence": [
          "decision_record"
        ],
        "key": "cancelled",
        "terminal": true
      }
    ],
    "protectedRules": [
      {
        "description": "No adjustment is posted to the ledger until a reviewer has recorded a decision that still matches the amount and the invoice version.",
        "key": "noAdjustmentWithoutDecision"
      },
      {
        "description": "The agent only reads the ledger. Postings happen only through the post-adjustment capability, after a decision.",
        "key": "agentReadsLedgerOnly"
      }
    ],
    "rework": [
      {
        "from": "followUp",
        "requires": "reviewer",
        "to": "match"
      }
    ],
    "roles": {
      "accountOwner": {
        "group": "{{settings.account_owner_group}}"
      },
      "manager": "installation.manager",
      "reviewer": "installation.reviewer"
    },
    "safeTest": {
      "assertions": [
        "steps.match.invoice != null",
        "steps.checkDifference.balanced != null"
      ],
      "sampleInputs": {
        "invoiceRef": "INV-SAMPLE-0001",
        "paymentRef": "PAY-SAMPLE-0001"
      }
    },
    "schemaVersion": 1,
    "steps": [
      {
        "key": "match",
        "kind": "agent",
        "outputs": [
          "invoice",
          "payment",
          "ledgerExtract"
        ],
        "proposalSchema": "invoicePaymentMatch",
        "skill": "match-invoice-and-payment",
        "title": "Match invoice and payment"
      },
      {
        "automation": "3f96e10b-afbc-4b32-b9ba-c89d8da51435",
        "inputs": {
          "account_code": "{{settings.write_off_account_code}}",
          "invoice": "steps.match.invoice",
          "payment": "steps.match.payment",
          "threshold": "{{writeOffThreshold}}"
        },
        "key": "checkDifference",
        "kind": "automation",
        "title": "Work out the difference exactly"
      },
      {
        "eligible": [
          "reviewer"
        ],
        "key": "treatment",
        "kind": "decision",
        "materiality": [
          "steps.checkDifference.difference",
          "steps.match.invoice.version"
        ],
        "options": [
          {
            "effect": "Leaves the invoice unchanged and raises a follow-up for the account owner. Nothing is posted.",
            "key": "keep-open-investigate",
            "label": "Keep the invoice open and investigate"
          },
          {
            "effect": "Raises a follow-up for the account owner to review a possible credit note with the customer. Nothing is posted.",
            "key": "credit-note-review",
            "label": "Send to credit-note review"
          },
          {
            "effect": "Sends the match back to the agent with your note. Nothing is posted.",
            "key": "revise",
            "label": "Ask for a closer match",
            "transition": "match"
          },
          {
            "effect": "Posts a credit note for the shortfall to the ledger. Available only when the shortfall is within the write-off threshold. This changes the books; reversing it is a manual step in the ledger.",
            "intent": {
              "capability": "accounting.post_adjustment",
              "payloadFrom": "steps.checkDifference.credit_note"
            },
            "key": "post-approved-adjustment",
            "label": "Post approved adjustment (financial)"
          }
        ],
        "separation": "preparerCannotDecide",
        "sla": {
          "escalateTo": "installation.manager",
          "expireAfterBusinessDays": 7,
          "remindAfterBusinessDays": 2
        },
        "title": "Decide how to treat the difference",
        "type": "short_payment_treatment"
      },
      {
        "assign": "accountOwner",
        "completion": "formSubmitted",
        "form": "f6c64ebb-f41d-4821-9af7-7d2c314a8b7c",
        "key": "followUp",
        "kind": "human",
        "template": "656d7222-e064-4e1c-9b9b-4f9356b12a33",
        "title": "Follow up and record the outcome"
      },
      {
        "evidence": [
          "steps.match.ledgerExtract",
          "steps.checkDifference.difference"
        ],
        "key": "reconciled",
        "kind": "gate",
        "outcome": "reconciled",
        "requires": [
          "steps.checkDifference.balanced || steps.followUp.answers.q_balanced"
        ],
        "title": "Reconciled"
      },
      {
        "evidence": [
          "steps.followUp.answers.q_note",
          "steps.treatment.responseId"
        ],
        "key": "documentedException",
        "kind": "gate",
        "outcome": "documentedException",
        "requires": [
          "steps.followUp.answers.q_note"
        ],
        "title": "Documented exception"
      }
    ],
    "subject": {
      "dedupeBy": [
        "invoiceRef",
        "paymentRef"
      ],
      "kind": "none"
    },
    "tests": [
      "79ccea48-7aef-4aaa-b20f-54429b229e58"
    ],
    "title": "Invoice reconciliation",
    "transitions": [
      {
        "from": "match",
        "to": "treatment",
        "when": "steps.match.invoice == null || steps.match.payment == null"
      },
      {
        "from": "match",
        "to": "checkDifference"
      },
      {
        "from": "checkDifference",
        "to": "reconciled",
        "when": "steps.checkDifference.balanced"
      },
      {
        "from": "checkDifference",
        "to": "treatment",
        "when": "!steps.checkDifference.balanced"
      },
      {
        "from": "treatment",
        "to": "followUp",
        "when": "steps.treatment.decision != 'revise'"
      },
      {
        "from": "followUp",
        "to": "reconciled",
        "when": "steps.followUp.answers.q_balanced"
      },
      {
        "from": "followUp",
        "to": "documentedException",
        "when": "!steps.followUp.answers.q_balanced"
      }
    ],
    "variationPoints": [
      {
        "default": 50,
        "editableBy": "manager",
        "key": "writeOffThreshold",
        "max": 5000,
        "min": 0,
        "type": "number"
      }
    ],
    "version": "0.1.0",
    "vocabulary": {
      "subject": "Invoice"
    }
  },
  "kind": "process",
  "name": "Invoice reconciliation",
  "originKey": "7525b98b-bddd-4fa3-b152-17f0b8fd4f72"
}
