          "steps.check.findings"
        ],
        "options": [
          {
            "effect": "Passes the bill to the internal reviewer. Nothing changes in Xero yet.",
            "key": "approve",
            "label": "Approve and send to the internal reviewer",
            "suggested": true
          },
          {
            "effect": "Sends the bill back to the agent with your note. Nothing changes in Xero.",
            "key": "changes",
            "label": "Change something first",
            "transition": "prepareInXero"
          },
          {
            "effect": "Ends the job and leaves the bill exactly as it is in Xero.",
            "key": "leave",
            "label": "Leave it for me in Xero"
          }
        ],
        "separation": "preparerCannotDecide",
        "sla": {
          "escalateTo": "installation.manager",
          "expireAfterBusinessDays": 10,
          "remindAfterBusinessDays": "{{reminderDays}}"
        },
        "title": "Bookkeeper approves the bill in Xero",
        "type": "bill_approval"
      },
      {
        "eligible": [
          "manager",
          "backupManager"
        ],
        "key": "secondReviewInXero",
        "kind": "decision",
        "materiality": [
          "steps.prepareInXero.xeroUpdate",
          "steps.prepareInXero.findings",
          "steps.check.findings"
        ],
        "options": [
          {
            "effect": "Updates the bill in the client's Xero with the corrected coding shown and moves it to Awaiting Payment. Amounts aren't changed.",
            "intent": {
              "capability": "xero.bill.update",
              "payloadFrom": "steps.prepareInXero.xeroUpdate"
            },
            "key": "approve",
            "label": "Apply the corrections and approve in Xero",
            "suggested": true
          },
          {
            "effect": "Sends the bill back to the agent with your note. Nothing changes in Xero.",
            "key": "changes",
            "label": "Change something first",
            "transition": "prepareInXero"
          },
          {
            "effect": "Ends the job and leaves the bill exactly as it is in Xero.",
            "key": "leave",
            "label": "Leave it for me in Xero"
          }
        ],
        "separation": "preparerCannotDecide",
        "sla": {
          "expireAfterBusinessDays": 10,
          "remindAfterBusinessDays": "{{reminderDays}}"
        },
        "title": "Internal reviewer approves the bill in Xero",
        "type": "bill_approval"
      },
      {
        "assign": "reviewer",
        "completion": "statusDone",
        "key": "lookAtFindings",
        "kind": "human",
        "title": "Look at what the agent flagged and fix it in Xero if needed"
      },
      {
        "evidence": [
          "steps.review.responseId",
          "steps.prepare.xeroBill"
        ],
        "key": "entered",
        "kind": "gate",
        "outcome": "entered",
        "requires": [
          "steps.review.decision == 'enter'"
        ],
        "title": "Bill entered in Xero"
      },
      {
        "evidence": [
          "steps.firstReview.responseId",
          "steps.secondReview.responseId",
          "steps.prepare.xeroBill"
        ],
        "key": "enteredAfterSecondReview",
        "kind": "gate",
        "outcome": "entered",
        "requires": [
          "steps.secondReview.decision == 'enter'"
        ],
        "title": "Bill entered in Xero after internal review"
      },
      {
        "evidence": [
          "steps.review.responseId"
        ],
        "key": "rejectedAtReview",
        "kind": "gate",
        "outcome": "rejected",
        "requires": [
          "steps.review.decision == 'reject'"
        ],
        "title": "Not entered"
      },
      {
        "evidence": [
          "steps.firstReview.responseId"
        ],
        "key": "rejectedAtFirstReview",
        "kind": "gate",
        "outcome": "rejected",
        "requires": [
          "steps.firstReview.decision == 'reject'"
        ],
        "title": "Not entered (bookkeeper)"
      },
      {
        "evidence": [
          "steps.secondReview.responseId"
        ],
        "key": "rejectedAtSecondReview",
        "kind": "gate",
        "outcome": "rejected",
        "requires": [
          "steps.secondReview.decision == 'reject'"
        ],
        "title": "Not entered (internal reviewer)"
      },
      {
        "evidence": [
          "steps.approveInXero.responseId",
          "steps.prepareInXero.xeroUpdate"
        ],
        "key": "approvedInXero",
        "kind": "gate",
        "outcome": "approvedInXero",
        "requires": [
          "steps.approveInXero.decision == 'approve'"
        ],
        "title": "Corrected and approved in Xero"
      },
      {
        "evidence": [
          "steps.firstReviewInXero.responseId",
          "steps.secondReviewInXero.responseId",
          "steps.prepareInXero.xeroUpdate"
        ],
        "key": "approvedInXeroAfterReview",
        "kind": "gate",
        "outcome": "approvedInXero",
        "requires": [
          "steps.secondReviewInXero.decision == 'approve'"
        ],
        "title": "Corrected and approved in Xero after internal review"
      },
      {
        "evidence": [
          "steps.approveInXero.responseId"
        ],
        "key": "leftInXero",
        "kind": "gate",
        "outcome": "leftInXero",
        "requires": [
          "steps.approveInXero.decision == 'leave'"
        ],
        "title": "Left for the bookkeeper in Xero"
      },
      {
        "evidence": [
          "steps.firstReviewInXero.responseId"
        ],
        "key": "leftInXeroAtFirstReview",
        "kind": "gate",
        "outcome": "leftInXero",
        "requires": [
          "steps.firstReviewInXero.decision == 'leave'"
        ],
        "title": "Left for the bookkeeper in Xero"
      },
      {
        "evidence": [
          "steps.secondReviewInXero.responseId"
        ],
        "key": "leftInXeroAtSecondReview",
        "kind": "gate",
        "outcome": "leftInXero",
        "requires": [
          "steps.secondReviewInXero.decision == 'leave'"
        ],
        "title": "Left for the bookkeeper in Xero"
      },
      {
        "evidence": [
          "steps.prepareInXero.codingSummary"
        ],
        "key": "checkedClean",
        "kind": "gate",
        "outcome": "checked",
        "requires": [
          "steps.prepareInXero.clean == true"
        ],
        "title": "Checked: nothing to fix"
      },
      {
        "evidence": [
          "steps.prepareInXero.findings",
          "steps.check.findings"
        ],
        "key": "findingsOwned",
        "kind": "gate",
        "outcome": "findingsOwned",
        "requires": [
          "steps.lookAtFindings.completed == true"
        ],
        "title": "Flagged items looked at"
      },
      {
        "evidence": [
          "steps.check.duplicateOf"
        ],
        "key": "duplicate",
        "kind": "gate",
        "outcome": "duplicate",
        "requires": [
          "steps.check.duplicate == true"
        ],
        "title": "Already in Xero"
      },
      {
        "evidence": [
          "steps.check.problem",
          "steps.check.summary"
        ],
        "key": "needsAttention",
        "kind": "gate",
        "outcome": "needsAttention",
        "requires": [
          "steps.check.ready == false"
        ],
        "title": "Needs a person"
      }
    ],
    "subject": {
      "dedupeBy": [
        "billRecordId"
      ],
      "kind": "none"
    },
    "title": "Enter a supplier bill",
    "transitions": [
      {
        "from": "check",
        "to": "needsAttention",
        "when": "steps.check.ready == false"
      },
      {
        "from": "check",
        "to": "duplicate",
        "when": "steps.check.ready == true && steps.check.duplicate == true"
      },
      {
        "from": "check",
        "to": "prepare",
        "when": "steps.check.ready == true && steps.check.duplicate == false && steps.check.inXero != true"
      },
      {
        "from": "check",
        "to": "prepareInXero",
        "when": "steps.check.ready == true && steps.check.duplicate == false && steps.check.inXero == true"
      },
      {
        "from": "prepare",
        "to": "review",
        "when": "steps.check.route != 'hj_reviewer'"
      },
      {
        "from": "prepare",
        "to": "firstReview",
        "when": "steps.check.route == 'hj_reviewer'"
      },
      {
        "from": "review",
        "to": "entered",
        "when": "steps.review.decision == 'enter'"
      },
      {
        "from": "review",
        "to": "rejectedAtReview",
        "when": "steps.review.decision == 'reject'"
      },
      {
        "from": "firstReview",
        "to": "secondReview",
        "when": "steps.firstReview.decision == 'approve'"
      },
      {
        "from": "firstReview",
        "to": "rejectedAtFirstReview",
        "when": "steps.firstReview.decision == 'reject'"
      },
      {
        "from": "secondReview",
        "to": "enteredAfterSecondReview",
        "when": "steps.secondReview.decision == 'enter'"
      },
      {
        "from": "secondReview",
        "to": "rejectedAtSecondReview",
        "when": "steps.secondReview.decision == 'reject'"
      },
      {
        "from": "prepareInXero",
        "to": "checkedClean",
        "when": "steps.prepareInXero.clean == true && (steps.check.route == 'approved_upstream' || (steps.check.route == 'draft_only' && steps.prepareInXero.changesProposed == false) || policy.cleanBillsNeedApproval == false)"
      },
      {
        "from": "prepareInXero",
        "to": "lookAtFindings",
        "when": "steps.prepareInXero.clean == false && (steps.check.route == 'approved_upstream' || (steps.check.route == 'draft_only' && steps.prepareInXero.changesProposed == false))"
      },
      {
        "from": "prepareInXero",
        "to": "approveInXero",
        "when": "steps.check.route != 'approved_upstream' && steps.check.route != 'hj_reviewer' && !(steps.check.route == 'draft_only' && steps.prepareInXero.changesProposed == false) && (steps.prepareInXero.clean == false || policy.cleanBillsNeedApproval == true)"
      },
      {
        "from": "prepareInXero",
        "to": "firstReviewInXero",
        "when": "steps.check.route == 'hj_reviewer' && (steps.prepareInXero.clean == false || policy.cleanBillsNeedApproval == true)"
      },
      {
        "from": "approveInXero",
        "to": "approvedInXero",
        "when": "steps.approveInXero.decision == 'approve'"
      },
      {
        "from": "approveInXero",
        "to": "leftInXero",
        "when": "steps.approveInXero.decision == 'leave'"
      },
      {
        "from": "firstReviewInXero",
        "to": "secondReviewInXero",
        "when": "steps.firstReviewInXero.decision == 'approve'"
      },
      {
        "from": "firstReviewInXero",
        "to": "leftInXeroAtFirstReview",
        "when": "steps.firstReviewInXero.decision == 'leave'"
      },
      {
        "from": "secondReviewInXero",
        "to": "approvedInXeroAfterReview",
        "when": "steps.secondReviewInXero.decision == 'approve'"
      },
      {
        "from": "secondReviewInXero",
        "to": "leftInXeroAtSecondReview",
        "when": "steps.secondReviewInXero.decision == 'leave'"
      },
      {
        "from": "lookAtFindings",
        "to": "findingsOwned"
      }
    ],
    "triggers": [
      {
        "event": "record.created",
        "filter": {
          "type_slug": "ap_bill"
        },
        "inputsFrom": {
          "billRecordId": "subject.record_id"
        },
        "kind": "event"
      }
    ],
    "variationPoints": [
      {
        "default": 1,
        "editableBy": "manager",
        "key": "reminderDays",
        "max": 10,
        "min": 1,
        "type": "number"
      },
      {
        "default": true,
        "editableBy": "manager",
        "key": "cleanBillsNeedApproval",
        "type": "boolean"
      }
    ],
    "version": "0.2.0",
    "vocabulary": {
      "subject": "Bill"
    }
  },
  "kind": "process",
  "name": "Enter a supplier bill",
  "originKey": "ce7515b8-e56f-4ce3-8cdc-b9a56d1bf0a8"
}
