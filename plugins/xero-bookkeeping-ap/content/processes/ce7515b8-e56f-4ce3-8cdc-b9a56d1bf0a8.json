      {
        "key": "prepare",
        "kind": "agent",
        "outputs": [
          "xeroBill",
          "status",
          "total",
          "codingSummary",
          "warnings"
        ],
        "skill": "xero-bookkeeping-ap-bill-coding",
        "title": "Code the bill and prepare it for Xero"
      },
      {
        "eligible": [
          "reviewer"
        ],
        "key": "review",
        "kind": "decision",
        "materiality": [
          "steps.prepare.xeroBill",
          "steps.prepare.total",
          "steps.check.findings"
        ],
        "options": [
          {
            "effect": "Creates the bill in the client's Xero organisation with this coding, in the status shown (Draft, Awaiting Approval or Awaiting Payment).",
            "intent": {
              "capability": "xero.bill.create",
              "payloadFrom": "steps.prepare.xeroBill"
            },
            "key": "enter",
            "label": "Enter in Xero as prepared",
            "suggested": true
          },
          {
            "effect": "Sends the bill back to the agent with your note. Nothing is created in Xero.",
            "key": "changes",
            "label": "Change something first",
            "transition": "prepare"
          },
          {
            "effect": "Ends the job. Nothing is created in Xero.",
            "key": "reject",
            "label": "Don't enter this bill"
          }
        ],
        "separation": "preparerCannotDecide",
        "sla": {
          "escalateTo": "installation.manager",
          "expireAfterBusinessDays": 10,
          "remindAfterBusinessDays": "{{reminderDays}}"
        },
        "title": "Approve the bill for Xero",
        "type": "bill_review"
      },
      {
        "eligible": [
          "reviewer"
        ],
        "key": "firstReview",
        "kind": "decision",
        "materiality": [
          "steps.prepare.xeroBill",
          "steps.prepare.total",
          "steps.check.findings"
        ],
        "options": [
          {
            "effect": "Passes the bill to the internal reviewer. Nothing is created in Xero yet.",
            "key": "approve",
            "label": "Approve and send to the internal reviewer",
            "suggested": true
          },
          {
            "effect": "Sends the bill back to the agent with your note. Nothing is created in Xero.",
            "key": "changes",
            "label": "Change something first",
            "transition": "prepare"
          },
          {
            "effect": "Ends the job. Nothing is created in Xero.",
            "key": "reject",
            "label": "Don't enter this bill"
