      {
        "from": "firstReviewInXero",
        "requires": "reviewer",
        "to": "prepareInXero"
      },
      {
        "from": "secondReviewInXero",
        "requires": "manager",
        "to": "prepareInXero"
      }
    ],
    "roles": {
      "backupManager": "installation.backupManager",
      "manager": "installation.manager",
      "reviewer": "installation.reviewer"
    },
    "schemaVersion": 1,
    "steps": [
      {
        "key": "check",
