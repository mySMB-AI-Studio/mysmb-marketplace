        "type": "bill_review"
      },
      {
        "key": "prepareInXero",
        "kind": "agent",
        "outputs": [
          "xeroUpdate",
          "changesProposed",
          "clean",
          "findings",
          "codingSummary",
          "status",
          "total",
          "warnings"
        ],
        "skill": "xero-bookkeeping-ap-bill-in-xero",
        "title": "Check the bill in Xero against its PDF and coding"
      },
      {
        "eligible": [
          "reviewer"
        ],
        "key": "approveInXero",
        "kind": "decision",
        "materiality": [
          "steps.prepareInXero.xeroUpdate",
          "steps.prepareInXero.findings",
          "steps.check.findings"
        ],
        "options": [
          {
            "effect": "Updates the bill in the client's Xero with the corrected coding shown and moves it to the status shown (Awaiting Approval or Awaiting Payment). Amounts aren't changed.",
            "intent": {
              "capability": "xero.bill.update",
              "payloadFrom": "steps.prepareInXero.xeroUpdate"
            },
            "key": "approve",
            "label": "Apply the corrections and approve in Xero",
            "suggested": true
          },
          {
            "effect": "Sends the bill back to the agent with your note. Nothing changes in Xero.",
            "key": "changes",
            "label": "Change something first",
            "transition": "prepareInXero"
          },
          {
            "effect": "Ends the job and leaves the bill exactly as it is in Xero for you to handle there.",
            "key": "leave",
            "label": "Leave it for me in Xero"
          }
        ],
        "separation": "preparerCannotDecide",
        "sla": {
          "escalateTo": "installation.manager",
          "expireAfterBusinessDays": 10,
