        "terminal": true
      },
      {
        "evidence": [
          "findings"
        ],
        "key": "findingsOwned",
        "terminal": true
      },
      {
        "evidence": [
          "decision_record"
        ],
        "key": "leftInXero",
        "terminal": true
      },
      {
        "evidence": [
          "decision_record"
        ],
        "key": "rejected",
        "terminal": true
      },
      {
        "evidence": [
          "duplicate_of"
        ],
        "key": "duplicate",
        "terminal": true
      },
      {
        "evidence": [
          "problem"
        ],
        "key": "needsAttention",
        "terminal": true
      }
    ],
    "protectedRules": [
      {
        "description": "A bill is created or changed in Xero only as the effect of a person's recorded approval. Elapsed time is never approval.",
        "key": "noXeroWithoutApproval"
      },
      {
        "description": "Agent steps only read Xero and the workspace. The only writes are the approved bill and the approved correction.",
        "key": "agentReadsOnly"
      },
      {
        "description": "Every Xero call uses the Xero organisation ID of this bill's client. One job never touches another client's organisation.",
        "key": "oneClientPerJob"
      },
      {
        "description": "An unknown client, a client that isn't set up, an unreadable document or something that isn't a tax invoice ends as needsAttention. No approval is asked for on guesses.",
        "key": "evidenceFirst"
      },
      {
        "description": "A bill that is already in the client's Xero is never entered again.",
        "key": "duplicatesStop"
      },
      {
        "description": "A bill for a client that approves before Xero (Dext, Restock, ApprovalMax) is never changed; it is only checked.",
        "key": "upstreamApprovalsKept"
      },
      {
        "description": "The agent never changes an amount on a bill already in Xero, never voids or deletes a bill; differences go to a person.",
        "key": "amountsNeverChanged"
      },
      {
        "description": "The agent never logs in to, uploads to or pays through a bank.",
        "key": "noBanking"
      }
    ],
    "rework": [
      {
        "from": "review",
        "requires": "reviewer",
        "to": "prepare"
      },
      {
        "from": "firstReview",
        "requires": "reviewer",
        "to": "prepare"
      },
      {
        "from": "secondReview",
