    ],
    "description": "Each new AP bill is checked and coded. A bill from email is created in the client's Xero once a person approves it. A bill already in Xero (from Hubdoc, Dext or keyed in) is compared with its PDF and the client's coding, and a person approves any correction and the approval status. Clients that approve before Xero are only checked.",
    "exceptions": [],
    "inputs": [
      {
        "key": "billRecordId",
        "label": "AP bill (record ID)",
        "required": true,
        "type": "string"
      }
    ],
    "key": "enter-supplier-bill",
    "kind": "process",
    "limits": {
      "maxActiveHours": 4,
      "maxAgentTurnsPerStep": 12,
      "maxAiUnits": 200,
      "maxSteps": 30,
      "maxWaitingDays": 30
    },
    "modelPolicy": {
      "brief": "haiku",
      "judgement": "sonnet",
      "plan": "sonnet"
    },
    "originKey": "ce7515b8-e56f-4ce3-8cdc-b9a56d1bf0a8",
    "outcomes": [
      {
