{
  "id": "docusign-completed-this-month",
  "title": "Completed This Month",
  "description": "Count of DocuSign envelopes fully signed and completed in the current calendar month, with a day-by-day sparkline and a month-over-month rate comparison.",
  "category": "documents",
  "tags": ["docusign", "esignature", "envelopes", "completed", "kpi", "contracts", "monthly"],
  "keywords": ["completed this month", "signed", "completed envelopes", "docusign", "kpi", "monthly", "count"],
  "connectorsUsed": ["docusign"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 3, "rowSpan": 5 },
    "min":       { "colSpan": 3, "rowSpan": 4 },
    "max":       { "colSpan": 6, "rowSpan": 8 }
  },
  "dataProvider": {
    "mcp": "docusign",
    "tool": "list_envelopes",
    "params": {
      "status": "completed",
      "from_date": "2026-08-01",
      "count": 100
    }
  },
  "spec": {
    "root": "card",
    "elements": {

      "card": {
        "type": "Card",
        "props": {},
        "children": ["header", "body"],
        "watch": {
          "/docusign/list_envelopes/envelopes": {
            "action": "setState",
            "params": {
              "statePath": "/ui/docusignCompletedStats",
              "value": {
                "$computed": "docusign_completed_stats",
                "args": { "value": { "$state": "/docusign/list_envelopes/envelopes" } }
              }
            }
          }
        }
      },

      "header": {
        "type": "Header",
        "props": {},
        "children": ["titleGroup"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "CheckCircle", "tone": "success", "size": "sm" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "eyebrow"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Completed This Month", "level": "h2" }
      },
      "eyebrow": {
        "type": "Eyebrow",
        "props": { "text": { "$state": "/ui/docusignCompletedStats/completedDateRange" } }
      },

      "body": {
        "type": "Body",
        "props": {},
        "children": ["loading", "content"]
      },

      "loading": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["sk1", "sk2"],
        "visible": { "$state": "/_loading/docusign.list_envelopes" }
      },
      "sk1": { "type": "Skeleton", "props": { "height": "3.5rem", "rounded": "md" } },
      "sk2": { "type": "Skeleton", "props": { "height": "2rem",   "rounded": "md" } },

      "content": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["statVal", "trendRow", "spark"],
        "visible": { "$state": "/_loading/docusign.list_envelopes", "not": true }
      },

      "statVal": {
        "type": "Stat",
        "props": {
          "value": { "$state": "/ui/docusignCompletedStats/completedCount" }
        }
      },

      "trendRow": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["trendIcon", "trendText"]
      },
      "trendIcon": {
        "type": "Icon",
        "props": {
          "name": { "$state": "/ui/docusignCompletedStats/completedTrendIcon" },
          "tone": { "$state": "/ui/docusignCompletedStats/completedTrendTone" },
          "size": "sm"
        }
      },
      "trendText": {
        "type": "Text",
        "props": {
          "text": { "$state": "/ui/docusignCompletedStats/completedTrendText" },
          "tone": { "$state": "/ui/docusignCompletedStats/completedTrendTone" },
          "size": "sm"
        }
      },

      "spark": {
        "type": "Sparkline",
        "props": {
          "values": { "$state": "/ui/docusignCompletedStats/completedSparkline" },
          "tone": "success",
          "height": 48,
          "fill": false
        }
      }

    }
  },
  "status": "published"
}
