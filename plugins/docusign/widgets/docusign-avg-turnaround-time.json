{
  "id": "docusign-avg-turnaround-time",
  "title": "Avg. Turnaround Time",
  "description": "Average number of days from envelope sent to completed for this calendar month, with a day-by-day sparkline and a month-over-month comparison showing whether signing is faster or slower than last month.",
  "category": "documents",
  "tags": ["docusign", "esignature", "envelopes", "turnaround", "kpi", "performance", "monthly"],
  "keywords": ["avg turnaround", "turnaround time", "signing time", "days to complete", "docusign", "kpi", "performance"],
  "connectorsUsed": ["docusign"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 3, "rowSpan": 5 },
    "min":       { "colSpan": 3, "rowSpan": 4 },
    "max":       { "colSpan": 6, "rowSpan": 8 }
  },
  "dataProvider": {
    "mcp": "docusign",
    "tool": "list_envelopes",
    "params": {
      "status": "completed",
      "from_date": "2026-08-01",
      "count": 100
    }
  },
  "spec": {
    "root": "card",
    "elements": {

      "card": {
        "type": "Card",
        "props": {},
        "children": ["header", "body"],
        "watch": {
          "/docusign/list_envelopes/envelopes": {
            "action": "setState",
            "params": {
              "statePath": "/ui/docusignTurnaroundStats",
              "value": {
                "$computed": "docusign_completed_stats",
                "args": { "value": { "$state": "/docusign/list_envelopes/envelopes" } }
              }
            }
          }
        }
      },

      "header": {
        "type": "Header",
        "props": {},
        "children": ["titleGroup"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "Clock", "tone": "accent", "size": "sm" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "eyebrow"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Avg. Turnaround Time", "level": "h2" }
      },
      "eyebrow": {
        "type": "Eyebrow",
        "props": { "text": "Sent → Completed" }
      },

      "body": {
        "type": "Body",
        "props": {},
        "children": ["loading", "content"]
      },

      "loading": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["sk1", "sk2"],
        "visible": { "$state": "/_loading/docusign.list_envelopes" }
      },
      "sk1": { "type": "Skeleton", "props": { "height": "3.5rem", "rounded": "md" } },
      "sk2": { "type": "Skeleton", "props": { "height": "2rem",   "rounded": "md" } },

      "content": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["statRow", "trendRow", "spark"],
        "visible": { "$state": "/_loading/docusign.list_envelopes", "not": true }
      },

      "statRow": {
        "type": "Row",
        "props": { "gap": "xs", "align": "end" },
        "children": ["statNum", "statUnit"]
      },
      "statNum": {
        "type": "Stat",
        "props": {
          "value": { "$state": "/ui/docusignTurnaroundStats/avgTurnaroundNum" }
        }
      },
      "statUnit": {
        "type": "Text",
        "props": { "text": "days", "size": "md", "tone": "muted" }
      },

      "trendRow": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["trendIcon", "trendText"]
      },
      "trendIcon": {
        "type": "Icon",
        "props": {
          "name": { "$state": "/ui/docusignTurnaroundStats/turnaroundTrendIcon" },
          "tone": { "$state": "/ui/docusignTurnaroundStats/turnaroundTrendTone" },
          "size": "sm"
        }
      },
      "trendText": {
        "type": "Text",
        "props": {
          "text": { "$state": "/ui/docusignTurnaroundStats/turnaroundTrendText" },
          "tone": { "$state": "/ui/docusignTurnaroundStats/turnaroundTrendTone" },
          "size": "sm"
        }
      },

      "spark": {
        "type": "Sparkline",
        "props": {
          "values": { "$state": "/ui/docusignTurnaroundStats/turnaroundSparkline" },
          "tone": "info",
          "height": 48,
          "fill": false
        }
      }

    }
  },
  "status": "published"
}
