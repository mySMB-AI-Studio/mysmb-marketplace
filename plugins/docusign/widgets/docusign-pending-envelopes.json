{
  "id": "docusign-pending-envelopes",
  "title": "Pending Envelopes",
  "description": "DocuSign envelopes awaiting action, ordered by creation date, with status badge and recipient count.",
  "category": "documents",
  "tags": ["docusign", "esignature", "envelopes", "signing", "contracts"],
  "keywords": ["envelope", "envelopes", "signing", "signature", "pending", "sent", "awaiting", "contract", "document", "docusign"],
  "connectorsUsed": ["docusign"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 5, "rowSpan": 6 },
    "min":       { "colSpan": 4, "rowSpan": 4 },
    "max":       { "colSpan": 10, "rowSpan": 12 }
  },
  "dataProvider": {
    "mcp": "docusign",
    "tool": "getEnvelopes",
    "params": {
      "status": "sent",
      "from_date": "2020-01-01",
      "order": "desc",
      "orderBy": "created"
    }
  },
  "spec": {
    "root": "card",
    "elements": {

      "card": {
        "type": "Card",
        "props": {},
        "children": ["titleRow", "loading", "empty", "list"]
      },

      "titleRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["titleGroup"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "FileSignature", "tone": "accent", "size": "sm" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "eyebrow"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Pending Envelopes", "level": "h2" }
      },
      "eyebrow": {
        "type": "Eyebrow",
        "props": { "text": "DocuSign" }
      },

      "loading": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["s1", "s2", "s3", "s4"],
        "visible": { "$state": "/_loading/docusign.getEnvelopes" }
      },
      "s1": { "type": "Skeleton", "props": { "height": "3rem", "rounded": "md" } },
      "s2": { "type": "Skeleton", "props": { "height": "3rem", "rounded": "md" } },
      "s3": { "type": "Skeleton", "props": { "height": "3rem", "rounded": "md" } },
      "s4": { "type": "Skeleton", "props": { "height": "3rem", "rounded": "md" } },

      "empty": {
        "type": "Empty",
        "props": { "message": "No envelopes awaiting signature." },
        "visible": {
          "$and": [
            { "$state": "/_loading/docusign.getEnvelopes", "not": true },
            { "$state": "/docusign/getEnvelopes/envelopes/0", "not": true }
          ]
        }
      },

      "list": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["row"],
        "repeat": {
          "statePath": "/docusign/getEnvelopes/envelopes",
          "key": "envelopeId"
        },
        "visible": { "$state": "/_loading/docusign.getEnvelopes", "not": true }
      },

      "row": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["rowTop", "rowBottom"]
      },

      "rowTop": {
        "type": "Row",
        "props": { "gap": "sm", "align": "start", "justify": "between" },
        "children": ["rowLeft", "rowStatus"]
      },
      "rowLeft": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["rowSubject", "rowSender"]
      },
      "rowSubject": {
        "type": "Text",
        "props": {
          "text": { "$item": "emailSubject" },
          "size": "sm",
          "weight": "medium",
          "truncate": true
        }
      },
      "rowSender": {
        "type": "Text",
        "props": {
          "text": { "$item": "sender.name" },
          "size": "xs",
          "tone": "muted",
          "truncate": true
        },
        "visible": { "$item": "sender.name" }
      },
      "rowStatus": {
        "type": "Badge",
        "props": {
          "text": { "$item": "status" },
          "tone": "accent",
          "variant": "soft"
        }
      },

      "rowBottom": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["rowDate"]
      },
      "rowDate": {
        "type": "Text",
        "props": {
          "text": { "$item": "createdDateTime" },
          "size": "xs",
          "tone": "muted"
        },
        "visible": { "$item": "createdDateTime" }
      }

    }
  },
  "status": "published"
}
