{
  "category": "surveys",
  "connectorsUsed": [
    "surveymonkey"
  ],
  "dataProvider": {
    "kind": "tool",
    "mcp": "surveymonkey",
    "params": {
      "include": "status",
      "per_page": 100,
      "sort_by": "date_modified",
      "sort_order": "DESC"
    },
    "tool": "list_surveys"
  },
  "description": "Open SurveyMonkey surveys currently collecting responses (at least one open collector).",
  "id": "surveymonkey-surveys-in-progress",
  "keywords": [
    "active surveys",
    "open surveys",
    "collecting",
    "in progress",
    "responses"
  ],
  "popularity": 62,
  "sizing": {
    "max": {
      "colSpan": 8,
      "rowSpan": 10
    },
    "min": {
      "colSpan": 4,
      "rowSpan": 5
    },
    "preferred": {
      "colSpan": 5,
      "rowSpan": 6
    }
  },
  "spec": {
    "elements": {
      "body": {
        "children": [
          "loading",
          "empty",
          "contentArea"
        ],
        "props": {},
        "type": "Body"
      },
      "card": {
        "children": [
          "header",
          "body"
        ],
        "props": {},
        "type": "Card",
        "watch": {
          "/surveymonkey/list_surveys/data": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/rows",
                "value": {
                  "$computed": "surveymonkey_flatten_surveys_in_progress",
                  "args": {
                    "value": {
                      "$state": "/surveymonkey/list_surveys/data"
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "contentArea": {
        "children": [
          "statsRow",
          "surveyList"
        ],
        "props": {
          "gap": "md"
        },
        "type": "Stack",
        "visible": {
          "$and": [
            {
              "$state": "/_loading/surveymonkey.list_surveys",
              "not": true
            },
            {
              "$state": "/ui/rows/0"
            }
          ]
        }
      },
      "empty": {
        "props": {
          "message": "No surveys currently collecting responses."
        },
        "type": "Empty",
        "visible": {
          "$and": [
            {
              "$state": "/_loading/surveymonkey.list_surveys",
              "not": true
            },
            {
              "$state": "/ui/rows/0",
              "not": true
            }
          ]
        }
      },
      "eyebrow": {
        "props": {
          "text": "SurveyMonkey"
        },
        "type": "Eyebrow"
      },
      "header": {
        "children": [
          "titleGroup"
        ],
        "props": {},
        "type": "Header"
      },
      "loading": {
        "children": [
          "sk1",
          "sk2",
          "sk3"
        ],
        "props": {
          "gap": "sm"
        },
        "type": "Stack",
        "visible": {
          "$state": "/_loading/surveymonkey.list_surveys"
        }
      },
      "sk1": {
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "sk2": {
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "sk3": {
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "statActive": {
        "children": [
          "statActiveCount",
          "statActiveLabel"
        ],
        "props": {
          "padding": "sm",
          "variant": "muted"
        },
        "type": "Section"
      },
      "statActiveCount": {
        "props": {
          "level": "h2",
          "text": {
            "$state": "/ui/rows/0/stat_active"
          },
          "tone": "accent"
        },
        "type": "Heading"
      },
      "statActiveLabel": {
        "props": {
          "text": "Active Surveys"
        },
        "type": "Caption"
      },
      "statActiveWrap": {
        "children": [
          "statActive"
        ],
        "props": {
          "gap": "none"
        },
        "type": "Stack"
      },
      "statAvg": {
        "children": [
          "statAvgCount",
          "statAvgLabel"
        ],
        "props": {
          "padding": "sm",
          "variant": "muted"
        },
        "type": "Section"
      },
      "statAvgCount": {
        "props": {
          "level": "h2",
          "text": {
            "$state": "/ui/rows/0/stat_avg_completion"
          }
        },
        "type": "Heading"
      },
      "statAvgLabel": {
        "props": {
          "text": "Avg Responses"
        },
        "type": "Caption"
      },
      "statAvgWrap": {
        "children": [
          "statAvg"
        ],
        "props": {
          "gap": "none"
        },
        "type": "Stack"
      },
      "statTotal": {
        "children": [
          "statTotalCount",
          "statTotalLabel"
        ],
        "props": {
          "padding": "sm",
          "variant": "muted"
        },
        "type": "Section"
      },
      "statTotalCount": {
        "props": {
          "level": "h2",
          "text": {
            "$state": "/ui/rows/0/stat_total_responses"
          }
        },
        "type": "Heading"
      },
      "statTotalLabel": {
        "props": {
          "text": "Total Responses"
        },
        "type": "Caption"
      },
      "statTotalWrap": {
        "children": [
          "statTotal"
        ],
        "props": {
          "gap": "none"
        },
        "type": "Stack"
      },
      "statsRow": {
        "children": [
          "statActiveWrap",
          "statTotalWrap",
          "statAvgWrap"
        ],
        "props": {
          "gap": "sm",
          "template": "1fr 1fr 1fr"
        },
        "type": "Row"
      },
      "surveyAudience": {
        "props": {
          "text": {
            "$item": "audience"
          },
          "tone": "muted"
        },
        "type": "Caption",
        "visible": {
          "$item": "audience"
        }
      },
      "surveyCloses": {
        "props": {
          "text": {
            "$item": "closes_label"
          },
          "tone": "muted"
        },
        "type": "Caption",
        "visible": {
          "$item": "closes_label"
        }
      },
      "surveyDivider": {
        "props": {},
        "type": "Divider"
      },
      "surveyInfo": {
        "children": [
          "surveyTitle",
          "surveyAudience"
        ],
        "props": {
          "gap": "none",
          "grow": true
        },
        "type": "Stack"
      },
      "surveyList": {
        "children": [
          "surveyRow"
        ],
        "props": {
          "gap": "sm"
        },
        "repeat": {
          "key": "id",
          "statePath": "/ui/rows"
        },
        "type": "Stack"
      },
      "surveyMetaRow": {
        "children": [
          "surveyResponses",
          "surveyCloses"
        ],
        "props": {
          "justify": "between"
        },
        "type": "Row"
      },
      "surveyProgress": {
        "props": {
          "tone": {
            "$item": "progress_tone"
          },
          "value": {
            "$item": "progress_pct"
          }
        },
        "type": "ProgressBar"
      },
      "surveyProgressRow": {
        "children": [
          "surveyProgress"
        ],
        "props": {},
        "type": "Row",
        "visible": {
          "$item": "has_progress"
        }
      },
      "surveyResponses": {
        "props": {
          "text": {
            "$item": "responses_label"
          },
          "tone": "muted"
        },
        "type": "Caption"
      },
      "surveyRow": {
        "children": [
          "surveyTopRow",
          "surveyProgressRow",
          "surveyMetaRow",
          "surveyDivider"
        ],
        "props": {
          "gap": "xs"
        },
        "type": "Stack"
      },
      "surveyStatusBadge": {
        "props": {
          "text": {
            "$item": "status_label"
          },
          "tone": {
            "$item": "status_tone"
          },
          "variant": "soft"
        },
        "type": "Badge",
        "visible": {
          "$item": "status_label"
        }
      },
      "surveyTitle": {
        "props": {
          "size": "sm",
          "text": {
            "$item": "title"
          },
          "truncate": true,
          "weight": "semibold"
        },
        "type": "Text"
      },
      "surveyTopRow": {
        "children": [
          "surveyInfo",
          "surveyStatusBadge"
        ],
        "props": {
          "align": "center",
          "justify": "between"
        },
        "type": "Row"
      },
      "title": {
        "props": {
          "level": "h2",
          "text": "Surveys in Progress"
        },
        "type": "Heading"
      },
      "titleGroup": {
        "children": [
          "titleIcon",
          "titleStack"
        ],
        "props": {
          "align": "center",
          "gap": "sm"
        },
        "type": "Row"
      },
      "titleIcon": {
        "props": {
          "name": "Activity",
          "size": "sm",
          "tone": "accent"
        },
        "type": "Icon"
      },
      "titleStack": {
        "children": [
          "title",
          "eyebrow"
        ],
        "props": {
          "gap": "none"
        },
        "type": "Stack"
      }
    },
    "root": "card"
  },
  "tags": [
    "surveymonkey",
    "surveys",
    "active",
    "collecting",
    "in-progress"
  ],
  "title": "Surveys in Progress"
}
