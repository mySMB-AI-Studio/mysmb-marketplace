{
  "id": "surveymonkey-surveys-in-progress",
  "title": "Surveys in Progress",
  "description": "Open SurveyMonkey surveys currently collecting responses (at least one open collector).",
  "category": "surveys",
  "tags": ["surveymonkey", "surveys", "active", "collecting", "in-progress"],
  "keywords": ["active surveys", "open surveys", "collecting", "in progress", "responses"],
  "connectorsUsed": ["surveymonkey"],
  "popularity": 62,
  "sizing": {
    "preferred": { "colSpan": 5, "rowSpan": 6 },
    "min": { "colSpan": 4, "rowSpan": 5 },
    "max": { "colSpan": 8, "rowSpan": 10 }
  },
  "dataProvider": {
    "mcp": "surveymonkey",
    "tool": "list_surveys",
    "params": { "per_page": 50, "sort_by": "date_modified", "sort_order": "DESC" }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": ["header", "body"],
        "watch": {
          "/surveymonkey/list_surveys/data": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/rows",
                "value": {
                  "$computed": "surveymonkey_flatten_surveys_in_progress",
                  "args": { "value": { "$state": "/surveymonkey/list_surveys/data" } }
                }
              }
            }
          ]
        }
      },

      "header": { "type": "Header", "props": {}, "children": ["titleStack"] },
      "titleStack": {
        "type": "Stack", "props": { "gap": "none" },
        "children": ["title", "eyebrow"]
      },
      "title": { "type": "Heading", "props": { "text": "Surveys in Progress", "level": "h2" } },
      "eyebrow": { "type": "Eyebrow", "props": { "text": "SurveyMonkey" } },

      "body": { "type": "Body", "props": {}, "children": ["loading", "empty", "contentArea"] },

      "loading": {
        "type": "Stack", "props": { "gap": "sm" },
        "children": ["sk1", "sk2", "sk3"],
        "visible": { "$state": "/_loading/surveymonkey.list_surveys" }
      },
      "sk1": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "sk2": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "sk3": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },

      "empty": {
        "type": "Empty",
        "props": { "message": "No surveys currently collecting responses." },
        "visible": {
          "$and": [
            { "$state": "/_loading/surveymonkey.list_surveys", "not": true },
            { "$state": "/surveymonkey/list_surveys/data/0", "not": true }
          ]
        }
      },

      "contentArea": {
        "type": "Stack", "props": { "gap": "md" },
        "children": ["statsRow", "surveyList"],
        "visible": {
          "$and": [
            { "$state": "/_loading/surveymonkey.list_surveys", "not": true },
            { "$state": "/surveymonkey/list_surveys/data/0" }
          ]
        }
      },

      "statsRow": {
        "type": "Row", "props": { "gap": "sm", "template": "1fr 1fr 1fr" },
        "children": ["statActiveWrap", "statTotalWrap", "statAvgWrap"]
      },
      "statActiveWrap": { "type": "Stack", "props": { "gap": "none" }, "children": ["statActive"] },
      "statActive": {
        "type": "Section", "props": { "variant": "muted", "padding": "sm" },
        "children": ["statActiveCount", "statActiveLabel"]
      },
      "statActiveCount": { "type": "Heading", "props": { "text": { "$state": "/ui/rows/0/stat_active" }, "level": "h2", "tone": "accent" } },
      "statActiveLabel": { "type": "Caption", "props": { "text": "Active Surveys" } },

      "statTotalWrap": { "type": "Stack", "props": { "gap": "none" }, "children": ["statTotal"] },
      "statTotal": {
        "type": "Section", "props": { "variant": "muted", "padding": "sm" },
        "children": ["statTotalCount", "statTotalLabel"]
      },
      "statTotalCount": { "type": "Heading", "props": { "text": { "$state": "/ui/rows/0/stat_total_responses" }, "level": "h2" } },
      "statTotalLabel": { "type": "Caption", "props": { "text": "Total Responses" } },

      "statAvgWrap": { "type": "Stack", "props": { "gap": "none" }, "children": ["statAvg"] },
      "statAvg": {
        "type": "Section", "props": { "variant": "muted", "padding": "sm" },
        "children": ["statAvgCount", "statAvgLabel"]
      },
      "statAvgCount": { "type": "Heading", "props": { "text": { "$state": "/ui/rows/0/stat_avg_completion" }, "level": "h2" } },
      "statAvgLabel": { "type": "Caption", "props": { "text": "Avg Completion" } },

      "surveyList": {
        "type": "Stack", "props": { "gap": "sm" },
        "children": ["surveyRow"],
        "repeat": { "statePath": "/ui/rows", "key": "id" }
      },

      "surveyRow": {
        "type": "Stack", "props": { "gap": "xs" },
        "children": ["surveyTopRow", "surveyProgress", "surveyMetaRow", "surveyDivider"]
      },
      "surveyTopRow": {
        "type": "Row", "props": { "justify": "between", "align": "center" },
        "children": ["surveyInfo", "surveyStatusBadge"]
      },
      "surveyInfo": {
        "type": "Stack", "props": { "gap": "none", "grow": true },
        "children": ["surveyTitle", "surveyAudience"]
      },
      "surveyTitle": {
        "type": "Text",
        "props": { "text": { "$item": "title" }, "size": "sm", "weight": "semibold", "truncate": true }
      },
      "surveyAudience": {
        "type": "Caption",
        "props": { "text": { "$item": "audience" }, "tone": "muted" },
        "visible": { "$item": "audience" }
      },
      "surveyStatusBadge": {
        "type": "Badge",
        "props": { "text": { "$item": "status_label" }, "tone": { "$item": "status_tone" }, "variant": "soft" },
        "visible": { "$item": "status_label" }
      },
      "surveyProgress": {
        "type": "ProgressBar",
        "props": { "value": { "$item": "progress_pct" }, "tone": { "$item": "progress_tone" } },
        "visible": { "$item": "has_progress" }
      },
      "surveyMetaRow": {
        "type": "Row", "props": { "justify": "between" },
        "children": ["surveyResponses", "surveyCloses"]
      },
      "surveyResponses": {
        "type": "Caption",
        "props": { "text": { "$item": "responses_label" }, "tone": "muted" }
      },
      "surveyCloses": {
        "type": "Caption",
        "props": { "text": { "$item": "closes_label" }, "tone": "muted" },
        "visible": { "$item": "closes_label" }
      },
      "surveyDivider": { "type": "Divider", "props": {} }
    }
  },
  "status": "published"
}
