{
  "category": "surveys",
  "connectorsUsed": [
    "surveymonkey"
  ],
  "dataProvider": {
    "kind": "tool",
    "mcp": "surveymonkey",
    "params": {
      "include": "status",
      "per_page": 100,
      "sort_by": "date_modified",
      "sort_order": "DESC"
    },
    "tool": "list_surveys"
  },
  "description": "Closed surveys with response counts, completion rates, and quarterly stats.",
  "id": "surveymonkey-surveys-completed",
  "keywords": [
    "surveys completed",
    "closed surveys",
    "response rate",
    "completion"
  ],
  "popularity": 58,
  "sizing": {
    "max": {
      "colSpan": 8,
      "rowSpan": 12
    },
    "min": {
      "colSpan": 3,
      "rowSpan": 4
    },
    "preferred": {
      "colSpan": 5,
      "rowSpan": 6
    }
  },
  "spec": {
    "elements": {
      "body": {
        "children": [
          "loading",
          "empty",
          "content"
        ],
        "props": {},
        "type": "Body"
      },
      "card": {
        "children": [
          "header",
          "body"
        ],
        "props": {},
        "type": "Card",
        "watch": {
          "/surveymonkey/list_surveys/data": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/rows",
                "value": {
                  "$computed": "surveymonkey_flatten_closed_surveys",
                  "args": {
                    "value": {
                      "$state": "/surveymonkey/list_surveys/data"
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "content": {
        "children": [
          "statsRow",
          "surveyList"
        ],
        "props": {
          "gap": "md"
        },
        "type": "Stack",
        "visible": {
          "$and": [
            {
              "$state": "/_loading/surveymonkey.list_surveys",
              "not": true
            },
            {
              "$state": "/ui/rows/0"
            }
          ]
        }
      },
      "empty": {
        "props": {
          "message": "No closed surveys found."
        },
        "type": "Empty",
        "visible": {
          "$and": [
            {
              "$state": "/_loading/surveymonkey.list_surveys",
              "not": true
            },
            {
              "$state": "/ui/rows/0",
              "not": true
            }
          ]
        }
      },
      "header": {
        "children": [
          "titleGroup"
        ],
        "props": {},
        "type": "Header"
      },
      "loading": {
        "children": [
          "sk1",
          "sk2",
          "sk3"
        ],
        "props": {
          "gap": "sm"
        },
        "type": "Stack",
        "visible": {
          "$state": "/_loading/surveymonkey.list_surveys"
        }
      },
      "sk1": {
        "props": {
          "height": "3rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "sk2": {
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "sk3": {
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "statQuarter": {
        "children": [
          "statQuarterNum",
          "statQuarterLabel"
        ],
        "props": {
          "padding": "sm",
          "variant": "muted"
        },
        "type": "Section"
      },
      "statQuarterLabel": {
        "props": {
          "text": "This Quarter"
        },
        "type": "Caption"
      },
      "statQuarterNum": {
        "props": {
          "level": "h2",
          "text": {
            "$state": "/ui/rows/0/stat_quarter_count"
          }
        },
        "type": "Heading"
      },
      "statQuarterWrap": {
        "children": [
          "statQuarter"
        ],
        "props": {
          "gap": "none"
        },
        "type": "Stack"
      },
      "statRate": {
        "children": [
          "statRateNum",
          "statRateLabel"
        ],
        "props": {
          "padding": "sm",
          "variant": "muted"
        },
        "type": "Section"
      },
      "statRateLabel": {
        "props": {
          "text": "Avg Responses"
        },
        "type": "Caption"
      },
      "statRateNum": {
        "props": {
          "level": "h2",
          "text": {
            "$state": "/ui/rows/0/stat_avg_responses"
          }
        },
        "type": "Heading"
      },
      "statRateWrap": {
        "children": [
          "statRate"
        ],
        "props": {
          "gap": "none"
        },
        "type": "Stack"
      },
      "statTotal": {
        "children": [
          "statTotalNum",
          "statTotalLabel"
        ],
        "props": {
          "padding": "sm",
          "variant": "muted"
        },
        "type": "Section"
      },
      "statTotalLabel": {
        "props": {
          "text": "Responses"
        },
        "type": "Caption"
      },
      "statTotalNum": {
        "props": {
          "level": "h2",
          "text": {
            "$state": "/ui/rows/0/stat_total_responses"
          }
        },
        "type": "Heading"
      },
      "statTotalWrap": {
        "children": [
          "statTotal"
        ],
        "props": {
          "gap": "none"
        },
        "type": "Stack"
      },
      "statsRow": {
        "children": [
          "statQuarterWrap",
          "statTotalWrap",
          "statRateWrap"
        ],
        "props": {
          "gap": "sm",
          "template": "1fr 1fr 1fr"
        },
        "type": "Row"
      },
      "surveyCheck": {
        "props": {
          "name": "CheckCircle",
          "size": "sm",
          "tone": "success"
        },
        "type": "Icon"
      },
      "surveyClosedDate": {
        "props": {
          "align": "right",
          "text": {
            "$item": "closed_label"
          },
          "tone": "muted"
        },
        "type": "Caption"
      },
      "surveyDivider": {
        "props": {},
        "type": "Divider"
      },
      "surveyInfo": {
        "children": [
          "surveyTitle",
          "surveyMeta"
        ],
        "props": {
          "gap": "none",
          "grow": true
        },
        "type": "Stack"
      },
      "surveyList": {
        "children": [
          "surveyRow"
        ],
        "props": {
          "gap": "xs"
        },
        "repeat": {
          "key": "id",
          "statePath": "/ui/rows"
        },
        "type": "Stack"
      },
      "surveyMeta": {
        "props": {
          "text": {
            "$item": "meta_label"
          },
          "tone": "muted",
          "truncate": true
        },
        "type": "Caption"
      },
      "surveyRate": {
        "props": {
          "align": "right",
          "size": "sm",
          "text": {
            "$item": "rate_label"
          },
          "weight": "bold"
        },
        "type": "Text",
        "visible": {
          "$item": "has_rate"
        }
      },
      "surveyRight": {
        "children": [
          "surveyRate",
          "surveyClosedDate"
        ],
        "props": {
          "gap": "none"
        },
        "type": "Stack"
      },
      "surveyRow": {
        "children": [
          "surveyRowContent",
          "surveyDivider"
        ],
        "props": {
          "gap": "xs"
        },
        "type": "Stack"
      },
      "surveyRowContent": {
        "children": [
          "surveyCheck",
          "surveyInfo",
          "surveyRight"
        ],
        "props": {
          "align": "center",
          "gap": "sm"
        },
        "type": "Row"
      },
      "surveyTitle": {
        "props": {
          "size": "sm",
          "text": {
            "$item": "title"
          },
          "truncate": true,
          "weight": "semibold"
        },
        "type": "Text"
      },
      "title": {
        "props": {
          "level": "h2",
          "text": "Surveys Completed"
        },
        "type": "Heading"
      },
      "titleEyebrow": {
        "props": {
          "text": "SurveyMonkey"
        },
        "type": "Eyebrow"
      },
      "titleGroup": {
        "children": [
          "titleIcon",
          "titleStack"
        ],
        "props": {
          "align": "center",
          "gap": "sm"
        },
        "type": "Row"
      },
      "titleIcon": {
        "props": {
          "name": "ClipboardCheck",
          "size": "sm",
          "tone": "accent"
        },
        "type": "Icon"
      },
      "titleStack": {
        "children": [
          "title",
          "titleEyebrow"
        ],
        "props": {
          "gap": "none"
        },
        "type": "Stack"
      }
    },
    "root": "card"
  },
  "tags": [
    "surveymonkey",
    "surveys",
    "completed",
    "closed",
    "responses",
    "rate"
  ],
  "title": "Surveys Completed"
}
