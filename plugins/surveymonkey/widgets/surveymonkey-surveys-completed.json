{
  "id": "surveymonkey-surveys-completed",
  "title": "Surveys Completed",
  "description": "Closed surveys with response counts, completion rates, and quarterly stats.",
  "category": "surveys",
  "tags": ["surveymonkey", "surveys", "completed", "closed", "responses", "rate"],
  "keywords": ["surveys completed", "closed surveys", "response rate", "completion"],
  "connectorsUsed": ["surveymonkey"],
  "popularity": 58,
  "sizing": {
    "preferred": { "colSpan": 5, "rowSpan": 6 },
    "min": { "colSpan": 3, "rowSpan": 4 },
    "max": { "colSpan": 8, "rowSpan": 12 }
  },
  "dataProvider": {
    "mcp": "surveymonkey",
    "tool": "list_closed_surveys",
    "params": { "days_modified": 365 }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": ["header", "body"],
        "watch": {
          "/surveymonkey/list_closed_surveys/data": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/rows",
                "value": {
                  "$computed": "surveymonkey_flatten_closed_surveys",
                  "args": {
                    "value": { "$state": "/surveymonkey/list_closed_surveys/data" }
                  }
                }
              }
            }
          ]
        }
      },
      "header": {
        "type": "Header",
        "props": {},
        "children": ["titleRow"]
      },
      "titleRow": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center", "justify": "between" },
        "children": ["titleStack", "smBadge"]
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "titleEyebrow"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Surveys Completed", "level": "h2" }
      },
      "titleEyebrow": {
        "type": "Eyebrow",
        "props": { "text": "SurveyMonkey" }
      },
      "smBadge": {
        "type": "Badge",
        "props": { "text": "SM", "tone": "accent", "variant": "soft" }
      },
      "body": {
        "type": "Body",
        "props": {},
        "children": ["loading", "empty", "content"]
      },
      "loading": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["sk1", "sk2", "sk3"],
        "visible": { "$state": "/_loading/surveymonkey.list_closed_surveys" }
      },
      "sk1": { "type": "Skeleton", "props": { "height": "3rem", "rounded": "md" } },
      "sk2": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "sk3": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "empty": {
        "type": "Empty",
        "props": { "message": "No closed surveys found." },
        "visible": {
          "$and": [
            { "$state": "/_loading/surveymonkey.list_closed_surveys", "not": true },
            { "$state": "/ui/rows/0", "not": true }
          ]
        }
      },
      "content": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["statsRow", "colHeaders", "surveyList"],
        "visible": {
          "$and": [
            { "$state": "/_loading/surveymonkey.list_closed_surveys", "not": true },
            { "$state": "/ui/rows/0" }
          ]
        }
      },
      "statsRow": {
        "type": "Row",
        "props": { "gap": "sm", "template": "1fr 1fr 1fr" },
        "children": ["statQuarter", "statTotal", "statRate"]
      },
      "statQuarter": {
        "type": "Section",
        "props": { "variant": "muted", "padding": "sm", "align": "center" },
        "children": ["statQuarterNum", "statQuarterLabel"]
      },
      "statQuarterNum": {
        "type": "Heading",
        "props": { "text": { "$state": "/ui/rows/0/stat_quarter_count" }, "level": "h3" }
      },
      "statQuarterLabel": {
        "type": "Caption",
        "props": { "text": "This Quarter", "tone": "muted" }
      },
      "statTotal": {
        "type": "Section",
        "props": { "variant": "muted", "padding": "sm", "align": "center" },
        "children": ["statTotalNum", "statTotalLabel"]
      },
      "statTotalNum": {
        "type": "Heading",
        "props": { "text": { "$state": "/ui/rows/0/stat_total_responses" }, "level": "h3" }
      },
      "statTotalLabel": {
        "type": "Caption",
        "props": { "text": "Responses", "tone": "muted" }
      },
      "statRate": {
        "type": "Section",
        "props": { "variant": "accent", "padding": "sm", "align": "center" },
        "children": ["statRateNum", "statRateLabel"]
      },
      "statRateNum": {
        "type": "Heading",
        "props": { "text": { "$state": "/ui/rows/0/stat_avg_rate" }, "level": "h3", "tone": "accent" }
      },
      "statRateLabel": {
        "type": "Caption",
        "props": { "text": "Avg Rate", "tone": "accent" }
      },
      "colHeaders": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["colSurvey", "colRight"]
      },
      "colSurvey": {
        "type": "Caption",
        "props": { "text": "SURVEY", "tone": "muted", "grow": true }
      },
      "colRight": {
        "type": "Row",
        "props": { "gap": "none", "template": "5rem 5rem 4rem" },
        "children": ["colResponses", "colCompleted", "colRate"]
      },
      "colResponses": {
        "type": "Caption",
        "props": { "text": "RESPONSES", "tone": "muted", "align": "right" }
      },
      "colCompleted": {
        "type": "Caption",
        "props": { "text": "COMPLETED", "tone": "muted", "align": "right" }
      },
      "colRate": {
        "type": "Caption",
        "props": { "text": "RATE", "tone": "muted", "align": "right" }
      },
      "surveyList": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["surveyRow"],
        "repeat": {
          "statePath": "/ui/rows",
          "key": "id"
        }
      },
      "surveyRow": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center", "hover": true },
        "children": ["surveyRowLeft", "surveyRowRight"]
      },
      "surveyRowLeft": {
        "type": "Stack",
        "props": { "gap": "none", "grow": true },
        "children": ["surveyTitle", "surveyAudience"]
      },
      "surveyTitle": {
        "type": "Text",
        "props": { "text": { "$item": "title" }, "size": "sm", "weight": "semibold", "truncate": true }
      },
      "surveyAudience": {
        "type": "Caption",
        "props": { "text": { "$item": "audience" }, "tone": "muted", "truncate": true }
      },
      "surveyRowRight": {
        "type": "Row",
        "props": { "gap": "none", "template": "5rem 5rem 4rem", "align": "center" },
        "children": ["surveyResponses", "surveyClosed", "surveyRate"]
      },
      "surveyResponses": {
        "type": "Text",
        "props": { "text": { "$item": "responses_label" }, "size": "sm", "align": "right" }
      },
      "surveyClosed": {
        "type": "Caption",
        "props": { "text": { "$item": "closed_label" }, "tone": "muted", "align": "right" }
      },
      "surveyRate": {
        "type": "Badge",
        "props": {
          "text": { "$item": "rate_label" },
          "tone": { "$item": "rate_tone" },
          "variant": "soft"
        },
        "visible": { "$item": "rate_label" }
      }
    }
  },
  "status": "published"
}
