{
  "id": "surveymonkey-surveys-completed",
  "title": "Surveys Completed",
  "description": "Closed surveys with response counts, completion rates, and quarterly stats.",
  "category": "surveys",
  "tags": ["surveymonkey", "surveys", "completed", "closed", "responses", "rate"],
  "keywords": ["surveys completed", "closed surveys", "response rate", "completion"],
  "connectorsUsed": ["surveymonkey"],
  "popularity": 58,
  "sizing": {
    "preferred": { "colSpan": 5, "rowSpan": 6 },
    "min": { "colSpan": 3, "rowSpan": 4 },
    "max": { "colSpan": 8, "rowSpan": 12 }
  },
  "dataProvider": {
    "mcp": "surveymonkey",
    "tool": "list_surveys",
    "params": { "per_page": 100, "sort_by": "date_modified", "sort_order": "DESC", "include": "status" }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": ["header", "body"],
        "watch": {
          "/surveymonkey/list_surveys/data": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/rows",
                "value": {
                  "$computed": "surveymonkey_flatten_closed_surveys",
                  "args": { "value": { "$state": "/surveymonkey/list_surveys/data" } }
                }
              }
            }
          ]
        }
      },

      "header": { "type": "Header", "props": {}, "children": ["titleStack"] },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "titleEyebrow"]
      },
      "title": { "type": "Heading", "props": { "text": "Surveys Completed", "level": "h2" } },
      "titleEyebrow": { "type": "Eyebrow", "props": { "text": "SurveyMonkey" } },

      "body": { "type": "Body", "props": {}, "children": ["loading", "empty", "content"] },

      "loading": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["sk1", "sk2", "sk3"],
        "visible": { "$state": "/_loading/surveymonkey.list_surveys" }
      },
      "sk1": { "type": "Skeleton", "props": { "height": "3rem", "rounded": "md" } },
      "sk2": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "sk3": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },

      "empty": {
        "type": "Empty",
        "props": { "message": "No closed surveys found." },
        "visible": {
          "$and": [
            { "$state": "/_loading/surveymonkey.list_surveys", "not": true },
            { "$state": "/ui/rows/0", "not": true }
          ]
        }
      },

      "content": {
        "type": "Stack",
        "props": { "gap": "md" },
        "children": ["statsRow", "surveyList"],
        "visible": {
          "$and": [
            { "$state": "/_loading/surveymonkey.list_surveys", "not": true },
            { "$state": "/ui/rows/0" }
          ]
        }
      },

      "statsRow": {
        "type": "Row",
        "props": { "gap": "sm", "template": "1fr 1fr 1fr" },
        "children": ["statQuarterWrap", "statTotalWrap", "statRateWrap"]
      },
      "statQuarterWrap": { "type": "Stack", "props": { "gap": "none" }, "children": ["statQuarter"] },
      "statQuarter": {
        "type": "Section",
        "props": { "variant": "muted", "padding": "sm" },
        "children": ["statQuarterNum", "statQuarterLabel"]
      },
      "statQuarterNum": {
        "type": "Heading",
        "props": { "text": { "$state": "/ui/rows/0/stat_quarter_count" }, "level": "h2" }
      },
      "statQuarterLabel": { "type": "Caption", "props": { "text": "This Quarter" } },

      "statTotalWrap": { "type": "Stack", "props": { "gap": "none" }, "children": ["statTotal"] },
      "statTotal": {
        "type": "Section",
        "props": { "variant": "muted", "padding": "sm" },
        "children": ["statTotalNum", "statTotalLabel"]
      },
      "statTotalNum": {
        "type": "Heading",
        "props": { "text": { "$state": "/ui/rows/0/stat_total_responses" }, "level": "h2" }
      },
      "statTotalLabel": { "type": "Caption", "props": { "text": "Responses" } },

      "statRateWrap": { "type": "Stack", "props": { "gap": "none" }, "children": ["statRate"] },
      "statRate": {
        "type": "Section",
        "props": { "variant": "muted", "padding": "sm" },
        "children": ["statRateNum", "statRateLabel"]
      },
      "statRateNum": {
        "type": "Heading",
        "props": { "text": { "$state": "/ui/rows/0/stat_avg_rate" }, "level": "h2" }
      },
      "statRateLabel": { "type": "Caption", "props": { "text": "Avg Rate" } },

      "surveyList": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["surveyRow"],
        "repeat": { "statePath": "/ui/rows", "key": "id" }
      },

      "surveyRow": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["surveyRowContent", "surveyDivider"]
      },
      "surveyRowContent": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["surveyCheck", "surveyInfo", "surveyRight"]
      },
      "surveyCheck": {
        "type": "Icon",
        "props": { "name": "CheckCircle", "tone": "success", "size": "sm" }
      },
      "surveyInfo": {
        "type": "Stack",
        "props": { "gap": "none", "grow": true },
        "children": ["surveyTitle", "surveyMeta"]
      },
      "surveyTitle": {
        "type": "Text",
        "props": { "text": { "$item": "title" }, "size": "sm", "weight": "semibold", "truncate": true }
      },
      "surveyMeta": {
        "type": "Caption",
        "props": { "text": { "$item": "meta_label" }, "tone": "muted", "truncate": true }
      },
      "surveyRight": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["surveyRate", "surveyClosedDate"]
      },
      "surveyRate": {
        "type": "Text",
        "props": { "text": { "$item": "rate_label" }, "size": "sm", "weight": "bold", "align": "right" },
        "visible": { "$item": "has_rate" }
      },
      "surveyClosedDate": {
        "type": "Caption",
        "props": { "text": { "$item": "closed_label" }, "tone": "muted", "align": "right" }
      },
      "surveyDivider": { "type": "Divider", "props": {} }
    }
  },
  "status": "published"
}
