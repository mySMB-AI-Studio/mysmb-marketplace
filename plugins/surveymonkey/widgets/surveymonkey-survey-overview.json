{
  "id": "surveymonkey-survey-overview",
  "title": "Survey Overview",
  "description": "At-a-glance summary of all SurveyMonkey surveys: total count, status breakdown, and response stats.",
  "category": "surveys",
  "tags": ["surveymonkey", "surveys", "responses", "overview"],
  "keywords": ["survey", "forms", "responses", "overview", "list"],
  "connectorsUsed": ["surveymonkey"],
  "popularity": 70,
  "sizing": {
    "preferred": { "colSpan": 5, "rowSpan": 7 },
    "min": { "colSpan": 4, "rowSpan": 6 },
    "max": { "colSpan": 8, "rowSpan": 12 }
  },
  "dataProvider": {
    "mcp": "surveymonkey",
    "tool": "list_surveys",
    "params": { "per_page": 100, "sort_by": "date_modified", "sort_order": "DESC", "include": "status" }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": ["header", "body"],
        "watch": {
          "/surveymonkey/list_surveys/data": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/summary",
                "value": {
                  "$computed": "surveymonkey_flatten_survey_overview",
                  "args": { "value": { "$state": "/surveymonkey/list_surveys/data" } }
                }
              }
            }
          ]
        }
      },

      "header": { "type": "Header", "props": {}, "children": ["titleStack"] },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "eyebrow"]
      },
      "title": { "type": "Heading", "props": { "text": "Survey Overview", "level": "h2" } },
      "eyebrow": { "type": "Eyebrow", "props": { "text": "SurveyMonkey" } },

      "body": { "type": "Body", "props": {}, "children": ["loading", "empty", "content"] },

      "loading": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["sk1", "sk2", "sk3"],
        "visible": { "$state": "/_loading/surveymonkey.list_surveys" }
      },
      "sk1": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "sk2": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "sk3": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },

      "empty": {
        "type": "Empty",
        "props": { "message": "No surveys found in SurveyMonkey." },
        "visible": {
          "$and": [
            { "$state": "/_loading/surveymonkey.list_surveys", "not": true },
            { "$state": "/ui/summary/total_label", "not": true }
          ]
        }
      },

      "content": {
        "type": "Stack",
        "props": { "gap": "md" },
        "children": ["totalRow", "segBar", "legendRow", "div1", "statsRow"],
        "visible": {
          "$and": [
            { "$state": "/_loading/surveymonkey.list_surveys", "not": true },
            { "$state": "/ui/summary/total_label" }
          ]
        }
      },

      "totalRow": {
        "type": "Row",
        "props": { "gap": "sm", "align": "baseline" },
        "children": ["totalCount", "totalLabel"]
      },
      "totalCount": {
        "type": "Heading",
        "props": { "text": { "$state": "/ui/summary/total_label" }, "level": "h1" }
      },
      "totalLabel": {
        "type": "Text",
        "props": { "text": "total surveys (all time)", "tone": "muted", "size": "sm" }
      },

      "segBar": {
        "type": "Row",
        "props": { "gap": "none", "template": { "$state": "/ui/summary/bar_template" } },
        "children": ["barOpenWrap", "barClosedWrap", "barDraftWrap"]
      },
      "barOpenWrap": { "type": "Row", "props": {}, "children": ["barOpen"] },
      "barOpen": { "type": "ProgressBar", "props": { "value": 100, "tone": "success" } },
      "barClosedWrap": { "type": "Row", "props": {}, "children": ["barClosed"] },
      "barClosed": { "type": "ProgressBar", "props": { "value": 100, "tone": "info" } },
      "barDraftWrap": { "type": "Row", "props": {}, "children": ["barDraft"] },
      "barDraft": { "type": "ProgressBar", "props": { "value": 100, "tone": "accent" } },

      "legendRow": {
        "type": "Row",
        "props": { "gap": "md", "wrap": true },
        "children": ["openLegend", "closedLegend", "draftLegend"]
      },
      "openLegend": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["openDot", "openLabel"]
      },
      "openDot": { "type": "Dot", "props": { "tone": "success" } },
      "openLabel": { "type": "Caption", "props": { "text": { "$state": "/ui/summary/in_progress_legend" } } },
      "closedLegend": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["closedDot", "closedLabel"]
      },
      "closedDot": { "type": "Dot", "props": { "tone": "info" } },
      "closedLabel": { "type": "Caption", "props": { "text": { "$state": "/ui/summary/completed_legend" } } },
      "draftLegend": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["draftDot", "draftLabel"]
      },
      "draftDot": { "type": "Dot", "props": { "tone": "accent" } },
      "draftLabel": { "type": "Caption", "props": { "text": { "$state": "/ui/summary/upcoming_legend" } } },

      "div1": { "type": "Divider", "props": {} },

      "statsRow": {
        "type": "Row",
        "props": { "gap": "sm", "template": "1fr 1fr" },
        "children": ["totalRespSection", "avgRespSection"]
      },
      "totalRespSection": {
        "type": "Section",
        "props": { "variant": "muted", "padding": "sm" },
        "children": ["totalRespNum", "totalRespLabel"]
      },
      "totalRespNum": {
        "type": "Heading",
        "props": { "text": { "$state": "/ui/summary/total_responses" }, "level": "h2" }
      },
      "totalRespLabel": { "type": "Caption", "props": { "text": "Total Responses" } },
      "avgRespSection": {
        "type": "Section",
        "props": { "variant": "muted", "padding": "sm" },
        "children": ["avgRespNum", "avgRespLabel"]
      },
      "avgRespNum": {
        "type": "Heading",
        "props": { "text": { "$state": "/ui/summary/avg_responses" }, "level": "h2" }
      },
      "avgRespLabel": { "type": "Caption", "props": { "text": "Avg Responses" } }
    }
  },
  "status": "published"
}
