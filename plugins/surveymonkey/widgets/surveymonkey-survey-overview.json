{
  "id": "surveymonkey-survey-overview",
  "title": "Survey Overview",
  "description": "List of your SurveyMonkey surveys with response counts and status.",
  "category": "surveys",
  "tags": ["surveymonkey", "surveys", "responses", "overview"],
  "keywords": ["survey", "forms", "responses", "overview", "list"],
  "connectorsUsed": ["surveymonkey"],
  "popularity": 70,
  "sizing": {
    "preferred": { "colSpan": 5, "rowSpan": 5 },
    "min": { "colSpan": 3, "rowSpan": 4 },
    "max": { "colSpan": 12, "rowSpan": 10 }
  },
  "dataProvider": {
    "mcp": "surveymonkey",
    "tool": "list_surveys",
    "params": {}
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": ["header", "body"]
      },
      "header": {
        "type": "Header",
        "props": {},
        "children": ["titleGroup"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "start" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "BarChart2", "tone": "accent", "size": "sm" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "subtitle"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Survey Overview", "level": "h2" }
      },
      "subtitle": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{n} Surveys",
              "n": {
                "$computed": "count",
                "args": { "value": { "$state": "/surveymonkey/list_surveys/records" } }
              }
            }
          }
        }
      },
      "body": {
        "type": "Body",
        "props": {},
        "children": ["loading", "empty", "surveyList"]
      },
      "loading": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["sk1", "sk2", "sk3", "sk4"],
        "visible": { "$state": "/_loading/surveymonkey.list_surveys" }
      },
      "sk1": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "sk2": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "sk3": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "sk4": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "empty": {
        "type": "Empty",
        "props": { "message": "No surveys found in SurveyMonkey." },
        "visible": {
          "$and": [
            { "$state": "/_loading/surveymonkey.list_surveys", "not": true },
            { "$state": "/surveymonkey/list_surveys/records/0", "not": true }
          ]
        }
      },
      "surveyList": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["surveyRow"],
        "repeat": {
          "statePath": "/surveymonkey/list_surveys/records",
          "key": "id"
        },
        "visible": {
          "$and": [
            { "$state": "/_loading/surveymonkey.list_surveys", "not": true },
            { "$state": "/surveymonkey/list_surveys/records/0" }
          ]
        }
      },
      "surveyRow": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center", "justify": "between", "hover": true },
        "children": ["surveyLeft", "surveyMeta"]
      },
      "surveyLeft": {
        "type": "Stack",
        "props": { "gap": "none", "grow": true },
        "children": ["surveyTitle", "surveyResponseCount"]
      },
      "surveyTitle": {
        "type": "Text",
        "props": {
          "text": { "$item": "title" },
          "size": "sm",
          "weight": "medium",
          "truncate": true
        }
      },
      "surveyResponseCount": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{n} responses",
              "n": { "$item": "response_count" }
            }
          },
          "tone": "muted"
        }
      },
      "surveyMeta": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "surveymonkey_format_date",
            "args": { "value": { "$item": "date_modified" } }
          },
          "tone": "muted"
        }
      }
    }
  },
  "status": "published"
}
