{
  "category": "surveys",
  "connectorsUsed": [
    "surveymonkey"
  ],
  "dataProvider": {
    "kind": "tool",
    "mcp": "surveymonkey",
    "params": {
      "include": "response_count,date_created,date_modified",
      "per_page": 100,
      "sort_by": "date_modified",
      "sort_order": "DESC"
    },
    "tool": "list_surveys"
  },
  "description": "Chronological event list of recent survey launches and closings.",
  "id": "surveymonkey-survey-calendar-events",
  "keywords": [
    "survey calendar",
    "events",
    "launching",
    "closing",
    "schedule"
  ],
  "popularity": 60,
  "sizing": {
    "max": {
      "colSpan": 6,
      "rowSpan": 14
    },
    "min": {
      "colSpan": 3,
      "rowSpan": 6
    },
    "preferred": {
      "colSpan": 4,
      "rowSpan": 10
    }
  },
  "spec": {
    "elements": {
      "body": {
        "children": [
          "loading",
          "empty",
          "content"
        ],
        "props": {},
        "type": "Body"
      },
      "card": {
        "children": [
          "header",
          "body"
        ],
        "props": {},
        "type": "Card",
        "watch": {
          "/surveymonkey/list_surveys/data": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/events",
                "value": {
                  "$computed": "surveymonkey_flatten_upcoming_calendar",
                  "args": {
                    "value": {
                      "$state": "/surveymonkey/list_surveys/data"
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "content": {
        "children": [
          "eventList"
        ],
        "props": {
          "gap": "sm"
        },
        "type": "Stack",
        "visible": {
          "$and": [
            {
              "$state": "/_loading/surveymonkey.list_surveys",
              "not": true
            },
            {
              "$state": "/ui/events/0"
            }
          ]
        }
      },
      "empty": {
        "props": {
          "message": "No survey events found."
        },
        "type": "Empty",
        "visible": {
          "$and": [
            {
              "$state": "/_loading/surveymonkey.list_surveys",
              "not": true
            },
            {
              "$state": "/ui/events/0",
              "not": true
            }
          ]
        }
      },
      "eventAudience": {
        "props": {
          "text": {
            "$item": "audience"
          },
          "tone": "muted"
        },
        "type": "Caption",
        "visible": {
          "$item": "audience"
        }
      },
      "eventBadge": {
        "props": {
          "text": {
            "$item": "event_label"
          },
          "tone": {
            "$item": "event_tone"
          },
          "variant": "soft"
        },
        "type": "Badge"
      },
      "eventBadgeWrap": {
        "children": [
          "eventBadge"
        ],
        "props": {
          "gap": "none"
        },
        "type": "Row"
      },
      "eventDateLabel": {
        "props": {
          "text": {
            "$item": "date_label"
          },
          "tone": "muted"
        },
        "type": "Eyebrow"
      },
      "eventDetails": {
        "children": [
          "eventDateLabel",
          "eventTitle",
          "eventAudience",
          "eventBadgeWrap"
        ],
        "props": {
          "gap": "xs"
        },
        "type": "Stack"
      },
      "eventDot": {
        "props": {
          "size": "sm",
          "tone": {
            "$item": "dot_tone"
          }
        },
        "type": "Dot"
      },
      "eventList": {
        "children": [
          "eventRow"
        ],
        "props": {
          "gap": "md"
        },
        "repeat": {
          "key": "id",
          "statePath": "/ui/events"
        },
        "type": "Stack"
      },
      "eventRow": {
        "children": [
          "eventDot",
          "eventDetails"
        ],
        "props": {
          "align": "start",
          "gap": "sm"
        },
        "type": "Row"
      },
      "eventTitle": {
        "props": {
          "size": "sm",
          "text": {
            "$item": "title"
          },
          "weight": "bold"
        },
        "type": "Text"
      },
      "eyebrow": {
        "props": {
          "text": "SurveyMonkey"
        },
        "type": "Eyebrow"
      },
      "header": {
        "children": [
          "titleGroup"
        ],
        "props": {},
        "type": "Header"
      },
      "loading": {
        "children": [
          "sk1",
          "sk2",
          "sk3"
        ],
        "props": {
          "gap": "sm"
        },
        "type": "Stack",
        "visible": {
          "$state": "/_loading/surveymonkey.list_surveys"
        }
      },
      "sk1": {
        "props": {
          "height": "4rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "sk2": {
        "props": {
          "height": "4rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "sk3": {
        "props": {
          "height": "4rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "title": {
        "props": {
          "level": "h2",
          "text": "Survey Calendar"
        },
        "type": "Heading"
      },
      "titleGroup": {
        "children": [
          "titleIcon",
          "titleStack"
        ],
        "props": {
          "align": "center",
          "gap": "sm"
        },
        "type": "Row"
      },
      "titleIcon": {
        "props": {
          "name": "Calendar",
          "size": "sm",
          "tone": "accent"
        },
        "type": "Icon"
      },
      "titleStack": {
        "children": [
          "title",
          "eyebrow"
        ],
        "props": {
          "gap": "none"
        },
        "type": "Stack"
      }
    },
    "root": "card"
  },
  "tags": [
    "surveymonkey",
    "surveys",
    "calendar",
    "events",
    "launching",
    "closing"
  ],
  "title": "Survey Calendar"
}
