{
  "id": "surveymonkey-response-summary",
  "title": "Response Summary",
  "description": "Breakdown of total responses across all surveys with a top-survey highlight.",
  "category": "surveys",
  "tags": ["surveymonkey", "surveys", "responses", "summary", "analytics"],
  "keywords": ["response count", "total responses", "survey analytics", "top surveys", "engagement"],
  "connectorsUsed": ["surveymonkey"],
  "popularity": 65,
  "sizing": {
    "preferred": { "colSpan": 3, "rowSpan": 4 },
    "min": { "colSpan": 2, "rowSpan": 3 },
    "max": { "colSpan": 6, "rowSpan": 8 }
  },
  "dataProvider": {
    "mcp": "surveymonkey",
    "tool": "list_surveys",
    "params": {}
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": ["header", "body"],
        "watch": {
          "/surveymonkey/list_surveys/records": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/totalResponses",
                "value": {
                  "$computed": "sum",
                  "args": {
                    "value": { "$state": "/surveymonkey/list_surveys/records" },
                    "field": "response_count"
                  }
                }
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/topSurveys",
                "value": {
                  "$computed": "top_n",
                  "args": {
                    "value": { "$state": "/surveymonkey/list_surveys/records" },
                    "field": "response_count",
                    "n": 5
                  }
                }
              }
            }
          ]
        }
      },
      "header": {
        "type": "Header",
        "props": {},
        "children": ["titleGroup"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "start" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "Users", "tone": "accent", "size": "sm" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "subtitle"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Response Summary", "level": "h2" }
      },
      "subtitle": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{total} Total Responses",
              "total": { "$state": "/ui/totalResponses" }
            }
          }
        }
      },
      "body": {
        "type": "Body",
        "props": {},
        "children": ["loading", "empty", "totalStat", "totalCaption", "topDivider", "topList"]
      },
      "loading": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["sk1", "sk2", "sk3", "sk4"],
        "visible": { "$state": "/_loading/surveymonkey.list_surveys" }
      },
      "sk1": { "type": "Skeleton", "props": { "height": "3rem", "rounded": "md" } },
      "sk2": { "type": "Skeleton", "props": { "height": "2rem", "rounded": "md" } },
      "sk3": { "type": "Skeleton", "props": { "height": "2rem", "rounded": "md" } },
      "sk4": { "type": "Skeleton", "props": { "height": "2rem", "rounded": "md" } },
      "empty": {
        "type": "Empty",
        "props": { "message": "No surveys found in SurveyMonkey." },
        "visible": {
          "$and": [
            { "$state": "/_loading/surveymonkey.list_surveys", "not": true },
            { "$state": "/surveymonkey/list_surveys/records/0", "not": true }
          ]
        }
      },
      "totalStat": {
        "type": "Stat",
        "props": {
          "value": { "$state": "/ui/totalResponses" },
          "size": "lg"
        },
        "visible": {
          "$and": [
            { "$state": "/_loading/surveymonkey.list_surveys", "not": true },
            { "$state": "/surveymonkey/list_surveys/records/0" }
          ]
        }
      },
      "totalCaption": {
        "type": "Caption",
        "props": { "text": "responses across all surveys" },
        "visible": {
          "$and": [
            { "$state": "/_loading/surveymonkey.list_surveys", "not": true },
            { "$state": "/surveymonkey/list_surveys/records/0" }
          ]
        }
      },
      "topDivider": {
        "type": "Divider",
        "props": {},
        "visible": {
          "$and": [
            { "$state": "/_loading/surveymonkey.list_surveys", "not": true },
            { "$state": "/surveymonkey/list_surveys/records/0" }
          ]
        }
      },
      "topList": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["topRow"],
        "repeat": {
          "statePath": "/ui/topSurveys",
          "key": "id"
        },
        "visible": {
          "$and": [
            { "$state": "/_loading/surveymonkey.list_surveys", "not": true },
            { "$state": "/ui/topSurveys/0" }
          ]
        }
      },
      "topRow": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center", "justify": "between" },
        "children": ["topTitle", "topBadge"]
      },
      "topTitle": {
        "type": "Text",
        "props": {
          "text": { "$item": "title" },
          "size": "sm",
          "truncate": true,
          "grow": true
        }
      },
      "topBadge": {
        "type": "Badge",
        "props": {
          "text": { "$item": "response_count" },
          "tone": "accent",
          "variant": "soft"
        }
      }
    }
  },
  "status": "published"
}
