{
  "id": "surveymonkey-response-summary",
  "title": "Response Summary",
  "description": "Breakdown of total responses across all surveys with a top-survey highlight.",
  "category": "surveys",
  "tags": ["surveymonkey", "surveys", "responses", "summary", "analytics"],
  "keywords": ["response count", "total responses", "survey analytics", "top surveys", "engagement"],
  "connectorsUsed": ["surveymonkey"],
  "popularity": 65,
  "sizing": {
    "preferred": { "colSpan": 4, "rowSpan": 7 },
    "min": { "colSpan": 3, "rowSpan": 5 },
    "max": { "colSpan": 6, "rowSpan": 10 }
  },
  "dataProvider": {
    "mcp": "surveymonkey",
    "tool": "list_surveys",
    "params": {}
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": ["header", "body"],
        "watch": {
          "/surveymonkey/list_surveys/data": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/totalResponses",
                "value": {
                  "$computed": "sum",
                  "args": {
                    "value": { "$state": "/surveymonkey/list_surveys/data" },
                    "field": "response_count"
                  }
                }
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/topSurveys",
                "value": {
                  "$computed": "surveymonkey_add_ranks",
                  "args": {
                    "value": {
                      "$computed": "top_n",
                      "args": {
                        "value": { "$state": "/surveymonkey/list_surveys/data" },
                        "field": "response_count",
                        "n": 5
                      }
                    }
                  }
                }
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/maxResponses",
                "value": {
                  "$computed": "sum",
                  "args": {
                    "value": {
                      "$computed": "filter_max_field",
                      "args": {
                        "value": { "$state": "/surveymonkey/list_surveys/data" },
                        "field": "response_count"
                      }
                    },
                    "field": "response_count"
                  }
                }
              }
            }
          ]
        }
      },
      "header": {
        "type": "Header",
        "props": {},
        "children": ["titleGroup"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "start" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "Users", "tone": "accent", "size": "sm" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "subtitle"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Response Summary", "level": "h2" }
      },
      "subtitle": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{total} Total Responses",
              "total": { "$state": "/ui/totalResponses" }
            }
          }
        }
      },
      "body": {
        "type": "Body",
        "props": {},
        "children": ["loading", "empty", "contentStack"]
      },
      "loading": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["sk1", "sk2", "sk3", "sk4"],
        "visible": { "$state": "/_loading/surveymonkey.list_surveys" }
      },
      "sk1": { "type": "Skeleton", "props": { "height": "3rem",   "rounded": "md" } },
      "sk2": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "sk3": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "sk4": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "empty": {
        "type": "Empty",
        "props": { "message": "No surveys found in SurveyMonkey." },
        "visible": {
          "$and": [
            { "$state": "/_loading/surveymonkey.list_surveys", "not": true },
            { "$state": "/surveymonkey/list_surveys/data/0", "not": true }
          ]
        }
      },
      "contentStack": {
        "type": "Stack",
        "props": { "gap": "md" },
        "children": ["statStack", "topDivider", "topList"],
        "visible": {
          "$and": [
            { "$state": "/_loading/surveymonkey.list_surveys", "not": true },
            { "$state": "/surveymonkey/list_surveys/data/0" }
          ]
        }
      },
      "statStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["totalStat", "totalCaption"]
      },
      "totalStat": {
        "type": "Stat",
        "props": { "value": { "$state": "/ui/totalResponses" }, "size": "lg" }
      },
      "totalCaption": {
        "type": "Caption",
        "props": { "text": "responses across all surveys" }
      },
      "topDivider": {
        "type": "Divider",
        "props": {}
      },
      "topList": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["topRow"],
        "repeat": {
          "statePath": "/ui/topSurveys",
          "key": "id"
        }
      },
      "topRow": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["rankBadge", "topContent", "topCount"]
      },
      "rankBadge": {
        "type": "Badge",
        "props": {
          "text": { "$item": "rank" },
          "tone": "muted",
          "variant": "soft"
        }
      },
      "topContent": {
        "type": "Stack",
        "props": { "gap": "xxs", "grow": true },
        "children": ["topTitle", "topBar"]
      },
      "topTitle": {
        "type": "Text",
        "props": {
          "text": { "$item": "title" },
          "size": "sm",
          "weight": "semibold",
          "truncate": true
        }
      },
      "topBar": {
        "type": "ProgressBar",
        "props": {
          "value": {
            "$computed": "pct",
            "args": {
              "part": { "$item": "response_count" },
              "whole": { "$state": "/ui/maxResponses" }
            }
          },
          "max": 100,
          "tone": "accent"
        }
      },
      "topCount": {
        "type": "Text",
        "props": {
          "text": { "$item": "response_count" },
          "size": "sm",
          "tone": "muted"
        }
      }
    }
  },
  "status": "published"
}
