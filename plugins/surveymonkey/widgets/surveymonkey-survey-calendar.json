{
  "id": "surveymonkey-survey-calendar",
  "title": "This Week's Surveys",
  "description": "7-day activity strip showing survey launches and closings for the current week.",
  "category": "surveys",
  "tags": ["surveymonkey", "surveys", "calendar", "activity", "week"],
  "keywords": ["survey calendar", "this week", "launching", "closing", "responses"],
  "connectorsUsed": ["surveymonkey"],
  "popularity": 55,
  "sizing": {
    "preferred": { "colSpan": 4, "rowSpan": 8 },
    "min": { "colSpan": 3, "rowSpan": 6 },
    "max": { "colSpan": 6, "rowSpan": 12 }
  },
  "dataProvider": {
    "mcp": "surveymonkey",
    "tool": "list_surveys",
    "params": { "per_page": 100, "sort_by": "date_modified", "sort_order": "DESC", "include": "status" }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": ["header", "body"],
        "watch": {
          "/surveymonkey/list_surveys/data": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/week",
                "value": {
                  "$computed": "surveymonkey_flatten_week_surveys",
                  "args": {
                    "value": { "$state": "/surveymonkey/list_surveys/data" }
                  }
                }
              }
            }
          ]
        }
      },
      "header": {
        "type": "Header",
        "props": {},
        "children": ["titleGroup"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "start" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "CalendarDays", "tone": "accent", "size": "sm" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "weekEyebrow"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "This Week's Surveys", "level": "h2" }
      },
      "weekEyebrow": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "surveymonkey_current_week_label",
            "args": {}
          }
        }
      },
      "body": {
        "type": "Body",
        "props": {},
        "children": ["loading", "content"]
      },
      "loading": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["skStrip", "skStats", "skList"],
        "visible": { "$state": "/_loading/surveymonkey.list_surveys" }
      },
      "skStrip": { "type": "Skeleton", "props": { "height": "4rem", "rounded": "md" } },
      "skStats": { "type": "Skeleton", "props": { "height": "3rem", "rounded": "md" } },
      "skList": { "type": "Skeleton", "props": { "height": "6rem", "rounded": "md" } },
      "content": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["dayStrip", "statsRow", "eventList", "noEventsCaption"],
        "visible": { "$state": "/_loading/surveymonkey.list_surveys", "not": true }
      },
      "dayStrip": {
        "type": "Row",
        "props": { "gap": "xs", "template": "1fr 1fr 1fr 1fr 1fr 1fr 1fr" },
        "children": ["dayCell"],
        "repeat": {
          "statePath": "/ui/week/days",
          "key": "key"
        }
      },
      "dayCell": {
        "type": "Stack",
        "props": { "gap": "none", "align": "center" },
        "children": ["todaySection", "normalSection"]
      },
      "todaySection": {
        "type": "Section",
        "props": { "variant": "muted", "padding": "xs", "align": "center" },
        "children": ["dayAbbrToday", "dayNumToday", "eventDotToday"],
        "visible": { "$item": "is_today" }
      },
      "normalSection": {
        "type": "Section",
        "props": { "variant": "muted", "padding": "xs", "align": "center" },
        "children": ["dayAbbrNormal", "dayNumNormal", "eventDotNormal"],
        "visible": { "$item": "is_today", "not": true }
      },
      "dayAbbrToday": {
        "type": "Caption",
        "props": { "text": { "$item": "abbr" }, "tone": "muted" }
      },
      "dayNumToday": {
        "type": "Text",
        "props": { "text": { "$item": "num" }, "size": "sm", "tone": "default" }
      },
      "eventDotToday": {
        "type": "Dot",
        "props": { "tone": "warning", "size": "xs" },
        "visible": { "$item": "has_event" }
      },
      "dayAbbrNormal": {
        "type": "Caption",
        "props": { "text": { "$item": "abbr" }, "tone": "muted" }
      },
      "dayNumNormal": {
        "type": "Text",
        "props": { "text": { "$item": "num" }, "size": "sm", "tone": "default" }
      },
      "eventDotNormal": {
        "type": "Dot",
        "props": { "tone": "warning", "size": "xs" },
        "visible": { "$item": "has_event" }
      },
      "statsRow": {
        "type": "Row",
        "props": { "gap": "sm", "template": "1fr 1fr 1fr" },
        "children": ["statLaunchingWrap", "statClosingWrap", "statResponsesWrap"]
      },
      "statLaunchingWrap": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["statLaunching"]
      },
      "statLaunching": {
        "type": "Section",
        "props": { "variant": "muted", "padding": "xs", "align": "center" },
        "children": ["statLaunchingNum", "statLaunchingLabel"]
      },
      "statLaunchingNum": {
        "type": "Heading",
        "props": { "text": { "$state": "/ui/week/stat_launching" }, "level": "h3" }
      },
      "statLaunchingLabel": {
        "type": "Caption",
        "props": { "text": "Launching", "tone": "muted" }
      },
      "statClosingWrap": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["statClosing"]
      },
      "statClosing": {
        "type": "Section",
        "props": { "variant": "muted", "padding": "xs", "align": "center" },
        "children": ["statClosingNum", "statClosingLabel"]
      },
      "statClosingNum": {
        "type": "Heading",
        "props": { "text": { "$state": "/ui/week/stat_closing" }, "level": "h3" }
      },
      "statClosingLabel": {
        "type": "Caption",
        "props": { "text": "Closing", "tone": "muted" }
      },
      "statResponsesWrap": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["statResponses"]
      },
      "statResponses": {
        "type": "Section",
        "props": { "variant": "muted", "padding": "xs", "align": "center" },
        "children": ["statResponsesNum", "statResponsesLabel"]
      },
      "statResponsesNum": {
        "type": "Heading",
        "props": { "text": { "$state": "/ui/week/stat_responses" }, "level": "h3" }
      },
      "statResponsesLabel": {
        "type": "Caption",
        "props": { "text": "Responses", "tone": "muted" }
      },
      "eventList": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["eventRow"],
        "repeat": {
          "statePath": "/ui/week/event_rows",
          "key": "id"
        },
        "visible": { "$state": "/ui/week/has_events" }
      },
      "eventRow": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center", "justify": "between" },
        "children": ["eventInfo", "eventBadge"]
      },
      "eventInfo": {
        "type": "Stack",
        "props": { "gap": "none", "grow": true },
        "children": ["eventTitle", "eventDateLabel"]
      },
      "eventTitle": {
        "type": "Text",
        "props": {
          "text": { "$item": "title" },
          "size": "sm",
          "weight": "semibold",
          "truncate": true
        }
      },
      "eventDateLabel": {
        "type": "Caption",
        "props": { "text": { "$item": "date_label" }, "tone": "muted" }
      },
      "eventBadge": {
        "type": "Badge",
        "props": {
          "text": { "$item": "event_label" },
          "tone": { "$item": "event_tone" },
          "variant": "soft"
        }
      },
      "noEventsCaption": {
        "type": "Empty",
        "props": { "message": "No survey activity this week." },
        "visible": { "$state": "/ui/week/has_events", "not": true }
      }
    }
  },
  "status": "published"
}
