{
  "category": "surveys",
  "connectorsUsed": [
    "surveymonkey"
  ],
  "dataProvider": {
    "kind": "tool",
    "mcp": "surveymonkey",
    "params": {
      "include": "response_count,date_created,date_modified",
      "per_page": 100,
      "sort_by": "date_modified",
      "sort_order": "DESC"
    },
    "tool": "list_surveys"
  },
  "description": "7-day activity strip showing survey launches and closings for the current week.",
  "id": "surveymonkey-survey-calendar",
  "keywords": [
    "survey calendar",
    "this week",
    "launching",
    "closing",
    "responses"
  ],
  "popularity": 55,
  "sizing": {
    "max": {
      "colSpan": 6,
      "rowSpan": 12
    },
    "min": {
      "colSpan": 3,
      "rowSpan": 6
    },
    "preferred": {
      "colSpan": 4,
      "rowSpan": 8
    }
  },
  "spec": {
    "elements": {
      "body": {
        "children": [
          "loading",
          "content"
        ],
        "props": {},
        "type": "Body"
      },
      "card": {
        "children": [
          "header",
          "body"
        ],
        "props": {},
        "type": "Card",
        "watch": {
          "/surveymonkey/list_surveys/data": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/week",
                "value": {
                  "$computed": "surveymonkey_flatten_week_surveys",
                  "args": {
                    "value": {
                      "$state": "/surveymonkey/list_surveys/data"
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "content": {
        "children": [
          "dayStrip",
          "statsRow",
          "eventList",
          "noEventsCaption"
        ],
        "props": {
          "gap": "sm"
        },
        "type": "Stack",
        "visible": {
          "$state": "/_loading/surveymonkey.list_surveys",
          "not": true
        }
      },
      "dayAbbrNormal": {
        "props": {
          "text": {
            "$item": "abbr"
          },
          "tone": "muted"
        },
        "type": "Caption"
      },
      "dayAbbrToday": {
        "props": {
          "text": {
            "$item": "abbr"
          },
          "tone": "muted"
        },
        "type": "Caption"
      },
      "dayCell": {
        "children": [
          "todaySection",
          "normalSection"
        ],
        "props": {
          "align": "center",
          "gap": "none"
        },
        "type": "Stack"
      },
      "dayNumNormal": {
        "props": {
          "size": "sm",
          "text": {
            "$item": "num"
          },
          "tone": "default"
        },
        "type": "Text"
      },
      "dayNumToday": {
        "props": {
          "size": "sm",
          "text": {
            "$item": "num"
          },
          "tone": "default"
        },
        "type": "Text"
      },
      "dayStrip": {
        "children": [
          "dayCell"
        ],
        "props": {
          "gap": "xs",
          "template": "1fr 1fr 1fr 1fr 1fr 1fr 1fr"
        },
        "repeat": {
          "key": "key",
          "statePath": "/ui/week/days"
        },
        "type": "Row"
      },
      "eventBadge": {
        "props": {
          "text": {
            "$item": "event_label"
          },
          "tone": {
            "$item": "event_tone"
          },
          "variant": "soft"
        },
        "type": "Badge"
      },
      "eventDateLabel": {
        "props": {
          "text": {
            "$item": "date_label"
          },
          "tone": "muted"
        },
        "type": "Caption"
      },
      "eventDotNormal": {
        "props": {
          "size": "xs",
          "tone": "warning"
        },
        "type": "Dot",
        "visible": {
          "$item": "has_event"
        }
      },
      "eventDotToday": {
        "props": {
          "size": "xs",
          "tone": "warning"
        },
        "type": "Dot",
        "visible": {
          "$item": "has_event"
        }
      },
      "eventInfo": {
        "children": [
          "eventTitle",
          "eventDateLabel"
        ],
        "props": {
          "gap": "none",
          "grow": true
        },
        "type": "Stack"
      },
      "eventList": {
        "children": [
          "eventRow"
        ],
        "props": {
          "gap": "xs"
        },
        "repeat": {
          "key": "id",
          "statePath": "/ui/week/event_rows"
        },
        "type": "Stack",
        "visible": {
          "$state": "/ui/week/has_events"
        }
      },
      "eventRow": {
        "children": [
          "eventInfo",
          "eventBadge"
        ],
        "props": {
          "align": "center",
          "gap": "sm",
          "justify": "between"
        },
        "type": "Row"
      },
      "eventTitle": {
        "props": {
          "size": "sm",
          "text": {
            "$item": "title"
          },
          "truncate": true,
          "weight": "semibold"
        },
        "type": "Text"
      },
      "header": {
        "children": [
          "titleGroup"
        ],
        "props": {},
        "type": "Header"
      },
      "loading": {
        "children": [
          "skStrip",
          "skStats",
          "skList"
        ],
        "props": {
          "gap": "sm"
        },
        "type": "Stack",
        "visible": {
          "$state": "/_loading/surveymonkey.list_surveys"
        }
      },
      "noEventsCaption": {
        "props": {
          "message": "No survey activity this week."
        },
        "type": "Empty",
        "visible": {
          "$state": "/ui/week/has_events",
          "not": true
        }
      },
      "normalSection": {
        "children": [
          "dayAbbrNormal",
          "dayNumNormal",
          "eventDotNormal"
        ],
        "props": {
          "align": "center",
          "padding": "xs",
          "variant": "muted"
        },
        "type": "Section",
        "visible": {
          "$item": "is_today",
          "not": true
        }
      },
      "skList": {
        "props": {
          "height": "6rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "skStats": {
        "props": {
          "height": "3rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "skStrip": {
        "props": {
          "height": "4rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "statClosing": {
        "children": [
          "statClosingNum",
          "statClosingLabel"
        ],
        "props": {
          "align": "center",
          "padding": "xs",
          "variant": "muted"
        },
        "type": "Section"
      },
      "statClosingLabel": {
        "props": {
          "text": "Closing",
          "tone": "muted"
        },
        "type": "Caption"
      },
      "statClosingNum": {
        "props": {
          "level": "h3",
          "text": {
            "$state": "/ui/week/stat_closing"
          }
        },
        "type": "Heading"
      },
      "statClosingWrap": {
        "children": [
          "statClosing"
        ],
        "props": {
          "gap": "none"
        },
        "type": "Stack"
      },
      "statLaunching": {
        "children": [
          "statLaunchingNum",
          "statLaunchingLabel"
        ],
        "props": {
          "align": "center",
          "padding": "xs",
          "variant": "muted"
        },
        "type": "Section"
      },
      "statLaunchingLabel": {
        "props": {
          "text": "Launching",
          "tone": "muted"
        },
        "type": "Caption"
      },
      "statLaunchingNum": {
        "props": {
          "level": "h3",
          "text": {
            "$state": "/ui/week/stat_launching"
          }
        },
        "type": "Heading"
      },
      "statLaunchingWrap": {
        "children": [
          "statLaunching"
        ],
        "props": {
          "gap": "none"
        },
        "type": "Stack"
      },
      "statResponses": {
        "children": [
          "statResponsesNum",
          "statResponsesLabel"
        ],
        "props": {
          "align": "center",
          "padding": "xs",
          "variant": "muted"
        },
        "type": "Section"
      },
      "statResponsesLabel": {
        "props": {
          "text": "Responses",
          "tone": "muted"
        },
        "type": "Caption"
      },
      "statResponsesNum": {
        "props": {
          "level": "h3",
          "text": {
            "$state": "/ui/week/stat_responses"
          }
        },
        "type": "Heading"
      },
      "statResponsesWrap": {
        "children": [
          "statResponses"
        ],
        "props": {
          "gap": "none"
        },
        "type": "Stack"
      },
      "statsRow": {
        "children": [
          "statLaunchingWrap",
          "statClosingWrap",
          "statResponsesWrap"
        ],
        "props": {
          "gap": "sm",
          "template": "1fr 1fr 1fr"
        },
        "type": "Row"
      },
      "title": {
        "props": {
          "level": "h2",
          "text": "This Week's Surveys"
        },
        "type": "Heading"
      },
      "titleGroup": {
        "children": [
          "titleIcon",
          "titleStack"
        ],
        "props": {
          "align": "center",
          "gap": "sm"
        },
        "type": "Row"
      },
      "titleIcon": {
        "props": {
          "name": "CalendarDays",
          "size": "sm",
          "tone": "accent"
        },
        "type": "Icon"
      },
      "titleStack": {
        "children": [
          "title",
          "weekEyebrow"
        ],
        "props": {
          "gap": "none"
        },
        "type": "Stack"
      },
      "todaySection": {
        "children": [
          "dayAbbrToday",
          "dayNumToday",
          "eventDotToday"
        ],
        "props": {
          "align": "center",
          "padding": "xs",
          "variant": "muted"
        },
        "type": "Section",
        "visible": {
          "$item": "is_today"
        }
      },
      "weekEyebrow": {
        "props": {
          "text": {
            "$computed": "surveymonkey_current_week_label",
            "args": {}
          }
        },
        "type": "Eyebrow"
      }
    },
    "root": "card"
  },
  "tags": [
    "surveymonkey",
    "surveys",
    "calendar",
    "activity",
    "week"
  ],
  "title": "This Week's Surveys"
}
