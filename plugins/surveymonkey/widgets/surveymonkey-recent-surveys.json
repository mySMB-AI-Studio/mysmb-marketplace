{
  "id": "surveymonkey-recent-surveys",
  "title": "Recent Surveys",
  "description": "Your 10 most recently modified SurveyMonkey surveys.",
  "category": "surveys",
  "tags": ["surveymonkey", "surveys", "recent", "modified"],
  "keywords": ["recent surveys", "latest surveys", "modified", "survey list", "forms"],
  "connectorsUsed": ["surveymonkey"],
  "popularity": 60,
  "sizing": {
    "preferred": { "colSpan": 4, "rowSpan": 5 },
    "min": { "colSpan": 3, "rowSpan": 4 },
    "max": { "colSpan": 8, "rowSpan": 10 }
  },
  "dataProvider": {
    "mcp": "surveymonkey",
    "tool": "list_surveys",
    "params": {}
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": ["header", "body"],
        "watch": {
          "/surveymonkey/list_surveys/records": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/recentSurveys",
                "value": {
                  "$computed": "top_n",
                  "args": {
                    "value": { "$state": "/surveymonkey/list_surveys/records" },
                    "field": "date_modified",
                    "n": 10
                  }
                }
              }
            }
          ]
        }
      },
      "header": {
        "type": "Header",
        "props": {},
        "children": ["titleGroup"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "start" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "ClipboardList", "tone": "accent", "size": "sm" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "subtitle"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Recent Surveys", "level": "h2" }
      },
      "subtitle": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{n} Surveys",
              "n": {
                "$computed": "count",
                "args": { "value": { "$state": "/ui/recentSurveys" } }
              }
            }
          }
        }
      },
      "body": {
        "type": "Body",
        "props": {},
        "children": ["loading", "empty", "surveyList"]
      },
      "loading": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["sk1", "sk2", "sk3", "sk4"],
        "visible": { "$state": "/_loading/surveymonkey.list_surveys" }
      },
      "sk1": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "sk2": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "sk3": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "sk4": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "empty": {
        "type": "Empty",
        "props": { "message": "No surveys found in SurveyMonkey." },
        "visible": {
          "$and": [
            { "$state": "/_loading/surveymonkey.list_surveys", "not": true },
            { "$state": "/surveymonkey/list_surveys/records/0", "not": true }
          ]
        }
      },
      "surveyList": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["surveyRow"],
        "repeat": {
          "statePath": "/ui/recentSurveys",
          "key": "id"
        },
        "visible": {
          "$and": [
            { "$state": "/_loading/surveymonkey.list_surveys", "not": true },
            { "$state": "/ui/recentSurveys/0" }
          ]
        }
      },
      "surveyRow": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center", "justify": "between", "hover": true },
        "children": ["surveyInfo", "surveyBadge"]
      },
      "surveyInfo": {
        "type": "Stack",
        "props": { "gap": "none", "grow": true },
        "children": ["surveyTitle", "surveyDate"]
      },
      "surveyTitle": {
        "type": "Text",
        "props": {
          "text": { "$item": "title" },
          "size": "sm",
          "weight": "semibold",
          "truncate": true
        }
      },
      "surveyDate": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "surveymonkey_format_date",
            "args": { "value": { "$item": "date_modified" } }
          },
          "tone": "muted"
        }
      },
      "surveyBadge": {
        "type": "Badge",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{n} responses",
              "n": { "$item": "response_count" }
            }
          },
          "tone": "accent",
          "variant": "soft"
        }
      }
    }
  },
  "status": "published"
}
