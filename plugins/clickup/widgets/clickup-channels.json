{
  "id": "clickup-channels",
  "title": "ClickUp Channels",
  "description": "Browse the Chat channels in a ClickUp Workspace — name, type, visibility and when each last had activity.",
  "category": "communication",
  "connectorsUsed": ["clickup"],
  "keywords": ["clickup", "chat", "channels", "workspace", "messages"],
  "tags": ["clickup", "chat", "channels", "project-management"],
  "popularity": 0,
  "sizing": {
    "min": { "colSpan": 4, "rowSpan": 5 },
    "preferred": { "colSpan": 5, "rowSpan": 8 },
    "max": { "colSpan": 8, "rowSpan": 12 }
  },
  "dataProvider": { "kind": "tool", "mcp": "clickup", "tool": "list_workspaces", "params": {} },
  "spec": {
    "root": "card",
    "elements": {
      "card": { "type": "Card", "props": {}, "children": ["header", "pickerRow", "errorBanner", "statusCaption", "channelList", "countCaption", "infoOverlay"] },

      "titleIcon": { "type": "Icon", "props": { "name": "Hash", "size": "sm", "tone": "accent" } },
      "title": { "type": "Heading", "props": { "level": "h2", "text": "ClickUp Channels" } },
      "eyebrow": { "type": "Eyebrow", "props": { "text": "Pick a workspace" } },
      "titleStack": { "type": "Stack", "props": { "gap": "none" }, "children": ["title", "eyebrow"] },
      "titleGroup": { "type": "Row", "props": { "align": "center", "gap": "sm" }, "children": ["titleIcon", "titleStack"] },
      "infoBtn": {
        "type": "IconButton",
        "props": { "icon": "Info", "size": "sm", "tone": "muted", "ariaLabel": "About this tile" },
        "on": { "click": { "action": "setState", "params": { "statePath": "/ui/showInfo", "value": true } } }
      },
      "header": { "type": "Row", "props": { "align": "center", "justify": "between", "gap": "sm" }, "children": ["titleGroup", "infoBtn"] },

      "teamSelect": {
        "type": "Select",
        "props": {
          "value": { "$bindState": "/ui/selectedTeam" },
          "options": {
            "$computed": "to_options",
            "args": { "value": { "$state": "/clickup/list_workspaces/teams" }, "valueField": "id", "labelField": "name" }
          },
          "placeholder": "Choose workspace…",
          "size": "sm"
        }
      },
      "pickerRow": {
        "type": "Row",
        "props": { "align": "center", "gap": "sm", "wrap": true },
        "children": ["teamSelect"],
        "watch": {
          "/ui/selectedTeam": [
            {
              "action": "clickup.list_channels",
              "params": { "team_id": { "$state": "/ui/selectedTeam" }, "limit": 100 }
            }
          ]
        }
      },

      "errorBanner": {
        "type": "Caption",
        "props": { "text": { "$template": "Couldn't load channels: ${/_errors/clickup.list_channels}" }, "tone": "destructive" },
        "visible": { "$state": "/_errors/clickup.list_channels" }
      },
      "statusCaption": {
        "type": "Caption",
        "props": {
          "text": {
            "$cond": { "$state": "/ui/selectedTeam" },
            "$then": {
              "$cond": { "$state": "/_loading/clickup.list_channels" },
              "$then": "Loading…",
              "$else": {
                "$cond": { "$state": "/clickup/list_channels/data/0" },
                "$then": "",
                "$else": "No channels in this workspace."
              }
            },
            "$else": "Pick a workspace above to see its channels."
          },
          "tone": "muted"
        },
        "visible": {
          "$cond": { "$state": "/ui/selectedTeam" },
          "$then": {
            "$cond": { "$state": "/_loading/clickup.list_channels" },
            "$then": true,
            "$else": { "$state": "/clickup/list_channels/data/0", "not": true }
          },
          "$else": true
        }
      },

      "channelIcon": { "type": "Icon", "props": { "name": "Hash", "size": "sm", "tone": "muted" } },
      "channelName": { "type": "Text", "props": { "size": "sm", "weight": "semibold", "text": { "$item": "name" } } },
      "channelNameRow": { "type": "Row", "props": { "align": "center", "gap": "xs" }, "children": ["channelIcon", "channelName"] },
      "channelTypeBadge": {
        "type": "Badge",
        "props": {
          "text": { "$computed": "clickup_channel_type_label", "args": { "value": { "$item": "type" } } },
          "tone": "muted"
        }
      },
      "channelTopRow": { "type": "Row", "props": { "align": "center", "justify": "between", "gap": "sm" }, "children": ["channelNameRow", "channelTypeBadge"] },
      "channelMeta": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{visibility} · Last activity {activity}",
              "visibility": { "$computed": "clickup_channel_visibility_label", "args": { "value": { "$item": "visibility" } } },
              "activity": { "$computed": "clickup_date", "args": { "value": { "$item": "latest_comment_at" } } }
            }
          },
          "tone": "muted"
        }
      },
      "channelTopic": {
        "type": "Caption",
        "props": { "text": { "$item": "topic" }, "tone": "muted" },
        "visible": { "$item": "topic" }
      },
      "channelCard": { "type": "Stack", "props": { "gap": "xs" }, "children": ["channelTopRow", "channelMeta", "channelTopic"] },
      "channelList": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["channelCard"],
        "repeat": { "key": "id", "statePath": "/clickup/list_channels/data" },
        "visible": { "$state": "/clickup/list_channels/data/0" }
      },

      "countCaption": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{n} channel{s}",
              "n": { "$computed": "count", "args": { "value": { "$state": "/clickup/list_channels/data" } } },
              "s": { "$cond": { "$computed": "count", "args": { "value": { "$state": "/clickup/list_channels/data" } } }, "eq": 1, "$then": "", "$else": "s" }
            }
          },
          "tone": "muted"
        },
        "visible": { "$state": "/clickup/list_channels/data/0" }
      },

      "infoOverlay": {
        "type": "Overlay",
        "props": { "maxWidth": "28rem" },
        "children": ["infoCard"],
        "visible": { "$state": "/ui/showInfo" },
        "on": { "backdropClick": { "action": "setState", "params": { "statePath": "/ui/showInfo", "value": false } } }
      },
      "infoCloseBtn": {
        "type": "IconButton",
        "props": { "icon": "X", "size": "sm", "tone": "muted", "ariaLabel": "Close", "floating": true },
        "on": { "click": { "action": "setState", "params": { "statePath": "/ui/showInfo", "value": false } } }
      },
      "infoTitleIcon": { "type": "Icon", "props": { "name": "Info", "size": "sm", "tone": "info" } },
      "infoTitleText": { "type": "Heading", "props": { "text": "About ClickUp Channels", "level": "h2" } },
      "infoTitleRow": { "type": "Row", "props": { "align": "center", "gap": "sm" }, "children": ["infoTitleIcon", "infoTitleText"] },
      "infoDivider": { "type": "Divider", "props": {} },
      "infoWhatLabel": { "type": "Caption", "props": { "text": "What this is", "tone": "muted", "weight": "semibold" } },
      "infoWhatText": {
        "type": "Text",
        "props": {
          "text": "Lists the ClickUp Chat channels in a Workspace you pick — name, type (Channel, Direct message or Group DM), visibility (Public or Private), topic, and when each one last had a message.",
          "size": "sm"
        }
      },
      "infoHowLabel": { "type": "Caption", "props": { "text": "Using it", "tone": "muted", "weight": "semibold" } },
      "infoHowText": {
        "type": "Text",
        "props": {
          "text": "This tile is read-only and shows channels only — it doesn't read or post messages, and channel rows aren't clickable yet (ClickUp Chat doesn't document a direct web link for a channel the way it does for a task).",
          "size": "sm"
        }
      },
      "infoBody": { "type": "Stack", "props": { "gap": "md" }, "children": ["infoWhatLabel", "infoWhatText", "infoHowLabel", "infoHowText"] },
      "infoCard": { "type": "Card", "props": {}, "children": ["infoCloseBtn", "infoTitleRow", "infoDivider", "infoBody"] }
    }
  }
}
