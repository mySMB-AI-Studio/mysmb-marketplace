{
  "id": "clickup-goals",
  "title": "ClickUp Goals",
  "description": "Goals in a ClickUp Workspace, with progress and how many key results each one has.",
  "category": "tasks",
  "connectorsUsed": ["clickup"],
  "keywords": ["clickup", "goals", "okr", "targets", "progress"],
  "tags": ["clickup", "project-management", "goals"],
  "popularity": 0,
  "sizing": {
    "min": { "colSpan": 4, "rowSpan": 6 },
    "preferred": { "colSpan": 5, "rowSpan": 9 },
    "max": { "colSpan": 8, "rowSpan": 14 }
  },
  "dataProvider": { "kind": "tool", "mcp": "clickup", "tool": "list_workspaces", "params": {} },
  "spec": {
    "root": "card",
    "elements": {
      "card": { "type": "Card", "props": {}, "children": ["header", "pickerRow", "errorBanner", "statusCaption", "goalList", "infoOverlay"] },

      "titleIcon": { "type": "Icon", "props": { "name": "Target", "size": "sm", "tone": "accent" } },
      "title": { "type": "Heading", "props": { "level": "h2", "text": "Goals" } },
      "eyebrow": { "type": "Eyebrow", "props": { "text": "Pick a workspace" } },
      "titleStack": { "type": "Stack", "props": { "gap": "none" }, "children": ["title", "eyebrow"] },
      "titleGroup": { "type": "Row", "props": { "align": "center", "gap": "sm" }, "children": ["titleIcon", "titleStack"] },
      "infoBtn": {
        "type": "IconButton",
        "props": { "icon": "Info", "size": "sm", "tone": "muted", "ariaLabel": "About this tile" },
        "on": { "click": { "action": "setState", "params": { "statePath": "/ui/showInfo", "value": true } } }
      },
      "header": { "type": "Row", "props": { "align": "center", "justify": "between", "gap": "sm" }, "children": ["titleGroup", "infoBtn"] },

      "infoOverlay": {
        "type": "Overlay",
        "props": { "maxWidth": "28rem" },
        "children": ["infoCard"],
        "visible": { "$state": "/ui/showInfo" },
        "on": { "backdropClick": { "action": "setState", "params": { "statePath": "/ui/showInfo", "value": false } } }
      },
      "infoCloseBtn": {
        "type": "IconButton",
        "props": { "icon": "X", "size": "sm", "tone": "muted", "ariaLabel": "Close", "floating": true },
        "on": { "click": { "action": "setState", "params": { "statePath": "/ui/showInfo", "value": false } } }
      },
      "infoTitleIcon": { "type": "Icon", "props": { "name": "Info", "size": "sm", "tone": "info" } },
      "infoTitleText": { "type": "Heading", "props": { "text": "About Goals", "level": "h2" } },
      "infoTitleRow": { "type": "Row", "props": { "align": "center", "gap": "sm" }, "children": ["infoTitleIcon", "infoTitleText"] },
      "infoDivider": { "type": "Divider", "props": {} },
      "infoWhatLabel": { "type": "Caption", "props": { "text": "What this is", "tone": "muted", "weight": "semibold" } },
      "infoWhatText": {
        "type": "Text",
        "props": {
          "text": "Every Goal set up in a ClickUp Workspace — its due date, how far along it is, and how many key results it's tracking.",
          "size": "sm"
        }
      },
      "infoHowLabel": { "type": "Caption", "props": { "text": "Using it", "tone": "muted", "weight": "semibold" } },
      "infoHowText": {
        "type": "Text",
        "props": {
          "text": "Pick a workspace, then switch between active and completed Goals. This tile is read-only — it doesn't create or edit Goals.",
          "size": "sm"
        }
      },
      "infoBody": { "type": "Stack", "props": { "gap": "md" }, "children": ["infoWhatLabel", "infoWhatText", "infoHowLabel", "infoHowText"] },
      "infoCard": { "type": "Card", "props": {}, "children": ["infoCloseBtn", "infoTitleRow", "infoDivider", "infoBody"] },

      "teamSelect": {
        "type": "Select",
        "props": {
          "value": { "$bindState": "/ui/selectedTeam" },
          "options": { "$computed": "to_options", "args": { "value": { "$state": "/clickup/list_workspaces/teams" }, "valueField": "id", "labelField": "name" } },
          "placeholder": "Choose workspace…",
          "size": "sm"
        },
        "watch": {
          "/ui/selectedTeam": [
            { "action": "setState", "params": { "statePath": "/ui/showCompleted", "value": false } }
          ]
        }
      },
      "activeBtn": {
        "type": "Button",
        "props": { "label": "Active", "size": "sm", "variant": { "$computed": "clickup_tab_variant", "args": { "active": { "$state": "/ui/showCompleted" }, "match": "false" } } },
        "visible": { "$state": "/ui/selectedTeam" },
        "on": {
          "click": [
            { "action": "setState", "params": { "statePath": "/ui/showCompleted", "value": false } },
            { "action": "clickup.list_goals", "params": { "team_id": { "$state": "/ui/selectedTeam" }, "include_completed": false } }
          ]
        }
      },
      "completedBtn": {
        "type": "Button",
        "props": { "label": "Include completed", "size": "sm", "variant": { "$computed": "clickup_tab_variant", "args": { "active": { "$state": "/ui/showCompleted" }, "match": "true" } } },
        "visible": { "$state": "/ui/selectedTeam" },
        "on": {
          "click": [
            { "action": "setState", "params": { "statePath": "/ui/showCompleted", "value": true } },
            { "action": "clickup.list_goals", "params": { "team_id": { "$state": "/ui/selectedTeam" }, "include_completed": true } }
          ]
        }
      },
      "pickerRow": { "type": "Row", "props": { "align": "center", "gap": "sm", "wrap": true }, "children": ["teamSelect", "activeBtn", "completedBtn"] },

      "errorBanner": {
        "type": "Caption",
        "props": { "text": { "$template": "Couldn't load goals: ${/_errors/clickup.list_goals}" }, "tone": "destructive" },
        "visible": { "$state": "/_errors/clickup.list_goals" }
      },
      "statusCaption": {
        "type": "Caption",
        "props": {
          "text": {
            "$cond": { "$state": "/ui/selectedTeam" },
            "$then": {
              "$cond": { "$state": "/_loading/clickup.list_goals" },
              "$then": "Loading…",
              "$else": { "$cond": { "$state": "/clickup/list_goals/goals/0" }, "$then": "", "$else": "No Goals found." }
            },
            "$else": "Pick a workspace above to see Goals."
          },
          "tone": "muted"
        },
        "watch": {
          "/ui/selectedTeam": [
            {
              "action": "clickup.list_goals",
              "params": { "team_id": { "$state": "/ui/selectedTeam" }, "include_completed": false }
            }
          ]
        }
      },

      "goalName": { "type": "Text", "props": { "text": { "$item": "name" }, "size": "sm", "weight": "medium", "truncate": true } },
      "goalDue": { "type": "Caption", "props": { "text": { "$computed": "clickup_date", "args": { "value": { "$item": "due_date" } } }, "tone": "muted" } },
      "goalTopRow": { "type": "Row", "props": { "align": "center", "justify": "between", "gap": "sm" }, "children": ["goalName", "goalDue"] },
      "goalProgressBar": {
        "type": "ProgressBar",
        "props": { "value": { "$item": "percent_completed" }, "tone": { "$computed": "clickup_goal_progress_tone", "args": { "value": { "$item": "percent_completed" } } } }
      },
      "goalPercentLabel": {
        "type": "Caption",
        "props": {
          "text": { "$computed": "clickup_goal_percent_label", "args": { "value": { "$item": "percent_completed" } } },
          "tone": { "$computed": "clickup_goal_progress_tone", "args": { "value": { "$item": "percent_completed" } } }
        }
      },
      "goalProgressRow": { "type": "Row", "props": { "align": "center", "gap": "sm" }, "children": ["goalProgressBar", "goalPercentLabel"] },
      "goalKeyResults": {
        "type": "Caption",
        "props": { "text": { "$computed": "fmt", "args": { "pattern": "{count} key results", "count": { "$item": "key_result_count" } } }, "tone": "muted" }
      },
      "goalContent": { "type": "Stack", "props": { "gap": "xs" }, "children": ["goalTopRow", "goalProgressRow", "goalKeyResults"] },
      "goalRow": { "type": "Row", "props": {}, "children": ["goalContent"] },
      "goalList": {
        "type": "Stack",
        "props": { "gap": "md" },
        "children": ["goalRow"],
        "repeat": { "key": "id", "statePath": "/clickup/list_goals/goals" },
        "visible": { "$state": "/_loading/clickup.list_goals", "not": true }
      }
    }
  }
}
