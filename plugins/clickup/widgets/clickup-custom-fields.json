{
  "id": "clickup-custom-fields",
  "title": "ClickUp Custom Fields",
  "description": "The Custom Field definitions set up on a ClickUp List, with each field's type.",
  "category": "tasks",
  "connectorsUsed": ["clickup"],
  "keywords": ["clickup", "custom fields", "fields", "metadata"],
  "tags": ["clickup", "project-management", "custom-fields"],
  "popularity": 0,
  "sizing": {
    "min": { "colSpan": 4, "rowSpan": 5 },
    "preferred": { "colSpan": 5, "rowSpan": 8 },
    "max": { "colSpan": 8, "rowSpan": 12 }
  },
  "dataProvider": { "kind": "tool", "mcp": "clickup", "tool": "list_workspaces", "params": {} },
  "spec": {
    "root": "card",
    "elements": {
      "card": { "type": "Card", "props": {}, "children": ["header", "pickerRow", "errorBanner", "statusCaption", "fieldList", "infoOverlay"] },

      "titleIcon": { "type": "Icon", "props": { "name": "ListChecks", "size": "sm", "tone": "accent" } },
      "title": { "type": "Heading", "props": { "level": "h2", "text": "Custom Fields" } },
      "eyebrow": { "type": "Eyebrow", "props": { "text": "Pick a workspace" } },
      "titleStack": { "type": "Stack", "props": { "gap": "none" }, "children": ["title", "eyebrow"] },
      "titleGroup": { "type": "Row", "props": { "align": "center", "gap": "sm" }, "children": ["titleIcon", "titleStack"] },
      "infoBtn": {
        "type": "IconButton",
        "props": { "icon": "Info", "size": "sm", "tone": "muted", "ariaLabel": "About this tile" },
        "on": { "click": { "action": "setState", "params": { "statePath": "/ui/showInfo", "value": true } } }
      },
      "header": { "type": "Row", "props": { "align": "center", "justify": "between", "gap": "sm" }, "children": ["titleGroup", "infoBtn"] },

      "infoOverlay": {
        "type": "Overlay",
        "props": { "maxWidth": "28rem" },
        "children": ["infoCard"],
        "visible": { "$state": "/ui/showInfo" },
        "on": { "backdropClick": { "action": "setState", "params": { "statePath": "/ui/showInfo", "value": false } } }
      },
      "infoCloseBtn": {
        "type": "IconButton",
        "props": { "icon": "X", "size": "sm", "tone": "muted", "ariaLabel": "Close", "floating": true },
        "on": { "click": { "action": "setState", "params": { "statePath": "/ui/showInfo", "value": false } } }
      },
      "infoTitleIcon": { "type": "Icon", "props": { "name": "Info", "size": "sm", "tone": "info" } },
      "infoTitleText": { "type": "Heading", "props": { "text": "About Custom Fields", "level": "h2" } },
      "infoTitleRow": { "type": "Row", "props": { "align": "center", "gap": "sm" }, "children": ["infoTitleIcon", "infoTitleText"] },
      "infoDivider": { "type": "Divider", "props": {} },
      "infoWhatLabel": { "type": "Caption", "props": { "text": "What this is", "tone": "muted", "weight": "semibold" } },
      "infoWhatText": {
        "type": "Text",
        "props": { "text": "The Custom Field definitions set up on a ClickUp List — each field's name, type, and whether it's required.", "size": "sm" }
      },
      "infoHowLabel": { "type": "Caption", "props": { "text": "Using it", "tone": "muted", "weight": "semibold" } },
      "infoHowText": {
        "type": "Text",
        "props": { "text": "Pick a workspace, space, and list. This tile is read-only — it doesn't create fields or set their values on tasks.", "size": "sm" }
      },
      "infoBody": { "type": "Stack", "props": { "gap": "md" }, "children": ["infoWhatLabel", "infoWhatText", "infoHowLabel", "infoHowText"] },
      "infoCard": { "type": "Card", "props": {}, "children": ["infoCloseBtn", "infoTitleRow", "infoDivider", "infoBody"] },

      "teamSelect": {
        "type": "Select",
        "props": {
          "value": { "$bindState": "/ui/selectedTeam" },
          "options": { "$computed": "to_options", "args": { "value": { "$state": "/clickup/list_workspaces/teams" }, "valueField": "id", "labelField": "name" } },
          "placeholder": "Choose workspace…",
          "size": "sm"
        }
      },
      "spaceSelect": {
        "type": "Select",
        "props": {
          "value": { "$bindState": "/ui/selectedSpace" },
          "options": { "$computed": "to_options", "args": { "value": { "$state": "/clickup/list_spaces/spaces" }, "valueField": "id", "labelField": "name" } },
          "placeholder": "Choose space…",
          "size": "sm"
        },
        "visible": { "$state": "/ui/selectedTeam" }
      },
      "listSelect": {
        "type": "Select",
        "props": {
          "value": { "$bindState": "/ui/selectedList" },
          "options": { "$computed": "to_options", "args": { "value": { "$state": "/clickup/list_folderless_lists/lists" }, "valueField": "id", "labelField": "name" } },
          "placeholder": "Choose list…",
          "size": "sm"
        },
        "visible": { "$state": "/ui/selectedSpace" }
      },
      "pickerRow": {
        "type": "Row",
        "props": { "align": "center", "gap": "sm", "wrap": true },
        "children": ["teamSelect", "spaceSelect", "listSelect"],
        "watch": {
          "/ui/selectedTeam": [
            { "action": "setState", "params": { "statePath": "/ui/selectedSpace", "value": null } },
            { "action": "setState", "params": { "statePath": "/ui/selectedList", "value": null } },
            { "action": "clickup.list_spaces", "params": { "team_id": { "$state": "/ui/selectedTeam" } } }
          ],
          "/ui/selectedSpace": [
            { "action": "setState", "params": { "statePath": "/ui/selectedList", "value": null } },
            { "action": "clickup.list_folderless_lists", "params": { "space_id": { "$state": "/ui/selectedSpace" } } }
          ],
          "/ui/selectedList": [
            { "action": "clickup.list_custom_fields", "params": { "list_id": { "$state": "/ui/selectedList" } } }
          ]
        }
      },

      "errorBanner": {
        "type": "Caption",
        "props": { "text": { "$template": "Couldn't load custom fields: ${/_errors/clickup.list_custom_fields}" }, "tone": "destructive" },
        "visible": { "$state": "/_errors/clickup.list_custom_fields" }
      },
      "statusCaption": {
        "type": "Caption",
        "props": {
          "text": {
            "$cond": { "$state": "/ui/selectedList" },
            "$then": {
              "$cond": { "$state": "/_loading/clickup.list_custom_fields" },
              "$then": "Loading…",
              "$else": { "$cond": { "$state": "/clickup/list_custom_fields/fields/0" }, "$then": "", "$else": "No Custom Fields set up on this List." }
            },
            "$else": "Pick a workspace, space and list above to see its Custom Fields."
          },
          "tone": "muted"
        }
      },

      "fieldName": { "type": "Text", "props": { "text": { "$item": "name" }, "size": "sm", "weight": "medium", "truncate": true } },
      "fieldTypeBadge": {
        "type": "Badge",
        "props": { "text": { "$item": "type" }, "tone": { "$computed": "clickup_custom_field_type_tone", "args": { "value": { "$item": "type" } } } }
      },
      "fieldTopRow": { "type": "Row", "props": { "align": "center", "justify": "between", "gap": "sm" }, "children": ["fieldName", "fieldTypeBadge"] },
      "fieldRequiredCaption": {
        "type": "Caption",
        "props": { "text": "Required", "tone": "muted" },
        "visible": { "$item": "required" }
      },
      "fieldContent": { "type": "Stack", "props": { "gap": "xs" }, "children": ["fieldTopRow", "fieldRequiredCaption"] },
      "fieldRow": { "type": "Row", "props": {}, "children": ["fieldContent"] },
      "fieldList": {
        "type": "Stack",
        "props": { "gap": "md" },
        "children": ["fieldRow"],
        "repeat": { "key": "id", "statePath": "/clickup/list_custom_fields/fields" },
        "visible": { "$state": "/_loading/clickup.list_custom_fields", "not": true }
      }
    }
  }
}
