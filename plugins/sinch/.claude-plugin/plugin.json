{
  "name": "sinch",
  "version": "0.1.0",
  "description": "Sinch Engage plugin — send SMS, generate reports, manage contacts",
  "author": {
    "name": "mySMB AI Studio"
  },
  "homepage": "https://github.com/mySMB-AI-Studio/mysmb-marketplace",
  "license": "MIT",
  "keywords": [
    "sinch",
    "sms",
    "messaging",
    "contacts",
    "reports",
    "communications",
    "smb"
  ],
  "connection": {
    "authType": "api_key",
    "instructions": "In your Sinch Engage account, go to Settings → API Settings to find your API key and secret. Select the region that matches your account (EU or AU).",
    "docUrl": "https://developers.messagemedia.com/",
    "fields": [
      {
        "name": "SINCH_ENGAGE_API_KEY",
        "label": "API Key",
        "secret": true
      },
      {
        "name": "SINCH_ENGAGE_API_SECRET",
        "label": "API Secret",
        "secret": true
      },
      {
        "name": "SINCH_ENGAGE_REGION",
        "label": "Region — EU or AU (default: AU)",
        "secret": false
      }
    ]
  },
  "tools": [
    "sendMessage",
    "getDetailedMessageReport",
    "getSummaryMessageReport",
    "getSummaryInsightMessageReport",
    "getAsyncReportStatus",
    "getAsyncReportFields",
    "requestAsyncDetailedMessageReport",
    "getContactGroups",
    "getContactGroupDetails",
    "getContactWithSearch",
    "createContactGroup",
    "createContact",
    "updateContact",
    "deleteContactGroup"
  ],
  "displayName": "Sinch Engage",
  "icon": "data:image/png;base64,"
}
