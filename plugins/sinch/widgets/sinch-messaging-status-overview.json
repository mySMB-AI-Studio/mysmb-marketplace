{
  "id": "sinch-messaging-status-overview",
  "title": "Messaging Status Overview",
  "description": "Total outbound message count and delivery breakdown for the last 24 hours — delivered, pending, failed, and rejected — shown as colour-coded progress bars.",
  "category": "messaging",
  "tags": ["sinch", "sms", "whatsapp", "messaging", "delivery", "overview", "status", "kpi"],
  "keywords": ["sinch", "sms", "whatsapp", "messaging status", "delivery rate", "failed messages", "pending", "rejected", "kpi", "overview"],
  "connectorsUsed": ["sinch"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 5, "rowSpan": 5 },
    "min":       { "colSpan": 4, "rowSpan": 4 },
    "max":       { "colSpan": 10, "rowSpan": 10 }
  },
  "dataProvider": {
    "mcp": "sinch",
    "tool": "get_sinch_delivery_stats",
    "params": {
      "period": "last_24h"
    }
  },
  "spec": {
    "root": "card",
    "elements": {

      "card": {
        "type": "Card",
        "props": {},
        "children": ["header", "body"],
        "watch": {
          "/sinch/get_sinch_delivery_stats/total": {
            "action": "setState",
            "params": {
              "statePath": "/ui/sinchMessageStats",
              "value": {
                "$computed": "sinch_message_stats",
                "args": { "value": { "$state": "/sinch/get_sinch_delivery_stats" } }
              }
            }
          }
        }
      },

      "header": {
        "type": "Header",
        "props": {},
        "children": ["titleGroup"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "MessageSquare", "tone": "accent", "size": "sm" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "eyebrow"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Messaging Status Overview", "level": "h2" }
      },
      "eyebrow": {
        "type": "Eyebrow",
        "props": { "text": "SMS + WhatsApp · Last 24 Hours" }
      },

      "body": {
        "type": "Body",
        "props": {},
        "children": ["loading", "empty", "content"]
      },

      "loading": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["sk1", "sk2", "sk3", "sk4", "sk5"],
        "visible": { "$state": "/_loading/sinch.get_sinch_delivery_stats" }
      },
      "sk1": { "type": "Skeleton", "props": { "height": "2.75rem", "rounded": "md" } },
      "sk2": { "type": "Skeleton", "props": { "height": "1.5rem", "rounded": "md" } },
      "sk3": { "type": "Skeleton", "props": { "height": "1.5rem", "rounded": "md" } },
      "sk4": { "type": "Skeleton", "props": { "height": "1.5rem", "rounded": "md" } },
      "sk5": { "type": "Skeleton", "props": { "height": "1.5rem", "rounded": "md" } },

      "empty": {
        "type": "Empty",
        "props": { "message": "No messaging data available for the last 24 hours." },
        "visible": {
          "$and": [
            { "$state": "/_loading/sinch.get_sinch_delivery_stats", "not": true },
            { "$state": "/sinch/get_sinch_delivery_stats/total", "not": true }
          ]
        }
      },

      "content": {
        "type": "Stack",
        "props": { "gap": "md" },
        "children": ["statBlock", "divider", "bars"],
        "visible": {
          "$and": [
            { "$state": "/_loading/sinch.get_sinch_delivery_stats", "not": true },
            { "$state": "/sinch/get_sinch_delivery_stats/total" }
          ]
        }
      },

      "statBlock": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["statVal", "statLbl"]
      },
      "statVal": {
        "type": "Stat",
        "props": { "value": { "$state": "/ui/sinchMessageStats/total" } }
      },
      "statLbl": {
        "type": "Caption",
        "props": { "text": "Total Messages" }
      },

      "divider": { "type": "Divider", "props": {} },

      "bars": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["rowDelivered", "rowPending", "rowFailed", "rowRejected"]
      },

      "rowDelivered": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["lblDelivered", "barDelivered", "cntDelivered"]
      },
      "lblDelivered": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["dotDelivered", "txtDelivered"]
      },
      "dotDelivered": { "type": "Dot", "props": { "size": "sm", "tone": "success" } },
      "txtDelivered":  { "type": "Text", "props": { "text": "Delivered", "size": "xs" } },
      "barDelivered": {
        "type": "ProgressBar",
        "props": {
          "value": { "$state": "/ui/sinchMessageStats/deliveredPct" },
          "tone": "success"
        }
      },
      "cntDelivered": {
        "type": "Text",
        "props": {
          "text": { "$state": "/ui/sinchMessageStats/deliveredCountPct" },
          "size": "xs",
          "tone": "muted"
        }
      },

      "rowPending": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["lblPending", "barPending", "cntPending"]
      },
      "lblPending": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["dotPending", "txtPending"]
      },
      "dotPending": { "type": "Dot", "props": { "size": "sm", "tone": "info" } },
      "txtPending":  { "type": "Text", "props": { "text": "Pending", "size": "xs" } },
      "barPending": {
        "type": "ProgressBar",
        "props": {
          "value": { "$state": "/ui/sinchMessageStats/pendingPct" },
          "tone": "info"
        }
      },
      "cntPending": {
        "type": "Text",
        "props": {
          "text": { "$state": "/ui/sinchMessageStats/pendingCountPct" },
          "size": "xs",
          "tone": "muted"
        }
      },

      "rowFailed": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["lblFailed", "barFailed", "cntFailed"]
      },
      "lblFailed": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["dotFailed", "txtFailed"]
      },
      "dotFailed": { "type": "Dot", "props": { "size": "sm", "tone": "destructive" } },
      "txtFailed":  { "type": "Text", "props": { "text": "Failed", "size": "xs" } },
      "barFailed": {
        "type": "ProgressBar",
        "props": {
          "value": { "$state": "/ui/sinchMessageStats/failedPct" },
          "tone": "destructive"
        }
      },
      "cntFailed": {
        "type": "Text",
        "props": {
          "text": { "$state": "/ui/sinchMessageStats/failedCountPct" },
          "size": "xs",
          "tone": "muted"
        }
      },

      "rowRejected": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["lblRejected", "barRejected", "cntRejected"]
      },
      "lblRejected": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["dotRejected", "txtRejected"]
      },
      "dotRejected": { "type": "Dot", "props": { "size": "sm", "tone": "warning" } },
      "txtRejected":  { "type": "Text", "props": { "text": "Rejected", "size": "xs" } },
      "barRejected": {
        "type": "ProgressBar",
        "props": {
          "value": { "$state": "/ui/sinchMessageStats/rejectedPct" },
          "tone": "warning"
        }
      },
      "cntRejected": {
        "type": "Text",
        "props": {
          "text": { "$state": "/ui/sinchMessageStats/rejectedCountPct" },
          "size": "xs",
          "tone": "muted"
        }
      }

    }
  },
  "status": "published"
}
