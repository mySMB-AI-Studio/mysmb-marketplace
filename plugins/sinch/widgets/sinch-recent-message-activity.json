{
  "id": "sinch-recent-message-activity",
  "title": "Recent Message Activity",
  "description": "Live feed of the latest Sinch message events — delivery status, channel, content preview, and masked identity for each inbound or outbound message.",
  "category": "messaging",
  "tags": ["sinch", "sms", "messaging", "activity", "delivery", "events", "feed"],
  "keywords": ["sinch", "message", "activity", "delivered", "sent", "failed", "inbound", "outbound", "sms", "whatsapp", "channel", "recent", "events", "feed"],
  "connectorsUsed": ["sinch"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 5, "rowSpan": 7 },
    "min":       { "colSpan": 4, "rowSpan": 5 },
    "max":       { "colSpan": 10, "rowSpan": 14 }
  },
  "dataProvider": {
    "mcp": "sinch",
    "tool": "list_sinch_message_events",
    "params": { "page_size": 20 }
  },
  "spec": {
    "root": "card",
    "elements": {

      "card": {
        "type": "Card",
        "props": {},
        "children": ["header", "body"],
        "watch": {
          "/sinch/list_sinch_message_events/events": {
            "action": "setState",
            "params": {
              "statePath": "/ui/sinchActivityEvents",
              "value": {
                "$computed": "sinch_activity_events",
                "args": { "value": { "$state": "/sinch/list_sinch_message_events/events" } }
              }
            }
          }
        }
      },

      "header": {
        "type": "Header",
        "props": {},
        "children": ["titleGroup"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "Activity", "tone": "accent", "size": "sm" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "eyebrow"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Recent Message Activity", "level": "h2" }
      },
      "eyebrow": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "Sinch · {n} events · latest 20",
              "n": {
                "$computed": "count",
                "args": { "value": { "$state": "/sinch/list_sinch_message_events/events" } }
              }
            }
          }
        }
      },

      "body": {
        "type": "Body",
        "props": {},
        "children": ["loading", "empty", "content"]
      },

      "loading": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["sk1", "sk2", "sk3", "sk4", "sk5"],
        "visible": { "$state": "/_loading/sinch.list_sinch_message_events" }
      },
      "sk1": { "type": "Skeleton", "props": { "height": "3rem", "rounded": "md" } },
      "sk2": { "type": "Skeleton", "props": { "height": "3rem", "rounded": "md" } },
      "sk3": { "type": "Skeleton", "props": { "height": "3rem", "rounded": "md" } },
      "sk4": { "type": "Skeleton", "props": { "height": "3rem", "rounded": "md" } },
      "sk5": { "type": "Skeleton", "props": { "height": "3rem", "rounded": "md" } },

      "empty": {
        "type": "Empty",
        "props": { "message": "No message events found." },
        "visible": {
          "$and": [
            { "$state": "/_loading/sinch.list_sinch_message_events", "not": true },
            { "$state": "/ui/sinchActivityEvents/0", "not": true }
          ]
        }
      },

      "content": {
        "type": "Stack",
        "props": { "gap": "none" },
        "visible": {
          "$and": [
            { "$state": "/_loading/sinch.list_sinch_message_events", "not": true },
            { "$state": "/ui/sinchActivityEvents/0" }
          ]
        },
        "children": ["eventList"]
      },

      "eventList": {
        "type": "Stack",
        "props": { "gap": "none" },
        "repeat": { "statePath": "/ui/sinchActivityEvents", "key": "id" },
        "children": ["eventRow"]
      },

      "eventRow": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["eventContent", "rowDivider"]
      },

      "eventContent": {
        "type": "Row",
        "props": { "gap": "sm", "align": "start" },
        "children": ["eventDot", "eventInfo"]
      },

      "eventDot": {
        "type": "Dot",
        "props": { "size": "sm", "tone": { "$item": "tone" } }
      },

      "eventInfo": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["eventMainLine", "eventMeta", "eventTime"]
      },

      "eventMainLine": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["eventStatusText", "eventDash", "eventChannel"]
      },

      "eventStatusText": {
        "type": "Text",
        "props": { "text": { "$item": "label" }, "size": "sm", "weight": "semibold" }
      },

      "eventDash": {
        "type": "Text",
        "props": { "text": "—", "size": "sm", "tone": "muted" }
      },

      "eventChannel": {
        "type": "Text",
        "props": { "text": { "$item": "channel" }, "size": "sm", "tone": "muted" }
      },

      "eventMeta": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{preview} · {identity}",
              "preview":  { "$item": "preview" },
              "identity": { "$item": "identity" }
            }
          },
          "tone": "muted",
          "truncate": true
        }
      },

      "eventTime": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "relative_time",
            "args": { "value": { "$item": "rawTimestamp" } }
          },
          "tone": "muted"
        }
      },

      "rowDivider": { "type": "Divider", "props": {} }

    }
  },
  "status": "published"
}
