{
  "id": "github-iteration-gantt",
  "title": "Release Board",
  "description": "Kanban of GitHub Project v2 features grouped by the week each iteration ships. Cards are dotted by status; click a card for an AI-summarized detail. Features with no iteration land in a \"No date yet\" column.",
  "category": "engineering",
  "tags": [
    "github",
    "roadmap",
    "release",
    "board",
    "kanban",
    "iteration",
    "sprint",
    "planning",
    "engineering"
  ],
  "keywords": [
    "release",
    "board",
    "kanban",
    "iteration",
    "sprint",
    "roadmap",
    "planning",
    "features",
    "github"
  ],
  "connectorsUsed": [
    "github"
  ],
  "popularity": 0,
  "sizing": {
    "preferred": {
      "colSpan": 12,
      "rowSpan": 8
    },
    "min": {
      "colSpan": 6,
      "rowSpan": 5
    },
    "max": {
      "colSpan": 12,
      "rowSpan": 12
    }
  },
  "dataProvider": {
    "mcp": "github",
    "tool": "projects_list",
    "params": {
      "method": "list_project_items",
      "owner": "mySMB-AI-Studio",
      "owner_type": "org",
      "project_number": 3,
      "fields": [
        "295149566",
        "295177536"
      ],
      "query": "-status:Done",
      "per_page": 50
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "children": [
          "header",
          "body"
        ],
        "watch": {
          "/github/projects_list": {
            "action": "setState",
            "params": {
              "statePath": "/ui/board",
              "value": {
                "$computed": "github_board_data",
                "args": {
                  "value": {
                    "$state": "/github/projects_list"
                  }
                }
              }
            }
          }
        }
      },
      "header": {
        "type": "Header",
        "children": [
          "headerRow"
        ]
      },
      "headerRow": {
        "type": "Row",
        "props": {
          "align": "center"
        },
        "children": [
          "titleGroup"
        ]
      },
      "titleGroup": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "start"
        },
        "children": [
          "titleIcon",
          "titleStack"
        ]
      },
      "titleIcon": {
        "type": "Icon",
        "props": {
          "name": "LayoutGrid",
          "tone": "accent",
          "size": "sm"
        }
      },
      "titleStack": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "children": [
          "title",
          "subtitle"
        ]
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "Release Board",
          "level": "h2"
        }
      },
      "subtitle": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{n} features · {i} release weeks",
              "n": {
                "$state": "/ui/board/total"
              },
              "i": {
                "$computed": "count",
                "args": {
                  "value": {
                    "$state": "/ui/board/columns"
                  }
                }
              }
            }
          }
        }
      },
      "body": {
        "type": "Body",
        "children": [
          "loading",
          "empty",
          "boardScroll"
        ]
      },
      "loading": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "visible": {
          "$state": "/_loading/github.projects_list"
        },
        "children": [
          "sk1",
          "sk2",
          "sk3"
        ]
      },
      "sk1": {
        "type": "Skeleton",
        "props": {
          "height": "3.25rem",
          "rounded": "md"
        }
      },
      "sk2": {
        "type": "Skeleton",
        "props": {
          "height": "3.25rem",
          "rounded": "md"
        }
      },
      "sk3": {
        "type": "Skeleton",
        "props": {
          "height": "3.25rem",
          "rounded": "md"
        }
      },
      "empty": {
        "type": "Empty",
        "props": {
          "message": "No features found on this project."
        },
        "visible": {
          "$and": [
            {
              "$state": "/_loading/github.projects_list",
              "not": true
            },
            {
              "$state": "/ui/board/columns/0",
              "not": true
            }
          ]
        }
      },
      "boardScroll": {
        "type": "Stack",
        "props": {
          "gap": "md"
        },
        "visible": {
