{
  "mcpServers": {
    "netsuite": {
      "type": "http",
      "url": "https://myhub-mcp-servers.thankfulcliff-9090ceed.westus2.azurecontainerapps.io/netsuite-records/mcp",
      "headers": {
        "X-Netsuite-Account-Id":      "${NETSUITE_ACCOUNT_ID}",
        "X-Netsuite-Consumer-Key":    "${NETSUITE_CONSUMER_KEY}",
        "X-Netsuite-Consumer-Secret": "${NETSUITE_CONSUMER_SECRET}",
        "X-Netsuite-Token-Id":        "${NETSUITE_TOKEN_ID}",
        "X-Netsuite-Token-Secret":    "${NETSUITE_TOKEN_SECRET}"
      }
    }
  }
}
