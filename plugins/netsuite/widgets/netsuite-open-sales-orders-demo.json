{
  "id": "netsuite-open-sales-orders-demo",
  "title": "Open Sales Orders",
  "description": "Live view of open sales orders — pending approval, pending fulfillment, and partially fulfilled. Demo version with static data.",
  "category": "finance",
  "tags": ["netsuite", "oracle", "erp", "finance", "sales-orders", "orders", "fulfillment", "demo"],
  "keywords": ["sales orders", "open orders", "fulfillment", "pending", "netsuite", "erp"],
  "connectorsUsed": ["netsuite"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 7, "rowSpan": 9 },
    "min":       { "colSpan": 5, "rowSpan": 8 },
    "max":       { "colSpan": 12, "rowSpan": 14 }
  },
  "spec": {
    "root": "card",
    "elements": {

      "card": {
        "type": "Card",
        "props": {},
        "children": ["headerRow", "div0", "kpiGrid", "div1", "tableHeaderRow", "orderList"]
      },

      "headerRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["titleGroup"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": { "type": "Icon", "props": { "name": "ShoppingCart", "tone": "accent", "size": "sm" } },
      "titleStack": { "type": "Stack", "props": { "gap": "none" }, "children": ["title", "eyebrow"] },
      "title": { "type": "Heading", "props": { "text": "Open Sales Orders", "level": "h2" } },
      "eyebrow": { "type": "Eyebrow", "props": { "text": "NetSuite ERP" } },

      "div0": { "type": "Divider", "props": {} },

      "kpiGrid": {
        "type": "Grid",
        "props": { "cols": 2, "gap": "sm" },
        "children": ["tileCount", "tileValue"]
      },

      "tileCount": { "type": "Section", "props": { "variant": "muted" }, "children": ["stackCount"] },
      "stackCount": { "type": "Stack", "props": { "gap": "xxs", "align": "center" }, "children": ["iconCount", "valCount", "lblCount"] },
      "iconCount": { "type": "Icon", "props": { "name": "Package", "size": "sm", "tone": "accent" } },
      "valCount": { "type": "Heading", "props": { "text": "7", "level": "h2" } },
      "lblCount": { "type": "Caption", "props": { "text": "Open Orders" } },

      "tileValue": { "type": "Section", "props": { "variant": "muted" }, "children": ["stackValue"] },
      "stackValue": { "type": "Stack", "props": { "gap": "xxs", "align": "center" }, "children": ["iconValue", "valValue", "lblValue"] },
      "iconValue": { "type": "Icon", "props": { "name": "DollarSign", "size": "sm", "tone": "accent" } },
      "valValue": { "type": "Heading", "props": { "text": "$234.6K", "level": "h2" } },
      "lblValue": { "type": "Caption", "props": { "text": "Total Value" } },

      "div1": { "type": "Divider", "props": {} },

      "tableHeaderRow": {
        "type": "Row",
        "props": { "template": "1fr 1.5fr 1fr 1fr", "gap": "sm", "align": "center" },
        "children": ["colOrder", "colCustomer", "colAmount", "colStatus"]
      },
      "colOrder":    { "type": "Caption", "props": { "text": "ORDER #",  "tone": "muted" } },
      "colCustomer": { "type": "Caption", "props": { "text": "CUSTOMER", "tone": "muted" } },
      "colAmount":   { "type": "Caption", "props": { "text": "AMOUNT",   "tone": "muted" } },
      "colStatus":   { "type": "Caption", "props": { "text": "STATUS",   "tone": "muted" } },

      "orderList": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": [
          "rowDiv0", "row0",
          "rowDiv1", "row1",
          "rowDiv2", "row2",
          "rowDiv3", "row3",
          "rowDiv4", "row4",
          "rowDiv5", "row5",
          "rowDiv6", "row6"
        ]
      },

      "rowDiv0": { "type": "Divider", "props": {} },
      "row0": {
        "type": "Row",
        "props": { "template": "1fr 1.5fr 1fr 1fr", "gap": "sm", "align": "center" },
