{
  "id": "netsuite-overdue-invoices",
  "title": "Overdue Invoices",
  "description": "Top overdue customer invoices sorted by most overdue first.",
  "category": "finance",
  "tags": ["netsuite", "oracle", "erp", "finance", "ar", "invoices", "overdue", "accounts-receivable"],
  "keywords": ["overdue invoices", "accounts receivable", "past due", "collections", "netsuite", "erp"],
  "connectorsUsed": ["netsuite"],
  "popularity": 0,
  "status": "published",
  "sizing": {
    "preferred": { "colSpan": 7, "rowSpan": 9 },
    "min":       { "colSpan": 5, "rowSpan": 8 },
    "max":       { "colSpan": 12, "rowSpan": 14 }
  },
  "dataProvider": {
    "mcp": "netsuite",
    "tool": "list_overdue_invoices",
    "params": {}
  },
  "spec": {
    "root": "card",
    "elements": {

      "card": {
        "type": "Card",
        "props": {},
        "children": ["headerRow", "div0", "kpiGrid", "div1", "tableBody", "div2", "kvGrid"]
      },

      "headerRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["titleGroup"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": { "type": "Icon", "props": { "name": "AlertTriangle", "tone": "destructive", "size": "sm" } },
      "titleStack": { "type": "Stack", "props": { "gap": "none" }, "children": ["title", "eyebrow"] },
      "title": { "type": "Heading", "props": { "text": "Overdue Invoices", "level": "h2" } },
      "eyebrow": { "type": "Eyebrow", "props": { "text": "NetSuite ERP · Requires attention" } },

      "div0": { "type": "Divider", "props": {} },

      "kpiGrid": {
        "type": "Grid",
        "props": { "cols": 2, "gap": "sm" },
        "children": ["tileTotal", "tileCount"]
      },

      "tileTotal": { "type": "Section", "props": { "variant": "muted" }, "children": ["stackTotal"] },
      "stackTotal": { "type": "Stack", "props": { "gap": "xxs", "align": "center" }, "children": ["iconTotal", "valTotal", "lblTotal"] },
      "iconTotal": { "type": "Icon", "props": { "name": "DollarSign", "size": "sm", "tone": "destructive" } },
      "valTotal": {
        "type": "Stat",
        "props": {
          "value": {
            "$computed": "format_currency",
            "args": { "value": { "$state": "/netsuite/list_overdue_invoices/total_overdue" } }
          }
        }
      },
      "lblTotal": { "type": "Caption", "props": { "text": "Total Overdue" } },

      "tileCount": { "type": "Section", "props": { "variant": "muted" }, "children": ["stackCount"] },
      "stackCount": { "type": "Stack", "props": { "gap": "xxs", "align": "center" }, "children": ["iconCount", "valCount", "lblCount"] },
      "iconCount": { "type": "Icon", "props": { "name": "FileText", "size": "sm", "tone": "warning" } },
      "valCount": {
        "type": "Stat",
        "props": { "value": { "$state": "/netsuite/list_overdue_invoices/invoice_count" } }
      },
      "lblCount": { "type": "Caption", "props": { "text": "Overdue Invoices" } },

      "div1": { "type": "Divider", "props": {} },

      "tableBody": {
        "type": "Body",
        "props": {},
        "children": ["invoicesTable"]
      },
      "invoicesTable": {
        "type": "Table",
        "props": {
          "loading": { "$state": "/_loading/netsuite.list_overdue_invoices" },
          "skeletonRows": 6,
          "rows": { "$state": "/netsuite/list_overdue_invoices/invoices" },
          "columns": [
            { "id": "invoice",  "header": "Invoice #",    "field": "invoice_number",  "width": 100, "priority": 1 },
            { "id": "customer", "header": "Customer",     "field": "customer_name",                 "priority": 1 },
            { "id": "amount",   "header": "Amount",       "field": "amount_remaining", "width": 110, "priority": 1, "format": "currency" },
            { "id": "days",     "header": "Days Overdue", "field": "days_overdue",    "width": 110, "priority": 1 },
            { "id": "due",      "header": "Due Date",     "field": "due_date",        "width": 110, "priority": 2, "format": "relative" }
          ]
        }
      },

      "div2": { "type": "Divider", "props": {} },

      "kvGrid": {
        "type": "Row",
        "props": { "justify": "between", "align": "start" },
        "children": ["kvOldest", "kvAvg"]
      },
      "kvOldest": {
        "type": "KeyValue",
        "props": {
          "label": "Oldest Invoice",
          "value": {
            "$computed": "netsuite_format_days",
            "args": { "value": { "$state": "/netsuite/list_overdue_invoices/oldest_days_overdue" } }
          }
        }
      },
      "kvAvg": {
        "type": "KeyValue",
        "props": {
          "label": "Avg Days Overdue",
          "value": {
            "$computed": "netsuite_format_days",
            "args": { "value": { "$state": "/netsuite/list_overdue_invoices/avg_days_overdue" } }
          }
        }
      }

    }
  }
}
