{
  "id": "netsuite-revenue-summary",
  "title": "Revenue at a Glance",
  "description": "Monthly revenue summary — current month vs prior month from NetSuite ERP.",
  "category": "finance",
  "tags": ["netsuite", "oracle", "erp", "finance", "revenue", "invoices"],
  "keywords": ["revenue", "sales", "monthly", "trend", "invoices", "netsuite", "erp"],
  "connectorsUsed": ["netsuite"],
  "popularity": 0,
  "status": "published",
  "sizing": {
    "preferred": { "colSpan": 5, "rowSpan": 7 },
    "min":       { "colSpan": 4, "rowSpan": 6 },
    "max":       { "colSpan": 10, "rowSpan": 12 }
  },
  "dataProvider": {
    "mcp": "netsuite",
    "tool": "get_revenue_summary",
    "params": {}
  },
  "spec": {
    "root": "card",
    "elements": {

      "card": {
        "type": "Card",
        "props": {},
        "children": ["headerRow", "div0", "kpiGrid", "div1", "bottomKv"]
      },

      "headerRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["titleGroup"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": { "type": "Icon", "props": { "name": "TrendingUp", "tone": "accent", "size": "sm" } },
      "titleStack": { "type": "Stack", "props": { "gap": "none" }, "children": ["title", "eyebrow"] },
      "title": { "type": "Heading", "props": { "text": "Revenue at a Glance", "level": "h2" } },
      "eyebrow": { "type": "Eyebrow", "props": { "text": "NetSuite ERP · Current month" } },

      "div0": { "type": "Divider", "props": {} },

      "kpiGrid": {
        "type": "Grid",
        "props": { "cols": 3, "gap": "sm" },
        "children": ["tileThisMonth", "tileLastMonth", "tileChange"]
      },

      "tileThisMonth": { "type": "Section", "props": { "variant": "muted" }, "children": ["stackThisMonth"] },
      "stackThisMonth": { "type": "Stack", "props": { "gap": "xxs", "align": "center" }, "children": ["iconThisMonth", "valThisMonth", "lblThisMonth"] },
      "iconThisMonth": { "type": "Icon", "props": { "name": "DollarSign", "size": "sm", "tone": "accent" } },
      "valThisMonth": {
        "type": "Stat",
        "props": {
          "value": {
            "$computed": "format_currency",
            "args": { "value": { "$state": "/netsuite/get_revenue_summary/this_month" } }
          }
        }
      },
      "lblThisMonth": {
        "type": "Caption",
        "props": { "text": { "$state": "/netsuite/get_revenue_summary/this_month_label" } }
      },

      "tileLastMonth": { "type": "Section", "props": { "variant": "muted" }, "children": ["stackLastMonth"] },
      "stackLastMonth": { "type": "Stack", "props": { "gap": "xxs", "align": "center" }, "children": ["iconLastMonth", "valLastMonth", "lblLastMonth"] },
      "iconLastMonth": { "type": "Icon", "props": { "name": "DollarSign", "size": "sm", "tone": "muted" } },
      "valLastMonth": {
        "type": "Stat",
        "props": {
          "value": {
            "$computed": "format_currency",
            "args": { "value": { "$state": "/netsuite/get_revenue_summary/last_month" } }
          }
        }
      },
      "lblLastMonth": {
        "type": "Caption",
        "props": { "text": { "$state": "/netsuite/get_revenue_summary/last_month_label" } }
      },

      "tileChange": { "type": "Section", "props": { "variant": "muted" }, "children": ["stackChange"] },
      "stackChange": { "type": "Stack", "props": { "gap": "xxs", "align": "center" }, "children": ["iconChange", "valChange", "lblChange"] },
      "iconChange": { "type": "Icon", "props": { "name": "TrendingUp", "size": "sm", "tone": "accent" } },
      "valChange": {
        "type": "Stat",
        "props": {
          "value": {
            "$computed": "fmt",
            "args": {
              "pattern": "{n}%",
              "n": { "$state": "/netsuite/get_revenue_summary/change_pct" }
            }
          }
        }
      },
      "lblChange": { "type": "Caption", "props": { "text": "vs Last Month" } },

      "div1": { "type": "Divider", "props": {} },

      "bottomKv": {
        "type": "Grid",
        "props": { "cols": 2, "gap": "sm" },
        "children": ["kvThisMonth", "kvLastMonth"]
      },
      "kvThisMonth": {
        "type": "KeyValue",
        "props": {
          "label": "Current Month",
          "value": { "$state": "/netsuite/get_revenue_summary/this_month_label" }
        }
      },
      "kvLastMonth": {
        "type": "KeyValue",
        "props": {
          "label": "Prior Month",
          "value": { "$state": "/netsuite/get_revenue_summary/last_month_label" }
        }
      }

    }
  }
}
