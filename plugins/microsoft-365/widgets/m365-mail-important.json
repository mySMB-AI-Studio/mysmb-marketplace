{
  "id": "m365-mail-important",
  "title": "Today's Important Emails",
  "description": "Unread messages received recently, surfaced to the top of your inbox.",
  "category": "productivity",
  "tags": [
    "m365",
    "email",
    "important",
    "priority"
  ],
  "keywords": [
    "important",
    "priority",
    "today",
    "unread"
  ],
  "connectorsUsed": [
    "m365-mail-read"
  ],
  "popularity": 60,
  "sizing": {
    "preferred": {
      "colSpan": 6,
      "rowSpan": 6
    },
    "min": {
      "colSpan": 4,
      "rowSpan": 4
    },
    "max": {
      "colSpan": 12,
      "rowSpan": 12
    }
  },
  "dataProvider": {
    "mcp": "m365-mail-read",
    "tool": "list_emails",
    "params": {
      "limit": 30
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "children": [
          "header",
          "body"
        ]
      },
      "header": {
        "type": "Header",
        "children": [
          "titleRow"
        ]
      },
      "titleRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "start"
        },
        "children": [
          "titleIcon",
          "titleStack"
        ]
      },
      "titleIcon": {
        "type": "Icon",
        "props": {
          "name": "Flame",
          "tone": "warning",
          "size": "sm"
        }
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "Important Today",
          "level": "h2"
        }
      },
      "count": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{n} Unread",
              "n": {
                "$computed": "count_where",
                "args": {
                  "value": {
                    "$state": "/m365-mail-read/list_emails"
                  },
                  "whereField": "isRead",
                  "equals": false
                }
              }
            }
          }
        }
      },
      "body": {
        "type": "Body",
        "children": [
          "loading",
          "empty",
          "list"
        ]
      },
      "loading": {
        "type": "Skeleton",
        "props": {
          "height": "8rem",
          "rounded": "md"
        },
        "visible": {
          "$state": "/_loading/m365-mail-read.list_emails"
        }
      },
      "empty": {
        "type": "Empty",
        "props": {
          "message": "Inbox zero."
        },
        "visible": {
          "$and": [
            {
              "$state": "/_loading/m365-mail-read.list_emails",
              "not": true
            },
            {
              "$state": "/m365-mail-read/list_emails/0",
              "not": true
            }
          ]
        }
      },
      "list": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "repeat": {
          "statePath": "/m365-mail-read/list_emails",
          "key": "id"
        },
        "children": [
          "row"
        ]
      },
      "row": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "start",
          "justify": "between",
          "hover": true,
          "clickable": true
        },
        "visible": {
          "$item": "isRead",
          "eq": false
        },
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "url": {
                "$computed": "fmt",
                "args": {
                  "pattern": "https://outlook.office.com/mail/inbox/id/{id}",
                  "id": {
                    "$item": "id"
                  }
                }
              }
            }
          }
        },
        "children": [
          "rowLeft",
          "age"
        ]
      },
      "rowLeft": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "start",
          "grow": true
        },
        "children": [
          "dot",
          "avatar",
          "labels"
        ]
      },
      "dot": {
        "type": "Dot",
        "props": {
          "tone": "warning",
          "size": "sm"
        }
      },
      "avatar": {
        "type": "Avatar",
        "props": {
          "initials": {
            "$computed": "initials",
            "args": {
              "value": {
                "$item": "from/emailAddress/name"
              }
            }
          },
          "size": "sm"
        }
      },
      "labels": {
        "type": "Stack",
        "props": {
          "gap": "xs",
          "grow": true
        },
        "children": [
          "subject",
          "preview"
        ]
      },
      "subject": {
        "type": "Text",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{n} \u2014 {s}",
              "n": {
                "$item": "from/emailAddress/name"
              },
              "s": {
                "$item": "subject"
              }
            }
          },
          "size": "sm",
          "weight": "medium",
          "truncate": true
        }
      },
      "preview": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "email_preview",
            "args": {
              "value": {
                "$item": "bodyPreview"
              },
              "maxLength": 140
            }
          }
        }
      },
      "age": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "relative_time",
            "args": {
              "value": {
                "$item": "receivedDateTime"
              }
            }
          }
        }
      },
      "titleStack": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "children": [
          "title",
          "count"
        ]
      }
    }
  },
  "status": "published"
}
