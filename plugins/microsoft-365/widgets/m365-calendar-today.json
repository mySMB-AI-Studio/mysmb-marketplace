{
  "id": "m365-calendar-today",
  "title": "Today",
  "description": "Timeline of today's meetings with location, attendees, and quick cancel.",
  "category": "productivity",
  "tags": [
    "m365",
    "calendar",
    "outlook",
    "meetings",
    "schedule"
  ],
  "keywords": [
    "today",
    "schedule",
    "calendar",
    "meetings",
    "events"
  ],
  "connectorsUsed": [
    "m365-calendar"
  ],
  "popularity": 92,
  "sizing": {
    "preferred": {
      "colSpan": 6,
      "rowSpan": 6
    },
    "min": {
      "colSpan": 4,
      "rowSpan": 4
    },
    "max": {
      "colSpan": 12,
      "rowSpan": 12
    }
  },
  "dataProvider": {
    "mcp": "m365-calendar",
    "tool": "list_events",
    "params": {
      "startDateTime": "$today",
      "endDateTime": "$today_end",
      "limit": 50
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "children": [
          "header",
          "body",
          "overlay"
        ],
        "watch": {
          "/m365-calendar/list_events": {
            "action": "setState",
            "params": {
              "statePath": "/ui/todayEvents",
              "value": {
                "$computed": "filter_date_range",
                "args": {
                  "value": {
                    "$state": "/m365-calendar/list_events"
                  },
                  "field": "start.dateTime"
                }
              }
            }
          }
        }
      },
      "header": {
        "type": "Header",
        "children": [
          "titleRow",
          "count"
        ]
      },
      "titleRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center"
        },
        "children": [
          "titleIcon",
          "title"
        ]
      },
      "titleIcon": {
        "type": "Icon",
        "props": {
          "name": "CalendarDays",
          "tone": "accent",
          "size": "sm"
        }
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "Today",
          "level": "h2"
        }
      },
      "count": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{n} meetings",
              "n": {
                "$computed": "count",
                "args": {
                  "value": {
                    "$state": "/ui/todayEvents"
                  }
                }
              }
            }
          }
        }
      },
      "body": {
        "type": "Body",
        "children": [
          "loading",
          "empty",
          "list"
        ]
      },
      "loading": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "sk1",
          "sk2",
          "sk3"
        ],
        "visible": {
          "$state": "/_loading/m365-calendar.list_events"
        }
      },
      "sk1": {
        "type": "Skeleton",
        "props": {
          "height": "3rem",
          "rounded": "md"
        }
      },
      "sk2": {
        "type": "Skeleton",
        "props": {
          "height": "3rem",
          "rounded": "md"
        }
      },
      "sk3": {
        "type": "Skeleton",
        "props": {
          "height": "3rem",
          "rounded": "md"
        }
      },
      "empty": {
        "type": "Empty",
        "props": {
          "message": "No meetings — go do deep work."
        },
        "visible": {
          "$and": [
            {
              "$state": "/_loading/m365-calendar.list_events",
              "not": true
            },
            {
              "$state": "/ui/todayEvents/0",
              "not": true
            }
          ]
        }
      },
      "list": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "children": [
          "row"
        ],
        "repeat": {
          "statePath": "/ui/todayEvents",
          "key": "id"
        },
        "visible": {
          "$state": "/_loading/m365-calendar.list_events",
          "not": true
        }
      },
      "row": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "start",
          "hover": true,
          "clickable": true,
          "justify": "between"
        },
        "children": [
          "timePill",
          "labels"
        ],
        "on": {
          "click": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/selectedEventId",
                "value": {
                  "$computed": "identity",
                  "args": {
                    "value": {
                      "$item": "id"
                    }
                  }
                }
              }
            },
            {
              "action": "m365-calendar.get_event",
              "params": {
                "id": {
                  "$computed": "identity",
                  "args": {
                    "value": {
                      "$item": "id"
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "timePill": {
        "type": "Badge",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{t}",
              "t": {
                "$computed": "relative_time",
                "args": {
                  "value": {
                    "$item": "start/dateTime"
                  }
                }
              }
            }
          },
          "tone": "accent",
          "variant": "soft"
        }
      },
      "labels": {
        "type": "Stack",
        "props": {
          "gap": "xs",
          "grow": true
        },
        "children": [
          "subject",
          "scheduleRow",
          "subtitle"
        ]
      },
      "subject": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "subject"
          },
          "size": "md",
          "weight": "medium",
          "truncate": true
        }
      },
      "scheduleRow": {
        "type": "Text",
        "props": {
          "size": "sm",
          "tone": "muted",
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{start} – {end} · {dur}",
              "start": {
                "$computed": "format_time",
                "args": { "value": { "$item": "start/dateTime" } }
              },
              "end": {
                "$computed": "format_time",
                "args": { "value": { "$item": "end/dateTime" } }
              },
              "dur": {
                "$computed": "duration_between",
                "args": {
                  "start": { "$item": "start/dateTime" },
                  "end": { "$item": "end/dateTime" }
                }
              }
            }
          }
        }
      },
      "subtitle": {
        "type": "Text",
        "props": {
          "size": "sm",
          "tone": "muted",
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{loc} · {org}",
              "loc": {
                "$item": "location/displayName"
              },
              "org": {
                "$item": "organizer/emailAddress/name"
              }
            }
          }
        }
      },
      "overlay": {
        "type": "Overlay",
        "props": {
          "maxWidth": "34rem"
        },
        "children": [
          "detailCard"
        ],
        "visible": {
          "$state": "/ui/selectedEventId"
        },
        "on": {
          "backdropClick": {
            "action": "setState",
            "params": {
              "statePath": "/ui/selectedEventId",
              "value": ""
            }
          }
        }
      },
      "detailCard": {
        "type": "Card",
        "children": [
          "detailHeader",
          "detailBody"
        ]
      },
      "detailHeader": {
        "type": "Header",
        "children": [
          "detailTitle",
          "detailClose"
        ]
      },
      "detailTitle": {
        "type": "Heading",
        "props": {
          "text": {
            "$state": "/m365-calendar/get_event/subject"
          },
          "level": "h2"
        }
      },
      "detailClose": {
        "type": "IconButton",
        "props": {
          "icon": "X",
          "tone": "muted",
          "ariaLabel": "Close"
        },
        "on": {
          "click": {
            "action": "setState",
            "params": {
              "statePath": "/ui/selectedEventId",
              "value": ""
            }
          }
        }
      },
      "detailBody": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "kvStart",
          "kvEnd",
          "kvLocation",
          "divider",
          "cancelBtn"
        ],
        "visible": {
          "$state": "/m365-calendar/get_event/id",
          "eq": {
            "$state": "/ui/selectedEventId"
          }
        }
      },
      "kvStart": {
        "type": "KeyValue",
        "props": {
          "label": "Starts",
          "value": {
            "$computed": "format_date",
            "args": {
              "value": {
                "$state": "/m365-calendar/get_event/start/dateTime"
              },
              "format": "long"
            }
          }
        }
      },
      "kvEnd": {
        "type": "KeyValue",
        "props": {
          "label": "Ends",
          "value": {
            "$computed": "format_date",
            "args": {
              "value": {
                "$state": "/m365-calendar/get_event/end/dateTime"
              },
              "format": "long"
            }
          }
        }
      },
      "kvLocation": {
        "type": "KeyValue",
        "props": {
          "label": "Location",
          "value": {
            "$state": "/m365-calendar/get_event/location/displayName"
          }
        }
      },
      "divider": {
        "type": "Divider"
      },
      "cancelBtn": {
        "type": "Button",
        "props": {
          "label": "Cancel meeting",
          "variant": "ghost",
          "size": "sm",
          "leadingIcon": "X"
        },
        "on": {
          "click": [
            {
              "action": "m365-calendar.cancel_event",
              "params": {
                "id": {
                  "$state": "/ui/selectedEventId"
                }
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/selectedEventId",
                "value": ""
              }
            },
            {
              "action": "m365-calendar.list_events",
              "params": {
                "limit": 20
              }
            }
          ]
        }
      }
    }
  },
  "status": "published"
}
