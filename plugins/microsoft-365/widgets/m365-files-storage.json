{
  "id": "m365-files-storage",
  "title": "Storage Usage",
  "description": "Largest recently used files in your OneDrive \u2014 cleanup candidates.",
  "category": "productivity",
  "tags": [
    "m365",
    "files",
    "storage",
    "cleanup"
  ],
  "keywords": [
    "storage",
    "quota",
    "cleanup",
    "size"
  ],
  "connectorsUsed": [
    "m365-files"
  ],
  "popularity": 0,
  "sizing": {
    "preferred": {
      "colSpan": 6,
      "rowSpan": 6
    },
    "min": {
      "colSpan": 4,
      "rowSpan": 4
    },
    "max": {
      "colSpan": 12,
      "rowSpan": 12
    }
  },
  "dataProvider": {
    "mcp": "m365-files",
    "tool": "list_recent_files",
    "params": {
      "limit": 50
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "children": [
          "header",
          "body"
        ]
      },
      "header": {
        "type": "Header",
        "children": [
          "titleRow"
        ]
      },
      "titleRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "start"
        },
        "children": [
          "titleIcon",
          "titleStack"
        ]
      },
      "titleIcon": {
        "type": "Icon",
        "props": {
          "name": "HardDrive",
          "tone": "accent",
          "size": "sm"
        }
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "Storage Usage",
          "level": "h2"
        }
      },
      "totalBadge": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{n} Sampled",
              "n": {
                "$computed": "count",
                "args": {
                  "value": {
                    "$state": "/m365-files/list_recent_files"
                  }
                }
              }
            }
          }
        }
      },
      "body": {
        "type": "Body",
        "children": [
          "table"
        ]
      },
      "table": {
        "type": "Table",
        "props": {
          "loading": {
            "$state": "/_loading/m365-files.list_recent_files"
          },
          "skeletonRows": 6,
          "rows": {
            "$computed": "top_n",
            "args": {
              "value": {
                "$state": "/m365-files/list_recent_files"
              },
              "field": "size",
              "direction": "desc",
              "limit": 15
            }
          },
          "rowAction": [
            {
              "action": "open_url",
              "fromRow": {
                "url": "webUrl"
              }
            }
          ],
          "columns": [
            {
              "id": "name",
              "header": "Name",
              "field": "name",
              "width": 240,
              "priority": 1
            },
            {
              "id": "size",
              "header": "Size",
              "field": "size",
              "format": "bytes",
              "align": "right",
              "width": 100,
              "priority": 1
            },
            {
              "id": "mod",
              "header": "Modified",
              "field": "lastModifiedDateTime",
              "format": "relative",
              "align": "right",
              "width": 120,
              "priority": 2
            }
          ]
        }
      },
      "titleStack": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "children": [
          "title",
          "totalBadge"
        ]
      }
    }
  },
  "status": "draft"
}
