{
  "id": "m365-meeting-prep",
  "title": "Meeting Prep Card",
  "description": "For your next meeting: subject, attendees, and related recent emails.",
  "category": "productivity",
  "tags": [
    "m365",
    "calendar",
    "prep",
    "meeting"
  ],
  "keywords": [
    "prep",
    "next",
    "meeting",
    "briefing"
  ],
  "connectorsUsed": [
    "m365-calendar",
    "m365-mail-read"
  ],
  "popularity": 80,
  "sizing": {
    "preferred": {
      "colSpan": 6,
      "rowSpan": 7
    },
    "min": {
      "colSpan": 4,
      "rowSpan": 5
    },
    "max": {
      "colSpan": 12,
      "rowSpan": 12
    }
  },
  "dataProvider": {
    "mcp": "m365-calendar",
    "tool": "list_events",
    "params": {
      "limit": 1
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "children": [
          "header",
          "body",
          "autoFetch"
        ]
      },
      "header": {
        "type": "Header",
        "children": [
          "titleRow"
        ]
      },
      "titleRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center"
        },
        "children": [
          "titleIcon",
          "title"
        ]
      },
      "titleIcon": {
        "type": "Icon",
        "props": {
          "name": "Clipboard",
          "tone": "accent",
          "size": "sm"
        }
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "Meeting prep",
          "level": "h2"
        }
      },
      "body": {
        "type": "Stack",
        "props": {
          "gap": "md"
        },
        "children": [
          "empty",
          "topStack",
          "divider",
          "attendees",
          "divider2",
          "related"
        ]
      },
      "empty": {
        "type": "Empty",
        "props": {
          "message": "Nothing upcoming — enjoy the quiet."
        },
        "visible": {
          "$and": [
            {
              "$state": "/_loading/m365-calendar.list_events",
              "not": true
            },
            {
              "$state": "/m365-calendar/list_events/0",
              "not": true
            }
          ]
        }
      },
      "topStack": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "visible": {
          "$state": "/m365-calendar/list_events/0/id"
        },
        "children": [
          "countdown",
          "subject",
          "when",
          "location"
        ]
      },
      "countdown": {
        "type": "Stat",
        "props": {
          "value": {
            "$computed": "relative_time",
            "args": {
              "value": {
                "$state": "/m365-calendar/list_events/0/start/dateTime"
              }
            }
          },
          "tone": "accent"
        }
      },
      "subject": {
        "type": "Text",
        "props": {
          "text": {
            "$state": "/m365-calendar/list_events/0/subject"
          },
          "size": "md",
          "weight": "semibold",
          "truncate": true
        }
      },
      "when": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "format_date",
            "args": {
              "value": {
                "$state": "/m365-calendar/list_events/0/start/dateTime"
              },
              "format": "long"
            }
          }
        }
      },
      "location": {
        "type": "Caption",
        "props": {
          "text": {
            "$state": "/m365-calendar/list_events/0/location/displayName"
          }
        }
      },
      "divider": {
        "type": "Divider"
      },
      "attendees": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "visible": {
          "$state": "/m365-calendar/list_events/0/attendees/0"
        },
        "children": [
          "atHead",
          "atList"
        ]
      },
      "atHead": {
        "type": "Heading",
        "props": {
          "text": "Attendees",
          "level": "h3"
        }
      },
      "atList": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "repeat": {
          "statePath": "/m365-calendar/list_events/0/attendees",
          "key": "emailAddress/address"
        },
        "children": [
          "atRow"
        ]
      },
      "atRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "start",
          "hover": true
        },
        "children": [
          "atAvatar",
          "atLabels"
        ]
      },
      "atAvatar": {
        "type": "Avatar",
        "props": {
          "initials": {
            "$computed": "initials",
            "args": {
              "value": {
                "$item": "emailAddress/name"
              }
            }
          },
          "size": "sm"
        }
      },
      "atLabels": {
        "type": "Stack",
        "props": {
          "gap": "xs",
          "grow": true
        },
        "children": [
          "atName",
          "atAddr"
        ]
      },
      "atName": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "emailAddress/name"
          },
          "size": "sm",
          "weight": "medium",
          "truncate": true
        }
      },
      "atAddr": {
        "type": "Caption",
        "props": {
          "text": {
            "$item": "emailAddress/address"
          }
        }
      },
      "divider2": {
        "type": "Divider",
        "visible": {
          "$state": "/m365-mail-read/search_emails/0"
        }
      },
      "related": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "visible": {
          "$state": "/m365-mail-read/search_emails/0"
        },
        "children": [
          "relHead",
          "relList"
        ]
      },
      "relHead": {
        "type": "Heading",
        "props": {
          "text": "Related emails",
          "level": "h3"
        }
      },
      "relList": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "repeat": {
          "statePath": "/m365-mail-read/search_emails",
          "key": "id"
        },
        "children": [
          "relRow"
        ]
      },
      "relRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "start",
          "hover": true
        },
        "children": [
          "relIcon",
          "relLabels"
        ]
      },
      "relIcon": {
        "type": "Icon",
        "props": {
          "name": "Mail",
          "tone": "muted",
          "size": "sm"
        }
      },
      "relLabels": {
        "type": "Stack",
        "props": {
          "gap": "xs",
          "grow": true
        },
        "children": [
          "relSubj",
          "relFrom"
        ]
      },
      "relSubj": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "subject"
          },
          "size": "sm",
          "weight": "medium",
          "truncate": true
        }
      },
      "relFrom": {
        "type": "Caption",
        "props": {
          "text": {
            "$item": "from/emailAddress/name"
          }
        }
      },
      "autoFetch": {
        "type": "Spinner",
        "props": {
          "size": "sm"
        },
        "visible": {
          "$state": "/_loading/m365-mail-read.search_emails"
        },
        "watch": {
          "/m365-calendar/list_events/0/subject": [
            {
              "action": "m365-mail-read.search_emails",
              "params": {
                "query": {
                  "$state": "/m365-calendar/list_events/0/subject"
                },
                "limit": 5
              }
            }
          ]
        }
      }
    }
  },
  "status": "draft"
}
