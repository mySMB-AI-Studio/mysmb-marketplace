{
  "id": "m365-files-onedrive",
  "title": "OneDrive \u2014 My Files",
  "description": "Browse your OneDrive root. Open files or copy a share link.",
  "category": "productivity",
  "tags": [
    "m365",
    "files",
    "onedrive",
    "browse"
  ],
  "keywords": [
    "onedrive",
    "files",
    "browse",
    "documents",
    "folders"
  ],
  "connectorsUsed": [
    "m365-files"
  ],
  "popularity": 0,
  "sizing": {
    "preferred": {
      "colSpan": 8,
      "rowSpan": 6
    },
    "min": {
      "colSpan": 6,
      "rowSpan": 5
    },
    "max": {
      "colSpan": 16,
      "rowSpan": 12
    }
  },
  "dataProvider": {
    "mcp": "m365-files",
    "tool": "list_files",
    "params": {
      "limit": 30
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "children": [
          "header",
          "body"
        ]
      },
      "header": {
        "type": "Header",
        "children": [
          "titleRow"
        ]
      },
      "titleRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "start"
        },
        "children": [
          "titleIcon",
          "titleStack"
        ]
      },
      "titleIcon": {
        "type": "Icon",
        "props": {
          "name": "HardDrive",
          "tone": "accent",
          "size": "sm"
        }
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "My OneDrive",
          "level": "h2"
        }
      },
      "count": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{n} items",
              "n": {
                "$computed": "count",
                "args": {
                  "value": {
                    "$state": "/m365-files/list_files"
                  }
                }
              }
            }
          }
        }
      },
      "body": {
        "type": "Body",
        "children": [
          "table"
        ]
      },
      "table": {
        "type": "Table",
        "props": {
          "loading": {
            "$state": "/_loading/m365-files.list_files"
          },
          "skeletonRows": 8,
          "rows": {
            "$state": "/m365-files/list_files"
          },
          "rowAction": [
            {
              "action": "open_url",
              "fromRow": {
                "url": "webUrl"
              }
            }
          ],
          "columns": [
            {
              "id": "name",
              "header": "Name",
              "field": "name",
              "width": 260,
              "priority": 1
            },
            {
              "id": "kind",
              "header": "Type",
              "field": "file.mimeType",
              "width": 140,
              "priority": 3
            },
            {
              "id": "size",
              "header": "Size",
              "field": "size",
              "format": "bytes",
              "align": "right",
              "width": 100,
              "priority": 2
            },
            {
              "id": "mod",
              "header": "Modified",
              "field": "lastModifiedDateTime",
              "format": "relative",
              "align": "right",
              "width": 120,
              "priority": 1
            }
          ]
        }
      },
      "titleStack": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "children": [
          "title",
          "count"
        ]
      }
    }
  },
  "status": "draft"
}
