{
  "id": "m365-files-recent",
  "title": "Recent Files",
  "description": "Most recently accessed OneDrive files with one-click open and copy sharing link.",
  "category": "productivity",
  "tags": [
    "m365",
    "files",
    "onedrive",
    "recent",
    "documents"
  ],
  "keywords": [
    "files",
    "recent",
    "onedrive",
    "documents",
    "open"
  ],
  "connectorsUsed": [
    "m365-files"
  ],
  "popularity": 72,
  "sizing": {
    "preferred": {
      "colSpan": 6,
      "rowSpan": 6
    },
    "min": {
      "colSpan": 4,
      "rowSpan": 4
    },
    "max": {
      "colSpan": 12,
      "rowSpan": 12
    }
  },
  "dataProvider": {
    "mcp": "m365-files",
    "tool": "list_recent_files",
    "params": {
      "limit": 15
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "children": [
          "header",
          "body"
        ]
      },
      "header": {
        "type": "Header",
        "children": [
          "titleRow",
          "count"
        ]
      },
      "titleRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center"
        },
        "children": [
          "titleIcon",
          "title"
        ]
      },
      "titleIcon": {
        "type": "Icon",
        "props": {
          "name": "Clock",
          "tone": "accent",
          "size": "sm"
        }
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "Recent files",
          "level": "h2"
        }
      },
      "count": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{n} files",
              "n": {
                "$computed": "count",
                "args": {
                  "value": {
                    "$state": "/m365-files/list_recent_files"
                  }
                }
              }
            }
          }
        }
      },
      "body": {
        "type": "Body",
        "children": [
          "loading",
          "empty",
          "list"
        ]
      },
      "loading": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "sk1",
          "sk2",
          "sk3",
          "sk4"
        ],
        "visible": {
          "$state": "/_loading/m365-files.list_recent_files"
        }
      },
      "sk1": {
        "type": "Skeleton",
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        }
      },
      "sk2": {
        "type": "Skeleton",
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        }
      },
      "sk3": {
        "type": "Skeleton",
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        }
      },
      "sk4": {
        "type": "Skeleton",
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        }
      },
      "empty": {
        "type": "Empty",
        "props": {
          "message": "No recent files."
        },
        "visible": {
          "$and": [
            {
              "$state": "/_loading/m365-files.list_recent_files",
              "not": true
            },
            {
              "$state": "/m365-files/list_recent_files/0",
              "not": true
            }
          ]
        }
      },
      "list": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "children": [
          "row"
        ],
        "repeat": {
          "statePath": "/m365-files/list_recent_files",
          "key": "id"
        },
        "visible": {
          "$state": "/_loading/m365-files.list_recent_files",
          "not": true
        }
      },
      "row": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center",
          "hover": true,
          "clickable": true,
          "justify": "between"
        },
        "children": [
          "fileIcon",
          "labels",
          "age",
          "shareBtn"
        ],
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "url": {
                "$computed": "identity",
                "args": {
                  "value": {
                    "$item": "webUrl"
                  }
                }
              }
            }
          }
        }
      },
      "fileIcon": {
        "type": "Icon",
        "props": {
          "name": "FileText",
          "tone": "muted",
          "size": "sm"
        }
      },
      "labels": {
        "type": "Stack",
        "props": {
          "gap": "xs",
          "grow": true
        },
        "children": [
          "fname",
          "fmeta"
        ]
      },
      "fname": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "name"
          },
          "size": "sm",
          "weight": "medium",
          "truncate": true
        }
      },
      "fmeta": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "Modified {t}",
              "t": {
                "$computed": "relative_time",
                "args": {
                  "value": {
                    "$item": "lastModifiedDateTime"
                  }
                }
              }
            }
          }
        }
      },
      "age": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "bytes_human",
            "args": {
              "value": {
                "$item": "size"
              }
            }
          }
        }
      },
      "shareBtn": {
        "type": "IconButton",
        "props": {
          "icon": "Link",
          "tone": "muted",
          "ariaLabel": "Copy share link"
        },
        "on": {
          "click": {
            "action": "copy_to_clipboard",
            "params": {
              "text": {
                "$computed": "identity",
                "args": {
                  "value": {
                    "$item": "webUrl"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "status": "draft"
}
