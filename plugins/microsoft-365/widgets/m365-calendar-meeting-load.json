{
  "id": "m365-calendar-meeting-load",
  "title": "Meeting Load",
  "description": "How many meetings are booked, with a quick density read.",
  "category": "productivity",
  "tags": [
    "m365",
    "calendar",
    "analytics",
    "load"
  ],
  "keywords": [
    "meeting load",
    "busy",
    "density",
    "analytics"
  ],
  "connectorsUsed": [
    "m365-calendar"
  ],
  "popularity": 0,
  "sizing": {
    "preferred": {
      "colSpan": 4,
      "rowSpan": 4
    },
    "min": {
      "colSpan": 3,
      "rowSpan": 3
    },
    "max": {
      "colSpan": 8,
      "rowSpan": 8
    }
  },
  "dataProvider": {
    "mcp": "m365-calendar",
    "tool": "list_events",
    "params": {
      "limit": 50
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "children": [
          "header",
          "body"
        ]
      },
      "header": {
        "type": "Header",
        "children": [
          "titleRow"
        ]
      },
      "titleRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center"
        },
        "children": [
          "titleIcon",
          "title"
        ]
      },
      "titleIcon": {
        "type": "Icon",
        "props": {
          "name": "Gauge",
          "tone": "warning",
          "size": "sm"
        }
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "Meeting Load",
          "level": "h2"
        }
      },
      "body": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "stats",
          "divider",
          "hint"
        ]
      },
      "stats": {
        "type": "Grid",
        "props": {
          "cols": 2,
          "gap": "md"
        },
        "children": [
          "leftStat",
          "rightStat"
        ]
      },
      "leftStat": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "children": [
          "leftEyebrow",
          "leftValue"
        ]
      },
      "leftEyebrow": {
        "type": "Eyebrow",
        "props": {
          "text": "Meetings"
        }
      },
      "leftValue": {
        "type": "Stat",
        "props": {
          "value": {
            "$computed": "count",
            "args": {
              "value": {
                "$state": "/m365-calendar/list_events"
              }
            }
          },
          "tone": "accent"
        }
      },
      "rightStat": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "children": [
          "rightEyebrow",
          "rightValue"
        ]
      },
      "rightEyebrow": {
        "type": "Eyebrow",
        "props": {
          "text": "With attendees"
        }
      },
      "rightValue": {
        "type": "Stat",
        "props": {
          "value": {
            "$computed": "count_where",
            "args": {
              "value": {
                "$state": "/m365-calendar/list_events"
              },
              "whereField": "attendees/0/emailAddress/address"
            }
          },
          "tone": "default"
        }
      },
      "divider": {
        "type": "Divider"
      },
      "hint": {
        "type": "Caption",
        "props": {
          "text": "Tip: block focus time to keep your week sustainable."
        }
      }
    }
  },
  "status": "draft"
}
