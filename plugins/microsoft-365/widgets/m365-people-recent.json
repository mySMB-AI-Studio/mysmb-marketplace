{
  "id": "m365-people-recent",
  "title": "Recently Interacted",
  "description": "People who've been in your recent emails — click to open their profile.",
  "category": "productivity",
  "tags": [
    "m365",
    "people",
    "recent",
    "interactions"
  ],
  "keywords": [
    "recent",
    "interacted",
    "contacts",
    "people"
  ],
  "connectorsUsed": [
    "m365-mail-read"
  ],
  "popularity": 0,
  "sizing": {
    "preferred": {
      "colSpan": 5,
      "rowSpan": 6
    },
    "min": {
      "colSpan": 4,
      "rowSpan": 4
    },
    "max": {
      "colSpan": 10,
      "rowSpan": 10
    }
  },
  "dataProvider": {
    "mcp": "m365-mail-read",
    "tool": "list_emails",
    "params": {
      "limit": 30
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "children": [
          "header",
          "body"
        ]
      },
      "header": {
        "type": "Header",
        "children": [
          "titleRow"
        ]
      },
      "titleRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center"
        },
        "children": [
          "titleIcon",
          "title"
        ]
      },
      "titleIcon": {
        "type": "Icon",
        "props": {
          "name": "UsersRound",
          "tone": "accent",
          "size": "sm"
        }
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "Recently interacted",
          "level": "h2"
        }
      },
      "body": {
        "type": "Body",
        "children": [
          "loading",
          "empty",
          "list"
        ]
      },
      "loading": {
        "type": "Skeleton",
        "props": {
          "height": "8rem",
          "rounded": "md"
        },
        "visible": {
          "$state": "/_loading/m365-mail-read.list_emails"
        }
      },
      "empty": {
        "type": "Empty",
        "props": {
          "message": "No recent interactions."
        },
        "visible": {
          "$and": [
            {
              "$state": "/_loading/m365-mail-read.list_emails",
              "not": true
            },
            {
              "$state": "/m365-mail-read/list_emails/0",
              "not": true
            }
          ]
        }
      },
      "list": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "repeat": {
          "statePath": "/m365-mail-read/list_emails",
          "key": "id"
        },
        "children": [
          "row"
        ]
      },
      "row": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "start",
          "justify": "between",
          "hover": true,
          "clickable": true
        },
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "url": {
                "$computed": "fmt",
                "args": {
                  "pattern": "mailto:{addr}",
                  "addr": {
                    "$item": "from/emailAddress/address"
                  }
                }
              }
            }
          }
        },
        "children": [
          "rowLeft",
          "ageBadge"
        ]
      },
      "rowLeft": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "start",
          "grow": true
        },
        "children": [
          "avatar",
          "labels"
        ]
      },
      "avatar": {
        "type": "Avatar",
        "props": {
          "initials": {
            "$computed": "initials",
            "args": {
              "value": {
                "$item": "from/emailAddress/name"
              }
            }
          },
          "size": "sm"
        }
      },
      "labels": {
        "type": "Stack",
        "props": {
          "gap": "xs",
          "grow": true
        },
        "children": [
          "name",
          "addr"
        ]
      },
      "name": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "from/emailAddress/name"
          },
          "size": "sm",
          "weight": "medium",
          "truncate": true
        }
      },
      "addr": {
        "type": "Caption",
        "props": {
          "text": {
            "$item": "from/emailAddress/address"
          }
        }
      },
      "ageBadge": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "relative_time",
            "args": {
              "value": {
                "$item": "receivedDateTime"
              }
            }
          }
        }
      }
    }
  },
  "status": "draft"
}
