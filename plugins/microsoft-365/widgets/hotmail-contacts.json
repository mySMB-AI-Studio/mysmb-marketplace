{
  "id": "hotmail-contacts",
  "title": "Hotmail Contacts",
  "description": "Contacts from a personal Hotmail/Outlook.com/Live.com account, alphabetical by display name.",
  "category": "productivity",
  "tags": [
    "hotmail",
    "outlook.com",
    "live.com",
    "personal",
    "contacts",
    "productivity"
  ],
  "keywords": [
    "hotmail",
    "outlook.com",
    "live.com",
    "personal contacts",
    "contacts",
    "people",
    "address book"
  ],
  "connectorsUsed": [
    "hotmail-people"
  ],
  "popularity": 0,
  "sizing": {
    "preferred": {
      "colSpan": 5,
      "rowSpan": 6
    },
    "min": {
      "colSpan": 4,
      "rowSpan": 4
    },
    "max": {
      "colSpan": 10,
      "rowSpan": 12
    }
  },
  "dataProvider": {
    "mcp": "hotmail-people",
    "tool": "list_contacts",
    "params": {
      "limit": 50
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": { "type": "Card", "props": {}, "children": ["header", "divider", "body"] },
      "header": { "type": "Header", "props": {}, "children": ["titleGroup"] },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": { "type": "Icon", "props": { "name": "Users", "tone": "accent", "size": "sm" } },
      "titleStack": { "type": "Stack", "props": { "gap": "none" }, "children": ["title", "eyebrow"] },
      "title": { "type": "Heading", "props": { "text": "Contacts", "level": "h2" } },
      "eyebrow": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{n} shown",
              "n": { "$computed": "count", "args": { "value": { "$state": "/hotmail-people/list_contacts" } } }
            }
          }
        }
      },
      "divider": { "type": "Divider", "props": {} },
      "body": { "type": "Body", "props": {}, "children": ["errorBanner", "loading", "empty", "list"] },
      "errorBanner": {
        "type": "Caption",
        "props": { "text": { "$template": "Couldn't load contacts: ${/_errors/hotmail-people.list_contacts}" }, "tone": "destructive" },
        "visible": { "$state": "/_errors/hotmail-people.list_contacts" }
      },
      "loading": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["s1", "s2", "s3", "s4"],
        "visible": { "$state": "/_loading/hotmail-people.list_contacts" }
      },
      "s1": { "type": "Skeleton", "props": { "height": "2.75rem", "rounded": "md" } },
      "s2": { "type": "Skeleton", "props": { "height": "2.75rem", "rounded": "md" } },
      "s3": { "type": "Skeleton", "props": { "height": "2.75rem", "rounded": "md" } },
      "s4": { "type": "Skeleton", "props": { "height": "2.75rem", "rounded": "md" } },
      "empty": {
        "type": "Empty",
        "props": { "message": "No contacts found." },
        "visible": {
          "$and": [
            { "$state": "/_loading/hotmail-people.list_contacts", "not": true },
            { "$state": "/hotmail-people/list_contacts/0", "not": true }
          ]
        }
      },
      "list": {
        "type": "Stack",
        "props": { "gap": "xs", "maxHeight": 440 },
        "children": ["row"],
        "repeat": { "statePath": "/hotmail-people/list_contacts", "key": "id" },
        "visible": { "$state": "/_loading/hotmail-people.list_contacts", "not": true }
      },
      "row": {
        "type": "ListItem",
        "props": {
          "title": { "$item": "displayName" },
          "subtitle": { "$item": "emailAddresses/0/address" },
          "value": { "$item": "mobilePhone" }
        }
      }
    }
  }
}
