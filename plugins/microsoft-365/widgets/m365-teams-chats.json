{
  "id": "m365-teams-chats",
  "title": "Teams — My Chats",
  "description": "Your recent Teams 1:1 and group chats. Click to load messages and reply.",
  "category": "productivity",
  "tags": [
    "m365",
    "teams",
    "chats",
    "messages"
  ],
  "keywords": [
    "teams",
    "chats",
    "dm",
    "direct",
    "messages"
  ],
  "connectorsUsed": [
    "m365-teams"
  ],
  "popularity": 0,
  "sizing": {
    "preferred": {
      "colSpan": 6,
      "rowSpan": 7
    },
    "min": {
      "colSpan": 4,
      "rowSpan": 5
    },
    "max": {
      "colSpan": 12,
      "rowSpan": 12
    }
  },
  "dataProvider": {
    "mcp": "m365-teams",
    "tool": "list_chats",
    "params": {
      "limit": 20
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "children": [
          "header",
          "body",
          "overlay"
        ]
      },
      "header": {
        "type": "Header",
        "children": [
          "titleRow"
        ]
      },
      "titleRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center"
        },
        "children": [
          "titleIcon",
          "title"
        ]
      },
      "titleIcon": {
        "type": "Icon",
        "props": {
          "name": "MessagesSquare",
          "tone": "accent",
          "size": "sm"
        }
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "Teams chats",
          "level": "h2"
        }
      },
      "body": {
        "type": "Body",
        "children": [
          "loading",
          "empty",
          "list"
        ]
      },
      "loading": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "sk1",
          "sk2",
          "sk3"
        ],
        "visible": {
          "$state": "/_loading/m365-teams.list_chats"
        }
      },
      "sk1": {
        "type": "Skeleton",
        "props": {
          "height": "2.75rem",
          "rounded": "md"
        }
      },
      "sk2": {
        "type": "Skeleton",
        "props": {
          "height": "2.75rem",
          "rounded": "md"
        }
      },
      "sk3": {
        "type": "Skeleton",
        "props": {
          "height": "2.75rem",
          "rounded": "md"
        }
      },
      "empty": {
        "type": "Empty",
        "props": {
          "message": "No chats yet."
        },
        "visible": {
          "$and": [
            {
              "$state": "/_loading/m365-teams.list_chats",
              "not": true
            },
            {
              "$state": "/m365-teams/list_chats/0",
              "not": true
            }
          ]
        }
      },
      "list": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "children": [
          "row"
        ],
        "repeat": {
          "statePath": "/m365-teams/list_chats",
          "key": "id"
        },
        "visible": {
          "$state": "/_loading/m365-teams.list_chats",
          "not": true
        }
      },
      "row": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "start",
          "hover": true,
          "clickable": true,
          "justify": "between"
        },
        "children": [
          "chatAvatar",
          "chatLabels"
        ],
        "on": {
          "click": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/selectedChatId",
                "value": {
                  "$computed": "identity",
                  "args": {
                    "value": {
                      "$item": "id"
                    }
                  }
                }
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/selectedChatTopic",
                "value": {
                  "$computed": "identity",
                  "args": {
                    "value": {
                      "$item": "topic"
                    }
                  }
                }
              }
            },
            {
              "action": "m365-teams.list_messages",
              "params": {
                "chatId": {
                  "$computed": "identity",
                  "args": {
                    "value": {
                      "$item": "id"
                    }
                  }
                },
                "limit": 20
              }
            }
          ]
        }
      },
      "chatAvatar": {
        "type": "Avatar",
        "props": {
          "initials": {
            "$computed": "initials",
            "args": {
              "value": {
                "$item": "topic"
              }
            }
          },
          "size": "sm"
        }
      },
      "chatLabels": {
        "type": "Stack",
        "props": {
          "gap": "xs",
          "grow": true
        },
        "children": [
          "chatTopic",
          "chatType"
        ]
      },
      "chatTopic": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "topic"
          },
          "size": "md",
          "weight": "medium",
          "truncate": true
        }
      },
      "chatType": {
        "type": "Text",
        "props": {
          "size": "sm",
          "tone": "muted",
          "text": {
            "$item": "chatType"
          }
        }
      },
      "overlay": {
        "type": "Overlay",
        "props": {
          "maxWidth": "36rem"
        },
        "children": [
          "detailCard"
        ],
        "visible": {
          "$state": "/ui/selectedChatId"
        },
        "on": {
          "backdropClick": {
            "action": "setState",
            "params": {
              "statePath": "/ui/selectedChatId",
              "value": ""
            }
          }
        }
      },
      "detailCard": {
        "type": "Card",
        "children": [
          "detailHeader",
          "detailBody"
        ]
      },
      "detailHeader": {
        "type": "Header",
        "children": [
          "detailTitle",
          "detailClose"
        ]
      },
      "detailTitle": {
        "type": "Heading",
        "props": {
          "text": {
            "$state": "/ui/selectedChatTopic"
          },
          "level": "h2"
        }
      },
      "detailClose": {
        "type": "IconButton",
        "props": {
          "icon": "X",
          "tone": "muted",
          "ariaLabel": "Close"
        },
        "on": {
          "click": {
            "action": "setState",
            "params": {
              "statePath": "/ui/selectedChatId",
              "value": ""
            }
          }
        }
      },
      "detailBody": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "messagesList",
          "divider",
          "replyRow",
          "sendBtn"
        ]
      },
      "messagesList": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "msgItem"
        ],
        "repeat": {
          "statePath": "/m365-teams/list_messages",
          "key": "id"
        }
      },
      "msgItem": {
        "type": "ActivityItem",
        "props": {
          "title": {
            "$item": "from/user/displayName"
          },
          "subtitle": {
            "$item": "body/content"
          },
          "timestamp": {
            "$computed": "relative_time",
            "args": {
              "value": {
                "$item": "createdDateTime"
              }
            }
          },
          "initials": {
            "$computed": "initials",
            "args": {
              "value": {
                "$item": "from/user/displayName"
              }
            }
          }
        }
      },
      "divider": {
        "type": "Divider"
      },
      "replyRow": {
        "type": "FormRow",
        "props": {
          "label": "Reply"
        },
        "children": [
          "replyInput"
        ]
      },
      "replyInput": {
        "type": "TextInput",
        "props": {
          "value": {
            "$bindState": "/ui/chatReply"
          },
          "placeholder": "Type a message…"
        }
      },
      "sendBtn": {
        "type": "Button",
        "props": {
          "label": "Send",
          "variant": "primary",
          "size": "sm",
          "leadingIcon": "Send",
          "disabled": {
            "$cond": {
              "$state": "/ui/chatReply"
            },
            "$then": false,
            "$else": true
          }
        },
        "on": {
          "click": [
            {
              "action": "m365-teams.send_message",
              "params": {
                "chatId": {
                  "$state": "/ui/selectedChatId"
                },
                "content": {
                  "$state": "/ui/chatReply"
                }
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/chatReply",
                "value": ""
              }
            },
            {
              "action": "m365-teams.list_messages",
              "params": {
                "chatId": {
                  "$state": "/ui/selectedChatId"
                },
                "limit": 20
              }
            }
          ]
        }
      }
    }
  },
  "status": "draft"
}
