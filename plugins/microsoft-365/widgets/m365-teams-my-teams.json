{
  "id": "m365-teams-my-teams",
  "title": "My Teams",
  "description": "Teams you're a member of. Click to browse channels.",
  "category": "productivity",
  "tags": [
    "m365",
    "teams",
    "channels"
  ],
  "keywords": [
    "teams",
    "channels",
    "groups",
    "collaboration"
  ],
  "connectorsUsed": [
    "m365-teams"
  ],
  "popularity": 0,
  "sizing": {
    "preferred": {
      "colSpan": 5,
      "rowSpan": 6
    },
    "min": {
      "colSpan": 4,
      "rowSpan": 4
    },
    "max": {
      "colSpan": 10,
      "rowSpan": 12
    }
  },
  "dataProvider": {
    "mcp": "m365-teams",
    "tool": "list_teams",
    "params": {}
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "children": [
          "header",
          "body",
          "overlay"
        ]
      },
      "header": {
        "type": "Header",
        "children": [
          "titleRow"
        ]
      },
      "titleRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "start"
        },
        "children": [
          "titleIcon",
          "titleStack"
        ]
      },
      "titleIcon": {
        "type": "Icon",
        "props": {
          "name": "Users",
          "tone": "accent",
          "size": "sm"
        }
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "My Teams",
          "level": "h2"
        }
      },
      "count": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{n} teams",
              "n": {
                "$computed": "count",
                "args": {
                  "value": {
                    "$state": "/m365-teams/list_teams"
                  }
                }
              }
            }
          }
        }
      },
      "body": {
        "type": "Body",
        "children": [
          "loading",
          "empty",
          "list"
        ]
      },
      "loading": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "sk1",
          "sk2",
          "sk3"
        ],
        "visible": {
          "$state": "/_loading/m365-teams.list_teams"
        }
      },
      "sk1": {
        "type": "Skeleton",
        "props": {
          "height": "2.75rem",
          "rounded": "md"
        }
      },
      "sk2": {
        "type": "Skeleton",
        "props": {
          "height": "2.75rem",
          "rounded": "md"
        }
      },
      "sk3": {
        "type": "Skeleton",
        "props": {
          "height": "2.75rem",
          "rounded": "md"
        }
      },
      "empty": {
        "type": "Empty",
        "props": {
          "message": "You're not in any teams."
        },
        "visible": {
          "$and": [
            {
              "$state": "/_loading/m365-teams.list_teams",
              "not": true
            },
            {
              "$state": "/m365-teams/list_teams/0",
              "not": true
            }
          ]
        }
      },
      "list": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "children": [
          "row"
        ],
        "repeat": {
          "statePath": "/m365-teams/list_teams",
          "key": "id"
        },
        "visible": {
          "$state": "/_loading/m365-teams.list_teams",
          "not": true
        }
      },
      "row": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "start",
          "hover": true,
          "clickable": true,
          "justify": "between"
        },
        "children": [
          "teamAvatar",
          "teamLabels"
        ],
        "on": {
          "click": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/selectedTeamId",
                "value": {
                  "$computed": "identity",
                  "args": {
                    "value": {
                      "$item": "id"
                    }
                  }
                }
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/selectedTeamName",
                "value": {
                  "$computed": "identity",
                  "args": {
                    "value": {
                      "$item": "displayName"
                    }
                  }
                }
              }
            },
            {
              "action": "m365-teams.list_channels",
              "params": {
                "teamId": {
                  "$computed": "identity",
                  "args": {
                    "value": {
                      "$item": "id"
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "teamAvatar": {
        "type": "Avatar",
        "props": {
          "initials": {
            "$computed": "initials",
            "args": {
              "value": {
                "$item": "displayName"
              }
            }
          },
          "size": "sm",
          "tone": "accent"
        }
      },
      "teamLabels": {
        "type": "Stack",
        "props": {
          "gap": "xs",
          "grow": true
        },
        "children": [
          "teamName",
          "teamDesc"
        ]
      },
      "teamName": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "displayName"
          },
          "size": "md",
          "weight": "medium",
          "truncate": true
        }
      },
      "teamDesc": {
        "type": "Text",
        "props": {
          "size": "sm",
          "tone": "muted",
          "text": {
            "$item": "description"
          }
        }
      },
      "overlay": {
        "type": "Overlay",
        "props": {
          "maxWidth": "32rem"
        },
        "children": [
          "channelCard"
        ],
        "visible": {
          "$state": "/ui/selectedTeamId"
        },
        "on": {
          "backdropClick": {
            "action": "setState",
            "params": {
              "statePath": "/ui/selectedTeamId",
              "value": ""
            }
          }
        }
      },
      "channelCard": {
        "type": "Card",
        "children": [
          "channelHeader",
          "channelList"
        ]
      },
      "channelHeader": {
        "type": "Row",
        "children": [
          "channelTitle",
          "channelClose"
        ],
        "props": {
          "gap": "sm",
          "align": "center",
          "justify": "between"
        }
      },
      "channelTitle": {
        "type": "Heading",
        "props": {
          "text": {
            "$state": "/ui/selectedTeamName"
          },
          "level": "h2"
        }
      },
      "channelClose": {
        "type": "IconButton",
        "props": {
          "icon": "X",
          "tone": "default",
          "ariaLabel": "Close",
          "size": "md",
          "variant": "outlined"
        },
        "on": {
          "click": {
            "action": "setState",
            "params": {
              "statePath": "/ui/selectedTeamId",
              "value": ""
            }
          }
        }
      },
      "channelList": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "children": [
          "chRow"
        ],
        "repeat": {
          "statePath": "/m365-teams/list_channels",
          "key": "id"
        }
      },
      "chRow": {
        "type": "ListItem",
        "props": {
          "title": {
            "$item": "displayName"
          },
          "subtitle": {
            "$item": "description"
          }
        }
      },
      "titleStack": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "children": [
          "title",
          "count"
        ]
      }
    }
  },
  "status": "draft"
}
