{
  "id": "m365-people-search",
  "title": "People Finder",
  "description": "Search your organisation's directory. Click a person to see their profile, or quick-email them.",
  "category": "productivity",
  "tags": [
    "m365",
    "people",
    "directory",
    "search"
  ],
  "keywords": [
    "people",
    "search",
    "directory",
    "find",
    "employee",
    "coworker"
  ],
  "connectorsUsed": [
    "m365-people"
  ],
  "popularity": 0,
  "sizing": {
    "preferred": {
      "colSpan": 6,
      "rowSpan": 6
    },
    "min": {
      "colSpan": 4,
      "rowSpan": 4
    },
    "max": {
      "colSpan": 12,
      "rowSpan": 10
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "children": [
          "header",
          "body",
          "overlay"
        ]
      },
      "header": {
        "type": "Header",
        "children": [
          "titleRow"
        ]
      },
      "titleRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center"
        },
        "children": [
          "titleIcon",
          "title"
        ]
      },
      "titleIcon": {
        "type": "Icon",
        "props": {
          "name": "Search",
          "tone": "accent",
          "size": "sm"
        }
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "Find someone",
          "level": "h2"
        }
      },
      "body": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "searchRow",
          "emptyHint",
          "results"
        ]
      },
      "searchRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center"
        },
        "children": [
          "queryInput",
          "searchBtn"
        ]
      },
      "queryInput": {
        "type": "TextInput",
        "props": {
          "value": {
            "$bindState": "/ui/q"
          },
          "placeholder": "Name or email…"
        }
      },
      "searchBtn": {
        "type": "Button",
        "props": {
          "label": "Search",
          "variant": "primary",
          "size": "sm",
          "leadingIcon": "Search",
          "disabled": {
            "$cond": {
              "$state": "/ui/q"
            },
            "$then": false,
            "$else": true
          }
        },
        "on": {
          "click": {
            "action": "m365-people.search_people",
            "params": {
              "query": {
                "$state": "/ui/q"
              },
              "limit": 15
            }
          }
        }
      },
      "emptyHint": {
        "type": "Empty",
        "props": {
          "message": "Type a name or email to search."
        },
        "visible": {
          "$and": [
            {
              "$state": "/m365-people/search_people/0",
              "not": true
            },
            {
              "$state": "/_loading/m365-people.search_people",
              "not": true
            }
          ]
        }
      },
      "results": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "repeat": {
          "statePath": "/m365-people/search_people",
          "key": "id"
        },
        "children": [
          "row"
        ]
      },
      "row": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center",
          "justify": "between",
          "hover": true,
          "clickable": true
        },
        "on": {
          "click": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/selectedUpn",
                "value": {
                  "$computed": "identity",
                  "args": {
                    "value": {
                      "$item": "userPrincipalName"
                    }
                  }
                }
              }
            },
            {
              "action": "m365-people.get_profile",
              "params": {
                "userIdOrUpn": {
                  "$computed": "identity",
                  "args": {
                    "value": {
                      "$item": "userPrincipalName"
                    }
                  }
                }
              }
            }
          ]
        },
        "children": [
          "rowLeft",
          "mailBtn"
        ]
      },
      "rowLeft": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center",
          "grow": true
        },
        "children": [
          "avatar",
          "labels"
        ]
      },
      "avatar": {
        "type": "Avatar",
        "props": {
          "initials": {
            "$computed": "initials",
            "args": {
              "value": {
                "$item": "displayName"
              }
            }
          },
          "size": "md"
        }
      },
      "labels": {
        "type": "Stack",
        "props": {
          "gap": "xs",
          "grow": true
        },
        "children": [
          "nameText",
          "jobText"
        ]
      },
      "nameText": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "displayName"
          },
          "size": "sm",
          "weight": "medium",
          "truncate": true
        }
      },
      "jobText": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{title} · {dept}",
              "title": {
                "$item": "jobTitle"
              },
              "dept": {
                "$item": "department"
              }
            }
          }
        }
      },
      "mailBtn": {
        "type": "IconButton",
        "props": {
          "icon": "Mail",
          "tone": "muted",
          "ariaLabel": "Email"
        },
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "url": {
                "$computed": "fmt",
                "args": {
                  "pattern": "mailto:{addr}",
                  "addr": {
                    "$item": "emailAddresses/0/address"
                  }
                }
              }
            }
          }
        }
      },
      "overlay": {
        "type": "Overlay",
        "props": {
          "maxWidth": "30rem"
        },
        "visible": {
          "$state": "/ui/selectedUpn"
        },
        "on": {
          "backdropClick": {
            "action": "setState",
            "params": {
              "statePath": "/ui/selectedUpn",
              "value": ""
            }
          }
        },
        "children": [
          "profileCard"
        ]
      },
      "profileCard": {
        "type": "Card",
        "children": [
          "profileHeader",
          "profileBody"
        ]
      },
      "profileHeader": {
        "type": "Header",
        "children": [
          "profileTitleRow",
          "profileClose"
        ]
      },
      "profileTitleRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center"
        },
        "children": [
          "profileAvatar",
          "profileNameStack"
        ]
      },
      "profileAvatar": {
        "type": "Avatar",
        "props": {
          "initials": {
            "$computed": "initials",
            "args": {
              "value": {
                "$state": "/m365-people/get_profile/displayName"
              }
            }
          },
          "size": "lg",
          "tone": "accent"
        }
      },
      "profileNameStack": {
        "type": "Stack",
        "props": {
          "gap": "xs",
          "grow": true
        },
        "children": [
          "profileName",
          "profileTitle"
        ]
      },
      "profileName": {
        "type": "Heading",
        "props": {
          "text": {
            "$state": "/m365-people/get_profile/displayName"
          },
          "level": "h2"
        }
      },
      "profileTitle": {
        "type": "Subtitle",
        "props": {
          "text": {
            "$state": "/m365-people/get_profile/jobTitle"
          }
        }
      },
      "profileClose": {
        "type": "IconButton",
        "props": {
          "icon": "X",
          "tone": "muted",
          "ariaLabel": "Close"
        },
        "on": {
          "click": {
            "action": "setState",
            "params": {
              "statePath": "/ui/selectedUpn",
              "value": ""
            }
          }
        }
      },
      "profileBody": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "visible": {
          "$state": "/m365-people/get_profile/userPrincipalName",
          "eq": {
            "$state": "/ui/selectedUpn"
          }
        },
        "children": [
          "kvDept",
          "kvOffice",
          "kvEmail",
          "divider",
          "actionsRow"
        ]
      },
      "kvDept": {
        "type": "KeyValue",
        "props": {
          "label": "Department",
          "value": {
            "$state": "/m365-people/get_profile/department"
          }
        }
      },
      "kvOffice": {
        "type": "KeyValue",
        "props": {
          "label": "Office",
          "value": {
            "$state": "/m365-people/get_profile/officeLocation"
          }
        }
      },
      "kvEmail": {
        "type": "KeyValue",
        "props": {
          "label": "Email",
          "value": {
            "$state": "/m365-people/get_profile/userPrincipalName"
          }
        }
      },
      "divider": {
        "type": "Divider"
      },
      "actionsRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "justify": "end"
        },
        "children": [
          "copyEmailBtn",
          "mailProfileBtn"
        ]
      },
      "copyEmailBtn": {
        "type": "Button",
        "props": {
          "label": "Copy email",
          "variant": "ghost",
          "size": "sm",
          "leadingIcon": "Copy"
        },
        "on": {
          "click": {
            "action": "copy_to_clipboard",
            "params": {
              "text": {
                "$state": "/m365-people/get_profile/userPrincipalName"
              }
            }
          }
        }
      },
      "mailProfileBtn": {
        "type": "Button",
        "props": {
          "label": "Email",
          "variant": "primary",
          "size": "sm",
          "leadingIcon": "Mail"
        },
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "url": {
                "$computed": "fmt",
                "args": {
                  "pattern": "mailto:{a}",
                  "a": {
                    "$state": "/m365-people/get_profile/userPrincipalName"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "status": "draft"
}
