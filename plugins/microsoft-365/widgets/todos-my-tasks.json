{
  "id": "todos-my-tasks",
  "title": "My WorkQ",
  "description": "Personal WorkQ \u2014 add, complete, and manage your tasks from the dashboard.",
  "category": "productivity",
  "tags": [
    "todos",
    "tasks",
    "productivity",
    "personal"
  ],
  "keywords": [
    "todo",
    "task",
    "tasks",
    "reminder",
    "checklist",
    "action items"
  ],
  "connectorsUsed": [],
  "popularity": 0,
  "sizing": {
    "preferred": {
      "colSpan": 4,
      "rowSpan": 5
    },
    "min": {
      "colSpan": 4,
      "rowSpan": 5
    },
    "max": {
      "colSpan": 4,
      "rowSpan": 5
    }
  },
  "status": "published",
  "dataProvider": {
    "mcp": "todos",
    "tool": "list_todos",
    "params": {
      "sortBy": "smart"
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "children": [
          "header",
          "toolbar",
          "body",
          "overlay"
        ]
      },
      "toolbar": {
        "type": "Row",
        "props": {
          "gap": "xs",
          "align": "center"
        },
        "children": [
          "searchInput",
          "sortSmart",
          "sortDueDate",
          "sortPriority"
        ]
      },
      "searchInput": {
        "type": "TextInput",
        "props": {
          "value": {
            "$bindState": "/ui/searchQuery"
          },
          "placeholder": "Search\u2026",
          "size": "sm",
          "ariaLabel": "Search items"
        },
        "on": {
          "change": [
            {
              "action": "bust_tool_cache",
              "params": {
                "mcp": "todos",
                "tool": "list_todos"
              }
            },
            {
              "action": "todos.list_todos",
              "params": {
                "sortBy": {
                  "$state": "/ui/sortBy"
                },
                "search": {
                  "$state": "/ui/searchQuery"
                }
              }
            }
          ]
        }
      },
      "sortSmart": {
        "type": "IconButton",
        "props": {
          "icon": "Sparkles",
          "size": "sm",
          "ariaLabel": "Sort: Smart",
          "tone": {
            "$cond": {
              "$state": "/ui/sortBy",
              "eq": "smart"
            },
            "$then": "accent",
            "$else": "muted"
          }
        },
        "on": {
          "click": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/sortBy",
                "value": "smart"
              }
            },
            {
              "action": "bust_tool_cache",
              "params": {
                "mcp": "todos",
                "tool": "list_todos"
              }
            },
            {
              "action": "todos.list_todos",
              "params": {
                "sortBy": "smart",
                "search": {
                  "$state": "/ui/searchQuery"
                }
              }
            }
          ]
        }
      },
      "sortDueDate": {
        "type": "IconButton",
        "props": {
          "icon": "Calendar",
          "size": "sm",
          "ariaLabel": "Sort: Due date",
          "tone": {
            "$cond": {
              "$state": "/ui/sortBy",
              "eq": "due_date"
            },
            "$then": "accent",
            "$else": "muted"
          }
        },
        "on": {
          "click": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/sortBy",
                "value": "due_date"
              }
            },
            {
              "action": "bust_tool_cache",
              "params": {
                "mcp": "todos",
                "tool": "list_todos"
              }
            },
            {
              "action": "todos.list_todos",
              "params": {
                "sortBy": "due_date",
                "search": {
                  "$state": "/ui/searchQuery"
                }
              }
            }
          ]
        }
      },
      "sortPriority": {
        "type": "IconButton",
        "props": {
          "icon": "ArrowUpDown",
          "size": "sm",
          "ariaLabel": "Sort: Priority",
          "tone": {
            "$cond": {
              "$state": "/ui/sortBy",
              "eq": "priority"
            },
            "$then": "accent",
            "$else": "muted"
          }
        },
        "on": {
          "click": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/sortBy",
                "value": "priority"
              }
            },
            {
              "action": "bust_tool_cache",
              "params": {
                "mcp": "todos",
                "tool": "list_todos"
              }
            },
            {
              "action": "todos.list_todos",
              "params": {
                "sortBy": "priority",
                "search": {
                  "$state": "/ui/searchQuery"
                }
              }
            }
          ]
        }
      },
      "header": {
        "type": "Header",
        "children": [
          "titleGroup"
        ]
      },
      "titleGroup": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "start"
        },
        "children": [
          "titleIcon",
          "titleStack"
        ]
      },
      "titleStack": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "children": [
          "title",
          "openCount"
        ]
      },
      "titleIcon": {
        "type": "Icon",
        "props": {
          "name": "CheckSquare",
          "tone": "accent",
          "size": "sm"
        }
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "My WorkQueue",
          "level": "h2"
        }
      },
      "openCount": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{n} Active",
              "n": {
                "$computed": "count_where_neq",
                "args": {
                  "value": {
                    "$state": "/todos/list_todos/todos"
                  },
                  "whereField": "status",
                  "notEquals": "done"
                }
              }
            }
          }
        }
      },
      "body": {
        "type": "Body",
        "children": [
          "loading",
          "empty",
          "list",
          "showDoneSection",
          "completedList",
          "addSection"
        ]
      },
      "loading": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "s1",
          "s2",
          "s3"
        ],
        "visible": {
          "$and": [
            {
              "$state": "/_loading/todos.list_todos"
            },
            {
              "$state": "/todos/list_todos/todos/0",
              "not": true
            }
          ]
        }
      },
      "s1": {
        "type": "Skeleton",
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        }
      },
      "s2": {
        "type": "Skeleton",
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        }
      },
      "s3": {
        "type": "Skeleton",
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        }
      },
      "empty": {
        "type": "Empty",
        "props": {
          "message": "No open items. Add one below."
        },
        "visible": {
          "$and": [
            {
              "$state": "/_loading/todos.list_todos",
              "not": true
            },
            {
              "$state": "/todos/list_todos/todos/0",
              "not": true
            }
          ]
        }
      },
      "list": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "children": [
          "row"
        ],
        "repeat": {
          "statePath": "/todos/list_todos/todos",
          "key": "id"
        },
        "visible": {
          "$state": "/todos/list_todos/todos/0"
        }
      },
      "row": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center",
          "justify": "between",
          "hover": true,
          "clickable": true
        },
        "children": [
          "rowCheckbox",
          "rowLabels",
          "rowDetailBtn"
        ],
        "visible": {
          "$item": "status",
          "neq": "done"
        },
        "on": {
          "click": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/selectedTaskId",
                "value": {
                  "$computed": "identity",
                  "args": {
                    "value": {
                      "$item": "id"
                    }
                  }
                }
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/editStatus",
                "value": {
                  "$computed": "identity",
                  "args": {
                    "value": {
                      "$item": "status"
                    }
                  }
                }
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/editPriority",
                "value": {
                  "$computed": "identity",
                  "args": {
                    "value": {
                      "$item": "priority"
                    }
                  }
                }
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/editDueDate",
                "value": {
                  "$computed": "identity",
                  "args": {
                    "value": {
                      "$item": "dueDate"
                    }
                  }
                }
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/editTitle",
                "value": {
                  "$computed": "identity",
                  "args": {
                    "value": {
                      "$item": "title"
                    }
                  }
                }
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/editDescription",
                "value": {
                  "$computed": "identity",
                  "args": {
                    "value": {
                      "$item": "description"
                    }
                  }
                }
              }
            },
            {
              "action": "todos.get_todo",
              "params": {
                "id": {
                  "$computed": "identity",
                  "args": {
                    "value": {
                      "$item": "id"
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "rowCheckbox": {
        "type": "Checkbox",
        "props": {
          "checked": false,
          "ariaLabel": "Mark done",
          "disabled": {
            "$computed": "not",
            "args": {
              "value": {
                "$item": "canEdit"
              }
            }
          }
        },
        "on": {
          "toggle": [
            {
              "action": "list_update_by_id",
              "params": {
                "listPath": "/todos/list_todos/todos",
                "id": {
                  "$computed": "identity",
                  "args": {
                    "value": {
                      "$item": "id"
                    }
                  }
                },
                "changes": {
                  "status": "done"
                }
              }
            },
            {
              "action": "todos.update_todo",
              "params": {
                "id": {
                  "$computed": "identity",
                  "args": {
                    "value": {
                      "$item": "id"
                    }
                  }
                },
                "status": "done"
              }
            },
            {
              "action": "bust_tool_cache",
              "params": {
                "mcp": "todos",
                "tool": "list_todos"
              }
            }
          ]
        }
      },
      "rowLabels": {
        "type": "Stack",
        "props": {
          "gap": "xs",
          "grow": true
        },
        "children": [
          "rowTitle",
          "rowMeta"
        ]
      },
      "rowTitle": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "title"
          },
          "size": "sm",
          "weight": "medium",
          "truncate": true
        }
      },
      "rowMeta": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center"
        },
        "children": [
          "priorityBadge",
          "rowDue",
          "rowAssignees"
        ]
      },
      "rowAssignees": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "\ud83d\udc65 {names}",
              "names": {
                "$computed": "join_strings",
                "args": {
                  "value": {
                    "$item": "assigneeLabels"
                  },
                  "sep": ", "
                }
              }
            }
          },
          "tone": "muted"
        },
        "visible": {
          "$item": "assigneeLabels/0"
        }
      },
      "priorityBadge": {
        "type": "Badge",
        "props": {
          "text": {
            "$computed": "priority_label",
            "args": {
              "value": {
                "$item": "priority"
              }
            }
          },
          "tone": {
            "$computed": "todo_priority_tone",
            "args": {
              "value": {
                "$item": "priority"
              }
            }
          },
          "size": "xs"
        },
        "visible": {
          "$item": "priority",
          "neq": "medium"
        }
      },
      "rowDue": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "due_date_au",
            "args": {
              "value": {
                "$item": "dueDate"
              }
            }
          },
          "tone": {
            "$computed": "is_overdue",
            "args": {
              "value": {
                "$item": "dueDate"
              }
            }
          }
        },
        "visible": {
          "$item": "dueDate"
        }
      },
      "rowDetailBtn": {
        "type": "IconButton",
        "props": {
          "icon": "ChevronRight",
          "tone": "muted",
          "ariaLabel": "View details",
          "size": "sm"
        },
        "on": {
          "click": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/selectedTaskId",
                "value": {
                  "$computed": "identity",
                  "args": {
                    "value": {
                      "$item": "id"
                    }
                  }
                }
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/editStatus",
                "value": {
                  "$computed": "identity",
                  "args": {
                    "value": {
                      "$item": "status"
                    }
                  }
                }
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/editPriority",
                "value": {
                  "$computed": "identity",
                  "args": {
                    "value": {
                      "$item": "priority"
                    }
                  }
                }
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/editDueDate",
                "value": {
                  "$computed": "identity",
                  "args": {
                    "value": {
                      "$item": "dueDate"
                    }
                  }
                }
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/editTitle",
                "value": {
                  "$computed": "identity",
                  "args": {
                    "value": {
                      "$item": "title"
                    }
                  }
                }
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/editDescription",
                "value": {
                  "$computed": "identity",
                  "args": {
                    "value": {
                      "$item": "description"
                    }
                  }
                }
              }
            },
            {
              "action": "todos.get_todo",
              "params": {
                "id": {
                  "$computed": "identity",
                  "args": {
                    "value": {
                      "$item": "id"
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "completedList": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "children": [
          "completedRow"
        ],
        "repeat": {
          "statePath": "/todos/list_todos/todos",
          "key": "id"
        },
        "visible": {
          "$state": "/ui/showDone"
        }
      },
      "completedRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center",
          "justify": "between",
          "hover": true,
          "clickable": true
        },
        "children": [
          "completedCheckbox",
          "completedTitle",
          "completedDetailBtn"
        ],
        "visible": {
          "$item": "status",
          "eq": "done"
        },
        "on": {
          "click": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/selectedTaskId",
                "value": {
                  "$computed": "identity",
                  "args": {
                    "value": {
                      "$item": "id"
                    }
                  }
                }
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/editStatus",
                "value": {
                  "$computed": "identity",
                  "args": {
                    "value": {
                      "$item": "status"
                    }
                  }
                }
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/editPriority",
                "value": {
                  "$computed": "identity",
                  "args": {
                    "value": {
                      "$item": "priority"
                    }
                  }
                }
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/editDueDate",
                "value": {
                  "$computed": "identity",
                  "args": {
                    "value": {
                      "$item": "dueDate"
                    }
                  }
                }
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/editTitle",
                "value": {
                  "$computed": "identity",
                  "args": {
                    "value": {
                      "$item": "title"
                    }
                  }
                }
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/editDescription",
                "value": {
                  "$computed": "identity",
                  "args": {
                    "value": {
                      "$item": "description"
                    }
                  }
                }
              }
            },
            {
              "action": "todos.get_todo",
              "params": {
                "id": {
                  "$computed": "identity",
                  "args": {
                    "value": {
                      "$item": "id"
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "completedCheckbox": {
        "type": "Checkbox",
        "props": {
          "checked": true,
          "tone": "muted",
          "ariaLabel": "Mark as to do",
          "disabled": {
            "$computed": "not",
            "args": {
              "value": {
                "$item": "canEdit"
              }
            }
          }
        },
        "on": {
          "toggle": [
            {
              "action": "list_update_by_id",
              "params": {
                "listPath": "/todos/list_todos/todos",
                "id": {
                  "$computed": "identity",
                  "args": {
                    "value": {
                      "$item": "id"
                    }
                  }
                },
                "changes": {
                  "status": "not_started"
                }
              }
            },
            {
              "action": "todos.update_todo",
              "params": {
                "id": {
                  "$computed": "identity",
                  "args": {
                    "value": {
                      "$item": "id"
                    }
                  }
                },
                "status": "not_started"
              }
            },
            {
              "action": "bust_tool_cache",
              "params": {
                "mcp": "todos",
                "tool": "list_todos"
              }
            }
          ]
        }
      },
      "completedTitle": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "title"
          },
          "size": "sm",
          "weight": "medium",
          "tone": "muted",
          "truncate": true
        }
      },
      "completedDetailBtn": {
        "type": "IconButton",
        "props": {
          "icon": "ChevronRight",
          "tone": "muted",
          "ariaLabel": "View details",
          "size": "sm"
        },
        "on": {
          "click": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/selectedTaskId",
                "value": {
                  "$computed": "identity",
                  "args": {
                    "value": {
                      "$item": "id"
                    }
                  }
                }
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/editStatus",
                "value": {
                  "$computed": "identity",
                  "args": {
                    "value": {
                      "$item": "status"
                    }
                  }
                }
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/editPriority",
                "value": {
                  "$computed": "identity",
                  "args": {
                    "value": {
                      "$item": "priority"
                    }
                  }
                }
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/editDueDate",
                "value": {
                  "$computed": "identity",
                  "args": {
                    "value": {
                      "$item": "dueDate"
                    }
                  }
                }
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/editTitle",
                "value": {
                  "$computed": "identity",
                  "args": {
                    "value": {
                      "$item": "title"
                    }
                  }
                }
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/editDescription",
                "value": {
                  "$computed": "identity",
                  "args": {
                    "value": {
                      "$item": "description"
                    }
                  }
                }
              }
            },
            {
              "action": "todos.get_todo",
              "params": {
                "id": {
                  "$computed": "identity",
                  "args": {
                    "value": {
                      "$item": "id"
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "showDoneSection": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "children": [
          "showDoneDivider",
          "showDoneBtn",
          "hideDoneBtn"
        ],
        "visible": {
          "$state": "/_loading/todos.list_todos",
          "not": true
        }
      },
      "showDoneDivider": {
        "type": "Divider"
      },
      "showDoneBtn": {
        "type": "Button",
        "props": {
          "label": {
            "$computed": "fmt",
            "args": {
              "pattern": "Show {n} completed",
              "n": {
                "$computed": "count_where",
                "args": {
                  "value": {
                    "$state": "/todos/list_todos/todos"
                  },
                  "whereField": "status",
                  "equals": "done"
                }
              }
            }
          },
          "variant": "ghost",
          "size": "sm",
          "leadingIcon": "ChevronDown"
        },
        "visible": {
          "$state": "/ui/showDone",
          "not": true
        },
        "on": {
          "click": {
            "action": "setState",
            "params": {
              "statePath": "/ui/showDone",
              "value": true
            }
          }
        }
      },
      "hideDoneBtn": {
        "type": "Button",
        "props": {
          "label": "Hide completed",
          "variant": "ghost",
          "size": "sm",
          "leadingIcon": "ChevronUp"
        },
        "visible": {
          "$state": "/ui/showDone"
        },
        "on": {
          "click": {
            "action": "setState",
            "params": {
              "statePath": "/ui/showDone",
              "value": false
            }
          }
        }
      },
      "addSection": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "addDivider",
          "addRow",
          "addError"
        ]
      },
      "addDivider": {
        "type": "Divider"
      },
      "addRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center"
        },
        "children": [
          "addInput",
          "addBtn"
        ]
      },
      "addInput": {
        "type": "TextInput",
        "props": {
          "value": {
            "$bindState": "/ui/newTaskTitle"
          },
          "placeholder": "Add a ToDo\u2026"
        },
        "on": {
          "submit": [
            {
              "action": "setState",
              "params": {
                "statePath": "/_errors/todos.create_todo",
                "value": ""
              }
            },
            {
              "action": "todos.create_todo",
              "params": {
                "title": {
                  "$state": "/ui/newTaskTitle"
                },
                "scope": "user"
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/newTaskTitle",
                "value": {
                  "$cond": {
                    "$state": "/_errors/todos.create_todo"
                  },
                  "$then": {
                    "$state": "/ui/newTaskTitle"
                  },
                  "$else": ""
                }
              }
            },
            {
              "action": "bust_tool_cache",
              "params": {
                "mcp": "todos",
                "tool": "list_todos"
              }
            },
            {
              "action": "todos.list_todos",
              "params": {}
            }
          ]
        }
      },
      "addBtn": {
        "type": "Button",
        "props": {
          "label": "Add",
          "variant": "primary",
          "size": "sm",
          "leadingIcon": "Plus",
          "disabled": {
            "$cond": {
              "$state": "/ui/newTaskTitle"
            },
            "$then": false,
            "$else": true
          }
        },
        "on": {
          "click": [
            {
              "action": "setState",
              "params": {
                "statePath": "/_errors/todos.create_todo",
                "value": ""
              }
            },
            {
              "action": "todos.create_todo",
              "params": {
                "title": {
                  "$state": "/ui/newTaskTitle"
                },
                "scope": "user"
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/newTaskTitle",
                "value": {
                  "$cond": {
                    "$state": "/_errors/todos.create_todo"
                  },
                  "$then": {
                    "$state": "/ui/newTaskTitle"
                  },
                  "$else": ""
                }
              }
            },
            {
              "action": "bust_tool_cache",
              "params": {
                "mcp": "todos",
                "tool": "list_todos"
              }
            },
            {
              "action": "todos.list_todos",
              "params": {}
            }
          ]
        }
      },
      "addError": {
        "type": "Caption",
        "props": {
          "text": {
            "$state": "/_errors/todos.create_todo"
          },
          "tone": "destructive"
        },
        "visible": {
          "$state": "/_errors/todos.create_todo"
        }
      },
      "overlay": {
        "type": "Overlay",
        "props": {
          "maxWidth": "32rem"
        },
        "children": [
          "detailCard"
        ],
        "visible": {
          "$state": "/ui/selectedTaskId"
        },
        "on": {
          "backdropClick": {
            "action": "setState",
            "params": {
              "statePath": "/ui/selectedTaskId",
              "value": ""
            }
          }
        }
      },
      "detailCard": {
        "type": "Card",
        "children": [
          "detailClose",
          "detailHeader",
          "detailSpinner",
          "detailBody"
        ]
      },
      "detailHeader": {
        "type": "Header",
        "children": [
          "detailTitleInput"
        ]
      },
      "detailTitleInput": {
        "type": "TextInput",
        "props": {
          "value": {
            "$bindState": "/ui/editTitle"
          },
          "size": "lg",
          "borderless": true,
          "placeholder": "Untitled",
          "ariaLabel": "Item title",
          "disabled": {
            "$computed": "not",
            "args": {
              "value": {
                "$state": "/todos/get_todo/todo/canEdit"
              }
            }
          }
        }
      },
      "detailClose": {
        "type": "IconButton",
        "props": {
          "icon": "X",
          "tone": "destructive",
          "size": "md",
          "floating": true,
          "ariaLabel": "Close"
        },
        "on": {
          "click": {
            "action": "setState",
            "params": {
              "statePath": "/ui/selectedTaskId",
              "value": ""
            }
          }
        }
      },
      "detailSpinner": {
        "type": "Spinner",
        "props": {
          "label": "Loading\u2026"
        },
        "visible": {
          "$state": "/todos/get_todo/todo/id",
          "neq": {
            "$state": "/ui/selectedTaskId"
          }
        }
      },
      "detailBody": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "detailReadOnlyBanner",
          "detailAssigneesRow",
          "detailStatusFormRow",
          "detailPriorityFormRow",
          "detailDueFormRow",
          "detailDescriptionFormRow",
          "detailMetaRow",
          "detailDivider",
          "actionsRow",
          "detailErrorBanner"
        ],
        "visible": {
          "$state": "/todos/get_todo/todo/id",
          "eq": {
            "$state": "/ui/selectedTaskId"
          }
        }
      },
      "detailMetaRow": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "children": [
          "detailCreatedBy",
          "detailUpdatedBy"
        ]
      },
      "detailCreatedBy": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "Created by {who}",
              "who": {
                "$state": "/todos/get_todo/todo/createdByLabel"
              }
            }
          },
          "tone": "muted"
        },
        "visible": {
          "$state": "/todos/get_todo/todo/createdByLabel"
        }
      },
      "detailUpdatedBy": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "Updated by {who}",
              "who": {
                "$state": "/todos/get_todo/todo/updatedByLabel"
              }
            }
          },
          "tone": "muted"
        },
        "visible": {
          "$state": "/todos/get_todo/todo/updatedByLabel"
        }
      },
      "detailReadOnlyBanner": {
        "type": "Caption",
        "props": {
          "text": "Read-only \u2014 only the creator and assignees can edit this item.",
          "tone": "muted"
        },
        "visible": {
          "$computed": "not",
          "args": {
            "value": {
              "$state": "/todos/get_todo/todo/canEdit"
            }
          }
        }
      },
      "detailAssigneesRow": {
        "type": "FormRow",
        "props": {
          "label": "Assignees"
        },
        "children": [
          "detailAssigneesText"
        ],
        "visible": {
          "$state": "/todos/get_todo/todo/assigneeLabels/0"
        }
      },
      "detailAssigneesText": {
        "type": "Text",
        "props": {
          "text": {
            "$computed": "join_strings",
            "args": {
              "value": {
                "$state": "/todos/get_todo/todo/assigneeLabels"
              },
              "sep": ", "
            }
          },
          "size": "sm"
        }
      },
      "detailStatusFormRow": {
        "type": "FormRow",
        "props": {
          "label": "Status"
        },
        "children": [
          "detailStatusSelect"
        ]
      },
      "detailStatusSelect": {
        "type": "Select",
        "props": {
          "value": {
            "$bindState": "/ui/editStatus"
          },
          "options": [
            {
              "value": "not_started",
              "label": "Not Started"
            },
            {
              "value": "in_progress",
              "label": "In Progress"
            },
            {
              "value": "done",
              "label": "Done"
            }
          ],
          "size": "sm",
          "disabled": {
            "$computed": "not",
            "args": {
              "value": {
                "$state": "/todos/get_todo/todo/canEdit"
              }
            }
          }
        }
      },
      "detailPriorityFormRow": {
        "type": "FormRow",
        "props": {
          "label": "Priority"
        },
        "children": [
          "detailPrioritySelect"
        ]
      },
      "detailPrioritySelect": {
        "type": "Select",
        "props": {
          "value": {
            "$bindState": "/ui/editPriority"
          },
          "options": [
            {
              "value": "low",
              "label": "Low"
            },
            {
              "value": "medium",
              "label": "Medium"
            },
            {
              "value": "high",
              "label": "High"
            },
            {
              "value": "urgent",
              "label": "Urgent"
            }
          ],
          "size": "sm",
          "disabled": {
            "$computed": "not",
            "args": {
              "value": {
                "$state": "/todos/get_todo/todo/canEdit"
              }
            }
          }
        }
      },
      "detailDueFormRow": {
        "type": "FormRow",
        "props": {
          "label": "Due date"
        },
        "children": [
          "detailDueInput"
        ]
      },
      "detailDueInput": {
        "type": "DateInput",
        "props": {
          "value": {
            "$bindState": "/ui/editDueDate"
          },
          "size": "sm",
          "disabled": {
            "$computed": "not",
            "args": {
              "value": {
                "$state": "/todos/get_todo/todo/canEdit"
              }
            }
          }
        }
      },
      "detailDescriptionFormRow": {
        "type": "FormRow",
        "props": {
          "label": "Description"
        },
        "children": [
          "detailDescriptionInput"
        ]
      },
      "detailDescriptionInput": {
        "type": "TextInput",
        "props": {
          "value": {
            "$bindState": "/ui/editDescription"
          },
          "multiline": true,
          "rows": 3,
          "placeholder": "Add notes\u2026",
          "ariaLabel": "Item description",
          "disabled": {
            "$computed": "not",
            "args": {
              "value": {
                "$state": "/todos/get_todo/todo/canEdit"
              }
            }
          }
        }
      },
      "detailDivider": {
        "type": "Divider"
      },
      "actionsRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "justify": "end"
        },
        "children": [
          "deleteBtn",
          "saveBtn"
        ]
      },
      "saveBtn": {
        "type": "Button",
        "props": {
          "label": "Save changes",
          "variant": "primary",
          "size": "sm",
          "leadingIcon": "Save",
          "disabled": {
            "$computed": "not",
            "args": {
              "value": {
                "$state": "/todos/get_todo/todo/canEdit"
              }
            }
          }
        },
        "on": {
          "click": [
            {
              "action": "todos.update_todo",
              "params": {
                "id": {
                  "$state": "/ui/selectedTaskId"
                },
                "title": {
                  "$state": "/ui/editTitle"
                },
                "description": {
                  "$state": "/ui/editDescription"
                },
                "status": {
                  "$state": "/ui/editStatus"
                },
                "priority": {
                  "$state": "/ui/editPriority"
                },
                "dueDate": {
                  "$state": "/ui/editDueDate"
                }
              }
            },
            {
              "action": "bust_tool_cache",
              "params": {
                "mcp": "todos",
                "tool": "list_todos"
              }
            },
            {
              "action": "todos.list_todos",
              "params": {}
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/selectedTaskId",
                "value": ""
              }
            },
            {
              "action": "toast",
              "params": {
                "message": "Todo saved"
              }
            }
          ]
        }
      },
      "deleteBtn": {
        "type": "Button",
        "props": {
          "label": "Delete",
          "variant": "ghost",
          "size": "sm",
          "leadingIcon": "Trash2"
        },
        "visible": {
          "$state": "/todos/get_todo/todo/canDelete"
        },
        "on": {
          "click": [
            {
              "action": "todos.delete_todo",
              "params": {
                "id": {
                  "$state": "/ui/selectedTaskId"
                }
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/selectedTaskId",
                "value": ""
              }
            },
            {
              "action": "bust_tool_cache",
              "params": {
                "mcp": "todos",
                "tool": "list_todos"
              }
            },
            {
              "action": "todos.list_todos",
              "params": {}
            }
          ]
        }
      },
      "detailErrorBanner": {
        "type": "Caption",
        "props": {
          "text": {
            "$state": "/_errors/todos.update_todo"
          },
          "tone": "destructive"
        },
        "visible": {
          "$state": "/_errors/todos.update_todo"
        }
      }
    }
  }
}
