{
  "id": "m365-daily-briefing",
  "title": "Daily Briefing",
  "description": "Morning digest: unread emails, today's meetings, and recent files — all in one glance.",
  "category": "productivity",
  "tags": [
    "m365",
    "briefing",
    "daily",
    "digest",
    "overview"
  ],
  "keywords": [
    "daily",
    "briefing",
    "morning",
    "digest",
    "overview",
    "start"
  ],
  "connectorsUsed": [
    "m365-calendar",
    "m365-files",
    "m365-mail-read"
  ],
  "popularity": 88,
  "sizing": {
    "preferred": {
      "colSpan": 8,
      "rowSpan": 8
    },
    "min": {
      "colSpan": 6,
      "rowSpan": 6
    },
    "max": {
      "colSpan": 16,
      "rowSpan": 14
    }
  },
  "dataProvider": {
    "mcp": "m365-mail-read",
    "tool": "list_emails",
    "params": {
      "limit": 10
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "children": [
          "header",
          "body",
          "emailOverlay",
          "eventOverlay",
          "fileOverlay"
        ],
        "watch": {
          "/m365-mail-read/list_emails": [
            {
              "action": "m365-calendar.list_events",
              "params": {
                "startDateTime": "$today",
                "endDateTime": "$today_end",
                "limit": 10
              }
            },
            {
              "action": "m365-files.list_recent_files",
              "params": {
                "limit": 5
              }
            }
          ],
          "/m365-calendar/list_events": {
            "action": "setState",
            "params": {
              "statePath": "/ui/todayEvents",
              "value": {
                "$computed": "filter_date_range",
                "args": {
                  "value": {
                    "$state": "/m365-calendar/list_events"
                  },
                  "field": "start.dateTime"
                }
              }
            }
          }
        }
      },
      "header": {
        "type": "Header",
        "children": [
          "titleRow",
          "refreshBtn"
        ]
      },
      "titleRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center"
        },
        "children": [
          "titleIcon",
          "title"
        ]
      },
      "titleIcon": {
        "type": "Icon",
        "props": {
          "name": "Sunrise",
          "tone": "warning",
          "size": "sm"
        }
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "Daily Briefing",
          "level": "h2"
        }
      },
      "refreshBtn": {
        "type": "IconButton",
        "props": {
          "icon": "RefreshCw",
          "tone": "muted",
          "ariaLabel": "Refresh"
        },
        "on": {
          "click": [
            {
              "action": "m365-mail-read.list_emails",
              "params": {
                "limit": 10
              }
            },
            {
              "action": "m365-calendar.list_events",
              "params": {
                "startDateTime": "$today",
                "endDateTime": "$today_end",
                "limit": 10
              }
            },
            {
              "action": "m365-files.list_recent_files",
              "params": {
                "limit": 5
              }
            }
          ]
        }
      },
      "body": {
        "type": "Body",
        "children": [
          "bodyInner"
        ]
      },
      "bodyInner": {
        "type": "Stack",
        "props": {
          "gap": "md"
        },
        "children": [
          "statsRow",
          "divider1",
          "mailSection",
          "divider2",
          "calSection",
          "divider3",
          "filesSection"
        ]
      },
      "statsRow": {
        "type": "Grid",
        "props": {
          "cols": 3,
          "gap": "md"
        },
        "children": [
          "statMail",
          "statCal",
          "statFiles"
        ]
      },
      "statMail": {
        "type": "Stack",
        "props": {
          "gap": "xs",
          "align": "center"
        },
        "children": [
          "statMailEyebrow",
          "statMailValue"
        ]
      },
      "statMailEyebrow": {
        "type": "Eyebrow",
        "props": {
          "text": "Unread"
        }
      },
      "statMailValue": {
        "type": "Stat",
        "props": {
          "value": {
            "$computed": "count_where",
            "args": {
              "value": {
                "$state": "/m365-mail-read/list_emails"
              },
              "whereField": "isRead",
              "equals": false
            }
          },
          "tone": "accent"
        }
      },
      "statCal": {
        "type": "Stack",
        "props": {
          "gap": "xs",
          "align": "center"
        },
        "children": [
          "statCalEyebrow",
          "statCalValue"
        ]
      },
      "statCalEyebrow": {
        "type": "Eyebrow",
        "props": {
          "text": "Meetings"
        }
      },
      "statCalValue": {
        "type": "Stat",
        "props": {
          "value": {
            "$computed": "count",
            "args": {
              "value": {
                "$state": "/ui/todayEvents"
              }
            }
          },
          "tone": "accent"
        }
      },
      "statFiles": {
        "type": "Stack",
        "props": {
          "gap": "xs",
          "align": "center"
        },
        "children": [
          "statFilesEyebrow",
          "statFilesValue"
        ]
      },
      "statFilesEyebrow": {
        "type": "Eyebrow",
        "props": {
          "text": "Recent files"
        }
      },
      "statFilesValue": {
        "type": "Stat",
        "props": {
          "value": {
            "$computed": "count",
            "args": {
              "value": {
                "$state": "/m365-files/list_recent_files"
              }
            }
          },
          "tone": "accent"
        }
      },
      "divider1": {
        "type": "Divider"
      },
      "mailSection": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "mailHead",
          "mailList"
        ]
      },
      "mailHead": {
        "type": "Heading",
        "props": {
          "text": "Inbox",
          "level": "h3"
        }
      },
      "mailList": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "children": [
          "mailRow"
        ],
        "repeat": {
          "statePath": "/m365-mail-read/list_emails",
          "key": "id"
        }
      },
      "mailRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "start",
          "hover": true,
          "clickable": true
        },
        "children": [
          "mailDot",
          "mailLabels",
          "mailAge"
        ],
        "on": {
          "click": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/selectedEmailId",
                "value": {
                  "$computed": "identity",
                  "args": {
                    "value": {
                      "$item": "id"
                    }
                  }
                }
              }
            },
            {
              "action": "m365-mail-read.get_email",
              "params": {
                "id": {
                  "$computed": "identity",
                  "args": {
                    "value": {
                      "$item": "id"
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "mailDot": {
        "type": "Dot",
        "props": {
          "tone": {
            "$cond": {
              "$item": "isRead"
            },
            "$then": "muted",
            "$else": "accent"
          },
          "size": "sm"
        }
      },
      "mailLabels": {
        "type": "Stack",
        "props": {
          "gap": "xs",
          "grow": true
        },
        "children": [
          "mailSubject",
          "mailFrom"
        ]
      },
      "mailSubject": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "subject"
          },
          "size": "sm",
          "weight": "medium",
          "truncate": true
        }
      },
      "mailFrom": {
        "type": "Caption",
        "props": {
          "text": {
            "$item": "from/emailAddress/name"
          }
        }
      },
      "mailAge": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "relative_time",
            "args": {
              "value": {
                "$item": "receivedDateTime"
              }
            }
          }
        }
      },
      "divider2": {
        "type": "Divider"
      },
      "calSection": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "calHead",
          "calList"
        ]
      },
      "calHead": {
        "type": "Heading",
        "props": {
          "text": "Today's meetings",
          "level": "h3"
        }
      },
      "calList": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "children": [
          "calRow"
        ],
        "repeat": {
          "statePath": "/ui/todayEvents",
          "key": "id"
        }
      },
      "calRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "start",
          "hover": true,
          "clickable": true
        },
        "children": [
          "calWhen",
          "calLabels"
        ],
        "on": {
          "click": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/selectedEventId",
                "value": {
                  "$computed": "identity",
                  "args": {
                    "value": {
                      "$item": "id"
                    }
                  }
                }
              }
            },
            {
              "action": "m365-calendar.get_event",
              "params": {
                "id": {
                  "$computed": "identity",
                  "args": {
                    "value": {
                      "$item": "id"
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "calWhen": {
        "type": "Badge",
        "props": {
          "text": {
            "$computed": "relative_time",
            "args": {
              "value": {
                "$item": "start/dateTime"
              }
            }
          },
          "tone": "accent",
          "variant": "soft"
        }
      },
      "calLabels": {
        "type": "Stack",
        "props": {
          "gap": "xs",
          "grow": true
        },
        "children": [
          "calSubject",
          "calLoc"
        ]
      },
      "calSubject": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "subject"
          },
          "size": "sm",
          "weight": "medium",
          "truncate": true
        }
      },
      "calLoc": {
        "type": "Caption",
        "props": {
          "text": {
            "$item": "location/displayName"
          }
        }
      },
      "divider3": {
        "type": "Divider"
      },
      "filesSection": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "filesHead",
          "filesList"
        ]
      },
      "filesHead": {
        "type": "Heading",
        "props": {
          "text": "Recent files",
          "level": "h3"
        }
      },
      "filesList": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "children": [
          "filesRow"
        ],
        "repeat": {
          "statePath": "/m365-files/list_recent_files",
          "key": "id"
        }
      },
      "filesRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "start",
          "hover": true,
          "clickable": true
        },
        "children": [
          "fIcon",
          "fLabels"
        ],
        "on": {
          "click": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/selectedFileId",
                "value": {
                  "$computed": "identity",
                  "args": {
                    "value": {
                      "$item": "id"
                    }
                  }
                }
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/selectedFileName",
                "value": {
                  "$computed": "identity",
                  "args": {
                    "value": {
                      "$item": "name"
                    }
                  }
                }
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/selectedFileWebUrl",
                "value": {
                  "$computed": "identity",
                  "args": {
                    "value": {
                      "$item": "webUrl"
                    }
                  }
                }
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/selectedFileSize",
                "value": {
                  "$computed": "identity",
                  "args": {
                    "value": {
                      "$item": "size"
                    }
                  }
                }
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/selectedFileMod",
                "value": {
                  "$computed": "identity",
                  "args": {
                    "value": {
                      "$item": "lastModifiedDateTime"
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "fIcon": {
        "type": "Icon",
        "props": {
          "name": "FileText",
          "tone": "muted",
          "size": "sm"
        }
      },
      "fLabels": {
        "type": "Stack",
        "props": {
          "gap": "xs",
          "grow": true
        },
        "children": [
          "fName",
          "fMod"
        ]
      },
      "fName": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "name"
          },
          "size": "sm",
          "weight": "medium",
          "truncate": true
        }
      },
      "fMod": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "relative_time",
            "args": {
              "value": {
                "$item": "lastModifiedDateTime"
              }
            }
          }
        }
      },
      "emailOverlay": {
        "type": "Overlay",
        "props": {
          "maxWidth": "44rem"
        },
        "children": [
          "emailDetailCard"
        ],
        "visible": {
          "$state": "/ui/selectedEmailId"
        },
        "on": {
          "backdropClick": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/selectedEmailId",
                "value": ""
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/replyText",
                "value": ""
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/replySent",
                "value": ""
              }
            }
          ]
        }
      },
      "emailDetailCard": {
        "type": "Card",
        "children": [
          "emailDetailHeader",
          "emailDetailSpinner",
          "emailDetailBody"
        ]
      },
      "emailDetailHeader": {
        "type": "Header",
        "children": [
          "emailDetailTitle",
          "emailDetailClose"
        ]
      },
      "emailDetailTitle": {
        "type": "Heading",
        "props": {
          "text": {
            "$state": "/m365-mail-read/get_email/subject"
          },
          "level": "h2"
        }
      },
      "emailDetailClose": {
        "type": "IconButton",
        "props": {
          "icon": "X",
          "tone": "muted",
          "ariaLabel": "Close"
        },
        "on": {
          "click": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/selectedEmailId",
                "value": ""
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/replyText",
                "value": ""
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/replySent",
                "value": ""
              }
            }
          ]
        }
      },
      "emailDetailSpinner": {
        "type": "Spinner",
        "props": {
          "label": "Loading message…"
        },
        "visible": {
          "$state": "/m365-mail-read/get_email/id",
          "neq": {
            "$state": "/ui/selectedEmailId"
          }
        }
      },
      "emailDetailBody": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "emailKvFrom",
          "emailKvReceived",
          "emailBodySection",
          "emailDivider",
          "emailReplyRow",
          "emailReplyActions",
          "emailReplySentBanner",
          "emailReplyErrorBanner",
          "emailActions"
        ],
        "visible": {
          "$state": "/m365-mail-read/get_email/id",
          "eq": {
            "$state": "/ui/selectedEmailId"
          }
        }
      },
      "emailKvFrom": {
        "type": "KeyValue",
        "props": {
          "label": "From",
          "value": {
            "$computed": "fmt",
            "args": {
              "pattern": "{name} <{addr}>",
              "name": {
                "$state": "/m365-mail-read/get_email/from/emailAddress/name"
              },
              "addr": {
                "$state": "/m365-mail-read/get_email/from/emailAddress/address"
              }
            }
          }
        }
      },
      "emailKvReceived": {
        "type": "KeyValue",
        "props": {
          "label": "Received",
          "value": {
            "$computed": "relative_time",
            "args": {
              "value": {
                "$state": "/m365-mail-read/get_email/receivedDateTime"
              }
            }
          }
        }
      },
      "emailBodySection": {
        "type": "Section",
        "props": {
          "variant": "muted"
        },
        "children": [
          "emailBodyHtml"
        ]
      },
      "emailBodyHtml": {
        "type": "RichHtml",
        "props": {
          "html": {
            "$state": "/m365-mail-read/get_email/body/content"
          },
          "minHeight": 120,
          "maxHeight": 420
        }
      },
      "emailDivider": {
        "type": "Divider"
      },
      "emailReplyRow": {
        "type": "FormRow",
        "props": {
          "label": "Reply",
          "hint": "Plain text"
        },
        "children": [
          "emailReplyInput"
        ]
      },
      "emailReplyInput": {
        "type": "TextInput",
        "props": {
          "value": {
            "$bindState": "/ui/replyText"
          },
          "placeholder": "Type your reply…"
        }
      },
      "emailReplyActions": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "justify": "end"
        },
        "children": [
          "emailDeleteBtn",
          "emailReplyBtn"
        ]
      },
      "emailDeleteBtn": {
        "type": "Button",
        "props": {
          "label": "Delete",
          "variant": "ghost",
          "size": "sm",
          "leadingIcon": "Trash2"
        },
        "on": {
          "click": [
            {
              "action": "m365-mail-send.delete_email",
              "params": {
                "id": {
                  "$state": "/ui/selectedEmailId"
                }
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/selectedEmailId",
                "value": ""
              }
            },
            {
              "action": "m365-mail-read.list_emails",
              "params": {
                "limit": 10
              }
            }
          ]
        }
      },
      "emailReplyBtn": {
        "type": "Button",
        "props": {
          "label": "Send reply",
          "variant": "primary",
          "size": "sm",
          "leadingIcon": "Send"
        },
        "on": {
          "click": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/replySent",
                "value": ""
              }
            },
            {
              "action": "m365-mail-send.reply_to_email",
              "params": {
                "id": {
                  "$state": "/ui/selectedEmailId"
                },
                "comment": {
                  "$state": "/ui/replyText"
                }
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/replySent",
                "value": {
                  "$cond": {
                    "$state": "/_errors/m365-mail-send.reply_to_email"
                  },
                  "$then": "",
                  "$else": true
                }
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/replyText",
                "value": {
                  "$cond": {
                    "$state": "/_errors/m365-mail-send.reply_to_email"
                  },
                  "$then": {
                    "$state": "/ui/replyText"
                  },
                  "$else": ""
                }
              }
            }
          ]
        }
      },
      "emailReplySentBanner": {
        "type": "Section",
        "props": {
          "variant": "muted"
        },
        "children": [
          "emailReplySentRow"
        ],
        "visible": {
          "$state": "/ui/replySent"
        }
      },
      "emailReplySentRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center"
        },
        "children": [
          "emailReplySentIcon",
          "emailReplySentText"
        ]
      },
      "emailReplySentIcon": {
        "type": "Icon",
        "props": {
          "name": "CheckCircle2",
          "tone": "success",
          "size": "sm"
        }
      },
      "emailReplySentText": {
        "type": "Text",
        "props": {
          "text": "Reply sent.",
          "size": "sm",
          "tone": "success"
        }
      },
      "emailReplyErrorBanner": {
        "type": "Section",
        "props": {
          "variant": "bordered"
        },
        "children": [
          "emailReplyErrorRow"
        ],
        "visible": {
          "$state": "/_errors/m365-mail-send.reply_to_email"
        }
      },
      "emailReplyErrorRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center"
        },
        "children": [
          "emailReplyErrorIcon",
          "emailReplyErrorText"
        ]
      },
      "emailReplyErrorIcon": {
        "type": "Icon",
        "props": {
          "name": "AlertTriangle",
          "tone": "destructive",
          "size": "sm"
        }
      },
      "emailReplyErrorText": {
        "type": "Text",
        "props": {
          "text": {
            "$state": "/_errors/m365-mail-send.reply_to_email"
          },
          "size": "sm",
          "tone": "destructive"
        }
      },
      "emailActions": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "justify": "end"
        },
        "children": [
          "emailOpenBtn"
        ]
      },
      "emailOpenBtn": {
        "type": "Button",
        "props": {
          "label": "Open in Outlook",
          "variant": "primary",
          "size": "sm",
          "leadingIcon": "ExternalLink"
        },
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "url": {
                "$computed": "fmt",
                "args": {
                  "pattern": "https://outlook.office.com/mail/inbox/id/{id}",
                  "id": {
                    "$state": "/ui/selectedEmailId"
                  }
                }
              }
            }
          }
        }
      },
      "eventOverlay": {
        "type": "Overlay",
        "props": {
          "maxWidth": "44rem"
        },
        "children": [
          "eventDetailCard"
        ],
        "visible": {
          "$state": "/ui/selectedEventId"
        },
        "on": {
          "backdropClick": {
            "action": "setState",
            "params": {
              "statePath": "/ui/selectedEventId",
              "value": ""
            }
          }
        }
      },
      "eventDetailCard": {
        "type": "Card",
        "children": [
          "eventDetailHeader",
          "eventDetailSpinner",
          "eventDetailBody"
        ]
      },
      "eventDetailHeader": {
        "type": "Header",
        "children": [
          "eventDetailTitle",
          "eventDetailClose"
        ]
      },
      "eventDetailTitle": {
        "type": "Heading",
        "props": {
          "text": {
            "$state": "/m365-calendar/get_event/subject"
          },
          "level": "h2"
        }
      },
      "eventDetailClose": {
        "type": "IconButton",
        "props": {
          "icon": "X",
          "tone": "muted",
          "ariaLabel": "Close"
        },
        "on": {
          "click": {
            "action": "setState",
            "params": {
              "statePath": "/ui/selectedEventId",
              "value": ""
            }
          }
        }
      },
      "eventDetailSpinner": {
        "type": "Spinner",
        "props": {
          "label": "Loading event…"
        },
        "visible": {
          "$state": "/m365-calendar/get_event/id",
          "neq": {
            "$state": "/ui/selectedEventId"
          }
        }
      },
      "eventDetailBody": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "eventKvWhen",
          "eventKvLocation",
          "eventKvOrganizer",
          "eventBodySection",
          "eventActions"
        ],
        "visible": {
          "$state": "/m365-calendar/get_event/id",
          "eq": {
            "$state": "/ui/selectedEventId"
          }
        }
      },
      "eventKvWhen": {
        "type": "KeyValue",
        "props": {
          "label": "When",
          "value": {
            "$computed": "format_date",
            "args": {
              "value": {
                "$state": "/m365-calendar/get_event/start/dateTime"
              },
              "format": "long"
            }
          }
        }
      },
      "eventKvLocation": {
        "type": "KeyValue",
        "props": {
          "label": "Location",
          "value": {
            "$state": "/m365-calendar/get_event/location/displayName"
          }
        },
        "visible": {
          "$state": "/m365-calendar/get_event/location/displayName"
        }
      },
      "eventKvOrganizer": {
        "type": "KeyValue",
        "props": {
          "label": "Organiser",
          "value": {
            "$state": "/m365-calendar/get_event/organizer/emailAddress/name"
          }
        }
      },
      "eventBodySection": {
        "type": "Section",
        "props": {
          "variant": "muted"
        },
        "children": [
          "eventBodyHtml"
        ],
        "visible": {
          "$state": "/m365-calendar/get_event/body/content"
        }
      },
      "eventBodyHtml": {
        "type": "RichHtml",
        "props": {
          "html": {
            "$state": "/m365-calendar/get_event/body/content"
          },
          "minHeight": 80,
          "maxHeight": 360
        }
      },
      "eventActions": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "justify": "end"
        },
        "children": [
          "eventOpenBtn"
        ]
      },
      "eventOpenBtn": {
        "type": "Button",
        "props": {
          "label": "Open in Outlook",
          "variant": "primary",
          "size": "sm",
          "leadingIcon": "ExternalLink"
        },
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "url": "https://outlook.office.com/calendar/view/day"
            }
          }
        }
      },
      "fileOverlay": {
        "type": "Overlay",
        "props": {
          "maxWidth": "36rem"
        },
        "children": [
          "fileDetailCard"
        ],
        "visible": {
          "$state": "/ui/selectedFileId"
        },
        "on": {
          "backdropClick": {
            "action": "setState",
            "params": {
              "statePath": "/ui/selectedFileId",
              "value": ""
            }
          }
        }
      },
      "fileDetailCard": {
        "type": "Card",
        "children": [
          "fileDetailHeader",
          "fileDetailBody"
        ]
      },
      "fileDetailHeader": {
        "type": "Header",
        "children": [
          "fileDetailTitle",
          "fileDetailClose"
        ]
      },
      "fileDetailTitle": {
        "type": "Heading",
        "props": {
          "text": {
            "$state": "/ui/selectedFileName"
          },
          "level": "h2"
        }
      },
      "fileDetailClose": {
        "type": "IconButton",
        "props": {
          "icon": "X",
          "tone": "muted",
          "ariaLabel": "Close"
        },
        "on": {
          "click": {
            "action": "setState",
            "params": {
              "statePath": "/ui/selectedFileId",
              "value": ""
            }
          }
        }
      },
      "fileDetailBody": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "fileKvModified",
          "fileKvSize",
          "fileActions"
        ]
      },
      "fileKvModified": {
        "type": "KeyValue",
        "props": {
          "label": "Modified",
          "value": {
            "$computed": "relative_time",
            "args": {
              "value": {
                "$state": "/ui/selectedFileMod"
              }
            }
          }
        }
      },
      "fileKvSize": {
        "type": "KeyValue",
        "props": {
          "label": "Size",
          "value": {
            "$state": "/ui/selectedFileSize"
          }
        },
        "visible": {
          "$state": "/ui/selectedFileSize"
        }
      },
      "fileActions": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "justify": "end"
        },
        "children": [
          "fileOpenBtn"
        ]
      },
      "fileOpenBtn": {
        "type": "Button",
        "props": {
          "label": "Open file",
          "variant": "primary",
          "size": "sm",
          "leadingIcon": "ExternalLink"
        },
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "url": {
                "$state": "/ui/selectedFileWebUrl"
              }
            }
          }
        }
      }
    }
  },
  "status": "published"
}
