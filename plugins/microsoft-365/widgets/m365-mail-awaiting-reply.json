{
  "id": "m365-mail-awaiting-reply",
  "title": "Awaiting Reply",
  "description": "Emails where you're the last recipient and haven't responded yet. Click to compose a reply inline.",
  "category": "productivity",
  "tags": [
    "m365",
    "email",
    "outlook",
    "followup",
    "productivity"
  ],
  "keywords": [
    "awaiting",
    "reply",
    "followup",
    "unread",
    "pending"
  ],
  "connectorsUsed": [
    "m365-mail-read",
    "m365-mail-send"
  ],
  "popularity": 0,
  "sizing": {
    "preferred": {
      "colSpan": 6,
      "rowSpan": 5
    },
    "min": {
      "colSpan": 4,
      "rowSpan": 4
    },
    "max": {
      "colSpan": 12,
      "rowSpan": 12
    }
  },
  "dataProvider": {
    "mcp": "m365-mail-read",
    "tool": "list_emails",
    "params": {
      "limit": 30
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "children": [
          "header",
          "body",
          "overlay"
        ]
      },
      "header": {
        "type": "Header",
        "children": [
          "titleRow"
        ]
      },
      "titleRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "start"
        },
        "children": [
          "titleIcon",
          "titleStack"
        ]
      },
      "titleIcon": {
        "type": "Icon",
        "props": {
          "name": "ReplyAll",
          "tone": "warning",
          "size": "sm"
        }
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "Awaiting My Reply",
          "level": "h2"
        }
      },
      "count": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{n} Pending",
              "n": {
                "$computed": "count_where",
                "args": {
                  "value": {
                    "$state": "/m365-mail-read/list_emails"
                  },
                  "whereField": "isRead",
                  "equals": false
                }
              }
            }
          }
        }
      },
      "body": {
        "type": "Body",
        "children": [
          "loading",
          "empty",
          "list"
        ]
      },
      "loading": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "sk1",
          "sk2",
          "sk3"
        ],
        "visible": {
          "$state": "/_loading/m365-mail-read.list_emails"
        }
      },
      "sk1": {
        "type": "Skeleton",
        "props": {
          "height": "2.75rem",
          "rounded": "md"
        }
      },
      "sk2": {
        "type": "Skeleton",
        "props": {
          "height": "2.75rem",
          "rounded": "md"
        }
      },
      "sk3": {
        "type": "Skeleton",
        "props": {
          "height": "2.75rem",
          "rounded": "md"
        }
      },
      "empty": {
        "type": "Empty",
        "props": {
          "message": "Nothing waiting for your reply. "
        },
        "visible": {
          "$and": [
            {
              "$state": "/_loading/m365-mail-read.list_emails",
              "not": true
            },
            {
              "$state": "/m365-mail-read/list_emails/0",
              "not": true
            }
          ]
        }
      },
      "list": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "children": [
          "row"
        ],
        "repeat": {
          "statePath": "/m365-mail-read/list_emails",
          "key": "id"
        },
        "visible": {
          "$state": "/_loading/m365-mail-read.list_emails",
          "not": true
        }
      },
      "row": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "start",
          "hover": true,
          "clickable": true,
          "justify": "between"
        },
        "children": [
          "avatar",
          "labels",
          "age"
        ],
        "visible": {
          "$item": "isRead",
          "eq": false
        },
        "on": {
          "click": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/selectedEmailId",
                "value": {
                  "$computed": "identity",
                  "args": {
                    "value": {
                      "$item": "id"
                    }
                  }
                }
              }
            },
            {
              "action": "m365-mail-read.get_email",
              "params": {
                "id": {
                  "$computed": "identity",
                  "args": {
                    "value": {
                      "$item": "id"
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "avatar": {
        "type": "Avatar",
        "props": {
          "initials": {
            "$computed": "initials",
            "args": {
              "value": {
                "$item": "from/emailAddress/name"
              }
            }
          },
          "size": "sm"
        }
      },
      "labels": {
        "type": "Stack",
        "props": {
          "gap": "xs",
          "grow": true
        },
        "children": [
          "labelTop",
          "labelBottom"
        ]
      },
      "labelTop": {
        "type": "Text",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{n} \u00b7 {s}",
              "n": {
                "$item": "from/emailAddress/name"
              },
              "s": {
                "$item": "subject"
              }
            }
          },
          "size": "md",
          "weight": "medium",
          "truncate": true
        }
      },
      "labelBottom": {
        "type": "Text",
        "props": {
          "size": "sm",
          "tone": "muted",
          "text": {
            "$computed": "email_preview",
            "args": {
              "value": {
                "$item": "bodyPreview"
              },
              "maxLength": 140
            }
          }
        }
      },
      "age": {
        "type": "Badge",
        "props": {
          "text": {
            "$computed": "relative_time",
            "args": {
              "value": {
                "$item": "receivedDateTime"
              }
            }
          },
          "tone": "warning",
          "variant": "soft"
        }
      },
      "overlay": {
        "type": "Overlay",
        "props": {
          "maxWidth": "34rem"
        },
        "children": [
          "detailCard"
        ],
        "visible": {
          "$state": "/ui/selectedEmailId"
        },
        "on": {
          "backdropClick": {
            "action": "setState",
            "params": {
              "statePath": "/ui/selectedEmailId",
              "value": ""
            }
          }
        }
      },
      "detailCard": {
        "type": "Card",
        "children": [
          "detailHeader",
          "detailBody"
        ]
      },
      "detailHeader": {
        "type": "Row",
        "children": [
          "detailTitle",
          "detailClose"
        ],
        "props": {
          "gap": "sm",
          "align": "center",
          "justify": "between"
        }
      },
      "detailTitle": {
        "type": "Heading",
        "props": {
          "text": {
            "$state": "/m365-mail-read/get_email/subject"
          },
          "level": "h2"
        }
      },
      "detailClose": {
        "type": "IconButton",
        "props": {
          "icon": "X",
          "tone": "default",
          "ariaLabel": "Close",
          "size": "md",
          "variant": "outlined"
        },
        "on": {
          "click": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/selectedEmailId",
                "value": ""
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/replyText",
                "value": ""
              }
            }
          ]
        }
      },
      "detailBody": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "kvFrom",
          "bodyPreview",
          "actions"
        ],
        "visible": {
          "$state": "/m365-mail-read/get_email/id",
          "eq": {
            "$state": "/ui/selectedEmailId"
          }
        }
      },
      "kvFrom": {
        "type": "KeyValue",
        "props": {
          "label": "From",
          "value": {
            "$computed": "fmt",
            "args": {
              "pattern": "{name} <{addr}>",
              "name": {
                "$state": "/m365-mail-read/get_email/from/emailAddress/name"
              },
              "addr": {
                "$state": "/m365-mail-read/get_email/from/emailAddress/address"
              }
            }
          }
        }
      },
      "bodyPreview": {
        "type": "Section",
        "props": {
          "variant": "muted"
        },
        "children": [
          "bodyText"
        ]
      },
      "bodyText": {
        "type": "Text",
        "props": {
          "text": {
            "$state": "/m365-mail-read/get_email/bodyPreview"
          },
          "size": "sm"
        }
      },
      "titleStack": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "children": [
          "title",
          "count"
        ]
      },
      "openBtn": {
        "type": "Button",
        "props": {
          "label": "Open in Outlook",
          "variant": "primary",
          "size": "sm",
          "leadingIcon": "ExternalLink"
        },
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "url": {
                "$state": "/m365-mail-read/get_email/webLink"
              }
            }
          }
        }
      },
      "actions": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "justify": "end"
        },
        "children": [
          "openBtn"
        ]
      }
    }
  },
  "status": "draft"
}
