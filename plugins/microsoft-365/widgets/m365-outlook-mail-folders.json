{
  "id": "m365-outlook-mail-folders",
  "title": "Outlook — Mail Folders",
  "description": "Browse your Outlook mailbox's folder structure, including subfolders — unread and total counts per folder, drill in to see children.",
  "category": "productivity",
  "tags": ["m365", "outlook", "mail", "email", "folders", "browser", "productivity"],
  "keywords": ["outlook", "mail folders", "subfolders", "inbox folders", "email folders", "m365", "office"],
  "connectorsUsed": ["m365-mail-read"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 5, "rowSpan": 9 },
    "min": { "colSpan": 4, "rowSpan": 7 },
    "max": { "colSpan": 8, "rowSpan": 14 }
  },
  "dataProvider": {
    "mcp": "m365-mail-read",
    "tool": "list_mail_folders",
    "params": { "maxDepth": 6 }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": ["header", "divider1", "breadcrumbRow", "body", "divider2", "footer"],
        "watch": {
          "/m365-mail-read/list_mail_folders": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/children",
                "value": {
                  "$computed": "microsoft-365_mail_folder_children",
                  "args": { "items": { "$state": "/m365-mail-read/list_mail_folders" }, "path": { "$state": "/ui/currentPath" } }
                }
              }
            }
          ],
          "/ui/currentPath": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/children",
                "value": {
                  "$computed": "microsoft-365_mail_folder_children",
                  "args": { "items": { "$state": "/m365-mail-read/list_mail_folders" }, "path": { "$state": "/ui/currentPath" } }
                }
              }
            }
          ]
        }
      },

      "header": { "type": "Header", "props": {}, "children": ["titleGroup"] },
      "titleGroup": { "type": "Row", "props": { "gap": "sm", "align": "center" }, "children": ["titleIcon", "titleStack"] },
      "titleIcon": { "type": "Icon", "props": { "name": "FolderTree", "tone": "info", "size": "sm" } },
      "titleStack": { "type": "Stack", "props": { "gap": "none" }, "children": ["title", "eyebrow"] },
      "title": { "type": "Heading", "props": { "text": "Mail Folders", "level": "h2" } },
      "eyebrow": { "type": "Eyebrow", "props": { "text": "Outlook · Microsoft 365" } },

      "divider1": { "type": "Divider", "props": {} },

      "breadcrumbRow": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["upBtn", "currentPathLabel"],
        "visible": { "$state": "/ui/currentPath" }
      },
      "upBtn": {
        "type": "Button",
        "props": { "label": "Up", "size": "sm", "variant": "ghost", "tone": "info", "leadingIcon": "ArrowLeft" },
        "on": {
          "click": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/currentPath",
                "value": { "$computed": "microsoft-365_mail_folder_parent_path", "args": { "path": { "$state": "/ui/currentPath" } } }
              }
            },
            {
              "action": "m365-mail-read.list_emails",
              "params": { "folder": { "$state": "/ui/currentPath" }, "limit": 20 }
            }
          ]
        }
      },
      "currentPathLabel": {
        "type": "Caption",
        "props": {
          "text": { "$computed": "microsoft-365_mail_folder_breadcrumb", "args": { "path": { "$state": "/ui/currentPath" } } },
          "tone": "info",
          "weight": "semibold"
        }
      },

      "body": {
        "type": "Body",
        "props": {},
        "children": [
          "loading",
          "errorBanner",
          "rootEmptyState",
          "folderList",
          "noSubfoldersCaption",
          "messagesDivider",
          "messagesHeader",
          "messagesLoading",
          "messagesError",
          "messagesEmpty",
          "messageList"
        ]
      },

      "loading": {
        "type": "Skeleton",
        "props": { "height": "8rem", "rounded": "md" },
        "visible": { "$state": "/_loading/m365-mail-read.list_mail_folders" }
      },

      "errorBanner": {
        "type": "Caption",
        "props": { "text": { "$template": "Couldn't load mail folders: ${/_errors/m365-mail-read.list_mail_folders}" }, "tone": "destructive" },
        "visible": { "$state": "/_errors/m365-mail-read.list_mail_folders" }
      },

      "rootEmptyState": {
        "type": "Stack",
        "props": { "gap": "xs", "align": "center" },
        "children": ["emptyIcon", "emptyText"],
        "visible": {
          "$and": [
            { "$state": "/_loading/m365-mail-read.list_mail_folders", "not": true },
            { "$state": "/ui/currentPath", "not": true },
            { "$state": "/ui/children/0", "not": true }
          ]
        }
      },
      "emptyIcon": { "type": "Icon", "props": { "name": "FolderX", "tone": "muted", "size": "md" } },
      "emptyText": { "type": "Caption", "props": { "text": "No mail folders found.", "tone": "muted" } },

      "folderList": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["folderRow"],
        "repeat": { "statePath": "/ui/children", "key": "id" },
        "visible": { "$state": "/_loading/m365-mail-read.list_mail_folders", "not": true }
      },
      "noSubfoldersCaption": {
        "type": "Caption",
        "props": { "text": "No subfolders.", "tone": "muted" },
        "visible": {
          "$and": [
            { "$state": "/_loading/m365-mail-read.list_mail_folders", "not": true },
            { "$state": "/ui/currentPath" },
            { "$state": "/ui/children/0", "not": true }
          ]
        }
      },
      "folderRow": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center", "justify": "between", "hover": true, "clickable": true },
        "children": ["folderLeft", "folderRight"],
        "on": {
          "click": [
            {
              "action": "setState",
              "params": { "statePath": "/ui/currentPath", "value": { "$bindItem": "path" } }
            },
            {
              "action": "m365-mail-read.list_emails",
              "params": { "folder": { "$state": "/ui/currentPath" }, "limit": 20 }
            }
          ]
        }
      },
      "folderLeft": { "type": "Row", "props": { "gap": "sm", "align": "center", "grow": true }, "children": ["folderIcon", "folderName"] },
      "folderIcon": { "type": "Icon", "props": { "name": "Folder", "tone": "info", "size": "sm" } },
      "folderName": { "type": "Text", "props": { "text": { "$item": "displayName" }, "size": "sm", "weight": "medium", "truncate": true } },

      "folderRight": { "type": "Row", "props": { "gap": "sm", "align": "center" }, "children": ["folderCounts", "folderUnreadBadge", "folderEnterIcon"] },
      "folderCounts": {
        "type": "Caption",
        "props": {
          "text": { "$computed": "fmt", "args": { "pattern": "{n} item{s}", "n": { "$item": "totalItemCount" }, "s": { "$cond": { "$item": "totalItemCount" }, "eq": 1, "$then": "", "$else": "s" } } },
          "tone": "muted"
        }
      },
      "folderUnreadBadge": {
        "type": "Badge",
        "props": { "text": { "$item": "unreadItemCount" }, "tone": "accent" },
        "visible": { "$item": "unreadItemCount" }
      },
      "folderEnterIcon": {
        "type": "Icon",
        "props": { "name": "ChevronRight", "tone": "muted", "size": "sm" },
        "visible": { "$item": "childFolderCount" }
      },

      "messagesDivider": { "type": "Divider", "props": {}, "visible": { "$state": "/ui/currentPath" } },
      "messagesHeader": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["messagesHeaderIcon", "messagesHeaderText"],
        "visible": { "$state": "/ui/currentPath" }
      },
      "messagesHeaderIcon": { "type": "Icon", "props": { "name": "Mail", "tone": "muted", "size": "sm" } },
      "messagesHeaderText": { "type": "Caption", "props": { "text": "Messages", "tone": "muted", "weight": "semibold" } },

      "messagesLoading": {
        "type": "Skeleton",
        "props": { "height": "6rem", "rounded": "md" },
        "visible": { "$and": [{ "$state": "/ui/currentPath" }, { "$state": "/_loading/m365-mail-read.list_emails" }] }
      },
      "messagesError": {
        "type": "Caption",
        "props": { "text": { "$template": "Couldn't load messages: ${/_errors/m365-mail-read.list_emails}" }, "tone": "destructive" },
        "visible": { "$state": "/_errors/m365-mail-read.list_emails" }
      },
      "messagesEmpty": {
        "type": "Caption",
        "props": { "text": "No messages in this folder.", "tone": "muted" },
        "visible": {
          "$and": [
            { "$state": "/ui/currentPath" },
            { "$state": "/_loading/m365-mail-read.list_emails", "not": true },
            { "$state": "/m365-mail-read/list_emails/0", "not": true }
          ]
        }
      },

      "messageList": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["messageRow"],
        "repeat": { "statePath": "/m365-mail-read/list_emails", "key": "id" },
        "visible": { "$and": [{ "$state": "/ui/currentPath" }, { "$state": "/_loading/m365-mail-read.list_emails", "not": true }] }
      },
      "messageRow": {
        "type": "Row",
        "props": { "gap": "sm", "align": "start", "justify": "between", "hover": true, "clickable": true },
        "children": ["messageLeft", "messageRight"],
        "on": {
          "click": { "action": "open_url", "params": { "url": { "$bindItem": "webLink" }, "target": "_blank" } }
        }
      },
      "messageUnreadDot": {
        "type": "Dot",
        "props": { "tone": { "$cond": { "$item": "isRead" }, "$then": "muted", "$else": "accent" }, "size": "sm" }
      },
      "messageLabels": { "type": "Stack", "props": { "gap": "none", "grow": true }, "children": ["messageSubject", "messageSender"] },
      "messageSubject": { "type": "Text", "props": { "text": { "$item": "subject" }, "size": "sm", "weight": "medium", "truncate": true } },
      "messageSender": { "type": "Caption", "props": { "text": { "$item": "from/emailAddress/name" }, "tone": "muted", "truncate": true } },
      "messageLeft": { "type": "Row", "props": { "gap": "sm", "align": "start", "grow": true }, "children": ["messageUnreadDot", "messageLabels"] },

      "messageReceived": {
        "type": "Caption",
        "props": { "text": { "$computed": "relative_time", "args": { "value": { "$item": "receivedDateTime" } } }, "tone": "muted" }
      },
      "messageOpenIcon": { "type": "Icon", "props": { "name": "ExternalLink", "tone": "muted", "size": "sm" } },
      "messageRight": { "type": "Row", "props": { "gap": "sm", "align": "center" }, "children": ["messageReceived", "messageOpenIcon"] },

      "divider2": { "type": "Divider", "props": {} },
      "footer": { "type": "Row", "props": { "justify": "end" }, "children": ["openOutlookBtn"] },
      "openOutlookBtn": {
        "type": "Button",
        "props": { "label": "Open Outlook", "tone": "info", "variant": "ghost", "size": "sm", "leadingIcon": "ExternalLink" },
        "on": { "click": { "action": "open_url", "params": { "url": "https://outlook.office.com/mail/", "target": "_blank" } } }
      }
    }
  },
  "status": "published"
}
