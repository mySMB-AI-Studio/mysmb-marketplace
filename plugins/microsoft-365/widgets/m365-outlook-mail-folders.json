{
  "id": "m365-outlook-mail-folders",
  "title": "myOutlook",
  "description": "Outlook-style two-pane mailbox browser: folders on the left (Inbox, Drafts and Sent Items pinned, then alphabetical), that folder's messages on the right, click a message for full details.",
  "category": "productivity",
  "tags": ["m365", "outlook", "mail", "email", "folders", "productivity"],
  "keywords": ["outlook", "mail folders", "inbox", "email", "m365", "office", "reading pane"],
  "connectorsUsed": ["m365-mail-read", "m365-mail-send"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 8, "rowSpan": 10 },
    "min": { "colSpan": 6, "rowSpan": 7 },
    "max": { "colSpan": 12, "rowSpan": 16 }
  },
  "dataProvider": {
    "mcp": "m365-mail-read",
    "tool": "list_mail_folders",
    "params": { "maxDepth": 4 }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": ["header", "divider1", "body", "divider2", "footer", "detailOverlay", "composeOverlay", "infoOverlay"],
        "watch": {
          "/m365-mail-read/list_mail_folders": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/sortedFolders",
                "value": {
                  "$computed": "microsoft-365_mail_folder_sorted",
                  "args": { "items": { "$state": "/m365-mail-read/list_mail_folders" }, "selectedPath": { "$state": "/ui/selectedFolderPath" } }
                }
              }
            }
          ]
        }
      },

      "header": { "type": "Header", "props": {}, "children": ["headerRow"] },
      "headerRow": { "type": "Row", "props": { "gap": "sm", "align": "center", "justify": "between" }, "children": ["titleGroup", "headerActions"] },
      "titleGroup": { "type": "Row", "props": { "gap": "sm", "align": "center" }, "children": ["titleIcon", "titleStack"] },
      "headerActions": { "type": "Row", "props": { "gap": "xs", "align": "center" }, "children": ["composeBtn", "infoBtn"] },
      "infoBtn": {
        "type": "IconButton",
        "props": { "icon": "Info", "size": "sm", "tone": "muted", "ariaLabel": "About this tile" },
        "on": { "click": { "action": "setState", "params": { "statePath": "/ui/showInfo", "value": true } } }
      },
      "titleIcon": { "type": "Icon", "props": { "name": "Mail", "tone": "info", "size": "sm" } },
      "titleStack": { "type": "Stack", "props": { "gap": "none" }, "children": ["title", "eyebrow"] },
      "title": { "type": "Heading", "props": { "text": "myOutlook", "level": "h2" } },
      "eyebrow": { "type": "Eyebrow", "props": { "text": "Outlook · Microsoft 365" } },

      "divider1": { "type": "Divider", "props": {} },

      "body": { "type": "Body", "props": {}, "children": ["foldersError", "mainRow"] },

      "foldersError": {
        "type": "Caption",
        "props": { "text": { "$template": "Couldn't load mail folders: ${/_errors/m365-mail-read.list_mail_folders}" }, "tone": "destructive" },
        "visible": { "$state": "/_errors/m365-mail-read.list_mail_folders" }
      },

      "mainRow": { "type": "Row", "props": { "gap": "md", "align": "start" }, "children": ["leftColumn", "rightColumn"] },

      "leftColumn": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["foldersLoading", "folderList"],
        "watch": {
          "/m365-mail-read/list_mail_folders": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/selectedFolderPath",
                "value": { "$cond": { "$state": "/ui/selectedFolderPath" }, "$then": { "$state": "/ui/selectedFolderPath" }, "$else": "Inbox" }
              }
            }
          ]
        }
      },
      "foldersLoading": {
        "type": "Skeleton",
        "props": { "height": "10rem", "rounded": "md" },
        "visible": { "$state": "/_loading/m365-mail-read.list_mail_folders" }
      },
      "folderList": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["folderRow"],
        "repeat": { "statePath": "/ui/sortedFolders", "key": "id" },
        "visible": { "$state": "/_loading/m365-mail-read.list_mail_folders", "not": true },
        "watch": {
          "/ui/selectedFolderPath": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/sortedFolders",
                "value": {
                  "$computed": "microsoft-365_mail_folder_tree",
                  "args": {
                    "items": { "$state": "/m365-mail-read/list_mail_folders" },
                    "selectedPath": { "$state": "/ui/selectedFolderPath" },
                    "expandedPaths": { "$state": "/ui/expandedFolderPaths" }
                  }
                }
              }
            }
          ],
          "/ui/expandedFolderPaths": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/sortedFolders",
                "value": {
                  "$computed": "microsoft-365_mail_folder_tree",
                  "args": {
                    "items": { "$state": "/m365-mail-read/list_mail_folders" },
                    "selectedPath": { "$state": "/ui/selectedFolderPath" },
                    "expandedPaths": { "$state": "/ui/expandedFolderPaths" }
                  }
                }
              }
            }
          ]
        }
      },
      "folderRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center",
          "justify": "between",
          "hover": true,
          "clickable": true,
          "selected": { "$item": "isSelected" }
        },
        "children": ["folderLeft", "folderUnreadBadge"],
        "on": {
          "click": [
            { "action": "setState", "params": { "statePath": "/ui/selectedFolderPath", "value": { "$bindItem": "path" } } },
            { "action": "setState", "params": { "statePath": "/ui/selectedFolderName", "value": { "$bindItem": "displayName" } } },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/expandedFolderPaths",
                "value": {
                  "$computed": "microsoft-365_mail_folder_toggle_expanded",
                  "args": { "expandedPaths": { "$state": "/ui/expandedFolderPaths" }, "path": { "$bindItem": "path" } }
                }
              }
            }
          ]
        }
      },
      "folderIcon": {
        "type": "Icon",
        "props": {
          "name": { "$computed": "microsoft-365_mail_folder_icon", "args": { "value": { "$item": "displayName" } } },
          "tone": { "$computed": "microsoft-365_mail_folder_tone", "args": { "value": { "$item": "displayName" } } },
          "size": "sm"
        },
        "visible": { "$item": "depth", "eq": 1 }
      },
      "subFolderIcon": {
        "type": "Icon",
        "props": { "name": "Folder", "tone": "muted", "size": "sm" },
        "visible": { "$item": "depth", "eq": 1, "not": true }
      },
      "folderLeft": { "type": "Row", "props": { "gap": "sm", "align": "center" }, "children": ["folderIcon", "subFolderIcon", "folderName"] },
      "folderName": { "type": "Text", "props": { "text": { "$item": "indentedName" }, "size": "sm", "weight": "medium", "truncate": true } },
      "folderUnreadBadge": {
        "type": "Badge",
        "props": {
          "text": { "$item": "unreadItemCount" },
          "tone": { "$cond": { "$item": "depth", "eq": 1 }, "$then": { "$computed": "microsoft-365_mail_folder_tone", "args": { "value": { "$item": "displayName" } } }, "$else": "muted" }
        },
        "visible": { "$item": "unreadItemCount" }
      },

      "rightColumn": {
        "type": "Stack",
        "props": { "gap": "sm", "grow": true },
        "children": ["rightHeader", "messagesLoading", "messagesError", "deleteError", "messagesEmpty", "messageList"],
        "watch": {
          "/m365-mail-read/list_mail_folders": [
            { "action": "m365-mail-read.list_emails", "params": { "folder": "Inbox", "limit": 20 } }
          ],
          "/ui/selectedFolderPath": [
            {
              "action": "m365-mail-read.list_emails",
              "params": { "folder": { "$state": "/ui/selectedFolderPath" }, "limit": 20 }
            }
          ]
        }
      },
      "rightHeader": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center", "justify": "between" },
        "children": ["rightHeaderTitle", "rightHeaderUnread"],
        "watch": {
          "/m365-mail-read/list_mail_folders": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/selectedFolderName",
                "value": { "$cond": { "$state": "/ui/selectedFolderName" }, "$then": { "$state": "/ui/selectedFolderName" }, "$else": "Inbox" }
              }
            }
          ]
        }
      },
      "rightHeaderTitle": { "type": "Heading", "props": { "text": { "$state": "/ui/selectedFolderName" }, "level": "h3" } },
      "rightHeaderUnread": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{n} unread",
              "n": { "$computed": "count_where", "args": { "value": { "$state": "/m365-mail-read/list_emails" }, "whereField": "isRead", "equals": false } }
            }
          }
        }
      },

      "messagesLoading": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["ms1", "ms2", "ms3"],
        "visible": { "$state": "/_loading/m365-mail-read.list_emails" }
      },
      "ms1": { "type": "Skeleton", "props": { "height": "2.75rem", "rounded": "md" } },
      "ms2": { "type": "Skeleton", "props": { "height": "2.75rem", "rounded": "md" } },
      "ms3": { "type": "Skeleton", "props": { "height": "2.75rem", "rounded": "md" } },

      "messagesError": {
        "type": "Caption",
        "props": { "text": { "$template": "Couldn't load messages: ${/_errors/m365-mail-read.list_emails}" }, "tone": "destructive" },
        "visible": { "$state": "/_errors/m365-mail-read.list_emails" }
      },
      "messagesEmpty": {
        "type": "Caption",
        "props": { "text": "No messages in this folder.", "tone": "muted" },
        "visible": {
          "$and": [
            { "$state": "/_loading/m365-mail-read.list_emails", "not": true },
            { "$state": "/m365-mail-read/list_emails/0", "not": true }
          ]
        }
      },

      "messageList": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["messageRow"],
        "repeat": { "statePath": "/ui/messagesView", "key": "id" },
        "visible": { "$state": "/_loading/m365-mail-read.list_emails", "not": true },
        "watch": {
          "/m365-mail-read/list_emails": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/messagesView",
                "value": {
                  "$computed": "microsoft-365_mark_pending_delete",
                  "args": { "items": { "$state": "/m365-mail-read/list_emails" }, "pendingId": { "$state": "/ui/pendingDeleteId" } }
                }
              }
            }
          ],
          "/ui/pendingDeleteId": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/messagesView",
                "value": {
                  "$computed": "microsoft-365_mark_pending_delete",
                  "args": { "items": { "$state": "/m365-mail-read/list_emails" }, "pendingId": { "$state": "/ui/pendingDeleteId" } }
                }
              }
            }
          ]
        }
      },
      "messageRow": {
        "type": "Row",
        "props": { "gap": "sm", "align": "start", "justify": "between", "hover": true, "clickable": true },
        "children": ["messageLeft", "messageRight"],
        "on": {
          "click": [
            { "action": "setState", "params": { "statePath": "/m365-mail-read/get_email", "value": {} } },
            { "action": "setState", "params": { "statePath": "/_errors/m365-mail-read.get_email", "value": "" } },
            { "action": "setState", "params": { "statePath": "/ui/replyText", "value": "" } },
            { "action": "setState", "params": { "statePath": "/ui/replySent", "value": false } },
            { "action": "setState", "params": { "statePath": "/ui/selectedEmailId", "value": { "$bindItem": "id" } } },
            { "action": "m365-mail-read.get_email", "params": { "id": { "$bindItem": "id" } } }
          ]
        }
      },
      "messageUnreadDot": { "type": "Dot", "props": { "tone": { "$cond": { "$item": "isRead" }, "$then": "muted", "$else": "accent" }, "size": "sm" } },
      "messageAvatar": { "type": "Avatar", "props": { "initials": { "$computed": "initials", "args": { "value": { "$item": "from/emailAddress/name" } } }, "size": "sm" } },
      "messageLabels": { "type": "Stack", "props": { "gap": "none", "grow": true }, "children": ["messageSubject", "messagePreview"] },
      "messageSubject": { "type": "Text", "props": { "text": { "$item": "subject" }, "size": "sm", "weight": "medium", "truncate": true } },
      "messagePreview": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": { "pattern": "{name} — {preview}", "name": { "$item": "from/emailAddress/name" }, "preview": { "$computed": "email_preview", "args": { "value": { "$item": "bodyPreview" }, "maxLength": 80 } } }
          },
          "tone": "muted",
          "truncate": true
        }
      },
      "messageLeft": { "type": "Row", "props": { "gap": "sm", "align": "start", "grow": true }, "children": ["messageUnreadDot", "messageAvatar", "messageLabels"] },
      "messageReceived": { "type": "Caption", "props": { "text": { "$computed": "relative_time", "args": { "value": { "$item": "receivedDateTime" } } }, "tone": "muted" } },

      "messageRight": { "type": "Stack", "props": { "gap": "xs", "align": "end" }, "children": ["messageReceived", "messageDeleteRow"] },
      "messageDeleteRow": { "type": "Row", "props": { "gap": "xs", "align": "center" }, "children": ["messageDeleteBtn", "messageDeleteConfirm"] },
      "messageDeleteBtn": {
        "type": "IconButton",
        "props": { "icon": "Trash2", "size": "sm", "tone": "muted", "ariaLabel": "Delete" },
        "visible": { "$item": "isPendingDelete", "not": true },
        "on": { "click": { "action": "setState", "params": { "statePath": "/ui/pendingDeleteId", "value": { "$bindItem": "id" } } } }
      },
      "messageDeleteConfirm": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["messageDeleteConfirmLabel", "messageDeleteConfirmBtn", "messageDeleteCancelBtn"],
        "visible": { "$item": "isPendingDelete" }
      },
      "messageDeleteConfirmLabel": { "type": "Caption", "props": { "text": "Delete?", "tone": "destructive" } },
      "messageDeleteConfirmBtn": {
        "type": "IconButton",
        "props": { "icon": "Check", "size": "sm", "tone": "destructive", "ariaLabel": "Confirm delete" },
        "on": {
          "click": [
            { "action": "m365-mail-send.delete_email", "params": { "id": { "$bindItem": "id" } } },
            { "action": "setState", "params": { "statePath": "/ui/pendingDeleteId", "value": "" } },
            { "action": "m365-mail-read.list_emails", "params": { "folder": { "$state": "/ui/selectedFolderPath" }, "limit": 20 } }
          ]
        }
      },
      "messageDeleteCancelBtn": {
        "type": "IconButton",
        "props": { "icon": "X", "size": "sm", "tone": "muted", "ariaLabel": "Cancel" },
        "on": { "click": { "action": "setState", "params": { "statePath": "/ui/pendingDeleteId", "value": "" } } }
      },
      "deleteError": {
        "type": "Caption",
        "props": { "text": { "$template": "Couldn't delete that message: ${/_errors/m365-mail-send.delete_email}" }, "tone": "destructive" },
        "visible": { "$state": "/_errors/m365-mail-send.delete_email" }
      },

      "divider2": { "type": "Divider", "props": {} },
      "footer": { "type": "Row", "props": { "justify": "end" }, "children": ["openOutlookBtn"] },
      "composeBtn": {
        "type": "Button",
        "props": { "label": "Compose", "tone": "info", "variant": "primary", "size": "sm", "leadingIcon": "SquarePen" },
        "on": {
          "click": [
            { "action": "setState", "params": { "statePath": "/ui/composeOpen", "value": true } },
            { "action": "setState", "params": { "statePath": "/ui/composeSent", "value": false } }
          ]
        }
      },
      "openOutlookBtn": {
        "type": "Button",
        "props": { "label": "Open Outlook", "tone": "info", "variant": "ghost", "size": "sm", "leadingIcon": "ExternalLink" },
        "on": { "click": { "action": "open_url", "params": { "url": "https://outlook.office.com/mail/", "target": "_blank" } } }
      },

      "detailOverlay": {
        "type": "Overlay",
        "props": { "maxWidth": "48rem" },
        "children": ["detailCard"],
        "visible": { "$state": "/ui/selectedEmailId" },
        "on": { "backdropClick": { "action": "setState", "params": { "statePath": "/ui/selectedEmailId", "value": "" } } }
      },
      "detailCard": { "type": "Card", "props": {}, "children": ["detailHeader", "detailDivider", "detailSpinner", "detailError", "detailBody"] },
      "detailHeader": { "type": "Row", "props": { "gap": "sm", "align": "center", "justify": "between" }, "children": ["detailTitle", "detailCloseBtn"] },
      "detailTitle": { "type": "Heading", "props": { "text": { "$state": "/m365-mail-read/get_email/subject" }, "level": "h2" } },
      "detailCloseBtn": {
        "type": "IconButton",
        "props": { "icon": "X", "size": "sm", "tone": "muted", "ariaLabel": "Close" },
        "on": {
          "click": [
            { "action": "setState", "params": { "statePath": "/ui/selectedEmailId", "value": "" } },
            { "action": "setState", "params": { "statePath": "/ui/replyText", "value": "" } },
            { "action": "setState", "params": { "statePath": "/ui/replySent", "value": false } }
          ]
        }
      },
      "detailDivider": { "type": "Divider", "props": {} },
      "detailSpinner": {
        "type": "Spinner",
        "props": { "label": "Loading message…" },
        "visible": {
          "$and": [
            { "$state": "/_errors/m365-mail-read.get_email", "not": true },
            { "$state": "/m365-mail-read/get_email/id", "neq": { "$state": "/ui/selectedEmailId" } }
          ]
        }
      },
      "detailError": {
        "type": "Empty",
        "props": { "message": "Couldn't load this message. Close and try again." },
        "visible": { "$state": "/_errors/m365-mail-read.get_email" }
      },
      "detailBody": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["kvFrom", "kvReceived", "bodySection", "detailActions", "replyDivider", "replySection"],
        "visible": { "$state": "/m365-mail-read/get_email/id", "eq": { "$state": "/ui/selectedEmailId" } }
      },
      "kvFrom": {
        "type": "KeyValue",
        "props": {
          "label": "From",
          "value": {
            "$computed": "fmt",
            "args": { "pattern": "{name} <{addr}>", "name": { "$state": "/m365-mail-read/get_email/from/emailAddress/name" }, "addr": { "$state": "/m365-mail-read/get_email/from/emailAddress/address" } }
          }
        }
      },
      "kvReceived": {
        "type": "KeyValue",
        "props": { "label": "Received", "value": { "$computed": "relative_time", "args": { "value": { "$state": "/m365-mail-read/get_email/receivedDateTime" } } } }
      },
      "bodySection": { "type": "Section", "props": { "variant": "muted" }, "children": ["bodyHtml"] },
      "bodyHtml": { "type": "RichHtml", "props": { "html": { "$state": "/m365-mail-read/get_email/body/content" }, "minHeight": 120, "maxHeight": 520 } },
      "detailActions": { "type": "Row", "props": { "justify": "end" }, "children": ["openInOutlookBtn"] },
      "openInOutlookBtn": {
        "type": "Button",
        "props": { "label": "Open in Outlook", "variant": "primary", "size": "sm", "leadingIcon": "ExternalLink" },
        "on": { "click": { "action": "open_url", "params": { "url": { "$state": "/m365-mail-read/get_email/webLink" } } } }
      },

      "replyDivider": { "type": "Divider", "props": {} },
      "replySection": { "type": "Stack", "props": { "gap": "xs" }, "children": ["replyLabel", "replyInput", "replyRow", "replySentCaption", "replyError"] },
      "replyLabel": { "type": "Caption", "props": { "text": "Reply", "tone": "muted", "weight": "semibold" } },
      "replyInput": {
        "type": "TextInput",
        "props": { "value": { "$bindState": "/ui/replyText" }, "multiline": true, "rows": 3, "placeholder": "Write a reply…" }
      },
      "replyRow": { "type": "Row", "props": { "justify": "end" }, "children": ["replySendBtn"] },
      "replySendBtn": {
        "type": "Button",
        "props": {
          "label": "Send reply",
          "variant": "primary",
          "size": "sm",
          "leadingIcon": "Send",
          "disabled": { "$computed": "microsoft-365_is_blank", "args": { "value": { "$state": "/ui/replyText" } } }
        },
        "on": {
          "click": [
            {
              "action": "m365-mail-send.reply_to_email",
              "params": { "id": { "$state": "/ui/selectedEmailId" }, "comment": { "$state": "/ui/replyText" } }
            },
            { "action": "setState", "params": { "statePath": "/ui/replyText", "value": "" } },
            { "action": "setState", "params": { "statePath": "/ui/replySent", "value": true } }
          ]
        }
      },
      "replySentCaption": { "type": "Caption", "props": { "text": "Reply sent.", "tone": "success" }, "visible": { "$state": "/ui/replySent" } },
      "replyError": {
        "type": "Caption",
        "props": { "text": { "$template": "Couldn't send that reply: ${/_errors/m365-mail-send.reply_to_email}" }, "tone": "destructive" },
        "visible": { "$state": "/_errors/m365-mail-send.reply_to_email" }
      },

      "composeOverlay": {
        "type": "Overlay",
        "props": { "maxWidth": "36rem" },
        "children": ["composeCard"],
        "visible": { "$state": "/ui/composeOpen" },
        "on": { "backdropClick": { "action": "setState", "params": { "statePath": "/ui/composeOpen", "value": false } } }
      },
      "composeCard": { "type": "Card", "props": {}, "children": ["composeHeader", "composeDivider", "composeBody"] },
      "composeHeader": { "type": "Row", "props": { "gap": "sm", "align": "center", "justify": "between" }, "children": ["composeTitle", "composeCloseBtn"] },
      "composeTitle": { "type": "Heading", "props": { "text": "New message", "level": "h2" } },
      "composeCloseBtn": {
        "type": "IconButton",
        "props": { "icon": "X", "size": "sm", "tone": "muted", "ariaLabel": "Close" },
        "on": { "click": { "action": "setState", "params": { "statePath": "/ui/composeOpen", "value": false } } }
      },
      "composeDivider": { "type": "Divider", "props": {} },
      "composeBody": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["composeToInput", "composeSubjectInput", "composeBodyInput", "composeSendRow", "composeSentCaption", "composeError"]
      },
      "composeToInput": {
        "type": "TextInput",
        "props": { "value": { "$bindState": "/ui/composeTo" }, "placeholder": "To (comma-separated emails)" }
      },
      "composeSubjectInput": {
        "type": "TextInput",
        "props": { "value": { "$bindState": "/ui/composeSubject" }, "placeholder": "Subject" }
      },
      "composeBodyInput": {
        "type": "TextInput",
        "props": { "value": { "$bindState": "/ui/composeBody" }, "multiline": true, "rows": 6, "placeholder": "Write your message…" }
      },
      "composeSendRow": { "type": "Row", "props": { "justify": "end" }, "children": ["composeSendBtn"] },
      "composeSendBtn": {
        "type": "Button",
        "props": {
          "label": "Send",
          "variant": "primary",
          "size": "sm",
          "leadingIcon": "Send",
          "disabled": {
            "$computed": "microsoft-365_compose_send_disabled",
            "args": { "to": { "$state": "/ui/composeTo" }, "subject": { "$state": "/ui/composeSubject" } }
          }
        },
        "on": {
          "click": [
            {
              "action": "m365-mail-send.send_email",
              "params": {
                "to": { "$computed": "microsoft-365_compose_to_list", "args": { "value": { "$state": "/ui/composeTo" } } },
                "subject": { "$state": "/ui/composeSubject" },
                "body": { "$state": "/ui/composeBody" },
                "contentType": "Text"
              }
            },
            { "action": "setState", "params": { "statePath": "/ui/composeTo", "value": "" } },
            { "action": "setState", "params": { "statePath": "/ui/composeSubject", "value": "" } },
            { "action": "setState", "params": { "statePath": "/ui/composeBody", "value": "" } },
            { "action": "setState", "params": { "statePath": "/ui/composeSent", "value": true } }
          ]
        }
      },
      "composeSentCaption": { "type": "Caption", "props": { "text": "Message sent.", "tone": "success" }, "visible": { "$state": "/ui/composeSent" } },
      "composeError": {
        "type": "Caption",
        "props": { "text": { "$template": "Couldn't send that message: ${/_errors/m365-mail-send.send_email}" }, "tone": "destructive" },
        "visible": { "$state": "/_errors/m365-mail-send.send_email" }
      },

      "infoOverlay": {
        "type": "Overlay",
        "props": { "maxWidth": "28rem" },
        "children": ["infoCard"],
        "visible": { "$state": "/ui/showInfo" },
        "on": { "backdropClick": { "action": "setState", "params": { "statePath": "/ui/showInfo", "value": false } } }
      },
      "infoCloseBtn": {
        "type": "IconButton",
        "props": { "icon": "X", "size": "sm", "tone": "muted", "ariaLabel": "Close", "floating": true },
        "on": { "click": { "action": "setState", "params": { "statePath": "/ui/showInfo", "value": false } } }
      },
      "infoTitleIcon": { "type": "Icon", "props": { "name": "Info", "size": "sm", "tone": "info" } },
      "infoTitleText": { "type": "Heading", "props": { "text": "About myOutlook", "level": "h2" } },
      "infoTitleRow": { "type": "Row", "props": { "align": "center", "gap": "sm" }, "children": ["infoTitleIcon", "infoTitleText"] },
      "infoDivider": { "type": "Divider", "props": {} },
      "infoWhatLabel": { "type": "Caption", "props": { "text": "What this is", "tone": "muted", "weight": "semibold" } },
      "infoWhatText": {
        "type": "Text",
        "props": {
          "text": "An Outlook-style view of your mailbox: your folders on the left (Inbox, Drafts and Sent Items first, then the rest alphabetically), and whichever folder's messages on the right. Any folder with sub-folders can be expanded in place to show them.",
          "size": "sm"
        }
      },
      "infoHowLabel": { "type": "Caption", "props": { "text": "Using it", "tone": "muted", "weight": "semibold" } },
      "infoHowText": {
        "type": "Text",
        "props": {
          "text": "Click a folder to see its messages. If it has sub-folders, the same click also expands them inline underneath it, indented and shown with a plain folder icon — click it again to collapse. Click a message to read it in full and reply. The trash icon on a message asks you to confirm before deleting it. Compose, at the top, opens a new message. Reply, delete and Compose all act on your real mailbox — there's no undo for sending, though a deleted message can still be recovered from Deleted Items.",
          "size": "sm"
        }
      },
      "infoBody": { "type": "Stack", "props": { "gap": "md" }, "children": ["infoWhatLabel", "infoWhatText", "infoHowLabel", "infoHowText"] },
      "infoCard": { "type": "Card", "props": {}, "children": ["infoCloseBtn", "infoTitleRow", "infoDivider", "infoBody"] }
    }
  },
  "status": "published"
}
