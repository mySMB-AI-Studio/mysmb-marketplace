{
  "id": "m365-calendar-this-week",
  "title": "This Week at a Glance",
  "description": "Your calendar for the next 7 days in a single scrollable list.",
  "category": "productivity",
  "tags": [
    "m365",
    "calendar",
    "week",
    "schedule"
  ],
  "keywords": [
    "week",
    "calendar",
    "overview",
    "upcoming"
  ],
  "connectorsUsed": [
    "m365-calendar"
  ],
  "popularity": 62,
  "sizing": {
    "preferred": {
      "colSpan": 6,
      "rowSpan": 6
    },
    "min": {
      "colSpan": 4,
      "rowSpan": 4
    },
    "max": {
      "colSpan": 12,
      "rowSpan": 12
    }
  },
  "dataProvider": {
    "mcp": "m365-calendar",
    "tool": "list_events",
    "params": {
      "startDateTime": "$week_start",
      "endDateTime": "$week_end",
      "limit": 50
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "children": [
          "header",
          "body"
        ]
      },
      "header": {
        "type": "Header",
        "children": [
          "titleRow"
        ]
      },
      "titleRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "start"
        },
        "children": [
          "titleIcon",
          "titleStack"
        ]
      },
      "titleIcon": {
        "type": "Icon",
        "props": {
          "name": "CalendarRange",
          "tone": "accent",
          "size": "sm"
        }
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "This Week",
          "level": "h2"
        }
      },
      "count": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{n} Events",
              "n": {
                "$computed": "count",
                "args": {
                  "value": {
                    "$state": "/m365-calendar/list_events"
                  }
                }
              }
            }
          }
        }
      },
      "body": {
        "type": "Body",
        "children": [
          "loading",
          "empty",
          "list"
        ]
      },
      "loading": {
        "type": "Skeleton",
        "props": {
          "height": "8rem",
          "rounded": "md"
        },
        "visible": {
          "$state": "/_loading/m365-calendar.list_events"
        }
      },
      "empty": {
        "type": "Empty",
        "props": {
          "message": "No events this week."
        },
        "visible": {
          "$and": [
            {
              "$state": "/_loading/m365-calendar.list_events",
              "not": true
            },
            {
              "$state": "/m365-calendar/list_events/0",
              "not": true
            }
          ]
        }
      },
      "list": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "children": [
          "row"
        ],
        "repeat": {
          "statePath": "/m365-calendar/list_events",
          "key": "id"
        }
      },
      "row": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "start",
          "justify": "between",
          "hover": true
        },
        "children": [
          "left",
          "badge"
        ]
      },
      "left": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "start",
          "grow": true
        },
        "children": [
          "icon",
          "labels"
        ]
      },
      "icon": {
        "type": "Icon",
        "props": {
          "name": "Clock",
          "tone": "muted",
          "size": "sm"
        }
      },
      "labels": {
        "type": "Stack",
        "props": {
          "gap": "xs",
          "grow": true
        },
        "children": [
          "subject",
          "when"
        ]
      },
      "subject": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "subject"
          },
          "size": "sm",
          "weight": "medium",
          "truncate": true
        }
      },
      "when": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{d} \u00b7 {loc}",
              "d": {
                "$computed": "format_date",
                "args": {
                  "value": {
                    "$item": "start/dateTime"
                  },
                  "format": "medium"
                }
              },
              "loc": {
                "$item": "location/displayName"
              }
            }
          }
        }
      },
      "badge": {
        "type": "Badge",
        "props": {
          "text": {
            "$computed": "relative_time",
            "args": {
              "value": {
                "$item": "start/dateTime"
              }
            }
          },
          "tone": "accent",
          "variant": "soft"
        }
      },
      "titleStack": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "children": [
          "title",
          "count"
        ]
      }
    }
  },
  "status": "draft"
}
