{
  "id": "m365-teams-mentions",
  "title": "Teams Activity",
  "description": "Recent Teams chats — unread first, with sender, snippet, and inline reply. Mark single chats or all chats as read without leaving the dashboard.",
  "category": "productivity",
  "tags": [
    "m365",
    "teams",
    "chats",
    "activity",
    "unread",
    "mentions"
  ],
  "keywords": [
    "teams",
    "chats",
    "activity",
    "recent",
    "unread",
    "mentions",
    "messages"
  ],
  "connectorsUsed": [
    "m365-teams"
  ],
  "popularity": 70,
  "sizing": {
    "preferred": {
      "colSpan": 6,
      "rowSpan": 7
    },
    "min": {
      "colSpan": 4,
      "rowSpan": 5
    },
    "max": {
      "colSpan": 12,
      "rowSpan": 12
    }
  },
  "dataProvider": {
    "mcp": "m365-teams",
    "tool": "list_chats",
    "params": {
      "limit": 25
    }
  },
  "spec": {
    "state": {
      "ui": {
        "teamsFilter": "all",
        "teamsActiveChatId": "",
        "teamsActiveChatName": "",
        "teamsReplyText": ""
      }
    },
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "children": [
          "header",
          "body",
          "drawer"
        ]
      },
      "header": {
        "type": "Header",
        "children": [
          "titleRow",
          "subhead",
          "filterBar"
        ]
      },
      "titleRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center",
          "justify": "between"
        },
        "children": [
          "titleLeft",
          "markAllReadBtn"
        ]
      },
      "titleLeft": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center"
        },
        "children": [
          "titleIcon",
          "title"
        ]
      },
      "titleIcon": {
        "type": "Icon",
        "props": {
          "name": "MessagesSquare",
          "tone": "accent",
          "size": "sm"
        }
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "Teams Activity",
          "level": "h2"
        }
      },
      "markAllReadBtn": {
        "type": "IconButton",
        "props": {
          "icon": "CheckCheck",
          "tone": "muted",
          "ariaLabel": "Mark all chats as read"
        },
        "visible": {
          "$state": "/_loading/m365-teams.list_chats",
          "not": true
        },
        "on": {
          "click": [
            {
              "action": "m365-teams.mark_all_chats_read",
              "params": {
                "limit": 50
              }
            },
            {
              "action": "m365-teams.list_chats",
              "params": {
                "limit": 25
              }
            }
          ]
        }
      },
      "subhead": {
        "type": "Caption",
        "props": {
          "tone": "muted",
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{unread} unread · {mentions} mentions · {total} recent",
              "unread": {
                "$computed": "count_where",
                "args": {
                  "value": {
                    "$state": "/m365-teams/list_chats"
                  },
                  "whereField": "unread",
                  "equals": true
                }
              },
              "mentions": {
                "$computed": "count_where",
                "args": {
                  "value": {
                    "$state": "/m365-teams/list_chats"
                  },
                  "whereField": "mentionsMe",
                  "equals": true
                }
              },
              "total": {
                "$computed": "count",
                "args": {
                  "value": {
                    "$state": "/m365-teams/list_chats"
                  }
                }
              }
            }
          }
        },
        "visible": {
          "$state": "/_loading/m365-teams.list_chats",
          "not": true
        }
      },
      "filterBar": {
        "type": "Row",
        "props": {
          "gap": "xs",
          "align": "center"
        },
        "children": [
          "filterAll",
          "filterUnread",
          "filterMentions"
        ],
        "visible": {
          "$state": "/_loading/m365-teams.list_chats",
          "not": true
        }
      },
      "filterAll": {
        "type": "Button",
        "props": {
          "label": "All",
          "size": "sm",
          "variant": {
            "$cond": {
              "$state": "/ui/teamsFilter",
              "eq": "all"
            },
            "$then": "primary",
            "$else": "ghost"
          }
        },
        "on": {
          "click": {
            "action": "setState",
            "params": {
              "statePath": "/ui/teamsFilter",
              "value": "all"
            }
          }
        }
      },
      "filterUnread": {
        "type": "Button",
        "props": {
          "label": "Unread",
          "size": "sm",
          "variant": {
            "$cond": {
              "$state": "/ui/teamsFilter",
              "eq": "unread"
            },
            "$then": "primary",
            "$else": "ghost"
          }
        },
        "on": {
          "click": {
            "action": "setState",
            "params": {
              "statePath": "/ui/teamsFilter",
              "value": "unread"
            }
          }
        }
      },
      "filterMentions": {
        "type": "Button",
        "props": {
          "label": "Mentions",
          "size": "sm",
          "variant": {
            "$cond": {
              "$state": "/ui/teamsFilter",
              "eq": "mentions"
            },
            "$then": "primary",
            "$else": "ghost"
          }
        },
        "on": {
          "click": {
            "action": "setState",
            "params": {
              "statePath": "/ui/teamsFilter",
              "value": "mentions"
            }
          }
        }
      },
      "body": {
        "type": "Body",
        "children": [
          "loading",
          "empty",
          "list"
        ]
      },
      "loading": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "visible": {
          "$state": "/_loading/m365-teams.list_chats"
        },
        "children": [
          "sk1",
          "sk2",
          "sk3"
        ]
      },
      "sk1": {
        "type": "Skeleton",
        "props": {
          "height": "3rem",
          "rounded": "md"
        }
      },
      "sk2": {
        "type": "Skeleton",
        "props": {
          "height": "3rem",
          "rounded": "md"
        }
      },
      "sk3": {
        "type": "Skeleton",
        "props": {
          "height": "3rem",
          "rounded": "md"
        }
      },
      "empty": {
        "type": "Empty",
        "props": {
          "message": "All caught up — no recent Teams activity."
        },
        "visible": {
          "$and": [
            {
              "$state": "/_loading/m365-teams.list_chats",
              "not": true
            },
            {
              "$state": "/m365-teams/list_chats/0",
              "not": true
            }
          ]
        }
      },
      "list": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "repeat": {
          "statePath": "/m365-teams/list_chats",
          "key": "id"
        },
        "children": [
          "row"
        ],
        "visible": {
          "$state": "/_loading/m365-teams.list_chats",
          "not": true
        }
      },
      "row": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center",
          "justify": "between",
          "hover": true,
          "clickable": true
        },
        "children": [
          "rowLeft",
          "rowRight"
        ],
        "visible": {
          "$or": [
            {
              "$state": "/ui/teamsFilter",
              "eq": "all"
            },
            {
              "$and": [
                {
                  "$state": "/ui/teamsFilter",
                  "eq": "unread"
                },
                {
                  "$item": "unread",
                  "eq": true
                }
              ]
            },
            {
              "$and": [
                {
                  "$state": "/ui/teamsFilter",
                  "eq": "mentions"
                },
                {
                  "$item": "mentionsMe",
                  "eq": true
                }
              ]
            }
          ]
        },
        "on": {
          "click": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/teamsActiveChatId",
                "value": {
                  "$computed": "identity",
                  "args": {
                    "value": {
                      "$item": "id"
                    }
                  }
                }
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/teamsActiveChatName",
                "value": {
                  "$computed": "identity",
                  "args": {
                    "value": {
                      "$item": "displayName"
                    }
                  }
                }
              }
            },
            {
              "action": "m365-teams.list_messages",
              "params": {
                "chatId": {
                  "$computed": "identity",
                  "args": {
                    "value": {
                      "$item": "id"
                    }
                  }
                },
                "limit": 20
              }
            },
            {
              "action": "m365-teams.mark_chat_read",
              "params": {
                "chatId": {
                  "$computed": "identity",
                  "args": {
                    "value": {
                      "$item": "id"
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "rowLeft": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center",
          "grow": true
        },
        "children": [
          "unreadDot",
          "avatar",
          "labels"
        ]
      },
      "unreadDot": {
        "type": "Dot",
        "props": {
          "tone": {
            "$cond": {
              "$item": "mentionsMe",
              "eq": true
            },
            "$then": "destructive",
            "$else": "accent"
          },
          "size": "sm"
        },
        "visible": {
          "$item": "unread",
          "eq": true
        }
      },
      "avatar": {
        "type": "Avatar",
        "props": {
          "size": "sm",
          "initials": {
            "$computed": "initials",
            "args": {
              "value": {
                "$cond": {
                  "$item": "senderName"
                },
                "$then": {
                  "$item": "senderName"
                },
                "$else": {
                  "$item": "displayName"
                }
              }
            }
          }
        }
      },
      "labels": {
        "type": "Stack",
        "props": {
          "gap": "xs",
          "grow": true
        },
        "children": [
          "topLine",
          "snippet"
        ]
      },
      "topLine": {
        "type": "Row",
        "props": {
          "gap": "xs",
          "align": "baseline"
        },
        "children": [
          "primaryLabel",
          "topicSuffix",
          "mentionPill"
        ]
      },
      "primaryLabel": {
        "type": "Text",
        "props": {
          "size": "sm",
          "truncate": true,
          "weight": {
            "$cond": {
              "$item": "unread",
              "eq": true
            },
            "$then": "semibold",
            "$else": "medium"
          },
          "text": {
            "$cond": {
              "$item": "senderName"
            },
            "$then": {
              "$item": "senderName"
            },
            "$else": {
              "$item": "displayName"
            }
          }
        }
      },
      "topicSuffix": {
        "type": "Text",
        "props": {
          "size": "xs",
          "tone": "muted",
          "truncate": true,
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "in {topic}",
              "topic": {
                "$item": "topic"
              }
            }
          }
        },
        "visible": {
          "$and": [
            {
              "$item": "senderName"
            },
            {
              "$item": "topic"
            }
          ]
        }
      },
      "mentionPill": {
        "type": "Badge",
        "props": {
          "text": "@you",
          "tone": "destructive",
          "variant": "soft"
        },
        "visible": {
          "$item": "mentionsMe",
          "eq": true
        }
      },
      "snippet": {
        "type": "Text",
        "props": {
          "size": "xs",
          "tone": "muted",
          "truncate": true,
          "text": {
            "$cond": {
              "$item": "snippet"
            },
            "$then": {
              "$item": "snippet"
            },
            "$else": {
              "$item": "snippetFallback"
            }
          }
        }
      },
      "rowRight": {
        "type": "Stack",
        "props": {
          "gap": "xs",
          "align": "end"
        },
        "children": [
          "time",
          "reactionSummary"
        ]
      },
      "time": {
        "type": "Caption",
        "props": {
          "tone": "muted",
          "text": {
            "$item": "relativeTime"
          }
        },
        "visible": {
          "$item": "relativeTime"
        }
      },
      "reactionSummary": {
        "type": "Caption",
        "props": {
          "tone": "muted",
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "♥ {count}",
              "count": {
                "$item": "reactions/0/count"
              }
            }
          }
        },
        "visible": {
          "$item": "reactions/0/count"
        }
      },
      "drawer": {
        "type": "Overlay",
        "props": {
          "maxWidth": "36rem"
        },
        "children": [
          "drawerCard"
        ],
        "visible": {
          "$state": "/ui/teamsActiveChatId"
        },
        "on": {
          "backdropClick": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/teamsActiveChatId",
                "value": ""
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/teamsReplyText",
                "value": ""
              }
            }
          ]
        }
      },
      "drawerCard": {
        "type": "Card",
        "children": [
          "drawerHeader",
          "drawerBody"
        ]
      },
      "drawerHeader": {
        "type": "Header",
        "children": [
          "drawerTitle",
          "drawerCloseBtn"
        ]
      },
      "drawerTitle": {
        "type": "Heading",
        "props": {
          "text": {
            "$state": "/ui/teamsActiveChatName"
          },
          "level": "h2"
        }
      },
      "drawerCloseBtn": {
        "type": "IconButton",
        "props": {
          "icon": "X",
          "tone": "muted",
          "ariaLabel": "Close"
        },
        "on": {
          "click": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/teamsActiveChatId",
                "value": ""
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/teamsReplyText",
                "value": ""
              }
            },
            {
              "action": "m365-teams.list_chats",
              "params": {
                "limit": 25
              }
            }
          ]
        }
      },
      "drawerBody": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "drawerLoading",
          "drawerMessages",
          "drawerDivider",
          "drawerComposer",
          "drawerSendBtn"
        ]
      },
      "drawerLoading": {
        "type": "Skeleton",
        "props": {
          "height": "8rem",
          "rounded": "md"
        },
        "visible": {
          "$state": "/_loading/m365-teams.list_messages"
        }
      },
      "drawerMessages": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "drawerMsgItem"
        ],
        "repeat": {
          "statePath": "/m365-teams/list_messages",
          "key": "id"
        },
        "visible": {
          "$state": "/_loading/m365-teams.list_messages",
          "not": true
        }
      },
      "drawerMsgItem": {
        "type": "ActivityItem",
        "props": {
          "title": {
            "$item": "from/user/displayName"
          },
          "subtitle": {
            "$computed": "html_to_text",
            "args": {
              "value": {
                "$item": "body/content"
              },
              "maxLength": 500
            }
          },
          "timestamp": {
            "$computed": "relative_time",
            "args": {
              "value": {
                "$item": "createdDateTime"
              }
            }
          },
          "initials": {
            "$computed": "initials",
            "args": {
              "value": {
                "$item": "from/user/displayName"
              }
            }
          }
        }
      },
      "drawerDivider": {
        "type": "Divider"
      },
      "drawerComposer": {
        "type": "TextInput",
        "props": {
          "value": {
            "$bindState": "/ui/teamsReplyText"
          },
          "placeholder": "Type a reply…"
        }
      },
      "drawerSendBtn": {
        "type": "Button",
        "props": {
          "label": "Send",
          "variant": "primary",
          "size": "sm",
          "leadingIcon": "Send",
          "disabled": {
            "$cond": {
              "$state": "/ui/teamsReplyText"
            },
            "$then": false,
            "$else": true
          }
        },
        "on": {
          "click": [
            {
              "action": "m365-teams.send_message",
              "params": {
                "chatId": {
                  "$state": "/ui/teamsActiveChatId"
                },
                "content": {
                  "$state": "/ui/teamsReplyText"
                }
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/teamsReplyText",
                "value": ""
              }
            },
            {
              "action": "m365-teams.list_messages",
              "params": {
                "chatId": {
                  "$state": "/ui/teamsActiveChatId"
                },
                "limit": 20
              }
            }
          ]
        }
      }
    }
  },
  "status": "published"
}
