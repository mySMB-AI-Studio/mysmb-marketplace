{
  "id": "m365-teams-mentions",
  "title": "Teams Activity",
  "description": "Your recent Teams chats and activity — the closest proxy for a mentions feed.",
  "category": "productivity",
  "tags": [
    "m365",
    "teams",
    "mentions",
    "replies"
  ],
  "keywords": [
    "mentions",
    "replies",
    "activity",
    "unread"
  ],
  "connectorsUsed": [
    "m365-teams"
  ],
  "popularity": 70,
  "sizing": {
    "preferred": {
      "colSpan": 6,
      "rowSpan": 6
    },
    "min": {
      "colSpan": 4,
      "rowSpan": 5
    },
    "max": {
      "colSpan": 12,
      "rowSpan": 12
    }
  },
  "dataProvider": {
    "mcp": "m365-teams",
    "tool": "list_chats",
    "params": {
      "limit": 20
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "children": [
          "header",
          "body"
        ]
      },
      "header": {
        "type": "Header",
        "children": [
          "titleRow",
          "count"
        ]
      },
      "titleRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center"
        },
        "children": [
          "titleIcon",
          "title"
        ]
      },
      "titleIcon": {
        "type": "Icon",
        "props": {
          "name": "AtSign",
          "tone": "accent",
          "size": "sm"
        }
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "Mentions & replies",
          "level": "h2"
        }
      },
      "count": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{n} active",
              "n": {
                "$computed": "count",
                "args": {
                  "value": {
                    "$state": "/m365-teams/list_chats"
                  }
                }
              }
            }
          }
        }
      },
      "body": {
        "type": "Body",
        "children": [
          "loading",
          "empty",
          "list"
        ]
      },
      "loading": {
        "type": "Skeleton",
        "props": {
          "height": "8rem",
          "rounded": "md"
        },
        "visible": {
          "$state": "/_loading/m365-teams.list_chats"
        }
      },
      "empty": {
        "type": "Empty",
        "props": {
          "message": "No recent chat activity."
        },
        "visible": {
          "$and": [
            {
              "$state": "/_loading/m365-teams.list_chats",
              "not": true
            },
            {
              "$state": "/m365-teams/list_chats/0",
              "not": true
            }
          ]
        }
      },
      "list": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "repeat": {
          "statePath": "/m365-teams/list_chats",
          "key": "id"
        },
        "children": [
          "row"
        ]
      },
      "row": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center",
          "justify": "between",
          "hover": true,
          "clickable": true
        },
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "url": {
                "$computed": "fmt",
                "args": {
                  "pattern": "https://teams.microsoft.com/l/chat/0/0?users={id}",
                  "id": {
                    "$item": "id"
                  }
                }
              }
            }
          }
        },
        "children": [
          "rowLeft",
          "typeBadge"
        ]
      },
      "rowLeft": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center",
          "grow": true
        },
        "children": [
          "avatar",
          "labels"
        ]
      },
      "avatar": {
        "type": "Avatar",
        "props": {
          "initials": {
            "$computed": "initials",
            "args": {
              "value": {
                "$item": "topic"
              }
            }
          },
          "size": "sm"
        }
      },
      "labels": {
        "type": "Stack",
        "props": {
          "gap": "xs",
          "grow": true
        },
        "children": [
          "topic"
        ]
      },
      "topic": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "topic"
          },
          "size": "sm",
          "weight": "medium",
          "truncate": true
        }
      },
      "typeBadge": {
        "type": "Badge",
        "props": {
          "text": {
            "$item": "chatType"
          },
          "tone": "muted",
          "variant": "soft"
        }
      }
    }
  },
  "status": "published"
}
