{
  "id": "m365-teams-mentions",
  "title": "Teams Activity",
  "description": "Recent Teams chats — who's waiting on you, sorted by recency.",
  "category": "productivity",
  "tags": [
    "m365",
    "teams",
    "chats",
    "activity"
  ],
  "keywords": [
    "teams",
    "chats",
    "activity",
    "recent",
    "messages"
  ],
  "connectorsUsed": [
    "m365-teams"
  ],
  "popularity": 70,
  "sizing": {
    "preferred": {
      "colSpan": 6,
      "rowSpan": 6
    },
    "min": {
      "colSpan": 4,
      "rowSpan": 4
    },
    "max": {
      "colSpan": 12,
      "rowSpan": 12
    }
  },
  "dataProvider": {
    "mcp": "m365-teams",
    "tool": "list_chats",
    "params": {
      "limit": 25
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "children": [
          "header",
          "body"
        ]
      },
      "header": {
        "type": "Header",
        "children": [
          "titleRow",
          "subhead"
        ]
      },
      "titleRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center"
        },
        "children": [
          "titleIcon",
          "title"
        ]
      },
      "titleIcon": {
        "type": "Icon",
        "props": {
          "name": "MessagesSquare",
          "tone": "accent",
          "size": "sm"
        }
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "Teams Activity",
          "level": "h2"
        }
      },
      "subhead": {
        "type": "Caption",
        "props": {
          "tone": "muted",
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{today} today · {total} recent",
              "today": {
                "$computed": "count",
                "args": {
                  "value": {
                    "$computed": "filter_date_range",
                    "args": {
                      "value": {
                        "$state": "/m365-teams/list_chats"
                      },
                      "field": "lastUpdatedDateTime"
                    }
                  }
                }
              },
              "total": {
                "$computed": "count",
                "args": {
                  "value": {
                    "$state": "/m365-teams/list_chats"
                  }
                }
              }
            }
          }
        },
        "visible": {
          "$state": "/_loading/m365-teams.list_chats",
          "not": true
        }
      },
      "body": {
        "type": "Body",
        "children": [
          "loading",
          "empty",
          "list"
        ]
      },
      "loading": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "visible": {
          "$state": "/_loading/m365-teams.list_chats"
        },
        "children": [
          "sk1",
          "sk2",
          "sk3"
        ]
      },
      "sk1": {
        "type": "Skeleton",
        "props": {
          "height": "3rem",
          "rounded": "md"
        }
      },
      "sk2": {
        "type": "Skeleton",
        "props": {
          "height": "3rem",
          "rounded": "md"
        }
      },
      "sk3": {
        "type": "Skeleton",
        "props": {
          "height": "3rem",
          "rounded": "md"
        }
      },
      "empty": {
        "type": "Empty",
        "props": {
          "message": "All caught up — no recent Teams activity."
        },
        "visible": {
          "$and": [
            {
              "$state": "/_loading/m365-teams.list_chats",
              "not": true
            },
            {
              "$state": "/m365-teams/list_chats/0",
              "not": true
            }
          ]
        }
      },
      "list": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "repeat": {
          "statePath": "/m365-teams/list_chats",
          "key": "id"
        },
        "children": [
          "row"
        ],
        "visible": {
          "$state": "/_loading/m365-teams.list_chats",
          "not": true
        }
      },
      "row": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center",
          "justify": "between",
          "hover": true,
          "clickable": true
        },
        "children": [
          "rowLeft",
          "rowRight"
        ],
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "url": {
                "$cond": {
                  "$item": "webUrl"
                },
                "$then": {
                  "$computed": "identity",
                  "args": {
                    "value": {
                      "$item": "webUrl"
                    }
                  }
                },
                "$else": {
                  "$computed": "fmt",
                  "args": {
                    "pattern": "https://teams.microsoft.com/_#/conversations/{id}?ctx=chat",
                    "id": {
                      "$item": "id"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "rowLeft": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center",
          "grow": true
        },
        "children": [
          "avatar",
          "labels"
        ]
      },
      "avatar": {
        "type": "Avatar",
        "props": {
          "size": "sm",
          "initials": {
            "$computed": "initials",
            "args": {
              "value": {
                "$cond": {
                  "$item": "lastMessagePreview/from/user/displayName"
                },
                "$then": {
                  "$item": "lastMessagePreview/from/user/displayName"
                },
                "$else": {
                  "$item": "topic"
                }
              }
            }
          }
        }
      },
      "labels": {
        "type": "Stack",
        "props": {
          "gap": "xs",
          "grow": true
        },
        "children": [
          "topLine",
          "snippet"
        ]
      },
      "topLine": {
        "type": "Row",
        "props": {
          "gap": "xs",
          "align": "baseline"
        },
        "children": [
          "sender",
          "topicSuffix"
        ]
      },
      "sender": {
        "type": "Text",
        "props": {
          "size": "sm",
          "weight": "medium",
          "truncate": true,
          "text": {
            "$cond": {
              "$item": "lastMessagePreview/from/user/displayName"
            },
            "$then": {
              "$item": "lastMessagePreview/from/user/displayName"
            },
            "$else": {
              "$item": "topic"
            }
          }
        }
      },
      "topicSuffix": {
        "type": "Text",
        "props": {
          "size": "xs",
          "tone": "muted",
          "truncate": true,
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "in {topic}",
              "topic": {
                "$item": "topic"
              }
            }
          }
        },
        "visible": {
          "$and": [
            {
              "$item": "lastMessagePreview/from/user/displayName"
            },
            {
              "$item": "topic"
            },
            {
              "$item": "chatType",
              "neq": "oneOnOne"
            }
          ]
        }
      },
      "snippet": {
        "type": "Text",
        "props": {
          "size": "xs",
          "tone": "muted",
          "truncate": true,
          "text": {
            "$computed": "html_to_text",
            "args": {
              "value": {
                "$item": "lastMessagePreview/body/content"
              },
              "maxLength": 140
            }
          }
        },
        "visible": {
          "$item": "lastMessagePreview/body/content"
        }
      },
      "rowRight": {
        "type": "Stack",
        "props": {
          "gap": "xs",
          "align": "end"
        },
        "children": [
          "time",
          "typeHint"
        ]
      },
      "time": {
        "type": "Caption",
        "props": {
          "tone": "muted",
          "text": {
            "$computed": "relative_time",
            "args": {
              "value": {
                "$item": "lastUpdatedDateTime"
              }
            }
          }
        },
        "visible": {
          "$item": "lastUpdatedDateTime"
        }
      },
      "typeHint": {
        "type": "Caption",
        "props": {
          "tone": "muted",
          "text": {
            "$item": "chatType"
          }
        },
        "visible": {
          "$item": "chatType",
          "neq": "oneOnOne"
        }
      }
    }
  },
  "status": "published"
}
