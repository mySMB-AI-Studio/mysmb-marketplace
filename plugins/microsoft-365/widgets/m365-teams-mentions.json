{
  "id": "m365-teams-mentions",
  "title": "Teams Activity",
  "description": "Recent Teams chats — unread first, grouped by recency, with sender, snippet, and one-click open.",
  "category": "productivity",
  "tags": [
    "m365",
    "teams",
    "chats",
    "activity",
    "unread"
  ],
  "keywords": [
    "teams",
    "chats",
    "activity",
    "recent",
    "unread",
    "messages"
  ],
  "connectorsUsed": [
    "m365-teams"
  ],
  "popularity": 70,
  "sizing": {
    "preferred": {
      "colSpan": 6,
      "rowSpan": 6
    },
    "min": {
      "colSpan": 4,
      "rowSpan": 4
    },
    "max": {
      "colSpan": 12,
      "rowSpan": 12
    }
  },
  "dataProvider": {
    "mcp": "m365-teams",
    "tool": "list_chats",
    "params": {
      "limit": 25
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "children": [
          "header",
          "body"
        ]
      },
      "header": {
        "type": "Header",
        "children": [
          "titleRow",
          "subhead"
        ]
      },
      "titleRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center"
        },
        "children": [
          "titleIcon",
          "title"
        ]
      },
      "titleIcon": {
        "type": "Icon",
        "props": {
          "name": "MessagesSquare",
          "tone": "accent",
          "size": "sm"
        }
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "Teams Activity",
          "level": "h2"
        }
      },
      "subhead": {
        "type": "Caption",
        "props": {
          "tone": "muted",
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{unread} unread · {today} today · {total} recent",
              "unread": {
                "$computed": "count_where",
                "args": {
                  "value": {
                    "$state": "/m365-teams/list_chats"
                  },
                  "whereField": "unread",
                  "equals": true
                }
              },
              "today": {
                "$computed": "count_where",
                "args": {
                  "value": {
                    "$state": "/m365-teams/list_chats"
                  },
                  "whereField": "bucket",
                  "equals": "today"
                }
              },
              "total": {
                "$computed": "count",
                "args": {
                  "value": {
                    "$state": "/m365-teams/list_chats"
                  }
                }
              }
            }
          }
        },
        "visible": {
          "$state": "/_loading/m365-teams.list_chats",
          "not": true
        }
      },
      "body": {
        "type": "Body",
        "children": [
          "loading",
          "empty",
          "groupToday",
          "groupWeek",
          "groupEarlier"
        ]
      },
      "loading": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "visible": {
          "$state": "/_loading/m365-teams.list_chats"
        },
        "children": [
          "sk1",
          "sk2",
          "sk3"
        ]
      },
      "sk1": {
        "type": "Skeleton",
        "props": {
          "height": "3rem",
          "rounded": "md"
        }
      },
      "sk2": {
        "type": "Skeleton",
        "props": {
          "height": "3rem",
          "rounded": "md"
        }
      },
      "sk3": {
        "type": "Skeleton",
        "props": {
          "height": "3rem",
          "rounded": "md"
        }
      },
      "empty": {
        "type": "Empty",
        "props": {
          "message": "All caught up — no recent Teams activity."
        },
        "visible": {
          "$and": [
            {
              "$state": "/_loading/m365-teams.list_chats",
              "not": true
            },
            {
              "$state": "/m365-teams/list_chats/0",
              "not": true
            }
          ]
        }
      },
      "groupToday": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "children": [
          "headingToday",
          "listToday"
        ],
        "visible": {
          "$and": [
            {
              "$state": "/_loading/m365-teams.list_chats",
              "not": true
            },
            {
              "$state": "/m365-teams/list_chats/0"
            }
          ]
        }
      },
      "headingToday": {
        "type": "Eyebrow",
        "props": {
          "text": "Today"
        }
      },
      "listToday": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "repeat": {
          "statePath": "/m365-teams/list_chats",
          "key": "id"
        },
        "children": [
          "rowToday"
        ]
      },
      "rowToday": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center",
          "justify": "between",
          "hover": true,
          "clickable": true
        },
        "children": [
          "rowLeft",
          "rowRight"
        ],
        "visible": {
          "$item": "bucket",
          "eq": "today"
        },
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "url": {
                "$computed": "identity",
                "args": {
                  "value": {
                    "$item": "webUrl"
                  }
                }
              }
            }
          }
        }
      },
      "groupWeek": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "children": [
          "headingWeek",
          "listWeek"
        ],
        "visible": {
          "$and": [
            {
              "$state": "/_loading/m365-teams.list_chats",
              "not": true
            },
            {
              "$state": "/m365-teams/list_chats/0"
            }
          ]
        }
      },
      "headingWeek": {
        "type": "Eyebrow",
        "props": {
          "text": "This week"
        }
      },
      "listWeek": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "repeat": {
          "statePath": "/m365-teams/list_chats",
          "key": "id"
        },
        "children": [
          "rowWeek"
        ]
      },
      "rowWeek": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center",
          "justify": "between",
          "hover": true,
          "clickable": true
        },
        "children": [
          "rowLeft",
          "rowRight"
        ],
        "visible": {
          "$item": "bucket",
          "eq": "week"
        },
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "url": {
                "$computed": "identity",
                "args": {
                  "value": {
                    "$item": "webUrl"
                  }
                }
              }
            }
          }
        }
      },
      "groupEarlier": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "children": [
          "headingEarlier",
          "listEarlier"
        ],
        "visible": {
          "$and": [
            {
              "$state": "/_loading/m365-teams.list_chats",
              "not": true
            },
            {
              "$state": "/m365-teams/list_chats/0"
            }
          ]
        }
      },
      "headingEarlier": {
        "type": "Eyebrow",
        "props": {
          "text": "Earlier"
        }
      },
      "listEarlier": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "repeat": {
          "statePath": "/m365-teams/list_chats",
          "key": "id"
        },
        "children": [
          "rowEarlier"
        ]
      },
      "rowEarlier": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center",
          "justify": "between",
          "hover": true,
          "clickable": true
        },
        "children": [
          "rowLeft",
          "rowRight"
        ],
        "visible": {
          "$item": "bucket",
          "eq": "earlier"
        },
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "url": {
                "$computed": "identity",
                "args": {
                  "value": {
                    "$item": "webUrl"
                  }
                }
              }
            }
          }
        }
      },
      "rowLeft": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center",
          "grow": true
        },
        "children": [
          "unreadDot",
          "avatar",
          "labels"
        ]
      },
      "unreadDot": {
        "type": "Dot",
        "props": {
          "tone": "accent",
          "size": "sm"
        },
        "visible": {
          "$item": "unread",
          "eq": true
        }
      },
      "avatar": {
        "type": "Avatar",
        "props": {
          "size": "sm",
          "initials": {
            "$computed": "initials",
            "args": {
              "value": {
                "$cond": {
                  "$item": "senderName"
                },
                "$then": {
                  "$item": "senderName"
                },
                "$else": {
                  "$item": "displayName"
                }
              }
            }
          }
        }
      },
      "labels": {
        "type": "Stack",
        "props": {
          "gap": "xs",
          "grow": true
        },
        "children": [
          "topLine",
          "snippet"
        ]
      },
      "topLine": {
        "type": "Row",
        "props": {
          "gap": "xs",
          "align": "baseline"
        },
        "children": [
          "primaryLabel",
          "topicSuffix"
        ]
      },
      "primaryLabel": {
        "type": "Text",
        "props": {
          "size": "sm",
          "truncate": true,
          "weight": {
            "$cond": {
              "$item": "unread",
              "eq": true
            },
            "$then": "semibold",
            "$else": "medium"
          },
          "text": {
            "$cond": {
              "$item": "senderName"
            },
            "$then": {
              "$item": "senderName"
            },
            "$else": {
              "$item": "displayName"
            }
          }
        }
      },
      "topicSuffix": {
        "type": "Text",
        "props": {
          "size": "xs",
          "tone": "muted",
          "truncate": true,
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "in {topic}",
              "topic": {
                "$item": "displayName"
              }
            }
          }
        },
        "visible": {
          "$and": [
            {
              "$item": "senderName"
            },
            {
              "$item": "chatType",
              "neq": "oneOnOne"
            }
          ]
        }
      },
      "snippet": {
        "type": "Text",
        "props": {
          "size": "xs",
          "tone": "muted",
          "truncate": true,
          "text": {
            "$item": "snippet"
          }
        },
        "visible": {
          "$item": "snippet"
        }
      },
      "rowRight": {
        "type": "Stack",
        "props": {
          "gap": "xs",
          "align": "end"
        },
        "children": [
          "time",
          "typeHint"
        ]
      },
      "time": {
        "type": "Caption",
        "props": {
          "tone": "muted",
          "text": {
            "$item": "relativeTime"
          }
        },
        "visible": {
          "$item": "relativeTime"
        }
      },
      "typeHint": {
        "type": "Caption",
        "props": {
          "tone": "muted",
          "text": {
            "$item": "chatType"
          }
        },
        "visible": {
          "$item": "chatType",
          "neq": "oneOnOne"
        }
      }
    }
  },
  "status": "published"
}
