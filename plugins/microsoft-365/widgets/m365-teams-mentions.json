{
  "id": "m365-teams-mentions",
  "title": "Teams Activity",
  "description": "Recent Teams chats — unread first, with sender, snippet, and inline reply. Click any chat for a chat-bubble drawer with composer pinned at the bottom.",
  "category": "productivity",
  "tags": [
    "m365",
    "teams",
    "chats",
    "activity",
    "unread",
    "mentions"
  ],
  "keywords": [
    "teams",
    "chats",
    "activity",
    "recent",
    "unread",
    "mentions",
    "messages"
  ],
  "connectorsUsed": [
    "m365-teams"
  ],
  "popularity": 70,
  "sizing": {
    "preferred": {
      "colSpan": 6,
      "rowSpan": 7
    },
    "min": {
      "colSpan": 4,
      "rowSpan": 5
    },
    "max": {
      "colSpan": 12,
      "rowSpan": 12
    }
  },
  "dataProvider": {
    "mcp": "m365-teams",
    "tool": "list_chats",
    "params": {
      "limit": 25
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "children": [
          "header",
          "body",
          "drawer"
        ],
        "watch": {
          "/m365-teams/list_chats": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/teamsUnreadCount",
                "value": {
                  "$computed": "count_where",
                  "args": {
                    "value": {
                      "$state": "/m365-teams/list_chats"
                    },
                    "whereField": "unread",
                    "equals": true
                  }
                }
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/teamsMentionCount",
                "value": {
                  "$computed": "count_where",
                  "args": {
                    "value": {
                      "$state": "/m365-teams/list_chats"
                    },
                    "whereField": "mentionsMe",
                    "equals": true
                  }
                }
              }
            }
          ]
        }
      },
      "header": {
        "type": "Header",
        "children": [
          "titleRow",
          "filterBar"
        ]
      },
      "titleRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center"
        },
        "children": [
          "titleIcon",
          "title"
        ]
      },
      "titleIcon": {
        "type": "Icon",
        "props": {
          "name": "MessagesSquare",
          "tone": "accent",
          "size": "sm"
        }
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "Teams Activity",
          "level": "h2"
        }
      },
      "filterBar": {
        "type": "Row",
        "props": {
          "gap": "xs",
          "align": "center"
        },
        "children": [
          "filterAll",
          "filterUnread",
          "filterMentions"
        ],
        "visible": {
          "$state": "/_loading/m365-teams.list_chats",
          "not": true
        }
      },
      "filterAll": {
        "type": "Button",
        "props": {
          "label": "All",
          "size": "sm",
          "variant": {
            "$cond": {
              "$and": [
                {
                  "$state": "/ui/teamsFilter",
                  "neq": "unread"
                },
                {
                  "$state": "/ui/teamsFilter",
                  "neq": "mentions"
                }
              ]
            },
            "$then": "primary",
            "$else": "ghost"
          }
        },
        "on": {
          "click": {
            "action": "setState",
            "params": {
              "statePath": "/ui/teamsFilter",
              "value": "all"
            }
          }
        }
      },
      "filterUnread": {
        "type": "Button",
        "props": {
          "label": "Unread",
          "size": "sm",
          "variant": {
            "$cond": {
              "$state": "/ui/teamsFilter",
              "eq": "unread"
            },
            "$then": "primary",
            "$else": "ghost"
          }
        },
        "on": {
          "click": {
            "action": "setState",
            "params": {
              "statePath": "/ui/teamsFilter",
              "value": "unread"
            }
          }
        }
      },
      "filterMentions": {
        "type": "Button",
        "props": {
          "label": "Mentions",
          "size": "sm",
          "variant": {
            "$cond": {
              "$state": "/ui/teamsFilter",
              "eq": "mentions"
            },
            "$then": "primary",
            "$else": "ghost"
          }
        },
        "on": {
          "click": {
            "action": "setState",
            "params": {
              "statePath": "/ui/teamsFilter",
              "value": "mentions"
            }
          }
        }
      },
      "body": {
        "type": "Body",
        "children": [
          "loading",
          "empty",
          "emptyUnread",
          "emptyMentions",
          "list"
        ]
      },
      "loading": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "visible": {
          "$state": "/_loading/m365-teams.list_chats"
        },
        "children": [
          "loadingHeader",
          "sk1",
          "sk2",
          "sk3"
        ]
      },
      "loadingHeader": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center"
        },
        "children": [
          "loadingSpinner",
          "loadingLabel"
        ]
      },
      "loadingSpinner": {
        "type": "Spinner",
        "props": {
          "size": "sm"
        }
      },
      "loadingLabel": {
        "type": "Caption",
        "props": {
          "tone": "muted",
          "text": "Loading chats…"
        }
      },
      "sk1": {
        "type": "Skeleton",
        "props": {
          "height": "3rem",
          "rounded": "md"
        }
      },
      "sk2": {
        "type": "Skeleton",
        "props": {
          "height": "3rem",
          "rounded": "md"
        }
      },
      "sk3": {
        "type": "Skeleton",
        "props": {
          "height": "3rem",
          "rounded": "md"
        }
      },
      "empty": {
        "type": "Empty",
        "props": {
          "icon": "Inbox",
          "title": "All caught up",
          "message": "No recent Teams activity."
        },
        "visible": {
          "$and": [
            {
              "$state": "/_loading/m365-teams.list_chats",
              "not": true
            },
            {
              "$state": "/m365-teams/list_chats/0",
              "not": true
            }
          ]
        }
      },
      "emptyUnread": {
        "type": "Empty",
        "props": {
          "icon": "CheckCircle2",
          "title": "Inbox zero",
          "message": "No unread chats. Switch to All to see your recent activity."
        },
        "visible": {
          "$and": [
            {
              "$state": "/_loading/m365-teams.list_chats",
              "not": true
            },
            {
              "$state": "/m365-teams/list_chats/0"
            },
            {
              "$state": "/ui/teamsFilter",
              "eq": "unread"
            },
            {
              "$state": "/ui/teamsUnreadCount",
              "eq": 0
            }
          ]
        }
      },
      "emptyMentions": {
        "type": "Empty",
        "props": {
          "icon": "AtSign",
          "title": "No mentions",
          "message": "Nobody has @-mentioned you in your recent chats."
        },
        "visible": {
          "$and": [
            {
              "$state": "/_loading/m365-teams.list_chats",
              "not": true
            },
            {
              "$state": "/m365-teams/list_chats/0"
            },
            {
              "$state": "/ui/teamsFilter",
              "eq": "mentions"
            },
            {
              "$state": "/ui/teamsMentionCount",
              "eq": 0
            }
          ]
        }
      },
      "list": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "repeat": {
          "statePath": "/m365-teams/list_chats",
          "key": "id"
        },
        "children": [
          "row"
        ],
        "visible": {
          "$state": "/_loading/m365-teams.list_chats",
          "not": true
        }
      },
      "row": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center",
          "justify": "between",
          "hover": true,
          "clickable": true
        },
        "children": [
          "rowLeft",
          "rowRight"
        ],
        "visible": {
          "$and": [
            {
              "$or": [
                {
                  "$state": "/ui/teamsFilter",
                  "neq": "unread"
                },
                {
                  "$item": "unread",
                  "eq": true
                }
              ]
            },
            {
              "$or": [
                {
                  "$state": "/ui/teamsFilter",
                  "neq": "mentions"
                },
                {
                  "$item": "mentionsMe",
                  "eq": true
                }
              ]
            }
          ]
        },
        "on": {
          "click": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/teamsActiveChatId",
                "value": {
                  "$computed": "identity",
                  "args": {
                    "value": {
                      "$item": "id"
                    }
                  }
                }
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/teamsActiveChatName",
                "value": {
                  "$computed": "identity",
                  "args": {
                    "value": {
                      "$item": "displayName"
                    }
                  }
                }
              }
            },
            {
              "action": "m365-teams.list_messages",
              "params": {
                "chatId": {
                  "$computed": "identity",
                  "args": {
                    "value": {
                      "$item": "id"
                    }
                  }
                },
                "limit": 15
              }
            },
            {
              "action": "m365-teams.mark_chat_read",
              "params": {
                "chatId": {
                  "$computed": "identity",
                  "args": {
                    "value": {
                      "$item": "id"
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "rowLeft": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center",
          "grow": true
        },
        "children": [
          "unreadDot",
          "avatar",
          "labels"
        ]
      },
      "unreadDot": {
        "type": "Dot",
        "props": {
          "tone": {
            "$cond": {
              "$item": "mentionsMe",
              "eq": true
            },
            "$then": "destructive",
            "$else": "accent"
          },
          "size": "sm"
        },
        "visible": {
          "$item": "unread",
          "eq": true
        }
      },
      "avatar": {
        "type": "Avatar",
        "props": {
          "size": "sm",
          "initials": {
            "$computed": "initials",
            "args": {
              "value": {
                "$cond": {
                  "$item": "senderName"
                },
                "$then": {
                  "$item": "senderName"
                },
                "$else": {
                  "$item": "displayName"
                }
              }
            }
          }
        }
      },
      "labels": {
        "type": "Stack",
        "props": {
          "gap": "xs",
          "grow": true
        },
        "children": [
          "topLine",
          "snippet"
        ]
      },
      "topLine": {
        "type": "Row",
        "props": {
          "gap": "xs",
          "align": "baseline"
        },
        "children": [
          "primaryLabel",
          "topicSuffix",
          "mentionPill"
        ]
      },
      "primaryLabel": {
        "type": "Text",
        "props": {
          "size": "sm",
          "truncate": true,
          "weight": {
            "$cond": {
              "$item": "unread",
              "eq": true
            },
            "$then": "semibold",
            "$else": "medium"
          },
          "text": {
            "$cond": {
              "$item": "senderName"
            },
            "$then": {
              "$item": "senderName"
            },
            "$else": {
              "$item": "displayName"
            }
          }
        }
      },
      "topicSuffix": {
        "type": "Text",
        "props": {
          "size": "xs",
          "tone": "muted",
          "truncate": true,
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "in {topic}",
              "topic": {
                "$item": "topic"
              }
            }
          }
        },
        "visible": {
          "$and": [
            {
              "$item": "senderName"
            },
            {
              "$item": "topic"
            }
          ]
        }
      },
      "mentionPill": {
        "type": "Badge",
        "props": {
          "text": "@you",
          "tone": "destructive",
          "variant": "soft"
        },
        "visible": {
          "$item": "mentionsMe",
          "eq": true
        }
      },
      "snippet": {
        "type": "Text",
        "props": {
          "size": "xs",
          "tone": "muted",
          "truncate": true,
          "text": {
            "$cond": {
              "$item": "snippet"
            },
            "$then": {
              "$item": "snippet"
            },
            "$else": {
              "$item": "snippetFallback"
            }
          }
        }
      },
      "rowRight": {
        "type": "Stack",
        "props": {
          "gap": "xs",
          "align": "end"
        },
        "children": [
          "time",
          "reactionSummary"
        ]
      },
      "time": {
        "type": "Caption",
        "props": {
          "tone": "muted",
          "text": {
            "$item": "relativeTime"
          }
        },
        "visible": {
          "$item": "relativeTime"
        }
      },
      "reactionSummary": {
        "type": "Caption",
        "props": {
          "tone": "muted",
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "♥ {count}",
              "count": {
                "$item": "reactions/0/count"
              }
            }
          }
        },
        "visible": {
          "$item": "reactions/0/count"
        }
      },
      "drawer": {
        "type": "Overlay",
        "props": {
          "maxWidth": "32rem"
        },
        "children": [
          "drawerCard"
        ],
        "visible": {
          "$state": "/ui/teamsActiveChatId"
        },
        "on": {
          "backdropClick": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/teamsActiveChatId",
                "value": ""
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/teamsReplyText",
                "value": ""
              }
            },
            {
              "action": "m365-teams.list_chats",
              "params": {
                "limit": 25
              }
            }
          ]
        }
      },
      "drawerCard": {
        "type": "Card",
        "children": [
          "drawerHeader",
          "drawerBody",
          "drawerComposerArea"
        ]
      },
      "drawerHeader": {
        "type": "Header",
        "children": [
          "drawerTitleRow"
        ]
      },
      "drawerTitleRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center",
          "justify": "between"
        },
        "children": [
          "drawerTitle",
          "drawerCloseBtn"
        ]
      },
      "drawerTitle": {
        "type": "Heading",
        "props": {
          "text": {
            "$state": "/ui/teamsActiveChatName"
          },
          "level": "h2"
        }
      },
      "drawerCloseBtn": {
        "type": "IconButton",
        "props": {
          "icon": "X",
          "tone": "muted",
          "ariaLabel": "Close"
        },
        "on": {
          "click": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/teamsActiveChatId",
                "value": ""
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/teamsReplyText",
                "value": ""
              }
            },
            {
              "action": "m365-teams.list_chats",
              "params": {
                "limit": 25
              }
            }
          ]
        }
      },
      "drawerBody": {
        "type": "Body",
        "children": [
          "drawerLoading",
          "drawerEmpty",
          "drawerMessages"
        ]
      },
      "drawerLoading": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center"
        },
        "children": [
          "drawerLoadingSpinner",
          "drawerLoadingLabel"
        ],
        "visible": {
          "$state": "/_loading/m365-teams.list_messages"
        }
      },
      "drawerLoadingSpinner": {
        "type": "Spinner",
        "props": {
          "size": "sm"
        }
      },
      "drawerLoadingLabel": {
        "type": "Caption",
        "props": {
          "tone": "muted",
          "text": "Loading conversation…"
        }
      },
      "drawerEmpty": {
        "type": "Empty",
        "props": {
          "icon": "MessageCircle",
          "title": "No messages yet",
          "message": "Be the first to say something."
        },
        "visible": {
          "$and": [
            {
              "$state": "/_loading/m365-teams.list_messages",
              "not": true
            },
            {
              "$state": "/m365-teams/list_messages/0",
              "not": true
            }
          ]
        }
      },
      "drawerMessages": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "messageRowOther",
          "messageRowMe"
        ],
        "repeat": {
          "statePath": "/m365-teams/list_messages",
          "key": "id"
        },
        "visible": {
          "$state": "/_loading/m365-teams.list_messages",
          "not": true
        }
      },
      "messageRowOther": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "start",
          "justify": "start"
        },
        "children": [
          "msgAvatar",
          "msgBubbleOther"
        ],
        "visible": {
          "$and": [
            {
              "$item": "isFromMe",
              "eq": false
            },
            {
              "$item": "isSystemEvent",
              "eq": false
            }
          ]
        }
      },
      "msgAvatar": {
        "type": "Avatar",
        "props": {
          "size": "sm",
          "initials": {
            "$computed": "initials",
            "args": {
              "value": {
                "$item": "senderName"
              }
            }
          }
        }
      },
      "msgBubbleOther": {
        "type": "Section",
        "props": {
          "variant": "muted"
        },
        "children": [
          "msgBubbleOtherHeader",
          "msgBubbleOtherText"
        ]
      },
      "msgBubbleOtherHeader": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "baseline",
          "justify": "between"
        },
        "children": [
          "msgBubbleOtherSender",
          "msgBubbleOtherTime"
        ]
      },
      "msgBubbleOtherSender": {
        "type": "Text",
        "props": {
          "size": "sm",
          "weight": "semibold",
          "text": {
            "$item": "senderName"
          }
        }
      },
      "msgBubbleOtherTime": {
        "type": "Caption",
        "props": {
          "tone": "muted",
          "text": {
            "$item": "relativeTime"
          }
        }
      },
      "msgBubbleOtherText": {
        "type": "Text",
        "props": {
          "size": "sm",
          "preserveLines": true,
          "text": {
            "$item": "text"
          }
        }
      },
      "messageRowMe": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "start",
          "justify": "end"
        },
        "children": [
          "msgBubbleMe"
        ],
        "visible": {
          "$item": "isFromMe",
          "eq": true
        }
      },
      "msgBubbleMe": {
        "type": "Section",
        "props": {
          "variant": "bordered"
        },
        "children": [
          "msgBubbleMeHeader",
          "msgBubbleMeText"
        ]
      },
      "msgBubbleMeHeader": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "baseline",
          "justify": "end"
        },
        "children": [
          "msgBubbleMeTime"
        ]
      },
      "msgBubbleMeTime": {
        "type": "Caption",
        "props": {
          "tone": "accent",
          "text": {
            "$item": "relativeTime"
          }
        }
      },
      "msgBubbleMeText": {
        "type": "Text",
        "props": {
          "size": "sm",
          "preserveLines": true,
          "text": {
            "$item": "text"
          }
        }
      },
      "drawerComposerArea": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "drawerComposer",
          "drawerSendBtn"
        ]
      },
      "drawerComposer": {
        "type": "TextInput",
        "props": {
          "value": {
            "$bindState": "/ui/teamsReplyText"
          },
          "placeholder": "Type a reply…"
        }
      },
      "drawerSendBtn": {
        "type": "Button",
        "props": {
          "label": "Send",
          "variant": "primary",
          "size": "sm",
          "leadingIcon": "Send",
          "disabled": {
            "$cond": {
              "$state": "/ui/teamsReplyText"
            },
            "$then": false,
            "$else": true
          }
        },
        "on": {
          "click": [
            {
              "action": "m365-teams.send_message",
              "params": {
                "chatId": {
                  "$state": "/ui/teamsActiveChatId"
                },
                "content": {
                  "$state": "/ui/teamsReplyText"
                }
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/teamsReplyText",
                "value": ""
              }
            },
            {
              "action": "m365-teams.list_messages",
              "params": {
                "chatId": {
                  "$state": "/ui/teamsActiveChatId"
                },
                "limit": 15
              }
            }
          ]
        }
      }
    }
  },
  "status": "published"
}
