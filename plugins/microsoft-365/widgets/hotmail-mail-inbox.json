{
  "id": "hotmail-mail-inbox",
  "title": "Hotmail Inbox",
  "description": "Inbox, Sent, and Drafts from a personal Hotmail/Outlook.com/Live.com account, with unread indicator and colored sender avatars. Drafts are view-only — opening one shows its content, not an editor.",
  "category": "productivity",
  "tags": [
    "hotmail",
    "outlook.com",
    "live.com",
    "personal",
    "email",
    "inbox",
    "productivity"
  ],
  "keywords": [
    "hotmail",
    "outlook.com",
    "live.com",
    "personal email",
    "email",
    "inbox",
    "message",
    "messages",
    "mail",
    "unread"
  ],
  "connectorsUsed": [
    "hotmail-mail"
  ],
  "popularity": 0,
  "sizing": {
    "preferred": {
      "colSpan": 7,
      "rowSpan": 5
    },
    "min": {
      "colSpan": 4,
      "rowSpan": 4
    },
    "max": {
      "colSpan": 12,
      "rowSpan": 12
    }
  },
  "dataProvider": {
    "mcp": "hotmail-mail",
    "tool": "list_emails",
    "params": {
      "folder": "inbox",
      "limit": 50
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "children": [
          "header",
          "tabDivider",
          "tabBar",
          "body",
          "overlay"
        ]
      },
      "tabDivider": { "type": "Divider", "props": {} },
      "tabBar": {
        "type": "Row",
        "props": { "gap": "xs" },
        "children": ["inboxTabBtn", "sentTabBtn", "draftsTabBtn"]
      },
      "inboxTabBtn": {
        "type": "Button",
        "props": {
          "label": "Inbox",
          "leadingIcon": "Inbox",
          "size": "sm",
          "variant": {
            "$computed": "microsoft-365_tab_variant",
            "args": { "active": { "$computed": "microsoft-365_default_tab", "args": { "value": { "$state": "/ui/activeTab" } } }, "match": "inbox" }
          },
          "tone": {
            "$computed": "microsoft-365_tab_tone",
            "args": { "active": { "$computed": "microsoft-365_default_tab", "args": { "value": { "$state": "/ui/activeTab" } } }, "match": "inbox" }
          }
        },
        "on": {
          "click": [
            { "action": "setState", "params": { "statePath": "/ui/activeTab", "value": "inbox" } },
            { "action": "hotmail-mail.list_emails", "params": { "folder": "inbox", "limit": 50 } }
          ]
        }
      },
      "sentTabBtn": {
        "type": "Button",
        "props": {
          "label": "Sent",
          "leadingIcon": "Send",
          "size": "sm",
          "variant": {
            "$computed": "microsoft-365_tab_variant",
            "args": { "active": { "$computed": "microsoft-365_default_tab", "args": { "value": { "$state": "/ui/activeTab" } } }, "match": "sent" }
          },
          "tone": {
            "$computed": "microsoft-365_tab_tone",
            "args": { "active": { "$computed": "microsoft-365_default_tab", "args": { "value": { "$state": "/ui/activeTab" } } }, "match": "sent" }
          }
        },
        "on": {
          "click": [
            { "action": "setState", "params": { "statePath": "/ui/activeTab", "value": "sent" } },
            { "action": "hotmail-mail.list_emails", "params": { "folder": "sentitems", "limit": 50 } }
          ]
        }
      },
      "draftsTabBtn": {
        "type": "Button",
        "props": {
          "label": "Drafts",
          "leadingIcon": "FileEdit",
          "size": "sm",
          "variant": {
            "$computed": "microsoft-365_tab_variant",
            "args": { "active": { "$computed": "microsoft-365_default_tab", "args": { "value": { "$state": "/ui/activeTab" } } }, "match": "drafts" }
          },
          "tone": {
            "$computed": "microsoft-365_tab_tone",
            "args": { "active": { "$computed": "microsoft-365_default_tab", "args": { "value": { "$state": "/ui/activeTab" } } }, "match": "drafts" }
          }
        },
        "on": {
          "click": [
            { "action": "setState", "params": { "statePath": "/ui/activeTab", "value": "drafts" } },
            { "action": "hotmail-mail.list_emails", "params": { "folder": "drafts", "limit": 50 } }
          ]
        }
      },
      "header": {
        "type": "Header",
        "children": [
          "titleGroup"
        ]
      },
      "titleGroup": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "start"
        },
        "children": [
          "titleIcon",
          "titleStack"
        ]
      },
      "titleIcon": {
        "type": "Icon",
        "props": {
          "name": "Mail",
          "tone": "accent",
          "size": "sm"
        }
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "Personal Inbox",
          "level": "h2"
        }
      },
      "unreadCount": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{n} Unread",
              "n": {
                "$computed": "count_where",
                "args": {
                  "value": {
                    "$state": "/hotmail-mail/list_emails"
                  },
                  "whereField": "isRead",
                  "equals": false
                }
              }
            }
          }
        },
        "visible": {
          "$and": [
            { "$state": "/ui/activeTab", "neq": "sent" },
            { "$state": "/ui/activeTab", "neq": "drafts" }
          ]
        }
      },
      "body": {
        "type": "Body",
        "children": [
          "loading",
          "empty",
          "list"
        ]
      },
      "loading": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "s1",
          "s2",
          "s3",
          "s4"
        ],
        "visible": {
          "$state": "/_loading/hotmail-mail.list_emails"
        }
      },
      "s1": {
        "type": "Skeleton",
        "props": {
          "height": "2.75rem",
          "rounded": "md"
        }
      },
      "s2": {
        "type": "Skeleton",
        "props": {
          "height": "2.75rem",
          "rounded": "md"
        }
      },
      "s3": {
        "type": "Skeleton",
        "props": {
          "height": "2.75rem",
          "rounded": "md"
        }
      },
      "s4": {
        "type": "Skeleton",
        "props": {
          "height": "2.75rem",
          "rounded": "md"
        }
      },
      "empty": {
        "type": "Empty",
        "props": {
          "message": {
            "$computed": "microsoft-365_mail_folder_empty_message",
            "args": { "tab": { "$state": "/ui/activeTab" } }
          }
        },
        "visible": {
          "$and": [
            {
              "$state": "/_loading/hotmail-mail.list_emails",
              "not": true
            },
            {
              "$state": "/hotmail-mail/list_emails/0",
              "not": true
            }
          ]
        }
      },
      "list": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "children": [
          "row"
        ],
        "repeat": {
          "statePath": "/hotmail-mail/list_emails",
          "key": "id"
        },
        "visible": {
          "$state": "/_loading/hotmail-mail.list_emails",
          "not": true
        }
      },
      "row": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "start",
          "hover": true,
          "clickable": true,
          "justify": "between"
        },
        "children": [
          "unreadDot",
          "avatar",
          "labels",
          "receivedCol"
        ],
        "on": {
          "click": [
            {
              "action": "setState",
              "params": {
                "statePath": "/hotmail-mail/get_email",
                "value": {}
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/_errors/hotmail-mail.get_email",
                "value": ""
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/selectedEmailId",
                "value": {
                  "$computed": "identity",
                  "args": {
                    "value": {
                      "$item": "id"
                    }
                  }
                }
              }
            },
            {
              "action": "hotmail-mail.get_email",
              "params": {
                "id": {
                  "$computed": "identity",
                  "args": {
                    "value": {
                      "$item": "id"
                    }
                  }
                },
                "_accountId": {
                  "$computed": "identity",
                  "args": {
                    "value": {
                      "$item": "_account/accountId"
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "unreadDot": {
        "type": "Dot",
        "props": {
          "tone": {
            "$cond": {
              "$item": "isRead"
            },
            "$then": "muted",
            "$else": "accent"
          },
          "size": "sm"
        }
      },
      "avatar": {
        "type": "Avatar",
        "props": {
          "initials": {
            "$computed": "initials",
            "args": {
              "value": {
                "$item": "from/emailAddress/name"
              }
            }
          },
          "tone": {
            "$computed": "microsoft-365_sender_tone",
            "args": {
              "value": {
                "$item": "from/emailAddress/name"
              }
            }
          },
          "size": "sm"
        }
      },
      "labels": {
        "type": "Stack",
        "props": {
          "gap": "xs",
          "grow": true
        },
        "children": [
          "labelTop",
          "labelBottom"
        ]
      },
      "labelTop": {
        "type": "Text",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{name} — {subject}",
              "name": {
                "$item": "from/emailAddress/name"
              },
              "subject": {
                "$item": "subject"
              }
            }
          },
          "size": "md",
          "weight": "medium",
          "truncate": true
        }
      },
      "labelBottom": {
        "type": "Text",
        "props": {
          "text": {
            "$computed": "email_preview",
            "args": {
              "value": {
                "$item": "bodyPreview"
              },
              "maxLength": 140
            }
          },
          "size": "sm",
          "tone": "muted"
        }
      },
      "received": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "relative_time",
            "args": {
              "value": {
                "$item": "receivedDateTime"
              }
            }
          }
        }
      },
      "overlay": {
        "type": "Overlay",
        "props": {
          "maxWidth": "48rem"
        },
        "children": [
          "detailCard"
        ],
        "visible": {
          "$state": "/ui/selectedEmailId"
        },
        "on": {
          "backdropClick": {
            "action": "setState",
            "params": {
              "statePath": "/ui/selectedEmailId",
              "value": ""
            }
          }
        }
      },
      "detailCard": {
        "type": "Card",
        "children": [
          "detailHeader",
          "detailSpinner",
          "detailError",
          "detailBody"
        ]
      },
      "detailHeader": {
        "type": "Row",
        "children": [
          "detailTitle",
          "detailClose"
        ],
        "props": {
          "gap": "sm",
          "align": "center",
          "justify": "between"
        }
      },
      "detailTitle": {
        "type": "Heading",
        "props": {
          "text": {
            "$state": "/hotmail-mail/get_email/subject"
          },
          "level": "h2"
        }
      },
      "detailClose": {
        "type": "IconButton",
        "props": {
          "icon": "X",
          "tone": "default",
          "ariaLabel": "Close",
          "size": "md",
          "variant": "outlined"
        },
        "on": {
          "click": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/selectedEmailId",
                "value": ""
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/replyText",
                "value": ""
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/replySent",
                "value": ""
              }
            }
          ]
        }
      },
      "detailSpinner": {
        "type": "Spinner",
        "props": {
          "label": "Loading message…"
        },
        "visible": {
          "$and": [
            {
              "$state": "/_errors/hotmail-mail.get_email",
              "not": true
            },
            {
              "$state": "/hotmail-mail/get_email/id",
              "neq": {
                "$state": "/ui/selectedEmailId"
              }
            }
          ]
        }
      },
      "detailBody": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "kvFrom",
          "kvReceived",
          "bodyPreview",
          "actions"
        ],
        "visible": {
          "$state": "/hotmail-mail/get_email/id",
          "eq": {
            "$state": "/ui/selectedEmailId"
          }
        }
      },
      "kvFrom": {
        "type": "KeyValue",
        "props": {
          "label": "From",
          "value": {
            "$computed": "fmt",
            "args": {
              "pattern": "{name} <{addr}>",
              "name": {
                "$state": "/hotmail-mail/get_email/from/emailAddress/name"
              },
              "addr": {
                "$state": "/hotmail-mail/get_email/from/emailAddress/address"
              }
            }
          }
        }
      },
      "kvReceived": {
        "type": "KeyValue",
        "props": {
          "label": "Received",
          "value": {
            "$computed": "relative_time",
            "args": {
              "value": {
                "$state": "/hotmail-mail/get_email/receivedDateTime"
              }
            }
          }
        }
      },
      "bodyPreview": {
        "type": "Section",
        "props": {
          "variant": "muted"
        },
        "children": [
          "bodyHtml"
        ]
      },
      "bodyHtml": {
        "type": "RichHtml",
        "props": {
          "html": {
            "$state": "/hotmail-mail/get_email/body/content"
          },
          "minHeight": 120,
          "maxHeight": 520
        }
      },
      "titleStack": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "children": [
          "title",
          "unreadCount"
        ]
      },
      "openBtn": {
        "type": "Button",
        "props": {
          "label": "Open in Outlook",
          "variant": "primary",
          "size": "sm",
          "leadingIcon": "ExternalLink"
        },
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "url": {
                "$state": "/hotmail-mail/get_email/webLink"
              }
            }
          }
        }
      },
      "actions": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "justify": "end"
        },
        "children": [
          "openBtn"
        ]
      },
      "detailError": {
        "type": "Empty",
        "props": {
          "message": "Couldn’t load this message. Close and try again."
        },
        "visible": {
          "$state": "/_errors/hotmail-mail.get_email"
        }
      },
      "receivedCol": {
        "type": "Stack",
        "props": {
          "gap": "xs",
          "align": "end"
        },
        "children": [
          "received",
          "accountPill"
        ]
      },
      "accountPill": {
        "type": "Badge",
        "props": {
          "text": {
            "$item": "_account/label"
          },
          "tone": "muted",
          "variant": "soft"
        },
        "visible": {
          "$item": "_account/label"
        }
      }
    }
  }
}
