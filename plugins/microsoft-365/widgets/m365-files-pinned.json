{
  "id": "m365-files-pinned",
  "title": "Pinned Documents",
  "description": "Pin file URLs for quick access. Click to open, X to unpin.",
  "category": "productivity",
  "tags": [
    "m365",
    "files",
    "pinned",
    "bookmarks"
  ],
  "keywords": [
    "pinned",
    "bookmark",
    "favorites",
    "quick"
  ],
  "connectorsUsed": [],
  "popularity": 0,
  "sizing": {
    "preferred": {
      "colSpan": 5,
      "rowSpan": 6
    },
    "min": {
      "colSpan": 4,
      "rowSpan": 4
    },
    "max": {
      "colSpan": 10,
      "rowSpan": 10
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "children": [
          "header",
          "body"
        ]
      },
      "header": {
        "type": "Header",
        "children": [
          "titleRow"
        ]
      },
      "titleRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center"
        },
        "children": [
          "titleIcon",
          "title"
        ]
      },
      "titleIcon": {
        "type": "Icon",
        "props": {
          "name": "Pin",
          "tone": "accent",
          "size": "sm"
        }
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "Pinned documents",
          "level": "h2"
        }
      },
      "body": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "urlRow",
          "labelRow",
          "addActions",
          "empty",
          "list"
        ]
      },
      "urlRow": {
        "type": "FormRow",
        "props": {
          "label": "URL"
        },
        "children": [
          "urlInput"
        ]
      },
      "urlInput": {
        "type": "TextInput",
        "props": {
          "value": {
            "$bindState": "/ui/newUrl"
          },
          "placeholder": "https://contoso-my.sharepoint.com/…"
        }
      },
      "labelRow": {
        "type": "FormRow",
        "props": {
          "label": "Label"
        },
        "children": [
          "labelInput"
        ]
      },
      "labelInput": {
        "type": "TextInput",
        "props": {
          "value": {
            "$bindState": "/ui/newLabel"
          },
          "placeholder": "e.g. Q2 plan"
        }
      },
      "addActions": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "justify": "end"
        },
        "children": [
          "addBtn"
        ]
      },
      "addBtn": {
        "type": "Button",
        "props": {
          "label": "Pin",
          "variant": "primary",
          "size": "sm",
          "leadingIcon": "Pin",
          "disabled": {
            "$cond": {
              "$and": [
                {
                  "$state": "/ui/newUrl"
                },
                {
                  "$state": "/ui/newLabel"
                }
              ]
            },
            "$then": false,
            "$else": true
          }
        },
        "on": {
          "click": [
            {
              "action": "pushState",
              "params": {
                "statePath": "/ui/pinned",
                "value": {
                  "$computed": "pair_object",
                  "args": {
                    "url": {
                      "$state": "/ui/newUrl"
                    },
                    "label": {
                      "$state": "/ui/newLabel"
                    }
                  }
                }
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/newUrl",
                "value": ""
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/newLabel",
                "value": ""
              }
            }
          ]
        }
      },
      "empty": {
        "type": "Empty",
        "props": {
          "message": "Pin documents for fast access."
        },
        "visible": {
          "$state": "/ui/pinned/0",
          "not": true
        }
      },
      "list": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "repeat": {
          "statePath": "/ui/pinned"
        },
        "children": [
          "row"
        ]
      },
      "row": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "start",
          "justify": "between",
          "hover": true,
          "clickable": true
        },
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "url": {
                "$computed": "identity",
                "args": {
                  "value": {
                    "$item": "url"
                  }
                }
              }
            }
          }
        },
        "children": [
          "rowLeft",
          "unpinBtn"
        ]
      },
      "rowLeft": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "start",
          "grow": true
        },
        "children": [
          "icon",
          "label"
        ]
      },
      "icon": {
        "type": "Icon",
        "props": {
          "name": "FileText",
          "tone": "muted",
          "size": "sm"
        }
      },
      "label": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "label"
          },
          "size": "sm",
          "weight": "medium",
          "truncate": true
        }
      },
      "unpinBtn": {
        "type": "IconButton",
        "props": {
          "icon": "X",
          "tone": "muted",
          "ariaLabel": "Unpin"
        },
        "on": {
          "click": {
            "action": "removeState",
            "params": {
              "statePath": "/ui/pinned",
              "index": {
                "$index": true
              }
            }
          }
        }
      }
    }
  },
  "status": "draft"
}
