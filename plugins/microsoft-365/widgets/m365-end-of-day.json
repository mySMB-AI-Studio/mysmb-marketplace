{
  "id": "m365-end-of-day",
  "title": "End-of-Day Wrap",
  "description": "A quick recap: unread left, meetings attended, files touched, and what's first tomorrow.",
  "category": "productivity",
  "tags": [
    "m365",
    "wrap",
    "recap",
    "end of day"
  ],
  "keywords": [
    "end of day",
    "wrap",
    "recap",
    "review"
  ],
  "connectorsUsed": [
    "m365-calendar",
    "m365-files",
    "m365-mail-read"
  ],
  "popularity": 0,
  "sizing": {
    "preferred": {
      "colSpan": 7,
      "rowSpan": 7
    },
    "min": {
      "colSpan": 5,
      "rowSpan": 5
    },
    "max": {
      "colSpan": 14,
      "rowSpan": 12
    }
  },
  "dataProvider": {
    "mcp": "m365-mail-read",
    "tool": "list_emails",
    "params": {
      "limit": 20
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "children": [
          "header",
          "body",
          "autoFetch"
        ]
      },
      "header": {
        "type": "Header",
        "children": [
          "titleRow",
          "refreshBtn"
        ]
      },
      "titleRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center"
        },
        "children": [
          "titleIcon",
          "title"
        ]
      },
      "titleIcon": {
        "type": "Icon",
        "props": {
          "name": "Sunset",
          "tone": "warning",
          "size": "sm"
        }
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "End-of-day wrap",
          "level": "h2"
        }
      },
      "refreshBtn": {
        "type": "IconButton",
        "props": {
          "icon": "RefreshCw",
          "tone": "muted",
          "ariaLabel": "Refresh"
        },
        "on": {
          "click": [
            {
              "action": "m365-mail-read.list_emails",
              "params": {
                "limit": 20
              }
            },
            {
              "action": "m365-calendar.list_events",
              "params": {
                "limit": 20
              }
            },
            {
              "action": "m365-files.list_recent_files",
              "params": {
                "limit": 10
              }
            }
          ]
        }
      },
      "body": {
        "type": "Stack",
        "props": {
          "gap": "md"
        },
        "children": [
          "stats",
          "divider",
          "tomorrowHead",
          "tomorrowList"
        ]
      },
      "stats": {
        "type": "Grid",
        "props": {
          "cols": 3,
          "gap": "md"
        },
        "children": [
          "sMail",
          "sCal",
          "sFiles"
        ]
      },
      "sMail": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "children": [
          "sMailEye",
          "sMailVal"
        ]
      },
      "sMailEye": {
        "type": "Eyebrow",
        "props": {
          "text": "Unread left"
        }
      },
      "sMailVal": {
        "type": "Stat",
        "props": {
          "value": {
            "$computed": "count_where",
            "args": {
              "value": {
                "$state": "/m365-mail-read/list_emails"
              },
              "whereField": "isRead",
              "equals": false
            }
          },
          "tone": "warning"
        }
      },
      "sCal": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "children": [
          "sCalEye",
          "sCalVal"
        ]
      },
      "sCalEye": {
        "type": "Eyebrow",
        "props": {
          "text": "Meetings today"
        }
      },
      "sCalVal": {
        "type": "Stat",
        "props": {
          "value": {
            "$computed": "count",
            "args": {
              "value": {
                "$state": "/m365-calendar/list_events"
              }
            }
          },
          "tone": "accent"
        }
      },
      "sFiles": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "children": [
          "sFilesEye",
          "sFilesVal"
        ]
      },
      "sFilesEye": {
        "type": "Eyebrow",
        "props": {
          "text": "Files touched"
        }
      },
      "sFilesVal": {
        "type": "Stat",
        "props": {
          "value": {
            "$computed": "count",
            "args": {
              "value": {
                "$state": "/m365-files/list_recent_files"
              }
            }
          },
          "tone": "default"
        }
      },
      "divider": {
        "type": "Divider"
      },
      "tomorrowHead": {
        "type": "Heading",
        "props": {
          "text": "First up tomorrow",
          "level": "h3"
        }
      },
      "tomorrowList": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "repeat": {
          "statePath": "/m365-calendar/list_events",
          "key": "id"
        },
        "children": [
          "tRow"
        ]
      },
      "tRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "start",
          "justify": "between",
          "hover": true
        },
        "children": [
          "tLeft",
          "tBadge"
        ]
      },
      "tLeft": {
        "type": "Stack",
        "props": {
          "gap": "xs",
          "grow": true
        },
        "children": [
          "tSubj",
          "tWhen"
        ]
      },
      "tSubj": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "subject"
          },
          "size": "sm",
          "weight": "medium",
          "truncate": true
        }
      },
      "tWhen": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "format_date",
            "args": {
              "value": {
                "$item": "start/dateTime"
              },
              "format": "medium"
            }
          }
        }
      },
      "tBadge": {
        "type": "Badge",
        "props": {
          "text": {
            "$computed": "relative_time",
            "args": {
              "value": {
                "$item": "start/dateTime"
              }
            }
          },
          "tone": "accent",
          "variant": "soft"
        }
      },
      "autoFetch": {
        "type": "Spinner",
        "props": {
          "size": "sm"
        },
        "visible": {
          "$state": "/_loading/m365-calendar.list_events"
        },
        "watch": {
          "/m365-mail-read/list_emails": [
            {
              "action": "m365-calendar.list_events",
              "params": {
                "limit": 20
              }
            },
            {
              "action": "m365-files.list_recent_files",
              "params": {
                "limit": 10
              }
            }
          ]
        }
      }
    }
  },
  "status": "draft"
}
