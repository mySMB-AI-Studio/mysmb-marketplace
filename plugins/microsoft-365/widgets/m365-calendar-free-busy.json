{
  "id": "m365-calendar-free-busy",
  "title": "Free/Busy Finder",
  "description": "Find common free slots across attendees for a meeting.",
  "category": "productivity",
  "tags": [
    "m365",
    "calendar",
    "scheduling",
    "free busy"
  ],
  "keywords": [
    "free",
    "busy",
    "finder",
    "slots",
    "availability"
  ],
  "connectorsUsed": [
    "m365-calendar"
  ],
  "popularity": 0,
  "sizing": {
    "preferred": {
      "colSpan": 6,
      "rowSpan": 7
    },
    "min": {
      "colSpan": 4,
      "rowSpan": 6
    },
    "max": {
      "colSpan": 12,
      "rowSpan": 12
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "children": [
          "header",
          "body"
        ]
      },
      "header": {
        "type": "Header",
        "children": [
          "titleRow"
        ]
      },
      "titleRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center"
        },
        "children": [
          "titleIcon",
          "title"
        ]
      },
      "titleIcon": {
        "type": "Icon",
        "props": {
          "name": "CalendarSearch",
          "tone": "accent",
          "size": "sm"
        }
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "Free/busy finder",
          "level": "h2"
        }
      },
      "body": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "atRow",
          "startRow",
          "endRow",
          "durRow",
          "actions",
          "resultsHead",
          "results",
          "emptyHint"
        ]
      },
      "atRow": {
        "type": "FormRow",
        "props": {
          "label": "Attendees",
          "hint": "Comma-separated emails"
        },
        "children": [
          "atInput"
        ]
      },
      "atInput": {
        "type": "TextInput",
        "props": {
          "value": {
            "$bindState": "/ui/attendees"
          },
          "placeholder": "alice@contoso.com, bob@contoso.com"
        }
      },
      "startRow": {
        "type": "FormRow",
        "props": {
          "label": "Search window start",
          "hint": "ISO 8601"
        },
        "children": [
          "startInput"
        ]
      },
      "startInput": {
        "type": "TextInput",
        "props": {
          "value": {
            "$bindState": "/ui/start"
          },
          "placeholder": "2026-04-24T09:00:00Z"
        }
      },
      "endRow": {
        "type": "FormRow",
        "props": {
          "label": "Search window end"
        },
        "children": [
          "endInput"
        ]
      },
      "endInput": {
        "type": "TextInput",
        "props": {
          "value": {
            "$bindState": "/ui/end"
          },
          "placeholder": "2026-04-24T18:00:00Z"
        }
      },
      "durRow": {
        "type": "FormRow",
        "props": {
          "label": "Duration (minutes)"
        },
        "children": [
          "durInput"
        ]
      },
      "durInput": {
        "type": "TextInput",
        "props": {
          "value": {
            "$bindState": "/ui/duration"
          },
          "placeholder": "30"
        }
      },
      "actions": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "justify": "end"
        },
        "children": [
          "findBtn"
        ]
      },
      "findBtn": {
        "type": "Button",
        "props": {
          "label": "Find slots",
          "variant": "primary",
          "size": "sm",
          "leadingIcon": "Search",
          "disabled": {
            "$cond": {
              "$and": [
                {
                  "$state": "/ui/attendees"
                },
                {
                  "$state": "/ui/start"
                },
                {
                  "$state": "/ui/end"
                }
              ]
            },
            "$then": false,
            "$else": true
          }
        },
        "on": {
          "click": {
            "action": "m365-calendar.find_free_slots",
            "params": {
              "attendees": {
                "$computed": "split_csv",
                "args": {
                  "value": {
                    "$state": "/ui/attendees"
                  }
                }
              },
              "startDateTime": {
                "$state": "/ui/start"
              },
              "startTimeZone": "UTC",
              "endDateTime": {
                "$state": "/ui/end"
              },
              "endTimeZone": "UTC",
              "durationMinutes": 30
            }
          }
        }
      },
      "resultsHead": {
        "type": "Heading",
        "props": {
          "text": "Suggested times",
          "level": "h3"
        },
        "visible": {
          "$state": "/m365-calendar/find_free_slots/meetingTimeSuggestions/0"
        }
      },
      "results": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "repeat": {
          "statePath": "/m365-calendar/find_free_slots/meetingTimeSuggestions"
        },
        "children": [
          "resRow"
        ]
      },
      "resRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "start",
          "justify": "between",
          "hover": true
        },
        "children": [
          "resLeft",
          "resConfidence"
        ]
      },
      "resLeft": {
        "type": "Stack",
        "props": {
          "gap": "xs",
          "grow": true
        },
        "children": [
          "resWhen",
          "resWindow"
        ]
      },
      "resWhen": {
        "type": "Text",
        "props": {
          "text": {
            "$computed": "format_date",
            "args": {
              "value": {
                "$item": "meetingTimeSlot/start/dateTime"
              },
              "format": "long"
            }
          },
          "size": "sm",
          "weight": "medium"
        }
      },
      "resWindow": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "Ends {t}",
              "t": {
                "$computed": "format_date",
                "args": {
                  "value": {
                    "$item": "meetingTimeSlot/end/dateTime"
                  },
                  "format": "medium"
                }
              }
            }
          }
        }
      },
      "resConfidence": {
        "type": "Badge",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{c}%",
              "c": {
                "$item": "confidence"
              }
            }
          },
          "tone": "success",
          "variant": "soft"
        }
      },
      "emptyHint": {
        "type": "Empty",
        "props": {
          "message": "Fill the form and click Find slots."
        },
        "visible": {
          "$and": [
            {
              "$state": "/_loading/m365-calendar.find_free_slots",
              "not": true
            },
            {
              "$state": "/m365-calendar/find_free_slots/meetingTimeSuggestions/0",
              "not": true
            }
          ]
        }
      }
    }
  },
  "status": "draft"
}
