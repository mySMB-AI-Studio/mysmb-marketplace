{
  "id": "m365-mail-volume",
  "title": "Email Volume",
  "description": "How many emails you've received recently, with read/unread split.",
  "category": "productivity",
  "tags": [
    "m365",
    "email",
    "volume",
    "analytics"
  ],
  "keywords": [
    "volume",
    "count",
    "analytics",
    "trend"
  ],
  "connectorsUsed": [
    "m365-mail-read"
  ],
  "popularity": 0,
  "sizing": {
    "preferred": {
      "colSpan": 4,
      "rowSpan": 4
    },
    "min": {
      "colSpan": 3,
      "rowSpan": 3
    },
    "max": {
      "colSpan": 8,
      "rowSpan": 6
    }
  },
  "dataProvider": {
    "mcp": "m365-mail-read",
    "tool": "list_emails",
    "params": {
      "limit": 50
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "children": [
          "header",
          "body"
        ]
      },
      "header": {
        "type": "Header",
        "children": [
          "titleRow"
        ]
      },
      "titleRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center"
        },
        "children": [
          "titleIcon",
          "title"
        ]
      },
      "titleIcon": {
        "type": "Icon",
        "props": {
          "name": "LineChart",
          "tone": "accent",
          "size": "sm"
        }
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "Email Volume",
          "level": "h2"
        }
      },
      "body": {
        "type": "Stack",
        "props": {
          "gap": "md"
        },
        "children": [
          "grid",
          "divider",
          "hint"
        ]
      },
      "grid": {
        "type": "Grid",
        "props": {
          "cols": 2,
          "gap": "md"
        },
        "children": [
          "totalStack",
          "unreadStack"
        ]
      },
      "totalStack": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "children": [
          "totalEyebrow",
          "totalValue"
        ]
      },
      "totalEyebrow": {
        "type": "Eyebrow",
        "props": {
          "text": "Total received"
        }
      },
      "totalValue": {
        "type": "Stat",
        "props": {
          "value": {
            "$computed": "count",
            "args": {
              "value": {
                "$state": "/m365-mail-read/list_emails"
              }
            }
          },
          "tone": "accent"
        }
      },
      "unreadStack": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "children": [
          "unreadEyebrow",
          "unreadValue"
        ]
      },
      "unreadEyebrow": {
        "type": "Eyebrow",
        "props": {
          "text": "Unread"
        }
      },
      "unreadValue": {
        "type": "Stat",
        "props": {
          "value": {
            "$computed": "count_where",
            "args": {
              "value": {
                "$state": "/m365-mail-read/list_emails"
              },
              "whereField": "isRead",
              "equals": false
            }
          },
          "tone": "warning"
        }
      },
      "divider": {
        "type": "Divider"
      },
      "hint": {
        "type": "Caption",
        "props": {
          "text": "Measured from your most recent 50 messages."
        }
      }
    }
  },
  "status": "draft"
}
