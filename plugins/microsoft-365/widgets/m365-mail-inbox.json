{
  "id": "m365-mail-inbox",
  "title": "Email Inbox",
  "description": "Recent inbox messages with unread indicator, sender avatar, and one-click reply.",
  "category": "productivity",
  "tags": [
    "m365",
    "email",
    "inbox",
    "outlook",
    "productivity"
  ],
  "keywords": [
    "email",
    "inbox",
    "outlook",
    "message",
    "messages",
    "mail",
    "unread"
  ],
  "connectorsUsed": [
    "m365-mail-read",
    "m365-mail-send"
  ],
  "popularity": 95,
  "sizing": {
    "preferred": {
      "colSpan": 7,
      "rowSpan": 5
    },
    "min": {
      "colSpan": 4,
      "rowSpan": 4
    },
    "max": {
      "colSpan": 12,
      "rowSpan": 12
    }
  },
  "dataProvider": {
    "mcp": "m365-mail-read",
    "tool": "list_emails",
    "params": {
      "limit": 20
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "children": [
          "header",
          "body",
          "overlay"
        ]
      },
      "header": {
        "type": "Header",
        "children": [
          "titleGroup"
        ]
      },
      "titleGroup": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "start"
        },
        "children": [
          "titleIcon",
          "titleStack"
        ]
      },
      "titleIcon": {
        "type": "Icon",
        "props": {
          "name": "Mail",
          "tone": "accent",
          "size": "sm"
        }
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "Inbox",
          "level": "h2"
        }
      },
      "unreadCount": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{n} Unread",
              "n": {
                "$computed": "count_where",
                "args": {
                  "value": {
                    "$state": "/m365-mail-read/list_emails"
                  },
                  "whereField": "isRead",
                  "equals": false
                }
              }
            }
          }
        }
      },
      "body": {
        "type": "Body",
        "children": [
          "loading",
          "empty",
          "list"
        ]
      },
      "loading": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "s1",
          "s2",
          "s3",
          "s4"
        ],
        "visible": {
          "$state": "/_loading/m365-mail-read.list_emails"
        }
      },
      "s1": {
        "type": "Skeleton",
        "props": {
          "height": "2.75rem",
          "rounded": "md"
        }
      },
      "s2": {
        "type": "Skeleton",
        "props": {
          "height": "2.75rem",
          "rounded": "md"
        }
      },
      "s3": {
        "type": "Skeleton",
        "props": {
          "height": "2.75rem",
          "rounded": "md"
        }
      },
      "s4": {
        "type": "Skeleton",
        "props": {
          "height": "2.75rem",
          "rounded": "md"
        }
      },
      "empty": {
        "type": "Empty",
        "props": {
          "message": "Inbox zero \u2014 enjoy it while it lasts."
        },
        "visible": {
          "$and": [
            {
              "$state": "/_loading/m365-mail-read.list_emails",
              "not": true
            },
            {
              "$state": "/m365-mail-read/list_emails/0",
              "not": true
            }
          ]
        }
      },
      "list": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "children": [
          "row"
        ],
        "repeat": {
          "statePath": "/m365-mail-read/list_emails",
          "key": "id"
        },
        "visible": {
          "$state": "/_loading/m365-mail-read.list_emails",
          "not": true
        }
      },
      "row": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "start",
          "hover": true,
          "clickable": true,
          "justify": "between"
        },
        "children": [
          "unreadDot",
          "avatar",
          "labels",
          "received"
        ],
        "on": {
          "click": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/selectedEmailId",
                "value": {
                  "$computed": "identity",
                  "args": {
                    "value": {
                      "$item": "id"
                    }
                  }
                }
              }
            },
            {
              "action": "m365-mail-read.get_email",
              "params": {
                "id": {
                  "$computed": "identity",
                  "args": {
                    "value": {
                      "$item": "id"
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "unreadDot": {
        "type": "Dot",
        "props": {
          "tone": {
            "$cond": {
              "$item": "isRead"
            },
            "$then": "muted",
            "$else": "accent"
          },
          "size": "sm"
        }
      },
      "avatar": {
        "type": "Avatar",
        "props": {
          "initials": {
            "$computed": "initials",
            "args": {
              "value": {
                "$item": "from/emailAddress/name"
              }
            }
          },
          "size": "sm"
        }
      },
      "labels": {
        "type": "Stack",
        "props": {
          "gap": "xs",
          "grow": true
        },
        "children": [
          "labelTop",
          "labelBottom"
        ]
      },
      "labelTop": {
        "type": "Text",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{name} \u2014 {subject}",
              "name": {
                "$item": "from/emailAddress/name"
              },
              "subject": {
                "$item": "subject"
              }
            }
          },
          "size": "md",
          "weight": "medium",
          "truncate": true
        }
      },
      "labelBottom": {
        "type": "Text",
        "props": {
          "text": {
            "$computed": "email_preview",
            "args": {
              "value": {
                "$item": "bodyPreview"
              },
              "maxLength": 140
            }
          },
          "size": "sm",
          "tone": "muted"
        }
      },
      "received": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "relative_time",
            "args": {
              "value": {
                "$item": "receivedDateTime"
              }
            }
          }
        }
      },
      "overlay": {
        "type": "Overlay",
        "props": {
          "maxWidth": "48rem"
        },
        "children": [
          "detailCard"
        ],
        "visible": {
          "$state": "/ui/selectedEmailId"
        },
        "on": {
          "backdropClick": {
            "action": "setState",
            "params": {
              "statePath": "/ui/selectedEmailId",
              "value": ""
            }
          }
        }
      },
      "detailCard": {
        "type": "Card",
        "children": [
          "detailHeader",
          "detailSpinner",
          "detailBody"
        ]
      },
      "detailHeader": {
        "type": "Row",
        "children": [
          "detailTitle",
          "detailClose"
        ],
        "props": {
          "gap": "sm",
          "align": "center",
          "justify": "between"
        }
      },
      "detailTitle": {
        "type": "Heading",
        "props": {
          "text": {
            "$state": "/m365-mail-read/get_email/subject"
          },
          "level": "h2"
        }
      },
      "detailClose": {
        "type": "IconButton",
        "props": {
          "icon": "X",
          "tone": "default",
          "ariaLabel": "Close",
          "size": "md",
          "variant": "outlined"
        },
        "on": {
          "click": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/selectedEmailId",
                "value": ""
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/replyText",
                "value": ""
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/replySent",
                "value": ""
              }
            }
          ]
        }
      },
      "detailSpinner": {
        "type": "Spinner",
        "props": {
          "label": "Loading message\u2026"
        },
        "visible": {
          "$state": "/m365-mail-read/get_email/id",
          "neq": {
            "$state": "/ui/selectedEmailId"
          }
        }
      },
      "detailBody": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "kvFrom",
          "kvReceived",
          "bodyPreview",
          "actions"
        ],
        "visible": {
          "$state": "/m365-mail-read/get_email/id",
          "eq": {
            "$state": "/ui/selectedEmailId"
          }
        }
      },
      "kvFrom": {
        "type": "KeyValue",
        "props": {
          "label": "From",
          "value": {
            "$computed": "fmt",
            "args": {
              "pattern": "{name} <{addr}>",
              "name": {
                "$state": "/m365-mail-read/get_email/from/emailAddress/name"
              },
              "addr": {
                "$state": "/m365-mail-read/get_email/from/emailAddress/address"
              }
            }
          }
        }
      },
      "kvReceived": {
        "type": "KeyValue",
        "props": {
          "label": "Received",
          "value": {
            "$computed": "relative_time",
            "args": {
              "value": {
                "$state": "/m365-mail-read/get_email/receivedDateTime"
              }
            }
          }
        }
      },
      "bodyPreview": {
        "type": "Section",
        "props": {
          "variant": "muted"
        },
        "children": [
          "bodyHtml"
        ]
      },
      "bodyHtml": {
        "type": "RichHtml",
        "props": {
          "html": {
            "$state": "/m365-mail-read/get_email/body/content"
          },
          "minHeight": 120,
          "maxHeight": 520
        }
      },
      "titleStack": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "children": [
          "title",
          "unreadCount"
        ]
      },
      "openBtn": {
        "type": "Button",
        "props": {
          "label": "Open in Outlook",
          "variant": "primary",
          "size": "sm",
          "leadingIcon": "ExternalLink"
        },
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "url": {
                "$state": "/m365-mail-read/get_email/webLink"
              }
            }
          }
        }
      },
      "actions": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "justify": "end"
        },
        "children": [
          "openBtn"
        ]
      }
    }
  },
  "status": "published"
}
