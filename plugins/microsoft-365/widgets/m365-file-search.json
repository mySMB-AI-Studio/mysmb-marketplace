{
  "id": "m365-file-search",
  "title": "OneDrive Search",
  "description": "Search your OneDrive files by name or content. Type a keyword or phrase and browse matching results inline.",
  "category": "productivity",
  "tags": [
    "m365",
    "onedrive",
    "files",
    "search",
    "documents",
    "productivity"
  ],
  "keywords": [
    "search",
    "find",
    "files",
    "documents",
    "onedrive",
    "office",
    "m365",
    "file search",
    "drive"
  ],
  "connectorsUsed": [
    "m365-files"
  ],
  "popularity": 0,
  "sizing": {
    "preferred": {
      "colSpan": 6,
      "rowSpan": 7
    },
    "min": {
      "colSpan": 4,
      "rowSpan": 5
    },
    "max": {
      "colSpan": 12,
      "rowSpan": 12
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": [
          "header",
          "divider1",
          "searchBar",
          "body",
          "divider2",
          "footer"
        ]
      },
      "divider1": { "type": "Divider", "props": {} },
      "header": {
        "type": "Header",
        "props": {},
        "children": [
          "headerRow"
        ]
      },
      "headerRow": {
        "type": "Row",
        "props": {
          "justify": "between",
          "align": "center"
        },
        "children": [
          "titleGroup"
        ]
      },
      "titleGroup": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center"
        },
        "children": [
          "titleIcon",
          "titleStack"
        ]
      },
      "titleIcon": {
        "type": "Icon",
        "props": {
          "name": "Search",
          "tone": "info",
          "size": "sm"
        }
      },
      "titleStack": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "children": [
          "widgetTitle",
          "widgetSubtitle"
        ]
      },
      "widgetTitle": {
        "type": "Heading",
        "props": {
          "text": "OneDrive Search",
          "level": "h2"
        }
      },
      "widgetSubtitle": {
        "type": "Eyebrow",
        "props": {
          "text": "Microsoft OneDrive"
        }
      },
      "searchBar": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center"
        },
        "children": [
          "searchInput",
          "searchBtn"
        ]
      },
      "searchInput": {
        "type": "TextInput",
        "props": {
          "value": {
            "$bindState": "/ui/m365FileSearch/query"
          },
          "placeholder": "Search files by name or content…",
          "ariaLabel": "Search OneDrive"
        },
        "on": {
          "submit": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/m365FileSearch/done",
                "value": true
              }
            },
            {
              "action": "m365-files.search_files",
              "params": {
                "query": {
                  "$state": "/ui/m365FileSearch/query"
                },
                "limit": 20
              }
            }
          ]
        }
      },
      "searchBtn": {
        "type": "Button",
        "props": {
          "label": "Search",
          "variant": "primary",
          "size": "sm",
          "leadingIcon": "Search",
          "disabled": {
            "$cond": {
              "$state": "/ui/m365FileSearch/query"
            },
            "$then": false,
            "$else": true
          }
        },
        "on": {
          "click": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/m365FileSearch/done",
                "value": true
              }
            },
            {
              "action": "m365-files.search_files",
              "params": {
                "query": {
                  "$state": "/ui/m365FileSearch/query"
                },
                "limit": 20
              }
            }
          ]
        }
      },
      "body": {
        "type": "Body",
        "props": {},
        "children": [
          "prompt",
          "loadingStack",
          "errorState",
          "emptyState",
          "results"
        ]
      },
      "prompt": {
        "type": "Stack",
        "props": {
          "gap": "sm",
          "align": "center"
        },
        "children": [
          "promptIcon",
          "promptTitle",
          "promptHint"
        ],
        "visible": {
          "$and": [
            {
              "$state": "/_loading/m365-files.search_files",
              "not": true
            },
            {
              "$or": [
                {
                  "$state": "/ui/m365FileSearch/done",
                  "not": true
                },
                {
                  "$state": "/ui/m365FileSearch/query",
                  "not": true
                }
              ]
            }
          ]
        }
      },
      "promptIcon": {
        "type": "Icon",
        "props": {
          "name": "FolderSearch",
          "tone": "muted",
          "size": "lg"
        }
      },
      "promptTitle": {
        "type": "Text",
        "props": {
          "text": "Search your OneDrive",
          "size": "sm",
          "weight": "medium"
        }
      },
      "promptHint": {
        "type": "Caption",
        "props": {
          "text": "Type a file name, keyword, or phrase to find documents.",
          "tone": "muted"
        }
      },
      "loadingStack": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "sk1",
          "sk2",
          "sk3"
        ],
        "visible": {
          "$state": "/_loading/m365-files.search_files"
        }
      },
      "sk1": {
        "type": "Skeleton",
        "props": {
          "height": "2.75rem",
          "rounded": "md"
        }
      },
      "sk2": {
        "type": "Skeleton",
        "props": {
          "height": "2.75rem",
          "rounded": "md"
        }
      },
      "sk3": {
        "type": "Skeleton",
        "props": {
          "height": "2.75rem",
          "rounded": "md"
        }
      },
      "errorState": {
        "type": "Empty",
        "props": {
          "message": "Couldn’t search OneDrive. Check the connection and try again."
        },
        "visible": {
          "$and": [
            {
              "$state": "/_loading/m365-files.search_files",
              "not": true
            },
            {
              "$state": "/_errors/m365-files.search_files"
            }
          ]
        }
      },
      "emptyState": {
        "type": "Empty",
        "props": {
          "message": "No files match that search. Try a different term."
        },
        "visible": {
          "$and": [
            {
              "$state": "/_loading/m365-files.search_files",
              "not": true
            },
            {
              "$state": "/_errors/m365-files.search_files",
              "not": true
            },
            {
              "$state": "/ui/m365FileSearch/done"
            },
            {
              "$state": "/ui/m365FileSearch/query"
            },
            {
              "$state": "/m365-files/search_files/0",
              "not": true
            }
          ]
        }
      },
      "results": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "summaryLabel",
          "fileList"
        ],
        "visible": {
          "$and": [
            {
              "$state": "/_loading/m365-files.search_files",
              "not": true
            },
            {
              "$state": "/_errors/m365-files.search_files",
              "not": true
            },
            {
              "$state": "/ui/m365FileSearch/done"
            },
            {
              "$state": "/ui/m365FileSearch/query"
            },
            {
              "$state": "/m365-files/search_files/0"
            }
          ]
        }
      },
      "summaryLabel": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{n} shown · up to 20 per search",
              "n": {
                "$computed": "count",
                "args": {
                  "value": {
                    "$state": "/m365-files/search_files"
                  }
                }
              }
            }
          },
          "tone": "muted"
        }
      },
      "fileList": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "repeat": {
          "statePath": "/m365-files/search_files",
          "key": "id"
        },
        "children": [
          "fileRow"
        ]
      },
      "fileRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center",
          "justify": "between",
          "hover": true,
          "clickable": true
        },
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "url": {
                "$computed": "identity",
                "args": {
                  "value": {
                    "$item": "webUrl"
                  }
                }
              }
            }
          }
        },
        "children": [
          "fileLeft",
          "fileOpenIcon"
        ]
      },
      "fileLeft": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "start",
          "grow": true
        },
        "children": [
          "fileIcon",
          "fileInfo"
        ]
      },
      "fileIcon": {
        "type": "Icon",
        "props": {
          "name": "FileText",
          "tone": "info",
          "size": "sm"
        }
      },
      "fileInfo": {
        "type": "Stack",
        "props": {
          "gap": "xs",
          "grow": true
        },
        "children": [
          "fileName",
          "fileMeta"
        ]
      },
      "fileName": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "name"
          },
          "size": "sm",
          "weight": "medium",
          "truncate": true
        }
      },
      "fileMeta": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "Modified {d}",
              "d": {
                "$computed": "format_date",
                "args": {
                  "value": {
                    "$item": "lastModifiedDateTime"
                  },
                  "format": "dd-mmm-yy"
                }
              }
            }
          },
          "tone": "muted"
        }
      },
      "fileOpenIcon": {
        "type": "Icon",
        "props": {
          "name": "ExternalLink",
          "tone": "muted",
          "size": "sm"
        }
      },
      "divider2": { "type": "Divider", "props": {} },
      "footer": { "type": "Row", "props": { "justify": "end" }, "children": ["openOneDriveBtn"] },
      "openOneDriveBtn": {
        "type": "Button",
        "props": { "label": "Open OneDrive", "tone": "info", "variant": "ghost", "size": "sm", "leadingIcon": "ExternalLink" },
        "on": { "click": { "action": "open_url", "params": { "url": "https://www.office.com/launch/onedrive", "target": "_blank" } } }
      }
    }
  }
}
