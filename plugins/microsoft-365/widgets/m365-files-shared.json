{
  "id": "m365-files-shared",
  "title": "Shared With Me",
  "description": "Recent files you have access to. Click to open or copy the link.",
  "category": "productivity",
  "tags": [
    "m365",
    "files",
    "shared",
    "onedrive"
  ],
  "keywords": [
    "shared",
    "access",
    "collaborate",
    "files"
  ],
  "connectorsUsed": [
    "m365-files"
  ],
  "popularity": 0,
  "sizing": {
    "preferred": {
      "colSpan": 6,
      "rowSpan": 6
    },
    "min": {
      "colSpan": 4,
      "rowSpan": 4
    },
    "max": {
      "colSpan": 12,
      "rowSpan": 12
    }
  },
  "dataProvider": {
    "mcp": "m365-files",
    "tool": "list_recent_files",
    "params": {
      "limit": 20
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "children": [
          "header",
          "body"
        ]
      },
      "header": {
        "type": "Header",
        "children": [
          "titleRow",
          "count"
        ]
      },
      "titleRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center"
        },
        "children": [
          "titleIcon",
          "title"
        ]
      },
      "titleIcon": {
        "type": "Icon",
        "props": {
          "name": "Share2",
          "tone": "accent",
          "size": "sm"
        }
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "Shared with me",
          "level": "h2"
        }
      },
      "count": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{n} files",
              "n": {
                "$computed": "count",
                "args": {
                  "value": {
                    "$state": "/m365-files/list_recent_files"
                  }
                }
              }
            }
          }
        }
      },
      "body": {
        "type": "Body",
        "children": [
          "loading",
          "empty",
          "list"
        ]
      },
      "loading": {
        "type": "Skeleton",
        "props": {
          "height": "8rem",
          "rounded": "md"
        },
        "visible": {
          "$state": "/_loading/m365-files.list_recent_files"
        }
      },
      "empty": {
        "type": "Empty",
        "props": {
          "message": "Nothing shared yet."
        },
        "visible": {
          "$and": [
            {
              "$state": "/_loading/m365-files.list_recent_files",
              "not": true
            },
            {
              "$state": "/m365-files/list_recent_files/0",
              "not": true
            }
          ]
        }
      },
      "list": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "repeat": {
          "statePath": "/m365-files/list_recent_files",
          "key": "id"
        },
        "children": [
          "row"
        ]
      },
      "row": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "start",
          "justify": "between",
          "hover": true,
          "clickable": true
        },
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "url": {
                "$computed": "identity",
                "args": {
                  "value": {
                    "$item": "webUrl"
                  }
                }
              }
            }
          }
        },
        "children": [
          "rowLeft",
          "copyBtn"
        ]
      },
      "rowLeft": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "start",
          "grow": true
        },
        "children": [
          "icon",
          "labels"
        ]
      },
      "icon": {
        "type": "Icon",
        "props": {
          "name": "FileText",
          "tone": "muted",
          "size": "sm"
        }
      },
      "labels": {
        "type": "Stack",
        "props": {
          "gap": "xs",
          "grow": true
        },
        "children": [
          "name",
          "meta"
        ]
      },
      "name": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "name"
          },
          "size": "sm",
          "weight": "medium",
          "truncate": true
        }
      },
      "meta": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "Modified {t}",
              "t": {
                "$computed": "relative_time",
                "args": {
                  "value": {
                    "$item": "lastModifiedDateTime"
                  }
                }
              }
            }
          }
        }
      },
      "copyBtn": {
        "type": "IconButton",
        "props": {
          "icon": "Link",
          "tone": "muted",
          "ariaLabel": "Copy link"
        },
        "on": {
          "click": {
            "action": "copy_to_clipboard",
            "params": {
              "text": {
                "$computed": "identity",
                "args": {
                  "value": {
                    "$item": "webUrl"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "status": "draft"
}
