{
  "id": "m365-calendar-focus-time",
  "title": "Focus Time Blocks",
  "description": "Create a protected focus-time block on your calendar.",
  "category": "productivity",
  "tags": [
    "m365",
    "calendar",
    "focus",
    "deep work"
  ],
  "keywords": [
    "focus",
    "deep work",
    "block",
    "protect"
  ],
  "connectorsUsed": [
    "m365-calendar"
  ],
  "popularity": 0,
  "sizing": {
    "preferred": {
      "colSpan": 5,
      "rowSpan": 6
    },
    "min": {
      "colSpan": 4,
      "rowSpan": 5
    },
    "max": {
      "colSpan": 10,
      "rowSpan": 10
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "children": [
          "header",
          "body"
        ]
      },
      "header": {
        "type": "Header",
        "children": [
          "titleRow"
        ]
      },
      "titleRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center"
        },
        "children": [
          "titleIcon",
          "title"
        ]
      },
      "titleIcon": {
        "type": "Icon",
        "props": {
          "name": "Focus",
          "tone": "accent",
          "size": "sm"
        }
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "Block Focus Time",
          "level": "h2"
        }
      },
      "body": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "subjRow",
          "startRow",
          "endRow",
          "actions",
          "banner",
          "errBanner"
        ]
      },
      "subjRow": {
        "type": "FormRow",
        "props": {
          "label": "Subject"
        },
        "children": [
          "subjInput"
        ]
      },
      "subjInput": {
        "type": "TextInput",
        "props": {
          "value": {
            "$bindState": "/ui/subject"
          },
          "placeholder": "Deep work — no meetings"
        }
      },
      "startRow": {
        "type": "FormRow",
        "props": {
          "label": "Start",
          "hint": "ISO 8601 (e.g. 2026-04-24T09:00:00Z)"
        },
        "children": [
          "startInput"
        ]
      },
      "startInput": {
        "type": "TextInput",
        "props": {
          "value": {
            "$bindState": "/ui/start"
          },
          "placeholder": "2026-04-24T09:00:00Z"
        }
      },
      "endRow": {
        "type": "FormRow",
        "props": {
          "label": "End"
        },
        "children": [
          "endInput"
        ]
      },
      "endInput": {
        "type": "TextInput",
        "props": {
          "value": {
            "$bindState": "/ui/end"
          },
          "placeholder": "2026-04-24T12:00:00Z"
        }
      },
      "actions": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "justify": "end"
        },
        "children": [
          "blockBtn"
        ]
      },
      "blockBtn": {
        "type": "Button",
        "props": {
          "label": "Block time",
          "variant": "primary",
          "size": "sm",
          "leadingIcon": "Shield",
          "disabled": {
            "$cond": {
              "$and": [
                {
                  "$state": "/ui/subject"
                },
                {
                  "$state": "/ui/start"
                },
                {
                  "$state": "/ui/end"
                }
              ]
            },
            "$then": false,
            "$else": true
          }
        },
        "on": {
          "click": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/created",
                "value": ""
              }
            },
            {
              "action": "m365-calendar.create_event",
              "params": {
                "subject": {
                  "$state": "/ui/subject"
                },
                "startDateTime": {
                  "$state": "/ui/start"
                },
                "startTimeZone": "UTC",
                "endDateTime": {
                  "$state": "/ui/end"
                },
                "endTimeZone": "UTC",
                "body": "Focus block — please do not schedule over."
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/created",
                "value": {
                  "$cond": {
                    "$state": "/_errors/m365-calendar.create_event"
                  },
                  "$then": "",
                  "$else": true
                }
              }
            }
          ]
        }
      },
      "banner": {
        "type": "Section",
        "props": {
          "variant": "muted"
        },
        "visible": {
          "$state": "/ui/created"
        },
        "children": [
          "bRow"
        ]
      },
      "bRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center"
        },
        "children": [
          "bIcon",
          "bText"
        ]
      },
      "bIcon": {
        "type": "Icon",
        "props": {
          "name": "CheckCircle2",
          "tone": "success",
          "size": "sm"
        }
      },
      "bText": {
        "type": "Text",
        "props": {
          "text": "Focus block created.",
          "size": "sm",
          "tone": "success"
        }
      },
      "errBanner": {
        "type": "Section",
        "props": {
          "variant": "bordered"
        },
        "visible": {
          "$state": "/_errors/m365-calendar.create_event"
        },
        "children": [
          "eRow"
        ]
      },
      "eRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center"
        },
        "children": [
          "eIcon",
          "eText"
        ]
      },
      "eIcon": {
        "type": "Icon",
        "props": {
          "name": "AlertTriangle",
          "tone": "destructive",
          "size": "sm"
        }
      },
      "eText": {
        "type": "Text",
        "props": {
          "text": {
            "$state": "/_errors/m365-calendar.create_event"
          },
          "size": "sm",
          "tone": "destructive"
        }
      }
    }
  },
  "status": "draft"
}
