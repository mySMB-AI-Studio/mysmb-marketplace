{
  "id": "m365-ready-to-pay-notices",
  "title": "Ready-to-Pay Notices",
  "description": "Inbox feed of 'Ready to pay' emails from accounts/ops over the last 14 days — surfaces unread notices, awaiting-reply reminders, and parses bill counts/totals from the preview.",
  "category": "productivity",
  "tags": ["m365", "email", "inbox", "outlook", "accounts-payable", "payments"],
  "keywords": ["ready to pay", "notices", "accounts", "bills", "outlook", "email"],
  "connectorsUsed": ["m365-mail-read"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 6, "rowSpan": 9 },
    "min":       { "colSpan": 4, "rowSpan": 6 },
    "max":       { "colSpan": 10, "rowSpan": 14 }
  },
  "dataProvider": {
    "mcp": "m365-mail-read",
    "tool": "list_ready_to_pay_notices",
    "params": {}
  },
  "spec": {
    "root": "card",
    "elements": {

      "card": {
        "type": "Card",
        "props": {},
        "children": ["header", "body"]
      },

      "header": {
        "type": "Header",
        "props": {},
        "children": ["titleGroup"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center", "justify": "between" },
        "children": ["titleLeft", "newBadge"]
      },
      "titleLeft": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "title"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "Mail", "tone": "accent", "size": "sm" }
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Ready-to-Pay Notices", "level": "h2" }
      },
      "newBadge": {
        "type": "Badge",
        "props": {
          "label": { "$state": "/m365-mail-read/list_ready_to_pay_notices/summary/newBadgeText" },
          "tone":  "info"
        },
        "visible": { "$state": "/m365-mail-read/list_ready_to_pay_notices/summary/newCount" }
      },

      "body": {
        "type": "Body",
        "props": {},
        "children": ["loading", "empty", "content"]
      },

      "loading": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["sk1", "sk2", "sk3", "sk4", "sk5"],
        "visible": { "$state": "/_loading/m365-mail-read.list_ready_to_pay_notices" }
      },
      "sk1": { "type": "Skeleton", "props": { "height": "2.25rem", "rounded": "md" } },
      "sk2": { "type": "Skeleton", "props": { "height": "4rem",    "rounded": "md" } },
      "sk3": { "type": "Skeleton", "props": { "height": "4rem",    "rounded": "md" } },
      "sk4": { "type": "Skeleton", "props": { "height": "4rem",    "rounded": "md" } },
      "sk5": { "type": "Skeleton", "props": { "height": "4rem",    "rounded": "md" } },

      "empty": {
        "type": "Empty",
        "props": { "message": "No ready-to-pay emails in the last 14 days." },
        "visible": {
          "$and": [
            { "$state": "/_loading/m365-mail-read.list_ready_to_pay_notices", "not": true },
            { "$state": "/m365-mail-read/list_ready_to_pay_notices/messages/0", "not": true }
          ]
        }
      },

      "content": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "visible": {
          "$and": [
            { "$state": "/_loading/m365-mail-read.list_ready_to_pay_notices", "not": true },
            { "$state": "/m365-mail-read/list_ready_to_pay_notices/messages/0" }
          ]
        },
        "children": ["tabsRow", "messageList", "footerRow"]
      },

      "tabsRow": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["tabAll", "tabUnread", "tabAwaiting"]
      },
      "tabAll": {
        "type": "Badge",
        "props": {
          "label": { "$state": "/m365-mail-read/list_ready_to_pay_notices/summary/allTabText" },
          "tone":  "info",
          "variant": "soft"
        }
      },
      "tabUnread": {
        "type": "Badge",
        "props": {
          "label": { "$state": "/m365-mail-read/list_ready_to_pay_notices/summary/unreadTabText" },
          "tone":  "muted"
        }
      },
      "tabAwaiting": {
        "type": "Badge",
        "props": {
          "label": { "$state": "/m365-mail-read/list_ready_to_pay_notices/summary/awaitingTabText" },
          "tone":  "muted"
        }
      },

      "messageList": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "repeat": {
          "statePath": "/m365-mail-read/list_ready_to_pay_notices/messages",
          "key": "id"
        },
        "children": ["messageRow"]
      },

      "messageRow": {
        "type": "Row",
        "props": { "gap": "sm", "align": "start", "template": "auto minmax(0,1fr) auto" },
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "url": {
                "$computed": "identity",
                "args": { "value": { "$item": "webLink" } }
              },
              "target": "_blank"
            }
          }
        },
        "children": ["messageAvatar", "messageBody", "messageTime"]
      },

      "messageAvatar": {
        "type": "Avatar",
        "props": {
          "initials": { "$item": "initials" },
          "tone":     { "$item": "avatarTone" },
          "size":     "md"
        }
      },

      "messageBody": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["senderLine", "subjectLine", "previewLine", "badgeRow"]
      },

      "senderLine": {
        "type": "Text",
        "props": {
          "text":     { "$item": "senderName" },
          "size":     "sm",
          "weight":   "semibold",
          "truncate": true
        }
      },

      "subjectLine": {
        "type": "Text",
        "props": {
          "text":     { "$item": "subject" },
          "size":     "sm",
          "weight":   "semibold",
          "truncate": true
        }
      },

      "previewLine": {
        "type": "Caption",
        "props": {
          "text":     { "$item": "preview" },
          "tone":     "muted",
          "truncate": true
        }
      },

      "badgeRow": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "repeat": {
          "statePath": "/badges",
          "key": "label"
        },
        "children": ["messageBadge"],
        "visible": { "$item": "badges/0" }
      },

      "messageBadge": {
        "type": "Badge",
        "props": {
          "label": { "$item": "label" },
          "tone":  { "$item": "tone" }
        }
      },

      "messageTime": {
        "type": "Caption",
        "props": {
          "text": { "$item": "timestamp" },
          "tone": { "$item": "timestampTone" }
        }
      },

      "footerRow": {
        "type": "Row",
        "props": { "gap": "sm", "justify": "between", "align": "center" },
        "children": ["footerLeft", "footerRight"]
      },

      "footerLeft": {
        "type": "Caption",
        "props": {
          "text": { "$state": "/m365-mail-read/list_ready_to_pay_notices/subjectFilterText" },
          "tone": "muted"
        }
      },

      "footerRight": {
        "type": "Button",
        "props": {
          "label":   "Open in Outlook",
          "variant": "ghost",
          "tone":    "info",
          "size":    "sm",
          "trailingIcon": "ArrowRight"
        },
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "url":    { "$state": "/m365-mail-read/list_ready_to_pay_notices/inboxUrl" },
              "target": "_blank"
            }
          }
        }
      }

    }
  },
  "status": "published"
}
