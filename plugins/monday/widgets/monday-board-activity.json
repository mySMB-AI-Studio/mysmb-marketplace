{
  "id": "monday-board-activity",
  "title": "Board Activity",
  "description": "Pick a monday.com board to see its recent activity log — items created, columns changed, updates posted.",
  "category": "work-management",
  "tags": [
    "monday",
    "activity",
    "audit log",
    "boards",
    "work-management"
  ],
  "keywords": [
    "board",
    "activity",
    "audit log",
    "recent changes",
    "monday",
    "feed"
  ],
  "connectorsUsed": [
    "monday"
  ],
  "popularity": 0,
  "sizing": {
    "preferred": {
      "colSpan": 4,
      "rowSpan": 6
    },
    "min": {
      "colSpan": 3,
      "rowSpan": 5
    },
    "max": {
      "colSpan": 6,
      "rowSpan": 9
    }
  },
  "dataProvider": {
    "mcp": "monday",
    "tool": "get_board_info",
    "params": {
      "limit": 50
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": [
          "titleRow",
          "divider1",
          "pickerRow",
          "body"
        ],
        "watch": {
          "/ui/selectedBoardId": [
            {
              "action": "monday.get_board_activity",
              "params": {
                "board_id": {
                  "$state": "/ui/selectedBoardId"
                },
                "limit": 20
              }
            }
          ],
          "/monday/get_board_activity": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/activity",
                "value": {
                  "$computed": "monday_activity_dashboard",
                  "args": {
                    "value": {
                      "$state": "/monday/get_board_activity"
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "titleRow": {
        "type": "Row",
        "props": {
          "justify": "between",
          "align": "center"
        },
        "children": [
          "titleGroup"
        ]
      },
      "titleGroup": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center"
        },
        "children": [
          "titleIcon",
          "titleStack"
        ]
      },
      "titleIcon": {
        "type": "Icon",
        "props": {
          "name": "Activity",
          "tone": "warning",
          "size": "sm"
        }
      },
      "titleStack": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "children": [
          "title",
          "eyebrow"
        ]
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "Board Activity",
          "level": "h2"
        }
      },
      "eyebrow": {
        "type": "Eyebrow",
        "props": {
          "text": "monday.com · pick a board"
        }
      },
      "divider1": {
        "type": "Divider",
        "props": {}
      },
      "pickerRow": {
        "type": "FormRow",
        "props": {
          "label": "Board"
        },
        "children": [
          "boardSelect"
        ]
      },
      "boardSelect": {
        "type": "Select",
        "props": {
          "value": {
            "$bindState": "/ui/selectedBoardId"
          },
          "options": {
            "$computed": "to_options",
            "args": {
              "value": {
                "$state": "/monday/get_board_info/boards"
              },
              "valueField": "id",
              "labelField": "name"
            }
          },
          "placeholder": "Select a board…",
          "size": "sm"
        }
      },
      "body": {
        "type": "Body",
        "props": {},
        "children": [
          "promptEmpty",
          "loading",
          "activityEmpty",
          "scopeLabel",
          "activityList"
        ]
      },
      "promptEmpty": {
        "type": "Empty",
        "props": {
          "message": "Select a board to see its activity."
        },
        "visible": {
          "$state": "/ui/selectedBoardId",
          "not": true
        }
      },
      "loading": {
        "type": "Row",
        "props": {
          "align": "center",
          "gap": "sm"
        },
        "children": [
          "loadingSpinner"
        ],
        "visible": {
          "$state": "/_loading/monday.get_board_activity"
        }
      },
      "loadingSpinner": {
        "type": "Spinner",
        "props": {
          "label": "Loading activity…",
          "size": "sm"
        }
      },
      "activityEmpty": {
        "type": "Empty",
        "props": {
          "message": "No recent activity on this board."
        },
        "visible": {
          "$and": [
            {
              "$state": "/ui/selectedBoardId"
            },
            {
              "$state": "/_loading/monday.get_board_activity",
              "not": true
            },
            {
              "$state": "/ui/activity/hasData",
              "not": true
            }
          ]
        }
      },
      "scopeLabel": {
        "type": "Caption",
        "props": {
          "text": {
            "$state": "/ui/activity/scopeText"
          },
          "tone": "muted"
        },
        "visible": {
          "$and": [
            {
              "$state": "/_loading/monday.get_board_activity",
              "not": true
            },
            {
              "$state": "/ui/activity/hasData"
            }
          ]
        }
      },
      "activityList": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "children": [
          "activityRowCollapsed",
          "activityRowExpanded"
        ],
        "repeat": {
          "statePath": "/ui/activity/rows",
          "key": "id"
        },
        "visible": {
          "$state": "/_loading/monday.get_board_activity",
          "not": true
        }
      },
      "activityRowCollapsed": {
        "type": "Row",
        "props": {
          "clickable": true
        },
        "children": [
          "activityRowCollapsedItem"
        ],
        "visible": {
          "$item": "id",
          "eq": {
            "$state": "/ui/expandedActivityId"
          },
          "not": true
        },
        "on": {
          "click": {
            "action": "setState",
            "params": {
              "statePath": "/ui/expandedActivityId",
              "value": {
                "$bindItem": "id"
              }
            }
          }
        }
      },
      "activityRowCollapsedItem": {
        "type": "ActivityItem",
        "props": {
          "title": {
            "$item": "actor_name"
          },
          "subtitle": {
            "$item": "action_text"
          },
          "timestamp": {
            "$computed": "relative_time",
            "args": {
              "value": {
                "$item": "created_at"
              }
            }
          },
          "initials": {
            "$computed": "initials",
            "args": {
              "value": {
                "$item": "actor_name"
              }
            }
          }
        }
      },
      "activityRowExpanded": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "children": [
          "activityRowSummary",
          "activityDetail"
        ],
        "visible": {
          "$item": "id",
          "eq": {
            "$state": "/ui/expandedActivityId"
          }
        }
      },
      "activityRowSummary": {
        "type": "Row",
        "props": {
          "clickable": true
        },
        "children": [
          "activityRowSummaryItem"
        ],
        "on": {
          "click": {
            "action": "setState",
            "params": {
              "statePath": "/ui/expandedActivityId",
              "value": ""
            }
          }
        }
      },
      "activityRowSummaryItem": {
        "type": "ActivityItem",
        "props": {
          "title": {
            "$item": "actor_name"
          },
          "subtitle": {
            "$item": "action_text"
          },
          "timestamp": {
            "$computed": "relative_time",
            "args": {
              "value": {
                "$item": "created_at"
              }
            }
          },
          "initials": {
            "$computed": "initials",
            "args": {
              "value": {
                "$item": "actor_name"
              }
            }
          }
        }
      },
      "activityDetail": {
        "type": "Section",
        "props": {
          "variant": "muted"
        },
        "children": [
          "detailType",
          "detailEvent",
          "detailTime",
          "detailDataLabel",
          "detailData"
        ]
      },
      "detailType": {
        "type": "KeyValue",
        "props": {
          "label": "Type",
          "value": {
            "$computed": "monday_entity_label",
            "args": {
              "value": {
                "$item": "entity"
              }
            }
          }
        }
      },
      "detailEvent": {
        "type": "KeyValue",
        "props": {
          "label": "Event code",
          "value": {
            "$item": "event"
          }
        }
      },
      "detailTime": {
        "type": "KeyValue",
        "props": {
          "label": "Time",
          "value": {
            "$computed": "fmt",
            "args": {
              "pattern": "{d} at {t}",
              "d": {
                "$computed": "format_date",
                "args": {
                  "value": {
                    "$item": "created_at"
                  },
                  "format": "dd-mmm-yy"
                }
              },
              "t": {
                "$computed": "format_time",
                "args": {
                  "value": {
                    "$item": "created_at"
                  }
                }
              }
            }
          }
        }
      },
      "detailDataLabel": {
        "type": "Caption",
        "props": {
          "text": "Raw details",
          "tone": "muted"
        }
      },
      "detailData": {
        "type": "Text",
        "props": {
          "text": {
            "$computed": "monday_pretty_json",
            "args": {
              "value": {
                "$item": "data"
              }
            }
          },
          "size": "xs",
          "tone": "muted"
        },
        "visible": {
          "$item": "data"
        }
      }
    }
  },
  "status": "published",
  "branding": {
    "color": "#0073ea"
  }
}
