{
  "category": "work-management",
  "connectorsUsed": [
    "monday"
  ],
  "dataProvider": {
    "kind": "tool",
    "mcp": "monday",
    "params": {
      "limit": 50
    },
    "tool": "get_board_info"
  },
  "description": "Pick a monday.com board to see its recent activity log — items created, columns changed, updates posted.",
  "id": "monday-board-activity",
  "keywords": [
    "board",
    "activity",
    "audit log",
    "recent changes",
    "monday",
    "feed"
  ],
  "popularity": 0,
  "sizing": {
    "max": {
      "colSpan": 6,
      "rowSpan": 9
    },
    "min": {
      "colSpan": 3,
      "rowSpan": 5
    },
    "preferred": {
      "colSpan": 4,
      "rowSpan": 6
    }
  },
  "spec": {
    "elements": {
      "activityDetail": {
        "children": [
          "detailType",
          "detailEvent",
          "detailTime",
          "detailDataLabel",
          "detailData"
        ],
        "props": {
          "variant": "muted"
        },
        "type": "Section"
      },
      "activityEmpty": {
        "props": {
          "message": "No recent activity on this board."
        },
        "type": "Empty",
        "visible": {
          "$and": [
            {
              "$state": "/ui/selectedBoardId"
            },
            {
              "$state": "/_loading/monday.get_board_activity",
              "not": true
            },
            {
              "$state": "/ui/activity/0",
              "not": true
            }
          ]
        }
      },
      "activityList": {
        "children": [
          "activityRowCollapsed",
          "activityRowExpanded"
        ],
        "props": {
          "gap": "xs"
        },
        "repeat": {
          "key": "id",
          "statePath": "/ui/activity"
        },
        "type": "Stack",
        "visible": {
          "$state": "/_loading/monday.get_board_activity",
          "not": true
        }
      },
      "activityRowCollapsed": {
        "children": [
          "activityRowCollapsedItem"
        ],
        "on": {
          "click": {
            "action": "setState",
            "params": {
              "statePath": "/ui/expandedActivityId",
              "value": {
                "$bindItem": "id"
              }
            }
          }
        },
        "props": {
          "clickable": true
        },
        "type": "Row",
        "visible": {
          "$item": "id",
          "eq": {
            "$state": "/ui/expandedActivityId"
          },
          "not": true
        }
      },
      "activityRowCollapsedItem": {
        "props": {
          "initials": {
            "$computed": "initials",
            "args": {
              "value": {
                "$item": "actor_name"
              }
            }
          },
          "subtitle": {
            "$item": "action_text"
          },
          "timestamp": {
            "$computed": "relative_time",
            "args": {
              "value": {
                "$item": "created_at"
              }
            }
          },
          "title": {
            "$item": "actor_name"
          }
        },
        "type": "ActivityItem"
      },
      "activityRowExpanded": {
        "children": [
          "activityRowSummary",
          "activityDetail"
        ],
        "props": {
          "gap": "xs"
        },
        "type": "Stack",
        "visible": {
          "$item": "id",
          "eq": {
            "$state": "/ui/expandedActivityId"
          }
        }
      },
      "activityRowSummary": {
        "children": [
          "activityRowSummaryItem"
        ],
        "on": {
          "click": {
            "action": "setState",
            "params": {
              "statePath": "/ui/expandedActivityId",
              "value": ""
            }
          }
        },
        "props": {
          "clickable": true
        },
        "type": "Row"
      },
      "activityRowSummaryItem": {
        "props": {
          "initials": {
            "$computed": "initials",
            "args": {
              "value": {
                "$item": "actor_name"
              }
            }
          },
          "subtitle": {
            "$item": "action_text"
          },
          "timestamp": {
            "$computed": "relative_time",
            "args": {
              "value": {
                "$item": "created_at"
              }
            }
          },
          "title": {
            "$item": "actor_name"
          }
        },
        "type": "ActivityItem"
      },
      "boardSelect": {
        "props": {
          "options": {
            "$computed": "to_options",
            "args": {
              "labelField": "name",
              "value": {
                "$state": "/monday/get_board_info/boards"
              },
              "valueField": "id"
            }
          },
          "placeholder": "Select a board…",
          "size": "sm",
          "value": {
            "$bindState": "/ui/selectedBoardId"
          }
        },
        "type": "Select"
      },
      "body": {
        "children": [
          "promptEmpty",
          "loading",
          "activityEmpty",
          "activityList"
        ],
        "props": {},
        "type": "Body"
      },
      "card": {
        "children": [
          "titleRow",
          "divider1",
          "pickerRow",
          "body"
        ],
        "props": {},
        "type": "Card",
        "watch": {
          "/monday/get_board_activity": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/activity",
                "value": {
                  "$computed": "monday_flatten_activity",
                  "args": {
                    "value": {
                      "$state": "/monday/get_board_activity"
                    }
                  }
                }
              }
            }
          ],
          "/ui/selectedBoardId": [
            {
              "action": "monday.get_board_activity",
              "params": {
                "board_id": {
                  "$state": "/ui/selectedBoardId"
                },
                "limit": 20
              }
            }
          ]
        }
      },
      "detailData": {
        "props": {
          "size": "xs",
          "text": {
            "$computed": "monday_pretty_json",
            "args": {
              "value": {
                "$item": "data"
              }
            }
          },
          "tone": "muted"
        },
        "type": "Text",
        "visible": {
          "$item": "data"
        }
      },
      "detailDataLabel": {
        "props": {
          "text": "Raw details",
          "tone": "muted"
        },
        "type": "Caption"
      },
      "detailEvent": {
        "props": {
          "label": "Event code",
          "value": {
            "$item": "event"
          }
        },
        "type": "KeyValue"
      },
      "detailTime": {
        "props": {
          "label": "Time",
          "value": {
            "$computed": "fmt",
            "args": {
              "d": {
                "$computed": "format_date",
                "args": {
                  "format": "dd-mmm-yy",
                  "value": {
                    "$item": "created_at"
                  }
                }
              },
              "pattern": "{d} at {t}",
              "t": {
                "$computed": "format_time",
                "args": {
                  "value": {
                    "$item": "created_at"
                  }
                }
              }
            }
          }
        },
        "type": "KeyValue"
      },
      "detailType": {
        "props": {
          "label": "Type",
          "value": {
            "$computed": "monday_entity_label",
            "args": {
              "value": {
                "$item": "entity"
              }
            }
          }
        },
        "type": "KeyValue"
      },
      "divider1": {
        "props": {},
        "type": "Divider"
      },
      "eyebrow": {
        "props": {
          "text": "monday.com · pick a board"
        },
        "type": "Eyebrow"
      },
      "loading": {
        "children": [
          "loadingSpinner"
        ],
        "props": {
          "align": "center",
          "gap": "sm"
        },
        "type": "Row",
        "visible": {
          "$state": "/_loading/monday.get_board_activity"
        }
      },
      "loadingSpinner": {
        "props": {
          "label": "Loading activity…",
          "size": "sm"
        },
        "type": "Spinner"
      },
      "pickerRow": {
        "children": [
          "boardSelect"
        ],
        "props": {
          "label": "Board"
        },
        "type": "FormRow"
      },
      "promptEmpty": {
        "props": {
          "message": "Select a board to see its activity."
        },
        "type": "Empty",
        "visible": {
          "$state": "/ui/selectedBoardId",
          "not": true
        }
      },
      "title": {
        "props": {
          "level": "h2",
          "text": "Board Activity"
        },
        "type": "Heading"
      },
      "titleGroup": {
        "children": [
          "titleIcon",
          "titleStack"
        ],
        "props": {
          "align": "center",
          "gap": "sm"
        },
        "type": "Row"
      },
      "titleIcon": {
        "props": {
          "name": "Activity",
          "size": "sm",
          "tone": "warning"
        },
        "type": "Icon"
      },
      "titleRow": {
        "children": [
          "titleGroup"
        ],
        "props": {
          "align": "center",
          "justify": "between"
        },
        "type": "Row"
      },
      "titleStack": {
        "children": [
          "title",
          "eyebrow"
        ],
        "props": {
          "gap": "none"
        },
        "type": "Stack"
      }
    },
    "root": "card"
  },
  "tags": [
    "monday",
    "activity",
    "audit log",
    "boards",
    "work-management"
  ],
  "title": "Board Activity"
}
