{
  "id": "monday-my-profile",
  "title": "My Profile",
  "description": "Your monday.com user profile and account details.",
  "category": "work-management",
  "tags": [
    "monday",
    "profile",
    "user",
    "account",
    "me"
  ],
  "keywords": [
    "profile",
    "me",
    "account",
    "user",
    "monday",
    "identity"
  ],
  "connectorsUsed": [
    "monday"
  ],
  "popularity": 0,
  "sizing": {
    "preferred": {
      "colSpan": 3,
      "rowSpan": 3
    },
    "min": {
      "colSpan": 2,
      "rowSpan": 2
    },
    "max": {
      "colSpan": 6,
      "rowSpan": 6
    }
  },
  "dataProvider": {
    "mcp": "monday",
    "tool": "get_user_context",
    "params": {}
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": [
          "titleRow",
          "loading",
          "content"
        ],
        "watch": {
          "/monday/get_user_context": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/profile",
                "value": {
                  "$computed": "monday_profile_dashboard",
                  "args": {
                    "context": {
                      "$state": "/monday/get_user_context"
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "titleRow": {
        "type": "Row",
        "props": {
          "justify": "between",
          "align": "center"
        },
        "children": [
          "titleGroup"
        ]
      },
      "titleGroup": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center"
        },
        "children": [
          "titleIcon",
          "titleStack"
        ]
      },
      "titleIcon": {
        "type": "Icon",
        "props": {
          "name": "User",
          "tone": "accent",
          "size": "sm"
        }
      },
      "titleStack": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "children": [
          "title",
          "eyebrow"
        ]
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "My Profile",
          "level": "h2"
        }
      },
      "eyebrow": {
        "type": "Eyebrow",
        "props": {
          "text": "monday.com"
        }
      },
      "loading": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "s1",
          "s2"
        ],
        "visible": {
          "$state": "/_loading/monday.get_user_context"
        }
      },
      "s1": {
        "type": "Skeleton",
        "props": {
          "height": "3rem",
          "rounded": "full"
        }
      },
      "s2": {
        "type": "Skeleton",
        "props": {
          "height": "5rem",
          "rounded": "md"
        }
      },
      "content": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "profileSection",
          "openBtn"
        ],
        "visible": {
          "$and": [
            {
              "$state": "/_loading/monday.get_user_context",
              "not": true
            },
            {
              "$state": "/ui/profile/hasData"
            }
          ]
        }
      },
      "profileSection": {
        "type": "Section",
        "props": {
          "variant": "muted"
        },
        "children": [
          "profileRow",
          "accountRow"
        ]
      },
      "profileRow": {
        "type": "Row",
        "props": {
          "align": "center",
          "gap": "sm"
        },
        "children": [
          "avatar",
          "userInfo"
        ]
      },
      "avatar": {
        "type": "Avatar",
        "props": {
          "initials": {
            "$computed": "initials",
            "args": {
              "value": {
                "$state": "/ui/profile/name"
              }
            }
          },
          "tone": "brand",
          "size": "lg"
        }
      },
      "userInfo": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "children": [
          "userName",
          "userEmail",
          "userTitle"
        ]
      },
      "userName": {
        "type": "Text",
        "props": {
          "text": {
            "$state": "/ui/profile/name"
          },
          "size": "sm",
          "weight": "semibold",
          "truncate": true
        }
      },
      "userEmail": {
        "type": "Text",
        "props": {
          "text": {
            "$state": "/ui/profile/email"
          },
          "size": "xs",
          "tone": "muted",
          "truncate": true
        }
      },
      "userTitle": {
        "type": "Caption",
        "props": {
          "text": {
            "$state": "/ui/profile/title"
          },
          "tone": "muted"
        },
        "visible": {
          "$state": "/ui/profile/title"
        }
      },
      "accountRow": {
        "type": "Row",
        "props": {
          "justify": "between",
          "align": "center"
        },
        "children": [
          "accountLabel",
          "accountBadge"
        ],
        "visible": {
          "$state": "/ui/profile/accountName"
        }
      },
      "accountLabel": {
        "type": "Caption",
        "props": {
          "text": "Account",
          "tone": "muted"
        }
      },
      "accountBadge": {
        "type": "Badge",
        "props": {
          "text": {
            "$state": "/ui/profile/accountName"
          },
          "tone": "brand",
          "variant": "soft"
        }
      },
      "openBtn": {
        "type": "Button",
        "props": {
          "label": "Open monday.com",
          "variant": "ghost",
          "tone": "accent",
          "size": "sm",
          "leadingIcon": "ExternalLink"
        },
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "url": "https://monday.com",
              "target": "_blank"
            }
          }
        }
      }
    }
  },
  "status": "published",
  "branding": {
    "color": "#0073ea"
  }
}
