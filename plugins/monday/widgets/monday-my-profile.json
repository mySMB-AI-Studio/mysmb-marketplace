{
  "category": "work-management",
  "connectorsUsed": [
    "monday"
  ],
  "dataProvider": {
    "kind": "tool",
    "mcp": "monday",
    "params": {},
    "tool": "get_user_context"
  },
  "description": "Your monday.com user profile and account details.",
  "id": "monday-my-profile",
  "keywords": [
    "profile",
    "me",
    "account",
    "user",
    "monday",
    "identity"
  ],
  "popularity": 0,
  "sizing": {
    "max": {
      "colSpan": 6,
      "rowSpan": 6
    },
    "min": {
      "colSpan": 2,
      "rowSpan": 2
    },
    "preferred": {
      "colSpan": 3,
      "rowSpan": 3
    }
  },
  "spec": {
    "elements": {
      "accountKV": {
        "props": {
          "label": "Account",
          "value": {
            "$state": "/monday/get_user_context/account/name"
          }
        },
        "type": "KeyValue",
        "visible": {
          "$state": "/monday/get_user_context/account/name"
        }
      },
      "avatar": {
        "props": {
          "initials": {
            "$computed": "initials",
            "args": {
              "value": {
                "$state": "/monday/get_user_context/name"
              }
            }
          }
        },
        "type": "Avatar"
      },
      "card": {
        "children": [
          "titleRow",
          "loading",
          "content"
        ],
        "props": {},
        "type": "Card"
      },
      "content": {
        "children": [
          "profileRow",
          "divider",
          "accountKV",
          "openBtn"
        ],
        "props": {
          "gap": "sm"
        },
        "type": "Stack",
        "visible": {
          "$state": "/_loading/monday.get_user_context",
          "not": true
        }
      },
      "divider": {
        "props": {},
        "type": "Divider"
      },
      "eyebrow": {
        "props": {
          "text": "monday.com"
        },
        "type": "Eyebrow"
      },
      "loading": {
        "children": [
          "s1",
          "s2"
        ],
        "props": {
          "gap": "sm"
        },
        "type": "Stack",
        "visible": {
          "$state": "/_loading/monday.get_user_context"
        }
      },
      "openBtn": {
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "url": "https://monday.com"
            }
          }
        },
        "props": {
          "label": "Open monday.com",
          "leadingIcon": "ExternalLink",
          "size": "sm",
          "tone": "accent",
          "variant": "ghost"
        },
        "type": "Button"
      },
      "profileRow": {
        "children": [
          "avatar",
          "userInfo"
        ],
        "props": {
          "align": "center",
          "gap": "sm"
        },
        "type": "Row"
      },
      "s1": {
        "props": {
          "height": "3rem",
          "rounded": "full"
        },
        "type": "Skeleton"
      },
      "s2": {
        "props": {
          "height": "2rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "title": {
        "props": {
          "level": "h2",
          "text": "My Profile"
        },
        "type": "Heading"
      },
      "titleGroup": {
        "children": [
          "titleIcon",
          "titleStack"
        ],
        "props": {
          "align": "center",
          "gap": "sm"
        },
        "type": "Row"
      },
      "titleIcon": {
        "props": {
          "name": "User",
          "size": "sm",
          "tone": "accent"
        },
        "type": "Icon"
      },
      "titleRow": {
        "children": [
          "titleGroup"
        ],
        "props": {
          "align": "center",
          "justify": "between"
        },
        "type": "Row"
      },
      "titleStack": {
        "children": [
          "title",
          "eyebrow"
        ],
        "props": {
          "gap": "none"
        },
        "type": "Stack"
      },
      "userEmail": {
        "props": {
          "size": "xs",
          "text": {
            "$state": "/monday/get_user_context/email"
          },
          "tone": "muted",
          "truncate": true
        },
        "type": "Text"
      },
      "userInfo": {
        "children": [
          "userName",
          "userEmail",
          "userTitle"
        ],
        "props": {
          "gap": "none"
        },
        "type": "Stack"
      },
      "userName": {
        "props": {
          "size": "sm",
          "text": {
            "$state": "/monday/get_user_context/name"
          },
          "truncate": true,
          "weight": "medium"
        },
        "type": "Text"
      },
      "userTitle": {
        "props": {
          "size": "xs",
          "text": {
            "$state": "/monday/get_user_context/title"
          },
          "tone": "muted",
          "truncate": true
        },
        "type": "Text",
        "visible": {
          "$state": "/monday/get_user_context/title"
        }
      }
    },
    "root": "card"
  },
  "tags": [
    "monday",
    "profile",
    "user",
    "account",
    "me"
  ],
  "title": "My Profile"
}
