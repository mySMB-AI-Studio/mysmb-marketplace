{
  "id": "monday-board-items",
  "title": "Board Items",
  "description": "Pick a monday.com board for a live snapshot — total items, status breakdown, and a color-coded list.",
  "category": "work-management",
  "tags": [
    "monday",
    "items",
    "boards",
    "tasks",
    "work-management",
    "status"
  ],
  "keywords": [
    "board items",
    "items",
    "tasks",
    "monday",
    "pulses",
    "status",
    "snapshot"
  ],
  "connectorsUsed": [
    "monday"
  ],
  "popularity": 0,
  "sizing": {
    "preferred": {
      "colSpan": 5,
      "rowSpan": 8
    },
    "min": {
      "colSpan": 4,
      "rowSpan": 7
    },
    "max": {
      "colSpan": 10,
      "rowSpan": 12
    }
  },
  "dataProvider": {
    "mcp": "monday",
    "tool": "get_board_info",
    "params": {
      "limit": 50
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": [
          "titleRow",
          "divider1",
          "pickerRow",
          "body"
        ],
        "watch": {
          "/ui/selectedBoardId": [
            {
              "action": "monday.get_board_items_page",
              "params": {
                "board_id": {
                  "$state": "/ui/selectedBoardId"
                },
                "limit": 20
              }
            }
          ],
          "/monday/get_board_items_page/items": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/items",
                "value": {
                  "$computed": "monday_board_items_dashboard",
                  "args": {
                    "value": {
                      "$state": "/monday/get_board_items_page/items"
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "titleRow": {
        "type": "Row",
        "props": {
          "justify": "between",
          "align": "center"
        },
        "children": [
          "titleGroup"
        ]
      },
      "titleGroup": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center"
        },
        "children": [
          "titleIcon",
          "titleStack"
        ]
      },
      "titleIcon": {
        "type": "Icon",
        "props": {
          "name": "ListChecks",
          "tone": "accent",
          "size": "sm"
        }
      },
      "titleStack": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "children": [
          "title",
          "eyebrow"
        ]
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "Board Items",
          "level": "h2"
        }
      },
      "eyebrow": {
        "type": "Eyebrow",
        "props": {
          "text": "monday.com · pick a board"
        }
      },
      "divider1": {
        "type": "Divider",
        "props": {}
      },
      "pickerRow": {
        "type": "FormRow",
        "props": {
          "label": "Board"
        },
        "children": [
          "boardSelect"
        ]
      },
      "boardSelect": {
        "type": "Select",
        "props": {
          "value": {
            "$bindState": "/ui/selectedBoardId"
          },
          "options": {
            "$computed": "to_options",
            "args": {
              "value": {
                "$state": "/monday/get_board_info/boards"
              },
              "valueField": "id",
              "labelField": "name"
            }
          },
          "placeholder": "Select a board…",
          "size": "sm"
        }
      },
      "body": {
        "type": "Body",
        "props": {},
        "children": [
          "promptEmpty",
          "loading",
          "itemsEmpty",
          "heroSection",
          "divider2",
          "donutSection",
          "listLabel",
          "listSection",
          "openBtnRow"
        ]
      },
      "promptEmpty": {
        "type": "Empty",
        "props": {
          "message": "Select a board to see its items."
        },
        "visible": {
          "$state": "/ui/selectedBoardId",
          "not": true
        }
      },
      "loading": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center"
        },
        "children": [
          "loadingSpinner"
        ],
        "visible": {
          "$and": [
            {
              "$state": "/ui/selectedBoardId"
            },
            {
              "$state": "/_loading/monday.get_board_items_page"
            }
          ]
        }
      },
      "loadingSpinner": {
        "type": "Spinner",
        "props": {
          "size": "sm",
          "label": "Loading items…"
        }
      },
      "itemsEmpty": {
        "type": "Empty",
        "props": {
          "message": "No items on this board."
        },
        "visible": {
          "$and": [
            {
              "$state": "/ui/selectedBoardId"
            },
            {
              "$state": "/_loading/monday.get_board_items_page",
              "not": true
            },
            {
              "$state": "/ui/items/hasData",
              "not": true
            }
          ]
        }
      },
      "heroSection": {
        "type": "Row",
        "props": {
          "justify": "between",
          "align": "end"
        },
        "children": [
          "heroStatStack",
          "heroChipsRow"
        ],
        "visible": {
          "$and": [
            {
              "$state": "/_loading/monday.get_board_items_page",
              "not": true
            },
            {
              "$state": "/ui/items/hasData"
            }
          ]
        }
      },
      "heroStatStack": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "children": [
          "heroValue",
          "heroLabel"
        ]
      },
      "heroValue": {
        "type": "Stat",
        "props": {
          "value": {
            "$state": "/ui/items/total"
          },
          "size": "lg"
        }
      },
      "heroLabel": {
        "type": "Caption",
        "props": {
          "text": "Total items",
          "tone": "muted"
        }
      },
      "heroChipsRow": {
        "type": "Row",
        "props": {
          "gap": "lg"
        },
        "children": [
          "chipGroups",
          "chipDone"
        ]
      },
      "chipGroups": {
        "type": "Stack",
        "props": {
          "gap": "none",
          "align": "end"
        },
        "children": [
          "chipGroupsValue",
          "chipGroupsLabel"
        ]
      },
      "chipGroupsValue": {
        "type": "Text",
        "props": {
          "text": {
            "$state": "/ui/items/groupCount"
          },
          "size": "md",
          "weight": "semibold"
        }
      },
      "chipGroupsLabel": {
        "type": "Caption",
        "props": {
          "text": "Groups",
          "tone": "muted"
        }
      },
      "chipDone": {
        "type": "Stack",
        "props": {
          "gap": "none",
          "align": "end"
        },
        "children": [
          "chipDoneValue",
          "chipDoneLabel"
        ]
      },
      "chipDoneValue": {
        "type": "Text",
        "props": {
          "text": {
            "$state": "/ui/items/doneCount"
          },
          "size": "md",
          "weight": "semibold"
        }
      },
      "chipDoneLabel": {
        "type": "Caption",
        "props": {
          "text": "Done",
          "tone": "muted"
        }
      },
      "divider2": {
        "type": "Divider",
        "props": {},
        "visible": {
          "$and": [
            {
              "$state": "/_loading/monday.get_board_items_page",
              "not": true
            },
            {
              "$state": "/ui/items/hasData"
            }
          ]
        }
      },
      "donutSection": {
        "type": "Section",
        "props": {
          "variant": "muted"
        },
        "children": [
          "statusLabel",
          "statusDonut"
        ],
        "visible": {
          "$and": [
            {
              "$state": "/_loading/monday.get_board_items_page",
              "not": true
            },
            {
              "$state": "/ui/items/hasData"
            }
          ]
        }
      },
      "statusLabel": {
        "type": "Eyebrow",
        "props": {
          "text": "Status breakdown"
        }
      },
      "statusDonut": {
        "type": "Donut",
        "props": {
          "segments": {
            "$state": "/ui/items/segments"
          },
          "centerLabel": "Items",
          "size": 104,
          "thickness": 12
        }
      },
      "listLabel": {
        "type": "Eyebrow",
        "props": {
          "text": "All items"
        },
        "visible": {
          "$and": [
            {
              "$state": "/_loading/monday.get_board_items_page",
              "not": true
            },
            {
              "$state": "/ui/items/hasData"
            }
          ]
        }
      },
      "listSection": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "children": [
          "itemRow"
        ],
        "repeat": {
          "statePath": "/ui/items/rows",
          "key": "id"
        },
        "visible": {
          "$state": "/_loading/monday.get_board_items_page",
          "not": true
        }
      },
      "itemRow": {
        "type": "Row",
        "props": {
          "justify": "between",
          "align": "center",
          "gap": "sm"
        },
        "children": [
          "itemLeft",
          "itemBadge"
        ]
      },
      "itemLeft": {
        "type": "Stack",
        "props": {
          "gap": "none",
          "grow": true
        },
        "children": [
          "itemName",
          "itemMeta"
        ]
      },
      "itemName": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "name"
          },
          "size": "sm",
          "weight": "medium",
          "truncate": true
        }
      },
      "itemMeta": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{g} · Updated {u}",
              "g": {
                "$item": "groupTitle"
              },
              "u": {
                "$computed": "relative_time",
                "args": {
                  "value": {
                    "$item": "updatedAt"
                  }
                }
              }
            }
          },
          "tone": "muted"
        }
      },
      "itemBadge": {
        "type": "Badge",
        "props": {
          "text": {
            "$item": "status"
          },
          "tone": {
            "$item": "statusTone"
          },
          "variant": "soft",
          "minWidth": "6rem"
        }
      },
      "openBtnRow": {
        "type": "Row",
        "props": {
          "justify": "end"
        },
        "children": [
          "openBtn"
        ],
        "visible": {
          "$state": "/ui/selectedBoardId"
        }
      },
      "openBtn": {
        "type": "Button",
        "props": {
          "label": "Open in monday.com",
          "variant": "ghost",
          "tone": "accent",
          "size": "sm",
          "leadingIcon": "ExternalLink"
        },
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "url": {
                "$computed": "monday_board_url",
                "args": {
                  "boards": {
                    "$state": "/monday/get_board_info/boards"
                  },
                  "selectedId": {
                    "$state": "/ui/selectedBoardId"
                  }
                }
              },
              "target": "_blank"
            }
          }
        }
      }
    }
  },
  "status": "published",
  "branding": {
    "color": "#0073ea"
  }
}
