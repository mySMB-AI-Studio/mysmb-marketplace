{
  "category": "work-management",
  "connectorsUsed": [
    "monday"
  ],
  "dataProvider": {
    "kind": "tool",
    "mcp": "monday",
    "params": {},
    "tool": "list_users_and_teams"
  },
  "description": "Your monday.com workspace members — an admin/member/guest breakdown plus the full roster.",
  "id": "monday-team-members",
  "keywords": [
    "team",
    "members",
    "users",
    "people",
    "monday",
    "workspace",
    "admin",
    "guest"
  ],
  "popularity": 0,
  "sizing": {
    "max": {
      "colSpan": 8,
      "rowSpan": 10
    },
    "min": {
      "colSpan": 3,
      "rowSpan": 4
    },
    "preferred": {
      "colSpan": 4,
      "rowSpan": 6
    }
  },
  "spec": {
    "elements": {
      "adminBadge": {
        "props": {
          "text": "Admin",
          "tone": "accent",
          "variant": "soft"
        },
        "type": "Badge",
        "visible": {
          "$item": "is_admin"
        }
      },
      "adminLabel": {
        "props": {
          "text": "Admins"
        },
        "type": "Caption"
      },
      "adminStat": {
        "children": [
          "adminVal",
          "adminLabel"
        ],
        "props": {
          "align": "center",
          "gap": "none",
          "grow": true
        },
        "type": "Stack"
      },
      "adminVal": {
        "props": {
          "tone": "muted",
          "value": {
            "$computed": "count",
            "args": {
              "value": {
                "$computed": "filter_by",
                "args": {
                  "field": "is_admin",
                  "value": {
                    "$state": "/monday/list_users_and_teams/users"
                  }
                }
              }
            }
          }
        },
        "type": "Stat"
      },
      "avatar": {
        "props": {
          "initials": {
            "$computed": "initials",
            "args": {
              "value": {
                "$item": "name"
              }
            }
          }
        },
        "type": "Avatar"
      },
      "card": {
        "children": [
          "titleRow",
          "loading",
          "empty",
          "content"
        ],
        "props": {},
        "type": "Card"
      },
      "content": {
        "children": [
          "statSection",
          "div1",
          "listLabel",
          "list"
        ],
        "props": {
          "gap": "md"
        },
        "type": "Stack",
        "visible": {
          "$and": [
            {
              "$state": "/_loading/monday.list_users_and_teams",
              "not": true
            },
            {
              "$state": "/monday/list_users_and_teams/users/0"
            }
          ]
        }
      },
      "div1": {
        "props": {},
        "type": "Divider"
      },
      "empty": {
        "props": {
          "message": "No team members found."
        },
        "type": "Empty",
        "visible": {
          "$and": [
            {
              "$state": "/_loading/monday.list_users_and_teams",
              "not": true
            },
            {
              "$state": "/monday/list_users_and_teams/users/0",
              "not": true
            }
          ]
        }
      },
      "eyebrow": {
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "n": {
                "$state": "/monday/list_users_and_teams/count"
              },
              "pattern": "monday.com · {n} members"
            }
          }
        },
        "type": "Eyebrow"
      },
      "guestBadge": {
        "props": {
          "text": "Guest",
          "tone": "muted",
          "variant": "soft"
        },
        "type": "Badge",
        "visible": {
          "$item": "is_guest"
        }
      },
      "guestLabel": {
        "props": {
          "text": "Guests"
        },
        "type": "Caption"
      },
      "guestStat": {
        "children": [
          "guestVal",
          "guestLabel"
        ],
        "props": {
          "align": "center",
          "gap": "none",
          "grow": true
        },
        "type": "Stack"
      },
      "guestVal": {
        "props": {
          "tone": "muted",
          "value": {
            "$computed": "count",
            "args": {
              "value": {
                "$computed": "filter_by",
                "args": {
                  "field": "is_guest",
                  "value": {
                    "$state": "/monday/list_users_and_teams/users"
                  }
                }
              }
            }
          }
        },
        "type": "Stat"
      },
      "list": {
        "children": [
          "userRow"
        ],
        "props": {
          "gap": "xs"
        },
        "repeat": {
          "key": "id",
          "statePath": "/monday/list_users_and_teams/users"
        },
        "type": "Stack"
      },
      "listLabel": {
        "props": {
          "text": "All members"
        },
        "type": "Eyebrow"
      },
      "loading": {
        "children": [
          "s1",
          "s2",
          "s3"
        ],
        "props": {
          "gap": "sm"
        },
        "type": "Stack",
        "visible": {
          "$state": "/_loading/monday.list_users_and_teams"
        }
      },
      "roleBadges": {
        "children": [
          "adminBadge",
          "guestBadge"
        ],
        "props": {
          "gap": "xs"
        },
        "type": "Row"
      },
      "s1": {
        "props": {
          "height": "2.5rem",
          "rounded": "full"
        },
        "type": "Skeleton"
      },
      "s2": {
        "props": {
          "height": "2.5rem",
          "rounded": "full"
        },
        "type": "Skeleton"
      },
      "s3": {
        "props": {
          "height": "2.5rem",
          "rounded": "full"
        },
        "type": "Skeleton"
      },
      "statRow": {
        "children": [
          "totalStat",
          "adminStat",
          "guestStat"
        ],
        "props": {
          "gap": "lg"
        },
        "type": "Row"
      },
      "statSection": {
        "children": [
          "statRow"
        ],
        "props": {
          "variant": "muted"
        },
        "type": "Section"
      },
      "title": {
        "props": {
          "level": "h2",
          "text": "Team Members"
        },
        "type": "Heading"
      },
      "titleGroup": {
        "children": [
          "titleIcon",
          "titleStack"
        ],
        "props": {
          "align": "center",
          "gap": "sm"
        },
        "type": "Row"
      },
      "titleIcon": {
        "props": {
          "name": "Users",
          "size": "sm",
          "tone": "accent"
        },
        "type": "Icon"
      },
      "titleRow": {
        "children": [
          "titleGroup"
        ],
        "props": {
          "align": "center",
          "justify": "between"
        },
        "type": "Row"
      },
      "titleStack": {
        "children": [
          "title",
          "eyebrow"
        ],
        "props": {
          "gap": "none"
        },
        "type": "Stack"
      },
      "totalLabel": {
        "props": {
          "text": "Total"
        },
        "type": "Caption"
      },
      "totalStat": {
        "children": [
          "totalVal",
          "totalLabel"
        ],
        "props": {
          "align": "center",
          "gap": "none",
          "grow": true
        },
        "type": "Stack"
      },
      "totalVal": {
        "props": {
          "tone": "accent",
          "value": {
            "$state": "/monday/list_users_and_teams/count"
          }
        },
        "type": "Stat"
      },
      "userEmail": {
        "props": {
          "size": "xs",
          "text": {
            "$item": "email"
          },
          "tone": "muted",
          "truncate": true
        },
        "type": "Text"
      },
      "userInfo": {
        "children": [
          "userName",
          "userEmail"
        ],
        "props": {
          "gap": "none",
          "grow": true
        },
        "type": "Stack"
      },
      "userLeft": {
        "children": [
          "avatar",
          "userInfo"
        ],
        "props": {
          "align": "center",
          "gap": "sm",
          "grow": true
        },
        "type": "Row"
      },
      "userName": {
        "props": {
          "size": "sm",
          "text": {
            "$item": "name"
          },
          "truncate": true,
          "weight": "medium"
        },
        "type": "Text"
      },
      "userRow": {
        "children": [
          "userLeft",
          "roleBadges"
        ],
        "props": {
          "align": "center",
          "gap": "sm",
          "justify": "between"
        },
        "type": "Row"
      }
    },
    "root": "card"
  },
  "tags": [
    "monday",
    "team",
    "users",
    "people",
    "work-management"
  ],
  "title": "Team Members"
}
