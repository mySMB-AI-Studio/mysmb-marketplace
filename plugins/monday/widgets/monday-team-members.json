{
  "id": "monday-team-members",
  "title": "Team Members",
  "description": "Your monday.com workspace members — an admin/guest breakdown plus the full roster.",
  "category": "work-management",
  "tags": [
    "monday",
    "team",
    "users",
    "people",
    "work-management"
  ],
  "keywords": [
    "team",
    "members",
    "users",
    "people",
    "monday",
    "workspace",
    "admin",
    "guest"
  ],
  "connectorsUsed": [
    "monday"
  ],
  "popularity": 0,
  "sizing": {
    "preferred": {
      "colSpan": 4,
      "rowSpan": 6
    },
    "min": {
      "colSpan": 3,
      "rowSpan": 4
    },
    "max": {
      "colSpan": 8,
      "rowSpan": 10
    }
  },
  "dataProvider": {
    "mcp": "monday",
    "tool": "list_users_and_teams",
    "params": {}
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": [
          "titleRow",
          "loading",
          "empty",
          "content"
        ],
        "watch": {
          "/monday/list_users_and_teams/users": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/team",
                "value": {
                  "$computed": "monday_team_dashboard",
                  "args": {
                    "value": {
                      "$state": "/monday/list_users_and_teams/users"
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "titleRow": {
        "type": "Row",
        "props": {
          "justify": "between",
          "align": "center"
        },
        "children": [
          "titleGroup"
        ]
      },
      "titleGroup": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center"
        },
        "children": [
          "titleIcon",
          "titleStack"
        ]
      },
      "titleIcon": {
        "type": "Icon",
        "props": {
          "name": "Users",
          "tone": "accent",
          "size": "sm"
        }
      },
      "titleStack": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "children": [
          "title",
          "eyebrow"
        ]
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "Team Members",
          "level": "h2"
        }
      },
      "eyebrow": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$state": "/ui/team/scopeText"
          }
        }
      },
      "loading": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "s1",
          "s2",
          "s3"
        ],
        "visible": {
          "$state": "/_loading/monday.list_users_and_teams"
        }
      },
      "s1": {
        "type": "Skeleton",
        "props": {
          "height": "2.5rem",
          "rounded": "full"
        }
      },
      "s2": {
        "type": "Skeleton",
        "props": {
          "height": "2.5rem",
          "rounded": "full"
        }
      },
      "s3": {
        "type": "Skeleton",
        "props": {
          "height": "2.5rem",
          "rounded": "full"
        }
      },
      "empty": {
        "type": "Empty",
        "props": {
          "message": "No team members found."
        },
        "visible": {
          "$and": [
            {
              "$state": "/_loading/monday.list_users_and_teams",
              "not": true
            },
            {
              "$state": "/ui/team/hasData",
              "not": true
            }
          ]
        }
      },
      "content": {
        "type": "Stack",
        "props": {
          "gap": "md"
        },
        "children": [
          "statSection",
          "divider1",
          "listLabel",
          "list"
        ],
        "visible": {
          "$and": [
            {
              "$state": "/_loading/monday.list_users_and_teams",
              "not": true
            },
            {
              "$state": "/ui/team/hasData"
            }
          ]
        }
      },
      "statSection": {
        "type": "Section",
        "props": {
          "variant": "muted"
        },
        "children": [
          "statRow"
        ]
      },
      "statRow": {
        "type": "Grid",
        "props": {
          "cols": 3,
          "gap": "sm"
        },
        "children": [
          "totalCell",
          "adminCell",
          "guestCell"
        ]
      },
      "totalCell": {
        "type": "Stack",
        "props": {
          "gap": "none",
          "align": "center"
        },
        "children": [
          "totalStat",
          "totalLabel"
        ]
      },
      "totalStat": {
        "type": "Stat",
        "props": {
          "value": {
            "$state": "/ui/team/total"
          },
          "tone": "brand",
          "size": "sm"
        }
      },
      "totalLabel": {
        "type": "Caption",
        "props": {
          "text": "Total",
          "tone": "muted"
        }
      },
      "adminCell": {
        "type": "Stack",
        "props": {
          "gap": "none",
          "align": "center"
        },
        "children": [
          "adminStat",
          "adminLabel"
        ]
      },
      "adminStat": {
        "type": "Stat",
        "props": {
          "value": {
            "$state": "/ui/team/adminCount"
          },
          "size": "sm"
        }
      },
      "adminLabel": {
        "type": "Caption",
        "props": {
          "text": "Admins",
          "tone": "muted"
        }
      },
      "guestCell": {
        "type": "Stack",
        "props": {
          "gap": "none",
          "align": "center"
        },
        "children": [
          "guestStat",
          "guestLabel"
        ]
      },
      "guestStat": {
        "type": "Stat",
        "props": {
          "value": {
            "$state": "/ui/team/guestCount"
          },
          "size": "sm"
        }
      },
      "guestLabel": {
        "type": "Caption",
        "props": {
          "text": "Guests",
          "tone": "muted"
        }
      },
      "divider1": {
        "type": "Divider",
        "props": {}
      },
      "listLabel": {
        "type": "Eyebrow",
        "props": {
          "text": "All members"
        }
      },
      "list": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "children": [
          "userRow"
        ],
        "repeat": {
          "statePath": "/ui/team/rows",
          "key": "id"
        }
      },
      "userRow": {
        "type": "Row",
        "props": {
          "align": "center",
          "gap": "sm",
          "justify": "between"
        },
        "children": [
          "userLeft",
          "roleBadge"
        ]
      },
      "userLeft": {
        "type": "Row",
        "props": {
          "align": "center",
          "gap": "sm",
          "grow": true
        },
        "children": [
          "avatar",
          "userInfo"
        ]
      },
      "avatar": {
        "type": "Avatar",
        "props": {
          "initials": {
            "$item": "initials"
          },
          "tone": {
            "$item": "avatarTone"
          }
        }
      },
      "userInfo": {
        "type": "Stack",
        "props": {
          "gap": "none",
          "grow": true
        },
        "children": [
          "userName",
          "userEmail"
        ]
      },
      "userName": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "name"
          },
          "size": "sm",
          "weight": "medium",
          "truncate": true
        }
      },
      "userEmail": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "email"
          },
          "size": "xs",
          "tone": "muted",
          "truncate": true
        }
      },
      "roleBadge": {
        "type": "Badge",
        "props": {
          "text": {
            "$item": "roleLabel"
          },
          "tone": {
            "$item": "roleTone"
          },
          "variant": "soft"
        }
      }
    }
  },
  "status": "published",
  "branding": {
    "color": "#0073ea"
  }
}
