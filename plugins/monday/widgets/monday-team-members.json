{
  "id": "monday-team-members",
  "title": "Team Members",
  "description": "Your monday.com workspace members — an admin/member/guest breakdown plus the full roster.",
  "category": "work-management",
  "tags": ["monday", "team", "users", "people", "work-management"],
  "keywords": ["team", "members", "users", "people", "monday", "workspace", "admin", "guest"],
  "connectorsUsed": ["monday"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 4, "rowSpan": 6 },
    "min":       { "colSpan": 3, "rowSpan": 4 },
    "max":       { "colSpan": 8, "rowSpan": 10 }
  },
  "dataProvider": {
    "mcp": "monday",
    "tool": "list_users_and_teams",
    "params": {}
  },
  "spec": {
    "root": "card",
    "elements": {

      "card": {
        "type": "Card",
        "props": {},
        "children": ["titleRow", "loading", "empty", "content"]
      },

      "titleRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["titleGroup"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "Users", "tone": "accent", "size": "sm" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "eyebrow"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Team Members", "level": "h2" }
      },
      "eyebrow": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "monday.com · {n} members",
              "n": { "$state": "/monday/list_users_and_teams/count" }
            }
          }
        }
      },

      "loading": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["s1", "s2", "s3"],
        "visible": { "$state": "/_loading/monday.list_users_and_teams" }
      },
      "s1": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "full" } },
      "s2": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "full" } },
      "s3": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "full" } },

      "empty": {
        "type": "Empty",
        "props": { "message": "No team members found." },
        "visible": {
          "$and": [
            { "$state": "/_loading/monday.list_users_and_teams", "not": true },
            { "$state": "/monday/list_users_and_teams/users/0", "not": true }
          ]
        }
      },

      "content": {
        "type": "Stack",
        "props": { "gap": "md" },
        "children": ["statSection", "div1", "listLabel", "list"],
        "visible": {
          "$and": [
            { "$state": "/_loading/monday.list_users_and_teams", "not": true },
            { "$state": "/monday/list_users_and_teams/users/0" }
          ]
        }
      },

      "statSection": {
        "type": "Section",
        "props": { "variant": "muted" },
        "children": ["statRow"]
      },
      "statRow": {
        "type": "Row",
        "props": { "gap": "lg" },
        "children": ["totalStat", "adminStat", "guestStat"]
      },
      "totalStat": {
        "type": "Stack",
        "props": { "gap": "none", "grow": true, "align": "center" },
        "children": ["totalVal", "totalLabel"]
      },
      "totalVal": {
        "type": "Stat",
        "props": { "value": { "$state": "/monday/list_users_and_teams/count" }, "tone": "accent" }
      },
      "totalLabel": { "type": "Caption", "props": { "text": "Total" } },
      "adminStat": {
        "type": "Stack",
        "props": { "gap": "none", "grow": true, "align": "center" },
        "children": ["adminVal", "adminLabel"]
      },
      "adminVal": {
        "type": "Stat",
        "props": {
          "value": {
            "$computed": "count",
            "args": {
              "value": {
                "$computed": "filter_by",
                "args": { "value": { "$state": "/monday/list_users_and_teams/users" }, "field": "is_admin" }
              }
            }
          },
          "tone": "muted"
        }
      },
      "adminLabel": { "type": "Caption", "props": { "text": "Admins" } },
      "guestStat": {
        "type": "Stack",
        "props": { "gap": "none", "grow": true, "align": "center" },
        "children": ["guestVal", "guestLabel"]
      },
      "guestVal": {
        "type": "Stat",
        "props": {
          "value": {
            "$computed": "count",
            "args": {
              "value": {
                "$computed": "filter_by",
                "args": { "value": { "$state": "/monday/list_users_and_teams/users" }, "field": "is_guest" }
              }
            }
          },
          "tone": "muted"
        }
      },
      "guestLabel": { "type": "Caption", "props": { "text": "Guests" } },

      "div1": { "type": "Divider", "props": {} },
      "listLabel": { "type": "Eyebrow", "props": { "text": "All members" } },

      "list": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["userRow"],
        "repeat": {
          "statePath": "/monday/list_users_and_teams/users",
          "key": "id"
        }
      },

      "userRow": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center", "justify": "between" },
        "children": ["userLeft", "roleBadges"]
      },
      "userLeft": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center", "grow": true },
        "children": ["avatar", "userInfo"]
      },
      "avatar": {
        "type": "Avatar",
        "props": {
          "initials": {
            "$computed": "initials",
            "args": { "value": { "$item": "name" } }
          }
        }
      },
      "userInfo": {
        "type": "Stack",
        "props": { "gap": "none", "grow": true },
        "children": ["userName", "userEmail"]
      },
      "userName": {
        "type": "Text",
        "props": {
          "text": { "$item": "name" },
          "size": "sm",
          "weight": "medium",
          "truncate": true
        }
      },
      "userEmail": {
        "type": "Text",
        "props": {
          "text": { "$item": "email" },
          "size": "xs",
          "tone": "muted",
          "truncate": true
        }
      },
      "roleBadges": {
        "type": "Row",
        "props": { "gap": "xs" },
        "children": ["adminBadge", "guestBadge"]
      },
      "adminBadge": {
        "type": "Badge",
        "props": { "text": "Admin", "tone": "accent", "variant": "soft" },
        "visible": { "$item": "is_admin" }
      },
      "guestBadge": {
        "type": "Badge",
        "props": { "text": "Guest", "tone": "muted", "variant": "soft" },
        "visible": { "$item": "is_guest" }
      }

    }
  },
  "status": "published"
}
