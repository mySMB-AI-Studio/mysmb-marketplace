{
  "id": "monday-my-boards",
  "title": "Boards",
  "description": "Your monday.com boards in a sortable table — name, type, status, and a one-click link to each.",
  "category": "work-management",
  "tags": ["monday", "boards", "work-management", "tasks", "projects", "table"],
  "keywords": ["board", "boards", "workspace", "monday", "project", "task", "overview", "table"],
  "connectorsUsed": ["monday"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 6, "rowSpan": 4 },
    "min":       { "colSpan": 4, "rowSpan": 4 },
    "max":       { "colSpan": 10, "rowSpan": 10 }
  },
  "dataProvider": {
    "mcp": "monday",
    "tool": "get_board_info",
    "params": { "limit": 20 }
  },
  "spec": {
    "root": "card",
    "elements": {

      "card": {
        "type": "Card",
        "props": {},
        "children": ["titleRow", "statSection", "tableBody"]
      },

      "titleRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["titleGroup"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "LayoutGrid", "tone": "accent", "size": "sm" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "eyebrow"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Boards", "level": "h2" }
      },
      "eyebrow": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "monday.com · {n} boards",
              "n": { "$state": "/monday/get_board_info/count" }
            }
          }
        }
      },

      "statSection": {
        "type": "Section",
        "props": { "variant": "muted" },
        "children": ["statRow"],
        "visible": { "$state": "/_loading/monday.get_board_info", "not": true }
      },
      "statRow": {
        "type": "Row",
        "props": { "gap": "lg" },
        "children": ["activeStat", "archivedStat"]
      },
      "activeStat": {
        "type": "Stack",
        "props": { "gap": "none", "grow": true, "align": "center" },
        "children": ["activeVal", "activeLabel"]
      },
      "activeVal": {
        "type": "Stat",
        "props": {
          "value": {
            "$computed": "count",
            "args": {
              "value": {
                "$computed": "filter_by",
                "args": {
                  "value": { "$state": "/monday/get_board_info/boards" },
                  "field": "state",
                  "equals": "active"
                }
              }
            }
          },
          "tone": "success"
        }
      },
      "activeLabel": { "type": "Caption", "props": { "text": "Active" } },
      "archivedStat": {
        "type": "Stack",
        "props": { "gap": "none", "grow": true, "align": "center" },
        "children": ["archivedVal", "archivedLabel"]
      },
      "archivedVal": {
        "type": "Stat",
        "props": {
          "value": {
            "$computed": "count",
            "args": {
              "value": {
                "$computed": "filter_by",
                "args": {
                  "value": { "$state": "/monday/get_board_info/boards" },
                  "field": "state",
                  "equals": "archived"
                }
              }
            }
          },
          "tone": "muted"
        }
      },
      "archivedLabel": { "type": "Caption", "props": { "text": "Archived" } },

      "tableBody": {
        "type": "Body",
        "props": {},
        "children": ["table", "empty"]
      },
      "empty": {
        "type": "Empty",
        "props": { "message": "No boards found." },
        "visible": {
          "$and": [
            { "$state": "/_loading/monday.get_board_info", "not": true },
            { "$state": "/monday/get_board_info/boards/0", "not": true }
          ]
        }
      },
      "table": {
        "type": "Table",
        "props": {
          "loading": { "$state": "/_loading/monday.get_board_info" },
          "skeletonRows": 5,
          "rows": { "$state": "/monday/get_board_info/boards" },
          "rowAction": [
            {
              "action": "open_url",
              "params": { "url": "{boardUrl}", "target": "_blank" },
              "fromRow": { "boardUrl": "url" }
            }
          ],
          "columns": [
            { "id": "name",       "header": "Board",  "field": "name",       "priority": 1 },
            { "id": "board_kind", "header": "Type",    "field": "board_kind", "width": 90,  "priority": 2 },
            { "id": "state",      "header": "State",   "field": "state",      "width": 90,  "priority": 2 },
            { "id": "workspace",  "header": "Workspace", "field": "workspace.name", "width": 140, "priority": 2 }
          ]
        }
      }

    }
  },
  "status": "published"
}
