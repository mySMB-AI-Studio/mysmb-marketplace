{
  "category": "work-management",
  "connectorsUsed": [
    "monday"
  ],
  "dataProvider": {
    "kind": "tool",
    "mcp": "monday",
    "params": {
      "limit": 20
    },
    "tool": "get_board_info"
  },
  "description": "Your monday.com boards in a sortable table — name, type, status, and a one-click link to each.",
  "id": "monday-my-boards",
  "keywords": [
    "board",
    "boards",
    "workspace",
    "monday",
    "project",
    "task",
    "overview",
    "table"
  ],
  "popularity": 0,
  "sizing": {
    "max": {
      "colSpan": 10,
      "rowSpan": 10
    },
    "min": {
      "colSpan": 4,
      "rowSpan": 4
    },
    "preferred": {
      "colSpan": 6,
      "rowSpan": 4
    }
  },
  "spec": {
    "elements": {
      "activeLabel": {
        "props": {
          "text": "Active"
        },
        "type": "Caption"
      },
      "activeStat": {
        "children": [
          "activeVal",
          "activeLabel"
        ],
        "props": {
          "align": "center",
          "gap": "none",
          "grow": true
        },
        "type": "Stack"
      },
      "activeVal": {
        "props": {
          "tone": "success",
          "value": {
            "$computed": "count",
            "args": {
              "value": {
                "$computed": "filter_by",
                "args": {
                  "equals": "active",
                  "field": "state",
                  "value": {
                    "$state": "/monday/get_board_info/boards"
                  }
                }
              }
            }
          }
        },
        "type": "Stat"
      },
      "archivedLabel": {
        "props": {
          "text": "Archived"
        },
        "type": "Caption"
      },
      "archivedStat": {
        "children": [
          "archivedVal",
          "archivedLabel"
        ],
        "props": {
          "align": "center",
          "gap": "none",
          "grow": true
        },
        "type": "Stack"
      },
      "archivedVal": {
        "props": {
          "tone": "muted",
          "value": {
            "$computed": "count",
            "args": {
              "value": {
                "$computed": "filter_by",
                "args": {
                  "equals": "archived",
                  "field": "state",
                  "value": {
                    "$state": "/monday/get_board_info/boards"
                  }
                }
              }
            }
          }
        },
        "type": "Stat"
      },
      "card": {
        "children": [
          "titleRow",
          "statSection",
          "tableBody"
        ],
        "props": {},
        "type": "Card"
      },
      "empty": {
        "props": {
          "message": "No boards found."
        },
        "type": "Empty",
        "visible": {
          "$and": [
            {
              "$state": "/_loading/monday.get_board_info",
              "not": true
            },
            {
              "$state": "/monday/get_board_info/boards/0",
              "not": true
            }
          ]
        }
      },
      "eyebrow": {
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "n": {
                "$state": "/monday/get_board_info/count"
              },
              "pattern": "monday.com · {n} boards"
            }
          }
        },
        "type": "Eyebrow"
      },
      "statRow": {
        "children": [
          "activeStat",
          "archivedStat"
        ],
        "props": {
          "gap": "lg"
        },
        "type": "Row"
      },
      "statSection": {
        "children": [
          "statRow"
        ],
        "props": {
          "variant": "muted"
        },
        "type": "Section",
        "visible": {
          "$state": "/_loading/monday.get_board_info",
          "not": true
        }
      },
      "table": {
        "props": {
          "columns": [
            {
              "field": "name",
              "header": "Board",
              "id": "name",
              "priority": 1
            },
            {
              "field": "board_kind",
              "header": "Type",
              "id": "board_kind",
              "priority": 2,
              "width": 90
            },
            {
              "field": "state",
              "header": "State",
              "id": "state",
              "priority": 2,
              "width": 90
            },
            {
              "field": "workspace.name",
              "header": "Workspace",
              "id": "workspace",
              "priority": 2,
              "width": 140
            }
          ],
          "loading": {
            "$state": "/_loading/monday.get_board_info"
          },
          "rowAction": [
            {
              "action": "open_url",
              "fromRow": {
                "boardUrl": "url"
              },
              "params": {
                "target": "_blank",
                "url": "{boardUrl}"
              }
            }
          ],
          "rows": {
            "$state": "/monday/get_board_info/boards"
          },
          "skeletonRows": 5
        },
        "type": "Table"
      },
      "tableBody": {
        "children": [
          "table",
          "empty"
        ],
        "props": {},
        "type": "Body"
      },
      "title": {
        "props": {
          "level": "h2",
          "text": "Boards"
        },
        "type": "Heading"
      },
      "titleGroup": {
        "children": [
          "titleIcon",
          "titleStack"
        ],
        "props": {
          "align": "center",
          "gap": "sm"
        },
        "type": "Row"
      },
      "titleIcon": {
        "props": {
          "name": "LayoutGrid",
          "size": "sm",
          "tone": "accent"
        },
        "type": "Icon"
      },
      "titleRow": {
        "children": [
          "titleGroup"
        ],
        "props": {
          "align": "center",
          "justify": "between"
        },
        "type": "Row"
      },
      "titleStack": {
        "children": [
          "title",
          "eyebrow"
        ],
        "props": {
          "gap": "none"
        },
        "type": "Stack"
      }
    },
    "root": "card"
  },
  "tags": [
    "monday",
    "boards",
    "work-management",
    "tasks",
    "projects",
    "table"
  ],
  "title": "Boards"
}
