{
  "id": "monday-my-boards",
  "title": "Boards",
  "description": "Your monday.com boards: Active/Archived breakdown, then a sortable table with name, type, status, and a one-click link to each.",
  "category": "work-management",
  "tags": [
    "monday",
    "boards",
    "work-management",
    "tasks",
    "projects",
    "table"
  ],
  "keywords": [
    "board",
    "boards",
    "workspace",
    "monday",
    "project",
    "task",
    "overview",
    "table"
  ],
  "connectorsUsed": [
    "monday"
  ],
  "popularity": 0,
  "sizing": {
    "preferred": {
      "colSpan": 6,
      "rowSpan": 4
    },
    "min": {
      "colSpan": 4,
      "rowSpan": 4
    },
    "max": {
      "colSpan": 10,
      "rowSpan": 10
    }
  },
  "dataProvider": {
    "mcp": "monday",
    "tool": "get_board_info",
    "params": {
      "limit": 20
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": [
          "titleRow",
          "statSection",
          "tableBody"
        ],
        "watch": {
          "/monday/get_board_info/boards": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/boards",
                "value": {
                  "$computed": "monday_boards_dashboard",
                  "args": {
                    "value": {
                      "$state": "/monday/get_board_info/boards"
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "titleRow": {
        "type": "Row",
        "props": {
          "justify": "between",
          "align": "center"
        },
        "children": [
          "titleGroup"
        ]
      },
      "titleGroup": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center"
        },
        "children": [
          "titleIcon",
          "titleStack"
        ]
      },
      "titleIcon": {
        "type": "Icon",
        "props": {
          "name": "LayoutGrid",
          "tone": "accent",
          "size": "sm"
        }
      },
      "titleStack": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "children": [
          "title",
          "eyebrow"
        ]
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "Boards",
          "level": "h2"
        }
      },
      "eyebrow": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "monday.com · {n} boards",
              "n": {
                "$state": "/ui/boards/total"
              }
            }
          }
        }
      },
      "statSection": {
        "type": "Section",
        "props": {
          "variant": "muted"
        },
        "children": [
          "statRow"
        ],
        "visible": {
          "$and": [
            {
              "$state": "/_loading/monday.get_board_info",
              "not": true
            },
            {
              "$state": "/ui/boards/hasData"
            }
          ]
        }
      },
      "statRow": {
        "type": "Grid",
        "props": {
          "cols": 2,
          "gap": "sm"
        },
        "children": [
          "activeCell",
          "archivedCell"
        ]
      },
      "activeCell": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "children": [
          "activeTopRow",
          "activeBarRow"
        ]
      },
      "activeTopRow": {
        "type": "Row",
        "props": {
          "justify": "between",
          "align": "baseline"
        },
        "children": [
          "activeLabel",
          "activeStat"
        ]
      },
      "activeLabel": {
        "type": "Caption",
        "props": {
          "text": "Active",
          "tone": "success"
        }
      },
      "activeStat": {
        "type": "Stat",
        "props": {
          "value": {
            "$state": "/ui/boards/activeCount"
          },
          "size": "sm"
        }
      },
      "activeBar": {
        "type": "ProgressBar",
        "props": {
          "value": {
            "$state": "/ui/boards/activePct"
          },
          "tone": "success"
        }
      },
      "archivedCell": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "children": [
          "archivedTopRow",
          "archivedBarRow"
        ]
      },
      "archivedTopRow": {
        "type": "Row",
        "props": {
          "justify": "between",
          "align": "baseline"
        },
        "children": [
          "archivedLabel",
          "archivedStat"
        ]
      },
      "archivedLabel": {
        "type": "Caption",
        "props": {
          "text": "Archived",
          "tone": "muted"
        }
      },
      "archivedStat": {
        "type": "Stat",
        "props": {
          "value": {
            "$state": "/ui/boards/archivedCount"
          },
          "size": "sm"
        }
      },
      "archivedBar": {
        "type": "ProgressBar",
        "props": {
          "value": {
            "$state": "/ui/boards/archivedPct"
          },
          "tone": "muted"
        }
      },
      "tableBody": {
        "type": "Body",
        "props": {},
        "children": [
          "table",
          "empty"
        ]
      },
      "table": {
        "type": "Table",
        "props": {
          "columns": [
            {
              "id": "name",
              "field": "name",
              "header": "Board",
              "priority": 1
            },
            {
              "id": "board_kind",
              "field": "board_kind",
              "header": "Type",
              "priority": 2,
              "width": 90
            },
            {
              "id": "state",
              "field": "state",
              "header": "State",
              "priority": 2,
              "width": 90
            },
            {
              "id": "workspace",
              "field": "workspace.name",
              "header": "Workspace",
              "priority": 2,
              "width": 140
            }
          ],
          "rows": {
            "$state": "/monday/get_board_info/boards"
          },
          "rowAction": [
            {
              "action": "open_url",
              "fromRow": {
                "boardUrl": "url"
              },
              "params": {
                "url": "{boardUrl}",
                "target": "_blank"
              }
            }
          ],
          "loading": {
            "$state": "/_loading/monday.get_board_info"
          },
          "skeletonRows": 5
        }
      },
      "empty": {
        "type": "Empty",
        "props": {
          "message": "No boards found."
        },
        "visible": {
          "$and": [
            {
              "$state": "/_loading/monday.get_board_info",
              "not": true
            },
            {
              "$state": "/monday/get_board_info/boards/0",
              "not": true
            }
          ]
        }
      },
      "activeBarRow": {
        "type": "Row",
        "props": {
          "template": "minmax(0, 1fr)",
          "align": "center"
        },
        "children": [
          "activeBar"
        ]
      },
      "archivedBarRow": {
        "type": "Row",
        "props": {
          "template": "minmax(0, 1fr)",
          "align": "center"
        },
        "children": [
          "archivedBar"
        ]
      }
    }
  },
  "status": "published",
  "branding": {
    "color": "#0073ea"
  }
}
