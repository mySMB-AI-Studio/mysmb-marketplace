{
  "category": "work-management",
  "connectorsUsed": [
    "monday"
  ],
  "dataProvider": {
    "kind": "tool",
    "mcp": "monday",
    "params": {},
    "tool": "list_workspaces"
  },
  "description": "All monday.com workspaces you have access to.",
  "id": "monday-workspaces",
  "keywords": [
    "workspace",
    "workspaces",
    "monday",
    "organization",
    "space"
  ],
  "popularity": 0,
  "sizing": {
    "max": {
      "colSpan": 6,
      "rowSpan": 8
    },
    "min": {
      "colSpan": 2,
      "rowSpan": 3
    },
    "preferred": {
      "colSpan": 3,
      "rowSpan": 4
    }
  },
  "spec": {
    "elements": {
      "card": {
        "children": [
          "titleRow",
          "loading",
          "empty",
          "list"
        ],
        "props": {},
        "type": "Card"
      },
      "empty": {
        "props": {
          "message": "No workspaces found."
        },
        "type": "Empty",
        "visible": {
          "$and": [
            {
              "$state": "/_loading/monday.list_workspaces",
              "not": true
            },
            {
              "$state": "/monday/list_workspaces/workspaces/0",
              "not": true
            }
          ]
        }
      },
      "eyebrow": {
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "n": {
                "$state": "/monday/list_workspaces/count"
              },
              "pattern": "monday.com · {n} workspaces"
            }
          }
        },
        "type": "Eyebrow"
      },
      "kindBadge": {
        "props": {
          "text": {
            "$item": "kind"
          },
          "tone": "info",
          "variant": "soft"
        },
        "type": "Badge"
      },
      "list": {
        "children": [
          "wsRow"
        ],
        "props": {
          "gap": "xs"
        },
        "repeat": {
          "key": "id",
          "statePath": "/monday/list_workspaces/workspaces"
        },
        "type": "Stack",
        "visible": {
          "$state": "/_loading/monday.list_workspaces",
          "not": true
        }
      },
      "loading": {
        "children": [
          "s1",
          "s2",
          "s3"
        ],
        "props": {
          "gap": "sm"
        },
        "type": "Stack",
        "visible": {
          "$state": "/_loading/monday.list_workspaces"
        }
      },
      "s1": {
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "s2": {
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "s3": {
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "title": {
        "props": {
          "level": "h2",
          "text": "Workspaces"
        },
        "type": "Heading"
      },
      "titleGroup": {
        "children": [
          "titleIcon",
          "titleStack"
        ],
        "props": {
          "align": "center",
          "gap": "sm"
        },
        "type": "Row"
      },
      "titleIcon": {
        "props": {
          "name": "Grid",
          "size": "sm",
          "tone": "accent"
        },
        "type": "Icon"
      },
      "titleRow": {
        "children": [
          "titleGroup"
        ],
        "props": {
          "align": "center",
          "justify": "between"
        },
        "type": "Row"
      },
      "titleStack": {
        "children": [
          "title",
          "eyebrow"
        ],
        "props": {
          "gap": "none"
        },
        "type": "Stack"
      },
      "wsDesc": {
        "props": {
          "size": "xs",
          "text": {
            "$item": "description"
          },
          "tone": "muted",
          "truncate": true
        },
        "type": "Text",
        "visible": {
          "$item": "description"
        }
      },
      "wsLeft": {
        "children": [
          "wsName",
          "wsDesc"
        ],
        "props": {
          "gap": "none",
          "grow": true
        },
        "type": "Stack"
      },
      "wsName": {
        "props": {
          "size": "sm",
          "text": {
            "$item": "name"
          },
          "truncate": true,
          "weight": "medium"
        },
        "type": "Text"
      },
      "wsRow": {
        "children": [
          "wsLeft",
          "kindBadge"
        ],
        "props": {
          "align": "center",
          "gap": "sm",
          "hover": true,
          "justify": "between"
        },
        "type": "Row"
      }
    },
    "root": "card"
  },
  "tags": [
    "monday",
    "workspaces",
    "work-management",
    "organization"
  ],
  "title": "Workspaces"
}
