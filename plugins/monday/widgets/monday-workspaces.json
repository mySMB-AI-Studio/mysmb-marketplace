{
  "id": "monday-workspaces",
  "title": "Workspaces",
  "description": "All monday.com workspaces you have access to.",
  "category": "work-management",
  "tags": ["monday", "workspaces", "work-management", "organization"],
  "keywords": ["workspace", "workspaces", "monday", "organization", "space"],
  "connectorsUsed": ["monday"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 3, "rowSpan": 4 },
    "min":       { "colSpan": 2, "rowSpan": 3 },
    "max":       { "colSpan": 6, "rowSpan": 8 }
  },
  "dataProvider": {
    "mcp": "monday",
    "tool": "list_workspaces",
    "params": {}
  },
  "spec": {
    "root": "card",
    "elements": {

      "card": {
        "type": "Card",
        "props": {},
        "children": ["titleRow", "loading", "empty", "list"]
      },

      "titleRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["titleGroup", "countBadge"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "Grid", "tone": "accent", "size": "sm" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "eyebrow"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Workspaces", "level": "h2" }
      },
      "eyebrow": {
        "type": "Eyebrow",
        "props": { "text": "monday.com" }
      },
      "countBadge": {
        "type": "Badge",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{n} workspaces",
              "n": { "$state": "/monday/list_workspaces/count" }
            }
          },
          "tone": "neutral"
        },
        "visible": { "$state": "/monday/list_workspaces/count" }
      },

      "loading": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["s1", "s2", "s3"],
        "visible": { "$state": "/_loading/monday.list_workspaces" }
      },
      "s1": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "s2": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "s3": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },

      "empty": {
        "type": "Empty",
        "props": { "message": "No workspaces found." },
        "visible": {
          "$and": [
            { "$state": "/_loading/monday.list_workspaces", "not": true },
            { "$state": "/monday/list_workspaces/workspaces/0", "not": true }
          ]
        }
      },

      "list": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["wsRow"],
        "repeat": {
          "statePath": "/monday/list_workspaces/workspaces",
          "key": "id"
        },
        "visible": { "$state": "/_loading/monday.list_workspaces", "not": true }
      },

      "wsRow": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center", "justify": "between", "hover": true },
        "children": ["wsLeft", "kindBadge"]
      },
      "wsLeft": {
        "type": "Stack",
        "props": { "gap": "none", "grow": true },
        "children": ["wsName", "wsDesc"]
      },
      "wsName": {
        "type": "Text",
        "props": {
          "text": { "$item": "name" },
          "size": "sm",
          "weight": "medium",
          "truncate": true
        }
      },
      "wsDesc": {
        "type": "Text",
        "props": {
          "text": { "$item": "description" },
          "size": "xs",
          "tone": "muted",
          "truncate": true
        },
        "visible": { "$item": "description" }
      },
      "kindBadge": {
        "type": "Badge",
        "props": {
          "text": { "$item": "kind" },
          "tone": "info",
          "variant": "soft"
        }
      }

    }
  },
  "status": "published"
}
