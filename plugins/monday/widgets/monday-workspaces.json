{
  "id": "monday-workspaces",
  "title": "Workspaces",
  "description": "All monday.com workspaces you have access to, with a kind breakdown (Main/Shareable/Template).",
  "category": "work-management",
  "tags": [
    "monday",
    "workspaces",
    "work-management",
    "organization"
  ],
  "keywords": [
    "workspace",
    "workspaces",
    "monday",
    "organization",
    "space"
  ],
  "connectorsUsed": [
    "monday"
  ],
  "popularity": 0,
  "sizing": {
    "preferred": {
      "colSpan": 3,
      "rowSpan": 5
    },
    "min": {
      "colSpan": 2,
      "rowSpan": 3
    },
    "max": {
      "colSpan": 6,
      "rowSpan": 8
    }
  },
  "dataProvider": {
    "mcp": "monday",
    "tool": "list_workspaces",
    "params": {}
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": [
          "titleRow",
          "loading",
          "empty",
          "content"
        ],
        "watch": {
          "/monday/list_workspaces/workspaces": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/ws",
                "value": {
                  "$computed": "monday_workspaces_dashboard",
                  "args": {
                    "value": {
                      "$state": "/monday/list_workspaces/workspaces"
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "titleRow": {
        "type": "Row",
        "props": {
          "justify": "between",
          "align": "center"
        },
        "children": [
          "titleGroup"
        ]
      },
      "titleGroup": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center"
        },
        "children": [
          "titleIcon",
          "titleStack"
        ]
      },
      "titleIcon": {
        "type": "Icon",
        "props": {
          "name": "Grid",
          "tone": "accent",
          "size": "sm"
        }
      },
      "titleStack": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "children": [
          "title",
          "eyebrow"
        ]
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "Workspaces",
          "level": "h2"
        }
      },
      "eyebrow": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$state": "/ui/ws/scopeText"
          }
        }
      },
      "loading": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "s1",
          "s2",
          "s3"
        ],
        "visible": {
          "$state": "/_loading/monday.list_workspaces"
        }
      },
      "s1": {
        "type": "Skeleton",
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        }
      },
      "s2": {
        "type": "Skeleton",
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        }
      },
      "s3": {
        "type": "Skeleton",
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        }
      },
      "empty": {
        "type": "Empty",
        "props": {
          "message": "No workspaces found."
        },
        "visible": {
          "$and": [
            {
              "$state": "/_loading/monday.list_workspaces",
              "not": true
            },
            {
              "$state": "/ui/ws/hasData",
              "not": true
            }
          ]
        }
      },
      "content": {
        "type": "Stack",
        "props": {
          "gap": "md"
        },
        "children": [
          "kindSection",
          "divider1",
          "listLabel",
          "list"
        ],
        "visible": {
          "$and": [
            {
              "$state": "/_loading/monday.list_workspaces",
              "not": true
            },
            {
              "$state": "/ui/ws/hasData"
            }
          ]
        }
      },
      "kindSection": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "children": [
          "kindRow"
        ],
        "repeat": {
          "statePath": "/ui/ws/kindRows",
          "key": "kind"
        }
      },
      "kindRow": {
        "type": "Row",
        "props": {
          "justify": "between",
          "align": "center"
        },
        "children": [
          "kindLeft",
          "kindCount"
        ]
      },
      "kindLeft": {
        "type": "Row",
        "props": {
          "gap": "xs",
          "align": "center"
        },
        "children": [
          "kindDot",
          "kindLabel"
        ]
      },
      "kindDot": {
        "type": "Dot",
        "props": {
          "tone": {
            "$item": "tone"
          },
          "size": "sm"
        }
      },
      "kindLabel": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "kind"
          },
          "size": "sm"
        }
      },
      "kindCount": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "count"
          },
          "size": "sm",
          "weight": "semibold"
        }
      },
      "divider1": {
        "type": "Divider",
        "props": {}
      },
      "listLabel": {
        "type": "Eyebrow",
        "props": {
          "text": "All workspaces"
        }
      },
      "list": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "children": [
          "wsRow"
        ],
        "repeat": {
          "statePath": "/ui/ws/rows",
          "key": "id"
        }
      },
      "wsRow": {
        "type": "Row",
        "props": {
          "align": "center",
          "gap": "sm",
          "justify": "between",
          "hover": true
        },
        "children": [
          "wsLeft",
          "kindBadge"
        ]
      },
      "wsLeft": {
        "type": "Stack",
        "props": {
          "gap": "none",
          "grow": true
        },
        "children": [
          "wsName",
          "wsDesc"
        ]
      },
      "wsName": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "name"
          },
          "size": "sm",
          "weight": "medium",
          "truncate": true
        }
      },
      "wsDesc": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "description"
          },
          "size": "xs",
          "tone": "muted",
          "truncate": true
        },
        "visible": {
          "$item": "description"
        }
      },
      "kindBadge": {
        "type": "Badge",
        "props": {
          "text": {
            "$item": "kind"
          },
          "tone": {
            "$item": "kindTone"
          },
          "variant": "soft"
        }
      }
    }
  },
  "status": "published",
  "branding": {
    "color": "#0073ea"
  }
}
