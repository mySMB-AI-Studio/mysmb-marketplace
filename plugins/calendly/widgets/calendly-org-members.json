{
  "id": "calendly-org-members",
  "title": "Calendly — Organisation members",
  "description": "Roster of members in your Calendly organisation with their roles and status.",
  "category": "scheduling",
  "tags": ["calendly", "organisation", "members", "team", "users"],
  "keywords": ["organisation", "members", "team", "users", "roles", "calendly"],
  "connectorsUsed": ["calendly"],
  "popularity": 60,
  "sizing": {
    "preferred": { "colSpan": 6, "rowSpan": 6 },
    "min":       { "colSpan": 4, "rowSpan": 4 },
    "max":       { "colSpan": 12, "rowSpan": 12 }
  },
  "dataProvider": {
    "mcp": "calendly",
    "tool": "organizations-list_organization_memberships",
    "params": {
      "count": 50
    }
  },
  "spec": {
    "root": "card",
    "elements": {

      "card": {
        "type": "Card",
        "props": {},
        "children": ["header", "body"]
      },

      "header": {
        "type": "Header",
        "props": {},
        "children": ["headerRow"]
      },
      "headerRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["titleGroup", "refreshBtn"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "Users", "tone": "accent", "size": "sm" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "countFallback", "count"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Organisation members", "level": "h2" }
      },
      "countFallback": {
        "type": "Eyebrow",
        "props": { "text": "Calendly · Organisation" },
        "visible": { "$state": "/calendly/organizations-list_organization_memberships/pagination/count", "not": true }
      },
      "count": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{n} members",
              "n": { "$state": "/calendly/organizations-list_organization_memberships/pagination/count" }
            }
          }
        },
        "visible": { "$state": "/calendly/organizations-list_organization_memberships/pagination/count" }
      },
      "refreshBtn": {
        "type": "IconButton",
        "props": { "name": "RefreshCw", "size": "sm", "ariaLabel": "Refresh" },
        "on": {
          "click": {
            "action": "calendly.organizations-list_organization_memberships",
            "params": { "count": 50 }
          }
        }
      },

      "body": {
        "type": "Body",
        "props": {},
        "children": ["loading", "empty", "list"]
      },

      "loading": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["lk1", "lk2", "lk3"],
        "visible": { "$state": "/_loading/calendly.organizations-list_organization_memberships" }
      },
      "lk1": { "type": "Skeleton", "props": { "height": "3rem", "rounded": "md" } },
      "lk2": { "type": "Skeleton", "props": { "height": "3rem", "rounded": "md" } },
      "lk3": { "type": "Skeleton", "props": { "height": "3rem", "rounded": "md" } },

      "empty": {
        "type": "Empty",
        "props": { "message": "No organisation members found." },
        "visible": {
          "$and": [
            { "$state": "/_loading/calendly.organizations-list_organization_memberships", "not": true },
            { "$state": "/calendly/organizations-list_organization_memberships/collection/0", "not": true }
          ]
        }
      },

      "list": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["row"],
        "repeat": {
          "statePath": "/calendly/organizations-list_organization_memberships/collection",
          "key": "uri"
        },
        "visible": {
          "$and": [
            { "$state": "/_loading/calendly.organizations-list_organization_memberships", "not": true },
            { "$state": "/calendly/organizations-list_organization_memberships/collection/0" }
          ]
        }
      },
      "row": {
        "type": "ListItem",
        "props": {
          "title": { "$item": "user/name" },
          "subtitle": { "$item": "user/email" },
          "value": { "$item": "role" }
        }
      }

    }
  }
}
