{
  "id": "calendly-user-profile",
  "title": "Calendly — My profile",
  "description": "Your Calendly profile: name, email, timezone, and personal scheduling URL.",
  "category": "scheduling",
  "tags": ["calendly", "profile", "user", "account", "timezone"],
  "keywords": ["profile", "user", "account", "email", "timezone", "scheduling url", "calendly"],
  "connectorsUsed": ["calendly"],
  "popularity": 55,
  "sizing": {
    "preferred": { "colSpan": 4, "rowSpan": 4 },
    "min":       { "colSpan": 3, "rowSpan": 3 },
    "max":       { "colSpan": 8, "rowSpan": 8 }
  },
  "dataProvider": {
    "mcp": "calendly",
    "tool": "users-get_current_user",
    "params": {}
  },
  "spec": {
    "root": "card",
    "elements": {

      "card": {
        "type": "Card",
        "props": {},
        "children": ["header", "body"]
      },

      "header": {
        "type": "Header",
        "props": {},
        "children": ["headerRow"]
      },
      "headerRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["titleGroup", "refreshBtn"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "User", "tone": "accent", "size": "sm" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "eyebrow"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "My Calendly profile", "level": "h2" }
      },
      "eyebrow": {
        "type": "Eyebrow",
        "props": { "text": "Calendly · Account" }
      },
      "refreshBtn": {
        "type": "IconButton",
        "props": { "name": "RefreshCw", "size": "sm", "ariaLabel": "Refresh" },
        "on": {
          "click": {
            "action": "calendly.users-get_current_user",
            "params": {}
          }
        }
      },

      "body": {
        "type": "Body",
        "props": {},
        "children": ["loading", "empty", "content"]
      },

      "loading": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["lk1", "lk2", "lk3", "lk4"],
        "visible": { "$state": "/_loading/calendly.users-get_current_user" }
      },
      "lk1": { "type": "Skeleton", "props": { "height": "2rem", "rounded": "md" } },
      "lk2": { "type": "Skeleton", "props": { "height": "2rem", "rounded": "md" } },
      "lk3": { "type": "Skeleton", "props": { "height": "2rem", "rounded": "md" } },
      "lk4": { "type": "Skeleton", "props": { "height": "2rem", "rounded": "md" } },

      "empty": {
        "type": "Empty",
        "props": { "message": "Could not load profile." },
        "visible": {
          "$and": [
            { "$state": "/_loading/calendly.users-get_current_user", "not": true },
            { "$state": "/calendly/users-get_current_user/resource/name", "not": true }
          ]
        }
      },

      "content": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["kvName", "kvEmail", "kvTimezone", "kvUrl"],
        "visible": {
          "$and": [
            { "$state": "/_loading/calendly.users-get_current_user", "not": true },
            { "$state": "/calendly/users-get_current_user/resource/name" }
          ]
        }
      },
      "kvName": {
        "type": "KeyValue",
        "props": {
          "label": "Name",
          "value": { "$state": "/calendly/users-get_current_user/resource/name" }
        }
      },
      "kvEmail": {
        "type": "KeyValue",
        "props": {
          "label": "Email",
          "value": { "$state": "/calendly/users-get_current_user/resource/email" }
        }
      },
      "kvTimezone": {
        "type": "KeyValue",
        "props": {
          "label": "Timezone",
          "value": { "$state": "/calendly/users-get_current_user/resource/timezone" }
        }
      },
      "kvUrl": {
        "type": "KeyValue",
        "props": {
          "label": "Scheduling URL",
          "value": { "$state": "/calendly/users-get_current_user/resource/scheduling_url" }
        }
      }

    }
  }
}
