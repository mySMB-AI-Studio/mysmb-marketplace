{
  "id": "calendly-event-types",
  "title": "Calendly — Event types",
  "description": "List of your Calendly event types with durations and scheduling links.",
  "category": "scheduling",
  "tags": ["calendly", "scheduling", "event-types", "meetings"],
  "keywords": ["event type", "meeting type", "duration", "scheduling link", "calendly"],
  "connectorsUsed": ["calendly"],
  "popularity": 80,
  "sizing": {
    "preferred": { "colSpan": 6, "rowSpan": 6 },
    "min":       { "colSpan": 4, "rowSpan": 4 },
    "max":       { "colSpan": 12, "rowSpan": 12 }
  },
  "dataProvider": {
    "mcp": "calendly",
    "tool": "event_types-list_event_types",
    "params": {
      "active": true,
      "count": 50
    }
  },
  "spec": {
    "root": "card",
    "elements": {

      "card": {
        "type": "Card",
        "props": {},
        "children": ["header", "body"]
      },

      "header": {
        "type": "Header",
        "props": {},
        "children": ["headerRow"]
      },
      "headerRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["titleGroup", "refreshBtn"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "ListChecks", "tone": "accent", "size": "sm" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "countFallback", "count"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Event types", "level": "h2" }
      },
      "countFallback": {
        "type": "Eyebrow",
        "props": { "text": "Calendly · Event types" },
        "visible": { "$state": "/calendly/event_types-list_event_types/pagination/count", "not": true }
      },
      "count": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{n} active",
              "n": { "$state": "/calendly/event_types-list_event_types/pagination/count" }
            }
          }
        },
        "visible": { "$state": "/calendly/event_types-list_event_types/pagination/count" }
      },
      "refreshBtn": {
        "type": "IconButton",
        "props": { "name": "RefreshCw", "size": "sm", "ariaLabel": "Refresh" },
        "on": {
          "click": {
            "action": "calendly.event_types-list_event_types",
            "params": { "active": true, "count": 50 }
          }
        }
      },

      "body": {
        "type": "Body",
        "props": {},
        "children": ["loading", "empty", "list"]
      },

      "loading": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["lk1", "lk2", "lk3"],
        "visible": { "$state": "/_loading/calendly.event_types-list_event_types" }
      },
      "lk1": { "type": "Skeleton", "props": { "height": "3rem", "rounded": "md" } },
      "lk2": { "type": "Skeleton", "props": { "height": "3rem", "rounded": "md" } },
      "lk3": { "type": "Skeleton", "props": { "height": "3rem", "rounded": "md" } },

      "empty": {
        "type": "Empty",
        "props": { "message": "No active event types found." },
        "visible": {
          "$and": [
            { "$state": "/_loading/calendly.event_types-list_event_types", "not": true },
            { "$state": "/calendly/event_types-list_event_types/collection/0", "not": true }
          ]
        }
      },

      "list": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["row"],
        "repeat": {
          "statePath": "/calendly/event_types-list_event_types/collection",
          "key": "uri"
        },
        "visible": {
          "$and": [
            { "$state": "/_loading/calendly.event_types-list_event_types", "not": true },
            { "$state": "/calendly/event_types-list_event_types/collection/0" }
          ]
        }
      },
      "row": {
        "type": "ListItem",
        "props": {
          "title": { "$item": "name" },
          "subtitle": { "$item": "description_plain" },
          "value": { "$item": "duration" },
          "valueHint": "min"
        }
      }

    }
  }
}
