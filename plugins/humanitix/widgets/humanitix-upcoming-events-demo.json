      "r2sub": { "type": "Caption", "props": { "text": "Workshop · CPD · Waitlist", "tone": "muted" } },
      "r2date": { "type": "Stack", "props": { "gap": "none" }, "children": ["r2dateMain", "r2dateSub"] },
