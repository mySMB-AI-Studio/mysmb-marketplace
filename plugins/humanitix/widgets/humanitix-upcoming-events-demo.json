      "r2dateSub": { "type": "Caption", "props": { "text": "Fri · 1:00 PM", "tone": "muted" } },
      "r2loc": { "type": "Row", "props": { "gap": "xs", "align": "center" }, "children": ["r2locIcon", "r2locText"] },
      "r2locIcon": { "type": "Icon", "props": { "name": "Globe", "tone": "muted", "size": "sm" } },
      "r2locText": { "type": "Text", "props": { "text": "Online", "size": "sm", "tone": "muted" } },
      "r2cap": { "type": "Stack", "props": { "gap": "xs", "align": "end" }, "children": ["r2capLabel", "r2capBar"] },
      "r2capLabel": { "type": "Text", "props": { "text": "18 / 20", "size": "sm", "tone": "warning" } },
      "r2capBar": { "type": "ProgressBar", "props": { "value": 90, "tone": "warning" } },

      "row3": { "type": "Row", "props": { "gap": "sm", "align": "center" }, "children": ["r3dot", "r3main", "r3date", "r3loc", "r3cap"] },
      "r3dot": { "type": "Dot", "props": { "tone": "chart-2" } },
      "r3main": { "type": "Stack", "props": { "gap": "none", "grow": true }, "children": ["r3name", "r3sub"] },
      "r3name": { "type": "Text", "props": { "text": "Community Food Market", "size": "sm", "weight": "medium", "truncate": true } },
      "r3sub": { "type": "Caption", "props": { "text": "Community · Recurring · Free", "tone": "muted" } },
      "r3date": { "type": "Stack", "props": { "gap": "none" }, "children": ["r3dateMain", "r3dateSub"] },
      "r3dateMain": { "type": "Text", "props": { "text": "11-Oct-26", "size": "sm" } },
      "r3dateSub": { "type": "Caption", "props": { "text": "Sun · 8:00 AM", "tone": "muted" } },
      "r3loc": { "type": "Row", "props": { "gap": "xs", "align": "center" }, "children": ["r3locIcon", "r3locText"] },
      "r3locIcon": { "type": "Icon", "props": { "name": "MapPin", "tone": "muted", "size": "sm" } },
      "r3locText": { "type": "Text", "props": { "text": "Fremantle, AU", "size": "sm", "tone": "muted" } },
      "r3cap": { "type": "Badge", "props": { "text": "No Limit", "tone": "muted", "variant": "soft" } },

      "row4": { "type": "Row", "props": { "gap": "sm", "align": "center" }, "children": ["r4dot", "r4main", "r4date", "r4loc", "r4cap"] },
      "r4dot": { "type": "Dot", "props": { "tone": "chart-4" } },
      "r4main": { "type": "Stack", "props": { "gap": "none", "grow": true }, "children": ["r4name", "r4sub"] },
      "r4name": { "type": "Text", "props": { "text": "Industry Awards & Gala Dinner", "size": "sm", "weight": "medium", "truncate": true } },
      "r4sub": { "type": "Caption", "props": { "text": "Awards · Gala · Group Tables", "tone": "muted" } },
      "r4date": { "type": "Stack", "props": { "gap": "none" }, "children": ["r4dateMain", "r4dateSub"] },
      "r4dateMain": { "type": "Text", "props": { "text": "24-Oct-26", "size": "sm" } },
      "r4dateSub": { "type": "Caption", "props": { "text": "Sat · 6:30 PM", "tone": "muted" } },
      "r4loc": { "type": "Row", "props": { "gap": "xs", "align": "center" }, "children": ["r4locIcon", "r4locText"] },
      "r4locIcon": { "type": "Icon", "props": { "name": "MapPin", "tone": "muted", "size": "sm" } },
      "r4locText": { "type": "Text", "props": { "text": "Perth, AU", "size": "sm", "tone": "muted" } },
      "r4cap": { "type": "Stack", "props": { "gap": "xs", "align": "end" }, "children": ["r4capLabel", "r4capBar"] },
      "r4capLabel": { "type": "Text", "props": { "text": "96 / 240", "size": "sm", "tone": "chart-4" } },
      "r4capBar": { "type": "ProgressBar", "props": { "value": 40, "tone": "chart-4" } },

      "row5": { "type": "Row", "props": { "gap": "sm", "align": "center" }, "children": ["r5dot", "r5main", "r5date", "r5loc", "r5cap"] },
      "r5dot": { "type": "Dot", "props": { "tone": "chart-5" } },
      "r5main": { "type": "Stack", "props": { "gap": "none", "grow": true }, "children": ["r5name", "r5sub"] },
      "r5name": { "type": "Text", "props": { "text": "Live Music Night", "size": "sm", "weight": "medium", "truncate": true } },
      "r5sub": { "type": "Caption", "props": { "text": "Concert · Early-bird · 18+", "tone": "muted" } },
      "r5date": { "type": "Stack", "props": { "gap": "none" }, "children": ["r5dateMain", "r5dateSub"] },
      "r5dateMain": { "type": "Text", "props": { "text": "07-Nov-26", "size": "sm" } },
      "r5dateSub": { "type": "Caption", "props": { "text": "Sat · 7:00 PM", "tone": "muted" } },
      "r5loc": { "type": "Row", "props": { "gap": "xs", "align": "center" }, "children": ["r5locIcon", "r5locText"] },
      "r5locIcon": { "type": "Icon", "props": { "name": "MapPin", "tone": "muted", "size": "sm" } },
      "r5locText": { "type": "Text", "props": { "text": "Perth, AU", "size": "sm", "tone": "muted" } },
      "r5cap": { "type": "Stack", "props": { "gap": "xs", "align": "end" }, "children": ["r5capLabel", "r5capBar"] },
      "r5capLabel": { "type": "Text", "props": { "text": "210 / 300", "size": "sm", "tone": "chart-5" } },
      "r5capBar": { "type": "ProgressBar", "props": { "value": 70, "tone": "chart-5" } },

      "divider3": { "type": "Divider", "props": {} },

      "footerRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["footerCount", "footerLink"]
      },
      "footerCount": { "type": "Caption", "props": { "text": "Showing 5 of 20 upcoming", "tone": "muted" } },
      "footerLink": { "type": "Button", "props": { "label": "View all events →", "variant": "ghost", "size": "sm" } }

    }
  },
  "status": "published"
}
