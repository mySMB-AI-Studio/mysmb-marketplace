{
  "id": "humanitix-upcoming-events-demo",
  "title": "Upcoming Events (Demo)",
  "description": "Sample upcoming events — click a row to see how it opens the event's own Humanitix page.",
  "category": "operations",
  "tags": ["humanitix", "events", "ticketing", "tickets", "demo"],
  "keywords": ["events", "upcoming", "tickets", "ticketing", "humanitix", "demo", "capacity"],
  "connectorsUsed": [],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 5, "rowSpan": 7 },
    "min":       { "colSpan": 4, "rowSpan": 5 },
    "max":       { "colSpan": 8, "rowSpan": 12 }
  },
  "spec": {
    "root": "card",
    "elements": {

      "card": {
        "type": "Card",
        "props": {},
        "children": ["headerRow", "divider1", "body", "divider2", "footerRow"]
      },

      "headerRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["titleStack", "nextBadgeRow"]
      },
      "titleStack": { "type": "Stack", "props": { "gap": "none" }, "children": ["title", "eyebrow"] },
      "title": { "type": "Heading", "props": { "text": "Upcoming Events", "level": "h2" } },
      "eyebrow": { "type": "Eyebrow", "props": { "text": "Humanitix" } },
      "nextBadgeRow": {
        "type": "Row",
        "props": { "clickable": true, "hover": true },
        "children": ["nextBadge"],
        "on": {
          "click": { "action": "open_url", "params": { "url": "https://events.humanitix.com" } }
        }
      },
      "nextBadge": { "type": "Badge", "props": { "text": "Next 20", "tone": "info", "variant": "soft" } },

      "divider1": { "type": "Divider", "props": {} },

      "body": { "type": "Body", "props": {}, "children": ["list"] },
      "list": { "type": "Stack", "props": { "gap": "xs" }, "children": ["row1", "row2", "row3", "row4", "row5"] },

      "row1": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center", "clickable": true, "hover": true },
        "children": ["r1badge", "r1main", "r1chev"],
        "on": { "click": { "action": "open_url", "params": { "url": "https://events.humanitix.com/annual-conference-agm-2026" } } }
      },
      "r1badge": { "type": "Stack", "props": { "gap": "none", "align": "center" }, "children": ["r1month", "r1day"] },
      "r1month": { "type": "Caption", "props": { "text": "SEP", "tone": "chart-1" } },
      "r1day": { "type": "Text", "props": { "text": "23", "size": "lg", "weight": "semibold", "tone": "chart-1" } },
      "r1main": { "type": "Stack", "props": { "gap": "none", "grow": true }, "children": ["r1name", "r1meta"] },
      "r1name": { "type": "Text", "props": { "text": "Annual Conference & AGM 2026", "size": "sm", "weight": "medium", "tone": "info", "truncate": true } },
      "r1meta": { "type": "Row", "props": { "gap": "xs", "align": "center" }, "children": ["r1time", "r1sep1", "r1loc", "r1sep2", "r1cap"] },
      "r1time": { "type": "Caption", "props": { "text": "9:00 AM", "tone": "muted" } },
      "r1sep1": { "type": "Caption", "props": { "text": "·", "tone": "muted" } },
      "r1loc": { "type": "Caption", "props": { "text": "Perth, AU", "tone": "muted" } },
      "r1sep2": { "type": "Caption", "props": { "text": "·", "tone": "muted" } },
      "r1cap": { "type": "Caption", "props": { "text": "142/500", "tone": "chart-1" } },
      "r1chev": { "type": "Icon", "props": { "name": "ChevronRight", "tone": "muted", "size": "sm" } },

