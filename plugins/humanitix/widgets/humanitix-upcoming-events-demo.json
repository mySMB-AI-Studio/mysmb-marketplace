      "r1date": { "type": "Text", "props": { "text": "12-Oct-26", "size": "xs", "tone": "muted" } },
      "r1loc": { "type": "Text", "props": { "text": "Town Hall", "size": "xs", "tone": "muted" } },
      "r1cap": { "type": "Text", "props": { "text": "200 cap.", "size": "xs", "tone": "muted" } },
      "r1badge": { "type": "Badge", "props": { "text": "Published", "tone": "muted", "variant": "soft" } },

      "div1": { "type": "Divider", "props": {} },

      "row2": {
        "type": "Row",
        "props": { "justify": "between", "align": "start" },
        "children": ["r2left", "r2badge"]
      },
      "r2left": {
        "type": "Stack",
        "props": { "gap": "none", "grow": true },
        "children": ["r2name", "r2meta"]
      },
      "r2name": { "type": "Text", "props": { "text": "Comedy Night", "size": "sm", "weight": "medium" } },
      "r2meta": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["r2date", "r2loc", "r2cap"]
      },
      "r2date": { "type": "Text", "props": { "text": "18-Oct-26", "size": "xs", "tone": "muted" } },
      "r2loc": { "type": "Text", "props": { "text": "The Basement", "size": "xs", "tone": "muted" } },
      "r2cap": { "type": "Text", "props": { "text": "80 cap.", "size": "xs", "tone": "muted" } },
      "r2badge": { "type": "Badge", "props": { "text": "Sold Out", "tone": "warning", "variant": "soft" } },

      "div2": { "type": "Divider", "props": {} },

      "row3": {
        "type": "Row",
        "props": { "justify": "between", "align": "start" },
        "children": ["r3left", "r3badge"]
