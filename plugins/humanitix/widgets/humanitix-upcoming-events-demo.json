{
  "id": "humanitix-upcoming-events-demo",
  "title": "Upcoming Events (Demo)",
  "description": "Sample upcoming events with category, start date/time, location, and capacity.",
  "category": "operations",
  "tags": ["humanitix", "events", "ticketing", "tickets", "demo"],
  "keywords": ["events", "upcoming", "tickets", "ticketing", "humanitix", "demo", "capacity"],
  "connectorsUsed": [],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 6, "rowSpan": 8 },
    "min":       { "colSpan": 5, "rowSpan": 6 },
    "max":       { "colSpan": 10, "rowSpan": 14 }
  },
  "spec": {
    "root": "card",
    "elements": {

      "card": {
        "type": "Card",
        "props": {},
        "children": ["headerRow", "divider1", "columnHeaderRow", "divider2", "body", "divider3", "footerRow"]
      },

      "headerRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["titleGroup", "statusGroup"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": { "type": "Icon", "props": { "name": "Calendar", "tone": "info", "size": "sm" } },
      "titleStack": { "type": "Stack", "props": { "gap": "none" }, "children": ["title", "eyebrow"] },
      "title": { "type": "Heading", "props": { "text": "Upcoming Events", "level": "h2" } },
      "eyebrow": { "type": "Eyebrow", "props": { "text": "Humanitix · next 20 · soonest first" } },

      "statusGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["liveBadge", "refreshBtn"]
      },
      "liveBadge": { "type": "Badge", "props": { "text": "Live sync", "tone": "success", "variant": "soft" } },
      "refreshBtn": { "type": "IconButton", "props": { "icon": "RefreshCw", "tone": "muted", "size": "sm", "ariaLabel": "Refresh" } },

      "divider1": { "type": "Divider", "props": {} },

      "columnHeaderRow": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["colEvent", "colStart", "colLocation", "colCapacity"]
      },
      "colEvent":    { "type": "Caption", "props": { "text": "Event",      "tone": "muted" } },
      "colStart":    { "type": "Caption", "props": { "text": "Start Date", "tone": "muted" } },
      "colLocation": { "type": "Caption", "props": { "text": "Location",   "tone": "muted" } },
      "colCapacity": { "type": "Caption", "props": { "text": "Capacity",   "tone": "muted" } },

      "divider2": { "type": "Divider", "props": {} },

      "body": {
        "type": "Body",
        "props": {},
        "children": ["list"]
      },

      "list": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["row1", "row2", "row3", "row4", "row5"]
      },

      "row1": { "type": "Row", "props": { "gap": "sm", "align": "center" }, "children": ["r1dot", "r1main", "r1date", "r1loc", "r1cap"] },
      "r1dot": { "type": "Dot", "props": { "tone": "chart-1" } },
      "r1main": { "type": "Stack", "props": { "gap": "none", "grow": true }, "children": ["r1name", "r1sub"] },
      "r1name": { "type": "Text", "props": { "text": "Annual Conference & AGM 2026", "size": "sm", "weight": "medium", "truncate": true } },
      "r1sub": { "type": "Caption", "props": { "text": "Conference · AGM · Hybrid", "tone": "muted" } },
      "r1date": { "type": "Stack", "props": { "gap": "none" }, "children": ["r1dateMain", "r1dateSub"] },
      "r1dateMain": { "type": "Text", "props": { "text": "23-Sep-26", "size": "sm" } },
      "r1dateSub": { "type": "Caption", "props": { "text": "Wed · 9:00 AM", "tone": "muted" } },
      "r1loc": { "type": "Row", "props": { "gap": "xs", "align": "center" }, "children": ["r1locIcon", "r1locText"] },
      "r1locIcon": { "type": "Icon", "props": { "name": "MapPin", "tone": "muted", "size": "sm" } },
      "r1locText": { "type": "Text", "props": { "text": "Perth, AU", "size": "sm", "tone": "muted" } },
      "r1cap": { "type": "Stack", "props": { "gap": "xs", "align": "end" }, "children": ["r1capLabel", "r1capBar"] },
      "r1capLabel": { "type": "Text", "props": { "text": "142 / 500", "size": "sm", "tone": "chart-1" } },
      "r1capBar": { "type": "ProgressBar", "props": { "value": 28, "tone": "chart-1" } },

      "row2": { "type": "Row", "props": { "gap": "sm", "align": "center" }, "children": ["r2dot", "r2main", "r2date", "r2loc", "r2cap"] },
      "r2dot": { "type": "Dot", "props": { "tone": "chart-3" } },
      "r2main": { "type": "Stack", "props": { "gap": "none", "grow": true }, "children": ["r2name", "r2sub"] },
