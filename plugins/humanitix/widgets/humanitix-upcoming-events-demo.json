      "r3name": { "type": "Text", "props": { "text": "Charity Fun Run", "size": "sm", "weight": "medium" } },
      "r3meta": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["r3date", "r3loc", "r3cap"]
      },
      "r3date": { "type": "Text", "props": { "text": "01-Nov-26", "size": "xs", "tone": "muted" } },
      "r3loc": { "type": "Text", "props": { "text": "Riverside Park", "size": "xs", "tone": "muted" } },
      "r3cap": { "type": "Text", "props": { "text": "500 cap.", "size": "xs", "tone": "muted" } },
      "r3badge": { "type": "Badge", "props": { "text": "Draft", "tone": "muted", "variant": "soft" } }

