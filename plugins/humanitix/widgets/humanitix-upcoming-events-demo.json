{
  "id": "humanitix-upcoming-events-demo",
  "title": "Upcoming Events (Demo)",
  "description": "Sample upcoming events with start date, location, capacity, and publish status.",
  "category": "operations",
  "tags": ["humanitix", "events", "ticketing", "tickets", "demo"],
  "keywords": ["events", "upcoming", "tickets", "ticketing", "humanitix", "demo"],
  "connectorsUsed": [],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 5, "rowSpan": 6 },
    "min": { "colSpan": 4, "rowSpan": 4 },
    "max": { "colSpan": 8, "rowSpan": 10 }
  },
  "spec": {
    "root": "card",
    "elements": {

      "card": {
        "type": "Card",
        "props": {},
        "children": ["titleRow", "divider", "body"]
      },

      "titleRow": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "CalendarClock", "tone": "info", "size": "sm" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "eyebrow"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Upcoming Events", "level": "h2" }
      },
      "eyebrow": {
        "type": "Eyebrow",
        "props": { "text": "Humanitix · next 20, soonest first" }
      },

      "divider": { "type": "Divider", "props": {} },

      "body": {
        "type": "Body",
        "props": {},
        "children": ["rows"]
      },

      "rows": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["row1", "div1", "row2", "div2", "row3"]
      },

      "row1": {
        "type": "Row",
        "props": { "justify": "between", "align": "start" },
        "children": ["r1left", "r1badge"]
      },
      "r1left": {
        "type": "Stack",
        "props": { "gap": "none", "grow": true },
        "children": ["r1name", "r1meta"]
      },
      "r1name": { "type": "Text", "props": { "text": "Winter Gala", "size": "sm", "weight": "medium" } },
      "r1meta": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["r1date", "r1loc", "r1cap"]
