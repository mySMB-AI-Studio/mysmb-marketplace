{
  "category": "operations",
  "connectorsUsed": [
    "humanitix"
  ],
  "dataProvider": {
    "kind": "tool",
    "mcp": "humanitix",
    "params": {},
    "tool": "get_humanitix_revenue_trend"
  },
  "description": "Total earnings over the last 7 days, day-over-day trend vs. the prior week, and the best-performing day.",
  "id": "humanitix-revenue-trend",
  "keywords": [
    "revenue trend",
    "earnings",
    "last 7 days",
    "best day",
    "vs last week",
    "humanitix"
  ],
  "popularity": 0,
  "sizing": {
    "max": {
      "colSpan": 7,
      "rowSpan": 6
    },
    "min": {
      "colSpan": 4,
      "rowSpan": 4
    },
    "preferred": {
      "colSpan": 5,
      "rowSpan": 5
    }
  },
  "spec": {
    "elements": {
      "body": {
        "children": [
          "loading",
          "content"
        ],
        "props": {},
        "type": "Body"
      },
      "card": {
        "children": [
          "headerRow",
          "divider0",
          "body"
        ],
        "props": {},
        "type": "Card",
        "watch": {
          "/humanitix/get_humanitix_revenue_trend": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/rows",
                "value": {
                  "$computed": "humanitix_flatten_revenue_trend",
                  "args": {
                    "value": {
                      "$state": "/humanitix/get_humanitix_revenue_trend"
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "content": {
        "children": [
          "sourceCaption",
          "totalRow",
          "trendBlock",
          "footerRow"
        ],
        "props": {
          "gap": "sm"
        },
        "type": "Stack",
        "visible": {
          "$state": "/_loading/humanitix.get_humanitix_revenue_trend",
          "not": true
        }
      },
      "dailyBar": {
        "props": {
          "tone": {
            "$item": "row_tone"
          },
          "value": {
            "$item": "bar_pct"
          }
        },
        "type": "ProgressBar"
      },
      "dailyBarRow": {
        "children": [
          "dailyBar"
        ],
        "props": {
          "align": "center",
          "gap": "none",
          "grow": true
        },
        "type": "Row"
      },
      "dailyBreakdownList": {
        "children": [
          "dailyBreakdownRow"
        ],
        "props": {
          "gap": "xs"
        },
        "repeat": {
          "key": "id",
          "statePath": "/ui/rows/0/daily_breakdown"
        },
        "type": "Stack"
      },
      "dailyBreakdownRow": {
        "children": [
          "dailyDayLabel",
          "dailyBarRow",
          "dailyValueLabel"
        ],
        "props": {
          "align": "center",
          "gap": "sm"
        },
        "type": "Row"
      },
      "dailyDayLabel": {
        "props": {
          "size": "sm",
          "text": {
            "$item": "label"
          },
          "tone": {
            "$item": "row_tone"
          },
          "weight": {
            "$item": "weight"
          }
        },
        "type": "Text"
      },
      "dailyValueLabel": {
        "props": {
          "size": "sm",
          "text": {
            "$item": "value_formatted"
          },
          "tone": {
            "$item": "row_tone"
          },
          "weight": {
            "$item": "weight"
          }
        },
        "type": "Text"
      },
      "divider0": {
        "props": {},
        "type": "Divider"
      },
      "eyebrow": {
        "props": {
          "text": "Humanitix"
        },
        "type": "Eyebrow"
      },
      "footerRow": {
        "children": [
          "updatedCaption"
        ],
        "props": {
          "align": "center",
          "justify": "between"
        },
        "type": "Row"
      },
      "headerRow": {
        "children": [
          "titleGroup"
        ],
        "props": {
          "align": "center",
          "justify": "between"
        },
        "type": "Row"
      },
      "loading": {
        "children": [
          "sk1",
          "sk2"
        ],
        "props": {
          "gap": "sm"
        },
        "type": "Stack",
        "visible": {
          "$state": "/_loading/humanitix.get_humanitix_revenue_trend"
        }
      },
      "sk1": {
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "sk2": {
        "props": {
          "height": "6rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "sourceCaption": {
        "props": {
          "text": "Earnings · Last 7 days",
          "tone": "muted"
        },
        "type": "Caption"
      },
      "title": {
        "props": {
          "level": "h2",
          "text": "Revenue Trend"
        },
        "type": "Heading"
      },
      "titleGroup": {
        "children": [
          "titleIconBadge",
          "titleStack"
        ],
        "props": {
          "align": "center",
          "gap": "sm"
        },
        "type": "Row"
      },
      "titleIcon": {
        "props": {
          "name": "list",
          "size": "md"
        },
        "type": "Icon"
      },
      "titleIconBadge": {
        "children": [
          "titleIcon"
        ],
        "props": {
          "tone": "info",
          "variant": "soft"
        },
        "type": "Badge"
      },
      "titleStack": {
        "children": [
          "title",
          "eyebrow"
        ],
        "props": {
          "gap": "none"
        },
        "type": "Stack"
      },
      "totalRow": {
        "children": [
          "totalStat",
          "vsLastWeekBadge"
        ],
        "props": {
          "align": "center",
          "gap": "sm"
        },
        "type": "Row"
      },
      "totalStat": {
        "props": {
          "size": "lg",
          "value": {
            "$state": "/ui/rows/0/total_formatted"
          }
        },
        "type": "Stat"
      },
      "trendBlock": {
        "children": [
          "dailyBreakdownList"
        ],
        "props": {
          "gap": "sm"
        },
        "type": "Stack"
      },
      "updatedCaption": {
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "Updated {t}",
              "t": {
                "$computed": "relative_time",
                "args": {
                  "value": {
                    "$state": "/ui/rows/0/last_updated_iso"
                  }
                }
              }
            }
          },
          "tone": "muted"
        },
        "type": "Caption",
        "visible": {
          "$state": "/ui/rows/0/last_updated_iso"
        }
      },
      "vsLastWeekBadge": {
        "children": [
          "vsLastWeekDelta",
          "vsLastWeekSuffix"
        ],
        "props": {
          "tone": {
            "$state": "/ui/rows/0/vs_last_week_badge_tone"
          },
          "variant": "soft"
        },
        "type": "Badge",
        "visible": {
          "$state": "/ui/rows/0/has_comparison"
        }
      },
      "vsLastWeekDelta": {
        "props": {
          "direction": {
            "$state": "/ui/rows/0/vs_last_week_direction"
          },
          "value": {
            "$state": "/ui/rows/0/vs_last_week_label"
          }
        },
        "type": "Delta"
      },
      "vsLastWeekSuffix": {
        "props": {
          "size": "sm",
          "text": "vs last week"
        },
        "type": "Text"
      }
    },
    "root": "card"
  },
  "tags": [
    "humanitix",
    "revenue",
    "earnings",
    "trend",
    "orders"
  ],
  "title": "Revenue Trend"
}
