{
  "category": "operations",
  "connectorsUsed": [
    "humanitix"
  ],
  "dataProvider": {
    "kind": "tool",
    "mcp": "humanitix",
    "params": {
      "pageSize": 20
    },
    "tool": "list_events"
  },
  "description": "Events on Humanitix that haven't ended yet, soonest first. Click a row to open that event's own page on Humanitix.",
  "id": "humanitix-upcoming-events",
  "keywords": [
    "events",
    "upcoming",
    "tickets",
    "ticketing",
    "humanitix",
    "schedule",
    "capacity"
  ],
  "popularity": 0,
  "sizing": {
    "max": {
      "colSpan": 8,
      "rowSpan": 12
    },
    "min": {
      "colSpan": 4,
      "rowSpan": 5
    },
    "preferred": {
      "colSpan": 5,
      "rowSpan": 7
    }
  },
  "spec": {
    "elements": {
      "body": {
        "children": [
          "loading",
          "empty",
          "list"
        ],
        "props": {},
        "type": "Body"
      },
      "card": {
        "children": [
          "headerRow",
          "divider1",
          "body",
          "footerRow"
        ],
        "props": {},
        "type": "Card",
        "watch": {
          "/humanitix/list_events": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/rows",
                "value": {
                  "$computed": "humanitix_flatten_upcoming_events_compact",
                  "args": {
                    "displayLimit": 5,
                    "value": {
                      "$state": "/humanitix/list_events"
                    }
                  }
                }
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/counts",
                "value": {
                  "$computed": "humanitix_upcoming_events_counts",
                  "args": {
                    "displayLimit": 5,
                    "value": {
                      "$state": "/humanitix/list_events"
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "divider1": {
        "props": {},
        "type": "Divider"
      },
      "empty": {
        "props": {
          "message": "No upcoming events on Humanitix."
        },
        "type": "Empty",
        "visible": {
          "$and": [
            {
              "$state": "/_loading/humanitix.list_events",
              "not": true
            },
            {
              "$state": "/ui/rows/0",
              "not": true
            }
          ]
        }
      },
      "eyebrow": {
        "props": {
          "text": "Humanitix"
        },
        "type": "Eyebrow"
      },
      "footerLink": {
        "props": {
          "size": "sm",
          "text": {
            "$computed": "fmt",
            "args": {
              "n": {
                "$state": "/ui/counts/total"
              },
              "pattern": "View all {n} events →"
            }
          },
          "tone": "chart-1",
          "weight": "medium"
        },
        "type": "Text"
      },
      "footerRow": {
        "children": [
          "footerLink"
        ],
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "target": "_blank",
              "url": "https://events.humanitix.com"
            }
          }
        },
        "props": {
          "align": "center",
          "clickable": true,
          "hover": true,
          "justify": "center"
        },
        "type": "Row"
      },
      "headerRow": {
        "children": [
          "titleIcon",
          "titleStack"
        ],
        "props": {
          "align": "center",
          "gap": "sm"
        },
        "type": "Row"
      },
      "list": {
        "children": [
          "rowWrap"
        ],
        "props": {
          "gap": "none"
        },
        "repeat": {
          "key": "id",
          "statePath": "/ui/rows"
        },
        "type": "Stack",
        "visible": {
          "$state": "/_loading/humanitix.list_events",
          "not": true
        }
      },
      "loading": {
        "children": [
          "sk1",
          "sk2",
          "sk3"
        ],
        "props": {
          "gap": "sm"
        },
        "type": "Stack",
        "visible": {
          "$state": "/_loading/humanitix.list_events"
        }
      },
      "row": {
        "children": [
          "rowDateBadge",
          "rowMain",
          "rowChevron"
        ],
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "target": "_blank",
              "url": {
                "$bindItem": "event_url"
              }
            }
          }
        },
        "props": {
          "align": "center",
          "clickable": {
            "$item": "has_url"
          },
          "gap": "md",
          "hover": {
            "$item": "has_url"
          },
          "padded": true
        },
        "type": "Row"
      },
      "rowChevron": {
        "props": {
          "name": "ChevronRight",
          "size": "md",
          "tone": "muted"
        },
        "type": "Icon"
      },
      "rowDateBadge": {
        "children": [
          "rowDayAvatar",
          "rowMonth"
        ],
        "props": {
          "align": "center",
          "gap": "xs"
        },
        "type": "Stack"
      },
      "rowDayAvatar": {
        "props": {
          "initials": {
            "$item": "start_day_label"
          },
          "size": "lg",
          "tone": {
            "$item": "category_tone"
          }
        },
        "type": "Avatar"
      },
      "rowDivider": {
        "props": {},
        "type": "Divider"
      },
      "rowMain": {
        "children": [
          "rowName",
          "rowMeta"
        ],
        "props": {
          "gap": "xs",
          "grow": true
        },
        "type": "Stack"
      },
      "rowMeta": {
        "children": [
          "rowMetaTime",
          "rowMetaSep1",
          "rowMetaLocation",
          "rowMetaSep2",
          "rowMetaCapacity"
        ],
        "props": {
          "align": "center",
          "gap": "xs"
        },
        "type": "Row"
      },
      "rowMetaCapacity": {
        "props": {
          "text": {
            "$item": "capacity_label"
          },
          "tone": {
            "$item": "capacity_tone"
          },
          "weight": "medium"
        },
        "type": "Caption"
      },
      "rowMetaLocation": {
        "props": {
          "text": {
            "$item": "location_label"
          },
          "tone": "muted",
          "truncate": true
        },
        "type": "Caption"
      },
      "rowMetaSep1": {
        "props": {
          "text": "·",
          "tone": "muted"
        },
        "type": "Caption"
      },
      "rowMetaSep2": {
        "props": {
          "text": "·",
          "tone": "muted"
        },
        "type": "Caption"
      },
      "rowMetaTime": {
        "props": {
          "text": {
            "$item": "start_time_label"
          },
          "tone": "muted"
        },
        "type": "Caption"
      },
      "rowMonth": {
        "props": {
          "text": {
            "$item": "start_month_label"
          },
          "tone": {
            "$item": "category_tone"
          },
          "weight": "medium"
        },
        "type": "Caption"
      },
      "rowName": {
        "props": {
          "size": "sm",
          "text": {
            "$item": "name"
          },
          "truncate": true,
          "weight": "semibold"
        },
        "type": "Text"
      },
      "rowWrap": {
        "children": [
          "row",
          "rowDivider"
        ],
        "props": {
          "gap": "xs"
        },
        "type": "Stack"
      },
      "sk1": {
        "props": {
          "height": "3.5rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "sk2": {
        "props": {
          "height": "3.5rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "sk3": {
        "props": {
          "height": "3.5rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "title": {
        "props": {
          "level": "h2",
          "text": "Upcoming Events"
        },
        "type": "Heading"
      },
      "titleIcon": {
        "props": {
          "name": "CalendarDays",
          "size": "sm",
          "tone": "chart-1"
        },
        "type": "Icon"
      },
      "titleStack": {
        "children": [
          "title",
          "eyebrow"
        ],
        "props": {
          "gap": "none"
        },
        "type": "Stack"
      }
    },
    "root": "card"
  },
  "tags": [
    "humanitix",
    "events",
    "ticketing",
    "tickets"
  ],
  "title": "Upcoming Events"
}
