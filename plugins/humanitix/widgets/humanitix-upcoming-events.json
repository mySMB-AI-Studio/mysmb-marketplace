{
  "id": "humanitix-upcoming-events",
  "title": "Upcoming Events",
  "description": "Events on Humanitix that haven't ended yet, soonest first — category, start date/time, location, and capacity at a glance.",
  "category": "operations",
  "tags": ["humanitix", "events", "ticketing", "tickets"],
  "keywords": ["events", "upcoming", "tickets", "ticketing", "humanitix", "schedule", "capacity"],
  "connectorsUsed": ["humanitix"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 6, "rowSpan": 8 },
    "min":       { "colSpan": 5, "rowSpan": 6 },
    "max":       { "colSpan": 10, "rowSpan": 14 }
  },
  "dataProvider": {
    "mcp": "humanitix",
    "tool": "list_events",
    "params": { "pageSize": 20 }
  },
  "spec": {
    "root": "card",
    "elements": {

      "card": {
        "type": "Card",
        "props": {},
        "children": ["headerRow", "divider1", "columnHeaderRow", "divider2", "body", "divider3", "footerRow"],
        "watch": {
          "/humanitix/list_events": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/rows",
                "value": {
                  "$computed": "humanitix_flatten_upcoming_events_rich",
                  "args": { "value": { "$state": "/humanitix/list_events" }, "displayLimit": 5 }
                }
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/counts",
                "value": {
                  "$computed": "humanitix_upcoming_events_counts",
                  "args": { "value": { "$state": "/humanitix/list_events" }, "displayLimit": 5 }
                }
              }
            }
          ]
        }
      },

      "headerRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["titleGroup", "statusGroup"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": { "type": "Icon", "props": { "name": "Calendar", "tone": "info", "size": "sm" } },
      "titleStack": { "type": "Stack", "props": { "gap": "none" }, "children": ["title", "eyebrow"] },
      "title": { "type": "Heading", "props": { "text": "Upcoming Events", "level": "h2" } },
      "eyebrow": { "type": "Eyebrow", "props": { "text": "Humanitix · next 20 · soonest first" } },

      "statusGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["liveBadge", "refreshBtn"]
      },
      "liveBadge": {
        "type": "Badge",
        "props": { "text": "Live sync", "tone": "success", "variant": "soft" }
      },
      "refreshBtn": {
        "type": "IconButton",
        "props": { "icon": "RefreshCw", "tone": "muted", "size": "sm", "ariaLabel": "Refresh" },
        "on": {
          "click": { "action": "humanitix.list_events", "params": { "pageSize": 20 } }
        }
      },

      "divider1": { "type": "Divider", "props": {} },

      "columnHeaderRow": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["colEvent", "colStart", "colLocation", "colCapacity"]
      },
      "colEvent":    { "type": "Caption", "props": { "text": "Event",      "tone": "muted" } },
      "colStart":    { "type": "Caption", "props": { "text": "Start Date", "tone": "muted" } },
      "colLocation": { "type": "Caption", "props": { "text": "Location",   "tone": "muted" } },
      "colCapacity": { "type": "Caption", "props": { "text": "Capacity",   "tone": "muted" } },

      "divider2": { "type": "Divider", "props": {} },

      "body": {
        "type": "Body",
        "props": {},
        "children": ["loading", "empty", "list"]
      },
      "loading": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "visible": { "$state": "/_loading/humanitix.list_events" },
        "children": ["sk1", "sk2", "sk3"]
      },
      "sk1": { "type": "Skeleton", "props": { "height": "3.5rem", "rounded": "md" } },
      "sk2": { "type": "Skeleton", "props": { "height": "3.5rem", "rounded": "md" } },
      "sk3": { "type": "Skeleton", "props": { "height": "3.5rem", "rounded": "md" } },

      "empty": {
        "type": "Empty",
        "props": { "message": "No upcoming events on Humanitix." },
        "visible": {
          "$and": [
            { "$state": "/_loading/humanitix.list_events", "not": true },
            { "$state": "/ui/rows/0", "not": true }
          ]
        }
      },

      "list": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "visible": { "$state": "/_loading/humanitix.list_events", "not": true },
        "repeat": { "statePath": "/ui/rows", "key": "id" },
        "children": ["row"]
      },

      "row": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["rowDot", "rowMain", "rowDate", "rowLocation", "rowCapacityGroup"]
      },
      "rowDot": { "type": "Dot", "props": { "tone": { "$item": "category_tone" } } },
      "rowMain": {
        "type": "Stack",
        "props": { "gap": "none", "grow": true },
        "children": ["rowName", "rowSubtitle"]
      },
      "rowName":     { "type": "Text",    "props": { "text": { "$item": "name" },     "size": "sm", "weight": "medium", "truncate": true } },
      "rowSubtitle": { "type": "Caption", "props": { "text": { "$item": "subtitle" }, "tone": "muted" } },

      "rowDate": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["rowDateMain", "rowDateSub"]
      },
      "rowDateMain": { "type": "Text",    "props": { "text": { "$item": "start_date_label" }, "size": "sm" } },
      "rowDateSub":  { "type": "Caption", "props": { "text": { "$item": "start_time_label" }, "tone": "muted" } },

      "rowLocation": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["rowLocationIcon", "rowLocationText"]
      },
      "rowLocationIcon": { "type": "Icon", "props": { "name": { "$item": "location_icon" }, "tone": "muted", "size": "sm" } },
      "rowLocationText": { "type": "Text", "props": { "text": { "$item": "location_label" }, "size": "sm", "tone": "muted" } },

      "rowCapacityGroup": {
        "type": "Stack",
        "props": { "gap": "xs", "align": "end" },
        "children": ["rowCapacityWithBar", "rowCapacityUnlimited"]
      },
      "rowCapacityWithBar": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "visible": { "$item": "has_capacity" },
        "children": ["rowCapacityLabel", "rowCapacityBar"]
      },
      "rowCapacityLabel": { "type": "Text", "props": { "text": { "$item": "capacity_label" }, "size": "sm", "tone": { "$item": "capacity_tone" } } },
      "rowCapacityBar":   { "type": "ProgressBar", "props": { "value": { "$item": "capacity_pct" }, "tone": { "$item": "capacity_tone" } } },
      "rowCapacityUnlimited": {
        "type": "Badge",
        "props": { "text": "No Limit", "tone": "muted", "variant": "soft" },
        "visible": { "$item": "has_capacity", "not": true }
      },

      "divider3": { "type": "Divider", "props": {} },

      "footerRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["footerCount", "footerLink"]
      },
      "footerCount": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": { "pattern": "Showing {shown} of {total} upcoming", "shown": { "$state": "/ui/counts/shown" }, "total": { "$state": "/ui/counts/total" } }
          },
          "tone": "muted"
        }
      },
      "footerLink": {
        "type": "Button",
        "props": { "label": "View all events →", "variant": "ghost", "size": "sm" }
      }

    }
  },
  "status": "published"
}
