{
  "id": "humanitix-upcoming-events",
  "title": "Upcoming Events",
  "description": "Events on Humanitix that haven't ended yet, soonest first. Click a row to open that event's own page on Humanitix.",
  "category": "operations",
  "tags": ["humanitix", "events", "ticketing", "tickets"],
  "keywords": ["events", "upcoming", "tickets", "ticketing", "humanitix", "schedule", "capacity"],
  "connectorsUsed": ["humanitix"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 5, "rowSpan": 7 },
    "min":       { "colSpan": 4, "rowSpan": 5 },
    "max":       { "colSpan": 8, "rowSpan": 12 }
  },
  "dataProvider": {
    "mcp": "humanitix",
    "tool": "list_events",
    "params": { "pageSize": 20 }
  },
  "spec": {
    "root": "card",
    "elements": {

      "card": {
        "type": "Card",
        "props": {},
        "children": ["headerRow", "divider1", "body", "footerRow"],
        "watch": {
          "/humanitix/list_events": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/rows",
                "value": {
                  "$computed": "humanitix_flatten_upcoming_events_compact",
                  "args": { "value": { "$state": "/humanitix/list_events" }, "displayLimit": 5 }
                }
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/counts",
                "value": {
                  "$computed": "humanitix_upcoming_events_counts",
                  "args": { "value": { "$state": "/humanitix/list_events" }, "displayLimit": 5 }
                }
              }
            }
          ]
        }
      },

      "headerRow": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": { "type": "Icon", "props": { "name": "CalendarDays", "tone": "chart-1", "size": "sm" } },
      "titleStack": { "type": "Stack", "props": { "gap": "none" }, "children": ["title", "eyebrow"] },
      "title": { "type": "Heading", "props": { "text": "Upcoming Events", "level": "h2" } },
      "eyebrow": { "type": "Eyebrow", "props": { "text": "Humanitix" } },

      "divider1": { "type": "Divider", "props": {} },

      "body": {
        "type": "Body",
        "props": {},
        "children": ["loading", "empty", "list"]
      },
      "loading": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "visible": { "$state": "/_loading/humanitix.list_events" },
        "children": ["sk1", "sk2", "sk3"]
      },
      "sk1": { "type": "Skeleton", "props": { "height": "3.5rem", "rounded": "md" } },
      "sk2": { "type": "Skeleton", "props": { "height": "3.5rem", "rounded": "md" } },
      "sk3": { "type": "Skeleton", "props": { "height": "3.5rem", "rounded": "md" } },

      "empty": {
        "type": "Empty",
        "props": { "message": "No upcoming events on Humanitix." },
        "visible": {
          "$and": [
            { "$state": "/_loading/humanitix.list_events", "not": true },
            { "$state": "/ui/rows/0", "not": true }
          ]
        }
      },

      "list": {
        "type": "Stack",
        "props": { "gap": "none" },
        "visible": { "$state": "/_loading/humanitix.list_events", "not": true },
        "repeat": { "statePath": "/ui/rows", "key": "id" },
        "children": ["rowWrap"]
      },

      "rowWrap": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["row", "rowDivider"]
      },
      "rowDivider": { "type": "Divider", "props": {} },

      "row": {
        "type": "Row",
        "props": {
          "gap": "md",
          "align": "center",
          "padded": true,
          "clickable": { "$item": "has_url" },
          "hover": { "$item": "has_url" }
        },
        "children": ["rowDateBadge", "rowMain", "rowChevron"],
        "on": {
          "click": { "action": "open_url", "params": { "url": { "$bindItem": "event_url" }, "target": "_blank" } }
        }
      },

      "rowDateBadge": {
        "type": "Stack",
        "props": { "gap": "xs", "align": "center" },
        "children": ["rowDayAvatar", "rowMonth"]
      },
      "rowDayAvatar": { "type": "Avatar", "props": { "initials": { "$item": "start_day_label" }, "tone": { "$item": "category_tone" }, "size": "lg" } },
      "rowMonth": { "type": "Caption", "props": { "text": { "$item": "start_month_label" }, "tone": { "$item": "category_tone" }, "weight": "medium" } },

      "rowMain": {
        "type": "Stack",
        "props": { "gap": "xs", "grow": true },
        "children": ["rowName", "rowMeta"]
      },
      "rowName": { "type": "Text", "props": { "text": { "$item": "name" }, "size": "sm", "weight": "semibold", "truncate": true } },
      "rowMeta": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["rowMetaTime", "rowMetaSep1", "rowMetaLocation", "rowMetaSep2", "rowMetaCapacity"]
      },
      "rowMetaTime":     { "type": "Caption", "props": { "text": { "$item": "start_time_label" }, "tone": "muted" } },
      "rowMetaSep1":     { "type": "Caption", "props": { "text": "·", "tone": "muted" } },
      "rowMetaLocation": { "type": "Caption", "props": { "text": { "$item": "location_label" }, "tone": "muted", "truncate": true } },
      "rowMetaSep2":     { "type": "Caption", "props": { "text": "·", "tone": "muted" } },
      "rowMetaCapacity": { "type": "Caption", "props": { "text": { "$item": "capacity_label" }, "tone": { "$item": "capacity_tone" }, "weight": "medium" } },

      "rowChevron": { "type": "Icon", "props": { "name": "ChevronRight", "tone": "muted", "size": "md" } },

      "footerRow": {
        "type": "Row",
        "props": { "justify": "center", "align": "center", "clickable": true, "hover": true },
        "children": ["footerLink"],
        "on": {
          "click": { "action": "open_url", "params": { "url": "https://events.humanitix.com", "target": "_blank" } }
        }
      },
      "footerLink": {
        "type": "Text",
        "props": {
          "text": { "$computed": "fmt", "args": { "pattern": "View all {n} events →", "n": { "$state": "/ui/counts/total" } } },
          "size": "sm",
          "weight": "medium",
          "tone": "chart-1"
        }
      }

    }
  },
  "status": "published"
}
