{
  "id": "humanitix-event-tickets",
  "title": "Event Ticket Sales",
  "description": "Ticket sales for the soonest upcoming Humanitix event — attendee, ticket type, amount, and check-in status.",
  "category": "operations",
  "tags": ["humanitix", "events", "ticketing", "tickets", "orders"],
  "keywords": ["tickets", "ticket sales", "attendees", "check-in", "humanitix"],
  "connectorsUsed": ["humanitix"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 5, "rowSpan": 6 },
    "min": { "colSpan": 4, "rowSpan": 4 },
    "max": { "colSpan": 10, "rowSpan": 12 }
  },
  "dataProvider": {
    "mcp": "humanitix",
    "tool": "list_events",
    "params": { "pageSize": 100 }
  },
  "spec": {
    "root": "card",
    "elements": {

      "card": {
        "type": "Card",
        "props": {},
        "children": ["titleRow", "eventLabelRow", "divider", "body"],
        "watch": {
          "/humanitix/list_events": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/eventId",
                "value": {
                  "$computed": "humanitix_next_upcoming_event_id",
                  "args": { "value": { "$state": "/humanitix/list_events" } }
                }
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/eventLabel",
                "value": {
                  "$computed": "humanitix_next_upcoming_event_label",
                  "args": { "value": { "$state": "/humanitix/list_events" } }
                }
              }
            }
          ],
          "/ui/eventId": [
            {
              "action": "humanitix.list_tickets",
              "params": { "eventId": { "$state": "/ui/eventId" }, "pageSize": 20 }
            }
          ],
          "/humanitix/list_tickets": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/rows",
                "value": {
                  "$computed": "humanitix_flatten_tickets",
                  "args": { "value": { "$state": "/humanitix/list_tickets" } }
                }
              }
            }
          ]
        }
      },

      "titleRow": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "Ticket", "tone": "info", "size": "sm" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "eyebrow"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Event Ticket Sales", "level": "h2" }
      },
      "eyebrow": {
        "type": "Eyebrow",
        "props": { "text": "Humanitix · next event, up to 20 tickets" }
      },

      "eventLabelRow": {
        "type": "Caption",
        "props": { "text": { "$state": "/ui/eventLabel" }, "tone": "muted", "truncate": true },
        "visible": { "$state": "/ui/eventLabel" }
      },

      "divider": { "type": "Divider", "props": {} },

      "body": {
        "type": "Body",
        "props": {},
        "children": ["noEvent", "empty", "table"]
      },

      "noEvent": {
        "type": "Empty",
        "props": { "message": "No upcoming events on Humanitix." },
        "visible": {
          "$and": [
            { "$state": "/_loading/humanitix.list_events", "not": true },
            { "$state": "/ui/eventId", "not": true }
          ]
        }
      },

      "empty": {
        "type": "Empty",
        "props": { "message": "No tickets sold yet for this event." },
        "visible": {
          "$and": [
            { "$state": "/ui/eventId" },
            { "$state": "/_loading/humanitix.list_tickets", "not": true },
            { "$state": "/ui/rows/0", "not": true }
          ]
        }
      },

      "table": {
        "type": "Table",
        "props": {
          "loading": {
            "$or": [
              { "$state": "/_loading/humanitix.list_events" },
              { "$state": "/_loading/humanitix.list_tickets" }
            ]
          },
          "skeletonRows": 5,
          "rows": { "$state": "/ui/rows" },
          "columns": [
            { "id": "attendee", "header": "Attendee", "field": "attendee", "priority": 1 },
            { "id": "type", "header": "Ticket Type", "field": "ticket_type", "width": 130, "priority": 2 },
            { "id": "amount", "header": "Amount", "field": "amount_label", "width": 100, "align": "right", "priority": 1 },
            {
              "id": "status",
              "header": "Status",
              "field": "status_label",
              "variant": "badge",
              "tone": { "$computed": "identity", "args": { "value": { "$item": "status_tone" } } },
              "width": 110,
              "priority": 1
            },
            {
              "id": "checkedIn",
              "header": "Checked In",
              "field": "checked_in_label",
              "variant": "badge",
              "tone": { "$computed": "identity", "args": { "value": { "$item": "checked_in_tone" } } },
              "width": 120,
              "priority": 2
            }
          ]
        },
        "visible": { "$state": "/ui/rows/0" }
      }

    }
  },
  "status": "published"
}
