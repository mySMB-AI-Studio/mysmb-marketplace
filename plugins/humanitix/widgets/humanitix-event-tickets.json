{
  "category": "operations",
  "connectorsUsed": [
    "humanitix"
  ],
  "dataProvider": {
    "kind": "tool",
    "mcp": "humanitix",
    "params": {
      "pageSize": 100
    },
    "tool": "list_events"
  },
  "description": "Ticket sales for the soonest upcoming Humanitix event — attendee, ticket type, amount, and check-in status.",
  "id": "humanitix-event-tickets",
  "keywords": [
    "tickets",
    "ticket sales",
    "attendees",
    "check-in",
    "humanitix"
  ],
  "popularity": 0,
  "sizing": {
    "max": {
      "colSpan": 10,
      "rowSpan": 12
    },
    "min": {
      "colSpan": 4,
      "rowSpan": 4
    },
    "preferred": {
      "colSpan": 5,
      "rowSpan": 6
    }
  },
  "spec": {
    "elements": {
      "body": {
        "children": [
          "noEvent",
          "empty",
          "table"
        ],
        "props": {},
        "type": "Body"
      },
      "card": {
        "children": [
          "titleRow",
          "eventLabelRow",
          "divider",
          "body"
        ],
        "props": {},
        "type": "Card",
        "watch": {
          "/humanitix/list_events": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/eventId",
                "value": {
                  "$computed": "humanitix_next_upcoming_event_id",
                  "args": {
                    "value": {
                      "$state": "/humanitix/list_events"
                    }
                  }
                }
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/eventLabel",
                "value": {
                  "$computed": "humanitix_next_upcoming_event_label",
                  "args": {
                    "value": {
                      "$state": "/humanitix/list_events"
                    }
                  }
                }
              }
            }
          ],
          "/humanitix/list_tickets": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/rows",
                "value": {
                  "$computed": "humanitix_flatten_tickets",
                  "args": {
                    "value": {
                      "$state": "/humanitix/list_tickets"
                    }
                  }
                }
              }
            }
          ],
          "/ui/eventId": [
            {
              "action": "humanitix.list_tickets",
              "params": {
                "eventId": {
                  "$state": "/ui/eventId"
                },
                "pageSize": 20
              }
            }
          ]
        }
      },
      "divider": {
        "props": {},
        "type": "Divider"
      },
      "empty": {
        "props": {
          "message": "No tickets sold yet for this event."
        },
        "type": "Empty",
        "visible": {
          "$and": [
            {
              "$state": "/ui/eventId"
            },
            {
              "$state": "/_loading/humanitix.list_tickets",
              "not": true
            },
            {
              "$state": "/ui/rows/0",
              "not": true
            }
          ]
        }
      },
      "eventLabelRow": {
        "props": {
          "text": {
            "$state": "/ui/eventLabel"
          },
          "tone": "muted",
          "truncate": true
        },
        "type": "Caption",
        "visible": {
          "$state": "/ui/eventLabel"
        }
      },
      "eyebrow": {
        "props": {
          "text": "Humanitix · next event, up to 20 tickets"
        },
        "type": "Eyebrow"
      },
      "noEvent": {
        "props": {
          "message": "No upcoming events on Humanitix."
        },
        "type": "Empty",
        "visible": {
          "$and": [
            {
              "$state": "/_loading/humanitix.list_events",
              "not": true
            },
            {
              "$state": "/ui/eventId",
              "not": true
            }
          ]
        }
      },
      "table": {
        "props": {
          "columns": [
            {
              "field": "attendee",
              "header": "Attendee",
              "id": "attendee",
              "priority": 1
            },
            {
              "field": "ticket_type",
              "header": "Ticket Type",
              "id": "type",
              "priority": 2,
              "width": 130
            },
            {
              "align": "right",
              "field": "amount_label",
              "header": "Amount",
              "id": "amount",
              "priority": 1,
              "width": 100
            },
            {
              "field": "status_label",
              "header": "Status",
              "id": "status",
              "priority": 1,
              "tone": {
                "$computed": "identity",
                "args": {
                  "value": {
                    "$item": "status_tone"
                  }
                }
              },
              "variant": "badge",
              "width": 110
            },
            {
              "field": "checked_in_label",
              "header": "Checked In",
              "id": "checkedIn",
              "priority": 2,
              "tone": {
                "$computed": "identity",
                "args": {
                  "value": {
                    "$item": "checked_in_tone"
                  }
                }
              },
              "variant": "badge",
              "width": 120
            }
          ],
          "loading": {
            "$or": [
              {
                "$state": "/_loading/humanitix.list_events"
              },
              {
                "$state": "/_loading/humanitix.list_tickets"
              }
            ]
          },
          "rows": {
            "$state": "/ui/rows"
          },
          "skeletonRows": 5
        },
        "type": "Table",
        "visible": {
          "$state": "/ui/rows/0"
        }
      },
      "title": {
        "props": {
          "level": "h2",
          "text": "Event Ticket Sales"
        },
        "type": "Heading"
      },
      "titleIcon": {
        "props": {
          "name": "Ticket",
          "size": "sm",
          "tone": "info"
        },
        "type": "Icon"
      },
      "titleRow": {
        "children": [
          "titleIcon",
          "titleStack"
        ],
        "props": {
          "align": "center",
          "gap": "sm"
        },
        "type": "Row"
      },
      "titleStack": {
        "children": [
          "title",
          "eyebrow"
        ],
        "props": {
          "gap": "none"
        },
        "type": "Stack"
      }
    },
    "root": "card"
  },
  "tags": [
    "humanitix",
    "events",
    "ticketing",
    "tickets",
    "orders"
  ],
  "title": "Event Ticket Sales"
}
