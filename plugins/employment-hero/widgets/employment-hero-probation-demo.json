{
  "id": "employment-hero-probation-demo",
  "title": "Probation Ending Soon (Demo)",
  "description": "STATIC DEMO — employees with probation periods ending within 60 days. Hardcoded sample data, no connector required.",
  "category": "hr",
  "tags": ["employment-hero", "hr", "probation", "employees", "demo"],
  "keywords": ["probation", "probation ending", "new hire", "trial period", "employment hero", "demo"],
  "connectorsUsed": ["employment-hero"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 5, "rowSpan": 6 },
    "min":       { "colSpan": 4, "rowSpan": 5 },
    "max":       { "colSpan": 8, "rowSpan": 12 }
  },
  "spec": {
    "root": "card",
    "elements": {

      "card": {
        "type": "Card",
        "props": {},
        "children": ["titleRow", "divider", "scrollBody", "footerDivider", "footer"]
      },

      "titleRow":   { "type": "Row",   "props": { "justify": "between", "align": "center" }, "children": ["titleGroup"] },
      "titleGroup": { "type": "Row",   "props": { "gap": "sm", "align": "center" },          "children": ["titleIcon", "titleStack"] },
      "titleIcon":  { "type": "Icon",  "props": { "name": "CalendarClock", "tone": "accent", "size": "sm" } },
      "titleStack": { "type": "Stack", "props": { "gap": "none" }, "children": ["title", "eyebrow"] },
      "title":      { "type": "Heading", "props": { "text": "Probation Ending Soon", "level": "h2" } },
      "eyebrow":    { "type": "Eyebrow", "props": { "text": "Employment Hero" } },

      "divider": { "type": "Divider", "props": {} },

      "scrollBody": {
        "type": "Body",
        "props": {},
        "children": ["list"]
      },

      "list": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": [
          "row1", "rd1",
          "row2", "rd2",
          "row3"
        ]
      },

      "row1":  { "type": "Row", "props": { "justify": "between", "align": "center" }, "children": ["left1", "badge1"] },
      "left1": { "type": "Row", "props": { "gap": "sm", "align": "center" }, "children": ["av1", "name1"] },
      "av1":   { "type": "Avatar", "props": { "initials": "JO", "tone": "muted", "size": "sm" } },
      "name1": { "type": "Stack", "props": { "gap": "none" }, "children": ["n1a", "n1b"] },
      "n1a":   { "type": "Text", "props": { "text": "Jake O'Sullivan", "size": "sm", "weight": "medium" } },
      "n1b":   { "type": "Text", "props": { "text": "Electrician · ends 4 Jul", "size": "xs", "tone": "muted" } },
      "badge1": { "type": "Badge", "props": { "text": "5 days", "tone": "destructive", "variant": "soft" } },
      "rd1":   { "type": "Divider", "props": {} },

      "row2":  { "type": "Row", "props": { "justify": "between", "align": "center" }, "children": ["left2", "badge2"] },
      "left2": { "type": "Row", "props": { "gap": "sm", "align": "center" }, "children": ["av2", "name2"] },
      "av2":   { "type": "Avatar", "props": { "initials": "CL", "tone": "warning", "size": "sm" } },
      "name2": { "type": "Stack", "props": { "gap": "none" }, "children": ["n2a", "n2b"] },
      "n2a":   { "type": "Text", "props": { "text": "Chloe Lam", "size": "sm", "weight": "medium" } },
      "n2b":   { "type": "Text", "props": { "text": "Apprentice · ends 18 Jul", "size": "xs", "tone": "muted" } },
      "badge2": { "type": "Badge", "props": { "text": "17 days", "tone": "warning", "variant": "soft" } },
      "rd2":   { "type": "Divider", "props": {} },

      "row3":  { "type": "Row", "props": { "justify": "between", "align": "center" }, "children": ["left3", "badge3"] },
      "left3": { "type": "Row", "props": { "gap": "sm", "align": "center" }, "children": ["av3", "name3"] },
      "av3":   { "type": "Avatar", "props": { "initials": "MR", "tone": "accent", "size": "sm" } },
      "name3": { "type": "Stack", "props": { "gap": "none" }, "children": ["n3a", "n3b"] },
      "n3a":   { "type": "Text", "props": { "text": "Michael Russo", "size": "sm", "weight": "medium" } },
      "n3b":   { "type": "Text", "props": { "text": "Admin Officer · ends 25 Aug", "size": "xs", "tone": "muted" } },
      "badge3": { "type": "Badge", "props": { "text": "55 days", "tone": "muted", "variant": "soft" } },

      "footerDivider": { "type": "Divider", "props": {} },

      "footer": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["footerLink", "footerCaption"]
      },
      "footerLink":    { "type": "Button",  "props": { "label": "Review employees →", "variant": "ghost", "size": "sm" } },
      "footerCaption": { "type": "Caption", "props": { "text": "3 probation periods ending within 60 days" } }

    }
  },
  "status": "published"
}
