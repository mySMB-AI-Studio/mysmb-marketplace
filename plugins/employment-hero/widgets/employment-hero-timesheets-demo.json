{
  "id": "employment-hero-timesheets-demo",
  "title": "Timesheets to Approve (Demo)",
  "description": "STATIC DEMO — pending timesheet approvals with hours worked. Hardcoded sample data, no connector required.",
  "category": "hr",
  "tags": ["employment-hero", "hr", "timesheets", "payroll", "approval", "demo"],
  "keywords": ["timesheets", "approve", "hours", "payroll", "pending", "employment hero", "demo"],
  "connectorsUsed": ["employment-hero"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 5, "rowSpan": 6 },
    "min":       { "colSpan": 4, "rowSpan": 5 },
    "max":       { "colSpan": 8, "rowSpan": 12 }
  },
  "spec": {
    "root": "card",
    "elements": {

      "card": {
        "type": "Card",
        "props": {},
        "children": ["titleRow", "divider", "scrollBody", "footerDivider", "footer"]
      },

      "titleRow":   { "type": "Row",   "props": { "justify": "between", "align": "center" }, "children": ["titleGroup"] },
      "titleGroup": { "type": "Row",   "props": { "gap": "sm", "align": "center" },          "children": ["titleIcon", "titleStack"] },
      "titleIcon":  { "type": "Icon",  "props": { "name": "ClipboardList", "tone": "accent", "size": "sm" } },
      "titleStack": { "type": "Stack", "props": { "gap": "none" }, "children": ["title", "eyebrow"] },
      "title":      { "type": "Heading", "props": { "text": "Timesheets to Approve", "level": "h2" } },
      "eyebrow":    { "type": "Eyebrow", "props": { "text": "Employment Hero" } },

      "divider": { "type": "Divider", "props": {} },

      "scrollBody": {
        "type": "Body",
        "props": {},
        "children": ["list"]
      },

      "list": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": [
          "row1", "rd1",
          "row2", "rd2",
          "row3"
        ]
      },

      "row1":  { "type": "Row", "props": { "justify": "between", "align": "center" }, "children": ["left1", "right1"] },
      "left1": { "type": "Row", "props": { "gap": "sm", "align": "center" }, "children": ["av1", "name1"] },
      "av1":   { "type": "Avatar", "props": { "initials": "JD", "tone": "accent", "size": "sm" } },
      "name1": { "type": "Stack", "props": { "gap": "none" }, "children": ["n1a", "n1b"] },
      "n1a":   { "type": "Text", "props": { "text": "Jye Donnelly", "size": "sm", "weight": "medium" } },
      "n1b":   { "type": "Text", "props": { "text": "Week ending 27 Jun", "size": "xs", "tone": "muted" } },
      "right1": { "type": "Stack", "props": { "gap": "none", "align": "end" }, "children": ["r1a", "r1b"] },
      "r1a":   { "type": "Text", "props": { "text": "38.5 hrs", "size": "sm", "weight": "bold" } },
      "r1b":   { "type": "Text", "props": { "text": "pending", "size": "xs", "tone": "warning" } },
      "rd1":   { "type": "Divider", "props": {} },

      "row2":  { "type": "Row", "props": { "justify": "between", "align": "center" }, "children": ["left2", "right2"] },
      "left2": { "type": "Row", "props": { "gap": "sm", "align": "center" }, "children": ["av2", "name2"] },
      "av2":   { "type": "Avatar", "props": { "initials": "SR", "tone": "success", "size": "sm" } },
      "name2": { "type": "Stack", "props": { "gap": "none" }, "children": ["n2a", "n2b"] },
      "n2a":   { "type": "Text", "props": { "text": "Sam Roberts", "size": "sm", "weight": "medium" } },
      "n2b":   { "type": "Text", "props": { "text": "Week ending 27 Jun", "size": "xs", "tone": "muted" } },
      "right2": { "type": "Stack", "props": { "gap": "none", "align": "end" }, "children": ["r2a", "r2b"] },
      "r2a":   { "type": "Text", "props": { "text": "40.0 hrs", "size": "sm", "weight": "bold" } },
      "r2b":   { "type": "Text", "props": { "text": "pending", "size": "xs", "tone": "warning" } },
      "rd2":   { "type": "Divider", "props": {} },

      "row3":  { "type": "Row", "props": { "justify": "between", "align": "center" }, "children": ["left3", "right3"] },
      "left3": { "type": "Row", "props": { "gap": "sm", "align": "center" }, "children": ["av3", "name3"] },
      "av3":   { "type": "Avatar", "props": { "initials": "DJ", "tone": "warning", "size": "sm" } },
      "name3": { "type": "Stack", "props": { "gap": "none" }, "children": ["n3a", "n3b"] },
      "n3a":   { "type": "Text", "props": { "text": "Dean Jackson", "size": "sm", "weight": "medium" } },
      "n3b":   { "type": "Text", "props": { "text": "Week ending 27 Jun", "size": "xs", "tone": "muted" } },
      "right3": { "type": "Stack", "props": { "gap": "none", "align": "end" }, "children": ["r3a", "r3b"] },
      "r3a":   { "type": "Text", "props": { "text": "32.0 hrs", "size": "sm", "weight": "bold" } },
      "r3b":   { "type": "Text", "props": { "text": "pending", "size": "xs", "tone": "warning" } },

      "footerDivider": { "type": "Divider", "props": {} },

      "footer": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["footerLink", "footerCaption"]
      },
      "footerLink":    { "type": "Button",  "props": { "label": "Approve timesheets →", "variant": "ghost", "size": "sm" } },
      "footerCaption": { "type": "Caption", "props": { "text": "3 timesheets awaiting approval" } }

    }
  },
  "status": "published"
}
