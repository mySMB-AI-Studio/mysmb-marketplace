{
  "id": "employment-hero-on-leave-demo",
  "title": "On Leave This Week (Demo)",
  "description": "STATIC DEMO — employees on leave this week with leave type and date range. Hardcoded sample data, no connector required.",
  "category": "hr",
  "tags": ["employment-hero", "hr", "leave", "absence", "demo"],
  "keywords": ["on leave", "leave", "absence", "time off", "annual leave", "sick leave", "employment hero", "demo"],
  "connectorsUsed": ["employment-hero"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 5, "rowSpan": 6 },
    "min":       { "colSpan": 4, "rowSpan": 5 },
    "max":       { "colSpan": 8, "rowSpan": 12 }
  },
  "spec": {
    "root": "card",
    "elements": {

      "card": {
        "type": "Card",
        "props": {},
        "children": ["titleRow", "divider", "scrollBody", "footerDivider", "footer"]
      },

      "titleRow":   { "type": "Row",   "props": { "justify": "between", "align": "center" }, "children": ["titleGroup"] },
      "titleGroup": { "type": "Row",   "props": { "gap": "sm", "align": "center" },          "children": ["titleIcon", "titleStack"] },
      "titleIcon":  { "type": "Icon",  "props": { "name": "CalendarOff", "tone": "accent", "size": "sm" } },
      "titleStack": { "type": "Stack", "props": { "gap": "none" }, "children": ["title", "eyebrow"] },
      "title":      { "type": "Heading", "props": { "text": "On Leave This Week", "level": "h2" } },
      "eyebrow":    { "type": "Eyebrow", "props": { "text": "Employment Hero" } },

      "divider": { "type": "Divider", "props": {} },

      "scrollBody": {
        "type": "Body",
        "props": {},
        "children": ["list"]
      },

      "list": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": [
          "row1", "rd1",
          "row2", "rd2",
          "row3"
        ]
      },

      "row1": { "type": "Row", "props": { "justify": "between", "align": "center" }, "children": ["left1", "right1"] },
      "left1": { "type": "Row", "props": { "gap": "sm", "align": "center" }, "children": ["av1", "name1"] },
      "av1":   { "type": "Avatar", "props": { "initials": "TW", "tone": "warning", "size": "sm" } },
      "name1": { "type": "Stack", "props": { "gap": "none" }, "children": ["n1a", "n1b"] },
      "n1a":   { "type": "Text", "props": { "text": "Tash Williams", "size": "sm", "weight": "medium" } },
      "n1b":   { "type": "Text", "props": { "text": "Annual Leave", "size": "xs", "tone": "muted" } },
      "right1": { "type": "Stack", "props": { "gap": "none", "align": "end" }, "children": ["r1a", "r1b"] },
      "r1a":   { "type": "Text", "props": { "text": "30 Jun – 4 Jul", "size": "xs", "tone": "muted" } },
      "r1b":   { "type": "Text", "props": { "text": "5 days", "size": "xs", "weight": "medium" } },
      "rd1":   { "type": "Divider", "props": {} },

      "row2": { "type": "Row", "props": { "justify": "between", "align": "center" }, "children": ["left2", "right2"] },
      "left2": { "type": "Row", "props": { "gap": "sm", "align": "center" }, "children": ["av2", "name2"] },
      "av2":   { "type": "Avatar", "props": { "initials": "BH", "tone": "accent", "size": "sm" } },
      "name2": { "type": "Stack", "props": { "gap": "none" }, "children": ["n2a", "n2b"] },
      "n2a":   { "type": "Text", "props": { "text": "Brad Harris", "size": "sm", "weight": "medium" } },
      "n2b":   { "type": "Text", "props": { "text": "Sick Leave", "size": "xs", "tone": "muted" } },
      "right2": { "type": "Stack", "props": { "gap": "none", "align": "end" }, "children": ["r2a", "r2b"] },
      "r2a":   { "type": "Text", "props": { "text": "1 Jul – 2 Jul", "size": "xs", "tone": "muted" } },
      "r2b":   { "type": "Text", "props": { "text": "2 days", "size": "xs", "weight": "medium" } },
      "rd2":   { "type": "Divider", "props": {} },

      "row3": { "type": "Row", "props": { "justify": "between", "align": "center" }, "children": ["left3", "right3"] },
      "left3": { "type": "Row", "props": { "gap": "sm", "align": "center" }, "children": ["av3", "name3"] },
      "av3":   { "type": "Avatar", "props": { "initials": "SC", "tone": "success", "size": "sm" } },
      "name3": { "type": "Stack", "props": { "gap": "none" }, "children": ["n3a", "n3b"] },
      "n3a":   { "type": "Text", "props": { "text": "Sarah Connell", "size": "sm", "weight": "medium" } },
      "n3b":   { "type": "Text", "props": { "text": "Carer's Leave", "size": "xs", "tone": "muted" } },
      "right3": { "type": "Stack", "props": { "gap": "none", "align": "end" }, "children": ["r3a", "r3b"] },
      "r3a":   { "type": "Text", "props": { "text": "1 Jul", "size": "xs", "tone": "muted" } },
      "r3b":   { "type": "Text", "props": { "text": "1 day", "size": "xs", "weight": "medium" } },

      "footerDivider": { "type": "Divider", "props": {} },

      "footer": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["footerLink", "footerCaption"]
      },
      "footerLink":    { "type": "Button",  "props": { "label": "Manage leave →", "variant": "ghost", "size": "sm" } },
      "footerCaption": { "type": "Caption", "props": { "text": "3 employees on leave this week" } }

    }
  },
  "status": "published"
}
