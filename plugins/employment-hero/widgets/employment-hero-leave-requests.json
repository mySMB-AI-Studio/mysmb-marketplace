{
  "id": "employment-hero-leave-requests",
  "title": "Pending Leave Requests",
  "description": "Live list of pending employee leave requests from Employment Hero.",
  "category": "hr",
  "tags": ["employment-hero", "hr", "leave", "requests", "pending"],
  "keywords": ["leave", "leave request", "pending", "time off", "absence", "hr", "employment hero"],
  "connectorsUsed": ["employment-hero"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 5, "rowSpan": 7 },
    "min":       { "colSpan": 4, "rowSpan": 5 },
    "max":       { "colSpan": 10, "rowSpan": 12 }
  },
  "dataProvider": {
    "mcp": "employment-hero",
    "tool": "list_leave_requests",
    "params": { "status": "pending", "per_page": 25 }
  },
  "spec": {
    "root": "card",
    "elements": {

      "card": {
        "type": "Card",
        "props": {},
        "children": ["header", "body", "footer"],
        "watch": {
          "/employment-hero/list_leave_requests/data/items": [
            { "action": "setState", "params": { "statePath": "/ui/leaveRows", "value": { "$computed": "employment-hero_flatten_leave_requests", "args": { "value": { "$state": "/employment-hero/list_leave_requests/data/items" } } } } }
          ]
        }
      },

      "header": { "type": "Header", "props": {}, "children": ["headerRow"] },
      "headerRow": { "type": "Row", "props": { "align": "center", "template": "1fr auto" }, "children": ["titleGroup"] },
      "titleGroup": { "type": "Row", "props": { "gap": "sm", "align": "start" }, "children": ["titleIcon", "titleStack"] },
      "titleIcon": { "type": "Icon", "props": { "name": "CalendarOff", "tone": "accent", "size": "sm" } },
      "titleStack": { "type": "Stack", "props": { "gap": "none" }, "children": ["title", "eyebrow"] },
      "title": { "type": "Heading", "props": { "text": "Pending Leave Requests", "level": "h2" } },
      "eyebrow": { "type": "Eyebrow", "props": { "text": "Employment Hero" } },

      "body": { "type": "Body", "props": {}, "children": ["loading", "empty", "list"] },

      "loading": {
        "type": "Stack", "props": { "gap": "sm" },
        "children": ["sk1", "sk2", "sk3", "sk4"],
        "visible": { "$state": "/_loading/employment-hero.list_leave_requests" }
      },
      "sk1": { "type": "Skeleton", "props": { "height": "3rem", "rounded": "md" } },
      "sk2": { "type": "Skeleton", "props": { "height": "3rem", "rounded": "md" } },
      "sk3": { "type": "Skeleton", "props": { "height": "3rem", "rounded": "md" } },
      "sk4": { "type": "Skeleton", "props": { "height": "3rem", "rounded": "md" } },

      "empty": {
        "type": "Empty",
        "props": { "message": "No pending leave requests." },
        "visible": {
          "$and": [
            { "$state": "/_loading/employment-hero.list_leave_requests", "not": true },
            { "$state": "/employment-hero/list_leave_requests/data/items/0", "not": true }
          ]
        }
      },

      "list": {
        "type": "Stack", "props": { "gap": "xs" },
        "children": ["leaveRow"],
        "repeat": { "statePath": "/ui/leaveRows", "key": "id" },
        "visible": {
          "$and": [
            { "$state": "/_loading/employment-hero.list_leave_requests", "not": true },
            { "$state": "/employment-hero/list_leave_requests/data/items/0" }
          ]
        }
      },

      "leaveRow": {
        "type": "Stack", "props": { "gap": "xs" },
        "children": ["leaveRowContent", "leaveRowDivider"]
      },
      "leaveRowContent": {
        "type": "Row",
        "props": { "justify": "between", "align": "start", "hover": true },
        "children": ["leaveIdentity", "leaveRight"]
      },
      "leaveIdentity": {
        "type": "Stack", "props": { "gap": "none" },
        "children": ["leaveName", "leaveType"]
      },
      "leaveName": {
        "type": "Text",
        "props": { "text": { "$item": "employee_name" }, "size": "sm", "weight": "medium", "truncate": true }
      },
      "leaveType": {
        "type": "Caption",
        "props": { "text": { "$item": "leave_type" }, "truncate": true }
      },
      "leaveRight": {
        "type": "Stack", "props": { "gap": "none", "align": "end" },
        "children": ["leaveStatusWrap", "leaveDates"]
      },
      "leaveStatusWrap": {
        "type": "Stack", "props": { "align": "end" },
        "children": ["leaveStatus"]
      },
      "leaveStatus": {
        "type": "Badge",
        "props": {
          "text": { "$item": "status_label" },
          "tone": { "$item": "status_tone" },
          "variant": "soft"
        }
      },
      "leaveDates": {
        "type": "Caption",
        "props": { "text": { "$item": "date_range" } }
      },
      "leaveRowDivider": { "type": "Divider", "props": {} },

      "footer": {
        "type": "Row", "props": { "justify": "center" },
        "children": ["footerText"],
        "visible": {
          "$and": [
            { "$state": "/_loading/employment-hero.list_leave_requests", "not": true },
            { "$state": "/employment-hero/list_leave_requests/data/items/0" }
          ]
        }
      },
      "footerText": {
        "type": "Caption",
        "props": { "text": "Pending requests only · Employment Hero" }
      }

    }
  },
  "status": "published"
}
