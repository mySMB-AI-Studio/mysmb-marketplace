{
  "id": "employment-hero-leave-requests",
  "title": "Pending Leave Requests",
  "description": "Live list of pending employee leave requests from Employment Hero.",
  "category": "hr",
  "tags": ["employment-hero", "hr", "leave", "requests", "pending"],
  "keywords": ["leave", "leave request", "pending", "time off", "absence", "hr", "employment hero"],
  "connectorsUsed": ["employment-hero"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 5, "rowSpan": 7 },
    "min":       { "colSpan": 4, "rowSpan": 5 },
    "max":       { "colSpan": 10, "rowSpan": 12 }
  },
  "dataProvider": {
    "mcp": "employment-hero",
    "tool": "list_leave_requests",
    "params": {
      "status": "pending",
      "per_page": 25
    }
  },
  "spec": {
    "root": "card",
    "elements": {

      "card": {
        "type": "Card",
        "props": {},
        "children": ["titleRow", "divider", "loading", "empty", "scrollBody", "footer"]
      },

      "titleRow": {
        "type": "Row",
        "props": { "align": "center" },
        "children": ["titleGroup"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "CalendarOff", "tone": "accent", "size": "sm" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "eyebrow"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Pending Leave Requests", "level": "h2" }
      },
      "eyebrow": {
        "type": "Eyebrow",
        "props": { "text": "Employment Hero" }
      },

      "divider": { "type": "Divider", "props": {} },

      "loading": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["s1", "s2", "s3", "s4"],
        "visible": { "$state": "/_loading/employment-hero.list_leave_requests" }
      },
      "s1": { "type": "Skeleton", "props": { "height": "3rem", "rounded": "md" } },
      "s2": { "type": "Skeleton", "props": { "height": "3rem", "rounded": "md" } },
      "s3": { "type": "Skeleton", "props": { "height": "3rem", "rounded": "md" } },
      "s4": { "type": "Skeleton", "props": { "height": "3rem", "rounded": "md" } },

      "empty": {
        "type": "Empty",
        "props": { "message": "No pending leave requests." },
        "visible": {
          "$and": [
            { "$state": "/_loading/employment-hero.list_leave_requests", "not": true },
            { "$state": "/employment-hero/list_leave_requests/leave_requests/0", "not": true }
          ]
        }
      },

      "scrollBody": {
        "type": "Body",
        "props": {},
        "children": ["list"],
        "visible": { "$state": "/_loading/employment-hero.list_leave_requests", "not": true }
      },

      "list": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["row"],
        "repeat": {
          "statePath": "/employment-hero/list_leave_requests/leave_requests",
          "key": "id"
        }
      },

      "row": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["rowContent", "rowDivider"]
      },
      "rowContent": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["rowLeft", "rowBadge"]
      },
      "rowLeft": {
        "type": "Stack",
        "props": { "gap": "none", "grow": true },
        "children": ["rowName", "rowDates"]
      },
      "rowName": {
        "type": "Text",
        "props": {
          "text": { "$item": "employee_name" },
          "size": "sm",
          "weight": "medium",
          "truncate": true
        }
      },
      "rowDates": {
        "type": "Text",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{s} → {e}",
              "s": { "$item": "start_date" },
              "e": { "$item": "end_date" }
            }
          },
          "size": "xs",
          "tone": "muted"
        }
      },
      "rowBadge": {
        "type": "Badge",
        "props": {
          "text": { "$item": "leave_type" },
          "tone": "accent",
          "variant": "soft"
        },
        "visible": { "$item": "leave_type" }
      },
      "rowDivider": { "type": "Divider", "props": {} },

      "footer": {
        "type": "Row",
        "props": { "justify": "center" },
        "children": ["footerText"],
        "visible": {
          "$and": [
            { "$state": "/_loading/employment-hero.list_leave_requests", "not": true },
            { "$state": "/employment-hero/list_leave_requests/leave_requests/0" }
          ]
        }
      },
      "footerText": {
        "type": "Caption",
        "props": { "text": "Pending requests only · Employment Hero" }
      }

    }
  },
  "status": "published"
}
