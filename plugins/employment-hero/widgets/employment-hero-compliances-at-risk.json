{
  "id": "employment-hero-compliances-at-risk",
  "title": "Compliances at Risk",
  "description": "Certifications that are overdue or due today in Employment Hero.",
  "category": "hr",
  "tags": ["employment-hero", "hr", "compliance", "risk", "expiry"],
  "keywords": ["compliance", "at risk", "expired", "due today", "certifications", "documents", "employment hero"],
  "connectorsUsed": ["employment-hero"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 5, "rowSpan": 7 },
    "min":       { "colSpan": 4, "rowSpan": 5 },
    "max":       { "colSpan": 10, "rowSpan": 12 }
  },
  "dataProvider": {
    "mcp": "employment-hero",
    "tool": "list_compliance_documents",
    "params": {}
  },
  "spec": {
    "root": "card",
    "elements": {

      "card": {
        "type": "Card",
        "props": {},
        "children": ["header", "body", "footer"],
        "watch": {
          "/employment-hero/list_compliance_documents/data/items": [
            { "action": "setState", "params": { "statePath": "/ui/complianceRows", "value": { "$computed": "employment-hero_flatten_compliance_at_risk", "args": { "value": { "$state": "/employment-hero/list_compliance_documents/data/items" } } } } }
          ]
        }
      },

      "header": { "type": "Header", "props": {}, "children": ["headerRow"] },
      "headerRow": { "type": "Row", "props": { "align": "center", "template": "1fr auto" }, "children": ["titleGroup"] },
      "titleGroup": { "type": "Row", "props": { "gap": "sm", "align": "start" }, "children": ["titleIcon", "titleStack"] },
      "titleIcon": { "type": "Icon", "props": { "name": "AlertTriangle", "tone": "accent", "size": "sm" } },
      "titleStack": { "type": "Stack", "props": { "gap": "none" }, "children": ["title", "eyebrow"] },
      "title": { "type": "Heading", "props": { "text": "Compliances at Risk", "level": "h2" } },
      "eyebrow": { "type": "Eyebrow", "props": { "text": "Employment Hero" } },

      "body": { "type": "Body", "props": {}, "children": ["loading", "empty", "list"] },

      "loading": {
        "type": "Stack", "props": { "gap": "sm" },
        "children": ["sk1", "sk2", "sk3"],
        "visible": { "$state": "/_loading/employment-hero.list_compliance_documents" }
      },
      "sk1": { "type": "Skeleton", "props": { "height": "3rem", "rounded": "md" } },
      "sk2": { "type": "Skeleton", "props": { "height": "3rem", "rounded": "md" } },
      "sk3": { "type": "Skeleton", "props": { "height": "3rem", "rounded": "md" } },

      "empty": {
        "type": "Empty",
        "props": { "message": "No compliance items at risk." },
        "visible": {
          "$and": [
            { "$state": "/_loading/employment-hero.list_compliance_documents", "not": true },
            { "$state": "/ui/complianceRows/0", "not": true }
          ]
        }
      },

      "list": {
        "type": "Stack", "props": { "gap": "xs" },
        "children": ["complianceRow"],
        "repeat": { "statePath": "/ui/complianceRows", "key": "id" },
        "visible": {
          "$and": [
            { "$state": "/_loading/employment-hero.list_compliance_documents", "not": true },
            { "$state": "/ui/complianceRows/0" }
          ]
        }
      },

      "complianceRow": {
        "type": "Stack", "props": { "gap": "xs" },
        "children": ["complianceRowContent", "complianceRowDivider"]
      },
      "complianceRowContent": {
        "type": "Row",
        "props": { "justify": "between", "align": "center", "hover": true },
        "children": ["complianceLeft", "complianceRight"]
      },
      "complianceLeft": {
        "type": "Stack", "props": { "gap": "none" },
        "children": ["complianceName", "complianceDueLabel"]
      },
      "complianceName": {
        "type": "Text",
        "props": { "text": { "$item": "display_name" }, "size": "sm", "weight": "medium", "truncate": true }
      },
      "complianceDueLabel": {
        "type": "Caption",
        "props": { "text": "Due Date" }
      },
      "complianceRight": {
        "type": "Stack", "props": { "gap": "none", "align": "end" },
        "children": ["complianceStatus", "complianceDue"]
      },
      "complianceStatus": {
        "type": "Badge",
        "props": {
          "text": { "$item": "status_label" },
          "tone": { "$item": "status_tone" },
          "variant": "soft"
        }
      },
      "complianceDue": {
        "type": "Caption",
        "props": { "text": { "$item": "due_date" } }
      },
      "complianceRowDivider": { "type": "Divider", "props": {} },

      "footer": {
        "type": "Row", "props": { "justify": "center" },
        "children": ["footerText"],
        "visible": {
          "$and": [
            { "$state": "/_loading/employment-hero.list_compliance_documents", "not": true },
            { "$state": "/ui/complianceRows/0" }
          ]
        }
      },
      "footerText": {
        "type": "Caption",
        "props": { "text": "Certifications only · Employment Hero" }
      }

    }
  },
  "status": "published"
}
