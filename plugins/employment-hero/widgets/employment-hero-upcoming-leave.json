{
  "id": "employment-hero-upcoming-leave",
  "title": "Direct Reports' Upcoming Leave",
  "description": "Approved upcoming leave for your direct reports, grouped by date.",
  "category": "hr",
  "tags": ["employment-hero", "hr", "leave", "upcoming", "manager", "direct-reports"],
  "keywords": ["direct reports", "upcoming leave", "approved leave", "team leave", "manager", "employment hero"],
  "connectorsUsed": ["employment-hero"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 5, "rowSpan": 7 },
    "min":       { "colSpan": 4, "rowSpan": 5 },
    "max":       { "colSpan": 10, "rowSpan": 12 }
  },
  "dataProvider": {
    "mcp": "employment-hero",
    "tool": "get_direct_reports_upcoming_leave",
    "params": {}
  },
  "spec": {
    "root": "card",
    "elements": {

      "card": {
        "type": "Card",
        "props": {},
        "children": ["header", "body", "footer"],
        "watch": {
          "/employment-hero/get_direct_reports_upcoming_leave/data/items": [
            { "action": "setState", "params": { "statePath": "/ui/upcomingRows", "value": { "$computed": "employment-hero_flatten_direct_reports_upcoming_leave", "args": { "value": { "$state": "/employment-hero/get_direct_reports_upcoming_leave/data/items" } } } } }
          ]
        }
      },

      "header": { "type": "Header", "props": {}, "children": ["headerRow"] },
      "headerRow": { "type": "Row", "props": { "align": "center", "template": "1fr auto" }, "children": ["titleGroup"] },
      "titleGroup": { "type": "Row", "props": { "gap": "sm", "align": "start" }, "children": ["titleIcon", "titleStack"] },
      "titleIcon": { "type": "Icon", "props": { "name": "CalendarDays", "tone": "accent", "size": "sm" } },
      "titleStack": { "type": "Stack", "props": { "gap": "none" }, "children": ["title", "eyebrow"] },
      "title": { "type": "Heading", "props": { "text": "Direct Reports' Upcoming Leave", "level": "h2" } },
      "eyebrow": { "type": "Eyebrow", "props": { "text": "Employment Hero" } },

      "body": { "type": "Body", "props": {}, "children": ["loading", "empty", "list"] },

      "loading": {
        "type": "Stack", "props": { "gap": "sm" },
        "children": ["sk1", "sk2", "sk3"],
        "visible": { "$state": "/_loading/employment-hero.get_direct_reports_upcoming_leave" }
      },
      "sk1": { "type": "Skeleton", "props": { "height": "3rem", "rounded": "md" } },
      "sk2": { "type": "Skeleton", "props": { "height": "3rem", "rounded": "md" } },
      "sk3": { "type": "Skeleton", "props": { "height": "3rem", "rounded": "md" } },

      "empty": {
        "type": "Empty",
        "props": { "message": "No upcoming leave for your direct reports." },
        "visible": {
          "$and": [
            { "$state": "/_loading/employment-hero.get_direct_reports_upcoming_leave", "not": true },
            { "$state": "/ui/upcomingRows/0", "not": true }
          ]
        }
      },

      "list": {
        "type": "Stack", "props": { "gap": "sm" },
        "children": ["leaveItem"],
        "repeat": { "statePath": "/ui/upcomingRows", "key": "id" },
        "visible": {
          "$and": [
            { "$state": "/_loading/employment-hero.get_direct_reports_upcoming_leave", "not": true },
            { "$state": "/ui/upcomingRows/0" }
          ]
        }
      },

      "leaveItem": {
        "type": "Stack", "props": { "gap": "none" },
        "children": ["dateHeader", "employeeRow"]
      },
      "dateHeader": {
        "type": "Text",
        "props": { "text": { "$item": "date_header" }, "size": "xs", "weight": "semibold", "tone": "accent" }
      },
      "employeeRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["employeeName", "leaveType"]
      },
      "employeeName": {
        "type": "Text",
        "props": { "text": { "$item": "employee_name" }, "size": "sm", "weight": "medium", "truncate": true }
      },
      "leaveType": {
        "type": "Caption",
        "props": { "text": { "$item": "leave_type" } }
      },

      "footer": {
        "type": "Row", "props": { "justify": "center" },
        "children": ["footerText"],
        "visible": {
          "$and": [
            { "$state": "/_loading/employment-hero.get_direct_reports_upcoming_leave", "not": true },
            { "$state": "/ui/upcomingRows/0" }
          ]
        }
      },
      "footerText": {
        "type": "Caption",
        "props": { "text": "Direct reports only · Employment Hero" }
      }

    }
  },
  "status": "published"
}
