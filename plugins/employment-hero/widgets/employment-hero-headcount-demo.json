{
  "id": "employment-hero-headcount-demo",
  "title": "Headcount Snapshot (Demo)",
  "description": "STATIC DEMO — headcount KPIs: total employees, active, onboarding, and on leave today. Hardcoded sample data, no connector required.",
  "category": "hr",
  "tags": ["employment-hero", "hr", "headcount", "employees", "onboarding", "demo"],
  "keywords": ["headcount", "employees", "active", "onboarding", "on leave", "kpi", "employment hero", "demo"],
  "connectorsUsed": ["employment-hero"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 4, "rowSpan": 3 },
    "min":       { "colSpan": 4, "rowSpan": 3 },
    "max":       { "colSpan": 8, "rowSpan": 9 }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": ["titleRow", "divider", "statsGrid", "detailOverlay"]
      },
      "titleRow":   { "type": "Row",  "props": { "justify": "between", "align": "center" }, "children": ["titleGroup"] },
      "titleGroup": { "type": "Row",  "props": { "gap": "sm", "align": "center" },          "children": ["titleIcon", "titleStack"] },
      "titleIcon":  { "type": "Icon", "props": { "name": "Hash", "tone": "accent", "size": "sm" } },
      "titleStack": { "type": "Stack", "props": { "gap": "none" }, "children": ["title", "eyebrow"] },
      "title":      { "type": "Heading", "props": { "text": "Headcount Snapshot", "level": "h2" } },
      "eyebrow":    { "type": "Eyebrow", "props": { "text": "Employment Hero" } },
      "divider": { "type": "Divider", "props": {} },

      "statsGrid": {
        "type": "Grid",
        "props": { "cols": 2, "gap": "md" },
        "children": ["box1", "box2", "box3", "box4"]
      },

      "box1": { "type": "Section", "props": { "variant": "muted" }, "children": ["clickRow1"] },
      "clickRow1": {
        "type": "Row",
        "props": { "clickable": true, "hover": true },
        "children": ["stat1"],
        "on": { "click": [
          { "action": "setState", "params": { "statePath": "/ui/sel/key",            "value": { "$computed": "identity", "args": { "value": "total" } } } },
          { "action": "setState", "params": { "statePath": "/ui/sel/title",          "value": { "$computed": "identity", "args": { "value": "Total Employees" } } } },
          { "action": "setState", "params": { "statePath": "/ui/sel/show_total",     "value": { "$computed": "identity", "args": { "value": "1" } } } },
          { "action": "setState", "params": { "statePath": "/ui/sel/show_active",    "value": "" } },
          { "action": "setState", "params": { "statePath": "/ui/sel/show_onboarding","value": "" } },
          { "action": "setState", "params": { "statePath": "/ui/sel/show_leave",     "value": "" } }
        ] }
      },
      "stat1": { "type": "Stack",   "props": { "gap": "xs" },        "children": ["lbl1", "val1", "hint1"] },
      "lbl1":  { "type": "Eyebrow", "props": { "text": "Total Employees" } },
      "val1":  { "type": "Heading", "props": { "text": "24",  "size": "xl", "weight": "bold" } },
      "hint1": { "type": "Text",    "props": { "text": "across 3 teams",    "size": "xs", "tone": "muted" } },

      "box2": { "type": "Section", "props": { "variant": "muted" }, "children": ["clickRow2"] },
      "clickRow2": {
        "type": "Row",
        "props": { "clickable": true, "hover": true },
        "children": ["stat2"],
        "on": { "click": [
          { "action": "setState", "params": { "statePath": "/ui/sel/key",            "value": { "$computed": "identity", "args": { "value": "active" } } } },
          { "action": "setState", "params": { "statePath": "/ui/sel/title",          "value": { "$computed": "identity", "args": { "value": "Active Employees" } } } },
          { "action": "setState", "params": { "statePath": "/ui/sel/show_total",     "value": "" } },
          { "action": "setState", "params": { "statePath": "/ui/sel/show_active",    "value": { "$computed": "identity", "args": { "value": "1" } } } },
          { "action": "setState", "params": { "statePath": "/ui/sel/show_onboarding","value": "" } },
          { "action": "setState", "params": { "statePath": "/ui/sel/show_leave",     "value": "" } }
        ] }
      },
      "stat2": { "type": "Stack",   "props": { "gap": "xs" },        "children": ["lbl2", "val2", "hint2"] },
      "lbl2":  { "type": "Eyebrow", "props": { "text": "Active" } },
      "val2":  { "type": "Heading", "props": { "text": "22", "size": "xl", "weight": "bold", "tone": "success" } },
      "hint2": { "type": "Text",    "props": { "text": "currently employed", "size": "xs", "tone": "success" } },

      "box3": { "type": "Section", "props": { "variant": "muted" }, "children": ["clickRow3"] },
      "clickRow3": {
        "type": "Row",
        "props": { "clickable": true, "hover": true },
        "children": ["stat3"],
        "on": { "click": [
          { "action": "setState", "params": { "statePath": "/ui/sel/key",            "value": { "$computed": "identity", "args": { "value": "onboarding" } } } },
          { "action": "setState", "params": { "statePath": "/ui/sel/title",          "value": { "$computed": "identity", "args": { "value": "Onboarding" } } } },
          { "action": "setState", "params": { "statePath": "/ui/sel/show_total",     "value": "" } },
          { "action": "setState", "params": { "statePath": "/ui/sel/show_active",    "value": "" } },
          { "action": "setState", "params": { "statePath": "/ui/sel/show_onboarding","value": { "$computed": "identity", "args": { "value": "1" } } } },
          { "action": "setState", "params": { "statePath": "/ui/sel/show_leave",     "value": "" } }
        ] }
      },
      "stat3": { "type": "Stack",   "props": { "gap": "xs" },        "children": ["lbl3", "val3", "hint3"] },
      "lbl3":  { "type": "Eyebrow", "props": { "text": "Onboarding" } },
      "val3":  { "type": "Heading", "props": { "text": "2",  "size": "xl", "weight": "bold", "tone": "warning" } },
      "hint3": { "type": "Text",    "props": { "text": "pending start",     "size": "xs", "tone": "warning" } },

      "box4": { "type": "Section", "props": { "variant": "muted" }, "children": ["clickRow4"] },
      "clickRow4": {
        "type": "Row",
        "props": { "clickable": true, "hover": true },
        "children": ["stat4"],
        "on": { "click": [
          { "action": "setState", "params": { "statePath": "/ui/sel/key",            "value": { "$computed": "identity", "args": { "value": "leave" } } } },
          { "action": "setState", "params": { "statePath": "/ui/sel/title",          "value": { "$computed": "identity", "args": { "value": "On Leave Today" } } } },
          { "action": "setState", "params": { "statePath": "/ui/sel/show_total",     "value": "" } },
          { "action": "setState", "params": { "statePath": "/ui/sel/show_active",    "value": "" } },
          { "action": "setState", "params": { "statePath": "/ui/sel/show_onboarding","value": "" } },
          { "action": "setState", "params": { "statePath": "/ui/sel/show_leave",     "value": { "$computed": "identity", "args": { "value": "1" } } } }
        ] }
      },
      "stat4": { "type": "Stack",   "props": { "gap": "xs" },        "children": ["lbl4", "val4", "hint4"] },
      "lbl4":  { "type": "Eyebrow", "props": { "text": "On Leave Today" } },
      "val4":  { "type": "Heading", "props": { "text": "3",  "size": "xl", "weight": "bold", "tone": "accent" } },
      "hint4": { "type": "Text",    "props": { "text": "incl. 1 sick",      "size": "xs", "tone": "destructive" } },

      "detailOverlay": {
        "type": "Overlay",
        "props": { "open": true, "maxWidth": "30rem" },
        "visible": { "$state": "/ui/sel/key" },
        "children": ["detailStack"]
      },
      "detailStack": { "type": "Stack", "props": { "gap": "md" }, "children": ["detailHeader", "detailHR", "totalContent", "activeContent", "onboardingContent", "leaveContent"] },

      "detailHeader": { "type": "Row", "props": { "justify": "between", "align": "center" }, "children": ["detailTitle", "detailClose"] },
      "detailTitle":  { "type": "Heading", "props": { "text": { "$state": "/ui/sel/title" }, "level": "h3" } },
      "detailClose":  { "type": "OverlayClose", "props": {}, "on": { "click": { "action": "setState", "params": { "statePath": "/ui/sel/key", "value": "" } } } },
      "detailHR":     { "type": "Divider", "props": {} },

      "totalContent": { "type": "Stack", "props": { "gap": "sm" }, "visible": { "$state": "/ui/sel/show_total" }, "children": ["tR1", "tD1", "tR2", "tD2", "tR3"] },
      "tR1":    { "type": "Row",    "props": { "justify": "between", "align": "center" }, "children": ["tLeft1", "tRight1"] },
      "tLeft1": { "type": "Row",    "props": { "gap": "sm", "align": "center" }, "children": ["tAv1", "tName1"] },
      "tAv1":   { "type": "Avatar", "props": { "initials": "FC", "tone": "accent", "size": "sm" } },
      "tName1": { "type": "Stack",  "props": { "gap": "none" }, "children": ["tN1a", "tN1b"] },
      "tN1a":   { "type": "Text", "props": { "text": "Field Crew", "size": "sm", "weight": "medium" } },
      "tN1b":   { "type": "Text", "props": { "text": "Construction & maintenance", "size": "xs", "tone": "muted" } },
      "tRight1": { "type": "Text", "props": { "text": "16", "size": "sm", "weight": "bold" } },
      "tD1":    { "type": "Divider", "props": {} },

      "tR2":    { "type": "Row",    "props": { "justify": "between", "align": "center" }, "children": ["tLeft2", "tRight2"] },
      "tLeft2": { "type": "Row",    "props": { "gap": "sm", "align": "center" }, "children": ["tAv2", "tName2"] },
      "tAv2":   { "type": "Avatar", "props": { "initials": "OF", "tone": "success", "size": "sm" } },
      "tName2": { "type": "Stack",  "props": { "gap": "none" }, "children": ["tN2a", "tN2b"] },
      "tN2a":   { "type": "Text", "props": { "text": "Office", "size": "sm", "weight": "medium" } },
      "tN2b":   { "type": "Text", "props": { "text": "Admin & payroll", "size": "xs", "tone": "muted" } },
      "tRight2": { "type": "Text", "props": { "text": "5", "size": "sm", "weight": "bold" } },
      "tD2":    { "type": "Divider", "props": {} },

      "tR3":    { "type": "Row",    "props": { "justify": "between", "align": "center" }, "children": ["tLeft3", "tRight3"] },
      "tLeft3": { "type": "Row",    "props": { "gap": "sm", "align": "center" }, "children": ["tAv3", "tName3"] },
      "tAv3":   { "type": "Avatar", "props": { "initials": "MG", "tone": "warning", "size": "sm" } },
      "tName3": { "type": "Stack",  "props": { "gap": "none" }, "children": ["tN3a", "tN3b"] },
      "tN3a":   { "type": "Text", "props": { "text": "Management", "size": "sm", "weight": "medium" } },
      "tN3b":   { "type": "Text", "props": { "text": "Operations", "size": "xs", "tone": "muted" } },
      "tRight3": { "type": "Text", "props": { "text": "3", "size": "sm", "weight": "bold" } },

      "activeContent": { "type": "Stack", "props": { "gap": "sm" }, "visible": { "$state": "/ui/sel/show_active" }, "children": ["aR1", "aD1", "aR2", "aD2", "aR3", "aMore"] },
      "aR1":    { "type": "Row",    "props": { "justify": "between", "align": "center" }, "children": ["aLeft1", "aRight1"] },
      "aLeft1": { "type": "Row",    "props": { "gap": "sm", "align": "center" }, "children": ["aAv1", "aName1"] },
      "aAv1":   { "type": "Avatar", "props": { "initials": "JD", "tone": "accent", "size": "sm" } },
      "aName1": { "type": "Stack",  "props": { "gap": "none" }, "children": ["aN1a", "aN1b"] },
      "aN1a":   { "type": "Text", "props": { "text": "Jye Donnelly", "size": "sm", "weight": "medium" } },
      "aN1b":   { "type": "Text", "props": { "text": "Apprentice 3rd yr", "size": "xs", "tone": "muted" } },
      "aRight1": { "type": "Badge", "props": { "text": "On site", "tone": "success", "variant": "soft" } },
      "aD1":    { "type": "Divider", "props": {} },

      "aR2":    { "type": "Row",    "props": { "justify": "between", "align": "center" }, "children": ["aLeft2", "aRight2"] },
      "aLeft2": { "type": "Row",    "props": { "gap": "sm", "align": "center" }, "children": ["aAv2", "aName2"] },
      "aAv2":   { "type": "Avatar", "props": { "initials": "MK", "tone": "success", "size": "sm" } },
      "aName2": { "type": "Stack",  "props": { "gap": "none" }, "children": ["aN2a", "aN2b"] },
      "aN2a":   { "type": "Text", "props": { "text": "Marcus Kelly", "size": "sm", "weight": "medium" } },
      "aN2b":   { "type": "Text", "props": { "text": "Licensed electrician", "size": "xs", "tone": "muted" } },
      "aRight2": { "type": "Badge", "props": { "text": "On site", "tone": "success", "variant": "soft" } },
      "aD2":    { "type": "Divider", "props": {} },

      "aR3":    { "type": "Row",    "props": { "justify": "between", "align": "center" }, "children": ["aLeft3", "aRight3"] },
      "aLeft3": { "type": "Row",    "props": { "gap": "sm", "align": "center" }, "children": ["aAv3", "aName3"] },
      "aAv3":   { "type": "Avatar", "props": { "initials": "NP", "tone": "accent", "size": "sm" } },
      "aName3": { "type": "Stack",  "props": { "gap": "none" }, "children": ["aN3a", "aN3b"] },
      "aN3a":   { "type": "Text", "props": { "text": "Nathan Park", "size": "sm", "weight": "medium" } },
      "aN3b":   { "type": "Text", "props": { "text": "Site supervisor", "size": "xs", "tone": "muted" } },
      "aRight3": { "type": "Badge", "props": { "text": "On site", "tone": "success", "variant": "soft" } },
      "aMore":  { "type": "Caption", "props": { "text": "+ 19 more active employees" } },

      "onboardingContent": { "type": "Stack", "props": { "gap": "sm" }, "visible": { "$state": "/ui/sel/show_onboarding" }, "children": ["oR1", "oD1", "oR2"] },
      "oR1":    { "type": "Row",    "props": { "justify": "between", "align": "center" }, "children": ["oLeft1", "oRight1"] },
      "oLeft1": { "type": "Row",    "props": { "gap": "sm", "align": "center" }, "children": ["oAv1", "oName1"] },
      "oAv1":   { "type": "Avatar", "props": { "initials": "LT", "tone": "accent", "size": "sm" } },
      "oName1": { "type": "Stack",  "props": { "gap": "none" }, "children": ["oN1a", "oN1b"] },
      "oN1a":   { "type": "Text", "props": { "text": "Liam Tran", "size": "sm", "weight": "medium" } },
      "oN1b":   { "type": "Text", "props": { "text": "Electrical apprentice", "size": "xs", "tone": "muted" } },
      "oRight1": { "type": "Text", "props": { "text": "Starts 7 Jul", "size": "xs", "tone": "muted" } },
      "oD1":    { "type": "Divider", "props": {} },

      "oR2":    { "type": "Row",    "props": { "justify": "between", "align": "center" }, "children": ["oLeft2", "oRight2"] },
      "oLeft2": { "type": "Row",    "props": { "gap": "sm", "align": "center" }, "children": ["oAv2", "oName2"] },
      "oAv2":   { "type": "Avatar", "props": { "initials": "GO", "tone": "success", "size": "sm" } },
      "oName2": { "type": "Stack",  "props": { "gap": "none" }, "children": ["oN2a", "oN2b"] },
      "oN2a":   { "type": "Text", "props": { "text": "Grace Osei", "size": "sm", "weight": "medium" } },
      "oN2b":   { "type": "Text", "props": { "text": "Office admin", "size": "xs", "tone": "muted" } },
      "oRight2": { "type": "Text", "props": { "text": "Starts 14 Jul", "size": "xs", "tone": "muted" } },

      "leaveContent": { "type": "Stack", "props": { "gap": "sm" }, "visible": { "$state": "/ui/sel/show_leave" }, "children": ["lR1", "lD1", "lR2", "lD2", "lR3"] },
      "lR1":    { "type": "Row",    "props": { "justify": "between", "align": "center" }, "children": ["lLeft1", "lRight1"] },
      "lLeft1": { "type": "Row",    "props": { "gap": "sm", "align": "center" }, "children": ["lAv1", "lName1"] },
      "lAv1":   { "type": "Avatar", "props": { "initials": "TW", "tone": "warning", "size": "sm" } },
      "lName1": { "type": "Stack",  "props": { "gap": "none" }, "children": ["lN1a", "lN1b"] },
      "lN1a":   { "type": "Text", "props": { "text": "Tash Williams", "size": "sm", "weight": "medium" } },
      "lN1b":   { "type": "Text", "props": { "text": "Office / admin", "size": "xs", "tone": "muted" } },
      "lRight1": { "type": "Badge", "props": { "text": "Annual", "tone": "warning", "variant": "soft" } },
      "lD1":    { "type": "Divider", "props": {} },

      "lR2":    { "type": "Row",    "props": { "justify": "between", "align": "center" }, "children": ["lLeft2", "lRight2"] },
      "lLeft2": { "type": "Row",    "props": { "gap": "sm", "align": "center" }, "children": ["lAv2", "lName2"] },
      "lAv2":   { "type": "Avatar", "props": { "initials": "BH", "tone": "accent", "size": "sm" } },
      "lName2": { "type": "Stack",  "props": { "gap": "none" }, "children": ["lN2a", "lN2b"] },
      "lN2a":   { "type": "Text", "props": { "text": "Brad Harris", "size": "sm", "weight": "medium" } },
      "lN2b":   { "type": "Text", "props": { "text": "Senior electrician", "size": "xs", "tone": "muted" } },
      "lRight2": { "type": "Badge", "props": { "text": "Sick", "tone": "destructive", "variant": "soft" } },
      "lD2":    { "type": "Divider", "props": {} },

      "lR3":    { "type": "Row",    "props": { "justify": "between", "align": "center" }, "children": ["lLeft3", "lRight3"] },
      "lLeft3": { "type": "Row",    "props": { "gap": "sm", "align": "center" }, "children": ["lAv3", "lName3"] },
      "lAv3":   { "type": "Avatar", "props": { "initials": "SC", "tone": "success", "size": "sm" } },
      "lName3": { "type": "Stack",  "props": { "gap": "none" }, "children": ["lN3a", "lN3b"] },
      "lN3a":   { "type": "Text", "props": { "text": "Sarah Connell", "size": "sm", "weight": "medium" } },
      "lN3b":   { "type": "Text", "props": { "text": "Project support", "size": "xs", "tone": "muted" } },
      "lRight3": { "type": "Badge", "props": { "text": "Carer's", "tone": "accent", "variant": "soft" } }

    }
  },
  "status": "published"
}
