{
  "id": "employment-hero-out-this-week",
  "title": "Out This Week",
  "description": "Live view of employees on approved leave for each day of the current week from Employment Hero.",
  "category": "hr",
  "tags": ["employment-hero", "hr", "leave", "absence", "calendar"],
  "keywords": ["out", "leave", "absence", "this week", "calendar", "employment hero"],
  "connectorsUsed": ["employment-hero"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 8, "rowSpan": 4 },
    "min":       { "colSpan": 6, "rowSpan": 3 },
    "max":       { "colSpan": 12, "rowSpan": 6 }
  },
  "dataProvider": {
    "mcp": "employment-hero",
    "tool": "get_leave_this_week",
    "params": {}
  },
  "spec": {
    "root": "card",
    "elements": {

      "card": {
        "type": "Card",
        "props": {},
        "children": ["loading", "empty", "content"]
      },

      "loading": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["s1", "s2"],
        "visible": { "$state": "/_loading/employment-hero.get_leave_this_week" }
      },
      "s1": { "type": "Skeleton", "props": { "height": "1.5rem", "rounded": "md" } },
      "s2": { "type": "Skeleton", "props": { "height": "4rem",   "rounded": "md" } },

      "empty": {
        "type": "Empty",
        "props": { "message": "No one on leave this week." },
        "visible": {
          "$and": [
            { "$state": "/_loading/employment-hero.get_leave_this_week", "not": true },
            { "$state": "/employment-hero/get_leave_this_week/total", "not": true }
          ]
        }
      },

      "content": {
        "type": "Stack",
        "props": { "gap": "md" },
        "children": ["eyebrow", "days"],
        "visible": { "$state": "/_loading/employment-hero.get_leave_this_week", "not": true }
      },

      "eyebrow": { "type": "Eyebrow", "props": { "text": "Out This Week" } },

      "days": {
        "type": "Row",
        "props": { "justify": "between", "align": "start" },
        "children": ["monCol", "tueCol", "wedCol", "thuCol", "friCol"]
      },

      "monCol": { "type": "Stack", "props": { "gap": "xs", "align": "center" }, "children": ["monLabel", "monAvatars", "monCount"] },
      "monLabel": { "type": "Eyebrow", "props": { "text": "MON" } },
      "monAvatars": { "type": "Row", "props": { "gap": "none", "align": "center" }, "children": ["monA1", "monA2", "monOverflow"] },
      "monA1": { "type": "Avatar", "props": { "initials": { "$state": "/employment-hero/get_leave_this_week/mon/a1/initials" }, "name": { "$state": "/employment-hero/get_leave_this_week/mon/a1/name" }, "size": "sm" }, "visible": { "$state": "/employment-hero/get_leave_this_week/mon/a1" } },
      "monA2": { "type": "Avatar", "props": { "initials": { "$state": "/employment-hero/get_leave_this_week/mon/a2/initials" }, "name": { "$state": "/employment-hero/get_leave_this_week/mon/a2/name" }, "size": "sm" }, "visible": { "$state": "/employment-hero/get_leave_this_week/mon/a2" } },
      "monOverflow": { "type": "Badge", "props": { "text": { "$computed": "fmt", "args": { "pattern": "+{n}", "n": { "$state": "/employment-hero/get_leave_this_week/mon/overflow" } } }, "tone": "default", "variant": "soft" }, "visible": { "$state": "/employment-hero/get_leave_this_week/mon/overflow" } },
      "monCount": { "type": "Text", "props": { "text": { "$state": "/employment-hero/get_leave_this_week/mon/count" }, "size": "sm", "tone": "muted" }, "visible": { "$state": "/employment-hero/get_leave_this_week/mon/count" } },

      "tueCol": { "type": "Stack", "props": { "gap": "xs", "align": "center" }, "children": ["tueLabel", "tueAvatars", "tueCount"] },
      "tueLabel": { "type": "Eyebrow", "props": { "text": "TUE" } },
      "tueAvatars": { "type": "Row", "props": { "gap": "none", "align": "center" }, "children": ["tueA1", "tueA2", "tueOverflow"] },
      "tueA1": { "type": "Avatar", "props": { "initials": { "$state": "/employment-hero/get_leave_this_week/tue/a1/initials" }, "name": { "$state": "/employment-hero/get_leave_this_week/tue/a1/name" }, "size": "sm" }, "visible": { "$state": "/employment-hero/get_leave_this_week/tue/a1" } },
      "tueA2": { "type": "Avatar", "props": { "initials": { "$state": "/employment-hero/get_leave_this_week/tue/a2/initials" }, "name": { "$state": "/employment-hero/get_leave_this_week/tue/a2/name" }, "size": "sm" }, "visible": { "$state": "/employment-hero/get_leave_this_week/tue/a2" } },
      "tueOverflow": { "type": "Badge", "props": { "text": { "$computed": "fmt", "args": { "pattern": "+{n}", "n": { "$state": "/employment-hero/get_leave_this_week/tue/overflow" } } }, "tone": "default", "variant": "soft" }, "visible": { "$state": "/employment-hero/get_leave_this_week/tue/overflow" } },
      "tueCount": { "type": "Text", "props": { "text": { "$state": "/employment-hero/get_leave_this_week/tue/count" }, "size": "sm", "tone": "muted" }, "visible": { "$state": "/employment-hero/get_leave_this_week/tue/count" } },

      "wedCol": { "type": "Stack", "props": { "gap": "xs", "align": "center" }, "children": ["wedLabel", "wedAvatars", "wedCount"] },
      "wedLabel": { "type": "Eyebrow", "props": { "text": "WED" } },
      "wedAvatars": { "type": "Row", "props": { "gap": "none", "align": "center" }, "children": ["wedA1", "wedA2", "wedOverflow"] },
      "wedA1": { "type": "Avatar", "props": { "initials": { "$state": "/employment-hero/get_leave_this_week/wed/a1/initials" }, "name": { "$state": "/employment-hero/get_leave_this_week/wed/a1/name" }, "size": "sm" }, "visible": { "$state": "/employment-hero/get_leave_this_week/wed/a1" } },
      "wedA2": { "type": "Avatar", "props": { "initials": { "$state": "/employment-hero/get_leave_this_week/wed/a2/initials" }, "name": { "$state": "/employment-hero/get_leave_this_week/wed/a2/name" }, "size": "sm" }, "visible": { "$state": "/employment-hero/get_leave_this_week/wed/a2" } },
      "wedOverflow": { "type": "Badge", "props": { "text": { "$computed": "fmt", "args": { "pattern": "+{n}", "n": { "$state": "/employment-hero/get_leave_this_week/wed/overflow" } } }, "tone": "default", "variant": "soft" }, "visible": { "$state": "/employment-hero/get_leave_this_week/wed/overflow" } },
      "wedCount": { "type": "Text", "props": { "text": { "$state": "/employment-hero/get_leave_this_week/wed/count" }, "size": "sm", "tone": "muted" }, "visible": { "$state": "/employment-hero/get_leave_this_week/wed/count" } },

      "thuCol": { "type": "Stack", "props": { "gap": "xs", "align": "center" }, "children": ["thuLabel", "thuAvatars", "thuCount"] },
      "thuLabel": { "type": "Eyebrow", "props": { "text": "THU" } },
      "thuAvatars": { "type": "Row", "props": { "gap": "none", "align": "center" }, "children": ["thuA1", "thuA2", "thuOverflow"] },
      "thuA1": { "type": "Avatar", "props": { "initials": { "$state": "/employment-hero/get_leave_this_week/thu/a1/initials" }, "name": { "$state": "/employment-hero/get_leave_this_week/thu/a1/name" }, "size": "sm" }, "visible": { "$state": "/employment-hero/get_leave_this_week/thu/a1" } },
      "thuA2": { "type": "Avatar", "props": { "initials": { "$state": "/employment-hero/get_leave_this_week/thu/a2/initials" }, "name": { "$state": "/employment-hero/get_leave_this_week/thu/a2/name" }, "size": "sm" }, "visible": { "$state": "/employment-hero/get_leave_this_week/thu/a2" } },
      "thuOverflow": { "type": "Badge", "props": { "text": { "$computed": "fmt", "args": { "pattern": "+{n}", "n": { "$state": "/employment-hero/get_leave_this_week/thu/overflow" } } }, "tone": "default", "variant": "soft" }, "visible": { "$state": "/employment-hero/get_leave_this_week/thu/overflow" } },
      "thuCount": { "type": "Text", "props": { "text": { "$state": "/employment-hero/get_leave_this_week/thu/count" }, "size": "sm", "tone": "muted" }, "visible": { "$state": "/employment-hero/get_leave_this_week/thu/count" } },

      "friCol": { "type": "Stack", "props": { "gap": "xs", "align": "center" }, "children": ["friLabel", "friAvatars", "friCount"] },
      "friLabel": { "type": "Eyebrow", "props": { "text": "FRI" } },
      "friAvatars": { "type": "Row", "props": { "gap": "none", "align": "center" }, "children": ["friA1", "friA2", "friOverflow"] },
      "friA1": { "type": "Avatar", "props": { "initials": { "$state": "/employment-hero/get_leave_this_week/fri/a1/initials" }, "name": { "$state": "/employment-hero/get_leave_this_week/fri/a1/name" }, "size": "sm" }, "visible": { "$state": "/employment-hero/get_leave_this_week/fri/a1" } },
      "friA2": { "type": "Avatar", "props": { "initials": { "$state": "/employment-hero/get_leave_this_week/fri/a2/initials" }, "name": { "$state": "/employment-hero/get_leave_this_week/fri/a2/name" }, "size": "sm" }, "visible": { "$state": "/employment-hero/get_leave_this_week/fri/a2" } },
      "friOverflow": { "type": "Badge", "props": { "text": { "$computed": "fmt", "args": { "pattern": "+{n}", "n": { "$state": "/employment-hero/get_leave_this_week/fri/overflow" } } }, "tone": "default", "variant": "soft" }, "visible": { "$state": "/employment-hero/get_leave_this_week/fri/overflow" } },
      "friCount": { "type": "Text", "props": { "text": { "$state": "/employment-hero/get_leave_this_week/fri/count" }, "size": "sm", "tone": "muted" }, "visible": { "$state": "/employment-hero/get_leave_this_week/fri/count" } }

    }
  },
  "status": "published"
}
