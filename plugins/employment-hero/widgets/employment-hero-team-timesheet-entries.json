{
  "id": "employment-hero-team-timesheet-entries",
  "title": "Team Timesheet This Week",
  "description": "Hours logged by each person this week, most hours first, with a bar comparing each against whoever logged the most. The three figures across the top give the team total, how many people have logged anything at all and the average each. The week shown is the one the connector queried, so the dates and the entries can never disagree.",
  "category": "hr",
  "tags": ["employment-hero", "hr", "timesheets", "team", "weekly", "manager"],
  "keywords": ["team timesheet", "hours", "this week", "entries", "work hours", "hours logged", "weekly total", "employment hero"],
  "connectorsUsed": ["employment-hero"],
  "popularity": 0,
  "branding": { "color": "#7b61ff" },
  "brandColor": "#7b61ff",
  "sizing": {
    "preferred": { "colSpan": 5, "rowSpan": 6 },
    "min":       { "colSpan": 4, "rowSpan": 3 },
    "max":       { "colSpan": 10, "rowSpan": 12 }
  },
  "dataProvider": {
    "mcp": "employment-hero",
    "tool": "get_timesheets_this_week",
    "params": {}
  },
  "spec": {
    "root": "card",
    "elements": {

      "card": {
        "type": "Card",
        "props": {},
        "children": ["header", "loading", "weekRow", "kpiGrid", "emptyPanel", "body", "footer"],
        "watch": {
          "/employment-hero/get_timesheets_this_week/data/items": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/board",
                "value": {
                  "$computed": "employment-hero_team_timesheet_board",
                  "args": {
                    "value": { "$state": "/employment-hero/get_timesheets_this_week/data/items" },
                    "start": { "$state": "/employment-hero/get_timesheets_this_week/data/period_start" },
                    "end":   { "$state": "/employment-hero/get_timesheets_this_week/data/period_end" }
                  }
                }
              }
            }
          ]
        }
      },

      "header": { "type": "Header", "props": {}, "children": ["titleGroup"] },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "start" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": { "type": "Icon", "props": { "name": "Users", "tone": "brand", "size": "sm" } },
      "titleStack": { "type": "Stack", "props": { "gap": "none" }, "children": ["title", "eyebrow"] },
      "title": { "type": "Heading", "props": { "text": "Team Timesheet This Week", "level": "h2" } },
      "eyebrow": { "type": "Eyebrow", "props": { "text": "EMPLOYMENT HERO" } },

      "loading": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["skKpi", "skRow1", "skRow2", "skRow3"],
        "visible": { "$state": "/_loading/employment-hero.get_timesheets_this_week" }
      },
      "skKpi":  { "type": "Skeleton", "props": { "height": "3.5rem", "rounded": "md" } },
      "skRow1": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "skRow2": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "skRow3": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },

      "weekRow": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center", "justify": "between" },
        "children": ["weekPill", "awaitingBadge"],
        "visible": { "$state": "/_loading/employment-hero.get_timesheets_this_week", "not": true }
      },
      "weekPill": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["weekIcon", "weekLabel"]
      },
      "weekIcon": { "type": "Icon", "props": { "name": "CalendarRange", "tone": "muted", "size": "xs" } },
      "weekLabel": { "type": "Caption", "props": { "tone": "muted", "text": { "$state": "/ui/board/week_label" } } },
      "awaitingBadge": {
        "type": "Badge",
        "props": { "text": { "$state": "/ui/board/awaiting_label" }, "tone": "warning", "variant": "soft" },
        "visible": { "$state": "/ui/board/has_awaiting" }
      },

      "kpiGrid": {
        "type": "Grid",
        "props": { "cols": 3, "gap": "sm" },
        "children": ["kpiTotal", "kpiPeople", "kpiAvg"],
        "visible": {
          "$and": [
            { "$state": "/_loading/employment-hero.get_timesheets_this_week", "not": true },
            { "$state": "/ui/board/has_rows" }
          ]
        }
      },

      "kpiTotal": { "type": "Section", "props": { "variant": "muted" }, "children": ["kpiTotalStack"] },
      "kpiTotalStack": { "type": "Stack", "props": { "gap": "xs" }, "children": ["kpiTotalHead", "kpiTotalValue"] },
      "kpiTotalHead": { "type": "Row", "props": { "gap": "sm", "align": "center" }, "children": ["kpiTotalDot", "kpiTotalLabel"] },
      "kpiTotalDot": { "type": "Dot", "props": { "tone": "brand", "size": "sm" } },
      "kpiTotalLabel": { "type": "Eyebrow", "props": { "text": "TOTAL HOURS" } },
      "kpiTotalValue": { "type": "Heading", "props": { "level": "h1", "text": { "$state": "/ui/board/total_value" } } },

      "kpiPeople": { "type": "Section", "props": { "variant": "muted" }, "children": ["kpiPeopleStack"] },
      "kpiPeopleStack": { "type": "Stack", "props": { "gap": "xs" }, "children": ["kpiPeopleHead", "kpiPeopleValue"] },
      "kpiPeopleHead": { "type": "Row", "props": { "gap": "sm", "align": "center" }, "children": ["kpiPeopleDot", "kpiPeopleLabel"] },
      "kpiPeopleDot": { "type": "Dot", "props": { "tone": "info", "size": "sm" } },
      "kpiPeopleLabel": { "type": "Eyebrow", "props": { "text": "PEOPLE" } },
      "kpiPeopleValue": { "type": "Heading", "props": { "level": "h1", "text": { "$state": "/ui/board/people_count" } } },

      "kpiAvg": { "type": "Section", "props": { "variant": "muted" }, "children": ["kpiAvgStack"] },
      "kpiAvgStack": { "type": "Stack", "props": { "gap": "xs" }, "children": ["kpiAvgHead", "kpiAvgValue"] },
      "kpiAvgHead": { "type": "Row", "props": { "gap": "sm", "align": "center" }, "children": ["kpiAvgDot", "kpiAvgLabel"] },
      "kpiAvgDot": { "type": "Dot", "props": { "tone": "success", "size": "sm" } },
      "kpiAvgLabel": { "type": "Eyebrow", "props": { "text": "AVG EACH" } },
      "kpiAvgValue": { "type": "Heading", "props": { "level": "h1", "text": { "$state": "/ui/board/avg_value" } } },

      "body": { "type": "Body", "props": {}, "children": ["list"] },

      "list": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["personRow"],
        "repeat": { "statePath": "/ui/board/rows", "key": "id" },
        "visible": {
          "$and": [
            { "$state": "/_loading/employment-hero.get_timesheets_this_week", "not": true },
            { "$state": "/ui/board/has_rows" }
          ]
        }
      },

      "personRow": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center", "hover": true, "template": "2rem minmax(0, 1fr) 3.5rem" },
        "children": ["personAvatar", "personIdentity", "personHours"]
      },
      "personAvatar": {
        "type": "Avatar",
        "props": { "initials": { "$item": "initials" }, "tone": "brand", "size": "md" }
      },
      "personIdentity": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["personName", "personBarRow"]
      },
      "personName": {
        "type": "Text",
        "props": { "text": { "$item": "employee_name" }, "size": "sm", "weight": "medium", "truncate": true }
      },
      "personBarRow": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["personBar", "personDays"]
      },
      "personBar": {
        "type": "ProgressBar",
        "props": { "value": { "$item": "pct" }, "tone": "brand" }
      },
      "personDays": { "type": "Caption", "props": { "tone": "muted", "text": { "$item": "days_note" } } },

      "personHours": {
        "type": "Stack",
        "props": { "gap": "none", "align": "end" },
        "children": ["personHoursValue", "personHoursLabel"]
      },
      "personHoursValue": {
        "type": "Heading",
        "props": { "level": "h1", "text": { "$item": "hours_value" } }
      },
      "personHoursLabel": { "type": "Caption", "props": { "tone": "muted", "text": "hrs" } },

      "emptyPanel": {
        "type": "Section",
        "props": { "variant": "bordered" },
        "children": ["emptyStack"],
        "visible": {
          "$and": [
            { "$state": "/_loading/employment-hero.get_timesheets_this_week", "not": true },
            { "$state": "/ui/board/has_rows", "not": true }
          ]
        }
      },
      "emptyStack": {
        "type": "Stack",
        "props": { "gap": "sm", "align": "center" },
        "children": ["emptyIcon", "emptyTitle", "emptyNote"]
      },
      "emptyIcon": { "type": "Icon", "props": { "name": "Clock", "tone": "brand", "size": "lg" } },
      "emptyTitle": { "type": "Text", "props": { "text": "No timesheet entries this week", "size": "sm", "weight": "medium" } },
      "emptyNote": { "type": "Caption", "props": { "tone": "muted", "text": "Hours your team logs this week will show here, per person, with a weekly total." } },

      "footer": {
        "type": "Row",
        "props": { "justify": "center" },
        "children": ["footerText"],
        "visible": {
          "$and": [
            { "$state": "/_loading/employment-hero.get_timesheets_this_week", "not": true },
            { "$state": "/ui/board/has_rows" }
          ]
        }
      },
      "footerText": {
        "type": "Caption",
        "props": { "tone": "muted", "text": "Bars compare each person with the highest this week" }
      }

    }
  },
  "status": "published"
}
