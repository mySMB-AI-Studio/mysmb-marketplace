{
  "id": "employment-hero-team-timesheet-entries",
  "title": "Team Timesheet This Week",
  "description": "All timesheet entries for the current work week across your organisation, grouped by employee with total hours and approval status.",
  "category": "hr",
  "tags": ["employment-hero", "hr", "timesheets", "team", "weekly", "manager"],
  "keywords": ["team timesheet", "hours", "this week", "entries", "work hours", "employment hero"],
  "connectorsUsed": ["employment-hero"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 5, "rowSpan": 8 },
    "min":       { "colSpan": 4, "rowSpan": 6 },
    "max":       { "colSpan": 10, "rowSpan": 14 }
  },
  "dataProvider": {
    "mcp": "employment-hero",
    "tool": "get_timesheets_this_week",
    "params": {}
  },
  "spec": {
    "root": "card",
    "elements": {

      "card": {
        "type": "Card",
        "props": {},
        "children": ["header", "body"],
        "watch": {
          "/employment-hero/get_timesheets_this_week/data/items": [
            { "action": "setState", "params": { "statePath": "/ui/entryRows", "value": { "$computed": "employment-hero_flatten_team_timesheet_entries", "args": { "value": { "$state": "/employment-hero/get_timesheets_this_week/data/items" } } } } }
          ]
        }
      },

      "header": { "type": "Header", "props": {}, "children": ["headerRow"] },
      "headerRow": { "type": "Row", "props": { "align": "center", "template": "1fr auto" }, "children": ["titleGroup"] },
      "titleGroup": { "type": "Row", "props": { "gap": "sm", "align": "start" }, "children": ["titleIcon", "titleStack"] },
      "titleIcon": { "type": "Icon", "props": { "name": "Users", "tone": "accent", "size": "sm" } },
      "titleStack": { "type": "Stack", "props": { "gap": "none" }, "children": ["title", "eyebrow"] },
      "title": { "type": "Heading", "props": { "text": "Team Timesheet This Week", "level": "h2" } },
      "eyebrow": { "type": "Eyebrow", "props": { "text": "Employment Hero" } },

      "body": { "type": "Body", "props": {}, "children": ["loading", "empty", "contentArea"] },

      "loading": {
        "type": "Stack", "props": { "gap": "sm" },
        "children": ["sk1", "sk2", "sk3"],
        "visible": { "$state": "/_loading/employment-hero.get_timesheets_this_week" }
      },
      "sk1": { "type": "Skeleton", "props": { "height": "4rem", "rounded": "md" } },
      "sk2": { "type": "Skeleton", "props": { "height": "4rem", "rounded": "md" } },
      "sk3": { "type": "Skeleton", "props": { "height": "4rem", "rounded": "md" } },

      "empty": {
        "type": "Empty",
        "props": { "message": "No timesheet entries this week." },
        "visible": {
          "$and": [
            { "$state": "/_loading/employment-hero.get_timesheets_this_week", "not": true },
            { "$state": "/ui/entryRows/0", "not": true }
          ]
        }
      },

      "contentArea": {
        "type": "Stack", "props": { "gap": "md" },
        "children": ["periodText", "statsRow", "list"],
        "visible": {
          "$and": [
            { "$state": "/_loading/employment-hero.get_timesheets_this_week", "not": true },
            { "$state": "/ui/entryRows/0" }
          ]
        }
      },

      "periodText": {
        "type": "Caption",
        "props": { "text": { "$state": "/ui/entryRows/0/period_range" } }
      },

      "statsRow": {
        "type": "Row", "props": { "gap": "sm", "template": "1fr 1fr 1fr" },
        "children": ["statPending", "statApproved", "statOverdue"]
      },

      "statPending": { "type": "Section", "props": { "variant": "muted" }, "children": ["statPendingInner"] },
      "statPendingInner": { "type": "Stack", "props": { "gap": "none" }, "children": ["statPendingLabel", "statPendingCount"] },
      "statPendingLabel": { "type": "Eyebrow", "props": { "text": "PENDING" } },
      "statPendingCount": { "type": "Heading", "props": { "text": { "$state": "/ui/entryRows/0/stat_pending" }, "level": "h2" } },

      "statApproved": { "type": "Section", "props": { "variant": "muted" }, "children": ["statApprovedInner"] },
      "statApprovedInner": { "type": "Stack", "props": { "gap": "none" }, "children": ["statApprovedLabel", "statApprovedCount"] },
      "statApprovedLabel": { "type": "Eyebrow", "props": { "text": "APPROVED" } },
      "statApprovedCount": { "type": "Heading", "props": { "text": { "$state": "/ui/entryRows/0/stat_approved" }, "level": "h2", "tone": "success" } },

      "statOverdue": { "type": "Section", "props": { "variant": "muted" }, "children": ["statOverdueInner"] },
      "statOverdueInner": { "type": "Stack", "props": { "gap": "none" }, "children": ["statOverdueLabel", "statOverdueCount"] },
      "statOverdueLabel": { "type": "Eyebrow", "props": { "text": "OVERDUE" } },
      "statOverdueCount": { "type": "Heading", "props": { "text": { "$state": "/ui/entryRows/0/stat_overdue" }, "level": "h2", "tone": "destructive" } },

      "list": {
        "type": "Stack", "props": { "gap": "xs" },
        "children": ["entryRow"],
        "repeat": { "statePath": "/ui/entryRows", "key": "id" }
      },

      "entryRow": {
        "type": "Stack", "props": { "gap": "xs" },
        "children": ["entryContent", "entryDivider"]
      },
      "entryContent": {
        "type": "Row", "props": { "justify": "between", "align": "start" },
        "children": ["entryLeft", "statusBadge"]
      },
      "entryLeft": {
        "type": "Stack", "props": { "gap": "none" },
        "children": ["requestorLabel", "employeeName", "hoursCaption", "reviewRow"]
      },
      "requestorLabel": { "type": "Eyebrow", "props": { "text": "REQUESTOR" } },
      "employeeName": {
        "type": "Text",
        "props": { "text": { "$item": "employee_name" }, "size": "sm", "weight": "semibold", "truncate": true }
      },
      "hoursCaption": {
        "type": "Caption",
        "props": { "text": { "$item": "hours_this_week" } }
      },
      "reviewRow": {
        "type": "Row",
        "props": { "align": "center", "clickable": true },
        "children": ["reviewCaption"],
        "visible": { "$item": "show_review_link" },
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "url": { "$computed": "identity", "args": { "value": { "$item": "review_url" } } },
              "target": "_blank"
            }
          }
        }
      },
      "reviewCaption": {
        "type": "Caption",
        "props": { "text": "Review in Employment Hero →", "tone": "accent" }
      },
      "statusBadge": {
        "type": "Badge",
        "props": {
          "text": { "$item": "status_label" },
          "tone": { "$item": "status_tone" },
          "variant": "soft"
        }
      },
      "entryDivider": { "type": "Divider", "props": {} }

    }
  },
  "status": "published"
}
