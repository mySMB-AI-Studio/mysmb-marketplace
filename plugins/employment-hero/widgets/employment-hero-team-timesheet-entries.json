{
  "id": "employment-hero-team-timesheet-entries",
  "title": "Team Timesheet This Week",
  "description": "All timesheet entries for the current work week across your organisation, with employee name, date, hours, and approval status.",
  "category": "hr",
  "tags": ["employment-hero", "hr", "timesheets", "team", "weekly", "manager"],
  "keywords": ["team timesheet", "hours", "this week", "entries", "work hours", "employment hero"],
  "connectorsUsed": ["employment-hero"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 5, "rowSpan": 8 },
    "min":       { "colSpan": 4, "rowSpan": 6 },
    "max":       { "colSpan": 10, "rowSpan": 14 }
  },
  "dataProvider": {
    "mcp": "employment-hero",
    "tool": "get_timesheets_this_week",
    "params": {}
  },
  "spec": {
    "root": "card",
    "elements": {

      "card": {
        "type": "Card",
        "props": {},
        "children": ["header", "body", "footer"],
        "watch": {
          "/employment-hero/get_timesheets_this_week/data/items": [
            { "action": "setState", "params": { "statePath": "/ui/entryRows", "value": { "$computed": "employment-hero_flatten_team_timesheet_entries", "args": { "value": { "$state": "/employment-hero/get_timesheets_this_week/data/items" } } } } }
          ]
        }
      },

      "header": { "type": "Header", "props": {}, "children": ["headerRow"] },
      "headerRow": { "type": "Row", "props": { "align": "center", "template": "1fr auto" }, "children": ["titleGroup"] },
      "titleGroup": { "type": "Row", "props": { "gap": "sm", "align": "start" }, "children": ["titleIcon", "titleStack"] },
      "titleIcon": { "type": "Icon", "props": { "name": "Users", "tone": "accent", "size": "sm" } },
      "titleStack": { "type": "Stack", "props": { "gap": "none" }, "children": ["title", "eyebrow"] },
      "title": { "type": "Heading", "props": { "text": "Team Timesheet This Week", "level": "h2" } },
      "eyebrow": { "type": "Eyebrow", "props": { "text": "Employment Hero" } },

      "body": { "type": "Body", "props": {}, "children": ["loading", "empty", "list"] },

      "loading": {
        "type": "Stack", "props": { "gap": "sm" },
        "children": ["sk1", "sk2", "sk3"],
        "visible": { "$state": "/_loading/employment-hero.get_timesheets_this_week" }
      },
      "sk1": { "type": "Skeleton", "props": { "height": "4rem", "rounded": "md" } },
      "sk2": { "type": "Skeleton", "props": { "height": "4rem", "rounded": "md" } },
      "sk3": { "type": "Skeleton", "props": { "height": "4rem", "rounded": "md" } },

      "empty": {
        "type": "Empty",
        "props": { "message": "No timesheet entries this week." },
        "visible": {
          "$and": [
            { "$state": "/_loading/employment-hero.get_timesheets_this_week", "not": true },
            { "$state": "/ui/entryRows/0", "not": true }
          ]
        }
      },

      "list": {
        "type": "Stack", "props": { "gap": "xs" },
        "children": ["entryRow"],
        "repeat": { "statePath": "/ui/entryRows", "key": "id" },
        "visible": {
          "$and": [
            { "$state": "/_loading/employment-hero.get_timesheets_this_week", "not": true },
            { "$state": "/ui/entryRows/0" }
          ]
        }
      },

      "entryRow": {
        "type": "Stack", "props": { "gap": "xs" },
        "children": ["entryRowContent", "entryDivider"]
      },
      "entryRowContent": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["entryLeft", "entryRight"]
      },
      "entryLeft": {
        "type": "Stack", "props": { "gap": "none" },
        "children": ["employeeName", "dateCaption"]
      },
      "employeeName": {
        "type": "Text",
        "props": { "text": { "$item": "employee_name" }, "size": "sm", "weight": "semibold", "truncate": true }
      },
      "dateCaption": {
        "type": "Caption",
        "props": { "text": { "$item": "date_caption" } }
      },
      "entryRight": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["hoursBadge", "statusBadge"]
      },
      "hoursBadge": {
        "type": "Badge",
        "props": {
          "text": { "$item": "hours_display" },
          "tone": "default",
          "variant": "soft"
        }
      },
      "statusBadge": {
        "type": "Badge",
        "props": {
          "text": { "$item": "status_label" },
          "tone": { "$item": "status_tone" },
          "variant": "soft"
        }
      },
      "entryDivider": { "type": "Divider", "props": {} },

      "footer": {
        "type": "Row", "props": { "justify": "center" },
        "children": ["footerText"],
        "visible": {
          "$and": [
            { "$state": "/_loading/employment-hero.get_timesheets_this_week", "not": true },
            { "$state": "/ui/entryRows/0" }
          ]
        }
      },
      "footerText": {
        "type": "Caption",
        "props": { "text": "All entries this week · Employment Hero" }
      }

    }
  },
  "status": "published"
}
