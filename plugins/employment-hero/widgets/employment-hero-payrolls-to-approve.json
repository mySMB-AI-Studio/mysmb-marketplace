{
  "id": "employment-hero-payrolls-to-approve",
  "title": "Payrolls to Approve",
  "description": "Pending timesheet entries grouped by employee, awaiting payroll approval in Employment Hero.",
  "category": "hr",
  "tags": ["employment-hero", "hr", "payroll", "timesheets", "approve"],
  "keywords": ["payroll", "timesheets", "approve", "pending", "hours", "employment hero"],
  "connectorsUsed": ["employment-hero"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 5, "rowSpan": 7 },
    "min":       { "colSpan": 4, "rowSpan": 5 },
    "max":       { "colSpan": 10, "rowSpan": 12 }
  },
  "dataProvider": {
    "mcp": "employment-hero",
    "tool": "list_pending_timesheets_by_employee",
    "params": {}
  },
  "spec": {
    "root": "card",
    "elements": {

      "card": {
        "type": "Card",
        "props": {},
        "children": ["header", "body", "footer"],
        "watch": {
          "/employment-hero/list_pending_timesheets_by_employee/data/items": [
            { "action": "setState", "params": { "statePath": "/ui/timesheetRows", "value": { "$computed": "employment-hero_flatten_timesheets_to_approve", "args": { "value": { "$state": "/employment-hero/list_pending_timesheets_by_employee/data/items" } } } } }
          ]
        }
      },

      "header": { "type": "Header", "props": {}, "children": ["headerRow"] },
      "headerRow": { "type": "Row", "props": { "align": "center", "template": "1fr auto" }, "children": ["titleGroup"] },
      "titleGroup": { "type": "Row", "props": { "gap": "sm", "align": "start" }, "children": ["titleIcon", "titleStack"] },
      "titleIcon": { "type": "Icon", "props": { "name": "ReceiptText", "tone": "accent", "size": "sm" } },
      "titleStack": { "type": "Stack", "props": { "gap": "none" }, "children": ["title", "eyebrow"] },
      "title": { "type": "Heading", "props": { "text": "Payrolls to Approve", "level": "h2" } },
      "eyebrow": { "type": "Eyebrow", "props": { "text": "Employment Hero" } },

      "body": { "type": "Body", "props": {}, "children": ["loading", "empty", "list"] },

      "loading": {
        "type": "Stack", "props": { "gap": "sm" },
        "children": ["sk1", "sk2", "sk3"],
        "visible": { "$state": "/_loading/employment-hero.list_pending_timesheets_by_employee" }
      },
      "sk1": { "type": "Skeleton", "props": { "height": "3rem", "rounded": "md" } },
      "sk2": { "type": "Skeleton", "props": { "height": "3rem", "rounded": "md" } },
      "sk3": { "type": "Skeleton", "props": { "height": "3rem", "rounded": "md" } },

      "empty": {
        "type": "Empty",
        "props": { "message": "No timesheets awaiting approval." },
        "visible": {
          "$and": [
            { "$state": "/_loading/employment-hero.list_pending_timesheets_by_employee", "not": true },
            { "$state": "/ui/timesheetRows/0", "not": true }
          ]
        }
      },

      "list": {
        "type": "Stack", "props": { "gap": "xs" },
        "children": ["timesheetRow"],
        "repeat": { "statePath": "/ui/timesheetRows", "key": "id" },
        "visible": {
          "$and": [
            { "$state": "/_loading/employment-hero.list_pending_timesheets_by_employee", "not": true },
            { "$state": "/ui/timesheetRows/0" }
          ]
        }
      },

      "timesheetRow": {
        "type": "Stack", "props": { "gap": "xs" },
        "children": ["timesheetRowContent", "timesheetRowDivider"]
      },
      "timesheetRowContent": {
        "type": "Row",
        "props": { "justify": "between", "align": "center", "hover": true },
        "children": ["timesheetLeft", "timesheetRight"]
      },
      "timesheetLeft": {
        "type": "Stack", "props": { "gap": "none" },
        "children": ["empName", "empHours"]
      },
      "empName": {
        "type": "Text",
        "props": { "text": { "$item": "employee_name" }, "size": "sm", "weight": "medium", "truncate": true }
      },
      "empHours": {
        "type": "Caption",
        "props": { "text": { "$item": "hours_display" } }
      },
      "timesheetRight": {
        "type": "Stack", "props": { "gap": "none", "align": "end" },
        "children": ["timesheetStatus", "timesheetPeriod"]
      },
      "timesheetStatus": {
        "type": "Badge",
        "props": {
          "text": { "$item": "status_label" },
          "tone": { "$item": "status_tone" },
          "variant": "soft"
        }
      },
      "timesheetPeriod": {
        "type": "Caption",
        "props": { "text": { "$item": "pay_period" } }
      },
      "timesheetRowDivider": { "type": "Divider", "props": {} },

      "footer": {
        "type": "Row", "props": { "justify": "center" },
        "children": ["footerText"],
        "visible": {
          "$and": [
            { "$state": "/_loading/employment-hero.list_pending_timesheets_by_employee", "not": true },
            { "$state": "/ui/timesheetRows/0" }
          ]
        }
      },
      "footerText": {
        "type": "Caption",
        "props": { "text": "Timesheets awaiting your approval · Employment Hero" }
      }

    }
  },
  "status": "published"
}
