{
  "id": "employment-hero-timesheet-daily-summary",
  "title": "Timesheet This Week",
  "description": "Your organisation's timesheet entries for the current work week, grouped by day with total hours.",
  "category": "hr",
  "tags": ["employment-hero", "hr", "timesheets", "weekly", "hours"],
  "keywords": ["timesheet", "hours", "this week", "daily", "work hours", "employment hero"],
  "connectorsUsed": ["employment-hero"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 4, "rowSpan": 7 },
    "min":       { "colSpan": 3, "rowSpan": 5 },
    "max":       { "colSpan": 8, "rowSpan": 12 }
  },
  "dataProvider": {
    "mcp": "employment-hero",
    "tool": "get_timesheets_this_week",
    "params": {}
  },
  "spec": {
    "root": "card",
    "elements": {

      "card": {
        "type": "Card",
        "props": {},
        "children": ["header", "body", "footer"],
        "watch": {
          "/employment-hero/get_timesheets_this_week/data/items": [
            { "action": "setState", "params": { "statePath": "/ui/dailyRows", "value": { "$computed": "employment-hero_flatten_timesheet_daily_summary", "args": { "value": { "$state": "/employment-hero/get_timesheets_this_week/data/items" } } } } }
          ]
        }
      },

      "header": { "type": "Header", "props": {}, "children": ["headerRow"] },
      "headerRow": { "type": "Row", "props": { "align": "center", "template": "1fr auto" }, "children": ["titleGroup", "totalBadge"] },
      "titleGroup": { "type": "Row", "props": { "gap": "sm", "align": "start" }, "children": ["titleIcon", "titleStack"] },
      "titleIcon": { "type": "Icon", "props": { "name": "Clock", "tone": "accent", "size": "sm" } },
      "titleStack": { "type": "Stack", "props": { "gap": "none" }, "children": ["title", "eyebrow"] },
      "title": { "type": "Heading", "props": { "text": "Timesheet This Week", "level": "h2" } },
      "eyebrow": { "type": "Eyebrow", "props": { "text": "Employment Hero" } },
      "totalBadge": {
        "type": "Badge",
        "props": {
          "text": { "$state": "/ui/dailyRows/0/total_hours_display" },
          "tone": "accent",
          "variant": "soft"
        },
        "visible": { "$state": "/ui/dailyRows/0" }
      },

      "body": { "type": "Body", "props": {}, "children": ["loading", "empty", "list"] },

      "loading": {
        "type": "Stack", "props": { "gap": "sm" },
        "children": ["sk1", "sk2", "sk3"],
        "visible": { "$state": "/_loading/employment-hero.get_timesheets_this_week" }
      },
      "sk1": { "type": "Skeleton", "props": { "height": "3rem", "rounded": "md" } },
      "sk2": { "type": "Skeleton", "props": { "height": "3rem", "rounded": "md" } },
      "sk3": { "type": "Skeleton", "props": { "height": "3rem", "rounded": "md" } },

      "empty": {
        "type": "Empty",
        "props": { "message": "No timesheet entries this week." },
        "visible": {
          "$and": [
            { "$state": "/_loading/employment-hero.get_timesheets_this_week", "not": true },
            { "$state": "/ui/dailyRows/0", "not": true }
          ]
        }
      },

      "list": {
        "type": "Stack", "props": { "gap": "xs" },
        "children": ["dayRow"],
        "repeat": { "statePath": "/ui/dailyRows", "key": "id" },
        "visible": {
          "$and": [
            { "$state": "/_loading/employment-hero.get_timesheets_this_week", "not": true },
            { "$state": "/ui/dailyRows/0" }
          ]
        }
      },

      "dayRow": {
        "type": "Stack", "props": { "gap": "xs" },
        "children": ["dayRowContent", "dayDivider"]
      },
      "dayRowContent": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["dayLeft", "dayHoursBadge"]
      },
      "dayLeft": {
        "type": "Stack", "props": { "gap": "none" },
        "children": ["dayHeader", "entryCountLabel"]
      },
      "dayHeader": {
        "type": "Text",
        "props": { "text": { "$item": "date_header" }, "size": "sm", "weight": "semibold" }
      },
      "entryCountLabel": {
        "type": "Caption",
        "props": { "text": { "$item": "entry_count_label" } }
      },
      "dayHoursBadge": {
        "type": "Badge",
        "props": {
          "text": { "$item": "hours_display" },
          "tone": "default",
          "variant": "soft"
        }
      },
      "dayDivider": { "type": "Divider", "props": {} },

      "footer": {
        "type": "Row", "props": { "justify": "center" },
        "children": ["footerText"],
        "visible": {
          "$and": [
            { "$state": "/_loading/employment-hero.get_timesheets_this_week", "not": true },
            { "$state": "/ui/dailyRows/0" }
          ]
        }
      },
      "footerText": {
        "type": "Caption",
        "props": { "text": { "$state": "/ui/dailyRows/0/period_range" } }
      }

    }
  },
  "status": "published"
}
