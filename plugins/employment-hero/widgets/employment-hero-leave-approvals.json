{
  "id": "employment-hero-leave-approvals",
  "title": "Leave Request Approvals",
  "description": "Pending leave requests from your direct reports, with smart urgency status.",
  "category": "hr",
  "tags": ["employment-hero", "hr", "leave", "approvals", "manager"],
  "keywords": ["leave approvals", "pending leave", "direct reports", "approve", "employment hero"],
  "connectorsUsed": ["employment-hero"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 5, "rowSpan": 8 },
    "min":       { "colSpan": 4, "rowSpan": 6 },
    "max":       { "colSpan": 10, "rowSpan": 14 }
  },
  "dataProvider": {
    "mcp": "employment-hero",
    "tool": "get_leave_approvals_queue",
    "params": {}
  },
  "spec": {
    "root": "card",
    "elements": {

      "card": {
        "type": "Card",
        "props": {},
        "children": ["header", "body", "footer"],
        "watch": {
          "/employment-hero/get_leave_approvals_queue/data/items": [
            { "action": "setState", "params": { "statePath": "/ui/approvalRows", "value": { "$computed": "employment-hero_flatten_leave_requests", "args": { "value": { "$state": "/employment-hero/get_leave_approvals_queue/data/items" } } } } }
          ]
        }
      },

      "header": { "type": "Header", "props": {}, "children": ["headerRow"] },
      "headerRow": { "type": "Row", "props": { "align": "center", "template": "1fr auto" }, "children": ["titleGroup"] },
      "titleGroup": { "type": "Row", "props": { "gap": "sm", "align": "start" }, "children": ["titleIcon", "titleStack"] },
      "titleIcon": { "type": "Icon", "props": { "name": "CheckSquare", "tone": "success", "size": "sm" } },
      "titleStack": { "type": "Stack", "props": { "gap": "none" }, "children": ["title", "eyebrow"] },
      "title": { "type": "Heading", "props": { "text": "Leave Request Approvals", "level": "h2" } },
      "eyebrow": { "type": "Eyebrow", "props": { "text": "Employment Hero" } },

      "body": { "type": "Body", "props": {}, "children": ["loading", "empty", "list"] },

      "loading": {
        "type": "Stack", "props": { "gap": "sm" },
        "children": ["sk1", "sk2", "sk3"],
        "visible": { "$state": "/_loading/employment-hero.get_leave_approvals_queue" }
      },
      "sk1": { "type": "Skeleton", "props": { "height": "4rem", "rounded": "md" } },
      "sk2": { "type": "Skeleton", "props": { "height": "4rem", "rounded": "md" } },
      "sk3": { "type": "Skeleton", "props": { "height": "4rem", "rounded": "md" } },

      "empty": {
        "type": "Empty",
        "props": { "message": "No leave requests found." },
        "visible": {
          "$and": [
            { "$state": "/_loading/employment-hero.get_leave_approvals_queue", "not": true },
            { "$state": "/ui/approvalRows/0", "not": true }
          ]
        }
      },

      "list": {
        "type": "Stack", "props": { "gap": "xs" },
        "children": ["approvalRow"],
        "repeat": { "statePath": "/ui/approvalRows", "key": "id" },
        "visible": {
          "$and": [
            { "$state": "/_loading/employment-hero.get_leave_approvals_queue", "not": true },
            { "$state": "/ui/approvalRows/0" }
          ]
        }
      },

      "approvalRow": {
        "type": "Stack", "props": { "gap": "xs" },
        "children": ["approvalRowContent", "approvalRowDivider"]
      },
      "approvalRowContent": {
        "type": "Row",
        "props": { "justify": "between", "align": "start" },
        "children": ["approvalLeft", "approvalStatus"]
      },
      "approvalLeft": {
        "type": "Stack", "props": { "gap": "none" },
        "children": ["requestorLabel", "employeeName", "dateLeaveLine", "reviewRow"]
      },
      "requestorLabel": {
        "type": "Eyebrow", "props": { "text": "Requestor" }
      },
      "employeeName": {
        "type": "Text",
        "props": { "text": { "$item": "employee_name" }, "size": "sm", "weight": "semibold", "truncate": true }
      },
      "dateLeaveLine": {
        "type": "Caption",
        "props": { "text": { "$item": "date_leave_line" } }
      },
      "reviewRow": {
        "type": "Row",
        "props": { "align": "center", "clickable": true },
        "children": ["reviewCaption"],
        "visible": { "$item": "show_review_link" },
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "url": { "$computed": "identity", "args": { "value": { "$item": "review_url" } } },
              "target": "_blank"
            }
          }
        }
      },
      "reviewCaption": {
        "type": "Caption",
        "props": { "text": "Review in Employment Hero →", "tone": "accent" }
      },
      "approvalStatus": {
        "type": "Badge",
        "props": {
          "text": { "$item": "status_label" },
          "tone": { "$item": "status_tone" },
          "variant": "soft"
        }
      },
      "approvalRowDivider": { "type": "Divider", "props": {} },

      "footer": {
        "type": "Row", "props": { "justify": "center" },
        "children": ["footerText"],
        "visible": {
          "$and": [
            { "$state": "/_loading/employment-hero.get_leave_approvals_queue", "not": true },
            { "$state": "/ui/approvalRows/0" }
          ]
        }
      },
      "footerText": {
        "type": "Caption",
        "props": { "text": "Requests to approve · Employment Hero" }
      }

    }
  },
  "status": "published"
}
