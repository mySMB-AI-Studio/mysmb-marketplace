        "type": "Dot",
        "props": {
          "size": "sm",
          "tone": "success"
        },
        "visible": {
          "$item": "fields/gst/confidence",
          "eq": "high"
        }
      },
      "fGstDotCheck": {
        "type": "Dot",
        "props": {
          "size": "sm",
          "tone": "warning"
        },
        "visible": {
          "$item": "fields/gst/confidence",
          "eq": "check"
        }
      },
      "fGstValue": {
        "type": "Text",
        "props": {
          "text": {
            "$computed": "format_currency",
            "args": {
              "value": {
                "$item": "fields/gst/value"
              }
            }
          },
          "size": "sm",
          "weight": "medium"
        },
        "visible": {
          "$item": "fields/gst/value"
        }
      },
      "fGstNone": {
        "type": "Text",
        "props": {
          "text": "—",
          "size": "sm",
          "tone": "muted"
        },
        "visible": {
          "$item": "fields/gst/value",
          "not": true
        }
      },
      "fReason": {
        "type": "Section",
        "props": {
          "variant": "muted"
        },
        "visible": {
          "$item": "status",
          "eq": "unreadable"
        },
        "children": [
          "fReasonRow"
        ]
      },
      "fReasonRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center"
        },
        "children": [
          "fReasonIcon",
          "fReasonText"
        ]
      },
      "fReasonIcon": {
        "type": "Icon",
        "props": {
          "name": "AlertTriangle",
          "tone": "destructive",
          "size": "sm"
        }
      },
      "fReasonText": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "reason"
          },
          "size": "sm"
        }
      },
      "fTotal": {
        "type": "Section",
        "props": {
          "variant": "bordered"
        },
        "visible": {
          "$item": "status",
          "neq": "unreadable"
        },
        "children": [
          "fTotalRow"
        ]
      },
      "fTotalRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center",
          "justify": "between"
        },
        "children": [
          "fTotalLabel",
          "fTotalValue",
          "fTotalNone"
        ]
      },
      "fTotalLabel": {
        "type": "Text",
        "props": {
          "text": "Total",
          "size": "sm",
          "weight": "medium",
          "tone": "muted"
        }
      },
      "fTotalValue": {
        "type": "Text",
        "props": {
          "text": {
            "$computed": "format_currency",
            "args": {
              "value": {
                "$item": "amount"
              }
            }
          },
          "size": "lg",
          "weight": "medium",
          "tone": "destructive"
        },
        "visible": {
          "$item": "amountText"
        }
      },
      "fTotalNone": {
        "type": "Text",
        "props": {
          "text": "—",
          "size": "lg",
          "tone": "muted"
        },
        "visible": {
          "$item": "amountText",
          "not": true
        }
      },
      "dots": {
        "type": "Row",
        "props": {
          "gap": "xs",
          "align": "center",
          "justify": "center"
        },
        "repeat": {
          "statePath": "/google-workspace-gmail/list_bill_label_emails/bills",
          "key": "id"
        },
        "children": [
          "dotOn",
          "dotOff"
        ]
      },
      "dotOn": {
        "type": "Dot",
        "props": {
          "size": "sm",
          "tone": "info"
        },
        "visible": {
          "$or": [
            {
              "$item": "position",
              "eq": {
                "$state": "/ui/gmailBills/sel"
              }
            },
            {
              "$and": [
                {
                  "$state": "/ui/gmailBills/sel",
                  "not": true
                },
                {
                  "$item": "isFirst"
                }
              ]
            }
          ]
        }
      },
      "dotOff": {
        "type": "Dot",
        "props": {
          "size": "xs",
          "tone": "muted"
        },
        "visible": {
          "$and": [
            {
              "$item": "position",
              "neq": {
                "$state": "/ui/gmailBills/sel"
              }
            },
            {
              "$or": [
                {
                  "$state": "/ui/gmailBills/sel"
                },
                {
                  "$item": "isFirst",
                  "not": true
                }
              ]
            }
          ]
        }
      },
      "listSection": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "listHeader",
          "list"
        ]
      },
      "listHeader": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center",
          "justify": "between"
        },
        "children": [
          "listTitle",
          "listOrder"
        ]
      },
      "listTitle": {
        "type": "Eyebrow",
        "props": {
          "text": "All bills in label"
        }
      },
      "listOrder": {
        "type": "Eyebrow",
        "props": {
          "text": "Newest first"
        }
      },
      "list": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "repeat": {
          "statePath": "/google-workspace-gmail/list_bill_label_emails/bills",
          "key": "id"
        },
        "children": [
          "groupDivider",
          "groupHeader",
          "billRow"
        ]
      },
      "groupDivider": {
        "type": "Divider",
        "props": {},
        "visible": {
          "$and": [
            {
              "$item": "groupStart"
            },
            {
              "$item": "isFirst",
              "not": true
            }
          ]
        }
      },
      "groupHeader": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center",
          "justify": "between"
        },
        "visible": {
          "$item": "groupStart"
        },
        "children": [
          "groupSender",
          "groupTime"
        ]
      },
      "groupSender": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "senderAddress"
          },
          "size": "sm",
          "weight": "medium",
          "truncate": true
        }
      },
      "groupTime": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "relative_time",
            "args": {
              "value": {
                "$item": "receivedAt"
              }
            }
          },
          "tone": "muted"
        }
      },
      "billRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center",
          "hover": true,
          "clickable": true,
          "selected": {
            "$cond": {
              "$or": [
                {
                  "$item": "position",
                  "eq": {
                    "$state": "/ui/gmailBills/sel"
                  }
                },
                {
                  "$and": [
                    {
                      "$state": "/ui/gmailBills/sel",
                      "not": true
                    },
                    {
                      "$item": "isFirst"
                    }
                  ]
                }
              ]
            },
            "$then": true,
            "$else": false
          }
        },
        "on": {
          "click": {
            "action": "setState",
            "params": {
              "statePath": "/ui/gmailBills/sel",
              "value": {
                "$computed": "identity",
                "args": {
                  "value": {
                    "$item": "position"
                  }
                }
              }
            }
          }
        },
        "children": [
          "billType",
          "billName",
          "billAmount",
          "billNoAmount",
          "billStatus"
        ]
      },
      "billType": {
        "type": "Badge",
        "props": {
          "text": {
            "$item": "fileType"
          },
          "tone": "brand",
          "variant": {
            "$cond": {
              "$or": [
                {
                  "$item": "position",
                  "eq": {
                    "$state": "/ui/gmailBills/sel"
                  }
                },
                {
                  "$and": [
                    {
                      "$state": "/ui/gmailBills/sel",
                      "not": true
                    },
                    {
                      "$item": "isFirst"
                    }
                  ]
                }
              ]
            },
            "$then": "solid",
            "$else": "soft"
          }
        }
      },
      "billName": {
        "type": "Row",
        "props": {
          "gap": "xs",
          "align": "center",
          "grow": true
        },
        "children": [
          "billSupplier",
          "billFile"
        ]
      },
      "billSupplier": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "supplierName"
          },
          "size": "sm",
          "weight": "medium",
          "truncate": true
        }
      },
      "billFile": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "· {file}",
              "file": {
                "$item": "attachmentName"
              }
            }
          },
          "tone": "muted",
          "truncate": true
        },
        "visible": {
          "$item": "attachmentName"
        }
      },
      "billAmount": {
        "type": "Text",
        "props": {
          "text": {
            "$computed": "format_currency",
            "args": {
              "value": {
                "$item": "amount"
              }
            }
          },
          "size": "sm",
          "weight": "medium"
        },
        "visible": {
          "$item": "amountText"
        }
      },
      "billNoAmount": {
        "type": "Text",
        "props": {
          "text": "—",
          "size": "sm",
          "tone": "muted"
        },
        "visible": {
          "$item": "amountText",
          "not": true
        }
      },
      "billStatus": {
        "type": "Badge",
        "props": {
          "text": {
            "$item": "statusLabel"
          },
          "tone": {
            "$item": "statusTone"
          },
          "variant": "soft"
        }
      },
      "footerDivider": {
        "type": "Divider",
        "props": {}
      },
      "footerRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center",
          "justify": "between"
        },
        "children": [
          "legend",
          "openList"
        ]
      },
      "legend": {
        "type": "Row",
        "props": {
          "gap": "xs",
          "align": "center"
        },
        "children": [
          "legendDotHigh",
          "legendHigh",
          "legendSep",
          "legendDotCheck",
          "legendCheck",
          "legendTail"
        ]
      },
      "legendDotHigh": {
        "type": "Dot",
        "props": {
          "size": "sm",
          "tone": "success"
        }
      },
      "legendHigh": {
        "type": "Caption",
        "props": {
          "text": "high",
          "tone": "muted"
        }
      },
      "legendSep": {
        "type": "Caption",
        "props": {
          "text": "·",
          "tone": "muted"
        }
      },
      "legendDotCheck": {
        "type": "Dot",
        "props": {
          "size": "sm",
          "tone": "warning"
        }
      },
      "legendCheck": {
        "type": "Caption",
        "props": {
          "text": "check",
          "tone": "muted"
        }
      },
      "legendTail": {
        "type": "Caption",
        "props": {
          "text": "— field confidence",
          "tone": "muted"
        }
      },
      "openList": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "repeat": {
          "statePath": "/google-workspace-gmail/list_bill_label_emails/bills",
          "key": "id"
        },
        "children": [
          "openButton"
        ]
      },
      "openButton": {
        "type": "Button",
        "props": {
          "label": "Open in Gmail",
          "variant": "primary",
          "tone": "info",
          "size": "sm"
        },
        "visible": {
          "$or": [
            {
              "$item": "position",
              "eq": {
                "$state": "/ui/gmailBills/sel"
              }
            },
            {
              "$and": [
                {
                  "$state": "/ui/gmailBills/sel",
                  "not": true
                },
                {
                  "$item": "isFirst"
                }
              ]
            }
          ]
        },
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "url": {
                "$computed": "identity",
                "args": {
                  "value": {
                    "$item": "webLink"
                  }
                }
              },
              "target": "_blank"
            }
          }
        }
      }
    }
  }
}
