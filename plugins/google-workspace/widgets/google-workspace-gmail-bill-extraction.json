          "size": "sm",
          "tone": "muted"
        },
        "visible": {
          "$item": "fields/invoiceNumber/value",
          "not": true
        }
      },
      "fIssued": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center",
          "justify": "between"
        },
        "children": [
          "fIssuedLabel",
          "fIssuedRight"
        ]
      },
      "fIssuedLabel": {
        "type": "Caption",
        "props": {
          "text": "Issued",
          "tone": "muted"
        }
      },
      "fIssuedRight": {
