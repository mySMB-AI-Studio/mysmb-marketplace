      "otherStatus": {
        "type": "Badge",
        "props": {
          "text": {
            "$item": "statusLabel"
          },
          "tone": {
            "$item": "statusTone"
          },
          "variant": "soft"
        }
      },
      "otherDivider": {
        "type": "Divider",
        "props": {}
      },
      "footerDivider": {
        "type": "Divider",
        "props": {}
      },
      "footerRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center",
          "justify": "between"
        },
        "children": [
          "footerLegend",
          "footerOpen"
        ]
      },
      "footerLegend": {
        "type": "Row",
        "props": {
          "gap": "xs",
          "align": "center"
        },
        "children": [
          "legendDotHigh",
          "legendTextHigh",
          "legendSep",
          "legendDotCheck",
          "legendTextCheck",
          "legendTail"
        ]
      },
      "legendDotHigh": {
        "type": "Dot",
        "props": {
          "size": "sm",
          "tone": "success"
        }
      },
      "legendTextHigh": {
        "type": "Caption",
        "props": {
          "text": "high",
          "tone": "muted"
        }
      },
      "legendSep": {
        "type": "Caption",
        "props": {
          "text": "·",
          "tone": "muted"
        }
      },
      "legendDotCheck": {
        "type": "Dot",
        "props": {
          "size": "sm",
          "tone": "warning"
        }
      },
      "legendTextCheck": {
        "type": "Caption",
        "props": {
          "text": "check",
          "tone": "muted"
        }
      },
      "legendTail": {
        "type": "Caption",
        "props": {
          "text": "— field confidence",
          "tone": "muted"
        }
      },
      "footerOpen": {
        "type": "Button",
        "props": {
          "label": "Open in Gmail",
          "variant": "primary",
          "tone": "info",
          "size": "sm"
        },
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "url": {
                "$state": "/google-workspace-gmail/list_bill_label_emails/latest/webLink"
              },
              "target": "_blank"
            }
          }
        }
      },
      "featuredSubtitleWithFile": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{addr} · {time} · {file}",
              "addr": {
                "$state": "/google-workspace-gmail/list_bill_label_emails/latest/senderAddress"
              },
              "time": {
                "$state": "/google-workspace-gmail/list_bill_label_emails/latest/receivedLabel"
              },
              "file": {
                "$state": "/google-workspace-gmail/list_bill_label_emails/latest/attachmentName"
              }
            }
          },
          "tone": "muted",
          "truncate": true
        },
        "visible": {
          "$state": "/google-workspace-gmail/list_bill_label_emails/latest/attachmentName"
        }
      },
      "featuredSubtitleNoFile": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{addr} · {time}",
              "addr": {
                "$state": "/google-workspace-gmail/list_bill_label_emails/latest/senderAddress"
              },
              "time": {
                "$state": "/google-workspace-gmail/list_bill_label_emails/latest/receivedLabel"
              }
            }
          },
          "tone": "muted",
          "truncate": true
        },
        "visible": {
          "$state": "/google-workspace-gmail/list_bill_label_emails/latest/attachmentName",
          "not": true
        }
      },
      "headerStack": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "children": [
          "title",
          "labelPillRow"
        ]
      },
      "headerRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center"
        },
        "children": [
          "headerIcon",
          "headerStack"
        ]
      }
    }
  }
}
