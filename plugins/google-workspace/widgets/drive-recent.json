{
  "id": "google-workspace-drive-recent",
  "title": "Recent Files",
  "description": "Recently viewed Google Drive files — folders excluded, colored type icons, Meet transcript names tidied, and a folder + reason context line. Tabs for Docs/Sheets/PDFs/Shared with me, plus quick-access cards for the 2 most recent files. Click a file to open it in Drive.",
  "category": "productivity",
  "tags": [
    "google",
    "drive",
    "files",
    "documents",
    "productivity"
  ],
  "keywords": [
    "drive",
    "files",
    "documents",
    "recent",
    "sheets",
    "docs",
    "pdf",
    "google"
  ],
  "connectorsUsed": [
    "google-workspace-drive"
  ],
  "brandColor": "#4285F4",
  "popularity": 0,
  "sizing": {
    "preferred": {
      "colSpan": 6,
      "rowSpan": 6
    },
    "min": {
      "colSpan": 4,
      "rowSpan": 4
    },
    "max": {
      "colSpan": 12,
      "rowSpan": 12
    }
  },
  "dataProvider": {
    "mcp": "google-workspace-drive",
    "tool": "get_recent_files_dashboard",
    "params": {
      "pageSize": 30
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "children": [
          "header",
          "body"
        ],
        "watch": {
          "/google-workspace-drive/get_recent_files_dashboard/files": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/recentFiles",
                "value": {
                  "$computed": "google-workspace_build_recent_files_view",
                  "args": {
                    "files": { "$state": "/google-workspace-drive/get_recent_files_dashboard/files" },
                    "tab": { "$state": "/ui/recentFilesTab" }
                  }
                }
              }
            }
          ],
          "/ui/recentFilesTab": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/recentFiles",
                "value": {
                  "$computed": "google-workspace_build_recent_files_view",
                  "args": {
                    "files": { "$state": "/google-workspace-drive/get_recent_files_dashboard/files" },
                    "tab": { "$state": "/ui/recentFilesTab" }
                  }
                }
              }
            }
          ]
        }
      },
      "header": {
        "type": "Header",
        "children": [
          "headerStack"
        ]
      },
      "headerStack": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "titleRow",
          "tabsRow"
        ]
      },
      "titleRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center"
        },
        "children": [
          "titleIcon",
          "titleStack"
        ]
      },
      "titleIcon": {
        "type": "Icon",
        "props": {
          "name": "HardDrive",
          "tone": "default",
          "size": "lg"
        }
      },
      "titleStack": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "children": [
          "title",
          "count"
        ]
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "Recent Files",
          "level": "h2"
        }
      },
      "count": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{n} files · last 3 days",
              "n": {
                "$computed": "count",
                "args": {
                  "value": { "$state": "/google-workspace-drive/get_recent_files_dashboard/files" }
                }
              }
            }
          }
        }
      },
      "tabsRow": {
        "type": "Row",
        "props": {
          "gap": "md",
          "align": "center"
        },
        "children": [
          "tabAll",
          "tabDocs",
          "tabSheets",
          "tabPdfs",
          "tabShared"
        ]
      },
      "tabAll": {
        "type": "Row",
        "props": {
          "clickable": true
        },
        "children": ["tabAllActive", "tabAllInactive"],
        "on": { "click": { "action": "setState", "params": { "statePath": "/ui/recentFilesTab", "value": "all" } } }
      },
      "tabAllActive": {
        "type": "Badge",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": { "pattern": "All {n}", "n": { "$state": "/ui/recentFiles/counts/all" } }
          },
          "tone": "muted",
          "variant": "soft"
        },
        "visible": {
          "$or": [
            { "$state": "/ui/recentFilesTab", "eq": "all" },
            { "$state": "/ui/recentFilesTab", "not": true }
          ]
        }
      },
      "tabAllInactive": {
        "type": "Text",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": { "pattern": "All {n}", "n": { "$state": "/ui/recentFiles/counts/all" } }
          },
          "size": "sm",
          "tone": "muted"
        },
        "visible": {
          "$and": [
            { "$state": "/ui/recentFilesTab" },
            { "$state": "/ui/recentFilesTab", "eq": "all", "not": true }
          ]
        }
      },
      "tabDocs": {
        "type": "Row",
        "props": {
          "clickable": true
        },
        "children": ["tabDocsActive", "tabDocsInactive"],
        "on": { "click": { "action": "setState", "params": { "statePath": "/ui/recentFilesTab", "value": "docs" } } }
      },
      "tabDocsActive": {
        "type": "Badge",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": { "pattern": "Docs {n}", "n": { "$state": "/ui/recentFiles/counts/docs" } }
          },
          "tone": "info",
          "variant": "soft"
        },
        "visible": { "$state": "/ui/recentFilesTab", "eq": "docs" }
      },
      "tabDocsInactive": {
        "type": "Text",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": { "pattern": "Docs {n}", "n": { "$state": "/ui/recentFiles/counts/docs" } }
          },
          "size": "sm",
          "tone": "muted"
        },
        "visible": { "$state": "/ui/recentFilesTab", "eq": "docs", "not": true }
      },
      "tabSheets": {
        "type": "Row",
        "props": {
          "clickable": true
        },
        "children": ["tabSheetsActive", "tabSheetsInactive"],
        "on": { "click": { "action": "setState", "params": { "statePath": "/ui/recentFilesTab", "value": "sheets" } } }
      },
      "tabSheetsActive": {
        "type": "Badge",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": { "pattern": "Sheets {n}", "n": { "$state": "/ui/recentFiles/counts/sheets" } }
          },
          "tone": "success",
          "variant": "soft"
        },
        "visible": { "$state": "/ui/recentFilesTab", "eq": "sheets" }
      },
      "tabSheetsInactive": {
        "type": "Text",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": { "pattern": "Sheets {n}", "n": { "$state": "/ui/recentFiles/counts/sheets" } }
          },
          "size": "sm",
          "tone": "muted"
        },
        "visible": { "$state": "/ui/recentFilesTab", "eq": "sheets", "not": true }
      },
      "tabPdfs": {
        "type": "Row",
        "props": {
          "clickable": true
        },
        "children": ["tabPdfsActive", "tabPdfsInactive"],
        "on": { "click": { "action": "setState", "params": { "statePath": "/ui/recentFilesTab", "value": "pdfs" } } }
      },
      "tabPdfsActive": {
        "type": "Badge",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": { "pattern": "PDFs {n}", "n": { "$state": "/ui/recentFiles/counts/pdfs" } }
          },
          "tone": "destructive",
          "variant": "soft"
        },
        "visible": { "$state": "/ui/recentFilesTab", "eq": "pdfs" }
      },
      "tabPdfsInactive": {
        "type": "Text",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": { "pattern": "PDFs {n}", "n": { "$state": "/ui/recentFiles/counts/pdfs" } }
          },
          "size": "sm",
          "tone": "muted"
        },
        "visible": { "$state": "/ui/recentFilesTab", "eq": "pdfs", "not": true }
      },
      "tabShared": {
        "type": "Row",
        "props": {
          "clickable": true
        },
        "children": ["tabSharedActive", "tabSharedInactive"],
        "on": { "click": { "action": "setState", "params": { "statePath": "/ui/recentFilesTab", "value": "shared" } } }
      },
      "tabSharedActive": {
        "type": "Badge",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": { "pattern": "Shared with me {n}", "n": { "$state": "/ui/recentFiles/counts/shared" } }
          },
          "tone": "warning",
          "variant": "soft"
        },
        "visible": { "$state": "/ui/recentFilesTab", "eq": "shared" }
      },
      "tabSharedInactive": {
        "type": "Text",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": { "pattern": "Shared with me {n}", "n": { "$state": "/ui/recentFiles/counts/shared" } }
          },
          "size": "sm",
          "tone": "muted"
        },
        "visible": { "$state": "/ui/recentFilesTab", "eq": "shared", "not": true }
      },
      "body": {
        "type": "Body",
        "children": [
          "loading",
          "empty",
          "content"
        ]
      },
      "loading": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "visible": {
          "$state": "/_loading/google-workspace-drive.get_recent_files_dashboard"
        },
        "children": [
          "sk1",
          "sk2",
          "sk3",
          "sk4"
        ]
      },
      "sk1": { "type": "Skeleton", "props": { "height": "2.75rem", "rounded": "md" } },
      "sk2": { "type": "Skeleton", "props": { "height": "2.75rem", "rounded": "md" } },
      "sk3": { "type": "Skeleton", "props": { "height": "2.75rem", "rounded": "md" } },
      "sk4": { "type": "Skeleton", "props": { "height": "2.75rem", "rounded": "md" } },
      "empty": {
        "type": "Empty",
        "props": {
          "message": "No recent files."
        },
        "visible": {
          "$and": [
            {
              "$state": "/_loading/google-workspace-drive.get_recent_files_dashboard",
              "not": true
            },
            {
              "$state": "/google-workspace-drive/get_recent_files_dashboard/files/0",
              "not": true
            }
          ]
        }
      },
      "content": {
        "type": "Stack",
        "props": {
          "gap": "md"
        },
        "visible": {
          "$state": "/_loading/google-workspace-drive.get_recent_files_dashboard",
          "not": true
        },
        "children": [
          "quickAccessRow",
          "list",
          "footer"
        ]
      },
      "quickAccessRow": {
        "type": "Row",
        "props": {
          "gap": "sm"
        },
        "visible": { "$state": "/ui/recentFiles/quickAccess/0" },
        "repeat": {
          "statePath": "/ui/recentFiles/quickAccess",
          "key": "id"
        },
        "children": [
          "quickCard"
        ]
      },
      "quickCard": {
        "type": "Section",
        "props": {
          "variant": "bordered",
          "grow": true
        },
        "children": [
          "quickCardClickRow"
        ]
      },
      "quickCardClickRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "start",
          "clickable": true
        },
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "url": {
                "$computed": "identity",
                "args": { "value": { "$item": "webViewLink" } }
              },
              "target": "_blank"
            }
          }
        },
        "children": [
          "quickCardIcon",
          "quickCardLabels"
        ]
      },
      "quickCardIcon": {
        "type": "Avatar",
        "props": {
          "initials": { "$item": "typeLabel" },
          "tone": { "$item": "typeTone" },
          "size": "md"
        }
      },
      "quickCardLabels": {
        "type": "Stack",
        "props": {
          "gap": "xs",
          "grow": true
        },
        "children": [
          "quickCardName",
          "quickCardMeta"
        ]
      },
      "quickCardName": {
        "type": "Text",
        "props": {
          "text": { "$item": "tidiedName" },
          "size": "sm",
          "weight": "bold"
        }
      },
      "quickCardMeta": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{reason} · {time}",
              "reason": { "$item": "reason" },
              "time": {
                "$computed": "relative_time",
                "args": { "value": { "$item": "modifiedTime" } }
              }
            }
          },
          "tone": "muted"
        }
      },
      "list": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "repeat": {
          "statePath": "/ui/recentFiles/agendaRows",
          "key": "id"
        },
        "children": [
          "rowWrap"
        ]
      },
      "rowWrap": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "children": [
          "dayHeader",
          "rowContent",
          "rowDivider"
        ]
      },
      "dayHeader": {
        "type": "Eyebrow",
        "props": {
          "text": { "$item": "dayLabel" },
          "tone": "muted"
        },
        "visible": { "$item": "showDayHeader" }
      },
      "rowContent": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "start",
          "hover": true,
          "clickable": true,
          "justify": "between"
        },
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "url": {
                "$computed": "identity",
                "args": { "value": { "$item": "webViewLink" } }
              },
              "target": "_blank"
            }
          }
        },
        "children": [
          "rowIcon",
          "rowLabels",
          "rowMeta"
        ]
      },
      "rowIcon": {
        "type": "Avatar",
        "props": {
          "initials": { "$item": "typeLabel" },
          "tone": { "$item": "typeTone" },
          "size": "sm"
        }
      },
      "rowLabels": {
        "type": "Stack",
        "props": {
          "gap": "xs",
          "grow": true
        },
        "children": [
          "rowNameRow",
          "rowContext"
        ]
      },
      "rowNameRow": {
        "type": "Row",
        "props": {
          "gap": "xs",
          "align": "center"
        },
        "children": [
          "rowName",
          "sharedTag"
        ]
      },
      "rowName": {
        "type": "Text",
        "props": {
          "text": { "$item": "tidiedName" },
          "size": "sm",
          "weight": "medium",
          "truncate": true
        }
      },
      "sharedTag": {
        "type": "Badge",
        "props": {
          "text": "Shared",
          "tone": "warning",
          "variant": "soft"
        },
        "visible": { "$item": "isShared" }
      },
      "rowContext": {
        "type": "Row",
        "props": {
          "gap": "xs",
          "align": "center"
        },
        "children": [
          "rowFolderIcon",
          "rowContextText"
        ]
      },
      "rowFolderIcon": {
        "type": "Icon",
        "props": {
          "name": "Folder",
          "tone": "muted",
          "size": "xs"
        },
        "visible": { "$item": "folderName" }
      },
      "rowContextText": {
        "type": "Caption",
        "props": {
          "text": { "$item": "contextLabel" },
          "tone": "muted",
          "truncate": true
        }
      },
      "rowMeta": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "relative_time",
            "args": { "value": { "$item": "modifiedTime" } }
          },
          "tone": "muted"
        }
      },
      "rowDivider": {
        "type": "Divider",
        "props": {}
      },
      "footer": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "justify": "between",
          "align": "center"
        },
        "children": [
          "footerCaption",
          "footerLink"
        ]
      },
      "footerCaption": {
        "type": "Caption",
        "props": {
          "text": "My Drive + shared with me · folders hidden",
          "tone": "muted"
        }
      },
      "footerLink": {
        "type": "Button",
        "props": {
          "label": "Open Google Drive",
          "variant": "primary",
          "tone": "info",
          "size": "sm",
          "leadingIcon": "HardDrive"
        },
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "url": "https://drive.google.com/drive/recent",
              "target": "_blank"
            }
          }
        }
      }
    }
  }
}
