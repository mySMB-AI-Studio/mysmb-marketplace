{
  "id": "google-workspace-gmail-inbox",
  "title": "Gmail Inbox",
  "description": "Recent Gmail messages grouped by sender and day, with unread/attachment/alert tabs. Repeat notifications from the same sender on the same day (e.g. security alerts) collapse into one row with a count. Click a row to open its thread in Gmail.",
  "category": "productivity",
  "tags": [
    "google",
    "gmail",
    "inbox",
    "email",
    "productivity"
  ],
  "keywords": [
    "gmail",
    "email",
    "inbox",
    "unread",
    "messages",
    "mail",
    "google",
    "alerts",
    "attachments"
  ],
  "connectorsUsed": [
    "google-workspace-gmail"
  ],
  "brandColor": "#EA4335",
  "popularity": 0,
  "sizing": {
    "preferred": {
      "colSpan": 6,
      "rowSpan": 6
    },
    "min": {
      "colSpan": 4,
      "rowSpan": 4
    },
    "max": {
      "colSpan": 12,
      "rowSpan": 12
    }
  },
  "dataProvider": {
    "mcp": "google-workspace-gmail",
    "tool": "list_messages",
    "params": {
      "labelIds": ["INBOX"],
      "maxResults": 20
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "children": [
          "header",
          "body"
        ],
        "watch": {
          "/google-workspace-gmail/list_messages/messages": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/gmailInbox",
                "value": {
                  "$computed": "google-workspace_build_inbox_rows",
                  "args": {
                    "messages": { "$state": "/google-workspace-gmail/list_messages/messages" },
                    "tab": { "$state": "/ui/gmailInboxTab" }
                  }
                }
              }
            }
          ],
          "/ui/gmailInboxTab": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/gmailInbox",
                "value": {
                  "$computed": "google-workspace_build_inbox_rows",
                  "args": {
                    "messages": { "$state": "/google-workspace-gmail/list_messages/messages" },
                    "tab": { "$state": "/ui/gmailInboxTab" }
                  }
                }
              }
            }
          ]
        }
      },
      "header": {
        "type": "Header",
        "children": [
          "headerStack"
        ]
      },
      "headerStack": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "titleRow",
          "tabsRow"
        ]
      },
      "titleRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center"
        },
        "children": [
          "titleIcon",
          "titleStack"
        ]
      },
      "titleIcon": {
        "type": "Icon",
        "props": {
          "name": "Mail",
          "tone": "default",
          "size": "lg"
        }
      },
      "titleStack": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "children": [
          "title",
          "count"
        ]
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "Gmail Inbox",
          "level": "h2"
        }
      },
      "count": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{unread} unread · {total} messages",
              "unread": {
                "$computed": "count_where",
                "args": {
                  "value": { "$state": "/google-workspace-gmail/list_messages/messages" },
                  "whereField": "isUnread",
                  "equals": true
                }
              },
              "total": {
                "$computed": "count",
                "args": {
                  "value": { "$state": "/google-workspace-gmail/list_messages/messages" }
                }
              }
            }
          }
        }
      },
      "tabsRow": {
        "type": "Row",
        "props": {
          "gap": "md",
          "align": "center"
        },
        "children": [
          "tabAll",
          "tabUnread",
          "tabAttachments",
          "tabAlerts"
        ]
      },
      "tabAll": {
        "type": "Row",
        "props": {
          "clickable": true
        },
        "children": ["tabAllActive", "tabAllInactive"],
        "on": { "click": { "action": "setState", "params": { "statePath": "/ui/gmailInboxTab", "value": "all" } } }
      },
      "tabAllActive": {
        "type": "Badge",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": { "pattern": "All {n}", "n": { "$state": "/ui/gmailInbox/counts/all" } }
          },
          "tone": "success",
          "variant": "soft"
        },
        "visible": {
          "$or": [
            { "$state": "/ui/gmailInboxTab", "eq": "all" },
            { "$state": "/ui/gmailInboxTab", "not": true }
          ]
        }
      },
      "tabAllInactive": {
        "type": "Text",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": { "pattern": "All {n}", "n": { "$state": "/ui/gmailInbox/counts/all" } }
          },
          "size": "sm",
          "tone": "muted"
        },
        "visible": {
          "$and": [
            { "$state": "/ui/gmailInboxTab" },
            { "$state": "/ui/gmailInboxTab", "eq": "all", "not": true }
          ]
        }
      },
      "tabUnread": {
        "type": "Row",
        "props": {
          "clickable": true
        },
        "children": ["tabUnreadActive", "tabUnreadInactive"],
        "on": { "click": { "action": "setState", "params": { "statePath": "/ui/gmailInboxTab", "value": "unread" } } }
      },
      "tabUnreadActive": {
        "type": "Badge",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": { "pattern": "Unread {n}", "n": { "$state": "/ui/gmailInbox/counts/unread" } }
          },
          "tone": "info",
          "variant": "soft"
        },
        "visible": { "$state": "/ui/gmailInboxTab", "eq": "unread" }
      },
      "tabUnreadInactive": {
        "type": "Text",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": { "pattern": "Unread {n}", "n": { "$state": "/ui/gmailInbox/counts/unread" } }
          },
          "size": "sm",
          "tone": "muted"
        },
        "visible": { "$state": "/ui/gmailInboxTab", "eq": "unread", "not": true }
      },
      "tabAttachments": {
        "type": "Row",
        "props": {
          "clickable": true
        },
        "children": ["tabAttachmentsActive", "tabAttachmentsInactive"],
        "on": { "click": { "action": "setState", "params": { "statePath": "/ui/gmailInboxTab", "value": "attachments" } } }
      },
      "tabAttachmentsActive": {
        "type": "Badge",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": { "pattern": "Attachments {n}", "n": { "$state": "/ui/gmailInbox/counts/attachments" } }
          },
          "tone": "warning",
          "variant": "soft"
        },
        "visible": { "$state": "/ui/gmailInboxTab", "eq": "attachments" }
      },
      "tabAttachmentsInactive": {
        "type": "Text",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": { "pattern": "Attachments {n}", "n": { "$state": "/ui/gmailInbox/counts/attachments" } }
          },
          "size": "sm",
          "tone": "muted"
        },
        "visible": { "$state": "/ui/gmailInboxTab", "eq": "attachments", "not": true }
      },
      "tabAlerts": {
        "type": "Row",
        "props": {
          "clickable": true
        },
        "children": ["tabAlertsActive", "tabAlertsInactive"],
        "on": { "click": { "action": "setState", "params": { "statePath": "/ui/gmailInboxTab", "value": "alerts" } } }
      },
      "tabAlertsActive": {
        "type": "Badge",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": { "pattern": "Alerts {n}", "n": { "$state": "/ui/gmailInbox/counts/alerts" } }
          },
          "tone": "destructive",
          "variant": "soft"
        },
        "visible": { "$state": "/ui/gmailInboxTab", "eq": "alerts" }
      },
      "tabAlertsInactive": {
        "type": "Text",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": { "pattern": "Alerts {n}", "n": { "$state": "/ui/gmailInbox/counts/alerts" } }
          },
          "size": "sm",
          "tone": "muted"
        },
        "visible": { "$state": "/ui/gmailInboxTab", "eq": "alerts", "not": true }
      },
      "body": {
        "type": "Body",
        "children": [
          "loading",
          "empty",
          "content"
        ]
      },
      "loading": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "visible": {
          "$state": "/_loading/google-workspace-gmail.list_messages"
        },
        "children": [
          "sk1",
          "sk2",
          "sk3",
          "sk4"
        ]
      },
      "sk1": { "type": "Skeleton", "props": { "height": "2.75rem", "rounded": "md" } },
      "sk2": { "type": "Skeleton", "props": { "height": "2.75rem", "rounded": "md" } },
      "sk3": { "type": "Skeleton", "props": { "height": "2.75rem", "rounded": "md" } },
      "sk4": { "type": "Skeleton", "props": { "height": "2.75rem", "rounded": "md" } },
      "empty": {
        "type": "Empty",
        "props": {
          "message": "No messages in your inbox."
        },
        "visible": {
          "$and": [
            {
              "$state": "/_loading/google-workspace-gmail.list_messages",
              "not": true
            },
            {
              "$state": "/google-workspace-gmail/list_messages/messages/0",
              "not": true
            }
          ]
        }
      },
      "content": {
        "type": "Stack",
        "props": {
          "gap": "md"
        },
        "visible": {
          "$state": "/_loading/google-workspace-gmail.list_messages",
          "not": true
        },
        "children": [
          "list",
          "divider",
          "footer"
        ]
      },
      "list": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "repeat": {
          "statePath": "/ui/gmailInbox/rows",
          "key": "id"
        },
        "children": [
          "rowWrap"
        ]
      },
      "rowWrap": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "children": [
          "dayHeader",
          "rowContent",
          "rowDivider"
        ]
      },
      "dayHeader": {
        "type": "Eyebrow",
        "props": {
          "text": { "$item": "dayLabel" },
          "tone": "muted"
        },
        "visible": { "$item": "showDayHeader" }
      },
      "rowContent": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "start",
          "hover": true,
          "clickable": true,
          "justify": "between"
        },
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "url": {
                "$computed": "fmt",
                "args": {
                  "pattern": "https://mail.google.com/mail/u/0/#inbox/{threadId}",
                  "threadId": { "$item": "threadId" }
                }
              },
              "target": "_blank"
            }
          }
        },
        "children": [
          "unreadDot",
          "avatar",
          "labels",
          "received"
        ]
      },
      "unreadDot": {
        "type": "Dot",
        "props": {
          "tone": "info"
        },
        "visible": { "$item": "isUnread" }
      },
      "avatar": {
        "type": "Avatar",
        "props": {
          "initials": {
            "$computed": "initials",
            "args": {
              "value": { "$item": "sender" }
            }
          },
          "tone": {
            "$computed": "google-workspace_sender_tone",
            "args": {
              "value": { "$item": "sender" }
            }
          },
          "size": "md"
        }
      },
      "labels": {
        "type": "Stack",
        "props": {
          "gap": "xs",
          "grow": true
        },
        "children": [
          "senderRow",
          "subjectText",
          "snippetText",
          "tagsRow"
        ]
      },
      "senderRow": {
        "type": "Row",
        "props": {
          "gap": "xs",
          "align": "center"
        },
        "children": [
          "senderText",
          "countBadge"
        ]
      },
      "senderText": {
        "type": "Caption",
        "props": {
          "text": { "$item": "sender" },
          "tone": "muted"
        }
      },
      "countBadge": {
        "type": "Badge",
        "props": {
          "text": { "$item": "count" },
          "tone": "muted",
          "variant": "soft"
        },
        "visible": { "$item": "isGroup" }
      },
      "subjectText": {
        "type": "Text",
        "props": {
          "text": { "$item": "subject" },
          "size": "sm",
          "weight": "medium",
          "truncate": true
        }
      },
      "snippetText": {
        "type": "Text",
        "props": {
          "text": { "$item": "snippet" },
          "size": "sm",
          "tone": "muted",
          "truncate": true
        }
      },
      "tagsRow": {
        "type": "Row",
        "props": {
          "gap": "xs",
          "align": "center"
        },
        "children": [
          "alertTag",
          "attachmentTag"
        ]
      },
      "alertTag": {
        "type": "Badge",
        "props": {
          "text": { "$item": "tag" },
          "tone": "warning",
          "variant": "soft"
        },
        "visible": { "$item": "tag" }
      },
      "attachmentTag": {
        "type": "Row",
        "props": {
          "gap": "xs",
          "align": "center"
        },
        "children": ["attachmentIcon", "attachmentLabel"],
        "visible": { "$item": "hasAttachments" }
      },
      "attachmentIcon": {
        "type": "Icon",
        "props": {
          "name": "Paperclip",
          "tone": "muted",
          "size": "xs"
        }
      },
      "attachmentLabel": {
        "type": "Caption",
        "props": {
          "text": "Attachment",
          "tone": "muted"
        }
      },
      "received": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "relative_time",
            "args": {
              "value": { "$item": "internalDate" }
            }
          },
          "tone": "muted"
        }
      },
      "rowDivider": {
        "type": "Divider",
        "props": {}
      },
      "divider": {
        "type": "Divider",
        "props": {}
      },
      "footer": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "justify": "between",
          "align": "center"
        },
        "children": [
          "footerCaption",
          "footerLink"
        ]
      },
      "footerCaption": {
        "type": "Caption",
        "props": {
          "text": "Similar alerts grouped · latest first",
          "tone": "muted"
        }
      },
      "footerLink": {
        "type": "Button",
        "props": {
          "label": "Open in Gmail",
          "variant": "primary",
          "tone": "info",
          "size": "sm",
          "leadingIcon": "Mail"
        },
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "url": "https://mail.google.com/mail/u/0/#inbox",
              "target": "_blank"
            }
          }
        }
      }
    }
  }
}
