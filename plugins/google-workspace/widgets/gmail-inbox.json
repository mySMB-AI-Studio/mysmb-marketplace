{
  "id": "google-workspace-gmail-inbox",
  "title": "Gmail Inbox",
  "description": "Recent unread Gmail messages — sender, subject, and relative timestamp. Click a row to read the full message.",
  "category": "productivity",
  "tags": [
    "google",
    "gmail",
    "inbox",
    "email",
    "productivity"
  ],
  "keywords": [
    "gmail",
    "email",
    "inbox",
    "unread",
    "messages",
    "mail",
    "google"
  ],
  "connectorsUsed": [
    "google-workspace-gmail"
  ],
  "popularity": 0,
  "sizing": {
    "preferred": {
      "colSpan": 6,
      "rowSpan": 6
    },
    "min": {
      "colSpan": 4,
      "rowSpan": 4
    },
    "max": {
      "colSpan": 12,
      "rowSpan": 12
    }
  },
  "dataProvider": {
    "mcp": "google-workspace-gmail",
    "tool": "list_messages",
    "params": {
      "labelIds": ["INBOX", "UNREAD"],
      "maxResults": 20
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "children": [
          "header",
          "body",
          "overlay"
        ]
      },
      "header": {
        "type": "Header",
        "children": [
          "titleRow"
        ]
      },
      "titleRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "start"
        },
        "children": [
          "titleIcon",
          "titleStack"
        ]
      },
      "titleIcon": {
        "type": "Icon",
        "props": {
          "name": "Mail",
          "tone": "accent",
          "size": "sm"
        }
      },
      "titleStack": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "children": [
          "title",
          "count"
        ]
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "Gmail Inbox",
          "level": "h2"
        }
      },
      "count": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{n} unread",
              "n": {
                "$computed": "count",
                "args": {
                  "value": {
                    "$state": "/google-workspace-gmail/list_messages/messages"
                  }
                }
              }
            }
          }
        }
      },
      "body": {
        "type": "Body",
        "children": [
          "loading",
          "empty",
          "list"
        ]
      },
      "loading": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "visible": {
          "$state": "/_loading/google-workspace-gmail.list_messages"
        },
        "children": [
          "sk1",
          "sk2",
          "sk3",
          "sk4"
        ]
      },
      "sk1": { "type": "Skeleton", "props": { "height": "2.75rem", "rounded": "md" } },
      "sk2": { "type": "Skeleton", "props": { "height": "2.75rem", "rounded": "md" } },
      "sk3": { "type": "Skeleton", "props": { "height": "2.75rem", "rounded": "md" } },
      "sk4": { "type": "Skeleton", "props": { "height": "2.75rem", "rounded": "md" } },
      "empty": {
        "type": "Empty",
        "props": {
          "message": "Inbox zero — enjoy it while it lasts."
        },
        "visible": {
          "$and": [
            {
              "$state": "/_loading/google-workspace-gmail.list_messages",
              "not": true
            },
            {
              "$state": "/google-workspace-gmail/list_messages/messages/0",
              "not": true
            }
          ]
        }
      },
      "list": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "visible": {
          "$state": "/_loading/google-workspace-gmail.list_messages",
          "not": true
        },
        "repeat": {
          "statePath": "/google-workspace-gmail/list_messages/messages",
          "key": "id"
        },
        "children": [
          "row"
        ]
      },
      "row": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "start",
          "hover": true,
          "clickable": true,
          "justify": "between"
        },
        "on": {
          "click": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/selectedMessageId",
                "value": {
                  "$computed": "identity",
                  "args": {
                    "value": {
                      "$item": "id"
                    }
                  }
                }
              }
            },
            {
              "action": "google-workspace-gmail.get_message",
              "params": {
                "id": {
                  "$computed": "identity",
                  "args": {
                    "value": {
                      "$item": "id"
                    }
                  }
                }
              }
            }
          ]
        },
        "children": [
          "avatar",
          "labels",
          "received"
        ]
      },
      "avatar": {
        "type": "Avatar",
        "props": {
          "initials": {
            "$computed": "initials",
            "args": {
              "value": {
                "$item": "from"
              }
            }
          },
          "size": "sm"
        }
      },
      "labels": {
        "type": "Stack",
        "props": {
          "gap": "xs",
          "grow": true
        },
        "children": [
          "labelTop",
          "labelBottom"
        ]
      },
      "labelTop": {
        "type": "Text",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{name} — {subject}",
              "name": {
                "$computed": "google_workspace_sender_name",
                "args": {
                  "value": {
                    "$item": "from"
                  }
                }
              },
              "subject": {
                "$item": "subject"
              }
            }
          },
          "size": "md",
          "weight": "medium",
          "truncate": true
        }
      },
      "labelBottom": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "snippet"
          },
          "size": "sm",
          "tone": "muted",
          "truncate": true
        }
      },
      "received": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "relative_time",
            "args": {
              "value": {
                "$item": "internalDate"
              }
            }
          }
        }
      },
      "overlay": {
        "type": "Overlay",
        "props": {
          "maxWidth": "48rem"
        },
        "children": [
          "detailCard"
        ],
        "visible": {
          "$state": "/ui/selectedMessageId"
        },
        "on": {
          "backdropClick": {
            "action": "setState",
            "params": {
              "statePath": "/ui/selectedMessageId",
              "value": ""
            }
          }
        }
      },
      "detailCard": {
        "type": "Card",
        "children": [
          "detailHeader",
          "detailSpinner",
          "detailBody"
        ]
      },
      "detailHeader": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center",
          "justify": "between"
        },
        "children": [
          "detailTitle",
          "detailClose"
        ]
      },
      "detailTitle": {
        "type": "Heading",
        "props": {
          "text": {
            "$state": "/google-workspace-gmail/get_message/subject"
          },
          "level": "h2"
        }
      },
      "detailClose": {
        "type": "IconButton",
        "props": {
          "icon": "X",
          "tone": "default",
          "ariaLabel": "Close",
          "size": "md",
          "variant": "outlined"
        },
        "on": {
          "click": {
            "action": "setState",
            "params": {
              "statePath": "/ui/selectedMessageId",
              "value": ""
            }
          }
        }
      },
      "detailSpinner": {
        "type": "Spinner",
        "props": {
          "label": "Loading message…"
        },
        "visible": {
          "$state": "/google-workspace-gmail/get_message/id",
          "neq": {
            "$state": "/ui/selectedMessageId"
          }
        }
      },
      "detailBody": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "visible": {
          "$state": "/google-workspace-gmail/get_message/id",
          "eq": {
            "$state": "/ui/selectedMessageId"
          }
        },
        "children": [
          "kvFrom",
          "kvDate",
          "bodySection",
          "detailActions"
        ]
      },
      "kvFrom": {
        "type": "KeyValue",
        "props": {
          "label": "From",
          "value": {
            "$state": "/google-workspace-gmail/get_message/from"
          }
        }
      },
      "kvDate": {
        "type": "KeyValue",
        "props": {
          "label": "Received",
          "value": {
            "$computed": "relative_time",
            "args": {
              "value": {
                "$state": "/google-workspace-gmail/get_message/internalDate"
              }
            }
          }
        }
      },
      "bodySection": {
        "type": "Section",
        "props": {
          "variant": "muted"
        },
        "children": [
          "bodyText"
        ]
      },
      "bodyText": {
        "type": "Body",
        "props": {
          "text": {
            "$state": "/google-workspace-gmail/get_message/snippet"
          }
        }
      },
      "detailActions": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "justify": "end"
        },
        "children": [
          "openGmailBtn"
        ]
      },
      "openGmailBtn": {
        "type": "Button",
        "props": {
          "label": "Open in Gmail",
          "variant": "primary",
          "size": "sm",
          "leadingIcon": "ExternalLink"
        },
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "url": {
                "$computed": "fmt",
                "args": {
                  "pattern": "https://mail.google.com/mail/u/0/#inbox/{id}",
                  "id": {
                    "$state": "/google-workspace-gmail/get_message/id"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
