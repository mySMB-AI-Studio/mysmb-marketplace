{
  "id": "google-workspace-calendar-today",
  "title": "Upcoming Events",
  "description": "Upcoming Google Calendar events — title, time range, and location. Click a row to open the event in Google Calendar.",
  "category": "productivity",
  "tags": [
    "google",
    "calendar",
    "events",
    "schedule",
    "productivity"
  ],
  "keywords": [
    "calendar",
    "events",
    "today",
    "schedule",
    "meetings",
    "google"
  ],
  "connectorsUsed": [
    "google-workspace-calendar"
  ],
  "popularity": 0,
  "sizing": {
    "preferred": {
      "colSpan": 6,
      "rowSpan": 6
    },
    "min": {
      "colSpan": 4,
      "rowSpan": 4
    },
    "max": {
      "colSpan": 12,
      "rowSpan": 12
    }
  },
  "dataProvider": {
    "mcp": "google-workspace-calendar",
    "tool": "list_events",
    "params": {
      "calendarId": "primary",
      "timeMin": "$today",
      "timeMax": "$today_end",
      "maxResults": 50,
      "orderBy": "startTime",
      "singleEvents": true
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "children": [
          "header",
          "body"
        ]
      },
      "header": {
        "type": "Header",
        "children": [
          "titleRow"
        ]
      },
      "titleRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "start"
        },
        "children": [
          "titleIcon",
          "titleStack"
        ]
      },
      "titleIcon": {
        "type": "Icon",
        "props": {
          "name": "CalendarDays",
          "tone": "accent",
          "size": "sm"
        }
      },
      "titleStack": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "children": [
          "title",
          "count"
        ]
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "Upcoming Events",
          "level": "h2"
        }
      },
      "count": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{n} events",
              "n": {
                "$computed": "count",
                "args": {
                  "value": {
                    "$state": "/google-workspace-calendar/list_events/items"
                  }
                }
              }
            }
          }
        }
      },
      "body": {
        "type": "Body",
        "children": [
          "loading",
          "empty",
          "list"
        ]
      },
      "loading": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "visible": {
          "$state": "/_loading/google-workspace-calendar.list_events"
        },
        "children": [
          "sk1",
          "sk2",
          "sk3"
        ]
      },
      "sk1": { "type": "Skeleton", "props": { "height": "3rem", "rounded": "md" } },
      "sk2": { "type": "Skeleton", "props": { "height": "3rem", "rounded": "md" } },
      "sk3": { "type": "Skeleton", "props": { "height": "3rem", "rounded": "md" } },
      "empty": {
        "type": "Empty",
        "props": {
          "message": "No upcoming events — go do deep work."
        },
        "visible": {
          "$and": [
            {
              "$state": "/_loading/google-workspace-calendar.list_events",
              "not": true
            },
            {
              "$state": "/google-workspace-calendar/list_events/items/0",
              "not": true
            }
          ]
        }
      },
      "list": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "visible": {
          "$state": "/_loading/google-workspace-calendar.list_events",
          "not": true
        },
        "repeat": {
          "statePath": "/google-workspace-calendar/list_events/items",
          "key": "id"
        },
        "children": [
          "row"
        ]
      },
      "row": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "start",
          "hover": true,
          "clickable": true,
          "template": "4.5rem 1fr"
        },
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "url": {
                "$computed": "identity",
                "args": { "value": { "$item": "htmlLink" } }
              },
              "target": "_blank"
            }
          }
        },
        "children": [
          "timePill",
          "labels"
        ]
      },
      "timePill": {
        "type": "Badge",
        "props": {
          "text": {
            "$computed": "format_time",
            "args": {
              "value": {
                "$item": "start/dateTime"
              }
            }
          },
          "tone": "accent",
          "variant": "soft"
        }
      },
      "labels": {
        "type": "Stack",
        "props": {
          "gap": "xs",
          "grow": true
        },
        "children": [
          "eventTitle",
          "eventSchedule",
          "eventLocation"
        ]
      },
      "eventTitle": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "summary"
          },
          "size": "md",
          "weight": "medium",
          "truncate": true
        }
      },
      "eventSchedule": {
        "type": "Text",
        "props": {
          "size": "sm",
          "tone": "muted",
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{start} – {end} · {dur}",
              "start": {
                "$computed": "format_time",
                "args": {
                  "value": {
                    "$item": "start/dateTime"
                  }
                }
              },
              "end": {
                "$computed": "format_time",
                "args": {
                  "value": {
                    "$item": "end/dateTime"
                  }
                }
              },
              "dur": {
                "$computed": "duration_between",
                "args": {
                  "start": {
                    "$item": "start/dateTime"
                  },
                  "end": {
                    "$item": "end/dateTime"
                  }
                }
              }
            }
          }
        }
      },
      "eventLocation": {
        "type": "Caption",
        "props": {
          "text": {
            "$item": "location"
          },
          "tone": "muted",
          "truncate": true
        },
        "visible": {
          "$item": "location"
        }
      }
    }
  }
}
