{
  "id": "google-workspace-calendar-today",
  "title": "Upcoming Events",
  "description": "Upcoming Google Calendar events — title, time range, and location. Click a row to see attendees and a join link.",
  "category": "productivity",
  "tags": [
    "google",
    "calendar",
    "events",
    "schedule",
    "productivity"
  ],
  "keywords": [
    "calendar",
    "events",
    "today",
    "schedule",
    "meetings",
    "google"
  ],
  "connectorsUsed": [
    "google-workspace-calendar"
  ],
  "popularity": 0,
  "sizing": {
    "preferred": {
      "colSpan": 6,
      "rowSpan": 6
    },
    "min": {
      "colSpan": 4,
      "rowSpan": 4
    },
    "max": {
      "colSpan": 12,
      "rowSpan": 12
    }
  },
  "dataProvider": {
    "mcp": "google-workspace-calendar",
    "tool": "list_events",
    "params": {
      "calendarId": "primary",
      "timeMin": "$today",
      "timeMax": "$today_end",
      "maxResults": 50,
      "orderBy": "startTime",
      "singleEvents": true
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "children": [
          "header",
          "body",
          "overlay"
        ]
      },
      "header": {
        "type": "Header",
        "children": [
          "titleRow"
        ]
      },
      "titleRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "start"
        },
        "children": [
          "titleIcon",
          "titleStack"
        ]
      },
      "titleIcon": {
        "type": "Icon",
        "props": {
          "name": "CalendarDays",
          "tone": "accent",
          "size": "sm"
        }
      },
      "titleStack": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "children": [
          "title",
          "count"
        ]
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "Upcoming Events",
          "level": "h2"
        }
      },
      "count": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{n} events",
              "n": {
                "$computed": "count",
                "args": {
                  "value": {
                    "$state": "/google-workspace-calendar/list_events/items"
                  }
                }
              }
            }
          }
        }
      },
      "body": {
        "type": "Body",
        "children": [
          "loading",
          "empty",
          "list"
        ]
      },
      "loading": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "visible": {
          "$state": "/_loading/google-workspace-calendar.list_events"
        },
        "children": [
          "sk1",
          "sk2",
          "sk3"
        ]
      },
      "sk1": { "type": "Skeleton", "props": { "height": "3rem", "rounded": "md" } },
      "sk2": { "type": "Skeleton", "props": { "height": "3rem", "rounded": "md" } },
      "sk3": { "type": "Skeleton", "props": { "height": "3rem", "rounded": "md" } },
      "empty": {
        "type": "Empty",
        "props": {
          "message": "No upcoming events — go do deep work."
        },
        "visible": {
          "$and": [
            {
              "$state": "/_loading/google-workspace-calendar.list_events",
              "not": true
            },
            {
              "$state": "/google-workspace-calendar/list_events/items/0",
              "not": true
            }
          ]
        }
      },
      "list": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "visible": {
          "$state": "/_loading/google-workspace-calendar.list_events",
          "not": true
        },
        "repeat": {
          "statePath": "/google-workspace-calendar/list_events/items",
          "key": "id"
        },
        "children": [
          "row"
        ]
      },
      "row": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "start",
          "hover": true,
          "clickable": true,
          "template": "4.5rem 1fr"
        },
        "on": {
          "click": [
            {
              "action": "setState",
              "params": {
                "statePath": "/_errors/google-workspace-calendar.get_event",
                "value": ""
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/selectedEventId",
                "value": {
                  "$computed": "identity",
                  "args": {
                    "value": {
                      "$item": "id"
                    }
                  }
                }
              }
            },
            {
              "action": "google-workspace-calendar.get_event",
              "params": {
                "calendarId": "primary",
                "eventId": {
                  "$computed": "identity",
                  "args": {
                    "value": {
                      "$item": "id"
                    }
                  }
                }
              }
            }
          ]
        },
        "children": [
          "timePill",
          "labels"
        ]
      },
      "timePill": {
        "type": "Badge",
        "props": {
          "text": {
            "$computed": "format_time",
            "args": {
              "value": {
                "$item": "start/dateTime"
              }
            }
          },
          "tone": "accent",
          "variant": "soft"
        }
      },
      "labels": {
        "type": "Stack",
        "props": {
          "gap": "xs",
          "grow": true
        },
        "children": [
          "eventTitle",
          "eventSchedule",
          "eventLocation"
        ]
      },
      "eventTitle": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "summary"
          },
          "size": "md",
          "weight": "medium",
          "truncate": true
        }
      },
      "eventSchedule": {
        "type": "Text",
        "props": {
          "size": "sm",
          "tone": "muted",
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{start} – {end} · {dur}",
              "start": {
                "$computed": "format_time",
                "args": {
                  "value": {
                    "$item": "start/dateTime"
                  }
                }
              },
              "end": {
                "$computed": "format_time",
                "args": {
                  "value": {
                    "$item": "end/dateTime"
                  }
                }
              },
              "dur": {
                "$computed": "duration_between",
                "args": {
                  "start": {
                    "$item": "start/dateTime"
                  },
                  "end": {
                    "$item": "end/dateTime"
                  }
                }
              }
            }
          }
        }
      },
      "eventLocation": {
        "type": "Caption",
        "props": {
          "text": {
            "$item": "location"
          },
          "tone": "muted",
          "truncate": true
        },
        "visible": {
          "$item": "location"
        }
      },
      "overlay": {
        "type": "Overlay",
        "props": {
          "maxWidth": "36rem"
        },
        "children": [
          "detailCard"
        ],
        "visible": {
          "$state": "/ui/selectedEventId"
        },
        "on": {
          "backdropClick": {
            "action": "setState",
            "params": {
              "statePath": "/ui/selectedEventId",
              "value": ""
            }
          }
        }
      },
      "detailCard": {
        "type": "Card",
        "children": [
          "detailHeader",
          "detailSpinner",
          "detailError",
          "detailBody"
        ]
      },
      "detailHeader": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center",
          "justify": "between"
        },
        "children": [
          "detailTitle",
          "detailClose"
        ]
      },
      "detailTitle": {
        "type": "Heading",
        "props": {
          "text": {
            "$state": "/google-workspace-calendar/get_event/summary"
          },
          "level": "h2"
        }
      },
      "detailClose": {
        "type": "IconButton",
        "props": {
          "icon": "X",
          "tone": "default",
          "ariaLabel": "Close",
          "size": "md",
          "variant": "outlined"
        },
        "on": {
          "click": {
            "action": "setState",
            "params": {
              "statePath": "/ui/selectedEventId",
              "value": ""
            }
          }
        }
      },
      "detailSpinner": {
        "type": "Spinner",
        "props": {
          "label": "Loading event…"
        },
        "visible": {
          "$and": [
            {
              "$state": "/_errors/google-workspace-calendar.get_event",
              "not": true
            },
            {
              "$state": "/google-workspace-calendar/get_event/id",
              "neq": {
                "$state": "/ui/selectedEventId"
              }
            }
          ]
        }
      },
      "detailError": {
        "type": "Empty",
        "props": {
          "message": "Couldn’t load this event. Close and try again."
        },
        "visible": {
          "$state": "/_errors/google-workspace-calendar.get_event"
        }
      },
      "detailBody": {
        "type": "Stack",
        "props": {
          "gap": "md"
        },
        "visible": {
          "$state": "/google-workspace-calendar/get_event/id",
          "eq": {
            "$state": "/ui/selectedEventId"
          }
        },
        "children": [
          "detailMeta",
          "attDivider",
          "attHeader",
          "attList",
          "linksRow"
        ]
      },
      "detailMeta": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "kvWhen",
          "kvOrganizer",
          "kvLocation"
        ]
      },
      "kvWhen": {
        "type": "KeyValue",
        "props": {
          "label": "When",
          "value": {
            "$computed": "fmt",
            "args": {
              "pattern": "{date} · {start} – {end}",
              "date": {
                "$computed": "format_date",
                "args": {
                  "value": {
                    "$state": "/google-workspace-calendar/get_event/start/dateTime"
                  },
                  "format": "long"
                }
              },
              "start": {
                "$computed": "format_time",
                "args": {
                  "value": {
                    "$state": "/google-workspace-calendar/get_event/start/dateTime"
                  }
                }
              },
              "end": {
                "$computed": "format_time",
                "args": {
                  "value": {
                    "$state": "/google-workspace-calendar/get_event/end/dateTime"
                  }
                }
              }
            }
          }
        }
      },
      "kvOrganizer": {
        "type": "KeyValue",
        "props": {
          "label": "Organizer",
          "value": {
            "$state": "/google-workspace-calendar/get_event/organizer/email"
          }
        }
      },
      "kvLocation": {
        "type": "KeyValue",
        "props": {
          "label": "Where",
          "value": {
            "$state": "/google-workspace-calendar/get_event/location"
          }
        },
        "visible": {
          "$state": "/google-workspace-calendar/get_event/location"
        }
      },
      "attDivider": {
        "type": "Divider"
      },
      "attHeader": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{n} Attendees",
              "n": {
                "$computed": "count",
                "args": {
                  "value": {
                    "$state": "/google-workspace-calendar/get_event/attendees"
                  }
                }
              }
            }
          }
        }
      },
      "attList": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "repeat": {
          "statePath": "/google-workspace-calendar/get_event/attendees",
          "key": "email"
        },
        "children": [
          "attRow"
        ]
      },
      "attRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center"
        },
        "children": [
          "attAvatar",
          "attName"
        ]
      },
      "attAvatar": {
        "type": "Avatar",
        "props": {
          "initials": {
            "$computed": "initials",
            "args": {
              "value": {
                "$item": "displayName"
              }
            }
          },
          "size": "sm"
        }
      },
      "attName": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "displayName"
          },
          "size": "sm",
          "truncate": true
        }
      },
      "linksRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "justify": "end"
        },
        "children": [
          "joinBtn",
          "calBtn"
        ]
      },
      "joinBtn": {
        "type": "Button",
        "props": {
          "label": "Join meeting",
          "variant": "primary",
          "size": "sm",
          "leadingIcon": "Video"
        },
        "visible": {
          "$state": "/google-workspace-calendar/get_event/hangoutLink"
        },
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "url": {
                "$state": "/google-workspace-calendar/get_event/hangoutLink"
              }
            }
          }
        }
      },
      "calBtn": {
        "type": "Button",
        "props": {
          "label": "Open in Calendar",
          "variant": "ghost",
          "size": "sm",
          "leadingIcon": "ExternalLink"
        },
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "url": {
                "$state": "/google-workspace-calendar/get_event/htmlLink"
              }
            }
          }
        }
      }
    }
  }
}
