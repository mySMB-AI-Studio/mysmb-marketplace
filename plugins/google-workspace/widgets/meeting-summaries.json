{
  "id": "google-workspace-meeting-summaries",
  "title": "Meeting Summaries",
  "description": "Recent Google Meet meetings with their transcripts. Transcripts that haven't been summarised yet can be summarised on demand — one at a time, or all at once — into a 2-3 sentence overview, decisions, and action items with assignees. Click a card to expand it; open the matching Calendar event or the full transcript from there.",
  "category": "productivity",
  "tags": [
    "google",
    "meet",
    "meetings",
    "summaries",
    "productivity"
  ],
  "keywords": [
    "meet",
    "meetings",
    "summary",
    "summaries",
    "action items",
    "decisions",
    "transcript",
    "google meet",
    "ai"
  ],
  "connectorsUsed": [
    "google-workspace-meet"
  ],
  "brandColor": "#00ac47",
  "popularity": 0,
  "sizing": {
    "preferred": {
      "colSpan": 6,
      "rowSpan": 9
    },
    "min": {
      "colSpan": 5,
      "rowSpan": 7
    },
    "max": {
      "colSpan": 12,
      "rowSpan": 12
    }
  },
  "dataProvider": {
    "mcp": "google-workspace-meet",
    "tool": "get_meeting_summaries_dashboard",
    "params": {}
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "children": [
          "header",
          "body"
        ],
        "watch": {
          "/google-workspace-meet/get_meeting_summaries_dashboard/meetings": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/meetingSummariesView",
                "value": {
                  "$computed": "google-workspace_build_meeting_summaries_view",
                  "args": {
                    "meetings": { "$state": "/google-workspace-meet/get_meeting_summaries_dashboard/meetings" },
                    "stats": { "$state": "/google-workspace-meet/get_meeting_summaries_dashboard/stats" },
                    "aiUnavailable": { "$state": "/google-workspace-meet/get_meeting_summaries_dashboard/aiUnavailable" },
                    "tab": { "$state": "/ui/meetingSummariesTab" },
                    "expandedId": { "$state": "/ui/meetingSummariesExpandedId" },
                    "summarizeId": { "$state": "/google-workspace-meet/summarize_meeting_transcript/id" },
                    "summarizeOk": { "$state": "/google-workspace-meet/summarize_meeting_transcript/ok" },
                    "summarizeSummary": { "$state": "/google-workspace-meet/summarize_meeting_transcript/summary" },
                    "summarizeDecisions": { "$state": "/google-workspace-meet/summarize_meeting_transcript/decisions" },
                    "summarizeActionItems": { "$state": "/google-workspace-meet/summarize_meeting_transcript/actionItems" },
                    "summarizeError": { "$state": "/google-workspace-meet/summarize_meeting_transcript/error" }
                  }
                }
              }
            }
          ],
          "/ui/meetingSummariesTab": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/meetingSummariesView",
                "value": {
                  "$computed": "google-workspace_build_meeting_summaries_view",
                  "args": {
                    "meetings": { "$state": "/google-workspace-meet/get_meeting_summaries_dashboard/meetings" },
                    "stats": { "$state": "/google-workspace-meet/get_meeting_summaries_dashboard/stats" },
                    "aiUnavailable": { "$state": "/google-workspace-meet/get_meeting_summaries_dashboard/aiUnavailable" },
                    "tab": { "$state": "/ui/meetingSummariesTab" },
                    "expandedId": { "$state": "/ui/meetingSummariesExpandedId" },
                    "summarizeId": { "$state": "/google-workspace-meet/summarize_meeting_transcript/id" },
                    "summarizeOk": { "$state": "/google-workspace-meet/summarize_meeting_transcript/ok" },
                    "summarizeSummary": { "$state": "/google-workspace-meet/summarize_meeting_transcript/summary" },
                    "summarizeDecisions": { "$state": "/google-workspace-meet/summarize_meeting_transcript/decisions" },
                    "summarizeActionItems": { "$state": "/google-workspace-meet/summarize_meeting_transcript/actionItems" },
                    "summarizeError": { "$state": "/google-workspace-meet/summarize_meeting_transcript/error" }
                  }
                }
              }
            }
          ],
          "/ui/meetingSummariesExpandedId": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/meetingSummariesView",
                "value": {
                  "$computed": "google-workspace_build_meeting_summaries_view",
                  "args": {
                    "meetings": { "$state": "/google-workspace-meet/get_meeting_summaries_dashboard/meetings" },
                    "stats": { "$state": "/google-workspace-meet/get_meeting_summaries_dashboard/stats" },
                    "aiUnavailable": { "$state": "/google-workspace-meet/get_meeting_summaries_dashboard/aiUnavailable" },
                    "tab": { "$state": "/ui/meetingSummariesTab" },
                    "expandedId": { "$state": "/ui/meetingSummariesExpandedId" },
                    "summarizeId": { "$state": "/google-workspace-meet/summarize_meeting_transcript/id" },
                    "summarizeOk": { "$state": "/google-workspace-meet/summarize_meeting_transcript/ok" },
                    "summarizeSummary": { "$state": "/google-workspace-meet/summarize_meeting_transcript/summary" },
                    "summarizeDecisions": { "$state": "/google-workspace-meet/summarize_meeting_transcript/decisions" },
                    "summarizeActionItems": { "$state": "/google-workspace-meet/summarize_meeting_transcript/actionItems" },
                    "summarizeError": { "$state": "/google-workspace-meet/summarize_meeting_transcript/error" }
                  }
                }
              }
            }
          ],
          "/_loading/google-workspace-meet.summarize_meeting_transcript": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/meetingSummariesView",
                "value": {
                  "$computed": "google-workspace_build_meeting_summaries_view",
                  "args": {
                    "meetings": { "$state": "/google-workspace-meet/get_meeting_summaries_dashboard/meetings" },
                    "stats": { "$state": "/google-workspace-meet/get_meeting_summaries_dashboard/stats" },
                    "aiUnavailable": { "$state": "/google-workspace-meet/get_meeting_summaries_dashboard/aiUnavailable" },
                    "tab": { "$state": "/ui/meetingSummariesTab" },
                    "expandedId": { "$state": "/ui/meetingSummariesExpandedId" },
                    "summarizeId": { "$state": "/google-workspace-meet/summarize_meeting_transcript/id" },
                    "summarizeOk": { "$state": "/google-workspace-meet/summarize_meeting_transcript/ok" },
                    "summarizeSummary": { "$state": "/google-workspace-meet/summarize_meeting_transcript/summary" },
                    "summarizeDecisions": { "$state": "/google-workspace-meet/summarize_meeting_transcript/decisions" },
                    "summarizeActionItems": { "$state": "/google-workspace-meet/summarize_meeting_transcript/actionItems" },
                    "summarizeError": { "$state": "/google-workspace-meet/summarize_meeting_transcript/error" }
                  }
                }
              }
            }
          ]
        }
      },
      "header": {
        "type": "Header",
        "children": [
          "headerRow"
        ]
      },
      "headerRow": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center", "justify": "between" },
        "children": [
          "titleRow",
          "workspaceBadge"
        ]
      },
      "titleRow": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": [
          "titleIcon",
          "titleStack"
        ]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "Video", "tone": "default", "size": "lg" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": [
          "titleConnector",
          "titleSubtitle"
        ]
      },
      "titleConnector": {
        "type": "Heading",
        "props": { "text": "GOOGLE MEET", "level": "h1" }
      },
      "titleSubtitle": {
        "type": "Caption",
        "props": { "text": "Meeting Summaries", "tone": "muted" }
      },
      "workspaceBadge": {
        "type": "Badge",
        "props": { "text": "Google Workspace", "tone": "muted", "variant": "outline" }
      },
      "body": {
        "type": "Body",
        "children": [
          "loading",
          "empty",
          "content"
        ]
      },
      "loading": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "visible": { "$state": "/_loading/google-workspace-meet.get_meeting_summaries_dashboard" },
        "children": ["sk1", "sk2", "sk3"]
      },
      "sk1": { "type": "Skeleton", "props": { "height": "4rem", "rounded": "md" } },
      "sk2": { "type": "Skeleton", "props": { "height": "4rem", "rounded": "md" } },
      "sk3": { "type": "Skeleton", "props": { "height": "4rem", "rounded": "md" } },
      "empty": {
        "type": "Empty",
        "props": { "message": "No recent meetings with transcripts." },
        "visible": {
          "$and": [
            { "$state": "/_loading/google-workspace-meet.get_meeting_summaries_dashboard", "not": true },
            { "$state": "/google-workspace-meet/get_meeting_summaries_dashboard/meetings/0", "not": true }
          ]
        }
      },
      "content": {
        "type": "Stack",
        "props": { "gap": "md" },
        "visible": { "$state": "/_loading/google-workspace-meet.get_meeting_summaries_dashboard", "not": true },
        "children": [
          "summariseBanner",
          "tabsRow",
          "list",
          "footer"
        ]
      },
      "summariseBanner": {
        "type": "Section",
        "props": { "variant": "muted" },
        "visible": { "$state": "/ui/meetingSummariesView/banner/visible" },
        "children": ["summariseBannerRow"]
      },
      "summariseBannerRow": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center", "justify": "between" },
        "children": ["summariseBannerTextGrow", "summariseAllButton"]
      },
      "summariseBannerTextGrow": {
        "type": "Stack",
        "props": { "gap": "xs", "grow": true },
        "children": ["summariseBannerHeadline", "summariseBannerDetail"]
      },
      "summariseBannerHeadline": {
        "type": "Text",
        "props": {
          "text": { "$state": "/ui/meetingSummariesView/banner/headline" },
          "size": "sm",
          "weight": "medium"
        }
      },
      "summariseBannerDetail": {
        "type": "Caption",
        "props": { "text": { "$state": "/ui/meetingSummariesView/banner/detail" }, "tone": "muted" }
      },
      "summariseAllButton": {
        "type": "Button",
        "props": { "label": "Summarize all", "variant": "primary", "size": "sm", "leadingIcon": "Sparkles" },
        "visible": { "$state": "/ui/meetingSummariesView/banner/canSummarizeAll" },
        "on": {
          "click": [
            {
              "action": "bust_tool_cache",
              "params": { "mcp": "google-workspace-meet", "tool": "get_meeting_summaries_dashboard" }
            },
            {
              "action": "google-workspace-meet.get_meeting_summaries_dashboard",
              "params": {}
            }
          ]
        }
      },
      "tabsRow": {
        "type": "Row",
        "props": { "gap": "md", "align": "center" },
        "children": ["tabAll", "tabWithActions", "tabNotSummarised"]
      },
      "tabAll": {
        "type": "Row",
        "props": { "clickable": true },
        "children": ["tabAllActive", "tabAllInactive"],
        "on": { "click": { "action": "setState", "params": { "statePath": "/ui/meetingSummariesTab", "value": "all" } } }
      },
      "tabAllActive": {
        "type": "Badge",
        "props": {
          "text": { "$computed": "fmt", "args": { "pattern": "All {n}", "n": { "$state": "/ui/meetingSummariesView/counts/all" } } },
          "tone": "success",
          "variant": "soft"
        },
        "visible": {
          "$or": [
            { "$state": "/ui/meetingSummariesTab", "eq": "all" },
            { "$state": "/ui/meetingSummariesTab", "not": true }
          ]
        }
      },
      "tabAllInactive": {
        "type": "Text",
        "props": {
          "text": { "$computed": "fmt", "args": { "pattern": "All {n}", "n": { "$state": "/ui/meetingSummariesView/counts/all" } } },
          "size": "sm",
          "tone": "muted"
        },
        "visible": {
          "$and": [
            { "$state": "/ui/meetingSummariesTab" },
            { "$state": "/ui/meetingSummariesTab", "eq": "all", "not": true }
          ]
        }
      },
      "tabWithActions": {
        "type": "Row",
        "props": { "clickable": true },
        "children": ["tabWithActionsActive", "tabWithActionsInactive"],
        "on": { "click": { "action": "setState", "params": { "statePath": "/ui/meetingSummariesTab", "value": "withActions" } } }
      },
      "tabWithActionsActive": {
        "type": "Badge",
        "props": {
          "text": { "$computed": "fmt", "args": { "pattern": "With action items {n}", "n": { "$state": "/ui/meetingSummariesView/counts/withActions" } } },
          "tone": "warning",
          "variant": "soft"
        },
        "visible": { "$state": "/ui/meetingSummariesTab", "eq": "withActions" }
      },
      "tabWithActionsInactive": {
        "type": "Text",
        "props": {
          "text": { "$computed": "fmt", "args": { "pattern": "With action items {n}", "n": { "$state": "/ui/meetingSummariesView/counts/withActions" } } },
          "size": "sm",
          "tone": "muted"
        },
        "visible": { "$state": "/ui/meetingSummariesTab", "eq": "withActions", "not": true }
      },
      "tabNotSummarised": {
        "type": "Row",
        "props": { "clickable": true },
        "children": ["tabNotSummarisedActive", "tabNotSummarisedInactive"],
        "on": { "click": { "action": "setState", "params": { "statePath": "/ui/meetingSummariesTab", "value": "notSummarised" } } }
      },
      "tabNotSummarisedActive": {
        "type": "Badge",
        "props": {
          "text": { "$computed": "fmt", "args": { "pattern": "Not summarised {n}", "n": { "$state": "/ui/meetingSummariesView/counts/notSummarised" } } },
          "tone": "accent",
          "variant": "soft"
        },
        "visible": { "$state": "/ui/meetingSummariesTab", "eq": "notSummarised" }
      },
      "tabNotSummarisedInactive": {
        "type": "Text",
        "props": {
          "text": { "$computed": "fmt", "args": { "pattern": "Not summarised {n}", "n": { "$state": "/ui/meetingSummariesView/counts/notSummarised" } } },
          "size": "sm",
          "tone": "muted"
        },
        "visible": { "$state": "/ui/meetingSummariesTab", "eq": "notSummarised", "not": true }
      },
      "list": {
        "type": "Stack",
        "props": { "gap": "none" },
        "repeat": { "statePath": "/ui/meetingSummariesView/rows", "key": "id" },
        "children": ["rowWrap"]
      },
      "rowWrap": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["collapsedRow", "expandedContent", "rowDivider"]
      },
      "collapsedRow": {
        "type": "Row",
        "props": { "gap": "sm", "align": "start", "hover": true, "clickable": true, "justify": "between" },
        "on": {
          "click": {
            "action": "setState",
            "params": {
              "statePath": "/ui/meetingSummariesExpandedId",
              "value": { "$computed": "identity", "args": { "value": { "$item": "toggleId" } } }
            }
          }
        },
        "children": ["dateBadgeGrow", "rowMain", "collapsedTrailing"]
      },
      "dateBadgeGrow": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["dateBadge"]
      },
      "dateBadge": {
        "type": "Section",
        "props": { "variant": "bordered" },
        "children": ["dateBadgeStack"]
      },
      "dateBadgeStack": {
        "type": "Stack",
        "props": { "gap": "none", "align": "center" },
        "children": ["dateBadgeDay", "dateBadgeMonth"]
      },
      "dateBadgeDay": {
        "type": "Text",
        "props": { "text": { "$item": "dayNumber" }, "size": "sm", "weight": "medium" }
      },
      "dateBadgeMonth": {
        "type": "Caption",
        "props": { "text": { "$item": "monthAbbrev" }, "tone": "muted" }
      },
      "rowMain": {
        "type": "Stack",
        "props": { "gap": "xs", "grow": true },
        "children": ["rowTitleRow", "rowMetaRow"]
      },
      "rowTitleRow": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["rowTitle", "rowMeetingCode"]
      },
      "rowTitle": {
        "type": "Text",
        "props": { "text": { "$item": "title" }, "size": "sm", "weight": "medium", "truncate": true }
      },
      "rowMeetingCode": {
        "type": "Caption",
        "props": { "text": { "$item": "meetingCode" }, "tone": "muted" },
        "visible": { "$item": "hasMeetingCode" }
      },
      "rowMetaRow": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["rowParticipants", "rowSchedule"]
      },
      "rowParticipants": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["participantAvatar1", "participantAvatar2", "participantAvatar3", "participantAvatar4", "participantOverflowBadge"]
      },
      "participantAvatar1": {
        "type": "Avatar",
        "props": { "initials": { "$item": "participant1/initials" }, "tone": { "$item": "participant1/tone" }, "size": "sm" },
        "visible": { "$item": "participant1/visible" }
      },
      "participantAvatar2": {
        "type": "Avatar",
        "props": { "initials": { "$item": "participant2/initials" }, "tone": { "$item": "participant2/tone" }, "size": "sm" },
        "visible": { "$item": "participant2/visible" }
      },
      "participantAvatar3": {
        "type": "Avatar",
        "props": { "initials": { "$item": "participant3/initials" }, "tone": { "$item": "participant3/tone" }, "size": "sm" },
        "visible": { "$item": "participant3/visible" }
      },
      "participantAvatar4": {
        "type": "Avatar",
        "props": { "initials": { "$item": "participant4/initials" }, "tone": { "$item": "participant4/tone" }, "size": "sm" },
        "visible": { "$item": "participant4/visible" }
      },
      "participantOverflowBadge": {
        "type": "Caption",
        "props": {
          "text": { "$computed": "fmt", "args": { "pattern": "+{n}", "n": { "$item": "participantOverflow" } } },
          "tone": "muted"
        },
        "visible": { "$item": "hasParticipantOverflow" }
      },
      "rowSchedule": {
        "type": "Caption",
        "props": { "text": { "$item": "scheduleLabel" }, "tone": "muted" }
      },
      "collapsedTrailing": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["statusBadge", "chevronIcon"]
      },
      "statusBadge": {
        "type": "Badge",
        "props": {
          "text": { "$item": "statusBadgeLabel" },
          "tone": { "$item": "statusBadgeTone" },
          "variant": "soft"
        }
      },
      "chevronIcon": {
        "type": "Icon",
        "props": { "name": { "$item": "chevronIcon" }, "tone": "muted", "size": "sm" }
      },
      "expandedContent": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "visible": { "$item": "expanded" },
        "children": [
          "noTranscriptNotice",
          "summarizePanel",
          "summarizeErrorNotice",
          "summaryRow",
          "decisionsSection",
          "actionItemsSection",
          "linksRow"
        ]
      },
      "noTranscriptNotice": {
        "type": "Caption",
        "props": { "text": "No transcript for this meeting.", "tone": "muted" },
        "visible": { "$item": "hasTranscript", "not": true }
      },
      "summarizePanel": {
        "type": "Section",
        "props": { "variant": "bordered" },
        "visible": { "$item": "showSummarizePanel" },
        "children": ["summarizePanelRow"]
      },
      "summarizePanelRow": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center", "justify": "between" },
        "children": ["summarizePanelTextGrow", "summarizeButton"]
      },
      "summarizePanelTextGrow": {
        "type": "Stack",
        "props": { "gap": "xs", "grow": true },
        "children": ["summarizePanelTitle", "summarizePanelDetail"]
      },
      "summarizePanelTitle": {
        "type": "Text",
        "props": { "text": "No summary yet", "size": "sm", "weight": "medium" }
      },
      "summarizePanelDetail": {
        "type": "Caption",
        "props": { "text": { "$item": "readyDetail" }, "tone": "muted" }
      },
      "summarizeButton": {
        "type": "Button",
        "props": { "label": "Summarize", "variant": "primary", "size": "sm", "leadingIcon": "Sparkles" },
        "visible": { "$item": "canSummarize" },
        "on": {
          "click": {
            "action": "google-workspace-meet.summarize_meeting_transcript",
            "params": {
              "conferenceRecordName": { "$computed": "identity", "args": { "value": { "$item": "id" } } }
            }
          }
        }
      },
      "summarizeErrorNotice": {
        "type": "Caption",
        "props": { "text": { "$item": "summarizeError" }, "tone": "destructive" },
        "visible": { "$item": "hasSummarizeError" }
      },
      "summaryRow": {
        "type": "Row",
        "props": { "gap": "xs", "align": "start" },
        "visible": { "$item": "hasSummary" },
        "children": ["summaryIcon", "summaryText"]
      },
      "summaryIcon": {
        "type": "Icon",
        "props": { "name": "Sparkles", "tone": "brand", "size": "xs" }
      },
      "summaryText": {
        "type": "Text",
        "props": { "text": { "$item": "summary" }, "size": "sm" }
      },
      "decisionsSection": {
        "type": "Section",
        "props": { "variant": "muted" },
        "visible": { "$item": "hasDecisions" },
        "children": ["decisionsStack"]
      },
      "decisionsStack": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["decisionsHeader", "decisionsList"]
      },
      "decisionsHeader": {
        "type": "Caption",
        "props": { "text": "DECISIONS", "tone": "muted" }
      },
      "decisionsList": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["decisionRow1", "decisionRow2", "decisionRow3", "decisionRow4"]
      },
      "decisionRow1": {
        "type": "Row",
        "props": { "gap": "xs", "align": "start" },
        "visible": { "$item": "decision1/visible" },
        "children": ["decisionBullet1", "decisionText1"]
      },
      "decisionBullet1": { "type": "Icon", "props": { "name": "Diamond", "tone": "muted", "size": "xs" } },
      "decisionText1": { "type": "Text", "props": { "text": { "$item": "decision1/text" }, "size": "sm" } },
      "decisionRow2": {
        "type": "Row",
        "props": { "gap": "xs", "align": "start" },
        "visible": { "$item": "decision2/visible" },
        "children": ["decisionBullet2", "decisionText2"]
      },
