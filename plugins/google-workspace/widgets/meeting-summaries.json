        "visible": { "$item": "actionItem5/hasAssignee" }
      },
      "linksRow": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["calendarEventButton", "transcriptLinkButton"]
      },
      "calendarEventButton": {
        "type": "Button",
        "props": { "label": "Calendar event", "variant": "secondary", "size": "sm", "leadingIcon": "Calendar" },
        "visible": { "$item": "calendarEventUrl" },
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "url": { "$computed": "identity", "args": { "value": { "$item": "calendarEventUrl" } } },
              "target": "_blank"
            }
          }
        }
      },
      "transcriptLinkButton": {
        "type": "Button",
        "props": { "label": "Open transcript", "variant": "secondary", "size": "sm", "leadingIcon": "FileText" },
        "visible": { "$item": "docUrl" },
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "url": { "$computed": "identity", "args": { "value": { "$item": "docUrl" } } },
              "target": "_blank"
            }
          }
        }
      },
