{
  "id": "talkdesk-call-history",
  "title": "Call History (12 Months)",
  "description": "Trailing 12-month inbound call volume from Talkdesk — visualised as a line chart.",
  "category": "support",
  "tags": ["talkdesk", "calls", "history", "trend", "support"],
  "keywords": ["call volume", "call history", "trend", "talkdesk", "12 months"],
  "connectorsUsed": ["talkdesk"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 6, "rowSpan": 4 },
    "min":       { "colSpan": 4, "rowSpan": 3 },
    "max":       { "colSpan": 12, "rowSpan": 6 }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "children": ["headerRow", "summaryRow", "chart", "axis"]
      },
      "headerRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["titleGroup", "brandBadge"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "PhoneCall", "tone": "accent", "size": "sm" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["hTitle", "hEyebrow"]
      },
      "hTitle": {
        "type": "Heading",
        "props": { "text": "Call History", "level": "h2" }
      },
      "hEyebrow": {
        "type": "Eyebrow",
        "props": { "text": "Talkdesk · Trailing 12 Months" }
      },
      "brandBadge": {
        "type": "Badge",
        "props": { "label": "talkdesk", "tone": "success" }
      },

      "summaryRow": {
        "type": "Row",
        "props": { "gap": "lg", "align": "center" },
        "children": ["statTotal", "statAvg", "statPeak"]
      },
      "statTotal": {
        "type": "Stat",
        "props": { "label": "Total Calls", "value": 18420 }
      },
      "statAvg": {
        "type": "Stat",
        "props": { "label": "Monthly Avg", "value": 1535 }
      },
      "statPeak": {
        "type": "Stat",
        "props": { "label": "Peak Month", "value": "Mar 2026" }
      },

      "chart": {
        "type": "Sparkline",
        "props": {
          "values": [1180, 1240, 1310, 1290, 1420, 1380, 1510, 1620, 1850, 1740, 1690, 1190],
          "tone": "accent",
          "height": 120,
          "fill": true
        }
      },

      "axis": {
        "type": "Row",
        "props": { "justify": "between", "gap": "none" },
        "children": ["m1", "m2", "m3", "m4", "m5", "m6", "m7", "m8", "m9", "m10", "m11", "m12"]
      },
      "m1":  { "type": "Caption", "props": { "text": "Jul" } },
      "m2":  { "type": "Caption", "props": { "text": "Aug" } },
      "m3":  { "type": "Caption", "props": { "text": "Sep" } },
      "m4":  { "type": "Caption", "props": { "text": "Oct" } },
      "m5":  { "type": "Caption", "props": { "text": "Nov" } },
      "m6":  { "type": "Caption", "props": { "text": "Dec" } },
      "m7":  { "type": "Caption", "props": { "text": "Jan" } },
      "m8":  { "type": "Caption", "props": { "text": "Feb" } },
      "m9":  { "type": "Caption", "props": { "text": "Mar" } },
      "m10": { "type": "Caption", "props": { "text": "Apr" } },
      "m11": { "type": "Caption", "props": { "text": "May" } },
      "m12": { "type": "Caption", "props": { "text": "Jun" } }
    }
  }
}
