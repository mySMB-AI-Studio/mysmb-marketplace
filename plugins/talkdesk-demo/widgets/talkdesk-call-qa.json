{
  "id": "talkdesk-call-qa",
  "title": "Call QA Scorecard",
  "description": "Recent Talkdesk call QA scores from the mySMB scoring service.",
  "category": "support",
  "tags": ["talkdesk", "qa", "calls", "scoring", "support"],
  "keywords": ["call quality", "qa score", "talkdesk", "agent performance"],
  "connectorsUsed": ["talkdesk"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 5, "rowSpan": 5 },
    "min":       { "colSpan": 4, "rowSpan": 4 },
    "max":       { "colSpan": 10, "rowSpan": 10 }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "children": ["headerRow", "avg", "divider", "list"]
      },
      "headerRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["titleGroup", "brandBadge"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "ClipboardCheck", "tone": "accent", "size": "sm" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["hTitle", "hEyebrow"]
      },
      "hTitle": {
        "type": "Heading",
        "props": { "text": "Call QA Scorecard", "level": "h2" }
      },
      "hEyebrow": {
        "type": "Eyebrow",
        "props": { "text": "Talkdesk AI Agent · Demo" }
      },
      "brandBadge": {
        "type": "Badge",
        "props": { "label": "talkdesk", "tone": "success" }
      },
      "avg": {
        "type": "Stat",
        "props": { "label": "Avg Score", "value": 82, "suffix": "/100" }
      },
      "divider": { "type": "Divider" },
      "list": {
        "type": "Stack",
        "children": ["row1", "row2", "row3", "row4", "row5"]
      },

      "row1": { "type": "Row", "props": { "gap": "sm" }, "children": ["r1agent", "r1score", "r1grade"] },
      "r1agent": { "type": "Text", "props": { "text": "Alice M.", "grow": true } },
      "r1score": { "type": "Text", "props": { "text": "92/100" } },
      "r1grade": { "type": "Badge", "props": { "label": "A" } },

      "row2": { "type": "Row", "props": { "gap": "sm" }, "children": ["r2agent", "r2score", "r2grade"] },
      "r2agent": { "type": "Text", "props": { "text": "Bob K.", "grow": true } },
      "r2score": { "type": "Text", "props": { "text": "74/100" } },
      "r2grade": { "type": "Badge", "props": { "label": "C" } },

      "row3": { "type": "Row", "props": { "gap": "sm" }, "children": ["r3agent", "r3score", "r3grade"] },
      "r3agent": { "type": "Text", "props": { "text": "Alice M.", "grow": true } },
      "r3score": { "type": "Text", "props": { "text": "88/100" } },
      "r3grade": { "type": "Badge", "props": { "label": "B" } },

      "row4": { "type": "Row", "props": { "gap": "sm" }, "children": ["r4agent", "r4score", "r4grade"] },
      "r4agent": { "type": "Text", "props": { "text": "Carol T.", "grow": true } },
      "r4score": { "type": "Text", "props": { "text": "95/100" } },
      "r4grade": { "type": "Badge", "props": { "label": "A" } },

      "row5": { "type": "Row", "props": { "gap": "sm" }, "children": ["r5agent", "r5score", "r5grade"] },
      "r5agent": { "type": "Text", "props": { "text": "Bob K.", "grow": true } },
      "r5score": { "type": "Text", "props": { "text": "61/100" } },
      "r5grade": { "type": "Badge", "props": { "label": "C" } }
    }
  }
}
