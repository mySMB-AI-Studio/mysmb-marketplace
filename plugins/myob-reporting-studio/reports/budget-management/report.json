{
  "dataBindings": {
    "bindings": [
      {
        "id": "budget",
        "params": {
          "financial_year": {
            "input": "financial_year",
            "kind": "input"
          },
          "myob_company_file_id": {
            "input": "company_file",
            "kind": "input"
          }
        },
        "tool": {
          "mcp": "myob-accounting",
          "name": "get_budget"
        }
      },
      {
        "id": "pnl",
        "params": {
          "from_date": {
            "input": "fy_start",
            "kind": "input"
          },
          "myob_company_file_id": {
            "input": "company_file",
            "kind": "input"
          },
          "reporting_basis": {
            "kind": "static",
            "value": "Accrual"
          },
          "to_date": {
            "input": "act_end",
            "kind": "input"
          }
        },
        "tool": {
          "mcp": "myob-accounting",
          "name": "get_profit_and_loss_3m"
        }
      },
      {
        "id": "accounts",
        "params": {
          "myob_company_file_id": {
            "input": "company_file",
            "kind": "input"
          }
        },
        "tool": {
          "mcp": "myob-accounting",
          "name": "list_accounts"
        }
      },
      {
        "id": "props",
        "params": {
          "myob_company_file_id": {
            "input": "company_file",
            "kind": "input"
          }
        },
        "tool": {
          "mcp": "myob-accounting",
          "name": "get_accounting_properties"
        }
      },
      {
        "id": "company_files",
        "params": {},
        "tool": {
          "mcp": "myob-accounting",
          "name": "list_company_files"
        }
      }
    ],
    "inputs": [
      {
        "default": "current",
        "label": "Budget year",
        "name": "budget_year",
        "options": [
          "current",
          "next",
          "file"
        ],
        "type": "enum"
      },
      {
        "default": 2027,
        "label": "Financial year (worked out from the budget year)",
        "max": 2100,
        "min": 2000,
        "name": "financial_year",
        "type": "number"
      },
      {
        "default": "2026-07-01",
        "label": "Financial year start (worked out)",
        "name": "fy_start",
        "type": "date"
      },
      {
        "default": "2026-08-31",
        "label": "Actuals to (end of last month, worked out)",
        "name": "act_end",
        "type": "date"
      },
      {
        "default": "",
        "label": "Company file",
        "maxLength": 64,
        "name": "company_file",
        "type": "string"
      },
      {
        "default": "Bookkeeper",
        "label": "View as",
        "name": "persona",
        "options": [
          "Client",
          "Bookkeeper",
          "Practitioner",
          "Executive"
        ],
        "type": "enum"
      },
      {
        "default": "{\"cents\":0,\"k\":0,\"zeros\":0,\"neg\":\"paren\",\"red\":0,\"hdr\":1,\"ftr\":1,\"style\":\"myob\",\"dens\":\"100\",\"p\":\"custom\",\"a\":\"custom\",\"c\":\"none\",\"v\":\"budget\",\"x\":\"\"}",
        "label": "Display settings",
        "maxLength": 300,
        "name": "display",
        "type": "string"
      }
    ]
  },
  "description": "Live, validated MYOB Budget Management (M01): Budget by month, Balance sheet budgets, Budget vs actual.",
  "fileName": "myob-budget-management.html",
  "tags": [
    "myob",
    "budget",
    "M01"
  ],
  "title": "MYOB Budget Management"
}
