{
  "title": "Unpaid & Aged Accounts — MYOB",
  "description": "Unpaid sales invoices and purchase bills across your MYOB company files, aged into buckets, with one grouped payment-reminder draft per contact.",
  "tags": ["myob", "aged-receivables", "aged-payables", "unpaid", "ageing"],
  "fileName": "myob-unpaid-aged-accounts.html",
  "dataBindings": {
    "inputs": [
      {
        "name": "company_file",
        "label": "Company file",
        "type": "string",
        "maxLength": 64,
        "default": ""
      }
    ],
    "bindings": [
      {
        "id": "company_files",
        "tool": { "mcp": "myob-accounting", "name": "list_company_files" },
        "params": {}
      },
      {
        "id": "invoices",
        "tool": { "mcp": "myob-accounting", "name": "list_invoices" },
        "params": {
          "status": { "kind": "static", "value": "Open" },
          "myob_company_file_id": { "kind": "input", "input": "company_file" }
        }
      },
      {
        "id": "bills",
        "tool": { "mcp": "myob-accounting", "name": "list_bills" },
        "params": {
          "status": { "kind": "static", "value": "Open" },
          "myob_company_file_id": { "kind": "input", "input": "company_file" }
        }
      },
      {
        "id": "contacts",
        "tool": { "mcp": "myob-accounting", "name": "list_contacts" },
        "params": {
          "type": { "kind": "static", "value": "All" },
          "myob_company_file_id": { "kind": "input", "input": "company_file" }
        }
      }
    ]
  }
}
