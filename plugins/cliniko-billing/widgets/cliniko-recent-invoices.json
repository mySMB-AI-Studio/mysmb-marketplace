{
  "id": "cliniko-recent-invoices",
  "title": "Cliniko — Recent invoices",
  "description": "Most recent invoices with status and amount.",
  "category": "health",
  "tags": [
    "cliniko",
    "billing",
    "invoices",
    "finance"
  ],
  "keywords": [
    "invoice",
    "invoices",
    "billing",
    "revenue",
    "payment"
  ],
  "connectorsUsed": [
    "cliniko-billing"
  ],
  "popularity": 85,
  "sizing": {
    "preferred": {
      "colSpan": 6,
      "rowSpan": 6
    },
    "min": {
      "colSpan": 4,
      "rowSpan": 4
    },
    "max": {
      "colSpan": 12,
      "rowSpan": 12
    }
  },
  "dataProvider": {
    "mcp": "cliniko-billing",
    "tool": "list_invoices",
    "params": {
      "per_page": 30,
      "sort": "issue_date:desc"
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "header": {
        "type": "Header",
        "props": {},
        "children": [
          "headerRow"
        ]
      },
      "headerRow": {
        "type": "Row",
        "props": {
          "justify": "between",
          "align": "center"
        },
        "children": [
          "titleGroup",
          "refreshBtn"
        ]
      },
      "titleGroup": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center"
        },
        "children": [
          "titleIcon",
          "titleStack"
        ]
      },
      "titleIcon": {
        "type": "Icon",
        "props": {
          "name": "Receipt",
          "tone": "accent",
          "size": "sm"
        }
      },
      "titleStack": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "children": [
          "title",
          "count"
        ]
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "Recent invoices",
          "level": "h2"
        }
      },
      "count": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{n} total",
              "n": {
                "$state": "/cliniko-billing/list_invoices/total_entries"
              }
            }
          }
        }
      },
      "refreshBtn": {
        "type": "IconButton",
        "props": {
          "name": "RefreshCw",
          "size": "sm",
          "ariaLabel": "Refresh"
        },
        "on": {
          "click": {
            "action": "cliniko-billing.list_invoices",
            "params": {
              "per_page": 30,
              "sort": "issue_date:desc"
            }
          }
        }
      },
      "body": {
        "type": "Body",
        "props": {},
        "children": [
          "loading",
          "empty",
          "list"
        ]
      },
      "loading": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "children": [
          "lk1",
          "lk2",
          "lk3",
          "lk4"
        ],
        "visible": {
          "$state": "/_loading/cliniko-billing.list_invoices"
        }
      },
      "lk1": {
        "type": "Skeleton",
        "props": {
          "height": "3rem",
          "rounded": "md"
        }
      },
      "lk2": {
        "type": "Skeleton",
        "props": {
          "height": "3rem",
          "rounded": "md"
        }
      },
      "lk3": {
        "type": "Skeleton",
        "props": {
          "height": "3rem",
          "rounded": "md"
        }
      },
      "lk4": {
        "type": "Skeleton",
        "props": {
          "height": "3rem",
          "rounded": "md"
        }
      },
      "empty": {
        "type": "Empty",
        "props": {
          "message": "No invoices yet — invoices are raised from appointments in Cliniko."
        },
        "visible": {
          "$and": [
            {
              "$state": "/_loading/cliniko-billing.list_invoices",
              "not": true
            },
            {
              "$state": "/cliniko-billing/list_invoices/invoices/0",
              "not": true
            }
          ]
        }
      },
      "list": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "children": [
          "row"
        ],
        "repeat": {
          "statePath": "/cliniko-billing/list_invoices/invoices",
          "key": "id"
        },
        "visible": {
          "$state": "/_loading/cliniko-billing.list_invoices",
          "not": true
        }
      },
      "row": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center",
          "hover": true,
          "template": "minmax(0, 1fr) auto auto"
        },
        "children": [
          "rowIdentity",
          "rowAmount",
          "rowStatus"
        ]
      },
      "rowIdentity": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "children": [
          "rowNumber",
          "rowMeta"
        ]
      },
      "rowMeta": {
        "type": "Row",
        "props": {
          "gap": "xs",
          "align": "baseline"
        },
        "children": [
          "rowMetaDate",
          "rowMetaWho"
        ]
      },
      "rowNumber": {
        "type": "Text",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "Invoice #{n}",
              "n": {
                "$item": "number"
              }
            }
          },
          "size": "sm",
          "weight": "medium",
          "truncate": true
        }
      },
      "rowMetaDate": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "format_date",
            "args": {
              "value": {
                "$item": "issue_date"
              },
              "format": "short"
            }
          }
        }
      },
      "rowMetaWho": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "· {who}",
              "who": {
                "$computed": "first_line",
                "args": {
                  "value": {
                    "$item": "invoice_to"
                  },
                  "max": 28
                }
              }
            }
          }
        },
        "visible": {
          "$item": "invoice_to"
        }
      },
      "rowAmount": {
        "type": "Text",
        "props": {
          "text": {
            "$computed": "format_currency",
            "args": {
              "value": {
                "$item": "total_amount"
              }
            }
          },
          "size": "sm",
          "weight": "semibold"
        }
      },
      "rowStatus": {
        "type": "Row",
        "props": {
          "gap": "xs",
          "align": "center"
        },
        "children": [
          "badgeOpen",
          "badgePaid",
          "badgeClosed",
          "badgeCredit"
        ]
      },
      "badgeOpen": {
        "type": "Badge",
        "props": {
          "text": "Open",
          "tone": "warning",
          "variant": "soft"
        },
        "visible": {
          "$item": "status",
          "eq": 10
        }
      },
      "badgePaid": {
        "type": "Badge",
        "props": {
          "text": "Paid",
          "tone": "success",
          "variant": "soft"
        },
        "visible": {
          "$item": "status",
          "eq": 20
        }
      },
      "badgeClosed": {
        "type": "Badge",
        "props": {
          "text": "Closed",
          "tone": "muted",
          "variant": "soft"
        },
        "visible": {
          "$item": "status",
          "eq": 30
        }
      },
      "badgeCredit": {
        "type": "Badge",
        "props": {
          "text": "Open credit",
          "tone": "info",
          "variant": "soft"
        },
        "visible": {
          "$item": "status",
          "eq": 40
        }
      },
      "card": {
        "type": "Card",
        "props": {},
        "children": [
          "header",
          "body"
        ]
      }
    }
  }
}
