{
  "id": "cliniko-product-catalogue",
  "title": "Cliniko — Product catalogue",
  "description": "Sellable products, their prices, and total catalogue value.",
  "category": "health",
  "tags": [
    "cliniko",
    "billing",
    "products",
    "inventory"
  ],
  "keywords": [
    "product",
    "inventory",
    "price",
    "catalogue",
    "stock"
  ],
  "connectorsUsed": [
    "cliniko-billing"
  ],
  "popularity": 65,
  "sizing": {
    "preferred": {
      "colSpan": 6,
      "rowSpan": 6
    },
    "min": {
      "colSpan": 4,
      "rowSpan": 4
    },
    "max": {
      "colSpan": 12,
      "rowSpan": 12
    }
  },
  "dataProvider": {
    "mcp": "cliniko-billing",
    "tool": "list_products",
    "params": {
      "per_page": 50,
      "sort": "name:asc"
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "header": {
        "type": "Header",
        "props": {},
        "children": [
          "headerRow"
        ]
      },
      "headerRow": {
        "type": "Row",
        "props": {
          "justify": "between",
          "align": "center"
        },
        "children": [
          "titleGroup",
          "refreshBtn"
        ]
      },
      "titleGroup": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center"
        },
        "children": [
          "titleIcon",
          "titleStack"
        ]
      },
      "titleIcon": {
        "type": "Icon",
        "props": {
          "name": "Package",
          "tone": "accent",
          "size": "sm"
        }
      },
      "titleStack": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "children": [
          "title",
          "count"
        ]
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "Product catalogue",
          "level": "h2"
        }
      },
      "count": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{n} total",
              "n": {
                "$state": "/cliniko-billing/list_products/total_entries"
              }
            }
          }
        }
      },
      "refreshBtn": {
        "type": "IconButton",
        "props": {
          "name": "RefreshCw",
          "size": "sm",
          "ariaLabel": "Refresh"
        },
        "on": {
          "click": {
            "action": "cliniko-billing.list_products",
            "params": {
              "per_page": 50,
              "sort": "name:asc"
            }
          }
        }
      },
      "kpiLoading": {
        "type": "Grid",
        "props": {
          "cols": 2,
          "gap": "md"
        },
        "children": [
          "kpiSk0",
          "kpiSk1"
        ],
        "visible": {
          "$state": "/_loading/cliniko-billing.list_products"
        }
      },
      "kpiSk0": {
        "type": "Skeleton",
        "props": {
          "height": "3rem",
          "rounded": "md"
        }
      },
      "kpiSk1": {
        "type": "Skeleton",
        "props": {
          "height": "3rem",
          "rounded": "md"
        }
      },
      "kpis": {
        "type": "Grid",
        "props": {
          "cols": 2,
          "gap": "md"
        },
        "children": [
          "kpi0",
          "kpi1"
        ],
        "visible": {
          "$state": "/_loading/cliniko-billing.list_products",
          "not": true
        }
      },
      "kpi0": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "children": [
          "kpiL0",
          "kpiV0"
        ]
      },
      "kpiL0": {
        "type": "Row",
        "props": {
          "gap": "xs",
          "align": "center"
        },
        "children": [
          "kpiI0",
          "kpiT0"
        ]
      },
      "kpiI0": {
        "type": "Icon",
        "props": {
          "name": "Package",
          "tone": "accent",
          "size": "xs"
        }
      },
      "kpiT0": {
        "type": "Eyebrow",
        "props": {
          "text": "Products"
        }
      },
      "kpiV0": {
        "type": "Stat",
        "props": {
          "size": "md",
          "value": {
            "$computed": "count",
            "args": {
              "value": {
                "$state": "/cliniko-billing/list_products/products"
              }
            }
          }
        }
      },
      "kpi1": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "children": [
          "kpiL1",
          "kpiV1"
        ]
      },
      "kpiL1": {
        "type": "Row",
        "props": {
          "gap": "xs",
          "align": "center"
        },
        "children": [
          "kpiI1",
          "kpiT1"
        ]
      },
      "kpiI1": {
        "type": "Icon",
        "props": {
          "name": "DollarSign",
          "tone": "success",
          "size": "xs"
        }
      },
      "kpiT1": {
        "type": "Eyebrow",
        "props": {
          "text": "Catalogue value"
        }
      },
      "kpiV1": {
        "type": "Stat",
        "props": {
          "size": "md",
          "value": {
            "$computed": "format_currency",
            "args": {
              "value": {
                "$computed": "sum",
                "args": {
                  "value": {
                    "$state": "/cliniko-billing/list_products/products"
                  },
                  "field": "price"
                }
              }
            }
          }
        }
      },
      "kpiDivider": {
        "type": "Divider",
        "props": {}
      },
      "body": {
        "type": "Body",
        "props": {},
        "children": [
          "loading",
          "empty",
          "list"
        ]
      },
      "loading": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "children": [
          "lk1",
          "lk2",
          "lk3",
          "lk4"
        ],
        "visible": {
          "$state": "/_loading/cliniko-billing.list_products"
        }
      },
      "lk1": {
        "type": "Skeleton",
        "props": {
          "height": "3rem",
          "rounded": "md"
        }
      },
      "lk2": {
        "type": "Skeleton",
        "props": {
          "height": "3rem",
          "rounded": "md"
        }
      },
      "lk3": {
        "type": "Skeleton",
        "props": {
          "height": "3rem",
          "rounded": "md"
        }
      },
      "lk4": {
        "type": "Skeleton",
        "props": {
          "height": "3rem",
          "rounded": "md"
        }
      },
      "empty": {
        "type": "Empty",
        "props": {
          "message": "No products in the catalogue."
        },
        "visible": {
          "$and": [
            {
              "$state": "/_loading/cliniko-billing.list_products",
              "not": true
            },
            {
              "$state": "/cliniko-billing/list_products/products/0",
              "not": true
            }
          ]
        }
      },
      "list": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "children": [
          "row"
        ],
        "repeat": {
          "statePath": "/cliniko-billing/list_products/products",
          "key": "id"
        },
        "visible": {
          "$state": "/_loading/cliniko-billing.list_products",
          "not": true
        }
      },
      "row": {
        "type": "ListItem",
        "props": {
          "title": {
            "$item": "name"
          },
          "subtitle": {
            "$item": "item_code"
          },
          "value": {
            "$computed": "format_currency",
            "args": {
              "value": {
                "$item": "price"
              }
            }
          }
        }
      },
      "card": {
        "type": "Card",
        "props": {},
        "children": [
          "header",
          "kpiLoading",
          "kpis",
          "kpiDivider",
          "chartLabel",
          "chartLoading",
          "chart",
          "chartDivider",
          "body"
        ]
      },
      "chartLabel": {
        "type": "Eyebrow",
        "props": {
          "text": "Top products by price"
        },
        "visible": {
          "$state": "/_loading/cliniko-billing.list_products",
          "not": true
        }
      },
      "chartLoading": {
        "type": "Skeleton",
        "props": {
          "height": "6rem",
          "rounded": "md"
        },
        "visible": {
          "$state": "/_loading/cliniko-billing.list_products"
        }
      },
      "chart": {
        "type": "BarChart",
        "props": {
          "data": {
            "$state": "/cliniko-billing/list_products/products"
          },
          "labelField": "name",
          "valueField": "price",
          "valueFormat": "currency",
          "limit": 6,
          "tone": "accent",
          "sort": "desc"
        },
        "visible": {
          "$state": "/_loading/cliniko-billing.list_products",
          "not": true
        }
      },
      "chartDivider": {
        "type": "Divider",
        "props": {}
      }
    }
  },
  "status": "published"
}
