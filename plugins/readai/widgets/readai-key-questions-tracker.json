{
  "id": "readai-key-questions-tracker",
  "title": "Key Questions Tracker",
  "description": "Important questions raised in your recent Read.ai meetings that may still need an answer.",
  "category": "productivity",
  "tags": [
    "readai",
    "meetings",
    "key questions",
    "follow-ups"
  ],
  "keywords": [
    "key questions",
    "open questions",
    "follow ups",
    "unanswered questions",
    "read ai",
    "readai"
  ],
  "connectorsUsed": [
    "readai"
  ],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 4, "rowSpan": 6 },
    "min": { "colSpan": 3, "rowSpan": 5 },
    "max": { "colSpan": 5, "rowSpan": 8 }
  },
  "dataProvider": {
    "mcp": "readai",
    "tool": "list_meetings",
    "params": {
      "expand": ["key_questions"],
      "limit": 5
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": ["headerRow", "divider0", "body", "footerRow"],
        "watch": {
          "/readai/list_meetings/data": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/key_questions",
                "value": {
                  "$computed": "readai_flatten_key_questions",
                  "args": { "value": { "$state": "/readai/list_meetings/data" } }
                }
              }
            }
          ]
        }
      },
      "headerRow": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIconBadge", "titleStack"]
      },
      "titleIconBadge": {
        "type": "Badge",
        "props": { "tone": "chart-1", "variant": "soft" },
        "children": ["titleIcon"]
      },
      "titleIcon": { "type": "Icon", "props": { "name": "HelpCircle", "size": "sm", "tone": "chart-1" } },
      "titleStack": { "type": "Stack", "props": { "gap": "none" }, "children": ["title", "subtitle"] },
      "title": { "type": "Heading", "props": { "text": "Key Questions Tracker", "level": "h2" } },
      "subtitle": { "type": "Eyebrow", "props": { "text": "Read AI" } },
      "divider0": { "type": "Divider", "props": {} },

      "body": { "type": "Body", "props": {}, "children": ["loading", "empty", "listSection"] },
      "loading": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["sk1", "sk2", "sk3"],
        "visible": { "$state": "/_loading/readai.list_meetings" }
      },
      "sk1": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "sk2": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "sk3": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "empty": {
        "type": "Empty",
        "props": { "message": "No key questions found in recent meetings." },
        "visible": {
          "$and": [
            { "$state": "/_loading/readai.list_meetings", "not": true },
            { "$state": "/ui/key_questions/0", "not": true }
          ]
        }
      },
      "listSection": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["pulledFromCaption", "itemsList"],
        "visible": { "$state": "/_loading/readai.list_meetings", "not": true }
      },
      "pulledFromCaption": {
        "type": "Text",
        "props": { "text": "Pulled from recent meetings", "size": "sm", "weight": "semibold" }
      },
      "itemsList": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["itemRow"],
        "repeat": { "statePath": "/ui/key_questions", "key": "id" },
        "visible": { "$state": "/_loading/readai.list_meetings", "not": true }
      },
      "itemRow": {
        "type": "Row",
        "props": { "gap": "sm", "align": "start" },
        "children": ["itemIcon", "itemTextStack", "itemViewButton"]
      },
      "itemIcon": { "type": "Icon", "props": { "name": "MessageCircleQuestion", "size": "sm", "tone": "chart-1" } },
      "itemTextStack": {
        "type": "Stack",
        "props": { "gap": "none", "grow": true },
        "children": ["itemText", "itemMeetingCaption"]
      },
      "itemText": {
        "type": "Text",
        "props": { "text": { "$item": "text" }, "size": "sm", "weight": "medium" }
      },
      "itemMeetingCaption": {
        "type": "Text",
        "props": { "text": { "$item": "meeting_title" }, "size": "xs", "weight": "medium", "tone": "chart-1" }
      },
      "itemViewButton": {
        "type": "IconButton",
        "props": { "icon": "ExternalLink", "size": "sm", "tone": "accent", "ariaLabel": "View in Read AI" },
        "on": {
          "click": { "action": "open_url", "params": { "url": { "$bindItem": "report_url" }, "target": "_blank" } }
        }
      },

      "footerRow": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center", "justify": "end", "clickable": true },
        "children": ["footerIcon", "footerLabel"],
        "on": {
          "click": { "action": "open_url", "params": { "url": "https://app.read.ai", "target": "_blank" } }
        }
      },
      "footerIcon": { "type": "Icon", "props": { "name": "ExternalLink", "size": "xs", "tone": "accent" } },
      "footerLabel": { "type": "Text", "props": { "text": "Open in Read AI", "size": "sm", "tone": "accent" } }
    }
  }
}
