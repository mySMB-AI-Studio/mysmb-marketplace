{
  "id": "readai-meeting-score-monitor",
  "title": "Meeting Score Monitor",
  "description": "Your latest meeting's Read Score, sentiment, and engagement, with trend vs. the previous meeting.",
  "category": "productivity",
  "tags": ["readai", "meetings", "score", "sentiment", "engagement"],
  "keywords": ["meeting score", "read score", "sentiment", "engagement", "read ai", "readai"],
  "connectorsUsed": ["readai"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 4, "rowSpan": 6 },
    "min": { "colSpan": 3, "rowSpan": 5 },
    "max": { "colSpan": 5, "rowSpan": 7 }
  },
  "dataProvider": {
    "mcp": "readai",
    "tool": "list_meetings",
    "params": { "limit": 2, "expand": ["metrics"] }
  },
  "spec": {
    "root": "card",
    "elements": {

      "card": {
        "type": "Card",
        "props": {},
        "children": ["headerRow", "divider0", "body"],
        "watch": {
          "/readai/list_meetings/data": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/scorecard",
                "value": {
                  "$computed": "readai_flatten_scorecard",
                  "args": { "value": { "$state": "/readai/list_meetings/data" } }
                }
              }
            }
          ]
        }
      },

      "headerRow": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIconBadge", "titleStack"]
      },
      "titleIconBadge": {
        "type": "Badge",
        "props": { "tone": "chart-1", "variant": "soft" },
        "children": ["titleIcon"]
      },
      "titleIcon": { "type": "Icon", "props": { "name": "Gauge", "tone": "chart-1", "size": "sm" } },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "subtitle"]
      },
      "title": { "type": "Heading", "props": { "text": "Meeting Score Monitor", "level": "h2" } },
      "subtitle": { "type": "Eyebrow", "props": { "text": "Read AI" } },
      "divider0": { "type": "Divider", "props": {} },

      "body": {
        "type": "Body",
        "props": {},
        "children": ["loading", "empty", "content"]
      },

      "loading": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["sk1", "sk2", "sk3"],
        "visible": { "$state": "/_loading/readai.list_meetings" }
      },
      "sk1": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "sk2": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "sk3": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },

      "empty": {
        "type": "Empty",
        "props": { "message": "No scored meetings yet." },
        "visible": {
          "$and": [
            { "$state": "/_loading/readai.list_meetings", "not": true },
            { "$state": "/ui/scorecard/has_data", "not": true }
          ]
        }
      },

      "content": {
        "type": "Stack",
        "props": { "gap": "md" },
        "children": ["meetingContextStack", "metricsList", "scoreCallout", "footerRow"],
        "visible": {
          "$and": [
            { "$state": "/_loading/readai.list_meetings", "not": true },
            { "$state": "/ui/scorecard/has_data" }
          ]
        }
      },

      "meetingContextStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["meetingTitleText", "scorecardCaption", "trendContextCaption"]
      },
      "meetingTitleText": {
        "type": "Text",
        "props": { "text": { "$state": "/ui/scorecard/meeting_title" }, "size": "sm", "weight": "semibold", "truncate": true }
      },
      "scorecardCaption": {
        "type": "Caption",
        "props": { "text": "Your latest meeting's scorecard", "tone": "muted" }
      },
      "trendContextCaption": {
        "type": "Caption",
        "props": { "text": "Note: ↓ / ↑ shows change vs. your previous meeting", "tone": "muted" },
        "visible": { "$state": "/ui/scorecard/has_trend" }
      },

      "metricsList": {
        "type": "Stack",
        "props": { "gap": "md" },
        "children": ["metricRow"],
        "repeat": { "statePath": "/ui/scorecard/metrics", "key": "id" }
      },
      "metricRow": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["metricHeaderRow", "metricBarRow"]
      },
      "metricBarRow": {
        "type": "Row",
        "props": { "align": "center", "gap": "none", "grow": true },
        "children": ["metricBar"]
      },
      "metricHeaderRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["metricLabel", "metricValueGroup"]
      },
      "metricLabel": {
        "type": "Text",
        "props": { "text": { "$item": "label" }, "size": "sm", "weight": "medium" }
      },
      "metricValueGroup": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["metricValue", "metricTrendIcon", "metricTrendText"]
      },
      "metricValue": {
        "type": "Text",
        "props": { "text": { "$item": "value_label" }, "size": "sm", "weight": "semibold", "tone": { "$item": "bar_tone" } }
      },
      "metricTrendIcon": {
        "type": "Icon",
        "props": { "name": { "$item": "trend_icon" }, "tone": { "$item": "trend_tone" }, "size": "xs" },
        "visible": { "$item": "trend_label" }
      },
      "metricTrendText": {
        "type": "Caption",
        "props": { "text": { "$item": "trend_label" }, "tone": { "$item": "trend_tone" } },
        "visible": { "$item": "trend_label" }
      },
      "metricBar": {
        "type": "ProgressBar",
        "props": { "value": { "$item": "bar_pct" }, "tone": { "$item": "bar_tone" } }
      },

      "scoreCallout": {
        "type": "Section",
        "props": { "variant": "muted" },
        "children": ["scoreCalloutInner"]
      },
      "scoreCalloutInner": {
        "type": "Stack",
        "props": { "gap": "xs", "align": "center" },
        "children": ["calloutEyebrow", "calloutScore", "calloutTier"]
      },
      "calloutEyebrow": {
        "type": "Caption",
        "props": { "text": "LATEST READ SCORE", "tone": "muted", "weight": "medium" }
      },
      "calloutScore": {
        "type": "Stat",
        "props": { "value": { "$state": "/ui/scorecard/read_score_label" }, "size": "md" }
      },
      "calloutTier": {
        "type": "Text",
        "props": { "text": { "$state": "/ui/scorecard/read_score_tier" }, "size": "sm", "weight": "semibold", "tone": "success" }
      },

      "footerRow": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center", "justify": "end", "clickable": true },
        "children": ["footerIcon", "footerLabel"],
        "on": {
          "click": { "action": "open_url", "params": { "url": { "$state": "/ui/scorecard/report_url" }, "target": "_blank" } }
        }
      },
      "footerIcon": { "type": "Icon", "props": { "name": "ExternalLink", "tone": "accent", "size": "xs" } },
      "footerLabel": { "type": "Text", "props": { "text": "Open in Read AI", "size": "sm", "tone": "accent" } }
    }
  },
  "status": "published"
}
