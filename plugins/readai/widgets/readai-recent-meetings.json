{
  "category": "productivity",
  "connectorsUsed": [
    "readai"
  ],
  "dataProvider": {
    "kind": "tool",
    "mcp": "readai",
    "params": {
      "expand": [
        "summary"
      ]
    },
    "tool": "list_meetings"
  },
  "description": "Latest Read.ai meeting reports — title, when it happened, and duration — newest first.",
  "id": "readai-recent-meetings",
  "keywords": [
    "recent meetings",
    "read ai",
    "meeting reports",
    "readai"
  ],
  "popularity": 0,
  "sizing": {
    "max": {
      "colSpan": 5,
      "rowSpan": 8
    },
    "min": {
      "colSpan": 3,
      "rowSpan": 5
    },
    "preferred": {
      "colSpan": 4,
      "rowSpan": 6
    }
  },
  "spec": {
    "elements": {
      "body": {
        "children": [
          "loading",
          "empty",
          "meetingsList"
        ],
        "props": {},
        "type": "Body"
      },
      "card": {
        "children": [
          "headerRow",
          "divider0",
          "body",
          "footerRow",
          "summaryOverlay"
        ],
        "props": {},
        "type": "Card",
        "watch": {
          "/readai/list_meetings/data": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/meetings",
                "value": {
                  "$computed": "readai_flatten_meetings",
                  "args": {
                    "value": {
                      "$state": "/readai/list_meetings/data"
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "divider0": {
        "props": {},
        "type": "Divider"
      },
      "empty": {
        "props": {
          "message": "No meetings recorded yet."
        },
        "type": "Empty",
        "visible": {
          "$and": [
            {
              "$state": "/_loading/readai.list_meetings",
              "not": true
            },
            {
              "$state": "/ui/meetings/0",
              "not": true
            }
          ]
        }
      },
      "eyebrow": {
        "props": {
          "text": "Read AI"
        },
        "type": "Eyebrow"
      },
      "footerIcon": {
        "props": {
          "name": "ExternalLink",
          "size": "xs",
          "tone": "accent"
        },
        "type": "Icon"
      },
      "footerLabel": {
        "props": {
          "size": "sm",
          "text": "Open in Read AI",
          "tone": "accent"
        },
        "type": "Text"
      },
      "footerRow": {
        "children": [
          "footerIcon",
          "footerLabel"
        ],
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "target": "_blank",
              "url": "https://app.read.ai"
            }
          }
        },
        "props": {
          "align": "center",
          "clickable": true,
          "gap": "xs",
          "justify": "end"
        },
        "type": "Row"
      },
      "headerRow": {
        "children": [
          "titleIconBadge",
          "titleStack"
        ],
        "props": {
          "align": "center",
          "gap": "sm"
        },
        "type": "Row"
      },
      "loading": {
        "children": [
          "sk1",
          "sk2",
          "sk3"
        ],
        "props": {
          "gap": "sm"
        },
        "type": "Stack",
        "visible": {
          "$state": "/_loading/readai.list_meetings"
        }
      },
      "meetingAvatar": {
        "props": {
          "initials": {
            "$item": "initials"
          },
          "size": "sm",
          "tone": {
            "$item": "avatar_tone"
          }
        },
        "type": "Avatar"
      },
      "meetingDurationBadge": {
        "props": {
          "text": {
            "$item": "duration_label"
          },
          "tone": "accent",
          "variant": "soft"
        },
        "type": "Badge",
        "visible": {
          "$item": "duration_label"
        }
      },
      "meetingRow": {
        "children": [
          "meetingAvatar",
          "meetingTextStack",
          "meetingTrailingGroup"
        ],
        "on": {
          "click": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/selected/id",
                "value": {
                  "$bindItem": "id"
                }
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/selected/title",
                "value": {
                  "$bindItem": "title"
                }
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/selected/subtitle",
                "value": {
                  "$bindItem": "subtitle"
                }
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/selected/summary",
                "value": {
                  "$bindItem": "summary"
                }
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/selected/report_url",
                "value": {
                  "$bindItem": "report_url"
                }
              }
            }
          ]
        },
        "props": {
          "align": "center",
          "clickable": true,
          "gap": "sm",
          "hover": true
        },
        "type": "Row"
      },
      "meetingSubtitle": {
        "props": {
          "text": {
            "$item": "subtitle"
          },
          "tone": "muted"
        },
        "type": "Caption"
      },
      "meetingTextStack": {
        "children": [
          "meetingTitle",
          "meetingSubtitle"
        ],
        "props": {
          "gap": "none",
          "grow": true
        },
        "type": "Stack"
      },
      "meetingTitle": {
        "props": {
          "size": "sm",
          "text": {
            "$item": "title"
          },
          "truncate": true,
          "weight": "semibold"
        },
        "type": "Text"
      },
      "meetingTrailingGroup": {
        "children": [
          "meetingDurationBadge"
        ],
        "props": {
          "align": "center",
          "gap": "xs"
        },
        "type": "Row"
      },
      "meetingsList": {
        "children": [
          "meetingRow"
        ],
        "props": {
          "gap": "sm"
        },
        "repeat": {
          "key": "id",
          "statePath": "/ui/meetings"
        },
        "type": "Stack",
        "visible": {
          "$state": "/_loading/readai.list_meetings",
          "not": true
        }
      },
      "ovActionIcon": {
        "props": {
          "name": "ExternalLink",
          "size": "xs",
          "tone": "accent"
        },
        "type": "Icon"
      },
      "ovActionLabel": {
        "props": {
          "size": "sm",
          "text": "Open Full Report in Read AI",
          "tone": "accent"
        },
        "type": "Text"
      },
      "ovActions": {
        "children": [
          "ovActionIcon",
          "ovActionLabel"
        ],
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "target": "_blank",
              "url": {
                "$state": "/ui/selected/report_url"
              }
            }
          }
        },
        "props": {
          "align": "center",
          "clickable": true,
          "gap": "xs",
          "justify": "end"
        },
        "type": "Row"
      },
      "ovClose": {
        "on": {
          "click": {
            "action": "setState",
            "params": {
              "statePath": "/ui/selected/id",
              "value": ""
            }
          }
        },
        "props": {
          "ariaLabel": "Close summary"
        },
        "type": "OverlayClose"
      },
      "ovDivider": {
        "props": {},
        "type": "Divider"
      },
      "ovDivider2": {
        "props": {},
        "type": "Divider"
      },
      "ovHeader": {
        "children": [
          "ovTitleStack",
          "ovClose"
        ],
        "props": {
          "align": "start",
          "gap": "sm",
          "justify": "between"
        },
        "type": "Row"
      },
      "ovStack": {
        "children": [
          "ovHeader",
          "ovDivider",
          "ovSummaryEyebrow",
          "ovSummaryBody",
          "ovSummaryEmpty",
          "ovDivider2",
          "ovActions"
        ],
        "props": {
          "gap": "md"
        },
        "type": "Stack"
      },
      "ovSubtitle": {
        "props": {
          "text": {
            "$state": "/ui/selected/subtitle"
          },
          "tone": "muted"
        },
        "type": "Caption"
      },
      "ovSummaryBody": {
        "props": {
          "preserveLines": true,
          "size": "sm",
          "text": {
            "$state": "/ui/selected/summary"
          }
        },
        "type": "Text",
        "visible": {
          "$state": "/ui/selected/summary"
        }
      },
      "ovSummaryEmpty": {
        "props": {
          "text": "No summary available yet for this meeting.",
          "tone": "muted"
        },
        "type": "Caption",
        "visible": {
          "$state": "/ui/selected/summary",
          "not": true
        }
      },
      "ovSummaryEyebrow": {
        "props": {
          "text": "Summary"
        },
        "type": "Eyebrow"
      },
      "ovTitle": {
        "props": {
          "level": "h2",
          "text": {
            "$state": "/ui/selected/title"
          },
          "wrap": true
        },
        "type": "Heading"
      },
      "ovTitleStack": {
        "children": [
          "ovTitle",
          "ovSubtitle"
        ],
        "props": {
          "gap": "none"
        },
        "type": "Stack"
      },
      "sk1": {
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "sk2": {
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "sk3": {
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "summaryOverlay": {
        "children": [
          "ovStack"
        ],
        "on": {
          "backdropClick": {
            "action": "setState",
            "params": {
              "statePath": "/ui/selected/id",
              "value": ""
            }
          }
        },
        "props": {
          "maxWidth": "32rem"
        },
        "type": "Overlay",
        "visible": {
          "$state": "/ui/selected/id"
        }
      },
      "title": {
        "props": {
          "level": "h2",
          "text": "Recent Meetings"
        },
        "type": "Heading"
      },
      "titleIcon": {
        "props": {
          "name": "Calendar",
          "size": "sm",
          "tone": "chart-1"
        },
        "type": "Icon"
      },
      "titleIconBadge": {
        "children": [
          "titleIcon"
        ],
        "props": {
          "tone": "chart-1",
          "variant": "soft"
        },
        "type": "Badge"
      },
      "titleStack": {
        "children": [
          "title",
          "eyebrow"
        ],
        "props": {
          "gap": "none"
        },
        "type": "Stack"
      }
    },
    "root": "card"
  },
  "tags": [
    "readai",
    "meetings",
    "reports",
    "transcripts"
  ],
  "title": "Recent Meetings"
}
