{
  "id": "readai-speaker-talk-time",
  "title": "Speaker Talk-Time",
  "description": "Who spoke the most in your latest meeting, derived from the transcript's per-speaker timestamps.",
  "category": "productivity",
  "tags": ["readai", "meetings", "talk time", "speakers"],
  "keywords": ["speaker talk time", "talk time", "who spoke", "read ai", "readai"],
  "connectorsUsed": ["readai"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 4, "rowSpan": 6 },
    "min": { "colSpan": 3, "rowSpan": 5 },
    "max": { "colSpan": 5, "rowSpan": 7 }
  },
  "dataProvider": {
    "mcp": "readai",
    "tool": "list_meetings",
    "params": { "limit": 1, "expand": ["transcript"] }
  },
  "spec": {
    "root": "card",
    "elements": {

      "card": {
        "type": "Card",
        "props": {},
        "children": ["headerRow", "divider0", "body", "footerRow"],
        "watch": {
          "/readai/list_meetings/data": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/talktime",
                "value": {
                  "$computed": "readai_flatten_talk_time",
                  "args": { "value": { "$state": "/readai/list_meetings/data" } }
                }
              }
            }
          ]
        }
      },

      "headerRow": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIconBadge", "titleStack"]
      },
      "titleIconBadge": {
        "type": "Badge",
        "props": { "tone": "chart-1", "variant": "soft" },
        "children": ["titleIcon"]
      },
      "titleIcon": { "type": "Icon", "props": { "name": "Mic", "tone": "chart-1", "size": "sm" } },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "subtitle"]
      },
      "title": { "type": "Heading", "props": { "text": "Speaker Talk-Time", "level": "h2" } },
      "subtitle": { "type": "Eyebrow", "props": { "text": "Read AI" } },
      "divider0": { "type": "Divider", "props": {} },

      "body": {
        "type": "Body",
        "props": {},
        "children": ["loading", "empty", "listSection"]
      },

      "listSection": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["meetingContextStack", "speakersList"],
        "visible": { "$state": "/_loading/readai.list_meetings", "not": true }
      },
      "meetingContextStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["meetingCaption", "meetingPlatformCaption"]
      },
      "meetingCaption": {
        "type": "Text",
        "props": { "text": { "$state": "/ui/talktime/meeting_subtitle" }, "size": "sm", "weight": "semibold" }
      },
      "meetingPlatformCaption": {
        "type": "Caption",
        "props": { "text": { "$state": "/ui/talktime/meeting_platform" }, "tone": "muted" },
        "visible": { "$state": "/ui/talktime/meeting_platform" }
      },

      "loading": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["sk1", "sk2", "sk3"],
        "visible": { "$state": "/_loading/readai.list_meetings" }
      },
      "sk1": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "sk2": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "sk3": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },

      "empty": {
        "type": "Empty",
        "props": { "message": "Talk-time breakdown not available yet for this meeting." },
        "visible": {
          "$and": [
            { "$state": "/_loading/readai.list_meetings", "not": true },
            { "$state": "/ui/talktime/speakers/0", "not": true }
          ]
        }
      },

      "speakersList": {
        "type": "Stack",
        "props": { "gap": "md" },
        "children": ["speakerRow"],
        "repeat": { "statePath": "/ui/talktime/speakers", "key": "id" },
        "visible": { "$state": "/_loading/readai.list_meetings", "not": true }
      },
      "speakerRow": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["speakerAvatar", "speakerTextStack"]
      },
      "speakerAvatar": {
        "type": "Avatar",
        "props": { "initials": { "$item": "initials" }, "tone": { "$item": "tone" }, "size": "sm" }
      },
      "speakerTextStack": {
        "type": "Stack",
        "props": { "gap": "xs", "grow": true },
        "children": ["speakerNameRow", "speakerBarRow"]
      },
      "speakerNameRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["speakerName", "speakerPercent"]
      },
      "speakerName": {
        "type": "Text",
        "props": { "text": { "$item": "name" }, "size": "sm", "weight": "medium" }
      },
      "speakerPercent": {
        "type": "Text",
        "props": { "text": { "$item": "percent_label" }, "size": "sm", "weight": "semibold", "tone": { "$item": "tone" } }
      },
      "speakerBarRow": {
        "type": "Row",
        "props": { "align": "center", "gap": "none", "grow": true },
        "children": ["speakerBar"]
      },
      "speakerBar": {
        "type": "ProgressBar",
        "props": { "value": { "$item": "bar_pct" }, "tone": { "$item": "tone" } }
      },

      "footerRow": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center", "justify": "end", "clickable": true },
        "children": ["footerIcon", "footerLabel"],
        "on": {
          "click": { "action": "open_url", "params": { "url": { "$state": "/ui/talktime/report_url" }, "target": "_blank" } }
        }
      },
      "footerIcon": { "type": "Icon", "props": { "name": "ExternalLink", "tone": "accent", "size": "xs" } },
      "footerLabel": { "type": "Text", "props": { "text": "Open in Read AI", "size": "sm", "tone": "accent" } }
    }
  },
  "status": "published"
}
