{
  "title": "Xero Unpaid & Aged Accounts",
  "description": "Aged receivables and payables from Xero, grouped by organisation and contact, with aging-bucket tiles, a chart and a review-only email draft per contact.",
  "tags": ["xero", "accounts-receivable", "accounts-payable", "ageing", "unpaid"],
  "fileName": "unpaid-aged-accounts-xero.html",
  "dataBindings": {
    "inputs": [
      { "name": "org", "label": "Organisation", "type": "string", "default": "" }
    ],
    "bindings": [
      {
        "id": "connections",
        "tool": { "mcp": "xero-accounting", "name": "list_connections" },
        "params": {}
      },
      {
        "id": "organisation",
        "tool": { "mcp": "xero-accounting", "name": "get_organisation" },
        "params": {
          "xero_tenant_id": { "kind": "input", "input": "org" }
        }
      },
      {
        "id": "ar_invoices",
        "tool": { "mcp": "xero-accounting", "name": "list_invoices" },
        "params": {
          "xero_tenant_id": { "kind": "input", "input": "org" },
          "where": { "kind": "static", "value": "Type==\"ACCREC\"" },
          "statuses": { "kind": "static", "value": "AUTHORISED" },
          "order": { "kind": "static", "value": "DueDate ASC" }
        }
      },
      {
        "id": "ap_invoices",
        "tool": { "mcp": "xero-accounting", "name": "list_invoices" },
        "params": {
          "xero_tenant_id": { "kind": "input", "input": "org" },
          "where": { "kind": "static", "value": "Type==\"ACCPAY\"" },
          "statuses": { "kind": "static", "value": "AUTHORISED" },
          "order": { "kind": "static", "value": "DueDate ASC" }
        }
      }
    ]
  }
}
