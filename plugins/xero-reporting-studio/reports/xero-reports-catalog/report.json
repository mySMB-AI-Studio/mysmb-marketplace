{
  "title": "Xero Reports Catalogue",
  "description": "Live Xero report catalogue (P04) — every Xero report grouped as in Xero, with which of this agent's 26 skills covers it (Live / Built on request / Partly / No prompt yet) and what to ask.",
  "tags": [
    "xero",
    "catalog",
    "P04"
  ],
  "fileName": "xero-reports-catalog.html",
  "dataBindings": {
    "inputs": [
      {
        "name": "org",
        "label": "Organisation",
        "type": "string",
        "maxLength": 64,
        "default": ""
      },
      {
        "name": "display",
        "label": "Display settings",
        "type": "string",
        "maxLength": 300,
        "default": "{\"cents\":1,\"k\":0,\"zeros\":1,\"neg\":\"paren\",\"red\":1,\"hdr\":1,\"ftr\":1,\"style\":\"xero\",\"dens\":\"100\",\"p\":\"custom\",\"a\":\"custom\",\"c\":\"none\",\"v\":\"\",\"o\":\"q=\"}"
      }
    ],
    "bindings": [
      {
        "id": "org",
        "tool": {
          "mcp": "xero-accounting",
          "name": "get_organisation"
        },
        "params": {
          "xero_tenant_id": {
            "kind": "input",
            "input": "org"
          }
        }
      },
      {
        "id": "connections",
        "tool": {
          "mcp": "xero-accounting",
          "name": "list_connections"
        },
        "params": {}
      }
    ]
  }
}
