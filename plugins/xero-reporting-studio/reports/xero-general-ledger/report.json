{
  "title": "General Ledger",
  "description": "Live, validated Xero General Ledger — every journal in a period from Xero's journal feed, with an account filter and running total, and an account summary tied to the Profit and Loss.",
  "tags": [
    "xero",
    "general-ledger",
    "journals",
    "gl"
  ],
  "fileName": "xero-general-ledger.html",
  "dataBindings": {
    "inputs": [
      {
        "name": "from_date",
        "label": "From",
        "type": "date",
        "default": "2026-07-01"
      },
      {
        "name": "to_date",
        "label": "To",
        "type": "date",
        "default": "today"
      },
      {
        "name": "offset",
        "label": "Journal feed position",
        "type": "number",
        "min": 0,
        "default": 0
      },
      {
        "name": "org",
        "label": "Organisation",
        "type": "string",
        "maxLength": 64,
        "default": ""
      },
      {
        "name": "display",
        "label": "Display settings",
        "type": "string",
        "maxLength": 300,
        "default": "{\"cents\":1,\"k\":0,\"zeros\":0,\"neg\":\"paren\",\"red\":1,\"hdr\":1,\"ftr\":1,\"style\":\"xero\",\"dens\":\"100\",\"p\":\"this_fy_td\",\"a\":\"custom\",\"c\":\"none\",\"v\":\"journals\",\"o\":\"acc=\"}"
      }
    ],
    "bindings": [
      {
        "id": "journals",
        "tool": {
          "mcp": "xero-accounting",
          "name": "list_journals"
        },
        "params": {
          "offset": {
            "kind": "input",
            "input": "offset"
          },
          "paymentsOnly": {
            "kind": "static",
            "value": false
          },
          "xero_tenant_id": {
            "kind": "input",
            "input": "org"
          }
        }
      },
      {
        "id": "pnl",
        "tool": {
          "mcp": "xero-accounting",
          "name": "get_profit_and_loss"
        },
        "params": {
          "fromDate": {
            "kind": "input",
            "input": "from_date"
          },
          "toDate": {
            "kind": "input",
            "input": "to_date"
          },
          "standardLayout": {
            "kind": "static",
            "value": true
          },
          "paymentsOnly": {
            "kind": "static",
            "value": false
          },
          "xero_tenant_id": {
            "kind": "input",
            "input": "org"
          }
        }
      },
      {
        "id": "org",
        "tool": {
          "mcp": "xero-accounting",
          "name": "get_organisation"
        },
        "params": {
          "xero_tenant_id": {
            "kind": "input",
            "input": "org"
          }
        }
      },
      {
        "id": "connections",
        "tool": {
          "mcp": "xero-accounting",
          "name": "list_connections"
        },
        "params": {}
      }
    ]
  }
}
