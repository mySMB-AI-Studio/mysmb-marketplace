{
  "title": "Profit and Loss by tracking category",
  "description": "Live, validated Xero Profit and Loss by tracking category — a column for every option (department, location …), Unassigned and the total, or one option beside the total, accrual or cash, tied to the P&L without tracking.",
  "tags": [
    "xero",
    "profit-and-loss",
    "tracking",
    "departments"
  ],
  "fileName": "xero-tracking-category-pnl.html",
  "dataBindings": {
    "inputs": [
      {
        "name": "from_date",
        "label": "From",
        "type": "date",
        "default": "2026-07-01"
      },
      {
        "name": "to_date",
        "label": "To",
        "type": "date",
        "default": "today"
      },
      {
        "name": "basis",
        "label": "Accounting method",
        "type": "enum",
        "options": [
          "Accrual",
          "Cash"
        ],
        "default": "Accrual"
      },
      {
        "name": "tracking",
        "label": "Tracking category",
        "type": "string",
        "maxLength": 64,
        "default": ""
      },
      {
        "name": "org",
        "label": "Organisation",
        "type": "string",
        "maxLength": 64,
        "default": ""
      },
      {
        "name": "display",
        "label": "Display settings",
        "type": "string",
        "maxLength": 300,
        "default": "{\"cents\":1,\"k\":0,\"zeros\":0,\"neg\":\"paren\",\"red\":1,\"hdr\":1,\"ftr\":1,\"style\":\"xero\",\"dens\":\"100\",\"p\":\"this_fy_td\",\"a\":\"custom\",\"c\":\"none\",\"v\":\"\",\"o\":\"opt=\"}"
      }
    ],
    "bindings": [
      {
        "id": "by_cat",
        "tool": {
          "mcp": "xero-accounting",
          "name": "get_profit_and_loss"
        },
        "params": {
          "fromDate": {
            "kind": "input",
            "input": "from_date"
          },
          "toDate": {
            "kind": "input",
            "input": "to_date"
          },
          "trackingCategoryID": {
            "kind": "input",
            "input": "tracking"
          },
          "standardLayout": {
            "kind": "static",
            "value": true
          },
          "paymentsOnly": {
            "kind": "static",
            "value": false
          },
          "xero_tenant_id": {
            "kind": "input",
            "input": "org"
          }
        }
      },
