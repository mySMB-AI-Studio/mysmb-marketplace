{
  "contentHash": "17d5f398fd6be1201956a6f8fdc046143d2ebfd058becd36e378fbdb58eef17f",
  "definition": {
    "kind": "capability",
    "schemaVersion": 1,
    "key": "xero.payroll.pay-runs.read",
    "originKey": "c9590c25-a6af-40bd-99af-537bfb9047f9",
    "title": "Xero pay runs (read)",
    "sideEffectClass": "read",
    "inputsSchema": {
      "type": "object",
      "properties": {
        "where": { "type": "string", "description": "Optional Xero API filter expression, e.g. PayRunStatus==\"DRAFT\"." },
        "order": { "type": "string", "description": "Optional Xero API sort expression, e.g. PaymentDate DESC." },
        "payRunId": { "type": "string", "description": "When reading a single pay run by id." }
      },
      "additionalProperties": false
    },
    "outputsSchema": {
      "type": "object",
      "properties": {
        "PayRuns": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "PayRunID": { "type": "string" },
              "PayRunStatus": { "type": "string" },
              "PayRunPeriodStartDate": { "type": "string" },
              "PayRunPeriodEndDate": { "type": "string" },
              "PaymentDate": { "type": "string", "description": "Xero /Date(epoch+offset)/ format, not ISO." },
              "Payslips": { "type": "array" }
            }
          }
        }
      }
    },
    "idempotency": { "supported": true },
    "bindings": [
      { "server": "xero-payroll-au", "tool": "list_pay_runs", "argMap": { "where": "where", "order": "order" }, "scopes": ["connectors:xero-payroll-au"] },
      { "server": "xero-payroll-au", "tool": "get_pay_run", "argMap": { "payRunId": "payRunId" }, "scopes": ["connectors:xero-payroll-au"] }
    ],
    "permissionRequirements": ["connectors:xero-payroll-au"]
  },
  "kind": "capability",
  "name": "Xero pay runs (read)",
  "originKey": "c9590c25-a6af-40bd-99af-537bfb9047f9"
