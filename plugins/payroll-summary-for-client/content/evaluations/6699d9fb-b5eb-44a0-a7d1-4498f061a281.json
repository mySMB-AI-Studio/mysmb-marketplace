  "definition": {
    "kind": "evaluation",
    "schemaVersion": 1,
    "key": "payroll-summary-review-controls",
    "title": "Prepare and approve a payroll summary: controls",
    "process": "db69f970-156d-4e5d-9a96-8dfffaae8a77",
    "required": true,
    "thresholds": { "requiredScenarioPassRate": 1 },
    "scenarios": [
      {
        "key": "not-due-yet",
        "title": "No Draft pay run due within the review window yet",
        "inputs": { "clientApproverEmail": "client@example.com" },
        "fixtures": { "outputs": { "checkDue": { "due": false, "payRunId": null, "paymentDateText": "12 Dec 2026", "reviewWindowDays": 3 } } },
        "expected": { "outcome": "notDueYet", "stepsReached": ["checkDue", "notDueYetGate"] }
      },
      {
        "key": "readiness-blocked",
        "title": "Employees missing required fields block the review before it reaches anyone",
        "inputs": { "clientApproverEmail": "client@example.com" },
        "fixtures": {
          "outputs": {
            "checkDue": { "due": true, "payRunId": "pr-1", "paymentDateText": "3 Nov 2026", "reviewWindowDays": 3 },
            "checkReadiness": { "ready": false, "notReadyCount": 2, "balanceConflictCount": 1, "blockingEmployees": [{ "name": "Jane Doe", "missingFields": ["Bank account"] }] }
          }
        },
        "expected": { "outcome": "readinessBlocked", "stepsReached": ["checkDue", "checkReadiness", "readinessBlockedGate"] }
      },
      {
        "key": "reviewer-declined",
        "title": "Reviewer sends the pack back before the client ever sees it",
        "inputs": { "clientApproverEmail": "client@example.com" },
        "fixtures": {
          "outputs": {
            "checkDue": { "due": true, "payRunId": "pr-2", "paymentDateText": "3 Nov 2026", "reviewWindowDays": 3 },
            "checkReadiness": { "ready": true, "notReadyCount": 0, "balanceConflictCount": 0, "blockingEmployees": [] },
            "summarize": { "wages": 50000, "tax": 9000, "super": 5500, "netPay": 41000, "vsLastRunLabel": "+2.1%", "periodText": "21-27 Oct", "paymentDateText": "3 Nov 2026", "allApproved": true, "allMatched": true },
            "internalReview": { "decision": "reject" }
          }
        },
        "expected": { "outcome": "reviewerDeclined", "stepsReached": ["checkDue", "checkReadiness", "summarize", "internalReview", "reviewerDeclinedGate"] }
      },
      {
        "key": "client-declined",
        "title": "Reviewer approves but the client declines",
        "inputs": { "clientApproverEmail": "client@example.com" },
        "fixtures": {
          "outputs": {
            "checkDue": { "due": true, "payRunId": "pr-3", "paymentDateText": "3 Nov 2026", "reviewWindowDays": 3 },
            "checkReadiness": { "ready": true, "notReadyCount": 0, "balanceConflictCount": 0, "blockingEmployees": [] },
            "summarize": { "wages": 50000, "tax": 9000, "super": 5500, "netPay": 41000, "vsLastRunLabel": "+2.1%", "periodText": "21-27 Oct", "paymentDateText": "3 Nov 2026", "allApproved": true, "allMatched": true },
            "internalReview": { "decision": "approve" },
            "clientApproval": { "choiceKey": "decline" }
          }
        },
        "expected": { "outcome": "clientDeclined", "stepsReached": ["checkDue", "checkReadiness", "summarize", "internalReview", "clientApproval", "clientDeclinedGate"] }
      },
      {
        "key": "approved",
        "title": "Reviewer and client both approve",
        "inputs": { "clientApproverEmail": "client@example.com" },
        "fixtures": {
          "outputs": {
            "checkDue": { "due": true, "payRunId": "pr-4", "paymentDateText": "3 Nov 2026", "reviewWindowDays": 3 },
            "checkReadiness": { "ready": true, "notReadyCount": 0, "balanceConflictCount": 0, "blockingEmployees": [] },
            "summarize": { "wages": 50000, "tax": 9000, "super": 5500, "netPay": 41000, "vsLastRunLabel": "+2.1%", "periodText": "21-27 Oct", "paymentDateText": "3 Nov 2026", "allApproved": true, "allMatched": true },
            "internalReview": { "decision": "approve" },
            "clientApproval": { "choiceKey": "approve" }
          }
        },
        "expected": { "outcome": "approved", "stepsReached": ["checkDue", "checkReadiness", "summarize", "internalReview", "clientApproval", "approved"] }
      }
    ],
    "originKey": "6699d9fb-b5eb-44a0-a7d1-4498f061a281"
  },
