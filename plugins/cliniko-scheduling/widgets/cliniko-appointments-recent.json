{
  "id": "cliniko-appointments-recent",
  "title": "Cliniko — Recent appointments",
  "description": "A feed of the most recent individual appointments.",
  "category": "health",
  "tags": [
    "cliniko",
    "scheduling",
    "appointments",
    "calendar"
  ],
  "keywords": [
    "appointment",
    "appointments",
    "schedule",
    "booking",
    "calendar"
  ],
  "connectorsUsed": [
    "cliniko-scheduling"
  ],
  "popularity": 85,
  "sizing": {
    "preferred": {
      "colSpan": 6,
      "rowSpan": 6
    },
    "min": {
      "colSpan": 4,
      "rowSpan": 4
    },
    "max": {
      "colSpan": 12,
      "rowSpan": 12
    }
  },
  "dataProvider": {
    "mcp": "cliniko-scheduling",
    "tool": "list_individual_appointments",
    "params": {
      "per_page": 30,
      "sort": "starts_at:desc"
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "header": {
        "type": "Header",
        "props": {},
        "children": [
          "headerRow"
        ]
      },
      "headerRow": {
        "type": "Row",
        "props": {
          "justify": "between",
          "align": "center"
        },
        "children": [
          "titleGroup",
          "refreshBtn"
        ]
      },
      "titleGroup": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center"
        },
        "children": [
          "titleIcon",
          "titleStack"
        ]
      },
      "titleIcon": {
        "type": "Icon",
        "props": {
          "name": "CalendarClock",
          "tone": "accent",
          "size": "sm"
        }
      },
      "titleStack": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "children": [
          "title",
          "count"
        ]
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "Recent appointments",
          "level": "h2"
        }
      },
      "count": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{n} total",
              "n": {
                "$state": "/cliniko-scheduling/list_individual_appointments/total_entries"
              }
            }
          }
        }
      },
      "refreshBtn": {
        "type": "IconButton",
        "props": {
          "name": "RefreshCw",
          "size": "sm",
          "ariaLabel": "Refresh"
        },
        "on": {
          "click": {
            "action": "cliniko-scheduling.list_individual_appointments",
            "params": {
              "per_page": 30,
              "sort": "starts_at:desc"
            }
          }
        }
      },
      "body": {
        "type": "Body",
        "props": {},
        "children": [
          "loading",
          "empty",
          "list"
        ]
      },
      "loading": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "children": [
          "lk1",
          "lk2",
          "lk3",
          "lk4"
        ],
        "visible": {
          "$state": "/_loading/cliniko-scheduling.list_individual_appointments"
        }
      },
      "lk1": {
        "type": "Skeleton",
        "props": {
          "height": "3rem",
          "rounded": "md"
        }
      },
      "lk2": {
        "type": "Skeleton",
        "props": {
          "height": "3rem",
          "rounded": "md"
        }
      },
      "lk3": {
        "type": "Skeleton",
        "props": {
          "height": "3rem",
          "rounded": "md"
        }
      },
      "lk4": {
        "type": "Skeleton",
        "props": {
          "height": "3rem",
          "rounded": "md"
        }
      },
      "empty": {
        "type": "Empty",
        "props": {
          "message": "No appointments scheduled."
        },
        "visible": {
          "$and": [
            {
              "$state": "/_loading/cliniko-scheduling.list_individual_appointments",
              "not": true
            },
            {
              "$state": "/cliniko-scheduling/list_individual_appointments/individual_appointments/0",
              "not": true
            }
          ]
        }
      },
      "list": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "children": [
          "row"
        ],
        "repeat": {
          "statePath": "/cliniko-scheduling/list_individual_appointments/individual_appointments",
          "key": "id"
        },
        "visible": {
          "$state": "/_loading/cliniko-scheduling.list_individual_appointments",
          "not": true
        }
      },
      "row": {
        "type": "ActivityItem",
        "props": {
          "iconName": "CalendarClock",
          "tone": "accent",
          "title": {
            "$item": "notes"
          },
          "subtitle": "Appointment",
          "timestamp": {
            "$computed": "relative_time",
            "args": {
              "value": {
                "$item": "starts_at"
              }
            }
          }
        }
      },
      "card": {
        "type": "Card",
        "props": {},
        "children": [
          "header",
          "body"
        ]
      }
    }
  },
  "status": "published"
}
