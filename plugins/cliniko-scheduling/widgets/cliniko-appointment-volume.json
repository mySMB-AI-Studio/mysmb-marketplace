{
  "id": "cliniko-appointment-volume",
  "title": "Cliniko — Appointment volume",
  "description": "Total number of individual appointments in the practice.",
  "category": "health",
  "tags": [
    "cliniko",
    "scheduling",
    "kpi",
    "appointments"
  ],
  "keywords": [
    "appointment count",
    "volume",
    "total appointments"
  ],
  "connectorsUsed": [
    "cliniko-scheduling"
  ],
  "popularity": 30,
  "sizing": {
    "preferred": {
      "colSpan": 4,
      "rowSpan": 3
    },
    "min": {
      "colSpan": 3,
      "rowSpan": 2
    },
    "max": {
      "colSpan": 6,
      "rowSpan": 4
    }
  },
  "dataProvider": {
    "mcp": "cliniko-scheduling",
    "tool": "list_individual_appointments",
    "params": {
      "per_page": 1
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": [
          "header",
          "heroRow"
        ]
      },
      "header": {
        "type": "Header",
        "props": {},
        "children": [
          "headerRow"
        ]
      },
      "headerRow": {
        "type": "Row",
        "props": {
          "justify": "between",
          "align": "center"
        },
        "children": [
          "titleGroup",
          "refreshBtn"
        ]
      },
      "titleGroup": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center"
        },
        "children": [
          "titleIcon",
          "title"
        ]
      },
      "titleIcon": {
        "type": "Icon",
        "props": {
          "name": "CalendarCheck",
          "tone": "accent",
          "size": "sm"
        }
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "Appointments",
          "level": "h2"
        }
      },
      "refreshBtn": {
        "type": "IconButton",
        "props": {
          "name": "RefreshCw",
          "size": "sm",
          "ariaLabel": "Refresh"
        },
        "on": {
          "click": {
            "action": "cliniko-scheduling.list_individual_appointments",
            "params": {
              "per_page": 1
            }
          }
        }
      },
      "heroRow": {
        "type": "Row",
        "props": {
          "gap": "md",
          "align": "center"
        },
        "children": [
          "heroIcon",
          "heroStack"
        ]
      },
      "heroIcon": {
        "type": "Icon",
        "props": {
          "name": "CalendarCheck",
          "tone": "accent",
          "size": "lg"
        }
      },
      "heroStack": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "children": [
          "heroVal",
          "heroCaption"
        ]
      },
      "heroVal": {
        "type": "Stat",
        "props": {
          "size": "lg",
          "value": {
            "$state": "/cliniko-scheduling/list_individual_appointments/total_entries"
          }
        }
      },
      "heroCaption": {
        "type": "Caption",
        "props": {
          "text": "Total scheduled"
        }
      }
    }
  },
  "status": "published"
}
