{
  "id": "cliniko-appointment-types",
  "title": "Cliniko — Appointment types",
  "description": "Appointment types offered, with their durations.",
  "category": "health",
  "tags": [
    "cliniko",
    "scheduling",
    "settings",
    "appointment types"
  ],
  "keywords": [
    "appointment type",
    "service",
    "duration",
    "offerings"
  ],
  "connectorsUsed": [
    "cliniko-scheduling"
  ],
  "popularity": 60,
  "sizing": {
    "preferred": {
      "colSpan": 6,
      "rowSpan": 6
    },
    "min": {
      "colSpan": 4,
      "rowSpan": 4
    },
    "max": {
      "colSpan": 12,
      "rowSpan": 12
    }
  },
  "dataProvider": {
    "mcp": "cliniko-scheduling",
    "tool": "list_appointment_types",
    "params": {
      "per_page": 50,
      "sort": "name:asc"
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "header": {
        "type": "Header",
        "props": {},
        "children": [
          "headerRow"
        ]
      },
      "headerRow": {
        "type": "Row",
        "props": {
          "justify": "between",
          "align": "center"
        },
        "children": [
          "titleGroup",
          "refreshBtn"
        ]
      },
      "titleGroup": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center"
        },
        "children": [
          "titleIcon",
          "titleStack"
        ]
      },
      "titleIcon": {
        "type": "Icon",
        "props": {
          "name": "ListChecks",
          "tone": "accent",
          "size": "sm"
        }
      },
      "titleStack": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "children": [
          "title",
          "count"
        ]
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "Appointment types",
          "level": "h2"
        }
      },
      "count": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{n} total",
              "n": {
                "$state": "/cliniko-scheduling/list_appointment_types/total_entries"
              }
            }
          }
        }
      },
      "refreshBtn": {
        "type": "IconButton",
        "props": {
          "name": "RefreshCw",
          "size": "sm",
          "ariaLabel": "Refresh"
        },
        "on": {
          "click": {
            "action": "cliniko-scheduling.list_appointment_types",
            "params": {
              "per_page": 50,
              "sort": "name:asc"
            }
          }
        }
      },
      "body": {
        "type": "Body",
        "props": {},
        "children": [
          "loading",
          "empty",
          "list"
        ]
      },
      "loading": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "children": [
          "lk1",
          "lk2",
          "lk3",
          "lk4"
        ],
        "visible": {
          "$state": "/_loading/cliniko-scheduling.list_appointment_types"
        }
      },
      "lk1": {
        "type": "Skeleton",
        "props": {
          "height": "3rem",
          "rounded": "md"
        }
      },
      "lk2": {
        "type": "Skeleton",
        "props": {
          "height": "3rem",
          "rounded": "md"
        }
      },
      "lk3": {
        "type": "Skeleton",
        "props": {
          "height": "3rem",
          "rounded": "md"
        }
      },
      "lk4": {
        "type": "Skeleton",
        "props": {
          "height": "3rem",
          "rounded": "md"
        }
      },
      "empty": {
        "type": "Empty",
        "props": {
          "message": "No appointment types configured."
        },
        "visible": {
          "$and": [
            {
              "$state": "/_loading/cliniko-scheduling.list_appointment_types",
              "not": true
            },
            {
              "$state": "/cliniko-scheduling/list_appointment_types/appointment_types/0",
              "not": true
            }
          ]
        }
      },
      "list": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "children": [
          "row"
        ],
        "repeat": {
          "statePath": "/cliniko-scheduling/list_appointment_types/appointment_types",
          "key": "id"
        },
        "visible": {
          "$state": "/_loading/cliniko-scheduling.list_appointment_types",
          "not": true
        }
      },
      "row": {
        "type": "ListItem",
        "props": {
          "title": {
            "$item": "name"
          },
          "subtitle": {
            "$item": "category"
          },
          "value": {
            "$item": "duration_in_minutes"
          },
          "valueHint": "min"
        }
      },
      "card": {
        "type": "Card",
        "props": {},
        "children": [
          "header",
          "chartLabel",
          "chartLoading",
          "chart",
          "chartDivider",
          "body"
        ]
      },
      "chartLabel": {
        "type": "Eyebrow",
        "props": {
          "text": "By duration"
        },
        "visible": {
          "$state": "/_loading/cliniko-scheduling.list_appointment_types",
          "not": true
        }
      },
      "chartLoading": {
        "type": "Skeleton",
        "props": {
          "height": "6rem",
          "rounded": "md"
        },
        "visible": {
          "$state": "/_loading/cliniko-scheduling.list_appointment_types"
        }
      },
      "chart": {
        "type": "BarChart",
        "props": {
          "data": {
            "$state": "/cliniko-scheduling/list_appointment_types/appointment_types"
          },
          "labelField": "name",
          "valueField": "duration_in_minutes",
          "valueFormat": "minutes",
          "limit": 8,
          "tone": "info",
          "sort": "desc"
        },
        "visible": {
          "$state": "/_loading/cliniko-scheduling.list_appointment_types",
          "not": true
        }
      },
      "chartDivider": {
        "type": "Divider",
        "props": {}
      }
    }
  },
  "status": "published"
}
