{
  "category": "hr",
  "connectorsUsed": [
    "xero-payroll-au"
  ],
  "dataProvider": {
    "kind": "tool",
    "mcp": "xero-payroll-au",
    "params": {},
    "tool": "get_hours_reconciliation"
  },
  "description": "Compares each employee's total and per-earnings-rate (Ordinary, Overtime, etc.) hours between the approved timesheet and the payslip — proving payroll hours match the approved time source before the pay run is built. Click an employee to see the segment breakdown. Day-level hours aren't available from Xero's API (a payslip's earnings lines have no daily breakdown), so this compares totals and segments only.",
  "id": "xero-payroll-au-hours-reconciliation",
  "keywords": [
    "hours reconciliation",
    "timesheet reconciliation",
    "earnings rate",
    "segment variance",
    "payroll audit"
  ],
  "popularity": 0,
  "sizing": {
    "max": {
      "colSpan": 10,
      "rowSpan": 14
    },
    "min": {
      "colSpan": 4,
      "rowSpan": 6
    },
    "preferred": {
      "colSpan": 5,
      "rowSpan": 9
    }
  },
  "spec": {
    "elements": {
      "approvedIcon": {
        "props": {
          "name": {
            "$cond": {
              "$state": "/xero-payroll-au/get_hours_reconciliation/allApproved"
            },
            "$else": "AlertTriangle",
            "$then": "CheckCircle2"
          },
          "size": "sm",
          "tone": {
            "$cond": {
              "$state": "/xero-payroll-au/get_hours_reconciliation/allApproved"
            },
            "$else": "warning",
            "$then": "success"
          }
        },
        "type": "Icon"
      },
      "approvedSummary": {
        "children": [
          "approvedIcon",
          "approvedText"
        ],
        "props": {
          "align": "center",
          "gap": "xs",
          "grow": true
        },
        "type": "Row"
      },
      "approvedText": {
        "props": {
          "size": "sm",
          "text": {
            "$cond": {
              "$state": "/xero-payroll-au/get_hours_reconciliation/allApproved"
            },
            "$else": "Not all timesheets approved",
            "$then": "All timesheets approved"
          },
          "weight": "medium"
        },
        "type": "Text"
      },
      "body": {
        "children": [
          "loading",
          "errorBanner",
          "empty",
          "content"
        ],
        "props": {},
        "type": "Body"
      },
      "card": {
        "children": [
          "header",
          "body"
        ],
        "props": {},
        "type": "Card",
        "watch": {
          "/xero-payroll-au/get_hours_reconciliation/employees": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/rows",
                "value": {
                  "$computed": "xero-payroll-au_flatten_employee_segments",
                  "args": {
                    "value": {
                      "$state": "/xero-payroll-au/get_hours_reconciliation/employees"
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "content": {
        "children": [
          "periodRow",
          "divider1",
          "summaryRow",
          "unmappedRateCaption",
          "divider2",
          "employeesList"
        ],
        "props": {
          "gap": "md"
        },
        "type": "Stack",
        "visible": {
          "$and": [
            {
              "$state": "/_loading/xero-payroll-au.get_hours_reconciliation",
              "not": true
            },
            {
              "$state": "/xero-payroll-au/get_hours_reconciliation/hasPayRun"
            }
          ]
        }
      },
      "divider1": {
        "props": {},
        "type": "Divider"
      },
      "divider2": {
        "props": {},
        "type": "Divider"
      },
      "employeeBadge": {
        "props": {
          "text": {
            "$computed": "xero-payroll-au_hours_recon_row_label",
            "args": {
              "category": {
                "$item": "category"
              },
              "hasUnmappedRate": {
                "$item": "hasUnmappedRate"
              },
              "hasVariance": {
                "$item": "hasVariance"
              },
              "notApproved": {
                "$item": "notApproved"
              },
              "variance": {
                "$item": "variance"
              }
            }
          },
          "tone": {
            "$computed": "xero-payroll-au_hours_recon_row_tone",
            "args": {
              "category": {
                "$item": "category"
              },
              "hasUnmappedRate": {
                "$item": "hasUnmappedRate"
              },
              "hasVariance": {
                "$item": "hasVariance"
              },
              "notApproved": {
                "$item": "notApproved"
              },
              "variance": {
                "$item": "variance"
              }
            }
          },
          "variant": "soft"
        },
        "type": "Badge"
      },
      "employeeChevron": {
        "props": {
          "name": {
            "$cond": {
              "$item": "employee_id",
              "eq": {
                "$state": "/ui/expandedEmployeeId"
              }
            },
            "$else": "ChevronRight",
            "$then": "ChevronDown"
          },
          "size": "xs",
          "tone": "muted"
        },
        "type": "Icon"
      },
      "employeeCountCaption": {
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "n": {
                "$state": "/xero-payroll-au/get_hours_reconciliation/payRun/employeeCount"
              },
              "pattern": "{n} employees in this pay run"
            }
          },
          "tone": "muted"
        },
        "type": "Caption"
      },
      "employeeHoursCaption": {
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{ts}h source · {pr}h payroll",
              "pr": {
                "$item": "payrollHours"
              },
              "ts": {
                "$item": "timesheetHours"
              }
            }
          },
          "tone": "muted"
        },
        "type": "Caption",
        "visible": {
          "$item": "category",
          "eq": "no_timesheet",
          "not": true
        }
      },
      "employeeLeft": {
        "children": [
          "employeeStatusIcon",
          "employeeName"
        ],
        "props": {
          "align": "center",
          "gap": "xs"
        },
        "type": "Row"
      },
      "employeeName": {
        "props": {
          "size": "sm",
          "text": {
            "$item": "name"
          },
          "weight": "medium"
        },
        "type": "Text"
      },
      "employeeRight": {
        "children": [
          "employeeHoursCaption",
          "employeeBadge",
          "employeeChevron"
        ],
        "props": {
          "align": "center",
          "gap": "sm"
        },
        "type": "Row"
      },
      "employeeRow": {
        "children": [
          "employeeLeft",
          "employeeRight"
        ],
        "on": {
          "click": {
            "action": "setState",
            "params": {
              "statePath": "/ui/expandedEmployeeId",
              "value": {
                "$cond": {
                  "$item": "employee_id",
                  "eq": {
                    "$state": "/ui/expandedEmployeeId"
                  }
                },
                "$else": {
                  "$item": "employee_id"
                },
                "$then": ""
              }
            }
          }
        },
        "props": {
          "align": "center",
          "clickable": true,
          "gap": "sm",
          "hover": true,
          "justify": "between"
        },
        "type": "Row",
        "visible": {
          "$item": "row_type",
          "eq": "employee"
        }
      },
      "employeeStatusIcon": {
        "props": {
          "name": {
            "$computed": "xero-payroll-au_hours_recon_row_icon",
            "args": {
              "category": {
                "$item": "category"
              },
              "hasUnmappedRate": {
                "$item": "hasUnmappedRate"
              },
              "hasVariance": {
                "$item": "hasVariance"
              },
              "notApproved": {
                "$item": "notApproved"
              },
              "variance": {
                "$item": "variance"
              }
            }
          },
          "size": "sm",
          "tone": {
            "$computed": "xero-payroll-au_hours_recon_row_tone",
            "args": {
              "category": {
                "$item": "category"
              },
              "hasUnmappedRate": {
                "$item": "hasUnmappedRate"
              },
              "hasVariance": {
                "$item": "hasVariance"
              },
              "notApproved": {
                "$item": "notApproved"
              },
              "variance": {
                "$item": "variance"
              }
            }
          }
        },
        "type": "Icon"
      },
      "employeesList": {
        "children": [
          "row"
        ],
        "props": {
          "gap": "none"
        },
        "repeat": {
          "key": "id",
          "statePath": "/ui/rows"
        },
        "type": "Stack"
      },
      "empty": {
        "props": {
          "message": "No pay runs found for this organisation."
        },
        "type": "Empty",
        "visible": {
          "$and": [
            {
              "$state": "/_loading/xero-payroll-au.get_hours_reconciliation",
              "not": true
            },
            {
              "$state": "/_errors/xero-payroll-au.get_hours_reconciliation",
              "not": true
            },
            {
              "$state": "/xero-payroll-au/get_hours_reconciliation/hasPayRun",
              "not": true
            }
          ]
        }
      },
      "errorBanner": {
        "props": {
          "text": {
            "$template": "Couldn't load hours reconciliation: ${/_errors/xero-payroll-au.get_hours_reconciliation}"
          },
          "tone": "destructive"
        },
        "type": "Caption",
        "visible": {
          "$state": "/_errors/xero-payroll-au.get_hours_reconciliation"
        }
      },
      "eyebrow": {
        "props": {
          "text": "Xero Payroll AU"
        },
        "type": "Eyebrow"
      },
      "header": {
        "children": [
          "titleGroup"
        ],
        "props": {},
        "type": "Header"
      },
      "loading": {
        "children": [
          "sk1",
          "sk2",
          "sk3",
          "sk4"
        ],
        "props": {
          "gap": "sm"
        },
        "type": "Stack",
        "visible": {
          "$state": "/_loading/xero-payroll-au.get_hours_reconciliation"
        }
      },
      "matchedIcon": {
        "props": {
          "name": {
            "$computed": "xero-payroll-au_hours_recon_summary_icon",
            "args": {
              "approvedCount": {
                "$state": "/xero-payroll-au/get_hours_reconciliation/approvedCount"
              },
              "draftCount": {
                "$state": "/xero-payroll-au/get_hours_reconciliation/draftCount"
              },
              "missingTimesheetCount": {
                "$state": "/xero-payroll-au/get_hours_reconciliation/missingTimesheetCount"
              }
            }
          },
          "size": "sm",
          "tone": {
            "$computed": "xero-payroll-au_hours_recon_summary_tone",
            "args": {
              "approvedCount": {
                "$state": "/xero-payroll-au/get_hours_reconciliation/approvedCount"
              },
              "draftCount": {
                "$state": "/xero-payroll-au/get_hours_reconciliation/draftCount"
              },
              "missingTimesheetCount": {
                "$state": "/xero-payroll-au/get_hours_reconciliation/missingTimesheetCount"
              }
            }
          }
        },
        "type": "Icon"
      },
      "matchedSummary": {
        "children": [
          "matchedIcon",
          "matchedText"
        ],
        "props": {
          "align": "center",
          "gap": "xs",
          "grow": true
        },
        "type": "Row"
      },
      "matchedText": {
        "props": {
          "size": "sm",
          "text": {
            "$computed": "xero-payroll-au_hours_recon_summary_label",
            "args": {
              "approvedCount": {
                "$state": "/xero-payroll-au/get_hours_reconciliation/approvedCount"
              },
              "draftCount": {
                "$state": "/xero-payroll-au/get_hours_reconciliation/draftCount"
              },
              "missingTimesheetCount": {
                "$state": "/xero-payroll-au/get_hours_reconciliation/missingTimesheetCount"
              }
            }
          },
          "weight": "medium"
        },
        "type": "Text"
      },
      "periodRow": {
        "children": [
          "periodStack",
          "statusBadge"
        ],
        "props": {
          "align": "center",
          "gap": "sm",
          "justify": "between"
        },
        "type": "Row"
      },
      "periodStack": {
        "children": [
          "periodText",
          "employeeCountCaption"
        ],
        "props": {
          "gap": "none"
        },
        "type": "Stack"
      },
      "periodText": {
        "props": {
          "level": "h3",
          "text": {
            "$state": "/xero-payroll-au/get_hours_reconciliation/payRun/periodText"
          }
        },
        "type": "Heading"
      },
      "row": {
        "children": [
          "employeeRow",
          "segmentRow"
        ],
        "props": {
          "gap": "none"
        },
        "type": "Stack"
      },
      "segmentBadge": {
        "props": {
          "text": {
            "$computed": "xero-payroll-au_segment_row_label",
            "args": {
              "hasVariance": {
                "$item": "hasVariance"
              },
              "variance": {
                "$item": "variance"
              }
            }
          },
          "tone": {
            "$computed": "xero-payroll-au_segment_row_tone",
            "args": {
              "hasVariance": {
                "$item": "hasVariance"
              }
            }
          },
          "variant": "soft"
        },
        "type": "Badge"
      },
      "segmentHoursCaption": {
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{ts}h · {pr}h",
              "pr": {
                "$item": "payrollHours"
              },
              "ts": {
                "$item": "timesheetHours"
              }
            }
          },
          "tone": "muted"
        },
        "type": "Caption"
      },
      "segmentName": {
        "props": {
          "text": {
            "$item": "name"
          },
          "tone": "muted"
        },
        "type": "Caption"
      },
      "segmentRight": {
        "children": [
          "segmentHoursCaption",
          "segmentBadge"
        ],
        "props": {
          "align": "center",
          "gap": "sm"
        },
        "type": "Row"
      },
      "segmentRow": {
        "children": [
          "segmentName",
          "segmentRight"
        ],
        "props": {
          "align": "center",
          "gap": "sm",
          "justify": "between"
        },
        "type": "Row",
        "visible": {
          "$and": [
            {
              "$item": "row_type",
              "eq": "segment"
            },
            {
              "$item": "employee_id",
              "eq": {
                "$state": "/ui/expandedEmployeeId"
              }
            }
          ]
        }
      },
      "sk1": {
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "sk2": {
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "sk3": {
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "sk4": {
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "statusBadge": {
        "props": {
          "text": {
            "$computed": "xero-payroll-au_title_case",
            "args": {
              "value": {
                "$state": "/xero-payroll-au/get_hours_reconciliation/payRun/status"
              }
            }
          },
          "tone": "brand"
        },
        "type": "Badge"
      },
      "summaryRow": {
        "children": [
          "approvedSummary",
          "matchedSummary"
        ],
        "props": {
          "align": "center",
          "gap": "sm"
        },
        "type": "Row"
      },
      "title": {
        "props": {
          "level": "h2",
          "text": "Hours Reconciliation"
        },
        "type": "Heading"
      },
      "titleGroup": {
        "children": [
          "titleIcon",
          "titleStack"
        ],
        "props": {
          "align": "center",
          "gap": "sm"
        },
        "type": "Row"
      },
      "titleIcon": {
        "props": {
          "name": "GitCompareArrows",
          "size": "sm",
          "tone": "accent"
        },
        "type": "Icon"
      },
      "titleStack": {
        "children": [
          "title",
          "eyebrow"
        ],
        "props": {
          "gap": "none"
        },
        "type": "Stack"
      },
      "unmappedRateCaption": {
        "props": {
          "text": "One or more earnings rates aren't in this organisation's pay items — shown as \"Unmapped rate\" below.",
          "tone": "warning"
        },
        "type": "Caption",
        "visible": {
          "$state": "/xero-payroll-au/get_hours_reconciliation/anyUnmappedRate"
        }
      }
    },
    "root": "card"
  },
  "tags": [
    "xero",
    "payroll",
    "timesheets",
    "hours",
    "hr",
    "reconciliation"
  ],
  "title": "Hours Reconciliation"
}
