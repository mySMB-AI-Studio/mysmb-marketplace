{
  "category": "hr",
  "connectorsUsed": [
    "xero-payroll-au"
  ],
  "dataProvider": {
    "kind": "tool",
    "mcp": "xero-payroll-au",
    "params": {},
    "tool": "get_payroll_readiness_check"
  },
  "description": "A read-only checklist — no writes — covering every employee, active or terminated, since a terminated employee's final pay needs the same complete record as a new hire's first pay. Flags missing required fields (home address, date of birth, tax declaration, bank account, ordinary earnings rate, payroll calendar) and any still-unconfirmed (REQUESTED) leave, separately flagging when requested leave exceeds the employee's current balance — a case that needs an explicit decision, not an automatic approval. Scoped down from a broader 'writes payroll data automatically' request: writing across employee records, leave, timesheets and pay lines with embedded business-rule interpretation isn't something a dashboard tile's fixed logic can safely or correctly do.",
  "id": "xero-payroll-au-payroll-readiness-check",
  "keywords": [
    "payroll readiness",
    "pre-pay check",
    "employee record check",
    "leave balance",
    "confirmed leave",
    "first pay",
    "last pay",
    "termination"
  ],
  "popularity": 0,
  "sizing": {
    "max": {
      "colSpan": 12,
      "rowSpan": 14
    },
    "min": {
      "colSpan": 5,
      "rowSpan": 6
    },
    "preferred": {
      "colSpan": 7,
      "rowSpan": 9
    }
  },
  "spec": {
    "elements": {
      "body": {
        "children": [
          "loading",
          "errorBanner",
          "summaryRow",
          "empty",
          "table"
        ],
        "props": {},
        "type": "Body"
      },
      "card": {
        "children": [
          "header",
          "divider1",
          "body",
          "footer",
          "infoOverlay"
        ],
        "props": {},
        "type": "Card",
        "watch": {
          "/xero-payroll-au/get_payroll_readiness_check": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/rows",
                "value": {
                  "$computed": "xero-payroll-au_payroll_readiness_rows",
                  "args": {
                    "employees": {
                      "$state": "/xero-payroll-au/get_payroll_readiness_check/employees"
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "divider1": {
        "props": {},
        "type": "Divider"
      },
      "empty": {
        "props": {
          "message": "No employees found in Xero Payroll AU."
        },
        "type": "Empty",
        "visible": {
          "$and": [
            {
              "$state": "/_loading/xero-payroll-au.get_payroll_readiness_check",
              "not": true
            },
            {
              "$state": "/ui/rows/0",
              "not": true
            }
          ]
        }
      },
      "errorBanner": {
        "props": {
          "text": {
            "$template": "Couldn't load readiness check: ${/_errors/xero-payroll-au.get_payroll_readiness_check}"
          },
          "tone": "destructive"
        },
        "type": "Caption",
        "visible": {
          "$state": "/_errors/xero-payroll-au.get_payroll_readiness_check"
        }
      },
      "eyebrow": {
        "props": {
          "text": "Xero Payroll AU · read-only, makes no changes"
        },
        "type": "Eyebrow"
      },
      "footer": {
        "children": [
          "openXeroBtn"
        ],
        "props": {
          "justify": "end"
        },
        "type": "Row"
      },
      "header": {
        "children": [
          "titleRow"
        ],
        "props": {},
        "type": "Header"
      },
      "infoBody": {
        "children": [
          "infoWhatLabel",
          "infoWhatText",
          "infoScopeLabel",
          "infoScopeText"
        ],
        "props": {
          "gap": "md"
        },
        "type": "Stack"
      },
      "infoBtn": {
        "on": {
          "click": {
            "action": "setState",
            "params": {
              "statePath": "/ui/showInfo",
              "value": true
            }
          }
        },
        "props": {
          "ariaLabel": "About this tile",
          "icon": "Info",
          "size": "sm",
          "tone": "muted"
        },
        "type": "IconButton"
      },
      "infoCard": {
        "children": [
          "infoCloseBtn",
          "infoTitleRow",
          "infoDivider",
          "infoBody"
        ],
        "props": {},
        "type": "Card"
      },
      "infoCloseBtn": {
        "on": {
          "click": {
            "action": "setState",
            "params": {
              "statePath": "/ui/showInfo",
              "value": false
            }
          }
        },
        "props": {
          "ariaLabel": "Close",
          "floating": true,
          "icon": "X",
          "size": "sm",
          "tone": "muted"
        },
        "type": "IconButton"
      },
      "infoDivider": {
        "props": {},
        "type": "Divider"
      },
      "infoOverlay": {
        "children": [
          "infoCard"
        ],
        "on": {
          "backdropClick": {
            "action": "setState",
            "params": {
              "statePath": "/ui/showInfo",
              "value": false
            }
          }
        },
        "props": {
          "maxWidth": "28rem"
        },
        "type": "Overlay",
        "visible": {
          "$state": "/ui/showInfo"
        }
      },
      "infoScopeLabel": {
        "props": {
          "text": "Why it's read-only",
          "tone": "muted",
          "weight": "semibold"
        },
        "type": "Caption"
      },
      "infoScopeText": {
        "props": {
          "size": "sm",
          "text": "A tile's logic is fixed and deterministic — it can check a known checklist, but it can't interpret open-ended business rules or write confirmed changes across employee records, leave, timesheets and pay lines safely. This tile intentionally does the safe, verifiable half: flagging what needs a human decision before payroll is run."
        },
        "type": "Text"
      },
      "infoTitleIcon": {
        "props": {
          "name": "Info",
          "size": "sm",
          "tone": "info"
        },
        "type": "Icon"
      },
      "infoTitleRow": {
        "children": [
          "infoTitleIcon",
          "infoTitleText"
        ],
        "props": {
          "align": "center",
          "gap": "sm"
        },
        "type": "Row"
      },
      "infoTitleText": {
        "props": {
          "level": "h2",
          "text": "How this tile works"
        },
        "type": "Heading"
      },
      "infoWhatLabel": {
        "props": {
          "text": "What this is",
          "tone": "muted",
          "weight": "semibold"
        },
        "type": "Caption"
      },
      "infoWhatText": {
        "props": {
          "size": "sm",
          "text": "Checks every employee — active or terminated — for a complete record and any unconfirmed leave before you run payroll. Makes no changes to Xero at all; it's a checklist, not a gate."
        },
        "type": "Text"
      },
      "loading": {
        "children": [
          "sk1",
          "sk2",
          "sk3"
        ],
        "props": {
          "gap": "sm"
        },
        "type": "Stack",
        "visible": {
          "$state": "/_loading/xero-payroll-au.get_payroll_readiness_check"
        }
      },
      "openXeroBtn": {
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "target": "_blank",
              "url": "https://go.xero.com/"
            }
          }
        },
        "props": {
          "label": "Open Payroll in Xero",
          "leadingIcon": "ExternalLink",
          "size": "sm",
          "tone": "brand",
          "variant": "primary"
        },
        "type": "Button"
      },
      "sk1": {
        "props": {
          "height": "2.25rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "sk2": {
        "props": {
          "height": "2.25rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "sk3": {
        "props": {
          "height": "2.25rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "summaryConflict": {
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "n": {
                "$state": "/xero-payroll-au/get_payroll_readiness_check/balanceConflictCount"
              },
              "pattern": "{n} balance conflicts"
            }
          },
          "tone": "destructive"
        },
        "type": "Caption",
        "visible": {
          "$state": "/xero-payroll-au/get_payroll_readiness_check/balanceConflictCount"
        }
      },
      "summaryNotReady": {
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "n": {
                "$state": "/xero-payroll-au/get_payroll_readiness_check/notReadyCount"
              },
              "pattern": "{n} need attention"
            }
          },
          "tone": "warning"
        },
        "type": "Caption"
      },
      "summaryReady": {
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "n": {
                "$state": "/xero-payroll-au/get_payroll_readiness_check/readyCount"
              },
              "pattern": "{n} ready"
            }
          },
          "tone": "success"
        },
        "type": "Caption"
      },
      "summaryRow": {
        "children": [
          "summaryReady",
          "summaryNotReady",
          "summaryConflict"
        ],
        "props": {
          "align": "center",
          "gap": "md"
        },
        "type": "Row",
        "visible": {
          "$state": "/_loading/xero-payroll-au.get_payroll_readiness_check",
          "not": true
        }
      },
      "table": {
        "props": {
          "columns": [
            {
              "field": "name",
              "header": "Employee",
              "id": "name",
              "width": 150
            },
            {
              "field": "employmentType",
              "header": "Type",
              "id": "employmentType",
              "width": 90
            },
            {
              "field": "statusLabel",
              "header": "Status",
              "id": "status",
              "width": 110
            },
            {
              "field": "issuesSummary",
              "header": "Issues",
              "id": "issues",
              "width": 320
            }
          ],
          "rows": {
            "$state": "/ui/rows"
          }
        },
        "type": "Table",
        "visible": {
          "$and": [
            {
              "$state": "/_loading/xero-payroll-au.get_payroll_readiness_check",
              "not": true
            },
            {
              "$state": "/ui/rows/0"
            }
          ]
        }
      },
      "title": {
        "props": {
          "level": "h2",
          "text": "Payroll Readiness Check"
        },
        "type": "Heading"
      },
      "titleGroup": {
        "children": [
          "titleIcon",
          "titleStack"
        ],
        "props": {
          "align": "center",
          "gap": "sm"
        },
        "type": "Row"
      },
      "titleIcon": {
        "props": {
          "name": "ClipboardCheck",
          "size": "sm",
          "tone": "info"
        },
        "type": "Icon"
      },
      "titleRow": {
        "children": [
          "titleGroup",
          "infoBtn"
        ],
        "props": {
          "align": "center",
          "gap": "sm",
          "justify": "between"
        },
        "type": "Row"
      },
      "titleStack": {
        "children": [
          "title",
          "eyebrow"
        ],
        "props": {
          "gap": "none"
        },
        "type": "Stack"
      }
    },
    "root": "card"
  },
  "tags": [
    "xero",
    "payroll",
    "readiness",
    "compliance",
    "leave",
    "employees",
    "hr"
  ],
  "title": "Payroll Readiness Check"
}
