{
  "id": "xero-payroll-au-payroll-readiness-check",
  "title": "Payroll Readiness Check",
  "description": "A read-only checklist — no writes — covering every employee, active or terminated, since a terminated employee's final pay needs the same complete record as a new hire's first pay. Flags missing required fields (home address, date of birth, tax declaration, bank account, ordinary earnings rate, payroll calendar) and any still-unconfirmed (REQUESTED) leave, separately flagging when requested leave exceeds the employee's current balance — a case that needs an explicit decision, not an automatic approval. Scoped down from a broader 'writes payroll data automatically' request: writing across employee records, leave, timesheets and pay lines with embedded business-rule interpretation isn't something a dashboard tile's fixed logic can safely or correctly do.",
  "category": "hr",
  "tags": ["xero", "payroll", "readiness", "compliance", "leave", "employees", "hr"],
  "keywords": ["payroll readiness", "pre-pay check", "employee record check", "leave balance", "confirmed leave", "first pay", "last pay", "termination"],
  "connectorsUsed": ["xero-payroll-au"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 7, "rowSpan": 9 },
    "min": { "colSpan": 5, "rowSpan": 6 },
    "max": { "colSpan": 12, "rowSpan": 14 }
  },
  "dataProvider": {
    "kind": "tool",
    "mcp": "xero-payroll-au",
    "tool": "get_payroll_readiness_check",
    "params": {}
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": ["header", "divider1", "body", "footer", "infoOverlay"],
        "watch": {
          "/xero-payroll-au/get_payroll_readiness_check": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/rows",
                "value": {
                  "$computed": "xero-payroll-au_payroll_readiness_rows",
                  "args": { "employees": { "$state": "/xero-payroll-au/get_payroll_readiness_check/employees" } }
                }
              }
            }
          ]
        }
      },

      "header": { "type": "Header", "props": {}, "children": ["titleRow"] },
      "titleRow": { "type": "Row", "props": { "gap": "sm", "align": "center", "justify": "between" }, "children": ["titleGroup", "infoBtn"] },
      "titleGroup": { "type": "Row", "props": { "gap": "sm", "align": "center" }, "children": ["titleIcon", "titleStack"] },
      "titleIcon": { "type": "Icon", "props": { "name": "ClipboardCheck", "tone": "info", "size": "sm" } },
      "titleStack": { "type": "Stack", "props": { "gap": "none" }, "children": ["title", "eyebrow"] },
      "title": { "type": "Heading", "props": { "text": "Payroll Readiness Check", "level": "h2" } },
      "eyebrow": { "type": "Eyebrow", "props": { "text": "Xero Payroll AU · read-only, makes no changes" } },
      "infoBtn": {
        "type": "IconButton",
        "props": { "icon": "Info", "size": "sm", "tone": "muted", "ariaLabel": "About this tile" },
        "on": { "click": { "action": "setState", "params": { "statePath": "/ui/showInfo", "value": true } } }
      },

      "divider1": { "type": "Divider", "props": {} },

      "body": { "type": "Body", "props": {}, "children": ["loading", "errorBanner", "summaryRow", "empty", "table"] },

      "loading": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "visible": { "$state": "/_loading/xero-payroll-au.get_payroll_readiness_check" },
        "children": ["sk1", "sk2", "sk3"]
      },
      "sk1": { "type": "Skeleton", "props": { "height": "2.25rem", "rounded": "md" } },
      "sk2": { "type": "Skeleton", "props": { "height": "2.25rem", "rounded": "md" } },
      "sk3": { "type": "Skeleton", "props": { "height": "2.25rem", "rounded": "md" } },

      "errorBanner": {
        "type": "Caption",
        "props": {
          "text": { "$template": "Couldn't load readiness check: ${/_errors/xero-payroll-au.get_payroll_readiness_check}" },
          "tone": "destructive"
        },
        "visible": { "$state": "/_errors/xero-payroll-au.get_payroll_readiness_check" }
      },

      "summaryRow": {
        "type": "Row",
        "props": { "gap": "md", "align": "center" },
        "visible": { "$state": "/_loading/xero-payroll-au.get_payroll_readiness_check", "not": true },
        "children": ["summaryReady", "summaryNotReady", "summaryConflict"]
      },
      "summaryReady": {
        "type": "Caption",
        "props": {
          "text": { "$computed": "fmt", "args": { "pattern": "{n} ready", "n": { "$state": "/xero-payroll-au/get_payroll_readiness_check/readyCount" } } },
          "tone": "success"
        }
      },
      "summaryNotReady": {
        "type": "Caption",
        "props": {
          "text": { "$computed": "fmt", "args": { "pattern": "{n} need attention", "n": { "$state": "/xero-payroll-au/get_payroll_readiness_check/notReadyCount" } } },
          "tone": "warning"
        }
      },
      "summaryConflict": {
        "type": "Caption",
        "props": {
          "text": { "$computed": "fmt", "args": { "pattern": "{n} balance conflicts", "n": { "$state": "/xero-payroll-au/get_payroll_readiness_check/balanceConflictCount" } } },
          "tone": "destructive"
        },
        "visible": { "$state": "/xero-payroll-au/get_payroll_readiness_check/balanceConflictCount" }
      },

      "empty": {
        "type": "Empty",
        "props": { "message": "No employees found in Xero Payroll AU." },
        "visible": {
          "$and": [
            { "$state": "/_loading/xero-payroll-au.get_payroll_readiness_check", "not": true },
            { "$state": "/ui/rows/0", "not": true }
          ]
        }
      },

      "table": {
        "props": {
          "columns": [
            { "id": "name", "header": "Employee", "field": "name", "width": 150 },
            { "id": "employmentType", "header": "Type", "field": "employmentType", "width": 90 },
            { "id": "status", "header": "Status", "field": "statusLabel", "width": 110 },
            { "id": "issues", "header": "Issues", "field": "issuesSummary", "width": 320 }
          ],
          "rows": { "$state": "/ui/rows" }
        },
        "type": "Table",
        "visible": {
          "$and": [
            { "$state": "/_loading/xero-payroll-au.get_payroll_readiness_check", "not": true },
            { "$state": "/ui/rows/0" }
          ]
        }
      },

      "footer": {
        "type": "Row",
        "props": { "justify": "end" },
        "children": ["openXeroBtn"]
      },
      "openXeroBtn": {
        "type": "Button",
        "props": { "label": "Open Payroll in Xero", "tone": "brand", "variant": "primary", "size": "sm", "leadingIcon": "ExternalLink" },
        "on": {
          "click": { "action": "open_url", "params": { "url": "https://go.xero.com/", "target": "_blank" } }
        }
      },

      "infoOverlay": {
        "type": "Overlay",
        "props": { "maxWidth": "28rem" },
        "children": ["infoCard"],
        "visible": { "$state": "/ui/showInfo" },
        "on": {
          "backdropClick": { "action": "setState", "params": { "statePath": "/ui/showInfo", "value": false } }
        }
      },
      "infoCard": {
        "type": "Card",
        "props": {},
        "children": ["infoCloseBtn", "infoTitleRow", "infoDivider", "infoBody"]
      },
      "infoCloseBtn": {
        "type": "IconButton",
        "props": { "icon": "X", "size": "sm", "tone": "muted", "ariaLabel": "Close", "floating": true },
        "on": { "click": { "action": "setState", "params": { "statePath": "/ui/showInfo", "value": false } } }
      },
      "infoTitleRow": { "type": "Row", "props": { "align": "center", "gap": "sm" }, "children": ["infoTitleIcon", "infoTitleText"] },
      "infoTitleIcon": { "type": "Icon", "props": { "name": "Info", "size": "sm", "tone": "info" } },
      "infoTitleText": { "type": "Heading", "props": { "text": "How this tile works", "level": "h2" } },
      "infoDivider": { "type": "Divider", "props": {} },
      "infoBody": {
        "type": "Stack",
        "props": { "gap": "md" },
        "children": ["infoWhatLabel", "infoWhatText", "infoScopeLabel", "infoScopeText"]
      },
      "infoWhatLabel": { "type": "Caption", "props": { "text": "What this is", "tone": "muted", "weight": "semibold" } },
      "infoWhatText": {
        "type": "Text",
        "props": {
          "text": "Checks every employee — active or terminated — for a complete record and any unconfirmed leave before you run payroll. Makes no changes to Xero at all; it's a checklist, not a gate.",
          "size": "sm"
        }
      },
      "infoScopeLabel": { "type": "Caption", "props": { "text": "Why it's read-only", "tone": "muted", "weight": "semibold" } },
      "infoScopeText": {
        "type": "Text",
        "props": {
          "text": "A tile's logic is fixed and deterministic — it can check a known checklist, but it can't interpret open-ended business rules or write confirmed changes across employee records, leave, timesheets and pay lines safely. This tile intentionally does the safe, verifiable half: flagging what needs a human decision before payroll is run.",
          "size": "sm"
        }
      }
    }
  },
  "status": "published"
}
