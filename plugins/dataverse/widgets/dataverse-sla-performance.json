{
  "id": "dataverse-sla-performance-v3",
  "status": "published",
  "title": "SLA Performance",
  "description": "Live SLA KPI status across active Dynamics 365 cases — highlights at-risk and breached SLAs.",
  "category": "support",
  "tags": ["dataverse", "dynamics-365", "sla", "cases", "performance", "customer-service", "support"],
  "keywords": ["sla", "service level", "breach", "at risk", "kpi", "performance", "cases", "d365"],
  "connectorsUsed": ["dataverse"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 8, "rowSpan": 5 },
    "min":       { "colSpan": 6, "rowSpan": 4 },
    "max":       { "colSpan": 12, "rowSpan": 10 }
  },
  "dataProvider": {
    "mcp": "dataverse",
    "tool": "list_sla_kpis",
    "params": { "org_url": "https://mysmb-dev.crm6.dynamics.com", "status_filter": "active", "top": 20 }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": ["titleRow", "stats", "divider", "tableBody", "footerDivider", "footer"]
      },
      "titleRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["titleGroup", "brandBadge"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "Clock", "tone": "accent", "size": "sm" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "eyebrow"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "SLA Performance", "level": "h2" }
      },
      "eyebrow": {
        "type": "Eyebrow",
        "props": { "text": "Dynamics 365 Customer Service" }
      },
      "brandBadge": {
        "type": "Badge",
        "props": { "text": "Dynamics 365", "tone": "info" }
      },
      "tableBody": {
        "type": "Body",
        "props": {},
        "children": ["table"]
      },
      "stats": {
        "type": "Grid",
        "props": { "cols": 2 },
        "children": ["tileActive", "tileBreached"]
      },
      "tileActive": {
        "type": "Section",
        "props": { "variant": "muted" },
        "children": ["stackActive"]
      },
      "stackActive": {
        "type": "Stack",
        "props": { "gap": "xxs", "align": "center" },
        "children": ["iconActive", "valActive", "lblActive"]
      },
      "iconActive": {
        "type": "Icon",
        "props": { "name": "Clock", "size": "sm", "tone": "accent" }
      },
      "valActive": {
        "type": "Heading",
        "props": {
          "text": {
            "$computed": "count",
            "args": { "value": { "$state": "/dataverse/list_sla_kpis/sla_kpis" } }
          },
          "level": "h2"
        }
      },
      "lblActive": {
        "type": "Caption",
        "props": { "text": "Active SLAs" }
      },
      "tileBreached": {
        "type": "Section",
        "props": { "variant": "muted" },
        "children": ["stackBreached"]
      },
      "stackBreached": {
        "type": "Stack",
        "props": { "gap": "xxs", "align": "center" },
        "children": ["iconBreached", "valBreached", "lblBreached"]
      },
      "iconBreached": {
        "type": "Icon",
        "props": { "name": "AlertTriangle", "size": "sm", "tone": "destructive" }
      },
      "valBreached": {
        "type": "Heading",
        "props": {
          "text": {
            "$computed": "count_where",
            "args": {
              "value": { "$state": "/dataverse/list_sla_kpis/sla_kpis" },
              "field": "status",
              "eq": 2
            }
          },
          "level": "h2"
        }
      },
      "lblBreached": {
        "type": "Caption",
        "props": { "text": "Breached", "tone": "destructive" }
      },
      "divider": { "type": "Divider", "props": {} },
      "table": {
        "type": "Table",
        "props": {
          "loading": { "$state": "/_loading/dataverse.list_sla_kpis" },
          "skeletonRows": 6,
          "rows": { "$state": "/dataverse/list_sla_kpis/sla_kpis" },
          "columns": [
            { "id": "name",        "header": "SLA",          "field": "name",                "priority": 1 },
            { "id": "status",      "header": "Status",       "field": "status",              "width": 90,  "priority": 1 },
            { "id": "failuretime", "header": "Breach Time",  "field": "computedfailuretime", "width": 130, "priority": 1, "format": "relative" },
            { "id": "warningtime", "header": "Warning Time", "field": "computedwarningtime", "width": 130, "priority": 2, "format": "relative" }
          ]
        }
      },
      "footerDivider": { "type": "Divider", "props": {} },
      "footer": {
        "type": "Row",
        "props": { "justify": "end", "gap": "xs", "align": "center" },
        "children": ["footerBtn"]
      },
      "footerBtn": {
        "type": "Button",
        "props": {
          "label": "Open in D365",
          "variant": "ghost",
          "size": "sm",
          "leadingIcon": "ExternalLink"
        },
        "on": {
          "click": {
            "action": "open_url",
            "params": { "url": "https://mysmb-dev.crm6.dynamics.com", "target": "_blank" }
          }
        }
      }
    }
  }
}
