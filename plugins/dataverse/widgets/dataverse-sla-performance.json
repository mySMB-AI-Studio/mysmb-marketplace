{
  "id": "dataverse-sla-performance-v3",
  "status": "published",
  "title": "SLA Performance",
  "description": "Live SLA KPI status across active Dynamics 365 cases — highlights at-risk and breached SLAs.",
  "category": "support",
  "tags": ["dataverse", "dynamics-365", "sla", "cases", "performance", "customer-service", "support"],
  "keywords": ["sla", "service level", "breach", "at risk", "kpi", "performance", "cases", "d365"],
  "connectorsUsed": ["dataverse"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 8, "rowSpan": 5 },
    "min":       { "colSpan": 8, "rowSpan": 4 },
    "max":       { "colSpan": 12, "rowSpan": 10 }
  },
  "dataProvider": {
    "mcp": "dataverse",
    "tool": "list_sla_kpis",
    "params": { "org_url": "https://mysmb-dev.crm6.dynamics.com", "status_filter": "monitored", "days_back": 7, "top": 20 }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": ["titleRow", "stats", "divider", "tableLabelRow", "tableBody", "footerDivider", "footer"]
      },
      "titleRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["titleGroup"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "Clock", "tone": "accent", "size": "sm" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "eyebrow"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "SLA Performance", "level": "h2" }
      },
      "eyebrow": {
        "type": "Eyebrow",
        "props": { "text": "Dynamics 365 Customer Service · Last 7 days" }
      },

      "stats": {
        "type": "Grid",
        "props": { "cols": 4, "gap": "sm" },
        "children": ["tileActive", "tileAtRisk", "tileBreached", "tileBreachRate"]
      },

      "tileActive": {
        "type": "Section",
        "props": { "variant": "muted" },
        "children": ["stackActive"],
        "on": { "click": { "action": "setState", "params": { "statePath": "/ui/sla/filter", "value": "" } } }
      },
      "stackActive": {
        "type": "Stack",
        "props": { "gap": "xxs", "align": "center" },
        "children": ["iconActive", "valActive", "lblActive", "dotActive"]
      },
      "iconActive": {
        "type": "Icon",
        "props": { "name": "Clock", "size": "sm", "tone": "accent" }
      },
      "valActive": {
        "type": "Stat",
        "props": {
          "value": {
            "$computed": "count",
            "args": { "value": { "$state": "/dataverse/list_sla_kpis/sla_kpis" } }
          }
        }
      },
      "lblActive": {
        "type": "Caption",
        "props": { "text": "Total SLAs" }
      },
      "dotActive": {
        "type": "Dot",
        "props": { "tone": "accent", "size": "xs" },
        "visible": { "$state": "/ui/sla/filter", "not": true }
      },

      "tileAtRisk": {
        "type": "Section",
        "props": { "variant": "muted" },
        "children": ["stackAtRisk"],
        "on": { "click": { "action": "setState", "params": { "statePath": "/ui/sla/filter", "value": "Nearing Noncompliance" } } }
      },
      "stackAtRisk": {
        "type": "Stack",
        "props": { "gap": "xxs", "align": "center" },
        "children": ["iconAtRisk", "valAtRisk", "lblAtRisk", "dotAtRisk"]
      },
      "iconAtRisk": {
        "type": "Icon",
        "props": { "name": "AlertCircle", "size": "sm", "tone": "warning" }
      },
      "valAtRisk": {
        "type": "Stat",
        "props": {
          "value": {
            "$computed": "count_where",
            "args": {
              "value": { "$state": "/dataverse/list_sla_kpis/sla_kpis" },
              "whereField": "status_label",
              "equals": "Nearing Noncompliance"
            }
          }
        }
      },
      "lblAtRisk": {
        "type": "Caption",
        "props": { "text": "At Risk" }
      },
      "dotAtRisk": {
        "type": "Dot",
        "props": { "tone": "warning", "size": "xs" },
        "visible": { "$computed": "equals", "args": { "a": { "$state": "/ui/sla/filter" }, "b": "Nearing Noncompliance" } }
      },

      "tileBreached": {
        "type": "Section",
        "props": { "variant": "muted" },
        "children": ["stackBreached"],
        "on": { "click": { "action": "setState", "params": { "statePath": "/ui/sla/filter", "value": "Noncompliant" } } }
      },
      "stackBreached": {
        "type": "Stack",
        "props": { "gap": "xxs", "align": "center" },
        "children": ["iconBreached", "valBreached", "lblBreached", "dotBreached"]
      },
      "iconBreached": {
        "type": "Icon",
        "props": { "name": "AlertTriangle", "size": "sm", "tone": "destructive" }
      },
      "valBreached": {
        "type": "Stat",
        "props": {
          "value": {
            "$computed": "count_where",
            "args": {
              "value": { "$state": "/dataverse/list_sla_kpis/sla_kpis" },
              "whereField": "status_label",
              "equals": "Noncompliant"
            }
          }
        }
      },
      "lblBreached": {
        "type": "Caption",
        "props": { "text": "Breached", "tone": "destructive" }
      },
      "dotBreached": {
        "type": "Dot",
        "props": { "tone": "destructive", "size": "xs" },
        "visible": { "$computed": "equals", "args": { "a": { "$state": "/ui/sla/filter" }, "b": "Noncompliant" } }
      },

      "tileBreachRate": {
        "type": "Section",
        "props": { "variant": "muted" },
        "children": ["stackBreachRate"]
      },
      "stackBreachRate": {
        "type": "Stack",
        "props": { "gap": "xxs", "align": "center" },
        "children": ["iconBreachRate", "valBreachRate", "lblBreachRate"]
      },
      "iconBreachRate": {
        "type": "Icon",
        "props": { "name": "Percent", "size": "sm", "tone": "destructive" }
      },
      "valBreachRate": {
        "type": "Stat",
        "props": {
          "value": {
            "$computed": "fmt",
            "args": {
              "pattern": "{n}%",
              "n": {
                "$computed": "pct",
                "args": {
                  "part": {
                    "$computed": "count_where",
                    "args": {
                      "value": { "$state": "/dataverse/list_sla_kpis/sla_kpis" },
                      "whereField": "status_label",
                      "equals": "Noncompliant"
                    }
                  },
                  "whole": {
                    "$computed": "count",
                    "args": { "value": { "$state": "/dataverse/list_sla_kpis/sla_kpis" } }
                  }
                }
              }
            }
          }
        }
      },
      "lblBreachRate": {
        "type": "Caption",
        "props": { "text": "Breach Rate", "tone": "destructive" }
      },

      "divider": { "type": "Divider", "props": {} },

      "tableLabelRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["tableLabel", "clearFilterBtn"]
      },
      "tableLabel": {
        "type": "Eyebrow",
        "props": { "text": "Active SLAs" }
      },
      "clearFilterBtn": {
        "type": "IconButton",
        "props": { "icon": "X", "tone": "muted", "size": "sm", "ariaLabel": "Clear filter" },
        "visible": { "$state": "/ui/sla/filter" },
        "on": { "click": { "action": "setState", "params": { "statePath": "/ui/sla/filter", "value": "" } } }
      },

      "tableBody": {
        "type": "Body",
        "props": {},
        "children": ["table", "tableFiltered"]
      },
      "table": {
        "type": "Table",
        "props": {
          "loading": { "$state": "/_loading/dataverse.list_sla_kpis" },
          "skeletonRows": 6,
          "rows": { "$state": "/dataverse/list_sla_kpis/sla_kpis" },
          "columns": [
            { "id": "ticket",      "header": "Case",        "field": "case_ticket",         "width": 110, "priority": 1 },
            { "id": "casetitle",   "header": "Case Title",  "field": "case_title",          "priority": 1 },
            { "id": "name",        "header": "SLA Type",    "field": "name",                "width": 130, "priority": 2 },
            { "id": "status",      "header": "Status",      "field": "status_label",        "width": 110, "priority": 1 },
            { "id": "failuretime", "header": "Breach Time", "field": "computedfailuretime", "width": 130, "priority": 1, "format": "relative" }
          ]
        },
        "visible": { "$state": "/ui/sla/filter", "not": true }
      },
      "tableFiltered": {
        "type": "Table",
        "props": {
          "loading": { "$state": "/_loading/dataverse.list_sla_kpis" },
          "skeletonRows": 6,
          "rows": {
            "$computed": "filter_by",
            "args": {
              "value": { "$state": "/dataverse/list_sla_kpis/sla_kpis" },
              "field": "status_label",
              "equals": { "$state": "/ui/sla/filter" }
            }
          },
          "columns": [
            { "id": "ticket",      "header": "Case",        "field": "case_ticket",         "width": 110, "priority": 1 },
            { "id": "casetitle",   "header": "Case Title",  "field": "case_title",          "priority": 1 },
            { "id": "name",        "header": "SLA Type",    "field": "name",                "width": 130, "priority": 2 },
            { "id": "status",      "header": "Status",      "field": "status_label",        "width": 110, "priority": 1 },
            { "id": "failuretime", "header": "Breach Time", "field": "computedfailuretime", "width": 130, "priority": 1, "format": "relative" }
          ]
        },
        "visible": { "$state": "/ui/sla/filter" }
      },

      "footerDivider": { "type": "Divider", "props": {} },
      "footer": {
        "type": "Row",
        "props": { "justify": "end", "gap": "xs", "align": "center" },
        "children": ["footerBtn"]
      },
      "footerBtn": {
        "type": "Button",
        "props": {
          "label": "Open in D365",
          "variant": "ghost",
          "size": "sm",
          "leadingIcon": "ExternalLink"
        },
        "on": {
          "click": {
            "action": "open_url",
            "params": { "url": "https://mysmb-dev.crm6.dynamics.com", "target": "_blank" }
          }
        }
      }
    }
  }
}
