{
  "id": "dataverse-sla-breach-trend-demo",
  "title": "SLA Breach Trend",
  "description": "SLA performance over the last 7 days — Met vs Breached trends. Demo version with static data.",
  "category": "support",
  "tags": ["dataverse", "dynamics-365", "sla", "customer-service", "support", "demo"],
  "keywords": ["sla", "breach", "met", "customer service", "d365", "performance", "trend"],
  "connectorsUsed": ["dataverse"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 5, "rowSpan": 10 },
    "min":       { "colSpan": 4, "rowSpan": 9 },
    "max":       { "colSpan": 10, "rowSpan": 14 }
  },
  "spec": {
    "root": "card",
    "elements": {

      "card": {
        "type": "Card",
        "props": {},
        "children": ["headerRow", "div0", "statsGrid", "div1", "metChartLabel", "metChart", "div2", "breachedChartLabel", "breachedChart", "div3", "kvGrid"]
      },

      "headerRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["titleGroup"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": { "type": "Icon", "props": { "name": "Clock", "tone": "destructive", "size": "sm" } },
      "titleStack": { "type": "Stack", "props": { "gap": "none" }, "children": ["title", "eyebrow"] },
      "title": { "type": "Heading", "props": { "text": "SLA Breach Trend", "level": "h2" } },
      "eyebrow": { "type": "Eyebrow", "props": { "text": "Dynamics 365 Customer Service · Last 7 days" } },

      "div0": { "type": "Divider", "props": {} },

      "statsGrid": {
        "type": "Grid",
        "props": { "cols": 3, "gap": "sm" },
        "children": ["tileTotal", "tileBreached", "tileRate"]
      },

      "tileTotal": { "type": "Section", "props": { "variant": "muted" }, "children": ["stackTotal"] },
      "stackTotal": { "type": "Stack", "props": { "gap": "xxs", "align": "center" }, "children": ["iconTotal", "valTotal", "lblTotal"] },
      "iconTotal": { "type": "Icon", "props": { "name": "ClipboardList", "size": "sm", "tone": "accent" } },
      "valTotal": { "type": "Heading", "props": { "text": "142", "level": "h2" } },
      "lblTotal": { "type": "Caption", "props": { "text": "Total SLAs" } },

      "tileBreached": { "type": "Section", "props": { "variant": "muted" }, "children": ["stackBreached"] },
      "stackBreached": { "type": "Stack", "props": { "gap": "xxs", "align": "center" }, "children": ["iconBreached", "valBreached", "lblBreached"] },
      "iconBreached": { "type": "Icon", "props": { "name": "AlertTriangle", "size": "sm", "tone": "destructive" } },
      "valBreached": { "type": "Heading", "props": { "text": "38", "level": "h2", "tone": "destructive" } },
      "lblBreached": { "type": "Caption", "props": { "text": "Breached" } },

      "tileRate": { "type": "Section", "props": { "variant": "muted" }, "children": ["stackRate"] },
      "stackRate": { "type": "Stack", "props": { "gap": "xxs", "align": "center" }, "children": ["iconRate", "valRate", "lblRate"] },
      "iconRate": { "type": "Icon", "props": { "name": "Percent", "size": "sm", "tone": "destructive" } },
      "valRate": { "type": "Heading", "props": { "text": "27%", "level": "h2", "tone": "destructive" } },
      "lblRate": { "type": "Caption", "props": { "text": "Breach Rate" } },

      "div1": { "type": "Divider", "props": {} },

      "metChartLabel": { "type": "Eyebrow", "props": { "text": "Met · Mon → Sun" } },
      "metChart": {
        "type": "Sparkline",
        "props": { "values": [12, 15, 20, 18, 21, 13, 4], "tone": "success", "height": 100, "fill": true }
      },

      "div2": { "type": "Divider", "props": {} },

      "breachedChartLabel": { "type": "Eyebrow", "props": { "text": "Breached · Mon → Sun" } },
      "breachedChart": {
        "type": "Sparkline",
        "props": { "values": [2, 3, 7, 4, 5, 5, 10], "tone": "destructive", "height": 100, "fill": true }
      },

      "div3": { "type": "Divider", "props": {} },

      "kvGrid": {
        "type": "Grid",
        "props": { "cols": 2, "gap": "sm" },
        "children": ["kvPeakMet", "kvWorstBreach"]
      },
      "kvPeakMet":     { "type": "KeyValue", "props": { "label": "Peak Met",     "value": "Fri · 21" } },
      "kvWorstBreach": { "type": "KeyValue", "props": { "label": "Worst Breach", "value": "Sun · 10" } }

    }
  },
  "status": "published"
}
