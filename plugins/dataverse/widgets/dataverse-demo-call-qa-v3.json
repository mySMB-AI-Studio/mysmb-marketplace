{
  "id": "dataverse-demo-call-qa-v3",
  "title": "Call QA Scorecard (Demo)",
  "description": "Demo — recent call QA scores from Dynamics 365 with static sample data.",
  "category": "support",
  "tags": ["dataverse", "dynamics-365", "call-qa", "scoring", "agent-performance", "customer-service", "support", "demo"],
  "keywords": ["call qa", "quality assurance", "agent score", "call scoring", "pass fail", "d365", "demo"],
  "connectorsUsed": ["dataverse"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 5, "rowSpan": 8 },
    "min":       { "colSpan": 4, "rowSpan": 7 },
    "max":       { "colSpan": 10, "rowSpan": 12 }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "children": ["headerRow", "statsGrid", "div1", "callList", "div2", "footer"]
      },
      "headerRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["titleGroup", "brandBadge"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": { "type": "Icon", "props": { "name": "ClipboardCheck", "tone": "accent", "size": "sm" } },
      "titleStack": { "type": "Stack", "props": { "gap": "none" }, "children": ["title", "eyebrow"] },
      "title": { "type": "Heading", "props": { "text": "Call QA Scorecard", "level": "h2" } },
      "eyebrow": { "type": "Eyebrow", "props": { "text": "Dynamics 365 Customer Service · Demo" } },
      "brandBadge": { "type": "Badge", "props": { "label": "Dynamics 365", "tone": "info" } },

      "statsGrid": {
        "type": "Grid",
        "props": { "cols": 3, "gap": "sm" },
        "children": ["tileScored", "tilePassed", "tileRate"]
      },
      "tileScored": { "type": "Section", "props": { "variant": "muted" }, "children": ["stackScored"] },
      "stackScored": { "type": "Stack", "props": { "gap": "xxs", "align": "center" }, "children": ["iconScored", "valScored", "lblScored"] },
      "iconScored": { "type": "Icon", "props": { "name": "ClipboardList", "size": "sm", "tone": "accent" } },
      "valScored": { "type": "Heading", "props": { "text": "4", "level": "h2" } },
      "lblScored": { "type": "Caption", "props": { "text": "Scored" } },

      "tilePassed": { "type": "Section", "props": { "variant": "muted" }, "children": ["stackPassed"] },
      "stackPassed": { "type": "Stack", "props": { "gap": "xxs", "align": "center" }, "children": ["iconPassed", "valPassed", "lblPassed"] },
      "iconPassed": { "type": "Icon", "props": { "name": "CheckCircle", "size": "sm", "tone": "positive" } },
      "valPassed": { "type": "Heading", "props": { "text": "3", "level": "h2" } },
      "lblPassed": { "type": "Caption", "props": { "text": "Passed" } },

      "tileRate": { "type": "Section", "props": { "variant": "muted" }, "children": ["stackRate"] },
      "stackRate": { "type": "Stack", "props": { "gap": "xxs", "align": "center" }, "children": ["iconRate", "valRate", "lblRate"] },
      "iconRate": { "type": "Icon", "props": { "name": "TrendingUp", "size": "sm", "tone": "accent" } },
      "valRate": { "type": "Heading", "props": { "text": "75%", "level": "h2" } },
      "lblRate": { "type": "Caption", "props": { "text": "Pass Rate" } },

      "div1": { "type": "Divider" },

      "callList": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["q1", "q2", "q3"]
      },

      "q1": { "type": "Row", "props": { "justify": "between", "align": "center", "gap": "sm" }, "children": ["q1left", "q1score", "q1badge"] },
      "q1left": { "type": "Stack", "props": { "gap": "xxs" }, "children": ["q1summary", "q1meta"] },
      "q1summary": { "type": "Text", "props": { "text": "Invoice dispute — credit memo not applied", "size": "sm", "weight": "medium" } },
      "q1meta": { "type": "Caption", "props": { "text": "Agent: Maria Santos · Customer: Juan dela Cruz" } },
      "q1score": { "type": "Badge", "props": { "text": "91/100", "tone": "positive", "variant": "soft" } },
      "q1badge": { "type": "Badge", "props": { "text": "PASS", "tone": "positive", "variant": "soft" } },

      "q2": { "type": "Row", "props": { "justify": "between", "align": "center", "gap": "sm" }, "children": ["q2left", "q2score", "q2badge"] },
      "q2left": { "type": "Stack", "props": { "gap": "xxs" }, "children": ["q2summary", "q2meta"] },
      "q2summary": { "type": "Text", "props": { "text": "Account portal access after forced password reset", "size": "sm", "weight": "medium" } },
      "q2meta": { "type": "Caption", "props": { "text": "Agent: James Reyes · Customer: Sandra Lee" } },
      "q2score": { "type": "Badge", "props": { "text": "78/100", "tone": "warning", "variant": "soft" } },
      "q2badge": { "type": "Badge", "props": { "text": "Coaching", "tone": "warning", "variant": "soft" } },

      "q3": { "type": "Row", "props": { "justify": "between", "align": "center", "gap": "sm" }, "children": ["q3left", "q3score", "q3badge"] },
      "q3left": { "type": "Stack", "props": { "gap": "xxs" }, "children": ["q3summary", "q3meta"] },
      "q3summary": { "type": "Text", "props": { "text": "Delivery delay — shipment tracking and escalation", "size": "sm", "weight": "medium" } },
      "q3meta": { "type": "Caption", "props": { "text": "Agent: Maria Santos · Customer: Pedro Santos" } },
      "q3score": { "type": "Badge", "props": { "text": "85/100", "tone": "positive", "variant": "soft" } },
      "q3badge": { "type": "Badge", "props": { "text": "PASS", "tone": "positive", "variant": "soft" } },

      "div2": { "type": "Divider" },

      "footer": {
        "type": "Row",
        "props": { "justify": "end", "gap": "xs", "align": "center" },
        "children": ["footerBtn"]
      },
      "footerBtn": {
        "type": "Button",
        "props": { "label": "Open in D365", "variant": "ghost", "size": "sm", "leadingIcon": "ExternalLink" }
      }
    }
  },
  "status": "published"
}
