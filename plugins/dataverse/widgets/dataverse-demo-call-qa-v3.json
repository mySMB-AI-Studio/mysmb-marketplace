{
  "id": "dataverse-demo-call-qa-v3",
  "title": "Call QA Scorecard",
  "description": "Recent call quality assessment scores from Dynamics 365 — pass/fail breakdown per agent with score, grade, and summary. Click any row to view details.",
  "category": "support",
  "tags": ["dataverse", "dynamics-365", "call-qa", "scoring", "agent-performance", "customer-service", "support"],
  "keywords": ["call quality", "qa score", "dynamics", "agent performance", "pass", "fail", "coaching", "d365"],
  "connectorsUsed": ["dataverse"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 5, "rowSpan": 10 },
    "min":       { "colSpan": 4, "rowSpan": 8 },
    "max":       { "colSpan": 10, "rowSpan": 14 }
  },
  "spec": {
    "root": "card",
    "elements": {

      "card": {
        "type": "Card",
        "props": {},
        "children": ["headerRow", "statsGrid", "div1", "tableBody", "overlay"]
      },

      "headerRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["titleGroup"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": { "type": "Icon", "props": { "name": "ClipboardCheck", "tone": "accent", "size": "sm" } },
      "titleStack": { "type": "Stack", "props": { "gap": "none" }, "children": ["title", "eyebrow"] },
      "title": { "type": "Heading", "props": { "text": "Call QA Scorecard", "level": "h2" } },
      "eyebrow": { "type": "Eyebrow", "props": { "text": "Dynamics 365 Customer Service" } },

      "statsGrid": {
        "type": "Grid",
        "props": { "cols": 3, "gap": "sm" },
        "children": ["tileScored", "tilePassed", "tileRate"]
      },
      "tileScored": { "type": "Section", "props": { "variant": "muted" }, "children": ["stackScored"] },
      "stackScored": { "type": "Stack", "props": { "gap": "xxs", "align": "center" }, "children": ["iconScored", "valScored", "lblScored"] },
      "iconScored": { "type": "Icon", "props": { "name": "ClipboardList", "size": "sm", "tone": "accent" } },
      "valScored": { "type": "Heading", "props": { "text": "10", "level": "h2" } },
      "lblScored": { "type": "Caption", "props": { "text": "Scored" } },

      "tilePassed": { "type": "Section", "props": { "variant": "muted" }, "children": ["stackPassed"] },
      "stackPassed": { "type": "Stack", "props": { "gap": "xxs", "align": "center" }, "children": ["iconPassed", "valPassed", "lblPassed"] },
      "iconPassed": { "type": "Icon", "props": { "name": "CheckCircle", "size": "sm", "tone": "positive" } },
      "valPassed": { "type": "Heading", "props": { "text": "7", "level": "h2" } },
      "lblPassed": { "type": "Caption", "props": { "text": "Passed" } },

      "tileRate": { "type": "Section", "props": { "variant": "muted" }, "children": ["stackRate"] },
      "stackRate": { "type": "Stack", "props": { "gap": "xxs", "align": "center" }, "children": ["iconRate", "valRate", "lblRate"] },
      "iconRate": { "type": "Icon", "props": { "name": "TrendingUp", "size": "sm", "tone": "accent" } },
      "valRate": { "type": "Heading", "props": { "text": "70%", "level": "h2" } },
      "lblRate": { "type": "Caption", "props": { "text": "Pass Rate" } },

      "div1": { "type": "Divider", "props": {} },

      "tableBody": {
        "type": "Body",
        "props": {},
        "children": ["tableHeader", "r1", "r2", "r3", "r4", "r5", "r6"]
      },

      "tableHeader": {
        "type": "Grid",
        "props": { "cols": 4, "gap": "sm" },
        "children": ["thId", "thAgent", "thScore", "thResult"]
      },
      "thId":     { "type": "Caption", "props": { "text": "CALL ID",  "weight": "medium" } },
      "thAgent":  { "type": "Caption", "props": { "text": "AGENT",    "weight": "medium" } },
      "thScore":  { "type": "Caption", "props": { "text": "SCORE",    "weight": "medium" } },
      "thResult": { "type": "Caption", "props": { "text": "RESULT",   "weight": "medium" } },

      "r1": {
        "type": "Grid",
        "props": { "cols": 4, "gap": "sm" },
        "children": ["r1id", "r1agent", "r1score", "r1result"],
        "on": { "click": { "action": "setState", "params": { "statePath": "/ui/modal", "value": "open" } } }
      },
      "r1id":     { "type": "Text", "props": { "text": "CALL-00121", "size": "sm", "weight": "medium" } },
      "r1agent":  { "type": "Text", "props": { "text": "Alice M.",   "size": "sm" } },
      "r1score":  { "type": "Text", "props": { "text": "92/100",     "size": "sm" } },
      "r1result": { "type": "Badge", "props": { "text": "Pass", "tone": "success" } },

      "r2": {
        "type": "Grid",
        "props": { "cols": 4, "gap": "sm" },
        "children": ["r2id", "r2agent", "r2score", "r2result"],
        "on": { "click": { "action": "setState", "params": { "statePath": "/ui/modal", "value": "open" } } }
      },
      "r2id":     { "type": "Text", "props": { "text": "CALL-00122", "size": "sm", "weight": "medium" } },
      "r2agent":  { "type": "Text", "props": { "text": "Bob K.",     "size": "sm" } },
      "r2score":  { "type": "Text", "props": { "text": "74/100",     "size": "sm" } },
      "r2result": { "type": "Badge", "props": { "text": "Fail", "tone": "destructive" } },

      "r3": {
        "type": "Grid",
        "props": { "cols": 4, "gap": "sm" },
        "children": ["r3id", "r3agent", "r3score", "r3result"],
        "on": { "click": { "action": "setState", "params": { "statePath": "/ui/modal", "value": "open" } } }
      },
      "r3id":     { "type": "Text", "props": { "text": "CALL-00123", "size": "sm", "weight": "medium" } },
      "r3agent":  { "type": "Text", "props": { "text": "Alice M.",   "size": "sm" } },
      "r3score":  { "type": "Text", "props": { "text": "88/100",     "size": "sm" } },
      "r3result": { "type": "Badge", "props": { "text": "Pass", "tone": "success" } },

      "r4": {
        "type": "Grid",
        "props": { "cols": 4, "gap": "sm" },
        "children": ["r4id", "r4agent", "r4score", "r4result"],
        "on": { "click": { "action": "setState", "params": { "statePath": "/ui/modal", "value": "open" } } }
      },
      "r4id":     { "type": "Text", "props": { "text": "CALL-00124", "size": "sm", "weight": "medium" } },
      "r4agent":  { "type": "Text", "props": { "text": "Carol T.",   "size": "sm" } },
      "r4score":  { "type": "Text", "props": { "text": "95/100",     "size": "sm" } },
      "r4result": { "type": "Badge", "props": { "text": "Pass", "tone": "success" } },

      "r5": {
        "type": "Grid",
        "props": { "cols": 4, "gap": "sm" },
        "children": ["r5id", "r5agent", "r5score", "r5result"],
        "on": { "click": { "action": "setState", "params": { "statePath": "/ui/modal", "value": "open" } } }
      },
      "r5id":     { "type": "Text", "props": { "text": "CALL-00125", "size": "sm", "weight": "medium" } },
      "r5agent":  { "type": "Text", "props": { "text": "Bob K.",     "size": "sm" } },
      "r5score":  { "type": "Text", "props": { "text": "61/100",     "size": "sm" } },
      "r5result": { "type": "Badge", "props": { "text": "Fail", "tone": "destructive" } },

      "r6": {
        "type": "Grid",
        "props": { "cols": 4, "gap": "sm" },
        "children": ["r6id", "r6agent", "r6score", "r6result"],
        "on": { "click": { "action": "setState", "params": { "statePath": "/ui/modal", "value": "open" } } }
      },
      "r6id":     { "type": "Text", "props": { "text": "CALL-00126", "size": "sm", "weight": "medium" } },
      "r6agent":  { "type": "Text", "props": { "text": "Jeremy F.",  "size": "sm" } },
      "r6score":  { "type": "Text", "props": { "text": "79/100",     "size": "sm" } },
      "r6result": { "type": "Badge", "props": { "text": "Pass", "tone": "success" } },

      "overlay": {
        "type": "Overlay",
        "props": { "maxWidth": "36rem" },
        "children": ["overlayCard"],
        "visible": { "$state": "/ui/modal" },
        "on": {
          "backdropClick": {
            "action": "setState",
            "params": { "statePath": "/ui/modal", "value": "" }
          }
        }
      },

      "overlayCard": {
        "type": "Card",
        "props": {},
        "children": ["overlayHeader", "overlayDivider", "overlayDetails"]
      },

      "overlayHeader": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["overlayTitle", "overlayCloseBtn"]
      },
      "overlayTitle": { "type": "Heading", "props": { "text": "CALL-00121", "level": "h2" } },
      "overlayCloseBtn": {
        "type": "IconButton",
        "props": { "icon": "X", "tone": "default", "ariaLabel": "Close", "size": "md", "variant": "outlined" },
        "on": {
          "click": {
            "action": "setState",
            "params": { "statePath": "/ui/modal", "value": "" }
          }
        }
      },

      "overlayDivider": { "type": "Divider", "props": {} },

      "overlayDetails": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["detailGrid", "summarySection", "viewD365Btn"]
      },

      "detailGrid": {
        "type": "Grid",
        "props": { "cols": 2, "gap": "sm" },
        "children": ["kvDateTime", "kvCaller", "kvAgent", "kvScore"]
      },
      "kvDateTime": { "type": "KeyValue", "props": { "label": "Date & Time",  "value": "29 May 2026 · 12:40 PM" } },
      "kvCaller":   { "type": "KeyValue", "props": { "label": "Caller",       "value": "+61 412 345 678 (James Nguyen)" } },
      "kvAgent":    { "type": "KeyValue", "props": { "label": "Agent",        "value": "Alice M." } },
      "kvScore":    { "type": "KeyValue", "props": { "label": "Score",        "value": "92/100 — Pass" } },

      "summarySection": {
        "type": "Section",
        "props": { "variant": "muted" },
        "children": ["summaryStack"]
      },
      "summaryStack": {
        "type": "Stack",
        "props": { "gap": "xxs" },
        "children": ["summaryLbl", "summaryText"]
      },
      "summaryLbl":  { "type": "Caption", "props": { "text": "Summary" } },
      "summaryText": {
        "type": "Text",
        "props": {
          "text": "Customer called to report a duplicate $49 subscription charge. Agent verified identity, confirmed the billing error, processed a refund, and provided a case reference number.",
          "size": "sm"
        }
      },

      "viewD365Btn": {
        "type": "Button",
        "props": { "label": "View in D365", "variant": "ghost", "size": "sm", "leadingIcon": "ExternalLink" },
        "on": {
          "click": {
            "action": "open_url",
            "params": { "url": "https://mysmb-dev.crm6.dynamics.com", "target": "_blank" }
          }
        }
      }

    }
  },
  "status": "published"
}
