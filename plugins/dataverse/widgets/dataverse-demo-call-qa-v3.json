      "thAgent":  { "type": "Caption", "props": { "text": "AGENT",    "weight": "medium" } },
      "thScore":  { "type": "Caption", "props": { "text": "SCORE",    "weight": "medium" } },
      "thResult": { "type": "Caption", "props": { "text": "RESULT",   "weight": "medium" } },

