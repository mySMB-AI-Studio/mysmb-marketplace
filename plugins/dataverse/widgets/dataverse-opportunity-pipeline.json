{
  "id": "dataverse-opportunity-pipeline-v5",
  "title": "Opportunity Pipeline",
  "description": "Every open opportunity in one list — group by owner, stage, or deal age, search across deals, and spot stalled (untouched 30d+) deals at a glance.",
  "category": "sales",
  "tags": ["dataverse", "dynamics-365", "sales", "pipeline", "opportunities", "owner", "crm", "stalled"],
  "keywords": ["pipeline", "opportunities", "opportunity", "owner", "salesperson", "rep", "stalled", "stale", "age", "stages", "sales", "crm"],
  "connectorsUsed": ["dataverse"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 5, "rowSpan": 10 },
    "min":       { "colSpan": 4, "rowSpan": 8 },
    "max":       { "colSpan": 12, "rowSpan": 14 }
  },
  "dataProvider": {
    "mcp": "dataverse",
    "tool": "list_opportunity_pipeline",
    "params": {
      "org_url": "mySMB.com Prod",
      "top": 200
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": ["headerRow", "controlsRow", "div1", "listBody", "oppModal"],
        "watch": {
          "/dataverse/list_opportunity_pipeline/items": {
            "action": "setState",
            "params": {
              "statePath": "/ui/groups",
              "value": {
                "$computed": "dataverse_group_opportunities",
                "args": {
                  "value": { "$state": "/dataverse/list_opportunity_pipeline/items" },
                  "mode": { "$state": "/ui/groupBy" },
                  "search": { "$state": "/ui/search" }
                }
              }
            }
          },
          "/ui/groupBy": {
            "action": "setState",
            "params": {
              "statePath": "/ui/groups",
              "value": {
                "$computed": "dataverse_group_opportunities",
                "args": {
                  "value": { "$state": "/dataverse/list_opportunity_pipeline/items" },
                  "mode": { "$state": "/ui/groupBy" },
                  "search": { "$state": "/ui/search" }
                }
              }
            }
          },
          "/ui/search": {
            "action": "setState",
            "params": {
              "statePath": "/ui/groups",
              "value": {
                "$computed": "dataverse_group_opportunities",
                "args": {
                  "value": { "$state": "/dataverse/list_opportunity_pipeline/items" },
                  "mode": { "$state": "/ui/groupBy" },
                  "search": { "$state": "/ui/search" }
                }
              }
            }
          }
        }
      },

      "headerRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["titleGroup", "statsRow"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": { "type": "Icon", "props": { "name": "TrendingUp", "tone": "accent", "size": "sm" } },
      "titleStack": { "type": "Stack", "props": { "gap": "none" }, "children": ["title", "eyebrow"] },
      "title": { "type": "Heading", "props": { "text": "Opportunity Pipeline", "level": "h2" } },
      "eyebrow": { "type": "Eyebrow", "props": { "text": "Dynamics 365 Sales" } },

      "statsRow": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["statOpen", "statStalled", "statWin"]
      },
      "statOpen": { "type": "Section", "props": { "variant": "muted" }, "children": ["rowOpen"] },
      "rowOpen": { "type": "Row", "props": { "gap": "xs", "align": "center" }, "children": ["lblOpen", "valOpen"] },
      "lblOpen": { "type": "Caption", "props": { "text": "Open" } },
      "valOpen": {
        "type": "Text",
        "props": {
          "text": { "$computed": "count", "args": { "value": { "$state": "/dataverse/list_opportunity_pipeline/items" } } },
          "size": "sm", "weight": "semibold"
        }
      },
      "statStalled": { "type": "Section", "props": { "variant": "muted" }, "children": ["rowStalled"] },
      "rowStalled": { "type": "Row", "props": { "gap": "xs", "align": "center" }, "children": ["lblStalled", "valStalled"] },
      "lblStalled": { "type": "Caption", "props": { "text": "Stalled" } },
      "valStalled": {
        "type": "Text",
        "props": {
          "text": { "$computed": "dataverse_count_stalled", "args": { "value": { "$state": "/dataverse/list_opportunity_pipeline/items" } } },
          "size": "sm", "weight": "semibold", "tone": "destructive"
        }
      },
      "statWin": { "type": "Section", "props": { "variant": "muted" }, "children": ["rowWin"] },
      "rowWin": { "type": "Row", "props": { "gap": "xs", "align": "center" }, "children": ["lblWin", "valWin"] },
      "lblWin": { "type": "Caption", "props": { "text": "Win rate" } },
      "valWin": {
        "type": "Text",
        "props": { "text": { "$state": "/dataverse/list_opportunity_pipeline/win_rate" }, "size": "sm", "weight": "semibold" }
      },

      "controlsRow": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center", "justify": "between" },
        "children": ["segControl", "searchInput"]
      },
      "segControl": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["segLabel", "segOwner", "segStage", "segAge"]
      },
      "segLabel": { "type": "Caption", "props": { "text": "Group by" } },
      "segOwner": {
        "type": "Row",
        "props": {
          "gap": "xs", "align": "center", "hover": true, "clickable": true,
          "selected": { "$computed": "dataverse_is_mode", "args": { "value": { "$state": "/ui/groupBy" }, "mode": "owner" } }
        },
        "children": ["segOwnerLbl"],
        "on": { "click": { "action": "setState", "params": { "statePath": "/ui/groupBy", "value": "owner" } } }
      },
      "segOwnerLbl": { "type": "Text", "props": { "text": "Owner", "size": "sm", "weight": "medium" } },
      "segStage": {
        "type": "Row",
        "props": {
          "gap": "xs", "align": "center", "hover": true, "clickable": true,
          "selected": { "$computed": "dataverse_is_mode", "args": { "value": { "$state": "/ui/groupBy" }, "mode": "stage" } }
        },
        "children": ["segStageLbl"],
        "on": { "click": { "action": "setState", "params": { "statePath": "/ui/groupBy", "value": "stage" } } }
      },
      "segStageLbl": { "type": "Text", "props": { "text": "Stage", "size": "sm", "weight": "medium" } },
      "segAge": {
        "type": "Row",
        "props": {
          "gap": "xs", "align": "center", "hover": true, "clickable": true,
          "selected": { "$computed": "dataverse_is_mode", "args": { "value": { "$state": "/ui/groupBy" }, "mode": "age" } }
        },
        "children": ["segAgeLbl"],
        "on": { "click": { "action": "setState", "params": { "statePath": "/ui/groupBy", "value": "age" } } }
      },
      "segAgeLbl": { "type": "Text", "props": { "text": "Age", "size": "sm", "weight": "medium" } },
      "searchInput": {
        "type": "TextInput",
        "props": {
          "value": { "$bindState": "/ui/search" },
          "placeholder": "Search opportunities or accounts",
          "size": "sm",
          "debounce": 150
        }
      },

      "div1": { "type": "Divider", "props": {} },

      "listBody": {
        "type": "Body",
        "props": {},
        "children": ["loading", "empty", "groupsList"]
      },

      "loading": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["sk1", "sk2", "sk3", "sk4"],
        "visible": { "$state": "/_loading/dataverse.list_opportunity_pipeline" }
      },
      "sk1": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "sk2": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "sk3": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "sk4": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },

      "empty": {
        "type": "Empty",
        "props": { "message": "No open opportunities — time to prospect." },
        "visible": {
          "$and": [
            { "$state": "/_loading/dataverse.list_opportunity_pipeline", "not": true },
            { "$state": "/dataverse/list_opportunity_pipeline/items/0", "not": true }
          ]
        }
      },

      "groupsList": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["groupItem"],
        "repeat": { "statePath": "/ui/groups", "key": "rowkey" },
        "visible": {
          "$and": [
            { "$state": "/_loading/dataverse.list_opportunity_pipeline", "not": true },
            { "$state": "/dataverse/list_opportunity_pipeline/items/0" }
          ]
        }
      },
      "groupItem": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["groupHeader", "dealRow"]
      },

      "groupHeader": {
        "type": "Section",
        "props": { "variant": "muted" },
        "children": ["groupHeaderRow"],
        "visible": { "$item": "isHeader" }
      },
      "groupHeaderRow": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center", "justify": "between" },
        "children": ["groupHeaderLeft", "groupHeaderRight"]
      },
      "groupHeaderLeft": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center", "grow": true },
        "children": ["groupAvatar", "groupLabel"]
      },
      "groupAvatar": {
        "type": "Badge",
        "props": { "text": { "$item": "initials" }, "tone": "accent", "variant": "soft" },
        "visible": { "$item": "initials" }
      },
      "groupLabel": { "type": "Text", "props": { "text": { "$item": "label" }, "size": "sm", "weight": "semibold", "truncate": true } },
      "groupHeaderRight": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["groupStalled", "groupCount", "groupTotal"]
      },
      "groupStalled": {
        "type": "Badge",
        "props": {
          "text": { "$computed": "fmt", "args": { "pattern": "{n} stalled", "n": { "$item": "stalled" } } },
          "tone": "destructive", "variant": "soft"
        },
        "visible": { "$item": "stalled" }
      },
      "groupCount": {
        "type": "Caption",
        "props": { "text": { "$computed": "fmt", "args": { "pattern": "{n} open", "n": { "$item": "count" } } } }
      },
      "groupTotal": {
        "type": "Text",
        "props": {
          "text": { "$computed": "format_currency", "args": { "value": { "$item": "total" } } },
          "size": "sm", "weight": "semibold"
        }
      },

      "dealRow": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center", "hover": true, "clickable": true },
        "children": ["dealLeft", "dealStage", "dealAge", "dealAmount"],
        "visible": { "$item": "isDeal" },
        "on": {
          "click": [
            { "action": "setState", "params": { "statePath": "/ui/sel/id", "value": { "$computed": "identity", "args": { "value": { "$item": "opportunityid" } } } } },
            { "action": "setState", "params": { "statePath": "/ui/sel/name", "value": { "$computed": "identity", "args": { "value": { "$item": "name" } } } } },
            { "action": "setState", "params": { "statePath": "/ui/sel/account", "value": { "$computed": "identity", "args": { "value": { "$item": "account" } } } } },
            { "action": "setState", "params": { "statePath": "/ui/sel/owner", "value": { "$computed": "identity", "args": { "value": { "$item": "owner" } } } } },
            { "action": "setState", "params": { "statePath": "/ui/sel/stageLabel", "value": { "$computed": "identity", "args": { "value": { "$item": "stageLabel" } } } } },
            { "action": "setState", "params": { "statePath": "/ui/sel/stageTone", "value": { "$computed": "identity", "args": { "value": { "$item": "stageTone" } } } } },
            { "action": "setState", "params": { "statePath": "/ui/sel/ageLabel", "value": { "$computed": "identity", "args": { "value": { "$item": "ageLabel" } } } } },
            { "action": "setState", "params": { "statePath": "/ui/sel/ageTone", "value": { "$computed": "identity", "args": { "value": { "$item": "ageTone" } } } } },
            { "action": "setState", "params": { "statePath": "/ui/sel/amount", "value": { "$computed": "identity", "args": { "value": { "$item": "amount" } } } } },
            { "action": "setState", "params": { "statePath": "/ui/sel/probability", "value": { "$computed": "identity", "args": { "value": { "$item": "probability" } } } } },
            { "action": "setState", "params": { "statePath": "/ui/sel/weighted", "value": { "$computed": "identity", "args": { "value": { "$item": "weighted" } } } } },
            { "action": "setState", "params": { "statePath": "/ui/sel/closeLabel", "value": { "$computed": "identity", "args": { "value": { "$item": "closeLabel" } } } } },
            { "action": "setState", "params": { "statePath": "/ui/sel/closeTone", "value": { "$computed": "identity", "args": { "value": { "$item": "closeTone" } } } } },
            { "action": "setState", "params": { "statePath": "/ui/sel/recordUrl", "value": { "$computed": "identity", "args": { "value": { "$item": "recordUrl" } } } } }
          ]
        }
      },
      "dealLeft": {
        "type": "Stack",
        "props": { "gap": "none", "grow": true },
        "children": ["dealName", "dealAccount"]
      },
      "dealName": { "type": "Text", "props": { "text": { "$item": "name" }, "size": "sm", "weight": "medium", "truncate": true } },
      "dealAccount": { "type": "Caption", "props": { "text": { "$item": "account" }, "truncate": true } },
      "dealStage": {
        "type": "Badge",
        "props": { "text": { "$item": "stageLabel" }, "tone": { "$item": "stageTone" }, "variant": "soft" }
      },
      "dealAge": {
        "type": "Badge",
        "props": { "text": { "$item": "ageLabel" }, "tone": { "$item": "ageTone" }, "variant": "soft" }
      },
      "dealAmount": {
        "type": "Text",
        "props": {
          "text": { "$computed": "format_currency", "args": { "value": { "$item": "amount" } } },
          "size": "sm", "weight": "semibold"
        }
      },

      "oppModal": {
        "type": "Overlay",
        "props": { "maxWidth": "30rem" },
        "visible": { "$state": "/ui/sel/id", "neq": "" },
        "on": { "backdropClick": { "action": "setState", "params": { "statePath": "/ui/sel/id", "value": "" } } },
        "children": ["modalContent"]
      },
      "modalContent": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["modalHeader", "modalDivider", "modalBody", "modalFooter"]
      },
      "modalHeader": {
        "type": "Row",
        "props": { "gap": "sm", "align": "start", "justify": "between" },
        "children": ["modalTitleStack", "modalClose"]
      },
      "modalTitleStack": {
        "type": "Stack",
        "props": { "gap": "none", "grow": true },
        "children": ["modalTitle", "modalAccount"]
      },
      "modalTitle": { "type": "Heading", "props": { "text": { "$state": "/ui/sel/name" }, "level": "h3", "wrap": true } },
      "modalAccount": { "type": "Caption", "props": { "text": { "$state": "/ui/sel/account" } } },
      "modalClose": {
        "type": "OverlayClose",
        "props": { "ariaLabel": "Close opportunity details" },
        "on": { "click": { "action": "setState", "params": { "statePath": "/ui/sel/id", "value": "" } } }
      },
      "modalDivider": { "type": "Divider", "props": {} },
      "modalBody": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["mrStage", "mrOwner", "mrValue", "mrProb", "mrWeighted", "mrClose", "mrActivity"]
      },
      "mrStage": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center", "justify": "between" },
        "children": ["mrStageLbl", "mrStageVal"]
      },
      "mrStageLbl": { "type": "Caption", "props": { "text": "Stage" } },
      "mrStageVal": {
        "type": "Badge",
        "props": { "text": { "$state": "/ui/sel/stageLabel" }, "tone": { "$state": "/ui/sel/stageTone" }, "variant": "soft" }
      },
      "mrOwner": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center", "justify": "between" },
        "children": ["mrOwnerLbl", "mrOwnerVal"]
      },
      "mrOwnerLbl": { "type": "Caption", "props": { "text": "Owner" } },
      "mrOwnerVal": { "type": "Text", "props": { "text": { "$state": "/ui/sel/owner" }, "size": "sm", "weight": "medium" } },
      "mrValue": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center", "justify": "between" },
        "children": ["mrValueLbl", "mrValueVal"]
      },
      "mrValueLbl": { "type": "Caption", "props": { "text": "Value" } },
      "mrValueVal": {
        "type": "Text",
        "props": { "text": { "$computed": "format_currency", "args": { "value": { "$state": "/ui/sel/amount" } } }, "size": "sm", "weight": "semibold" }
      },
      "mrProb": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center", "justify": "between" },
        "children": ["mrProbLbl", "mrProbVal"]
      },
      "mrProbLbl": { "type": "Caption", "props": { "text": "Probability" } },
      "mrProbVal": {
        "type": "Text",
        "props": { "text": { "$computed": "fmt", "args": { "pattern": "{p}%", "p": { "$state": "/ui/sel/probability" } } }, "size": "sm", "weight": "medium" }
      },
      "mrWeighted": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center", "justify": "between" },
        "children": ["mrWeightedLbl", "mrWeightedVal"]
      },
      "mrWeightedLbl": { "type": "Caption", "props": { "text": "Weighted" } },
      "mrWeightedVal": {
        "type": "Text",
        "props": { "text": { "$computed": "format_currency", "args": { "value": { "$state": "/ui/sel/weighted" } } }, "size": "sm", "weight": "medium" }
      },
      "mrClose": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center", "justify": "between" },
        "children": ["mrCloseLbl", "mrCloseVal"]
      },
      "mrCloseLbl": { "type": "Caption", "props": { "text": "Close" } },
      "mrCloseVal": { "type": "Text", "props": { "text": { "$state": "/ui/sel/closeLabel" }, "tone": { "$state": "/ui/sel/closeTone" }, "size": "sm", "weight": "medium" } },
      "mrActivity": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center", "justify": "between" },
        "children": ["mrActivityLbl", "mrActivityVal"]
      },
      "mrActivityLbl": { "type": "Caption", "props": { "text": "Last activity" } },
      "mrActivityVal": {
        "type": "Badge",
        "props": { "text": { "$state": "/ui/sel/ageLabel" }, "tone": { "$state": "/ui/sel/ageTone" }, "variant": "soft" }
      },
      "modalFooter": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center", "justify": "end" },
        "children": ["modalOpenBtn"]
      },
      "modalOpenBtn": {
        "type": "Button",
        "props": { "label": "Open in Dynamics 365", "variant": "primary", "size": "sm", "leadingIcon": "ExternalLink" },
        "visible": { "$state": "/ui/sel/recordUrl", "neq": "" },
        "on": { "click": { "action": "open_url", "params": { "url": { "$state": "/ui/sel/recordUrl" }, "target": "_blank" } } }
      }
    }
  }
}
