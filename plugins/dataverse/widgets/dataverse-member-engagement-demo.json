{
  "id": "dataverse-member-engagement-demo",
  "title": "Member Engagement",
  "description": "Engagement breakdown of Contact records using a `new_engagementlevel` field on Contact. Demo version with static data.",
  "category": "crm",
  "tags": ["dataverse", "dynamics-365", "membership", "engagement", "association", "crm", "demo"],
  "keywords": ["engagement", "member engagement", "engaged", "less engaged", "active members", "participation", "d365"],
  "connectorsUsed": ["dataverse"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 3, "rowSpan": 4 },
    "min": { "colSpan": 2, "rowSpan": 3 },
    "max": { "colSpan": 6, "rowSpan": 8 }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": { "type": "Card", "children": ["header", "body"] },
      "header": { "type": "Header", "children": ["titleGroup"] },
      "titleGroup": { "type": "Row", "props": { "gap": "sm", "align": "start" }, "children": ["titleIcon", "titleStack"] },
      "titleIcon": { "type": "Icon", "props": { "name": "Users", "tone": "accent", "size": "sm" } },
      "titleStack": { "type": "Stack", "props": { "gap": "none" }, "children": ["title", "subtitle"] },
      "title": { "type": "Heading", "props": { "text": "Member Engagement", "level": "h2" } },
      "subtitle": { "type": "Eyebrow", "props": { "text": "10 active members" } },
      "body": { "type": "Body", "children": ["contentStack"] },
      "contentStack": {
        "type": "Stack",
        "props": { "gap": "md" },
        "children": ["pctStack", "engagementDivider", "engagementList"]
      },
      "pctStack": { "type": "Stack", "props": { "gap": "none" }, "children": ["pctValue", "pctCaption"] },
      "pctValue": {
        "type": "Stat",
        "props": {
          "value": {
            "$computed": "fmt",
            "args": {
              "pattern": "{n}%",
              "n": { "$computed": "pct", "args": { "part": 5, "whole": 10 } }
            }
          },
          "size": "lg"
        }
      },
      "pctCaption": { "type": "Caption", "props": { "text": "of members are highly engaged" } },
      "engagementDivider": { "type": "Divider" },
      "engagementList": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["engagedRow", "lessEngagedRow", "noEngageRow"]
      },
      "engagedRow": { "type": "Row", "props": { "gap": "sm", "align": "center", "justify": "between" }, "children": ["engagedLeft", "engagedCount"] },
      "engagedLeft": { "type": "Row", "props": { "gap": "xs", "align": "center" }, "children": ["engagedDot", "engagedLabel"] },
      "engagedDot": { "type": "Dot", "props": { "tone": "success", "size": "sm" } },
      "engagedLabel": { "type": "Text", "props": { "text": "Engaged", "size": "sm" } },
      "engagedCount": { "type": "Text", "props": { "text": 5, "size": "sm", "weight": "semibold" } },

      "lessEngagedRow": { "type": "Row", "props": { "gap": "sm", "align": "center", "justify": "between" }, "children": ["lessEngagedLeft", "lessEngagedCount"] },
      "lessEngagedLeft": { "type": "Row", "props": { "gap": "xs", "align": "center" }, "children": ["lessEngagedDot", "lessEngagedLabel"] },
      "lessEngagedDot": { "type": "Dot", "props": { "tone": "warning", "size": "sm" } },
      "lessEngagedLabel": { "type": "Text", "props": { "text": "Less Engaged", "size": "sm" } },
      "lessEngagedCount": { "type": "Text", "props": { "text": 3, "size": "sm", "weight": "semibold" } },

      "noEngageRow": { "type": "Row", "props": { "gap": "sm", "align": "center", "justify": "between" }, "children": ["noEngageLeft", "noEngageCount"] },
      "noEngageLeft": { "type": "Row", "props": { "gap": "xs", "align": "center" }, "children": ["noEngageDot", "noEngageLabel"] },
      "noEngageDot": { "type": "Dot", "props": { "tone": "muted", "size": "sm" } },
      "noEngageLabel": { "type": "Text", "props": { "text": "Does Not Engage", "size": "sm" } },
      "noEngageCount": { "type": "Text", "props": { "text": 2, "size": "sm", "weight": "semibold" } }
    }
  },
  "status": "published"
}
