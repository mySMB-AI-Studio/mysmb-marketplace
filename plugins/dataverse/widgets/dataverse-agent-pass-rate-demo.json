{
  "id": "dataverse-agent-pass-rate-demo",
  "title": "Agent Pass Rate",
  "description": "QA pass rate breakdown by agent from Dynamics 365 Customer Service. Demo version with static data.",
  "category": "support",
  "tags": ["dataverse", "dynamics-365", "call-qa", "agent-performance", "customer-service", "support", "demo"],
  "keywords": ["agent", "pass rate", "qa", "call quality", "d365", "performance", "scoring"],
  "connectorsUsed": ["dataverse"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 4, "rowSpan": 10 },
    "min":       { "colSpan": 3, "rowSpan": 8 },
    "max":       { "colSpan": 8, "rowSpan": 14 }
  },
  "spec": {
    "root": "card",
    "elements": {

      "card": {
        "type": "Card",
        "props": {},
        "children": ["headerRow", "div0", "statsGrid", "div1", "donutSection", "div2", "agentList"]
      },

      "headerRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["titleGroup"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": { "type": "Icon", "props": { "name": "Users", "tone": "accent", "size": "sm" } },
      "titleStack": { "type": "Stack", "props": { "gap": "none" }, "children": ["title", "eyebrow"] },
      "title": { "type": "Heading", "props": { "text": "Agent Pass Rate", "level": "h2" } },
      "eyebrow": { "type": "Eyebrow", "props": { "text": "Dynamics 365 Customer Service" } },

      "div0": { "type": "Divider", "props": {} },

      "statsGrid": {
        "type": "Grid",
        "props": { "cols": 3, "gap": "sm" },
        "children": ["tileAgents", "tileTop", "tileAvg"]
      },

      "tileAgents": { "type": "Section", "props": { "variant": "muted" }, "children": ["stackAgents"] },
      "stackAgents": { "type": "Stack", "props": { "gap": "xxs", "align": "center" }, "children": ["iconAgents", "valAgents", "lblAgents"] },
      "iconAgents": { "type": "Icon", "props": { "name": "Users", "size": "sm", "tone": "accent" } },
      "valAgents": { "type": "Heading", "props": { "text": "5", "level": "h2" } },
      "lblAgents": { "type": "Caption", "props": { "text": "Agents" } },

      "tileTop": { "type": "Section", "props": { "variant": "muted" }, "children": ["stackTop"] },
      "stackTop": { "type": "Stack", "props": { "gap": "xxs", "align": "center" }, "children": ["iconTop", "valTop", "lblTop"] },
      "iconTop": { "type": "Icon", "props": { "name": "Trophy", "size": "sm", "tone": "warning" } },
      "valTop": { "type": "Heading", "props": { "text": "Carol T.", "level": "h2" } },
      "lblTop": { "type": "Caption", "props": { "text": "Top Agent" } },

      "tileAvg": { "type": "Section", "props": { "variant": "muted" }, "children": ["stackAvg"] },
      "stackAvg": { "type": "Stack", "props": { "gap": "xxs", "align": "center" }, "children": ["iconAvg", "valAvg", "lblAvg"] },
      "iconAvg": { "type": "Icon", "props": { "name": "ChartBar", "size": "sm", "tone": "accent" } },
      "valAvg": { "type": "Heading", "props": { "text": "79%", "level": "h2" } },
      "lblAvg": { "type": "Caption", "props": { "text": "Avg Pass Rate" } },

      "div1": { "type": "Divider", "props": {} },

      "donutSection": {
        "type": "Stack",
        "props": { "gap": "sm", "align": "center" },
        "children": ["donutChart"]
      },

      "donutChart": {
        "type": "Donut",
        "props": {
          "data": [
            { "status": "passed", "count": 79 },
            { "status": "failed", "count": 21 }
          ],
          "groupField": "status",
          "legend": {
            "passed": { "label": "Passed", "tone": "positive" },
            "failed": { "label": "Not Passed", "tone": "danger" }
          },
          "centerLabel": "79%",
          "size": 160
        }
      },

      "div2": { "type": "Divider", "props": {} },

      "agentList": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["agentHeader", "agentDivider", "agent1", "agent2", "agent3", "agent4", "agent5"]
      },

      "agentHeader": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["agentHdrName", "agentHdrScore"]
      },
      "agentHdrName":  { "type": "Caption", "props": { "text": "AGENT",      "weight": "medium" } },
      "agentHdrScore": { "type": "Caption", "props": { "text": "PASS RATE",  "weight": "medium" } },

      "agentDivider": { "type": "Divider", "props": {} },

      "agent1": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["a1name", "a1score"]
      },
      "a1name":  { "type": "Text", "props": { "text": "Carol T.",  "size": "sm", "weight": "medium" } },
      "a1score": { "type": "Badge", "props": { "text": "95%", "tone": "success" } },

      "agent2": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["a2name", "a2score"]
      },
      "a2name":  { "type": "Text", "props": { "text": "Alice M.",  "size": "sm" } },
      "a2score": { "type": "Badge", "props": { "text": "90%", "tone": "success" } },

      "agent3": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["a3name", "a3score"]
      },
      "a3name":  { "type": "Text", "props": { "text": "Jeremy F.", "size": "sm" } },
      "a3score": { "type": "Badge", "props": { "text": "79%", "tone": "success" } },

      "agent4": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["a4name", "a4score"]
      },
      "a4name":  { "type": "Text", "props": { "text": "Rico P.",   "size": "sm" } },
      "a4score": { "type": "Badge", "props": { "text": "66%", "tone": "warning" } },

      "agent5": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["a5name", "a5score"]
      },
      "a5name":  { "type": "Text", "props": { "text": "Bob K.",    "size": "sm" } },
      "a5score": { "type": "Badge", "props": { "text": "58%", "tone": "destructive" } }

    }
  },
  "status": "published"
}
