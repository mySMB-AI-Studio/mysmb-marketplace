      "event1LocationIcon": { "type": "Icon", "props": { "name": "MapPin", "size": "xs", "tone": "muted" } },
      "event1Location": { "type": "Caption", "props": { "text": "Virtual", "tone": "muted" } },
      "event1Divider": { "type": "Divider", "props": {} },
      "event1AttendeeStack": { "type": "Row", "props": { "gap": "sm", "align": "center" }, "children": ["event1AttendeeIcon", "event1AttendeeTextStack"] },
      "event1AttendeeIcon": { "type": "Icon", "props": { "name": "Users", "size": "sm", "tone": "destructive" } },
      "event1AttendeeTextStack": { "type": "Stack", "props": { "gap": "none" }, "children": ["event1AttendeeCount", "event1AttendeeLabel"] },
      "event1AttendeeCount": { "type": "Stat", "props": { "value": 2, "size": "md", "tone": "destructive" } },
