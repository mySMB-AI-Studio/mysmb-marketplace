      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": { "type": "Icon", "props": { "name": "AlertTriangle", "tone": "warning", "variant": "soft", "size": "sm" } },
      "titleStack": { "type": "Stack", "props": { "gap": "none" }, "children": ["title", "subtitle"] },
      "title": { "type": "Heading", "props": { "text": "Top 3 Events at Risk", "level": "h2" } },
      "subtitle": { "type": "Eyebrow", "props": { "text": "Lowest Registered Attendance" } },
      "headerDivider": { "type": "Divider", "props": {} },

      "body": { "type": "Body", "props": { "padding": "md" }, "children": ["boxRow"] },
      "boxRow": {
        "type": "Row",
        "props": { "template": "1fr 1fr 1fr", "gap": "md", "align": "stretch" },
        "children": ["box1", "box2", "box3"]
      },

      "box1": {
        "type": "Stack",
        "props": { "gap": "sm", "padding": "md", "rounded": "lg", "tone": "destructive", "variant": "soft" },
        "children": ["rank1Badge", "event1Name", "event1MetaRow", "event1DateRow", "event1LocationRow", "event1Divider", "event1AttendeeStack"]
      },
      "rank1Badge": { "type": "Badge", "props": { "text": "#1 At Risk", "tone": "destructive", "variant": "solid" } },
      "event1Name": { "type": "Text", "props": { "text": "Product Roadmap Webinar - Q4 2026", "size": "sm", "weight": "semibold", "truncate": true } },
      "event1MetaRow": { "type": "Row", "props": { "gap": "xs", "align": "center" }, "children": ["event1TypeBadge", "event1StatusCaption"] },
      "event1TypeBadge": { "type": "Badge", "props": { "text": "Webinar", "variant": "outline", "size": "sm" } },
      "event1StatusCaption": { "type": "Caption", "props": { "text": "Planned", "tone": "muted" } },
      "event1DateRow": { "type": "Row", "props": { "gap": "xs", "align": "center" }, "children": ["event1DateIcon", "event1Date"] },
      "event1DateIcon": { "type": "Icon", "props": { "name": "Calendar", "size": "xs", "tone": "muted" } },
      "event1Date": { "type": "Caption", "props": { "text": "05-Sep-26", "tone": "muted" } },
