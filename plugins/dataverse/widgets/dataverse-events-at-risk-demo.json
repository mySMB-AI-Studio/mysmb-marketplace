{
  "id": "dataverse-events-at-risk-demo",
  "title": "Top 3 Events at Risk",
  "description": "The 3 upcoming Dynamics 365 events with the lowest registered attendance — surfaces which events need the most attention before they happen. Demo version with static data, matching the shared CRM Associations requirement (event name, attendance, location) also built for Salesforce and iMIS. Swap in a live dataProvider (Dynamics 365 Marketing's msevtmgt_event/msevtmgt_eventregistration, or the core Campaign entity) once the target org's actual event schema is confirmed.",
  "category": "crm",
  "tags": ["dataverse", "dynamics-365", "crm", "events", "attendance", "at-risk", "marketing", "demo"],
  "keywords": ["events", "at risk", "attendance", "registrations", "low attendance", "engagement", "event management", "d365"],
  "connectorsUsed": ["dataverse"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 7, "rowSpan": 5 },
    "min": { "colSpan": 5, "rowSpan": 4 },
    "max": { "colSpan": 10, "rowSpan": 9 }
  },
  "spec": {
    "root": "card",
