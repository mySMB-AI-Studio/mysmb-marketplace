{
  "id": "dataverse-closing-opportunities-v1",
  "status": "published",
  "title": "Closing This Month",
  "description": "Open Dynamics 365 opportunities with an estimated close date this calendar month — sorted by close date.",
  "category": "sales",
  "tags": ["dataverse", "dynamics-365", "sales", "opportunities", "closing", "forecast", "pipeline"],
  "keywords": ["closing", "close date", "this month", "opportunities", "pipeline", "forecast", "deals"],
  "connectorsUsed": ["dataverse"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 8, "rowSpan": 5 },
    "min":       { "colSpan": 6, "rowSpan": 4 },
    "max":       { "colSpan": 12, "rowSpan": 10 }
  },
  "dataProvider": {
    "mcp": "dataverse",
    "tool": "list_closing_opportunities",
    "params": { "org_url": "https://mysmb-dev.crm6.dynamics.com", "top": 25 }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": ["titleRow", "statGrid", "divider", "tableBody", "footerDivider", "footer"]
      },

      "titleRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["titleGroup"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": { "type": "Icon", "props": { "name": "CalendarClock", "tone": "accent", "size": "sm" } },
      "titleStack": { "type": "Stack", "props": { "gap": "none" }, "children": ["title", "eyebrow"] },
      "title": { "type": "Heading", "props": { "text": "Closing This Month", "level": "h2" } },
      "eyebrow": { "type": "Eyebrow", "props": { "text": "Dynamics 365 Sales" } },

      "statGrid": {
        "type": "Grid",
        "props": { "cols": 2 },
        "children": ["tileCount", "tileValue"]
      },
      "tileCount": { "type": "Section", "props": { "variant": "muted" }, "children": ["stackCount"] },
      "stackCount": {
        "type": "Stack",
        "props": { "gap": "xxs", "align": "center" },
        "children": ["iconCount", "valCount", "lblCount"]
      },
      "iconCount": { "type": "Icon", "props": { "name": "CalendarClock", "size": "sm", "tone": "accent" } },
      "valCount": {
        "type": "Stat",
        "props": { "value": { "$state": "/dataverse/list_closing_opportunities/count" } }
      },
      "lblCount": { "type": "Caption", "props": { "text": "Closing" } },

      "tileValue": { "type": "Section", "props": { "variant": "muted" }, "children": ["stackValue"] },
      "stackValue": {
        "type": "Stack",
        "props": { "gap": "xxs", "align": "center" },
        "children": ["iconValue", "valValue", "lblValue"]
      },
      "iconValue": { "type": "Icon", "props": { "name": "Banknote", "size": "sm", "tone": "positive" } },
      "valValue": {
        "type": "Stat",
        "props": {
          "value": {
            "$computed": "format_currency",
            "args": { "value": { "$state": "/dataverse/list_closing_opportunities/total_value" } }
          }
        }
      },
      "lblValue": { "type": "Caption", "props": { "text": "Pipeline Value" } },

      "divider": { "type": "Divider", "props": {} },

      "tableBody": { "type": "Body", "props": {}, "children": ["table"] },
      "table": {
        "type": "Table",
        "props": {
          "loading": { "$state": "/_loading/dataverse.list_closing_opportunities" },
          "skeletonRows": 5,
          "rows": { "$state": "/dataverse/list_closing_opportunities/items" },
          "columns": [
            { "id": "name",    "header": "Opportunity", "field": "name",                "priority": 1 },
            { "id": "account", "header": "Account",     "field": "account_name",        "width": 140, "priority": 2 },
            { "id": "close",   "header": "Closes",      "field": "estimatedclosedate",  "width": 110, "priority": 1, "format": "relative" },
            { "id": "prob",    "header": "Prob %",      "field": "closeprobability",    "width": 80,  "priority": 2 },
            { "id": "stage",   "header": "Stage",       "field": "stage_label",         "width": 90,  "priority": 2 }
          ]
        }
      },

      "footerDivider": { "type": "Divider", "props": {} },
      "footer": {
        "type": "Row",
        "props": { "justify": "end", "gap": "xs", "align": "center" },
        "children": ["footerBtn"]
      },
      "footerBtn": {
        "type": "Button",
        "props": { "label": "Open in D365", "variant": "ghost", "size": "sm", "leadingIcon": "ExternalLink" },
        "on": {
          "click": {
            "action": "open_url",
            "params": { "url": "https://mysmb-dev.crm6.dynamics.com", "target": "_blank" }
          }
        }
      }
    }
  }
}
