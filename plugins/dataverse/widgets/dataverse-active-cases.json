{
  "id": "dataverse-active-cases-v5",
  "status": "published",
  "title": "Active Cases",
  "description": "Open Dynamics 365 Customer Service cases — title, priority, status, and time created.",
  "category": "support",
  "tags": ["dataverse", "dynamics-365", "cases", "incidents", "customer-service", "support"],
  "keywords": ["cases", "incidents", "open cases", "support queue", "customer service", "d365"],
  "connectorsUsed": ["dataverse"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 8, "rowSpan": 5 },
    "min":       { "colSpan": 6, "rowSpan": 4 },
    "max":       { "colSpan": 12, "rowSpan": 10 }
  },
  "dataProvider": {
    "mcp": "dataverse",
    "tool": "list_active_cases",
    "params": {
      "org_url": "https://mysmb-dev.crm6.dynamics.com",
      "top": 25
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": ["titleRow", "statGrid", "divider", "tableBody", "footerDivider", "footer"]
      },
      "titleRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["titleGroup"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "Inbox", "tone": "accent", "size": "sm" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "eyebrow"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Active Cases", "level": "h2" }
      },
      "eyebrow": {
        "type": "Eyebrow",
        "props": { "text": "Dynamics 365 Customer Service" }
      },
      "tableBody": {
        "type": "Body",
        "props": {},
        "children": ["table"]
      },
      "statGrid": {
        "type": "Grid",
        "props": { "cols": 2 },
        "children": ["tileCount", "tileOverdue"]
      },
      "tileCount": {
        "type": "Section",
        "props": { "variant": "muted" },
        "children": ["stackCount"]
      },
      "stackCount": {
        "type": "Stack",
        "props": { "gap": "xxs", "align": "center" },
        "children": ["iconCount", "valCount", "lblCount"]
      },
      "iconCount": {
        "type": "Icon",
        "props": { "name": "Inbox", "size": "sm", "tone": "accent" }
      },
      "valCount": {
        "type": "Stat",
        "props": {
          "value": {
            "$computed": "count",
            "args": { "value": { "$state": "/dataverse/list_active_cases/items" } }
          }
        }
      },
      "lblCount": {
        "type": "Caption",
        "props": { "text": "Open Cases" }
      },
      "tileOverdue": {
        "type": "Section",
        "props": { "variant": "muted" },
        "children": ["stackOverdue"]
      },
      "stackOverdue": {
        "type": "Stack",
        "props": { "gap": "xxs", "align": "center" },
        "children": ["iconOverdue", "valOverdue", "lblOverdue"]
      },
      "iconOverdue": {
        "type": "Icon",
        "props": { "name": "AlertTriangle", "size": "sm", "tone": "destructive" }
      },
      "valOverdue": {
        "type": "Stat",
        "props": {
          "value": {
            "$computed": "count_where",
            "args": {
              "value": { "$state": "/dataverse/list_active_cases/items" },
              "field": "isescalated",
              "eq": true
            }
          }
        }
      },
      "lblOverdue": {
        "type": "Caption",
        "props": { "text": "Overdue Cases", "tone": "destructive" }
      },
      "divider": { "type": "Divider", "props": {} },
      "table": {
        "type": "Table",
        "props": {
          "loading": { "$state": "/_loading/dataverse.list_active_cases" },
          "skeletonRows": 6,
          "rows": { "$state": "/dataverse/list_active_cases/items" },
          "columns": [
            { "id": "title",    "header": "Case",      "field": "title",        "priority": 1 },
            { "id": "ticket",   "header": "Ticket #",  "field": "ticketnumber", "width": 120, "priority": 1 },
            { "id": "priority", "header": "Priority",  "field": "priority_label", "width": 90,  "priority": 2 },
            { "id": "status",   "header": "Status",    "field": "status_label",   "width": 90,  "priority": 2 },
            { "id": "created",  "header": "Created",   "field": "createdon",    "width": 120, "priority": 2, "format": "relative" }
          ]
        }
      },
      "footerDivider": { "type": "Divider", "props": {} },
      "footer": {
        "type": "Row",
        "props": { "justify": "end", "gap": "xs", "align": "center" },
        "children": ["footerBtn"]
      },
      "footerBtn": {
        "type": "Button",
        "props": {
          "label": "Open in D365",
          "variant": "ghost",
          "size": "sm",
          "leadingIcon": "ExternalLink"
        },
        "on": {
          "click": {
            "action": "open_url",
            "params": { "url": "https://mysmb-dev.crm6.dynamics.com", "target": "_blank" }
          }
        }
      }
    }
  }
}
