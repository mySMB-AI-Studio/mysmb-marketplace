{
  "id": "dataverse-knowledge-search-v2",
  "status": "published",
  "title": "D365 Knowledge Search",
  "description": "Search published Dynamics 365 knowledge articles — the same knowledge base agents use to resolve cases.",
  "category": "support",
  "tags": ["dataverse", "dynamics-365", "knowledge", "articles", "support", "customer-service"],
  "keywords": ["knowledge base", "articles", "search", "faq", "dynamics", "d365", "customer service"],
  "connectorsUsed": ["dataverse"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 5, "rowSpan": 5 },
    "min":       { "colSpan": 4, "rowSpan": 4 },
    "max":       { "colSpan": 10, "rowSpan": 10 }
  },
  "dataProvider": {
    "mcp": "dataverse",
    "tool": "search_knowledge_articles",
    "params": { "org_url": "https://mysmb-dev.crm6.dynamics.com", "query": "common issues", "top": 5 }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": ["header", "body"]
      },
      "header": {
        "type": "Header",
        "props": {},
        "children": ["titleRow"]
      },
      "titleRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["titleGroup", "brandBadge"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "BookOpen", "tone": "accent", "size": "sm" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "eyebrow"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Knowledge Search", "level": "h2" }
      },
      "eyebrow": {
        "type": "Eyebrow",
        "props": { "text": "Dynamics 365 Customer Service" }
      },
      "brandBadge": {
        "type": "Badge",
        "props": { "text": "Dynamics 365", "tone": "info" }
      },
      "body": {
        "type": "Body",
        "props": {},
        "children": ["list", "footerDivider", "footer"]
      },
      "list": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "repeat": {
          "statePath": "/dataverse/search_knowledge_articles/articles",
          "key": "knowledgearticleid"
        },
        "children": ["articleRow"]
      },
      "articleRow": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["artTitle", "artDesc"]
      },
      "artTitle": {
        "type": "Text",
        "props": { "text": { "$item": "title" }, "weight": "bold" }
      },
      "artDesc": {
        "type": "Caption",
        "props": { "text": { "$item": "description" } }
      },
      "footerDivider": { "type": "Divider", "props": {} },
      "footer": {
        "type": "Row",
        "props": { "justify": "end", "gap": "xs", "align": "center" },
        "children": ["footerBtn"]
      },
      "footerBtn": {
        "type": "Button",
        "props": {
          "label": "Open in D365",
          "variant": "ghost",
          "size": "sm",
          "leadingIcon": "ExternalLink"
        },
        "on": {
          "click": {
            "action": "open_url",
            "params": { "url": "https://mysmb-dev.crm6.dynamics.com", "target": "_blank" }
          }
        }
      }
    }
  }
}
