{
  "id": "myob-aged-receivables",
  "title": "MYOB — Aged Receivables",
  "description": "Open invoices aggregated per customer — total balance owed with overdue indicator, sorted worst-first.",
  "category": "finance",
  "tags": ["myob", "receivables", "aging", "ar", "finance", "overdue"],
  "keywords": ["aged", "aging", "receivables", "ar", "outstanding", "overdue", "myob", "customers"],
  "connectorsUsed": ["myob-accounting"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 5, "rowSpan": 5 },
    "min": { "colSpan": 4, "rowSpan": 4 },
    "max": { "colSpan": 10, "rowSpan": 12 }
  },
  "dataProvider": {
    "mcp": "myob-accounting",
    "tool": "list_invoices",
    "params": { "status": "Open", "page_size": 500 }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": ["header", "body"],
        "watch": {
          "/myob-accounting/list_invoices/Items": {
            "action": "setState",
            "params": {
              "statePath": "/ui/arData",
              "value": {
                "$computed": "myob-accounting_ar_by_customer",
                "args": { "value": { "$state": "/myob-accounting/list_invoices/Items" } }
              }
            }
          }
        }
      },

      "header": {
        "type": "Header",
        "props": {},
        "children": ["titleGroup"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "start" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "CalendarClock", "tone": "warning", "size": "sm" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "subtitle"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Aged Receivables", "level": "h2" }
      },
      "subtitle": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{n} customers · {total} outstanding",
              "n": { "$state": "/ui/arData/customerCount" },
              "total": {
                "$computed": "myob-accounting_format_currency",
                "args": { "value": { "$state": "/ui/arData/grandTotal" } }
              }
            }
          }
        }
      },

      "body": {
        "type": "Body",
        "props": {},
        "children": ["loading", "statGrid", "divider0", "empty", "list"]
      },

      "loading": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["skel1", "skel2", "skel3", "skel4"],
        "visible": { "$state": "/_loading/myob-accounting.list_invoices" }
      },
      "skel1": { "type": "Skeleton", "props": { "height": "2.25rem", "rounded": "md" } },
      "skel2": { "type": "Skeleton", "props": { "height": "2.25rem", "rounded": "md" } },
      "skel3": { "type": "Skeleton", "props": { "height": "2.25rem", "rounded": "md" } },
      "skel4": { "type": "Skeleton", "props": { "height": "2.25rem", "rounded": "md" } },

      "statGrid": {
        "type": "Grid",
        "props": { "cols": 2, "gap": "md" },
        "children": ["statCountSection", "statTotalSection"],
        "visible": {
          "$and": [
            { "$state": "/_loading/myob-accounting.list_invoices", "not": true },
            { "$state": "/ui/arData/customerCount" }
          ]
        }
      },
      "statCountSection": {
        "type": "Section",
        "props": { "variant": "muted" },
        "children": ["statCount"]
      },
      "statTotalSection": {
        "type": "Section",
        "props": { "variant": "muted" },
        "children": ["statTotal"]
      },
      "statCount": {
        "type": "Stack",
        "props": { "gap": "xs", "align": "center" },
        "children": ["statCountLabel", "statCountValue"]
      },
      "statCountLabel": {
        "type": "Eyebrow",
        "props": { "text": "Customers Owing" }
      },
      "statCountValue": {
        "type": "Stat",
        "props": {
          "value": { "$state": "/ui/arData/customerCount" },
          "tone": "warning"
        }
      },
      "statTotal": {
        "type": "Stack",
        "props": { "gap": "xs", "align": "center" },
        "children": ["statTotalLabel", "statTotalValue"]
      },
      "statTotalLabel": {
        "type": "Eyebrow",
        "props": { "text": "Total Outstanding" }
      },
      "statTotalValue": {
        "type": "Stat",
        "props": {
          "value": {
            "$computed": "myob-accounting_format_currency",
            "args": { "value": { "$state": "/ui/arData/grandTotal" } }
          },
          "tone": "warning"
        }
      },

      "divider0": {
        "type": "Divider",
        "visible": {
          "$and": [
            { "$state": "/_loading/myob-accounting.list_invoices", "not": true },
            { "$state": "/ui/arData/customerCount" }
          ]
        }
      },

      "empty": {
        "type": "Empty",
        "props": { "message": "No outstanding receivables.", "icon": "Trophy" },
        "visible": {
          "$and": [
            { "$state": "/_loading/myob-accounting.list_invoices", "not": true },
            { "$state": "/ui/arData/customerCount", "not": true }
          ]
        }
      },

      "list": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["rowWrapper"],
        "repeat": {
          "statePath": "/ui/arData/entries",
          "key": "uid"
        },
        "visible": { "$state": "/_loading/myob-accounting.list_invoices", "not": true }
      },
      "rowWrapper": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["row", "rowDivider"]
      },
      "row": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center", "hover": true },
        "children": ["label", "ageBadgeWrap", "amount"]
      },
      "label": {
        "type": "Text",
        "props": {
          "text": { "$item": "name" },
          "size": "sm",
          "weight": "semibold",
          "truncate": true,
          "grow": true
        }
      },
      "ageBadgeWrap": {
        "type": "Row",
        "props": { "justify": "center" },
        "children": ["ageBadge"]
      },
      "ageBadge": {
        "type": "Badge",
        "props": {
          "text": { "$item": "badgeText" },
          "tone": { "$item": "badgeTone" },
          "variant": "soft"
        }
      },
      "amount": {
        "type": "Text",
        "props": {
          "text": {
            "$computed": "myob-accounting_format_currency",
            "args": { "value": { "$item": "total" } }
          },
          "size": "sm",
          "weight": "semibold",
          "align": "end"
        }
      },
      "rowDivider": {
        "type": "Divider"
      }
    }
  },
  "status": "published"
}
