{
  "id": "myob-aged-receivables",
  "title": "MYOB — Aged Receivables",
  "description": "Open invoices aggregated per customer — total balance owed with overdue indicator, sorted worst-first.",
  "category": "finance",
  "tags": ["myob", "receivables", "aging", "ar", "finance", "overdue"],
  "keywords": ["aged", "aging", "receivables", "ar", "outstanding", "overdue", "myob", "customers"],
  "connectorsUsed": ["myob-accounting"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 5, "rowSpan": 5 },
    "min": { "colSpan": 4, "rowSpan": 4 },
    "max": { "colSpan": 10, "rowSpan": 12 }
  },
  "dataProvider": {
    "mcp": "myob-accounting",
    "tool": "list_invoices",
    "params": { "status": "Open", "page_size": 500 }
  },
  "spec": {
    "root": "card",
    "elements": {

      "card": {
        "type": "Card",
        "props": {},
        "children": ["titleRow", "statGrid", "divider", "tableBody"],
        "watch": {
          "/myob-accounting/list_invoices/Items": {
            "action": "setState",
            "params": {
              "statePath": "/ui/arData",
              "value": {
                "$computed": "myob-accounting_ar_by_customer",
                "args": {
                  "value": { "$state": "/myob-accounting/list_invoices/Items" }
                }
              }
            }
          }
        }
      },

      "titleRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["titleGroup"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "CalendarClock", "tone": "warning", "size": "sm" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "eyebrow"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Aged Receivables", "level": "h2" }
      },
      "eyebrow": {
        "type": "Eyebrow",
        "props": { "text": "MYOB Accounting" }
      },

      "statGrid": {
        "type": "Grid",
        "props": { "cols": 2 },
        "children": ["tileCount", "tileTotal"]
      },
      "tileCount": {
        "type": "Section",
        "props": { "variant": "muted" },
        "children": ["stackCount"]
      },
      "stackCount": {
        "type": "Stack",
        "props": { "gap": "xxs", "align": "center" },
        "children": ["iconCount", "valCount", "lblCount"]
      },
      "iconCount": {
        "type": "Icon",
        "props": { "name": "Users", "size": "sm", "tone": "warning" }
      },
      "valCount": {
        "type": "Stat",
        "props": {
          "value": { "$state": "/ui/arData/customerCount" },
          "tone": "warning"
        }
      },
      "lblCount": {
        "type": "Caption",
        "props": { "text": "Customers Owing" }
      },
      "tileTotal": {
        "type": "Section",
        "props": { "variant": "muted" },
        "children": ["stackTotal"]
      },
      "stackTotal": {
        "type": "Stack",
        "props": { "gap": "xxs", "align": "center" },
        "children": ["iconTotal", "valTotal", "lblTotal"]
      },
      "iconTotal": {
        "type": "Icon",
        "props": { "name": "AlertTriangle", "size": "sm", "tone": "warning" }
      },
      "valTotal": {
        "type": "Stat",
        "props": {
          "value": {
            "$computed": "myob-accounting_format_currency",
            "args": { "value": { "$state": "/ui/arData/grandTotal" } }
          },
          "tone": "warning"
        }
      },
      "lblTotal": {
        "type": "Caption",
        "props": { "text": "Total Outstanding" }
      },

      "divider": { "type": "Divider", "props": {} },

      "tableBody": {
        "type": "Body",
        "props": {},
        "children": ["table"]
      },
      "table": {
        "type": "Table",
        "props": {
          "loading": { "$state": "/_loading/myob-accounting.list_invoices" },
          "skeletonRows": 4,
          "rows": { "$state": "/ui/arData/entries" },
          "columns": [
            { "id": "customer",     "header": "Customer", "field": "name",         "priority": 1 },
            { "id": "invoiceCount", "header": "Invoices", "field": "invoiceCount", "width": 96,  "priority": 1 },
            { "id": "total",        "header": "Amount",   "field": "total",        "width": 120, "priority": 1, "format": "currency" }
          ]
        }
      }

    }
  },
  "status": "published"
}
