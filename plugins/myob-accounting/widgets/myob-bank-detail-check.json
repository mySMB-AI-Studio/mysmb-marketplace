{
  "category": "finance",
  "connectorsUsed": [
    "myob-accounting"
  ],
  "dataProvider": {
    "kind": "tool",
    "mcp": "myob-accounting",
    "params": {},
    "tool": "list_myob_bank_detail_check"
  },
  "description": "Cross-references open MYOB purchase bills against bank account details stored on supplier contacts — surfaces missing or unverifiable bank details before batch payment runs.",
  "id": "myob-bank-detail-check",
  "keywords": [
    "myob",
    "bank detail",
    "check",
    "verify",
    "verified",
    "can't verify",
    "missing",
    "bills",
    "accounts payable",
    "batch payment",
    "supplier",
    "contact",
    "fraud"
  ],
  "popularity": 0,
  "sizing": {
    "max": {
      "colSpan": 10,
      "rowSpan": 14
    },
    "min": {
      "colSpan": 4,
      "rowSpan": 5
    },
    "preferred": {
      "colSpan": 5,
      "rowSpan": 7
    }
  },
  "spec": {
    "elements": {
      "billAmount": {
        "props": {
          "size": "md",
          "text": {
            "$computed": "format_currency",
            "args": {
              "currency": {
                "$item": "currencyCode"
              },
              "value": {
                "$item": "amountDue"
              }
            }
          },
          "weight": "semibold"
        },
        "type": "Text"
      },
      "billDivider": {
        "props": {},
        "type": "Divider"
      },
      "billInfo": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "children": [
          "billName",
          "billMeta",
          "billBadgeRow"
        ]
      },
      "billList": {
        "children": [
          "billRow"
        ],
        "props": {
          "gap": "sm"
        },
        "repeat": {
          "key": "id",
          "statePath": "/myob-accounting/list_myob_bank_detail_check/bills"
        },
        "type": "Stack"
      },
      "billMeta": {
        "props": {
          "text": {
            "$item": "metaLine"
          },
          "tone": "muted",
          "truncate": true
        },
        "type": "Caption"
      },
      "billName": {
        "props": {
          "size": "md",
          "text": {
            "$item": "contactName"
          },
          "truncate": true,
          "weight": "semibold"
        },
        "type": "Text"
      },
      "billRow": {
        "children": [
          "billRowContent",
          "billDivider"
        ],
        "props": {
          "gap": "sm"
        },
        "type": "Stack"
      },
      "billRowContent": {
        "children": [
          "billDotGroup",
          "billInfo",
          "billRightCol"
        ],
        "props": {
          "align": "start",
          "gap": "sm",
          "template": "auto minmax(0,1fr) auto"
        },
        "type": "Row"
      },
      "billRightCol": {
        "children": [
          "billAmount",
          "billReviewBtn"
        ],
        "props": {
          "align": "end",
          "gap": "sm"
        },
        "type": "Stack"
      },
      "billReviewBtn": {
        "type": "Row",
        "props": {
          "gap": "xs",
          "align": "center",
          "hover": true,
          "clickable": true
        },
        "children": [
          "billReviewText",
          "billReviewIcon"
        ],
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "url": {
                "$computed": "identity",
                "args": {
                  "value": {
                    "$item": "reviewUrl"
                  }
                }
              },
              "target": "_blank"
            }
          }
        },
        "visible": {
          "$item": "needsReview"
        }
      },
      "body": {
        "children": [
          "loading",
          "empty",
          "content"
        ],
        "props": {},
        "type": "Body"
      },
      "card": {
        "children": [
          "header",
          "body"
        ],
        "props": {},
        "type": "Card"
      },
      "content": {
        "children": [
          "statsGrid",
          "divider",
          "billList",
          "footerDivider",
          "footerRow"
        ],
        "props": {
          "gap": "md"
        },
        "type": "Stack",
        "visible": {
          "$and": [
            {
              "$state": "/_loading/myob-accounting.list_myob_bank_detail_check",
              "not": true
            },
            {
              "$state": "/myob-accounting/list_myob_bank_detail_check/bills/0"
            }
          ]
        }
      },
      "divider": {
        "props": {},
        "type": "Divider"
      },
      "empty": {
        "props": {
          "message": "No open bills found."
        },
        "type": "Empty",
        "visible": {
          "$and": [
            {
              "$state": "/_loading/myob-accounting.list_myob_bank_detail_check",
              "not": true
            },
            {
              "$state": "/myob-accounting/list_myob_bank_detail_check/bills/0",
              "not": true
            }
          ]
        }
      },
      "footerLeft": {
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "n": {
                "$state": "/myob-accounting/list_myob_bank_detail_check/summary/total"
              },
              "pattern": "{n} open bills scanned"
            }
          },
          "tone": "muted"
        },
        "type": "Caption"
      },
      "footerRight": {
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "Updated {t}",
              "t": {
                "$state": "/myob-accounting/list_myob_bank_detail_check/updatedTime"
              }
            }
          },
          "tone": "muted"
        },
        "type": "Caption"
      },
      "footerRow": {
        "children": [
          "footerLeft",
          "footerRight"
        ],
        "props": {
          "align": "center",
          "gap": "sm",
          "justify": "between"
        },
        "type": "Row"
      },
      "header": {
        "children": [
          "title"
        ],
        "props": {},
        "type": "Header"
      },
      "loading": {
        "children": [
          "sk1",
          "sk2",
          "sk3",
          "sk4",
          "sk5"
        ],
        "props": {
          "gap": "sm"
        },
        "type": "Stack",
        "visible": {
          "$state": "/_loading/myob-accounting.list_myob_bank_detail_check"
        }
      },
      "sk1": {
        "props": {
          "height": "3.5rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "sk2": {
        "props": {
          "height": "2.75rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "sk3": {
        "props": {
          "height": "2.75rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "sk4": {
        "props": {
          "height": "2.75rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "sk5": {
        "props": {
          "height": "2.75rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "statCantVerify": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "children": [
          "valCantVerify",
          "lblCantVerify"
        ]
      },
      "valCantVerify": {
        "type": "Stat",
        "props": {
          "value": {
            "$state": "/myob-accounting/list_myob_bank_detail_check/summary/cantVerify"
          },
          "tone": "warning"
        }
      },
      "lblCantVerify": {
        "type": "Caption",
        "props": {
          "text": "CAN'T VERIFY",
          "tone": "warning"
        }
      },
      "statVerified": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "children": [
          "valVerified",
          "lblVerified"
        ]
      },
      "valVerified": {
        "type": "Stat",
        "props": {
          "value": {
            "$state": "/myob-accounting/list_myob_bank_detail_check/summary/verified"
          },
          "tone": "success"
        }
      },
      "lblVerified": {
        "type": "Caption",
        "props": {
          "text": "VERIFIED",
          "tone": "success"
        }
      },
      "statsGrid": {
        "children": [
          "statMismatchCard",
          "statCantVerifyCard",
          "statVerifiedCard"
        ],
        "props": {
          "cols": 3,
          "gap": "sm"
        },
        "type": "Grid"
      },
      "statMismatchCard": {
        "type": "Section",
        "props": {
          "variant": "muted"
        },
        "children": [
          "statMismatch"
        ]
      },
      "statCantVerifyCard": {
        "type": "Section",
        "props": {
          "variant": "muted"
        },
        "children": [
          "statCantVerify"
        ]
      },
      "statVerifiedCard": {
        "type": "Section",
        "props": {
          "variant": "muted"
        },
        "children": [
          "statVerified"
        ]
      },
      "statMismatch": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "children": [
          "valMismatch",
          "lblMismatch"
        ]
      },
      "valMismatch": {
        "type": "Stat",
        "props": {
          "value": {
            "$state": "/myob-accounting/list_myob_bank_detail_check/summary/mismatch"
          },
          "tone": "destructive"
        }
      },
      "lblMismatch": {
        "type": "Caption",
        "props": {
          "text": "MISMATCH",
          "tone": "destructive"
        }
      },
      "title": {
        "props": {
          "level": "h2",
          "text": "Bank-Detail Check"
        },
        "type": "Heading"
      },
      "billReviewText": {
        "type": "Text",
        "props": {
          "text": "Review",
          "size": "sm",
          "weight": "medium",
          "tone": "info"
        }
      },
      "billReviewIcon": {
        "type": "Icon",
        "props": {
          "name": "ArrowRight",
          "size": "xs",
          "tone": "info"
        }
      },
      "footerDivider": {
        "type": "Divider",
        "props": {}
      },
      "billDotGroup": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "children": [
          "billDotMismatch",
          "billDotMissing",
          "billDotVerified"
        ]
      },
      "billDotMismatch": {
        "type": "Dot",
        "props": {
          "size": "sm",
          "tone": "destructive"
        },
        "visible": {
          "$item": "status",
          "eq": "mismatch"
        }
      },
      "billBadgeMismatch": {
        "type": "Badge",
        "props": {
          "text": "Mismatch",
          "tone": "destructive",
          "variant": "soft"
        },
        "visible": {
          "$item": "status",
          "eq": "mismatch"
        }
      },
      "billDotMissing": {
        "type": "Dot",
        "props": {
          "size": "sm",
          "tone": "warning"
        },
        "visible": {
          "$item": "status",
          "eq": "cant_verify"
        }
      },
      "billBadgeMissing": {
        "type": "Badge",
        "props": {
          "text": "Missing on contact",
          "tone": "warning",
          "variant": "soft"
        },
        "visible": {
          "$item": "status",
          "eq": "cant_verify"
        }
      },
      "billDotVerified": {
        "type": "Dot",
        "props": {
          "size": "sm",
          "tone": "success"
        },
        "visible": {
          "$item": "status",
          "eq": "verified"
        }
      },
      "billBadgeVerified": {
        "type": "Badge",
        "props": {
          "text": "Verified",
          "tone": "success",
          "variant": "soft"
        },
        "visible": {
          "$item": "status",
          "eq": "verified"
        }
      },
      "billBadgeRow": {
        "type": "Row",
        "props": {
          "gap": "xs",
          "align": "center"
        },
        "children": [
          "billBadgeMismatch",
          "billBadgeMissing",
          "billBadgeVerified"
        ]
      }
    },
    "root": "card"
  },
  "status": "published",
  "tags": [
    "myob",
    "bills",
    "bank",
    "payments",
    "fraud",
    "verification",
    "accounts-payable"
  ],
  "title": "Bank-Detail Check"
}
