{
  "id": "myob-overdue-invoices",
  "title": "MYOB — Overdue Invoices",
  "description": "Overdue sales invoices sorted most overdue first, with total exposure and aging stats.",
  "category": "finance",
  "tags": ["myob", "invoices", "overdue", "aging", "ar", "finance", "receivables"],
  "keywords": ["overdue", "invoices", "aging", "aged", "past due", "myob", "receivables", "ar"],
  "connectorsUsed": ["myob-accounting"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 7, "rowSpan": 9 },
    "min":       { "colSpan": 5, "rowSpan": 8 },
    "max":       { "colSpan": 12, "rowSpan": 14 }
  },
  "dataProvider": {
    "mcp": "myob-accounting",
    "tool": "list_invoices",
    "params": { "status": "Open", "page_size": 500 }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": ["headerRow", "div0", "kpiGrid", "div1", "tableBody", "div2", "kvGrid"],
        "watch": {
          "/myob-accounting/list_invoices/Items": {
            "action": "setState",
            "params": {
              "statePath": "/ui/overdueData",
              "value": {
                "$computed": "myob-accounting_flatten_overdue_invoices",
                "args": { "value": { "$state": "/myob-accounting/list_invoices/Items" } }
              }
            }
          }
        }
      },

      "headerRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["titleGroup"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": { "type": "Icon", "props": { "name": "AlertTriangle", "tone": "destructive", "size": "sm" } },
      "titleStack": { "type": "Stack", "props": { "gap": "none" }, "children": ["title", "eyebrow"] },
      "title": { "type": "Heading", "props": { "text": "Overdue Invoices", "level": "h2" } },
      "eyebrow": { "type": "Eyebrow", "props": { "text": "MYOB Accounting · Requires attention" } },

      "div0": { "type": "Divider", "props": {} },

      "kpiGrid": {
        "type": "Grid",
        "props": { "cols": 2, "gap": "sm" },
        "children": ["tileTotal", "tileCount"],
        "visible": { "$state": "/_loading/myob-accounting.list_invoices", "not": true }
      },
      "tileTotal": { "type": "Section", "props": { "variant": "muted" }, "children": ["stackTotal"] },
      "stackTotal": { "type": "Stack", "props": { "gap": "xxs", "align": "center" }, "children": ["iconTotal", "valTotal", "lblTotal"] },
      "iconTotal": { "type": "Icon", "props": { "name": "DollarSign", "size": "sm", "tone": "destructive" } },
      "valTotal": {
        "type": "Stat",
        "props": {
          "value": {
            "$computed": "myob-accounting_format_currency",
            "args": { "value": { "$state": "/ui/overdueData/totalOverdue" } }
          }
        }
      },
      "lblTotal": { "type": "Caption", "props": { "text": "Total Overdue" } },

      "tileCount": { "type": "Section", "props": { "variant": "muted" }, "children": ["stackCount"] },
      "stackCount": { "type": "Stack", "props": { "gap": "xxs", "align": "center" }, "children": ["iconCount", "valCount", "lblCount"] },
      "iconCount": { "type": "Icon", "props": { "name": "FileText", "size": "sm", "tone": "warning" } },
      "valCount": {
        "type": "Stat",
        "props": { "value": { "$state": "/ui/overdueData/overdueCount" } }
      },
      "lblCount": { "type": "Caption", "props": { "text": "Overdue Invoices" } },

      "div1": { "type": "Divider", "props": {} },

      "tableBody": {
        "type": "Body",
        "props": {},
        "children": ["loading", "empty", "invoicesTable"]
      },
      "loading": {
        "type": "Stack", "props": { "gap": "sm" },
        "children": ["sk1", "sk2", "sk3", "sk4"],
        "visible": { "$state": "/_loading/myob-accounting.list_invoices" }
      },
      "sk1": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "sk2": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "sk3": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "sk4": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "empty": {
        "type": "Empty",
        "props": { "message": "No overdue invoices — you're all caught up." },
        "visible": {
          "$and": [
            { "$state": "/_loading/myob-accounting.list_invoices", "not": true },
            { "$state": "/ui/overdueData/overdueCount", "not": true }
          ]
        }
      },
      "invoicesTable": {
        "type": "Table",
        "props": {
          "loading": { "$state": "/_loading/myob-accounting.list_invoices" },
          "skeletonRows": 6,
          "rows": { "$state": "/ui/overdueData/rows" },
          "columns": [
            { "id": "number",   "header": "Invoice #",    "field": "number",        "width": 100, "priority": 1 },
            { "id": "customer", "header": "Customer",     "field": "customer_name",               "priority": 1 },
            { "id": "amount",   "header": "Amount",       "field": "amount",        "width": 110, "priority": 1 },
            { "id": "days",     "header": "Days Overdue", "field": "days_overdue",  "width": 110, "priority": 1 },
            { "id": "due",      "header": "Due Date",     "field": "due_date",      "width": 110, "priority": 2 }
          ]
        },
        "visible": {
          "$and": [
            { "$state": "/_loading/myob-accounting.list_invoices", "not": true },
            { "$state": "/ui/overdueData/overdueCount" }
          ]
        }
      },

      "div2": {
        "type": "Divider",
        "visible": {
          "$and": [
            { "$state": "/_loading/myob-accounting.list_invoices", "not": true },
            { "$state": "/ui/overdueData/overdueCount" }
          ]
        }
      },
      "kvGrid": {
        "type": "Row",
        "props": { "justify": "between", "align": "start" },
        "children": ["kvOldest", "kvAvg"],
        "visible": {
          "$and": [
            { "$state": "/_loading/myob-accounting.list_invoices", "not": true },
            { "$state": "/ui/overdueData/overdueCount" }
          ]
        }
      },
      "kvOldest": {
        "type": "KeyValue",
        "props": {
          "label": "Oldest Invoice",
          "value": {
            "$computed": "fmt",
            "args": { "pattern": "{d} days", "d": { "$state": "/ui/overdueData/oldestDays" } }
          }
        }
      },
      "kvAvg": {
        "type": "KeyValue",
        "props": {
          "label": "Avg Days Overdue",
          "value": {
            "$computed": "fmt",
            "args": { "pattern": "{d} days", "d": { "$state": "/ui/overdueData/avgDays" } }
          }
        }
      }
    }
  },
  "status": "published"
}
