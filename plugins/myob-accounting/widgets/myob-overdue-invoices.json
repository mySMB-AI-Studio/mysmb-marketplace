{
  "id": "myob-overdue-invoices",
  "title": "MYOB — Overdue Invoices",
  "description": "Overdue sales invoices grouped into age buckets — 1–15, 16–30, and 30+ days past due.",
  "category": "finance",
  "tags": ["myob", "invoices", "overdue", "aging", "ar", "finance", "receivables"],
  "keywords": ["overdue", "invoices", "aging", "aged", "past due", "myob", "receivables", "ar"],
  "connectorsUsed": ["myob-accounting"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 4, "rowSpan": 4 },
    "min": { "colSpan": 3, "rowSpan": 3 },
    "max": { "colSpan": 8, "rowSpan": 8 }
  },
  "dataProvider": {
    "mcp": "myob-accounting",
    "tool": "list_invoices",
    "params": { "status": "Open", "page_size": 500 }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "children": ["header", "body"],
        "watch": {
          "/myob-accounting/list_invoices/Items": {
            "action": "setState",
            "params": {
              "statePath": "/ui/overdueData",
              "value": {
                "$computed": "myob-accounting_overdue_buckets",
                "args": { "value": { "$state": "/myob-accounting/list_invoices/Items" } }
              }
            }
          }
        }
      },

      "header": {
        "type": "Header",
        "children": ["titleGroup"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["title", "titleIcon"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Overdue Invoices", "level": "h2" }
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "AlarmClock", "tone": "muted", "size": "sm" }
      },

      "body": {
        "type": "Body",
        "children": ["loading", "empty", "hero", "divider", "bucketList"]
      },

      "loading": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["sk1", "sk2", "sk3"],
        "visible": { "$state": "/_loading/myob-accounting.list_invoices" }
      },
      "sk1": { "type": "Skeleton", "props": { "height": "3rem", "rounded": "md" } },
      "sk2": { "type": "Skeleton", "props": { "height": "2rem", "rounded": "md" } },
      "sk3": { "type": "Skeleton", "props": { "height": "2rem", "rounded": "md" } },

      "empty": {
        "type": "Empty",
        "props": { "message": "No overdue invoices — you're all caught up." },
        "visible": {
          "$and": [
            { "$state": "/_loading/myob-accounting.list_invoices", "not": true },
            { "$state": "/ui/overdueData/total", "not": true }
          ]
        }
      },

      "hero": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["heroAmount", "heroLabel"],
        "visible": {
          "$and": [
            { "$state": "/_loading/myob-accounting.list_invoices", "not": true },
            { "$state": "/ui/overdueData/total" }
          ]
        }
      },
      "heroAmount": {
        "type": "Stat",
        "props": {
          "value": {
            "$computed": "myob-accounting_format_currency",
            "args": { "value": { "$state": "/ui/overdueData/total" } }
          }
        }
      },
      "heroLabel": {
        "type": "Text",
        "props": { "text": "total overdue", "tone": "muted", "size": "sm" }
      },

      "divider": {
        "type": "Divider",
        "visible": {
          "$and": [
            { "$state": "/_loading/myob-accounting.list_invoices", "not": true },
            { "$state": "/ui/overdueData/total" }
          ]
        }
      },

      "bucketList": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["bucketRow"],
        "repeat": {
          "statePath": "/ui/overdueData/buckets",
          "key": "key"
        },
        "visible": {
          "$and": [
            { "$state": "/_loading/myob-accounting.list_invoices", "not": true },
            { "$state": "/ui/overdueData/total" }
          ]
        }
      },
      "bucketRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center",
          "template": "minmax(0, 1fr) 3rem 8rem"
        },
        "children": ["bucketLeft", "bucketCount", "bucketAmount"]
      },
      "bucketLeft": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["bucketDot", "bucketLabel"]
      },
      "bucketDot": {
        "type": "Dot",
        "props": { "tone": { "$item": "tone" }, "size": "sm" }
      },
      "bucketLabel": {
        "type": "Text",
        "props": {
          "text": { "$item": "label" },
          "size": "sm",
          "tone": { "$item": "tone" }
        }
      },
      "bucketCount": {
        "type": "Text",
        "props": {
          "text": { "$item": "count" },
          "size": "sm",
          "tone": "muted",
          "align": "end"
        }
      },
      "bucketAmount": {
        "type": "Text",
        "props": {
          "text": {
            "$computed": "myob-accounting_format_currency",
            "args": { "value": { "$item": "total" } }
          },
          "size": "sm",
          "weight": "semibold",
          "align": "end"
        }
      }
    }
  },
  "status": "published"
}
