{
  "id": "myob-financial-position",
  "title": "MYOB — Financial Position",
  "description": "Net profit hero with monthly income, expenses and profit sparklines for the financial year.",
  "category": "finance",
  "tags": ["myob", "pnl", "profit", "net profit", "financial position", "income", "expenses", "finance", "report"],
  "keywords": ["financial position", "net profit", "income", "expenses", "pnl", "myob", "balance", "financial year"],
  "connectorsUsed": ["myob-accounting"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 6, "rowSpan": 7 },
    "min": { "colSpan": 4, "rowSpan": 5 },
    "max": { "colSpan": 10, "rowSpan": 10 }
  },
  "dataProvider": {
    "mcp": "myob-accounting",
    "tool": "get_profit_and_loss",
    "params": { "from_date": "2025-07-01", "to_date": "2026-06-30", "reporting_basis": "Accrual" }
  },
  "spec": {
    "root": "card",
    "elements": {

      "card": {
        "type": "Card",
        "children": ["header", "heroStack", "incomeSparkRow", "expensesSparkRow", "netSparkRow", "dateAxis", "legend", "divider", "collapseRow", "collapseBody"],
        "watch": {
          "/myob-accounting/get_profit_and_loss": [
            {
              "action": "myob-accounting.list_invoices",
              "params": { "status": "All", "from_date": "2025-07-01", "to_date": "2026-06-30", "page_size": 1000 }
            },
            {
              "action": "myob-accounting.list_bills",
              "params": { "status": "All", "from_date": "2025-07-01", "to_date": "2026-06-30", "page_size": 1000 }
            }
          ]
        }
      },

      "header": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["titleGroup"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": { "type": "Icon", "props": { "name": "TrendingUp", "tone": "accent", "size": "sm" } },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "eyebrow"]
      },
      "title": { "type": "Heading", "props": { "text": "Financial Position", "level": "h2" } },
      "eyebrow": { "type": "Eyebrow", "props": { "text": "MYOB Accounting" } },
      "heroStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["heroAmt", "heroSub"]
      },
      "heroAmt": {
        "type": "Stat",
        "props": {
          "value": {
            "$computed": "myob-accounting_format_currency",
            "args": {
              "value": {
                "$computed": "myob-accounting_pnl_get",
                "args": { "value": { "$state": "/myob-accounting/get_profit_and_loss" }, "key": "netProfit" }
              }
            }
          }
        }
      },
      "heroSub": { "type": "Caption", "props": { "text": "this financial year" } },

      "incomeSparkRow": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["incomeSparkLabel", "incomeSpark"]
      },
      "incomeSparkLabel": { "type": "Caption", "props": { "text": "Income", "tone": "success" } },
      "incomeSpark": {
        "type": "Sparkline",
        "props": {
          "values": {
            "$computed": "myob-accounting_monthly_totals",
            "args": {
              "value": { "$state": "/myob-accounting/list_invoices/Items" },
              "months": ["2025-07","2025-08","2025-09","2025-10","2025-11","2025-12","2026-01","2026-02","2026-03","2026-04","2026-05","2026-06"]
            }
          },
          "tone": "success",
          "height": 50,
          "fill": false
        }
      },

      "expensesSparkRow": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["expensesSparkLabel", "expensesSpark"]
      },
      "expensesSparkLabel": { "type": "Caption", "props": { "text": "Expenses", "tone": "destructive" } },
      "expensesSpark": {
        "type": "Sparkline",
        "props": {
          "values": {
            "$computed": "myob-accounting_monthly_totals",
            "args": {
              "value": { "$state": "/myob-accounting/list_bills/Items" },
              "months": ["2025-07","2025-08","2025-09","2025-10","2025-11","2025-12","2026-01","2026-02","2026-03","2026-04","2026-05","2026-06"]
            }
          },
          "tone": "destructive",
          "height": 50,
          "fill": false
        }
      },

      "netSparkRow": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["netSparkLabel", "netSpark"]
      },
      "netSparkLabel": { "type": "Caption", "props": { "text": "Net profit", "tone": "accent" } },
      "netSpark": {
        "type": "Sparkline",
        "props": {
          "values": {
            "$computed": "myob-accounting_net_monthly",
            "args": {
              "income": {
                "$computed": "myob-accounting_monthly_totals",
                "args": {
                  "value": { "$state": "/myob-accounting/list_invoices/Items" },
                  "months": ["2025-07","2025-08","2025-09","2025-10","2025-11","2025-12","2026-01","2026-02","2026-03","2026-04","2026-05","2026-06"]
                }
              },
              "expenses": {
                "$computed": "myob-accounting_monthly_totals",
                "args": {
                  "value": { "$state": "/myob-accounting/list_bills/Items" },
                  "months": ["2025-07","2025-08","2025-09","2025-10","2025-11","2025-12","2026-01","2026-02","2026-03","2026-04","2026-05","2026-06"]
                }
              }
            }
          },
          "tone": "accent",
          "height": 50,
          "fill": false
        }
      },

      "dateAxis": {
        "type": "Row",
        "props": { "justify": "between" },
        "children": ["dateStart", "dateMid", "dateEnd"]
      },
      "dateStart": { "type": "Caption", "props": { "text": "Jul 2025" } },
      "dateMid":   { "type": "Caption", "props": { "text": "Jan 2026" } },
      "dateEnd":   { "type": "Caption", "props": { "text": "Jun 2026" } },

      "legend": {
        "type": "Row",
        "props": { "gap": "lg", "align": "center" },
        "children": ["legendIncome", "legendExpenses", "legendNet"]
      },
      "legendIncome": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["legendIncomeDot", "legendIncomeLabel"]
      },
      "legendIncomeDot": { "type": "Icon", "props": { "name": "Circle", "tone": "success", "size": "xs" } },
      "legendIncomeLabel": { "type": "Caption", "props": { "text": "Income" } },
      "legendExpenses": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["legendExpensesDot", "legendExpensesLabel"]
      },
      "legendExpensesDot": { "type": "Icon", "props": { "name": "Circle", "tone": "destructive", "size": "xs" } },
      "legendExpensesLabel": { "type": "Caption", "props": { "text": "Expenses" } },
      "legendNet": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["legendNetDot", "legendNetLabel"]
      },
      "legendNetDot": { "type": "Icon", "props": { "name": "Circle", "tone": "accent", "size": "xs" } },
      "legendNetLabel": { "type": "Caption", "props": { "text": "Net profit" } },

      "divider": { "type": "Divider" },

      "collapseRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center", "clickable": true },
        "children": ["collapseLabel", "chevronStack"],
        "on": {
          "click": {
            "action": "setState",
            "params": {
              "statePath": "/ui/fp/expanded",
              "value": {
                "$computed": "myob-accounting_bool_not",
                "args": { "value": { "$state": "/ui/fp/expanded" } }
              }
            }
          }
        }
      },
      "collapseLabel": { "type": "Text", "props": { "text": "Totals", "size": "sm", "weight": "medium" } },
      "chevronStack": {
        "type": "Row",
        "props": { "gap": "none" },
        "children": ["chevronDown", "chevronUp"]
      },
      "chevronDown": {
        "type": "Icon",
        "props": { "name": "ChevronDown", "size": "sm", "tone": "muted" },
        "visible": {
          "$computed": "myob-accounting_bool_not",
          "args": { "value": { "$state": "/ui/fp/expanded" } }
        }
      },
      "chevronUp": {
        "type": "Icon",
        "props": { "name": "ChevronUp", "size": "sm", "tone": "muted" },
        "visible": { "$state": "/ui/fp/expanded" }
      },

      "collapseBody": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "visible": { "$state": "/ui/fp/expanded" },
        "children": ["fpIncomeRow", "fpExpensesRow", "fpNetRow"]
      },

      "fpIncomeRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["fpIncomeLbl", "fpIncomeAmt"]
      },
      "fpIncomeLbl": { "type": "Caption", "props": { "text": "Income" } },
      "fpIncomeAmt": {
        "type": "Text",
        "props": {
          "text": {
            "$computed": "myob-accounting_format_currency",
            "args": {
              "value": {
                "$computed": "myob-accounting_pnl_get",
                "args": { "value": { "$state": "/myob-accounting/get_profit_and_loss" }, "key": "income" }
              }
            }
          },
          "size": "sm",
          "weight": "medium"
        }
      },

      "fpExpensesRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["fpExpensesLbl", "fpExpensesAmt"]
      },
      "fpExpensesLbl": { "type": "Caption", "props": { "text": "Expenses" } },
      "fpExpensesAmt": {
        "type": "Text",
        "props": {
          "text": {
            "$computed": "myob-accounting_format_currency",
            "args": {
              "value": {
                "$computed": "myob-accounting_pnl_get",
                "args": { "value": { "$state": "/myob-accounting/get_profit_and_loss" }, "key": "expenses" }
              }
            }
          },
          "size": "sm",
          "weight": "medium"
        }
      },

      "fpNetRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["fpNetLbl", "fpNetAmt"]
      },
      "fpNetLbl": { "type": "Caption", "props": { "text": "Net profit" } },
      "fpNetAmt": {
        "type": "Text",
        "props": {
          "text": {
            "$computed": "myob-accounting_format_currency",
            "args": {
              "value": {
                "$computed": "myob-accounting_pnl_get",
                "args": { "value": { "$state": "/myob-accounting/get_profit_and_loss" }, "key": "netProfit" }
              }
            }
          },
          "size": "sm",
          "weight": "medium"
        }
      }

    }
  },
  "status": "published"
}
