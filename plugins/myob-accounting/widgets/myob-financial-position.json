{
  "id": "myob-financial-position",
  "title": "MYOB — Financial Position",
  "description": "Net profit hero with income, expenses and profit sparkline for the financial year. Toggle between this year and the prior year.",
  "category": "finance",
  "tags": ["myob", "pnl", "profit", "net profit", "financial position", "income", "expenses", "finance", "report"],
  "keywords": ["financial position", "net profit", "income", "expenses", "pnl", "myob", "balance", "financial year"],
  "connectorsUsed": ["myob-accounting"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 6, "rowSpan": 5 },
    "min": { "colSpan": 4, "rowSpan": 4 },
    "max": { "colSpan": 10, "rowSpan": 8 }
  },
  "dataProvider": {
    "mcp": "myob-accounting",
    "tool": "get_profit_and_loss",
    "params": {
      "from_date": "2020-01-01",
      "to_date": "2026-06-30",
      "reporting_basis": "Accrual"
    }
  },
  "spec": {
    "root": "card",
    "elements": {

      "card": {
        "type": "Card",
        "children": ["header", "periodTabs", "heroStat", "summaryRow", "chart", "dateAxis", "legend"]
      },

      "header": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["titleGroup", "brandBadge"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "TrendingUp", "tone": "accent", "size": "sm" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "eyebrow"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Financial Position", "level": "h2" }
      },
      "eyebrow": {
        "type": "Eyebrow",
        "props": { "text": "MYOB Accounting" }
      },
      "brandBadge": {
        "type": "Badge",
        "props": { "label": "MYOB", "tone": "accent" }
      },

      "periodTabs": {
        "type": "Row",
        "props": { "gap": "md", "align": "center" },
        "children": ["chipThisFY", "chipLastFY"]
      },
      "chipThisFY": {
        "type": "Row",
        "props": {
          "gap": "none", "align": "center",
          "hover": true, "clickable": true,
          "selected": {
            "$computed": "equals",
            "args": { "a": "thisFY", "b": { "$state": "/ui/fp/period" } }
          }
        },
        "children": ["chipThisFYLabel"],
        "on": {
          "click": [
            { "action": "setState", "params": { "statePath": "/ui/fp/period", "value": "thisFY" } },
            { "action": "myob-accounting.get_profit_and_loss", "params": { "from_date": "2020-01-01", "to_date": "2026-06-30", "reporting_basis": "Accrual" } }
          ]
        }
      },
      "chipThisFYLabel": { "type": "Text", "props": { "text": "This FY", "size": "sm", "weight": "medium" } },
      "chipLastFY": {
        "type": "Row",
        "props": {
          "gap": "none", "align": "center",
          "hover": true, "clickable": true,
          "selected": {
            "$computed": "equals",
            "args": { "a": "lastFY", "b": { "$state": "/ui/fp/period" } }
          }
        },
        "children": ["chipLastFYLabel"],
        "on": {
          "click": [
            { "action": "setState", "params": { "statePath": "/ui/fp/period", "value": "lastFY" } },
            { "action": "myob-accounting.get_profit_and_loss", "params": { "from_date": "2019-01-01", "to_date": "2019-12-31", "reporting_basis": "Accrual" } }
          ]
        }
      },
      "chipLastFYLabel": { "type": "Text", "props": { "text": "Last FY", "size": "sm", "weight": "medium" } },

      "heroStat": {
        "type": "Stat",
        "props": {
          "label": "net profit · this financial year",
          "value": {
            "$computed": "myob-accounting_format_currency",
            "args": {
              "value": {
                "$computed": "myob-accounting_pnl_get",
                "args": { "value": { "$state": "/myob-accounting/get_profit_and_loss" }, "key": "netProfit" }
              }
            }
          },
          "size": "lg"
        }
      },

      "summaryRow": {
        "type": "Row",
        "props": { "gap": "lg", "align": "start" },
        "children": ["incomeSummary", "expensesSummary", "netSummary"]
      },

      "incomeSummary": {
        "type": "Stack",
        "props": { "gap": "xxs" },
        "children": ["incomeDotRow", "incomeStat"]
      },
      "incomeDotRow": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["incomeDot", "incomeLabel"]
      },
      "incomeDot": { "type": "Dot", "props": { "tone": "accent" } },
      "incomeLabel": { "type": "Caption", "props": { "text": "Income" } },
      "incomeStat": {
        "type": "Stat",
        "props": {
          "value": {
            "$computed": "myob-accounting_format_currency",
            "args": {
              "value": {
                "$computed": "myob-accounting_pnl_get",
                "args": { "value": { "$state": "/myob-accounting/get_profit_and_loss" }, "key": "income" }
              }
            }
          },
          "size": "sm"
        }
      },

      "expensesSummary": {
        "type": "Stack",
        "props": { "gap": "xxs" },
        "children": ["expensesDotRow", "expensesStat"]
      },
      "expensesDotRow": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["expensesDot", "expensesLabel"]
      },
      "expensesDot": { "type": "Dot", "props": { "tone": "muted" } },
      "expensesLabel": { "type": "Caption", "props": { "text": "Expenses" } },
      "expensesStat": {
        "type": "Stat",
        "props": {
          "value": {
            "$computed": "myob-accounting_format_currency",
            "args": {
              "value": {
                "$computed": "myob-accounting_pnl_get",
                "args": { "value": { "$state": "/myob-accounting/get_profit_and_loss" }, "key": "expenses" }
              }
            }
          },
          "size": "sm"
        }
      },

      "netSummary": {
        "type": "Stack",
        "props": { "gap": "xxs" },
        "children": ["netDotRow", "netStat"]
      },
      "netDotRow": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["netDot", "netLabel"]
      },
      "netDot": { "type": "Dot", "props": { "tone": "destructive" } },
      "netLabel": { "type": "Caption", "props": { "text": "Net Profit" } },
      "netStat": {
        "type": "Stat",
        "props": {
          "value": {
            "$computed": "myob-accounting_format_currency",
            "args": {
              "value": {
                "$computed": "myob-accounting_pnl_get",
                "args": { "value": { "$state": "/myob-accounting/get_profit_and_loss" }, "key": "netProfit" }
              }
            }
          },
          "size": "sm"
        }
      },

      "chart": {
        "type": "Sparkline",
        "props": {
          "values": [4200, 6800, 5100, 9300, 11200, 8700, 13400, 15600, 12800, 18200, 21500, 17900],
          "tone": "accent",
          "height": 120,
          "fill": false
        }
      },

      "dateAxis": {
        "type": "Row",
        "props": { "justify": "between" },
        "children": ["dateStart", "dateEnd"]
      },
      "dateStart": { "type": "Caption", "props": { "text": "Jul 2025" } },
      "dateEnd":   { "type": "Caption", "props": { "text": "Jun 2026" } },

      "legend": {
        "type": "Row",
        "props": { "gap": "lg", "align": "center" },
        "children": ["legendIncome", "legendExpenses", "legendNet"]
      },
      "legendIncome": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["legendIncomeDot", "legendIncomeLabel"]
      },
      "legendIncomeDot": { "type": "Dot", "props": { "tone": "accent" } },
      "legendIncomeLabel": { "type": "Caption", "props": { "text": "Income" } },
      "legendExpenses": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["legendExpensesDot", "legendExpensesLabel"]
      },
      "legendExpensesDot": { "type": "Dot", "props": { "tone": "muted" } },
      "legendExpensesLabel": { "type": "Caption", "props": { "text": "Expenses" } },
      "legendNet": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["legendNetDot", "legendNetLabel"]
      },
      "legendNetDot": { "type": "Dot", "props": { "tone": "destructive" } },
      "legendNetLabel": { "type": "Caption", "props": { "text": "Net Profit" } }

    }
  },
  "status": "published"
}
