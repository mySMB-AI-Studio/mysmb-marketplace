{
  "id": "myob-financial-position",
  "title": "MYOB — Financial Position",
  "description": "Net profit hero with income, expenses and profit sparkline for the financial year. Toggle between this year and the prior year.",
  "category": "finance",
  "tags": ["myob", "pnl", "profit", "net profit", "financial position", "income", "expenses", "finance", "report"],
  "keywords": ["financial position", "net profit", "income", "expenses", "pnl", "myob", "balance", "financial year"],
  "connectorsUsed": ["myob-accounting"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 6, "rowSpan": 4 },
    "min": { "colSpan": 4, "rowSpan": 3 },
    "max": { "colSpan": 10, "rowSpan": 8 }
  },
  "dataProvider": {
    "mcp": "myob-accounting",
    "tool": "get_profit_and_loss",
    "params": {
      "from_date": "2020-01-01",
      "to_date": "2026-06-30",
      "reporting_basis": "Accrual"
    }
  },
  "spec": {
    "root": "card",
    "elements": {

      "card": {
        "type": "Card",
        "children": ["header", "heroNet", "summaryRow", "chart", "axis"]
      },

      "header": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["titleGroup", "periodChips"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "TrendingUp", "tone": "accent", "size": "sm" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "eyebrow"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Financial Position", "level": "h2" }
      },
      "eyebrow": {
        "type": "Eyebrow",
        "props": { "text": "MYOB Accounting" }
      },

      "periodChips": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["chipThisFY", "chipLastFY"]
      },
      "chipThisFY": {
        "type": "Row",
        "props": {
          "gap": "none",
          "align": "center",
          "hover": true,
          "clickable": true,
          "selected": {
            "$computed": "equals",
            "args": { "a": "thisFY", "b": { "$state": "/ui/fp/period" } }
          }
        },
        "children": ["chipThisFYLabel"],
        "on": {
          "click": [
            { "action": "setState", "params": { "statePath": "/ui/fp/period", "value": "thisFY" } },
            { "action": "myob-accounting.get_profit_and_loss", "params": { "from_date": "2020-01-01", "to_date": "2026-06-30", "reporting_basis": "Accrual" } }
          ]
        }
      },
      "chipThisFYLabel": {
        "type": "Text",
        "props": { "text": "This FY", "size": "xs", "weight": "medium" }
      },
      "chipLastFY": {
        "type": "Row",
        "props": {
          "gap": "none",
          "align": "center",
          "hover": true,
          "clickable": true,
          "selected": {
            "$computed": "equals",
            "args": { "a": "lastFY", "b": { "$state": "/ui/fp/period" } }
          }
        },
        "children": ["chipLastFYLabel"],
        "on": {
          "click": [
            { "action": "setState", "params": { "statePath": "/ui/fp/period", "value": "lastFY" } },
            { "action": "myob-accounting.get_profit_and_loss", "params": { "from_date": "2019-01-01", "to_date": "2019-12-31", "reporting_basis": "Accrual" } }
          ]
        }
      },
      "chipLastFYLabel": {
        "type": "Text",
        "props": { "text": "Last FY", "size": "xs", "weight": "medium" }
      },

      "heroNet": {
        "type": "Stat",
        "props": {
          "label": "Net Profit",
          "value": {
            "$computed": "myob-accounting_format_currency",
            "args": {
              "value": {
                "$computed": "myob-accounting_pnl_get",
                "args": {
                  "value": { "$state": "/myob-accounting/get_profit_and_loss" },
                  "key": "netProfit"
                }
              }
            }
          },
          "size": "lg"
        }
      },

      "summaryRow": {
        "type": "Row",
        "props": { "gap": "lg", "align": "center" },
        "children": ["statIncome", "statExpenses"]
      },
      "statIncome": {
        "type": "Stat",
        "props": {
          "label": "Income",
          "value": {
            "$computed": "myob-accounting_format_currency",
            "args": {
              "value": {
                "$computed": "myob-accounting_pnl_get",
                "args": {
                  "value": { "$state": "/myob-accounting/get_profit_and_loss" },
                  "key": "income"
                }
              }
            }
          },
          "tone": "success"
        }
      },
      "statExpenses": {
        "type": "Stat",
        "props": {
          "label": "Expenses",
          "value": {
            "$computed": "myob-accounting_format_currency",
            "args": {
              "value": {
                "$computed": "myob-accounting_pnl_get",
                "args": {
                  "value": { "$state": "/myob-accounting/get_profit_and_loss" },
                  "key": "expenses"
                }
              }
            }
          },
          "tone": "destructive"
        }
      },

      "chart": {
        "type": "Sparkline",
        "props": {
          "values": [4200, 6800, 5100, 9300, 11200, 8700, 13400, 15600, 12800, 18200, 21500, 17900],
          "tone": "accent",
          "height": 120,
          "fill": true
        }
      },

      "axis": {
        "type": "Row",
        "props": { "justify": "between", "gap": "none" },
        "children": ["m1","m2","m3","m4","m5","m6","m7","m8","m9","m10","m11","m12"]
      },
      "m1":  { "type": "Caption", "props": { "text": "Jul" } },
      "m2":  { "type": "Caption", "props": { "text": "Aug" } },
      "m3":  { "type": "Caption", "props": { "text": "Sep" } },
      "m4":  { "type": "Caption", "props": { "text": "Oct" } },
      "m5":  { "type": "Caption", "props": { "text": "Nov" } },
      "m6":  { "type": "Caption", "props": { "text": "Dec" } },
      "m7":  { "type": "Caption", "props": { "text": "Jan" } },
      "m8":  { "type": "Caption", "props": { "text": "Feb" } },
      "m9":  { "type": "Caption", "props": { "text": "Mar" } },
      "m10": { "type": "Caption", "props": { "text": "Apr" } },
      "m11": { "type": "Caption", "props": { "text": "May" } },
      "m12": { "type": "Caption", "props": { "text": "Jun" } }

    }
  },
  "status": "published"
}
