{
  "id": "myob-open-bills",
  "title": "MYOB — Open Bills",
  "description": "Outstanding purchase bills from MYOB AccountRight — supplier, amount due, and due date.",
  "category": "finance",
  "tags": ["myob", "bills", "payables", "finance", "accounting", "ap"],
  "keywords": ["bills", "purchase", "payables", "ap", "outstanding", "myob", "supplier"],
  "connectorsUsed": ["myob-accounting"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 5, "rowSpan": 5 },
    "min": { "colSpan": 4, "rowSpan": 4 },
    "max": { "colSpan": 10, "rowSpan": 12 }
  },
  "dataProvider": {
    "mcp": "myob-accounting",
    "tool": "list_bills",
    "params": { "status": "Open", "page_size": 50 }
  },
  "spec": {
    "root": "card",
    "elements": {

      "card": {
        "type": "Card",
        "props": {},
        "children": ["titleRow", "statGrid", "divider", "tableBody"],
        "watch": {
          "/myob-accounting/list_bills/Items": {
            "action": "setState",
            "params": {
              "statePath": "/ui/tableRows",
              "value": {
                "$computed": "myob-accounting_flatten_bills",
                "args": {
                  "value": { "$state": "/myob-accounting/list_bills/Items" }
                }
              }
            }
          }
        }
      },

      "titleRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["titleGroup"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "Receipt", "tone": "destructive", "size": "sm" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "eyebrow"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Open Bills", "level": "h2" }
      },
      "eyebrow": {
        "type": "Eyebrow",
        "props": { "text": "MYOB Accounting" }
      },

      "statGrid": {
        "type": "Grid",
        "props": { "cols": 2 },
        "children": ["tileCount", "tileTotal"]
      },
      "tileCount": {
        "type": "Section",
        "props": { "variant": "muted" },
        "children": ["stackCount"]
      },
      "stackCount": {
        "type": "Stack",
        "props": { "gap": "xxs", "align": "center" },
        "children": ["iconCount", "valCount", "lblCount"]
      },
      "iconCount": {
        "type": "Icon",
        "props": { "name": "Receipt", "size": "sm", "tone": "destructive" }
      },
      "valCount": {
        "type": "Stat",
        "props": {
          "value": {
            "$computed": "count",
            "args": { "value": { "$state": "/myob-accounting/list_bills/Items" } }
          },
          "tone": "destructive"
        }
      },
      "lblCount": {
        "type": "Caption",
        "props": { "text": "Bills to Pay" }
      },
      "tileTotal": {
        "type": "Section",
        "props": { "variant": "muted" },
        "children": ["stackTotal"]
      },
      "stackTotal": {
        "type": "Stack",
        "props": { "gap": "xxs", "align": "center" },
        "children": ["iconTotal", "valTotal", "lblTotal"]
      },
      "iconTotal": {
        "type": "Icon",
        "props": { "name": "DollarSign", "size": "sm", "tone": "destructive" }
      },
      "valTotal": {
        "type": "Stat",
        "props": {
          "value": {
            "$computed": "myob-accounting_format_currency",
            "args": {
              "value": {
                "$computed": "sum",
                "args": {
                  "value": { "$state": "/myob-accounting/list_bills/Items" },
                  "field": "BalanceDueAmount"
                }
              }
            }
          },
          "tone": "destructive"
        }
      },
      "lblTotal": {
        "type": "Caption",
        "props": { "text": "Total Due" }
      },

      "divider": { "type": "Divider", "props": {} },

      "tableBody": {
        "type": "Body",
        "props": {},
        "children": ["table"]
      },
      "table": {
        "type": "Table",
        "props": {
          "loading": { "$state": "/_loading/myob-accounting.list_bills" },
          "skeletonRows": 4,
          "rows": { "$state": "/ui/tableRows" },
          "columns": [
            { "id": "supplier", "header": "Supplier",  "field": "supplierName", "priority": 1 },
            { "id": "number",   "header": "Bill #",    "field": "number",       "width": 96,  "priority": 2 },
            {
              "id": "dueDate",
              "header": "Due Date",
              "field": "dueDate",
              "width": 130,
              "priority": 1,
              "tone": {
                "$computed": "myob-accounting_is_overdue",
                "args": { "value": { "$item": "rawDue" } }
              }
            },
            { "id": "amount",   "header": "Amount",    "field": "amount",       "width": 120, "priority": 1 }
          ]
        }
      }

    }
  },
  "status": "published"
}
