{
  "id": "myob-income-expenses",
  "title": "MYOB — Income vs Expenses",
  "description": "Year-to-date total income vs total expenses with a sparkline and stat tiles. Toggle between this financial year and the prior year.",
  "category": "finance",
  "tags": ["myob", "income", "expenses", "pnl", "profit", "loss", "finance", "report"],
  "keywords": ["income", "expenses", "profit", "loss", "pnl", "myob", "revenue", "financial year"],
  "connectorsUsed": ["myob-accounting"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 6, "rowSpan": 4 },
    "min": { "colSpan": 4, "rowSpan": 3 },
    "max": { "colSpan": 10, "rowSpan": 8 }
  },
  "dataProvider": {
    "mcp": "myob-accounting",
    "tool": "get_profit_and_loss",
    "params": {
      "from_date": "2020-01-01",
      "to_date": "2026-06-30",
      "reporting_basis": "Accrual"
    }
  },
  "spec": {
    "root": "card",
    "elements": {

      "card": {
        "type": "Card",
        "children": ["header", "summaryRow", "chart", "axis"],
        "watch": {
          "/myob-accounting/get_profit_and_loss": {
            "action": "setState",
            "params": {
              "statePath": "/ui/pnl/sparkValues",
              "value": {
                "$computed": "myob-accounting_pnl_spark_values",
                "args": { "value": { "$state": "/myob-accounting/get_profit_and_loss" } }
              }
            }
          }
        }
      },

      "header": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["titleGroup", "periodChips"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "BarChart2", "tone": "accent", "size": "sm" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "eyebrow"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Income vs Expenses", "level": "h2" }
      },
      "eyebrow": {
        "type": "Eyebrow",
        "props": { "text": "MYOB Accounting" }
      },

      "periodChips": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["chipThisFY", "chipLastFY"]
      },
      "chipThisFY": {
        "type": "Row",
        "props": {
          "gap": "none",
          "align": "center",
          "hover": true,
          "clickable": true,
          "selected": {
            "$computed": "equals",
            "args": { "a": "thisFY", "b": { "$state": "/ui/pnl/period" } }
          }
        },
        "children": ["chipThisFYLabel"],
        "on": {
          "click": [
            { "action": "setState", "params": { "statePath": "/ui/pnl/period", "value": "thisFY" } },
            {
              "action": "myob-accounting.get_profit_and_loss",
              "params": { "from_date": "2020-01-01", "to_date": "2026-06-30", "reporting_basis": "Accrual" }
            }
          ]
        }
      },
      "chipThisFYLabel": {
        "type": "Text",
        "props": { "text": "This FY", "size": "xs", "weight": "medium" }
      },
      "chipLastFY": {
        "type": "Row",
        "props": {
          "gap": "none",
          "align": "center",
          "hover": true,
          "clickable": true,
          "selected": {
            "$computed": "equals",
            "args": { "a": "lastFY", "b": { "$state": "/ui/pnl/period" } }
          }
        },
        "children": ["chipLastFYLabel"],
        "on": {
          "click": [
            { "action": "setState", "params": { "statePath": "/ui/pnl/period", "value": "lastFY" } },
            {
              "action": "myob-accounting.get_profit_and_loss",
              "params": { "from_date": "2019-01-01", "to_date": "2019-12-31", "reporting_basis": "Accrual" }
            }
          ]
        }
      },
      "chipLastFYLabel": {
        "type": "Text",
        "props": { "text": "Last FY", "size": "xs", "weight": "medium" }
      },

      "summaryRow": {
        "type": "Row",
        "props": { "gap": "lg", "align": "center" },
        "children": ["statIncome", "statExpenses", "statNet"],
        "visible": { "$state": "/_loading/myob-accounting.get_profit_and_loss", "not": true }
      },
      "statIncome": {
        "type": "Stat",
        "props": {
          "label": "Total Income",
          "value": {
            "$computed": "myob-accounting_format_currency",
            "args": {
              "value": {
                "$computed": "myob-accounting_pnl_get",
                "args": {
                  "value": { "$state": "/myob-accounting/get_profit_and_loss" },
                  "key": "income"
                }
              }
            }
          },
          "tone": "success"
        }
      },
      "statExpenses": {
        "type": "Stat",
        "props": {
          "label": "Total Expenses",
          "value": {
            "$computed": "myob-accounting_format_currency",
            "args": {
              "value": {
                "$computed": "myob-accounting_pnl_get",
                "args": {
                  "value": { "$state": "/myob-accounting/get_profit_and_loss" },
                  "key": "expenses"
                }
              }
            }
          },
          "tone": "destructive"
        }
      },
      "statNet": {
        "type": "Stat",
        "props": {
          "label": "Net Profit",
          "value": {
            "$computed": "myob-accounting_format_currency",
            "args": {
              "value": {
                "$computed": "myob-accounting_pnl_get",
                "args": {
                  "value": { "$state": "/myob-accounting/get_profit_and_loss" },
                  "key": "netProfit"
                }
              }
            }
          }
        }
      },

      "chart": {
        "type": "Sparkline",
        "props": {
          "values": { "$state": "/ui/pnl/sparkValues" },
          "tone": "accent",
          "height": 120,
          "fill": true
        },
        "visible": { "$state": "/_loading/myob-accounting.get_profit_and_loss", "not": true }
      },

      "axis": {
        "type": "Row",
        "props": { "justify": "between", "gap": "none" },
        "children": ["axIncome", "axExpenses", "axNet"],
        "visible": { "$state": "/_loading/myob-accounting.get_profit_and_loss", "not": true }
      },
      "axIncome":   { "type": "Caption", "props": { "text": "Income" } },
      "axExpenses": { "type": "Caption", "props": { "text": "Expenses" } },
      "axNet":      { "type": "Caption", "props": { "text": "Net" } }

    }
  },
  "status": "published"
}
