{
  "id": "myob-income-expenses",
  "title": "MYOB — Income vs Expenses",
  "description": "Total income vs total expenses for the financial year with period toggle.",
  "category": "finance",
  "tags": ["myob", "income", "expenses", "pnl", "profit", "loss", "finance", "report"],
  "keywords": ["income", "expenses", "profit", "loss", "pnl", "myob", "revenue", "financial year"],
  "connectorsUsed": ["myob-accounting"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 6, "rowSpan": 5 },
    "min": { "colSpan": 4, "rowSpan": 4 },
    "max": { "colSpan": 12, "rowSpan": 8 }
  },
  "dataProvider": {
    "mcp": "myob-accounting",
    "tool": "get_profit_and_loss",
    "params": {
      "from_date": "2020-01-01",
      "to_date": "2026-06-30",
      "reporting_basis": "Accrual"
    }
  },
  "spec": {
    "root": "card",
    "elements": {

      "card": {
        "type": "Card",
        "children": ["headerRow", "periodTabs", "statGrid", "debugCaption", "chart", "axis", "legend"]
      },

      "headerRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["titleGroup", "brandBadge"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "BarChart2", "tone": "accent", "size": "sm" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "eyebrow"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Income vs Expenses", "level": "h2" }
      },
      "eyebrow": {
        "type": "Eyebrow",
        "props": { "text": "MYOB Accounting" }
      },
      "brandBadge": {
        "type": "Badge",
        "props": { "label": "MYOB", "tone": "accent" }
      },

      "periodTabs": {
        "type": "Row",
        "props": { "gap": "md", "align": "center" },
        "children": ["chipThisFY", "chipLastFY"]
      },
      "chipThisFY": {
        "type": "Row",
        "props": {
          "gap": "none", "align": "center",
          "hover": true, "clickable": true,
          "selected": {
            "$computed": "equals",
            "args": { "a": "thisFY", "b": { "$state": "/ui/pnl/period" } }
          }
        },
        "children": ["chipThisFYLabel"],
        "on": {
          "click": [
            { "action": "setState", "params": { "statePath": "/ui/pnl/period", "value": "thisFY" } },
            { "action": "myob-accounting.get_profit_and_loss", "params": { "from_date": "2020-01-01", "to_date": "2026-06-30", "reporting_basis": "Accrual" } }
          ]
        }
      },
      "chipThisFYLabel": { "type": "Text", "props": { "text": "This FY", "size": "sm", "weight": "medium" } },
      "chipLastFY": {
        "type": "Row",
        "props": {
          "gap": "none", "align": "center",
          "hover": true, "clickable": true,
          "selected": {
            "$computed": "equals",
            "args": { "a": "lastFY", "b": { "$state": "/ui/pnl/period" } }
          }
        },
        "children": ["chipLastFYLabel"],
        "on": {
          "click": [
            { "action": "setState", "params": { "statePath": "/ui/pnl/period", "value": "lastFY" } },
            { "action": "myob-accounting.get_profit_and_loss", "params": { "from_date": "2019-01-01", "to_date": "2019-12-31", "reporting_basis": "Accrual" } }
          ]
        }
      },
      "chipLastFYLabel": { "type": "Text", "props": { "text": "Last FY", "size": "sm", "weight": "medium" } },

      "statGrid": {
        "type": "Row",
        "props": { "gap": "lg", "align": "start" },
        "children": ["incomeBlock", "expensesBlock"]
      },

      "incomeBlock": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["incomeArrow", "incomeStat"]
      },
      "incomeArrow": {
        "type": "Icon",
        "props": { "name": "ArrowUpRight", "tone": "success", "size": "xs" }
      },
      "incomeStat": {
        "type": "Stat",
        "props": {
          "label": "Total Income",
          "value": {
            "$computed": "myob-accounting_format_currency",
            "args": {
              "value": {
                "$computed": "myob-accounting_pnl_get",
                "args": { "value": { "$state": "/myob-accounting/get_profit_and_loss" }, "key": "income" }
              }
            }
          },
          "tone": "success",
          "size": "lg"
        }
      },

      "expensesBlock": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["expensesArrow", "expensesStat"]
      },
      "expensesArrow": {
        "type": "Icon",
        "props": { "name": "ArrowDownRight", "tone": "destructive", "size": "xs" }
      },
      "expensesStat": {
        "type": "Stat",
        "props": {
          "label": "Total Expenses",
          "value": {
            "$computed": "myob-accounting_format_currency",
            "args": {
              "value": {
                "$computed": "myob-accounting_pnl_get",
                "args": { "value": { "$state": "/myob-accounting/get_profit_and_loss" }, "key": "expenses" }
              }
            }
          },
          "tone": "destructive",
          "size": "lg"
        }
      },

      "debugCaption": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "myob-accounting_format_json",
            "args": { "value": { "$state": "/myob-accounting/get_profit_and_loss" } }
          }
        }
      },
      "expensesChart": {
        "type": "Sparkline",
        "props": {
          "values": [142000, 168000, 235000, 181000, 290000, 178000, 195000, 212000, 310000, 278000, 65000, 98000],
          "tone": "destructive",
          "height": 64,
          "fill": true
        }
      },

      "axis": {
        "type": "Row",
        "props": { "justify": "between", "gap": "none" },
        "children": ["m1","m2","m3","m4","m5","m6","m7","m8","m9","m10","m11","m12"]
      },
      "m1":  { "type": "Caption", "props": { "text": "Jul" } },
      "m2":  { "type": "Caption", "props": { "text": "Aug" } },
      "m3":  { "type": "Caption", "props": { "text": "Sep" } },
      "m4":  { "type": "Caption", "props": { "text": "Oct" } },
      "m5":  { "type": "Caption", "props": { "text": "Nov" } },
      "m6":  { "type": "Caption", "props": { "text": "Dec" } },
      "m7":  { "type": "Caption", "props": { "text": "Jan" } },
      "m8":  { "type": "Caption", "props": { "text": "Feb" } },
      "m9":  { "type": "Caption", "props": { "text": "Mar" } },
      "m10": { "type": "Caption", "props": { "text": "Apr" } },
      "m11": { "type": "Caption", "props": { "text": "May" } },
      "m12": { "type": "Caption", "props": { "text": "Jun" } },

      "legend": {
        "type": "Row",
        "props": { "gap": "lg", "align": "center" },
        "children": ["legendIncome", "legendExpenses"]
      },
      "legendIncome": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["legendIncomeDot", "legendIncomeLabel"]
      },
      "legendIncomeDot": { "type": "Dot", "props": { "tone": "success" } },
      "legendIncomeLabel": { "type": "Caption", "props": { "text": "Income" } },
      "legendExpenses": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["legendExpensesDot", "legendExpensesLabel"]
      },
      "legendExpensesDot": { "type": "Dot", "props": { "tone": "destructive" } },
      "legendExpensesLabel": { "type": "Caption", "props": { "text": "Expenses" } }

    }
  },
  "status": "published"
}
