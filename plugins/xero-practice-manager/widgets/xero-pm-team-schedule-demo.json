{
  "id": "xero-pm-team-schedule-demo",
  "title": "Team Schedule (Demo)",
  "description": "Static demo of the Xero Practice Manager Team Schedule widget — weekly workload overview for 6 staff members, with an inline load bar between name/role and status badge on each row. Spacer count per row adjusted to approximate consistent bar alignment.",
  "category": "project-management",
  "tags": ["xero", "practice-manager", "xpm", "team", "schedule", "workload", "staff", "accounting-practice", "demo"],
  "keywords": ["team schedule", "workload", "staff", "weekly", "job allocation", "xpm", "practice manager", "demo"],
  "connectorsUsed": ["xero-practice-manager"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 4, "rowSpan": 6 },
    "min":       { "colSpan": 3, "rowSpan": 5 },
    "max":       { "colSpan": 8, "rowSpan": 12 }
  },
  "spec": {
    "root": "card",
    "elements": {

      "card": {
        "type": "Card",
        "props": {},
        "children": ["headerRow", "sub", "div0", "body", "div1", "footer"]
      },

      "headerRow": { "type": "Row", "props": { "justify": "between", "align": "center" }, "children": ["titleGroup"] },
      "titleGroup": { "type": "Row", "props": { "gap": "sm", "align": "center" }, "children": ["titleIcon", "titleStack"] },
      "titleIcon": { "type": "Icon", "props": { "name": "Users", "tone": "accent", "size": "sm" } },
      "titleStack": { "type": "Stack", "props": { "gap": "none" }, "children": ["title", "eyebrow"] },
      "title": { "type": "Heading", "props": { "text": "Team Schedule", "level": "h2" } },
      "eyebrow": { "type": "Eyebrow", "props": { "text": "6 staff · Week of 13 Jul" } },

      "sub": { "type": "Text", "props": { "text": "Workload overview · jobs assigned this week", "size": "xs", "tone": "muted" } },
      "div0": { "type": "Divider", "props": {} },

      "body": { "type": "Body", "props": {}, "children": ["rows"] },
      "rows": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["row1","rd1","row2","rd2","row3","rd3","row4","rd4","row5","rd5","row6"]
      },
      "rd1": { "type": "Divider", "props": {} },
      "rd2": { "type": "Divider", "props": {} },
      "rd3": { "type": "Divider", "props": {} },
      "rd4": { "type": "Divider", "props": {} },
      "rd5": { "type": "Divider", "props": {} },

      "row1": { "type": "Row", "props": { "gap": "lg", "align": "center", "justify": "between" }, "children": ["leftGroup1", "spacer1a", "bar1", "badge1"] },
      "leftGroup1": { "type": "Row", "props": { "gap": "sm", "align": "center" }, "children": ["avatar1", "nameCol1"] },
      "avatar1": { "type": "Badge", "props": { "text": "PN", "tone": "success", "variant": "soft" } },
      "nameCol1": { "type": "Stack", "props": { "gap": "none" }, "children": ["name1", "role1"] },
      "name1": { "type": "Text", "props": { "text": "Priya Nair", "size": "sm", "weight": "medium" } },
      "role1": { "type": "Text", "props": { "text": "Senior Accountant · 4 jobs today", "size": "xs", "tone": "muted" } },
      "spacer1a": { "type": "Text", "props": { "text": "", "size": "xs" } },
      "spacer1b": { "type": "Text", "props": { "text": "", "size": "xs" } },
      "bar1": { "type": "ProgressBar", "props": { "value": 80, "tone": "success" } },
