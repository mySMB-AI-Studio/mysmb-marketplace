{
  "id": "xero-pm-open-jobs",
  "title": "Open Jobs",
  "description": "Table of open and in-progress jobs from Xero Practice Manager — job number, name, client, due date, and status at a glance.",
  "category": "accounting",
  "tags": [
    "xero",
    "practice-manager",
    "xpm",
    "jobs",
    "accounting-practice"
  ],
  "keywords": [
    "jobs",
    "open jobs",
    "in progress",
    "practice manager",
    "xpm",
    "xero",
    "due date",
    "status"
  ],
  "connectorsUsed": [
    "xero-practice-manager"
  ],
  "popularity": 0,
  "sizing": {
    "preferred": {
      "colSpan": 5,
      "rowSpan": 5
    },
    "min": {
      "colSpan": 3,
      "rowSpan": 4
    },
    "max": {
      "colSpan": 10,
      "rowSpan": 12
    }
  },
  "dataProvider": {
    "mcp": "xero-practice-manager",
    "tool": "list_xpm_jobs",
    "params": {
      "status": "inprogress"
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "children": [
          "header",
          "body"
        ]
      },
      "header": {
        "type": "Header",
        "children": [
          "titleGroup"
        ]
      },
      "titleGroup": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "start"
        },
        "children": [
          "titleIcon",
          "titleStack"
        ]
      },
      "titleIcon": {
        "type": "Icon",
        "props": {
          "name": "Briefcase",
          "tone": "accent",
          "size": "sm"
        }
      },
      "titleStack": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "children": [
          "title",
          "count"
        ]
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "Open Jobs",
          "level": "h2"
        }
      },
      "count": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{n} jobs",
              "n": {
                "$computed": "count",
                "args": {
                  "value": {
                    "$state": "/xero-practice-manager/list_xpm_jobs/Jobs"
                  }
                }
              }
            }
          }
        },
        "visible": {
          "$state": "/xero-practice-manager/list_xpm_jobs/Jobs/0"
        }
      },
      "body": {
        "type": "Body",
        "children": [
          "jobTable"
        ]
      },
      "jobTable": {
        "type": "Table",
        "props": {
          "loading": {
            "$state": "/_loading/xero-practice-manager.list_xpm_jobs"
          },
          "skeletonRows": 6,
          "rows": {
            "$state": "/xero-practice-manager/list_xpm_jobs/Jobs"
          },
          "emptyMessage": "No open jobs found.",
          "columns": [
            {
              "id": "jobNumber",
              "header": "Job No.",
              "field": "JobNumber",
              "width": 90,
              "priority": 1
            },
            {
              "id": "name",
              "header": "Name",
              "field": "Name",
              "width": 180,
              "priority": 1
            },
            {
              "id": "client",
              "header": "Client",
              "field": "Client/Name",
              "width": 160,
              "priority": 2
            },
            {
              "id": "dueDate",
              "header": "Due Date",
              "field": "DueDate",
              "format": "date",
              "align": "right",
              "width": 110,
              "priority": 2
            },
            {
              "id": "status",
              "header": "Status",
              "field": "State",
              "variant": "badge",
              "width": 110,
              "priority": 1
            }
          ]
        }
      }
    }
  }
}
