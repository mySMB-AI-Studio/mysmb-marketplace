{
  "id": "xero-pm-clients",
  "title": "Clients",
  "description": "Directory of clients in Xero Practice Manager — name, phone, email, and address.",
  "category": "accounting",
  "tags": [
    "xero",
    "practice-manager",
    "xpm",
    "clients",
    "accounting-practice"
  ],
  "keywords": [
    "clients",
    "contacts",
    "practice manager",
    "xpm",
    "xero",
    "phone",
    "email",
    "address"
  ],
  "connectorsUsed": [
    "xero-practice-manager"
  ],
  "popularity": 0,
  "sizing": {
    "preferred": {
      "colSpan": 5,
      "rowSpan": 5
    },
    "min": {
      "colSpan": 3,
      "rowSpan": 4
    },
    "max": {
      "colSpan": 10,
      "rowSpan": 12
    }
  },
  "dataProvider": {
    "mcp": "xero-practice-manager",
    "tool": "list_xpm_clients",
    "params": {}
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "children": [
          "header",
          "body"
        ]
      },
      "header": {
        "type": "Header",
        "children": [
          "titleGroup"
        ]
      },
      "titleGroup": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "start"
        },
        "children": [
          "titleIcon",
          "titleStack"
        ]
      },
      "titleIcon": {
        "type": "Icon",
        "props": {
          "name": "Users",
          "tone": "accent",
          "size": "sm"
        }
      },
      "titleStack": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "children": [
          "title",
          "count"
        ]
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "Clients",
          "level": "h2"
        }
      },
      "count": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{n} clients",
              "n": {
                "$computed": "count",
                "args": {
                  "value": {
                    "$state": "/xero-practice-manager/list_xpm_clients/Clients"
                  }
                }
              }
            }
          }
        },
        "visible": {
          "$state": "/xero-practice-manager/list_xpm_clients/Clients/0"
        }
      },
      "body": {
        "type": "Body",
        "children": [
          "clientTable"
        ]
      },
      "clientTable": {
        "type": "Table",
        "props": {
          "loading": {
            "$state": "/_loading/xero-practice-manager.list_xpm_clients"
          },
          "skeletonRows": 6,
          "rows": {
            "$state": "/xero-practice-manager/list_xpm_clients/Clients"
          },
          "emptyMessage": "No clients found.",
          "columns": [
            {
              "id": "name",
              "header": "Name",
              "field": "Name",
              "width": 180,
              "priority": 1
            },
            {
              "id": "phone",
              "header": "Phone",
              "field": "Phone",
              "width": 130,
              "priority": 2
            },
            {
              "id": "email",
              "header": "Email",
              "field": "Email",
              "width": 180,
              "priority": 2
            },
            {
              "id": "address",
              "header": "Address",
              "field": "Address",
              "width": 200,
              "priority": 3
            }
          ]
        }
      }
    }
  }
}
