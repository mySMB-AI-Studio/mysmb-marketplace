{
  "id": "xero-pm-time-boxing-demo",
  "title": "Time Boxing (Demo)",
  "description": "Static demo of the Xero Practice Manager Time Boxing widget — daily schedule card showing 9 time-blocked entries for a staff member with billable vs non-billable breakdown.",
  "category": "project-management",
  "tags": ["xero", "practice-manager", "xpm", "time-boxing", "schedule", "timesheets", "accounting-practice", "demo"],
  "keywords": ["time boxing", "schedule", "daily", "billable", "timesheet", "staff", "xpm", "practice manager", "demo"],
  "connectorsUsed": ["xero-practice-manager"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 4, "rowSpan": 7 },
    "min":       { "colSpan": 3, "rowSpan": 6 },
    "max":       { "colSpan": 8, "rowSpan": 14 }
  },
  "spec": {
    "root": "card",
    "elements": {

      "card": {
        "type": "Card",
        "props": {},
        "children": ["headerRow", "sub", "div0", "body", "div1", "footer"]
      },

      "headerRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["titleGroup"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "Clock", "tone": "accent", "size": "sm" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "eyebrow"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Time Boxing", "level": "h2" }
      },
      "eyebrow": {
        "type": "Eyebrow",
        "props": { "text": "Priya Nair · Wed 15 Jul" }
      },

      "sub": {
        "type": "Text",
        "props": { "text": "Daily time blocks · 9 entries", "size": "xs", "tone": "muted" }
      },

      "div0": { "type": "Divider", "props": {} },

      "body": {
        "type": "Body",
        "props": {},
        "children": ["rows"]
      },

      "rows": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["tb1", "tb2", "tb3", "tb4", "tb5", "tb6", "tb7", "tb8", "tb9"]
      },

      "tb1": {
        "type": "xero-practice-manager/TimeBlock",
        "props": { "task": "Inbox triage / buffer", "subtitle": "", "duration": "30m", "tone": "muted" }
      },
      "tb2": {
        "type": "xero-practice-manager/TimeBlock",
        "props": { "task": "FY26 Tax Return prep", "subtitle": "Heritage Trust · Job #4821", "duration": "1h 38m", "tone": "success" }
      },
      "tb3": {
        "type": "xero-practice-manager/TimeBlock",
        "props": { "task": "Break", "subtitle": "", "duration": "15m", "tone": "muted" }
      },
      "tb4": {
        "type": "xero-practice-manager/TimeBlock",
        "props": { "task": "BAS Lodgement Review", "subtitle": "Bayside Club · Job #4809", "duration": "1h 45m", "tone": "success" }
      },
      "tb5": {
        "type": "xero-practice-manager/TimeBlock",
        "props": { "task": "Lunch", "subtitle": "", "duration": "45m", "tone": "muted" }
      },
      "tb6": {
        "type": "xero-practice-manager/TimeBlock",
        "props": { "task": "Year-end reconciliation", "subtitle": "Capital Cab Co · Job #4795", "duration": "1h 45m", "tone": "success" }
      },
      "tb7": {
        "type": "xero-practice-manager/TimeBlock",
        "props": { "task": "Admin / client emails", "subtitle": "", "duration": "30m", "tone": "warning" }
      },
      "tb8": {
        "type": "xero-practice-manager/TimeBlock",
        "props": { "task": "Payroll compliance check", "subtitle": "Mitchell River Lodge · Job #4831", "duration": "1h 38m", "tone": "success" }
      },
      "tb9": {
        "type": "xero-practice-manager/TimeBlock",
        "props": { "task": "Catch-up / overflow", "subtitle": "", "duration": "30m", "tone": "muted" }
      },

      "div1": { "type": "Divider", "props": {} },

      "footer": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["footerRow", "footerBar", "footerHint"]
      },
      "footerRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["footerLabel", "footerStat"]
      },
      "footerLabel": {
        "type": "Text",
        "props": { "text": "Billable scheduled", "size": "xs", "tone": "muted" }
      },
      "footerStat": {
        "type": "Text",
        "props": { "text": "5h 45m / 7h 30m", "size": "sm", "weight": "semibold" }
      },
      "footerBar": {
        "type": "ProgressBar",
        "props": { "value": 77, "tone": "success" }
      },
      "footerHint": {
        "type": "Text",
        "props": { "text": "Blocks generated from XPM scheduled jobs · drag to re-box your day", "size": "xs", "tone": "accent" }
      }

    }
  },
  "status": "published"
}
