{
  "id": "geotab-direct-vehicle-geofence-status",
  "title": "Vehicles On Site Now",
  "description": "Live ring chart of how many vehicles are on site, in transit or offline, matched against your MyGeotab zones, with each vehicle and the site it is at.",
  "category": "fleet-management",
  "tags": [
    "geotab",
    "fleet",
    "live-tracking",
    "geofence"
  ],
  "keywords": [
    "vehicle status",
    "on site",
    "in transit",
    "offline",
    "geofence",
    "zone",
    "live",
    "fleet snapshot"
  ],
  "connectorsUsed": [
    "geotab-direct"
  ],
  "popularity": 0,
  "sizing": {
    "preferred": {
      "colSpan": 6,
      "rowSpan": 7
    },
    "min": {
      "colSpan": 4,
      "rowSpan": 6
    },
    "max": {
      "colSpan": 10,
      "rowSpan": 14
    }
  },
  "dataProvider": {
    "kind": "tool",
    "mcp": "geotab-direct",
    "tool": "get_vehicle_geofence_status",
    "params": {
      "resultsLimit": 500
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": [
          "headerRow",
          "div0",
          "body"
        ],
        "watch": {
          "/geotab-direct/get_vehicle_geofence_status": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/dashboard",
                "value": {
                  "$computed": "geotab-direct_fleet_snapshot_dashboard",
                  "args": {
                    "statuses": {
                      "$state": "/geotab-direct/get_vehicle_geofence_status/result"
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "headerRow": {
        "type": "Row",
        "props": {
          "align": "center",
          "justify": "between"
        },
        "children": [
          "titleGroup"
        ]
      },
      "titleGroup": {
        "type": "Row",
        "props": {
          "align": "center",
          "gap": "sm"
        },
        "children": [
          "titleIcon",
          "titleStack"
        ]
      },
      "titleIcon": {
        "type": "Icon",
        "props": {
          "name": "MapPin",
          "size": "sm",
          "tone": "muted"
        }
      },
      "titleStack": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "children": [
          "title",
          "eyebrow"
        ]
      },
      "title": {
        "type": "Heading",
        "props": {
          "level": "h2",
          "text": "Vehicles On Site Now"
        }
      },
      "eyebrow": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "Live · {n} vehicles",
              "n": {
                "$state": "/ui/dashboard/totalCount"
              }
            }
          }
        }
      },
      "div0": {
        "type": "Divider",
        "props": {}
      },
      "body": {
        "type": "Body",
        "props": {},
        "children": [
          "loading",
          "empty",
          "content"
        ]
      },
      "loading": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "lk1",
          "lk2",
          "lk3"
        ],
        "visible": {
          "$state": "/_loading/geotab-direct.get_vehicle_geofence_status"
        }
      },
      "lk1": {
        "type": "Skeleton",
        "props": {
          "height": "5rem",
          "rounded": "md"
        }
      },
      "lk2": {
        "type": "Skeleton",
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        }
      },
      "lk3": {
        "type": "Skeleton",
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        }
      },
      "empty": {
        "type": "Empty",
        "props": {
          "message": "No device status data available."
        },
        "visible": {
          "$and": [
            {
              "$state": "/_loading/geotab-direct.get_vehicle_geofence_status",
              "not": true
            },
            {
              "$state": "/ui/dashboard/totalCount",
              "not": true
            }
          ]
        }
      },
      "ring": {
        "type": "Donut",
        "props": {
          "segments": {
            "$state": "/ui/dashboard/segments"
          },
          "centerLabel": "vehicles",
          "size": 96,
          "thickness": 10
        }
      },
      "div1": {
        "type": "Divider",
        "props": {}
      },
      "listLabel": {
        "type": "Eyebrow",
        "props": {
          "text": "Vehicles"
        }
      },
      "vehicleRows": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "vehicleRow"
        ],
        "repeat": {
          "statePath": "/ui/dashboard/rows",
          "key": "deviceName"
        }
      },
      "vehicleRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center"
        },
        "children": [
          "vDot",
          "vLabelStack"
        ]
      },
      "vDot": {
        "type": "Dot",
        "props": {
          "tone": {
            "$item": "dotTone"
          },
          "size": "sm"
        }
      },
      "vLabelStack": {
        "type": "Stack",
        "props": {
          "gap": "xs",
          "grow": true
        },
        "children": [
          "vLabel",
          "vCaption"
        ]
      },
      "vLabel": {
        "type": "Text",
        "props": {
          "size": "sm",
          "text": {
            "$item": "deviceName"
          },
          "truncate": true
        }
      },
      "vCaption": {
        "type": "Caption",
        "props": {
          "text": {
            "$item": "caption"
          }
        }
      },
      "content": {
        "type": "Stack",
        "props": {
          "gap": "md"
        },
        "children": [
          "ring",
          "div1",
          "listLabel",
          "vehicleRows"
        ],
        "visible": {
          "$and": [
            {
              "$state": "/_loading/geotab-direct.get_vehicle_geofence_status",
              "not": true
            },
            {
              "$state": "/ui/dashboard/totalCount"
            }
          ]
        }
      }
    }
  }
}
