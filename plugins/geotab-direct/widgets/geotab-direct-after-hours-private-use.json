{
  "id": "geotab-direct-after-hours-private-use",
  "title": "After-Hours & Private Use",
  "description": "After-hours kilometres over the last 30 days broken down by day of the week, plus the vehicles with the most after-hours use, to spot private-use patterns early.",
  "category": "fleet-management",
  "tags": [
    "geotab",
    "fleet",
    "compliance",
    "logbook"
  ],
  "keywords": [
    "after hours",
    "private use",
    "weekend",
    "weekday",
    "fbt",
    "logbook",
    "tool of trade"
  ],
  "connectorsUsed": [
    "geotab-direct"
  ],
  "branding": {
    "icon": "data:image/png;base64,"
  },
  "popularity": 0,
  "sizing": {
    "preferred": {
      "colSpan": 6,
      "rowSpan": 7
    },
    "min": {
      "colSpan": 4,
      "rowSpan": 6
    },
    "max": {
      "colSpan": 10,
      "rowSpan": 14
    }
  },
  "dataProvider": {
    "kind": "tool",
    "mcp": "geotab-direct",
    "tool": "Get",
    "params": {
      "typeName": "Trip",
      "resultsLimit": 1000,
      "search": {
        "fromDate": "$days_ago_30",
        "toDate": "$now"
      }
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": [
          "headerRow",
          "div0",
          "body"
        ],
        "watch": {
          "/geotab-direct/Get": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/dashboard",
                "value": {
                  "$computed": "geotab-direct_after_hours_weekday_dashboard",
                  "args": {
                    "trips": {
                      "$state": "/geotab-direct/Get/result"
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "headerRow": {
        "type": "Row",
        "props": {
          "align": "center",
          "justify": "between"
        },
        "children": [
          "titleGroup"
        ]
      },
      "titleGroup": {
        "type": "Row",
        "props": {
          "align": "center",
          "gap": "sm"
        },
        "children": [
          "titleIcon",
          "titleStack"
        ]
      },
      "titleIcon": {
        "type": "Icon",
        "props": {
          "name": "Clock",
          "size": "sm",
          "tone": "muted"
        }
      },
      "titleStack": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "children": [
          "title",
          "eyebrow"
        ]
      },
      "title": {
        "type": "Heading",
        "props": {
          "level": "h2",
          "text": "After-Hours & Private Use"
        }
      },
      "eyebrow": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "Last 30 days · {km} km after hours",
              "km": {
                "$state": "/ui/dashboard/totalKm"
              }
            }
          }
        }
      },
      "div0": {
        "type": "Divider",
        "props": {}
      },
      "body": {
        "type": "Body",
        "props": {},
        "children": [
          "loading",
          "empty",
          "content"
        ]
      },
      "loading": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "lk1",
          "lk2",
          "lk3"
        ],
        "visible": {
          "$state": "/_loading/geotab-direct.Get"
        }
      },
      "lk1": {
        "type": "Skeleton",
        "props": {
          "height": "5rem",
          "rounded": "md"
        }
      },
      "lk2": {
        "type": "Skeleton",
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        }
      },
      "lk3": {
        "type": "Skeleton",
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        }
      },
      "empty": {
        "type": "Empty",
        "props": {
          "message": "No after-hours trips in the last 30 days."
        },
        "visible": {
          "$and": [
            {
              "$state": "/_loading/geotab-direct.Get",
              "not": true
            },
            {
              "$state": "/ui/dashboard/totalKm",
              "not": true
            }
          ]
        }
      },
      "heroRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "baseline"
        },
        "children": [
          "heroStat",
          "heroCaption"
        ]
      },
      "heroStat": {
        "type": "Stat",
        "props": {
          "value": {
            "$computed": "fmt",
            "args": {
              "pattern": "{km} km",
              "km": {
                "$state": "/ui/dashboard/totalKm"
              }
            }
          }
        }
      },
      "heroCaption": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "Peak {d} · {w}% on weekends",
              "d": {
                "$state": "/ui/dashboard/peakDayLabel"
              },
              "w": {
                "$state": "/ui/dashboard/weekendPercent"
              }
            }
          }
        }
      },
      "div1": {
        "type": "Divider",
        "props": {}
      },
      "stripLabel": {
        "type": "Eyebrow",
        "props": {
          "text": "By weekday"
        }
      },
      "strip": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "end",
          "template": "repeat(7, minmax(0, 1fr))"
        },
        "children": [
          "dayCol"
        ],
        "repeat": {
          "statePath": "/ui/dashboard/days",
          "key": "key"
        }
      },
      "dayCol": {
        "type": "Stack",
        "props": {
          "gap": "xs",
          "align": "stretch"
        },
        "children": [
          "dayKmWrap",
          "dayBarWrap",
          "dayLabelWrap"
        ]
      },
      "dayKmWrap": {
        "type": "Stack",
        "props": {
          "gap": "xs",
          "align": "center"
        },
        "children": [
          "dayKm"
        ]
      },
      "dayKm": {
        "type": "Text",
        "props": {
          "size": "xs",
          "weight": "medium",
          "text": {
            "$item": "kmText"
          }
        }
      },
      "dayBarWrap": {
        "type": "Row",
        "props": {
          "align": "center"
        },
        "children": [
          "dayBar"
        ]
      },
      "dayBar": {
        "type": "ProgressBar",
        "props": {
          "value": {
            "$item": "pct"
          },
          "tone": {
            "$item": "tone"
          }
        }
      },
      "dayLabelWrap": {
        "type": "Stack",
        "props": {
          "gap": "xs",
          "align": "center"
        },
        "children": [
          "dayName",
          "dayTrips"
        ]
      },
      "dayName": {
        "type": "Text",
        "props": {
          "size": "sm",
          "weight": "medium",
          "text": {
            "$item": "dayLabel"
          }
        }
      },
      "dayTrips": {
        "type": "Caption",
        "props": {
          "text": {
            "$item": "tripsText"
          }
        }
      },
      "div2": {
        "type": "Divider",
        "props": {}
      },
      "vehiclesLabel": {
        "type": "Eyebrow",
        "props": {
          "text": "Most after-hours km"
        }
      },
      "vehicleChart": {
        "type": "BarChart",
        "props": {
          "data": {
            "$state": "/ui/dashboard/vehicles"
          },
          "labelField": "deviceName",
          "valueField": "afterHoursKm",
          "tone": "warning",
          "limit": 5,
          "valueFormat": "number"
        }
      },
      "flagNote": {
        "type": "Caption",
        "props": {
          "text": {
            "$state": "/ui/dashboard/flagNote"
          }
        }
      },
      "content": {
        "type": "Stack",
        "props": {
          "gap": "md"
        },
        "children": [
          "heroRow",
          "div1",
          "stripLabel",
          "strip",
          "div2",
          "vehiclesLabel",
          "vehicleChart",
          "flagNote"
        ],
        "visible": {
          "$and": [
            {
              "$state": "/_loading/geotab-direct.Get",
              "not": true
            },
            {
              "$state": "/ui/dashboard/totalKm"
            }
          ]
        }
      }
    }
  }
}
