{
  "id": "geotab-direct-travel-vs-onsite-time",
  "title": "Travel vs On-Site Time",
  "description": "Today's on-site, travel and idle time across the fleet as a split bar, with the same split for each vehicle, from real MyGeotab trip records.",
  "category": "fleet-management",
  "tags": [
    "geotab",
    "fleet",
    "field-service",
    "productivity"
  ],
  "keywords": [
    "travel time",
    "on site",
    "idle",
    "productive ratio",
    "time split",
    "vehicles"
  ],
  "connectorsUsed": [
    "geotab-direct"
  ],
  "popularity": 0,
  "sizing": {
    "preferred": {
      "colSpan": 6,
      "rowSpan": 7
    },
    "min": {
      "colSpan": 4,
      "rowSpan": 6
    },
    "max": {
      "colSpan": 10,
      "rowSpan": 14
    }
  },
  "dataProvider": {
    "kind": "tool",
    "mcp": "geotab-direct",
    "tool": "Get",
    "params": {
      "typeName": "Trip",
      "resultsLimit": 500,
      "search": {
        "fromDate": "$today",
        "toDate": "$now"
      }
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": [
          "headerRow",
          "div0",
          "body"
        ],
        "watch": {
          "/geotab-direct/Get": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/dashboard",
                "value": {
                  "$computed": "geotab-direct_time_split_dashboard",
                  "args": {
                    "trips": {
                      "$state": "/geotab-direct/Get/result"
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "headerRow": {
        "type": "Row",
        "props": {
          "align": "center",
          "justify": "between"
        },
        "children": [
          "titleGroup"
        ]
      },
      "titleGroup": {
        "type": "Row",
        "props": {
          "align": "center",
          "gap": "sm"
        },
        "children": [
          "titleIcon",
          "titleStack"
        ]
      },
      "titleIcon": {
        "type": "Icon",
        "props": {
          "name": "BarChart2",
          "size": "sm",
          "tone": "muted"
        }
      },
      "titleStack": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "children": [
          "title",
          "eyebrow"
        ]
      },
      "title": {
        "type": "Heading",
        "props": {
          "level": "h2",
          "text": "Travel vs On-Site Time"
        }
      },
      "eyebrow": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "Today · {n} vehicles",
              "n": {
                "$state": "/ui/dashboard/vehicleCount"
              }
            }
          }
        }
      },
      "div0": {
        "type": "Divider",
        "props": {}
      },
      "body": {
        "type": "Body",
        "props": {},
        "children": [
          "loading",
          "empty",
          "content"
        ]
      },
      "loading": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "lk1",
          "lk2",
          "lk3"
        ],
        "visible": {
          "$state": "/_loading/geotab-direct.Get"
        }
      },
      "lk1": {
        "type": "Skeleton",
        "props": {
          "height": "5rem",
          "rounded": "md"
        }
      },
      "lk2": {
        "type": "Skeleton",
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        }
      },
      "lk3": {
        "type": "Skeleton",
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        }
      },
      "empty": {
        "type": "Empty",
        "props": {
          "message": "No trips found for today yet."
        },
        "visible": {
          "$and": [
            {
              "$state": "/_loading/geotab-direct.Get",
              "not": true
            },
            {
              "$state": "/ui/dashboard/rows/0",
              "not": true
            }
          ]
        }
      },
      "heroRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "baseline"
        },
        "children": [
          "heroStat",
          "heroCaption"
        ]
      },
      "heroStat": {
        "type": "Stat",
        "props": {
          "value": {
            "$computed": "fmt",
            "args": {
              "pattern": "{p}%",
              "p": {
                "$state": "/ui/dashboard/onSitePercent"
              }
            }
          },
          "tone": "success"
        }
      },
      "heroCaption": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "of tracked time on site · {t}",
              "t": {
                "$state": "/ui/dashboard/onSiteText"
              }
            }
          }
        }
      },
      "fleetBar": {
        "type": "Row",
        "props": {
          "gap": "xs",
          "template": {
            "$state": "/ui/dashboard/bar/template"
          }
        },
        "children": [
          "fleetBar_onSite",
          "fleetBar_travel",
          "fleetBar_idle"
        ]
      },
      "fleetBar_onSite": {
        "type": "ProgressBar",
        "props": {
          "value": 100,
          "tone": "success"
        },
        "visible": {
          "$state": "/ui/dashboard/bar/show_onSite"
        }
      },
      "fleetBar_travel": {
        "type": "ProgressBar",
        "props": {
          "value": 100,
          "tone": "info"
        },
        "visible": {
          "$state": "/ui/dashboard/bar/show_travel"
        }
      },
      "fleetBar_idle": {
        "type": "ProgressBar",
        "props": {
          "value": 100,
          "tone": "warning"
        },
        "visible": {
          "$state": "/ui/dashboard/bar/show_idle"
        }
      },
      "legendRow": {
        "type": "Row",
        "props": {
          "gap": "md",
          "align": "center"
        },
        "children": [
          "lg_onSite",
          "lg_travel",
          "lg_idle"
        ]
      },
      "lg_onSite": {
        "type": "Row",
        "props": {
          "gap": "xs",
          "align": "center"
        },
        "children": [
          "lg_onSite_dot",
          "lg_onSite_text"
        ]
      },
      "lg_onSite_dot": {
        "type": "Dot",
        "props": {
          "tone": "success",
          "size": "sm"
        }
      },
      "lg_onSite_text": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "On site {t} · {p}%",
              "t": {
                "$state": "/ui/dashboard/onSiteText"
              },
              "p": {
                "$state": "/ui/dashboard/onSitePercent"
              }
            }
          }
        }
      },
      "lg_travel": {
        "type": "Row",
        "props": {
          "gap": "xs",
          "align": "center"
        },
        "children": [
          "lg_travel_dot",
          "lg_travel_text"
        ]
      },
      "lg_travel_dot": {
        "type": "Dot",
        "props": {
          "tone": "info",
          "size": "sm"
        }
      },
      "lg_travel_text": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "Travel {t} · {p}%",
              "t": {
                "$state": "/ui/dashboard/travelText"
              },
              "p": {
                "$state": "/ui/dashboard/travelPercent"
              }
            }
          }
        }
      },
      "lg_idle": {
        "type": "Row",
        "props": {
          "gap": "xs",
          "align": "center"
        },
        "children": [
          "lg_idle_dot",
          "lg_idle_text"
        ]
      },
      "lg_idle_dot": {
        "type": "Dot",
        "props": {
          "tone": "warning",
          "size": "sm"
        }
      },
      "lg_idle_text": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "Idle {t} · {p}%",
              "t": {
                "$state": "/ui/dashboard/idleText"
              },
              "p": {
                "$state": "/ui/dashboard/idlePercent"
              }
            }
          }
        }
      },
      "div1": {
        "type": "Divider",
        "props": {}
      },
      "listLabel": {
        "type": "Eyebrow",
        "props": {
          "text": "By vehicle"
        }
      },
      "vehicleRows": {
        "type": "Stack",
        "props": {
          "gap": "md"
        },
        "children": [
          "vehicle"
        ],
        "repeat": {
          "statePath": "/ui/dashboard/rows",
          "key": "deviceId"
        }
      },
      "vehicle": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "children": [
          "vTop",
          "vBar",
          "vCaption"
        ]
      },
      "vTop": {
        "type": "Row",
        "props": {
          "justify": "between",
          "align": "center"
        },
        "children": [
          "vLabel",
          "vPct"
        ]
      },
      "vLabel": {
        "type": "Text",
        "props": {
          "size": "sm",
          "text": {
            "$item": "deviceName"
          },
          "truncate": true
        }
      },
      "vPct": {
        "type": "Text",
        "props": {
          "size": "sm",
          "weight": "medium",
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{p}% on site",
              "p": {
                "$item": "productivePercent"
              }
            }
          }
        }
      },
      "vBar": {
        "type": "Row",
        "props": {
          "gap": "xs",
          "template": {
            "$item": "bar/template"
          }
        },
        "children": [
          "vBar_onSite",
          "vBar_travel",
          "vBar_idle"
        ]
      },
      "vBar_onSite": {
        "type": "ProgressBar",
        "props": {
          "value": 100,
          "tone": "success"
        },
        "visible": {
          "$item": "bar/show_onSite"
        }
      },
      "vBar_travel": {
        "type": "ProgressBar",
        "props": {
          "value": 100,
          "tone": "info"
        },
        "visible": {
          "$item": "bar/show_travel"
        }
      },
      "vBar_idle": {
        "type": "ProgressBar",
        "props": {
          "value": 100,
          "tone": "warning"
        },
        "visible": {
          "$item": "bar/show_idle"
        }
      },
      "vCaption": {
        "type": "Caption",
        "props": {
          "text": {
            "$item": "summary"
          }
        }
      },
      "content": {
        "type": "Stack",
        "props": {
          "gap": "md"
        },
        "children": [
          "heroRow",
          "fleetBar",
          "legendRow",
          "div1",
          "listLabel",
          "vehicleRows"
        ],
        "visible": {
          "$and": [
            {
              "$state": "/_loading/geotab-direct.Get",
              "not": true
            },
            {
              "$state": "/ui/dashboard/rows/0"
            }
          ]
        }
      }
    }
  }
}
