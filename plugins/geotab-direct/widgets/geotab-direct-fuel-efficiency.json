{
  "id": "geotab-direct-fuel-efficiency",
  "title": "Fuel & Efficiency",
  "description": "Litres filled per day over the last week, month-to-date fuel spend and fleet efficiency, and a ring chart of which vehicles used the most fuel this month.",
  "category": "fleet-management",
  "tags": [
    "geotab",
    "fleet",
    "fuel",
    "efficiency"
  ],
  "keywords": [
    "fuel",
    "litres",
    "fuel spend",
    "efficiency",
    "l/100km",
    "fuel by day",
    "fuel by vehicle"
  ],
  "connectorsUsed": [
    "geotab-direct"
  ],
  "popularity": 0,
  "sizing": {
    "preferred": {
      "colSpan": 6,
      "rowSpan": 7
    },
    "min": {
      "colSpan": 4,
      "rowSpan": 6
    },
    "max": {
      "colSpan": 10,
      "rowSpan": 14
    }
  },
  "dataProvider": {
    "kind": "tool",
    "mcp": "geotab-direct",
    "tool": "Get",
    "params": {
      "typeName": "FuelTransaction",
      "resultsLimit": 500,
      "search": {
        "fromDate": "$last_month_start",
        "toDate": "$now"
      }
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": [
          "headerRow",
          "div0",
          "body"
        ],
        "watch": {
          "/geotab-direct/Get": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/dashboard",
                "value": {
                  "$computed": "geotab-direct_fuel_daily_dashboard",
                  "args": {
                    "transactions": {
                      "$state": "/geotab-direct/Get/result"
                    },
                    "monthStartIso": {
                      "$computed": "geotab-direct_month_start_iso",
                      "args": {}
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "headerRow": {
        "type": "Row",
        "props": {
          "align": "center",
          "justify": "between"
        },
        "children": [
          "titleGroup"
        ]
      },
      "titleGroup": {
        "type": "Row",
        "props": {
          "align": "center",
          "gap": "sm"
        },
        "children": [
          "titleIcon",
          "titleStack"
        ]
      },
      "titleIcon": {
        "type": "Icon",
        "props": {
          "name": "Fuel",
          "size": "sm",
          "tone": "muted"
        }
      },
      "titleStack": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "children": [
          "title",
          "eyebrow"
        ]
      },
      "title": {
        "type": "Heading",
        "props": {
          "level": "h2",
          "text": "Fuel & Efficiency"
        }
      },
      "eyebrow": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "Last 7 days · {l} L",
              "l": {
                "$state": "/ui/dashboard/weekLitres"
              }
            }
          }
        }
      },
      "div0": {
        "type": "Divider",
        "props": {}
      },
      "body": {
        "type": "Body",
        "props": {},
        "children": [
          "loading",
          "empty",
          "content"
        ]
      },
      "loading": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "lk1",
          "lk2",
          "lk3"
        ],
        "visible": {
          "$state": "/_loading/geotab-direct.Get"
        }
      },
      "lk1": {
        "type": "Skeleton",
        "props": {
          "height": "5rem",
          "rounded": "md"
        }
      },
      "lk2": {
        "type": "Skeleton",
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        }
      },
      "lk3": {
        "type": "Skeleton",
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        }
      },
      "empty": {
        "type": "Empty",
        "props": {
          "message": "No fuel transactions found."
        },
        "visible": {
          "$and": [
            {
              "$state": "/_loading/geotab-direct.Get",
              "not": true
            },
            {
              "$state": "/geotab-direct/Get/result/0",
              "not": true
            }
          ]
        }
      },
      "heroRow": {
        "type": "Row",
        "props": {
          "gap": "lg",
          "align": "start"
        },
        "children": [
          "costBlock",
          "effBlock"
        ]
      },
      "costBlock": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "children": [
          "costStat",
          "costCaption"
        ]
      },
      "costStat": {
        "type": "Stat",
        "props": {
          "value": {
            "$computed": "format_currency",
            "args": {
              "value": {
                "$state": "/ui/dashboard/totalCost"
              }
            }
          }
        }
      },
      "costCaption": {
        "type": "Caption",
        "props": {
          "text": "Fuel spend this month"
        }
      },
      "effBlock": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "children": [
          "effStat",
          "effCaption"
        ]
      },
      "effStat": {
        "type": "Stat",
        "props": {
          "value": {
            "$state": "/ui/dashboard/fleetAvgL100km"
          }
        }
      },
      "effCaption": {
        "type": "Caption",
        "props": {
          "text": "Fleet avg L/100km"
        }
      },
      "div1": {
        "type": "Divider",
        "props": {}
      },
      "dailyLabel": {
        "type": "Eyebrow",
        "props": {
          "text": "Litres per day"
        }
      },
      "dailyChart": {
        "type": "BarChart",
        "props": {
          "data": {
            "$state": "/ui/dashboard/daily"
          },
          "labelField": "label",
          "valueField": "litres",
          "tone": "info",
          "sort": "none",
          "valueFormat": "number"
        }
      },
      "div2": {
        "type": "Divider",
        "props": {}
      },
      "shareLabel": {
        "type": "Eyebrow",
        "props": {
          "text": "Month to date by vehicle"
        }
      },
      "shareRing": {
        "type": "Donut",
        "props": {
          "segments": {
            "$state": "/ui/dashboard/segments"
          },
          "centerLabel": "litres",
          "size": 96,
          "thickness": 10
        }
      },
      "div3": {
        "type": "Divider",
        "props": {}
      },
      "effLabel": {
        "type": "Eyebrow",
        "props": {
          "text": "Highest L/100km (latest fill)"
        }
      },
      "effChart": {
        "type": "BarChart",
        "props": {
          "data": {
            "$state": "/ui/dashboard/efficiency"
          },
          "labelField": "deviceName",
          "valueField": "l100km",
          "tone": "warning",
          "valueFormat": "number",
          "emptyMessage": "Needs two fills per vehicle to calculate."
        }
      },
      "outlierNote": {
        "type": "Caption",
        "props": {
          "text": {
            "$state": "/ui/dashboard/outlierNote"
          }
        }
      },
      "content": {
        "type": "Stack",
        "props": {
          "gap": "md"
        },
        "children": [
          "heroRow",
          "div1",
          "dailyLabel",
          "dailyChart",
          "div2",
          "shareLabel",
          "shareRing",
          "div3",
          "effLabel",
          "effChart",
          "outlierNote"
        ],
        "visible": {
          "$and": [
            {
              "$state": "/_loading/geotab-direct.Get",
              "not": true
            },
            {
              "$state": "/geotab-direct/Get/result/0"
            }
          ]
        }
      }
    }
  }
}
