{
  "id": "stripe-invoices",
  "title": "Stripe Invoices",
  "description": "Latest invoices with status badges — quickly see what's paid, open, or overdue.",
  "category": "payments",
  "tags": ["stripe", "invoices", "billing", "finance", "payments"],
  "keywords": ["invoices", "stripe", "billing", "paid", "open", "draft", "uncollectible", "void"],
  "connectorsUsed": ["stripe"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 5, "rowSpan": 5 },
    "min": { "colSpan": 4, "rowSpan": 4 },
    "max": { "colSpan": 10, "rowSpan": 12 }
  },
  "dataProvider": {
    "mcp": "stripe",
    "tool": "list_invoices",
    "params": { "limit": 20 }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "children": ["header", "body"]
      },
      "header": {
        "type": "Header",
        "children": ["titleGroup"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "start" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "FileText", "tone": "accent", "size": "sm" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "count"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Stripe Invoices", "level": "h2" }
      },
      "count": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{n} recent",
              "n": {
                "$computed": "count",
                "args": { "value": { "$state": "/stripe/list_invoices/data" } }
              }
            }
          }
        }
      },
      "body": {
        "type": "Body",
        "children": ["loading", "empty", "columnHeaders", "list"]
      },
      "loading": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["sk1", "sk2", "sk3", "sk4"],
        "visible": { "$state": "/_loading/stripe.list_invoices" }
      },
      "sk1": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "sk2": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "sk3": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "sk4": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "empty": {
        "type": "Empty",
        "props": { "message": "No invoices found." },
        "visible": {
          "$and": [
            { "$state": "/_loading/stripe.list_invoices", "not": true },
            { "$state": "/stripe/list_invoices/data/0", "not": true }
          ]
        }
      },
      "columnHeaders": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center",
          "template": "minmax(0, 1fr) 8rem 6rem 7rem auto"
        },
        "children": ["hBilledTo", "hInvoiceNumber", "hAmount", "hDueDate", "hStatus"],
        "visible": {
          "$and": [
            { "$state": "/_loading/stripe.list_invoices", "not": true },
            { "$state": "/stripe/list_invoices/data/0" }
          ]
        }
      },
      "hBilledTo": { "type": "Eyebrow", "props": { "text": "Billed to" } },
      "hInvoiceNumber": { "type": "Eyebrow", "props": { "text": "Invoice Number" } },
      "hAmount": { "type": "Eyebrow", "props": { "text": "Amount" } },
      "hDueDate": { "type": "Eyebrow", "props": { "text": "Due date" } },
      "hStatus": { "type": "Eyebrow", "props": { "text": "Status" } },
      "list": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["row"],
        "repeat": {
          "statePath": "/stripe/list_invoices/data",
          "key": "id"
        },
        "visible": { "$state": "/_loading/stripe.list_invoices", "not": true }
      },
      "row": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center",
          "hover": true,
          "template": "minmax(0, 1fr) 8rem 6rem 7rem auto"
        },
        "children": ["nameText", "invoiceNumText", "amountText", "dueDateText", "statusBadge"]
      },
      "nameText": {
        "type": "Text",
        "props": {
          "text": { "$item": "customer_name" },
          "size": "sm",
          "weight": "medium",
          "truncate": true
        }
      },
      "invoiceNumText": {
        "type": "Caption",
        "props": {
          "text": { "$item": "number" },
          "truncate": true
        }
      },
      "amountText": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "stripe_format_currency",
            "args": {
              "amount": { "$item": "amount_due" },
              "currency": { "$item": "currency" }
            }
          }
        }
      },
      "dueDateText": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "stripe_format_stripe_date",
            "args": { "value": { "$item": "due_date" } }
          }
        }
      },
      "statusBadge": {
        "type": "Badge",
        "props": {
          "text": { "$item": "status" },
          "tone": {
            "$computed": "stripe_invoice_status_tone",
            "args": { "status": { "$item": "status" } }
          },
          "variant": "soft"
        }
      }
    }
  }
}
