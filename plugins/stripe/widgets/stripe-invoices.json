{
  "id": "stripe-invoices",
  "title": "Stripe Invoices",
  "description": "Latest invoices with status badges — quickly see what's paid, open, or overdue.",
  "category": "payments",
  "tags": ["stripe", "invoices", "billing", "finance", "payments"],
  "keywords": ["invoices", "stripe", "billing", "paid", "open", "draft", "uncollectible", "void"],
  "connectorsUsed": ["stripe"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 6, "rowSpan": 5 },
    "min": { "colSpan": 4, "rowSpan": 4 },
    "max": { "colSpan": 10, "rowSpan": 12 }
  },
  "dataProvider": {
    "mcp": "stripe",
    "tool": "list_invoices",
    "params": { "limit": 20 }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": ["titleRow", "divider", "tableBody"],
        "watch": {
          "/stripe/list_invoices/data": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/sortKey",
                "value": "customer_name|asc"
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/tableRows",
                "value": {
                  "$computed": "stripe_flatten_invoices",
                  "args": {
                    "value": { "$state": "/stripe/list_invoices/data" },
                    "key": "customer_name|asc"
                  }
                }
              }
            }
          ],
          "/ui/sortKey": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/tableRows",
                "value": {
                  "$computed": "stripe_flatten_invoices",
                  "args": {
                    "value": { "$state": "/stripe/list_invoices/data" },
                    "key": { "$state": "/ui/sortKey" }
                  }
                }
              }
            }
          ]
        }
      },
      "titleRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["titleGroup", "sortBtn"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "FileText", "tone": "accent", "size": "sm" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "eyebrow"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Invoices", "level": "h2" }
      },
      "eyebrow": {
        "type": "Eyebrow",
        "props": { "text": "Stripe" }
      },
      "sortBtn": {
        "type": "Button",
        "props": {
          "leadingIcon": "ArrowUpDown",
          "variant": "ghost",
          "size": "sm",
          "ariaLabel": "Cycle sort order"
        },
        "on": {
          "click": {
            "action": "setState",
            "params": {
              "statePath": "/ui/sortKey",
              "value": {
                "$computed": "stripe_cycle_sort",
                "args": { "current": { "$state": "/ui/sortKey" } }
              }
            }
          }
        }
      },
      "divider": { "type": "Divider", "props": {} },
      "tableBody": {
        "type": "Body",
        "props": {},
        "children": ["table"]
      },
      "table": {
        "type": "Table",
        "props": {
          "loading": { "$state": "/_loading/stripe.list_invoices" },
          "skeletonRows": 4,
          "rows": { "$state": "/ui/tableRows" },
          "rowAction": {
            "action": "open_url",
            "fromRow": { "url": "hosted_invoice_url" }
          },
          "columns": [
            {
              "id": "customer",
              "header": "Billed to",
              "field": "customer_name",
              "priority": 1
            },
            {
              "id": "status",
              "header": "Status",
              "field": "status",
              "priority": 1
            },
            {
              "id": "amount",
              "header": "Amount",
              "field": "amount",
              "width": 100,
              "priority": 1
            },
            {
              "id": "dueDate",
              "header": "Due date",
              "field": "due_date",
              "width": 120,
              "priority": 2
            },
            {
              "id": "number",
              "header": "Invoice Number",
              "field": "number",
              "width": 130,
              "priority": 3
            }
          ]
        }
      }
    }
  },
  "status": "published"
}
