{
  "id": "stripe-subscription-overview",
  "title": "Subscription Overview",
  "description": "What your recurring revenue is worth and who it comes from. Two headline figures lead — monthly recurring revenue, normalised so a yearly plan is counted as one twelfth per month, and the number of people actually subscribed — then every active subscriber is listed with their plan, what they are charged and when they are next billed. The countdown beside each date only takes a colour when something is really happening: amber when the subscription is set to end at the period close, red when a payment is overdue. With nothing subscribed yet the tile says so plainly instead of showing an empty table.",
  "category": "payments",
  "tags": ["stripe", "subscriptions", "mrr", "billing", "recurring", "revenue"],
  "keywords": ["subscriptions", "mrr", "stripe", "active", "monthly", "revenue", "recurring", "plan", "renewal", "next bill", "subscribers"],
  "connectorsUsed": ["stripe"],
  "popularity": 0,
  "branding": { "color": "#635bff" },
  "brandColor": "#635bff",
  "sizing": {
    "preferred": { "colSpan": 5, "rowSpan": 5 },
    "min": { "colSpan": 4, "rowSpan": 4 },
    "max": { "colSpan": 8, "rowSpan": 12 }
  },
  "dataProvider": {
    "mcp": "stripe",
    "tool": "list_subscriptions",
    "params": { "status": "active", "limit": 100 }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": ["header", "body"],
        "watch": {
          "/stripe/list_subscriptions/data": [
            {
              "action": "setState",
              "params": { "statePath": "/ui/sortKey", "value": "customer_name|asc" }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/board",
                "value": {
                  "$computed": "stripe_subscription_board",
                  "args": {
                    "value": { "$state": "/stripe/list_subscriptions/data" },
                    "key": "customer_name|asc"
                  }
                }
              }
            }
          ],
          "/ui/sortKey": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/board",
                "value": {
                  "$computed": "stripe_subscription_board",
                  "args": {
                    "value": { "$state": "/stripe/list_subscriptions/data" },
                    "key": { "$state": "/ui/sortKey" }
                  }
                }
              }
            }
          ]
        }
      },

      "header": {
        "type": "Header",
        "props": {},
        "children": ["titleGroup"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "start" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "RefreshCw", "tone": "brand", "size": "sm" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["title", "eyebrow"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Subscription Overview", "level": "h2" }
      },
      "eyebrow": {
        "type": "Eyebrow",
        "props": { "text": "STRIPE · RECURRING REVENUE" }
      },

      "body": {
        "type": "Body",
        "props": {},
        "children": ["loading", "kpiGrid", "emptyPanel", "columnHeaders", "list"]
      },

      "loading": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["skKpi", "sk1", "sk2", "sk3"],
        "visible": { "$state": "/_loading/stripe.list_subscriptions" }
      },
      "skKpi": { "type": "Skeleton", "props": { "height": "5.5rem", "rounded": "md" } },
      "sk1": { "type": "Skeleton", "props": { "height": "2.75rem", "rounded": "md" } },
      "sk2": { "type": "Skeleton", "props": { "height": "2.75rem", "rounded": "md" } },
      "sk3": { "type": "Skeleton", "props": { "height": "2.75rem", "rounded": "md" } },

      "kpiGrid": {
        "type": "Grid",
        "props": { "cols": 2, "gap": "sm" },
        "children": ["kpiMrr", "kpiCount"],
        "visible": { "$state": "/_loading/stripe.list_subscriptions", "not": true }
      },

      "kpiMrr": {
        "type": "Section",
        "props": { "variant": "muted" },
        "children": ["mrrStack"]
      },
      "mrrStack": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["mrrHead", "mrrValue", "mrrNote"]
      },
      "mrrHead": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["mrrIcon", "mrrLabel"]
      },
      "mrrIcon": {
        "type": "Icon",
        "props": { "name": "TrendingUp", "size": "sm", "tone": { "$state": "/ui/board/mrrTone" } }
      },
      "mrrLabel": {
        "type": "Eyebrow",
        "props": { "text": "MONTHLY RECURRING REVENUE" }
      },
      "mrrValue": {
        "type": "Stat",
        "props": { "size": "md", "value": { "$state": "/ui/board/mrr" } }
      },
      "mrrNote": {
        "type": "Caption",
        "props": { "tone": "muted", "text": "Per month, every plan normalised" }
      },

      "kpiCount": {
        "type": "Section",
        "props": { "variant": "muted" },
        "children": ["countStack"]
      },
      "countStack": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["countHead", "countValue", "countNote"]
      },
      "countHead": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["countIcon", "countLabel"]
      },
      "countIcon": {
        "type": "Icon",
        "props": { "name": "Users", "size": "sm", "tone": { "$state": "/ui/board/countTone" } }
      },
      "countLabel": {
        "type": "Eyebrow",
        "props": { "text": "ACTIVE SUBSCRIPTIONS" }
      },
      "countValue": {
        "type": "Stat",
        "props": { "size": "md", "value": { "$state": "/ui/board/activeCount" } }
      },
      "countNote": {
        "type": "Caption",
        "props": { "tone": "muted", "text": "Subscribers billing right now" }
      },

      "emptyPanel": {
        "type": "Section",
        "props": { "variant": "bordered" },
        "children": ["emptyStack"],
        "visible": {
          "$and": [
            { "$state": "/_loading/stripe.list_subscriptions", "not": true },
            { "$state": "/stripe/list_subscriptions/data/0", "not": true }
          ]
        }
      },
      "emptyStack": {
        "type": "Stack",
        "props": { "gap": "sm", "align": "center" },
        "children": ["emptyIcon", "emptyTitle", "emptyNote"]
      },
      "emptyIcon": {
        "type": "Icon",
        "props": { "name": "RefreshCw", "tone": "brand", "size": "lg" }
      },
      "emptyTitle": {
        "type": "Text",
        "props": { "text": "No active subscriptions yet", "size": "sm", "weight": "medium" }
      },
      "emptyNote": {
        "type": "Caption",
        "props": {
          "tone": "muted",
          "align": "center",
          "text": "When a customer subscribes, they appear here with their plan, what they pay and when they are next billed."
        }
      },

      "columnHeaders": {
        "type": "Row",
        "props": {
          "gap": "md",
          "align": "center",
          "hover": true,
          "template": "minmax(0, 1fr) 7rem 7rem"
        },
        "children": ["colCustomer", "colAmount", "colNext"],
        "visible": {
          "$and": [
            { "$state": "/_loading/stripe.list_subscriptions", "not": true },
            { "$state": "/stripe/list_subscriptions/data/0" }
          ]
        }
      },
      "colCustomer": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["colCustomerLabel", "sortCustomerBtn"]
      },
      "colCustomerLabel": { "type": "Eyebrow", "props": { "text": "CUSTOMER / PLAN" } },
      "sortCustomerBtn": {
        "type": "IconButton",
        "props": { "icon": "ChevronsUpDown", "size": "sm", "variant": "ghost", "ariaLabel": "Sort by customer" },
        "on": {
          "click": {
            "action": "setState",
            "params": {
              "statePath": "/ui/sortKey",
              "value": {
                "$computed": "stripe_set_sort_field",
                "args": { "current": { "$state": "/ui/sortKey" }, "field": "customer_name" }
              }
            }
          }
        }
      },
      "colAmount": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center", "justify": "end" },
        "children": ["colAmountLabel", "sortAmountBtn"]
      },
      "colAmountLabel": { "type": "Eyebrow", "props": { "text": "AMOUNT" } },
      "sortAmountBtn": {
        "type": "IconButton",
        "props": { "icon": "ChevronsUpDown", "size": "sm", "variant": "ghost", "ariaLabel": "Sort by amount" },
        "on": {
          "click": {
            "action": "setState",
            "params": {
              "statePath": "/ui/sortKey",
              "value": {
                "$computed": "stripe_set_sort_field",
                "args": { "current": { "$state": "/ui/sortKey" }, "field": "amount_cents" }
              }
            }
          }
        }
      },
      "colNext": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center", "justify": "end" },
        "children": ["colNextLabel", "sortNextBtn"]
      },
      "colNextLabel": { "type": "Eyebrow", "props": { "text": "NEXT BILL" } },
      "sortNextBtn": {
        "type": "IconButton",
        "props": { "icon": "ChevronsUpDown", "size": "sm", "variant": "ghost", "ariaLabel": "Sort by next bill date" },
        "on": {
          "click": {
            "action": "setState",
            "params": {
              "statePath": "/ui/sortKey",
              "value": {
                "$computed": "stripe_set_sort_field",
                "args": { "current": { "$state": "/ui/sortKey" }, "field": "next_bill_ts" }
              }
            }
          }
        }
      },

      "list": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["row"],
        "repeat": { "statePath": "/ui/board/rows", "key": "id" },
        "visible": {
          "$and": [
            { "$state": "/_loading/stripe.list_subscriptions", "not": true },
            { "$state": "/stripe/list_subscriptions/data/0" }
          ]
        }
      },
      "row": {
        "type": "Row",
        "props": {
          "gap": "md",
          "align": "center",
          "hover": true,
          "template": "minmax(0, 1fr) 7rem 7rem"
        },
        "children": ["identity", "amountCell", "nextCell"]
      },
      "identity": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["customerName", "planName"]
      },
      "customerName": {
        "type": "Text",
        "props": { "text": { "$item": "customer_name" }, "size": "sm", "weight": "medium", "truncate": true }
      },
      "planName": {
        "type": "Text",
        "props": { "text": { "$item": "plan_name" }, "tone": "muted", "truncate": true }
      },
      "amountCell": {
        "type": "Stack",
        "props": { "gap": "xs", "align": "end" },
        "children": ["amountText", "intervalText"]
      },
      "amountText": {
        "type": "Text",
        "props": { "text": { "$item": "amount" }, "size": "sm", "weight": "medium" }
      },
      "intervalText": {
        "type": "Caption",
        "props": { "tone": "muted", "text": { "$item": "interval_label" } }
      },
      "nextCell": {
        "type": "Stack",
        "props": { "gap": "xs", "align": "end" },
        "children": ["nextDateText", "nextRelText"]
      },
      "nextDateText": {
        "type": "Text",
        "props": { "text": { "$item": "next_bill" }, "size": "sm" }
      },
      "nextRelText": {
        "type": "Caption",
        "props": { "text": { "$item": "rel_label" }, "tone": { "$item": "rel_tone" } }
      }
    }
  },
  "status": "published"
}
