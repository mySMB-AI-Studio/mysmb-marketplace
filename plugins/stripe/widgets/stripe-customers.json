{
  "id": "stripe-customers",
  "title": "Stripe Customers",
  "description": "Your most recent Stripe customers as a scannable roster — an initials avatar, the customer's name over their email, the date they joined, and their account balance. Balance is signed the way Stripe signs it: green is credit sitting on the account, amber is an amount that will be added to their next invoice, and a plain figure means they are square. Sort by any of the three columns, and click a row to open that customer in the Stripe dashboard.",
  "category": "payments",
  "tags": ["stripe", "customers", "billing", "contacts"],
  "keywords": ["customers", "stripe", "billing", "email", "contacts", "clients", "balance", "credit", "owed"],
  "connectorsUsed": ["stripe"],
  "popularity": 0,
  "branding": { "color": "#635bff" },
  "brandColor": "#635bff",
  "sizing": {
    "preferred": { "colSpan": 5, "rowSpan": 6 },
    "min": { "colSpan": 4, "rowSpan": 4 },
    "max": { "colSpan": 8, "rowSpan": 10 }
  },
  "dataProvider": {
    "mcp": "stripe",
    "tool": "list_customers",
    "params": { "limit": 20 }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": ["header", "headerDivider", "body", "footerDivider", "footer"],
        "watch": {
          "/stripe/list_customers/data": [
            {
              "action": "setState",
              "params": { "statePath": "/ui/sortKey", "value": "created|desc" }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/rows",
                "value": {
                  "$computed": "stripe_flatten_customers",
                  "args": {
                    "value": { "$state": "/stripe/list_customers/data" },
                    "key": "created|desc"
                  }
                }
              }
            }
          ],
          "/ui/sortKey": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/rows",
                "value": {
                  "$computed": "stripe_flatten_customers",
                  "args": {
                    "value": { "$state": "/stripe/list_customers/data" },
                    "key": { "$state": "/ui/sortKey" }
                  }
                }
              }
            }
          ]
        }
      },

      "header": {
        "type": "Header",
        "props": {},
        "children": ["titleGroup"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "start" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "Users", "tone": "brand", "size": "sm" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["title", "eyebrow"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Stripe Customers", "level": "h2" }
      },
      "eyebrow": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "Stripe · {n} Recent",
              "n": {
                "$computed": "count",
                "args": { "value": { "$state": "/stripe/list_customers/data" } }
              }
            }
          }
        }
      },
      "headerDivider": { "type": "Divider", "props": {} },

      "body": {
        "type": "Body",
        "props": {},
        "children": ["loading", "empty", "columnHeaders", "list"]
      },

      "loading": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["sk1", "sk2", "sk3", "sk4", "sk5"],
        "visible": { "$state": "/_loading/stripe.list_customers" }
      },
      "sk1": { "type": "Skeleton", "props": { "height": "2.75rem", "rounded": "md" } },
      "sk2": { "type": "Skeleton", "props": { "height": "2.75rem", "rounded": "md" } },
      "sk3": { "type": "Skeleton", "props": { "height": "2.75rem", "rounded": "md" } },
      "sk4": { "type": "Skeleton", "props": { "height": "2.75rem", "rounded": "md" } },
      "sk5": { "type": "Skeleton", "props": { "height": "2.75rem", "rounded": "md" } },

      "empty": {
        "type": "Empty",
        "props": { "message": "No customers found in Stripe." },
        "visible": {
          "$and": [
            { "$state": "/_loading/stripe.list_customers", "not": true },
            { "$state": "/stripe/list_customers/data/0", "not": true }
          ]
        }
      },

      "columnHeaders": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center",
          "hover": true,
          "template": "2rem minmax(0, 1fr) 7rem 6rem"
        },
        "children": ["colAvatar", "colCustomer", "colJoined", "colBalance"],
        "visible": {
          "$and": [
            { "$state": "/_loading/stripe.list_customers", "not": true },
            { "$state": "/stripe/list_customers/data/0" }
          ]
        }
      },
      "colAvatar": { "type": "Eyebrow", "props": { "text": "" } },
      "colCustomer": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["colCustomerLabel", "sortCustomerBtn"]
      },
      "colCustomerLabel": { "type": "Eyebrow", "props": { "text": "Customer" } },
      "sortCustomerBtn": {
        "type": "IconButton",
        "props": { "icon": "ChevronsUpDown", "size": "sm", "variant": "ghost", "ariaLabel": "Sort by customer" },
        "on": {
          "click": {
            "action": "setState",
            "params": {
              "statePath": "/ui/sortKey",
              "value": {
                "$computed": "stripe_set_sort_field",
                "args": { "current": { "$state": "/ui/sortKey" }, "field": "name" }
              }
            }
          }
        }
      },
      "colJoined": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["colJoinedLabel", "sortJoinedBtn"]
      },
      "colJoinedLabel": { "type": "Eyebrow", "props": { "text": "Joined" } },
      "sortJoinedBtn": {
        "type": "IconButton",
        "props": { "icon": "ChevronsUpDown", "size": "sm", "variant": "ghost", "ariaLabel": "Sort by date joined" },
        "on": {
          "click": {
            "action": "setState",
            "params": {
              "statePath": "/ui/sortKey",
              "value": {
                "$computed": "stripe_set_sort_field",
                "args": { "current": { "$state": "/ui/sortKey" }, "field": "created" }
              }
            }
          }
        }
      },
      "colBalance": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center", "justify": "end" },
        "children": ["colBalanceLabel", "sortBalanceBtn"]
      },
      "colBalanceLabel": { "type": "Eyebrow", "props": { "text": "Balance" } },
      "sortBalanceBtn": {
        "type": "IconButton",
        "props": { "icon": "ChevronsUpDown", "size": "sm", "variant": "ghost", "ariaLabel": "Sort by balance" },
        "on": {
          "click": {
            "action": "setState",
            "params": {
              "statePath": "/ui/sortKey",
              "value": {
                "$computed": "stripe_set_sort_field",
                "args": { "current": { "$state": "/ui/sortKey" }, "field": "balance" }
              }
            }
          }
        }
      },

      "list": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["row"],
        "repeat": { "statePath": "/ui/rows", "key": "id" },
        "visible": {
          "$and": [
            { "$state": "/_loading/stripe.list_customers", "not": true },
            { "$state": "/stripe/list_customers/data/0" }
          ]
        }
      },
      "row": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center",
          "hover": true,
          "clickable": true,
          "template": "2rem minmax(0, 1fr) 7rem 6rem"
        },
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "url": {
                "$computed": "stripe_build_customer_url",
                "args": {
                  "customer_id": { "$item": "id" },
                  "livemode": { "$item": "livemode" },
                  "platform_id": { "$state": "/stripe/list_customers/platform_account_id" },
                  "connected_id": { "$state": "/stripe/list_customers/connected_account_id" }
                }
              }
            }
          }
        },
        "children": ["rowAvatar", "identity", "joinedCell", "balanceCell"]
      },
      "rowAvatar": {
        "type": "Avatar",
        "props": { "initials": { "$item": "initials" }, "tone": "brand", "size": "md" }
      },
      "identity": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["nameText", "emailText"]
      },
      "nameText": {
        "type": "Text",
        "props": { "text": { "$item": "name" }, "size": "sm", "weight": "medium", "truncate": true }
      },
      "emailText": {
        "type": "Text",
        "props": { "text": { "$item": "email" }, "tone": "muted", "truncate": true }
      },
      "joinedCell": {
        "type": "Caption",
        "props": { "text": { "$item": "created_label" } }
      },
      "balanceCell": {
        "type": "Row",
        "props": { "justify": "end" },
        "children": ["balanceText"]
      },
      "balanceText": {
        "type": "Text",
        "props": {
          "text": { "$item": "balance_label" },
          "size": "sm",
          "weight": "medium",
          "tone": { "$item": "balance_tone" }
        }
      },

      "footerDivider": {
        "type": "Divider",
        "props": {},
        "visible": {
          "$and": [
            { "$state": "/_loading/stripe.list_customers", "not": true },
            { "$state": "/stripe/list_customers/data/0" }
          ]
        }
      },
      "footer": {
        "type": "Caption",
        "props": {
          "tone": "muted",
          "text": "Click a customer to open them in Stripe. Balance: credit in green, amount owed in amber."
        },
        "visible": {
          "$and": [
            { "$state": "/_loading/stripe.list_customers", "not": true },
            { "$state": "/stripe/list_customers/data/0" }
          ]
        }
      }
    }
  }
}
