{
  "id": "stripe-customers",
  "title": "Stripe Customers",
  "description": "Recent customers in your Stripe account — name, email, and sign-up date.",
  "category": "payments",
  "tags": ["stripe", "customers", "billing", "contacts"],
  "keywords": ["customers", "stripe", "billing", "email", "contacts", "clients"],
  "connectorsUsed": ["stripe"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 5, "rowSpan": 4 },
    "min": { "colSpan": 4, "rowSpan": 3 },
    "max": { "colSpan": 8, "rowSpan": 8 }
  },
  "dataProvider": {
    "mcp": "stripe",
    "tool": "list_customers",
    "params": { "limit": 20 }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "children": ["header", "body"]
      },
      "header": {
        "type": "Header",
        "children": ["titleGroup"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "start" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "Users", "tone": "accent", "size": "sm" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "count"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Stripe Customers", "level": "h2" }
      },
      "count": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{n} recent",
              "n": {
                "$computed": "count",
                "args": { "value": { "$state": "/stripe/list_customers/data" } }
              }
            }
          }
        }
      },
      "body": {
        "type": "Body",
        "children": ["loading", "empty", "columnHeaders", "list"]
      },
      "loading": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["sk1", "sk2", "sk3", "sk4"],
        "visible": { "$state": "/_loading/stripe.list_customers" }
      },
      "sk1": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "sk2": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "sk3": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "sk4": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "empty": {
        "type": "Empty",
        "props": { "message": "No customers found." },
        "visible": {
          "$and": [
            { "$state": "/_loading/stripe.list_customers", "not": true },
            { "$state": "/stripe/list_customers/data/0", "not": true }
          ]
        }
      },
      "columnHeaders": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "template": "minmax(0, 1fr) 7rem 6rem"
        },
        "children": ["headerCustomer", "headerCreated", "headerSpend"],
        "visible": {
          "$and": [
            { "$state": "/_loading/stripe.list_customers", "not": true },
            { "$state": "/stripe/list_customers/data/0" }
          ]
        }
      },
      "headerCustomer": {
        "type": "Eyebrow",
        "props": { "text": "Customer" }
      },
      "headerCreated": {
        "type": "Eyebrow",
        "props": { "text": "Created" }
      },
      "headerSpend": {
        "type": "Eyebrow",
        "props": { "text": "Balance" }
      },
      "list": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["row"],
        "repeat": {
          "statePath": "/stripe/list_customers/data",
          "key": "id"
        },
        "visible": { "$state": "/_loading/stripe.list_customers", "not": true }
      },
      "row": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center",
          "hover": true,
          "template": "minmax(0, 1fr) 7rem 6rem"
        },
        "children": ["identity", "createdDate", "balanceText"]
      },
      "identity": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["nameText", "emailText"]
      },
      "nameText": {
        "type": "Text",
        "props": {
          "text": { "$item": "name" },
          "size": "sm",
          "weight": "medium",
          "truncate": true
        }
      },
      "emailText": {
        "type": "Caption",
        "props": {
          "text": { "$item": "email" },
          "truncate": true
        }
      },
      "createdDate": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "stripe_format_stripe_date",
            "args": { "value": { "$item": "created" } }
          }
        }
      },
      "balanceText": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "stripe_format_currency",
            "args": {
              "amount": { "$item": "balance" },
              "currency": { "$item": "currency" }
            }
          }
        }
      }
    }
  }
}
