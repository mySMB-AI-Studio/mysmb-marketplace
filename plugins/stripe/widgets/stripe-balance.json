{
  "id": "stripe-balance",
  "title": "Stripe Balance",
  "description": "Available and pending balance in your Stripe account.",
  "category": "payments",
  "tags": ["stripe", "balance", "payments", "finance"],
  "keywords": ["balance", "available", "pending", "stripe", "funds", "payout"],
  "connectorsUsed": ["stripe"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 4, "rowSpan": 3 },
    "min": { "colSpan": 3, "rowSpan": 2 },
    "max": { "colSpan": 6, "rowSpan": 4 }
  },
  "dataProvider": {
    "mcp": "stripe",
    "tool": "get_balance",
    "params": {}
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": ["header", "body"]
      },
      "header": {
        "type": "Header",
        "props": {},
        "children": ["titleGroup"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "start" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "Wallet", "tone": "success", "size": "sm" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "subtitle"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Stripe Balance", "level": "h2" }
      },
      "subtitle": {
        "type": "Eyebrow",
        "props": { "text": "Available & Pending" }
      },
      "body": {
        "type": "Body",
        "props": {},
        "children": ["loading", "empty", "balanceGrid"]
      },
      "loading": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["sk1", "sk2"],
        "visible": { "$state": "/_loading/stripe.get_balance" }
      },
      "sk1": {
        "type": "Skeleton",
        "props": { "height": "4rem", "rounded": "md" }
      },
      "sk2": {
        "type": "Skeleton",
        "props": { "height": "4rem", "rounded": "md" }
      },
      "empty": {
        "type": "Empty",
        "props": { "message": "No balance data available." },
        "visible": {
          "$and": [
            { "$state": "/_loading/stripe.get_balance", "not": true },
            { "$state": "/stripe/get_balance/available/0", "not": true }
          ]
        }
      },
      "balanceGrid": {
        "type": "Grid",
        "props": { "cols": 2, "gap": "md" },
        "children": ["availableSection", "pendingSection"],
        "visible": { "$state": "/_loading/stripe.get_balance", "not": true }
      },
      "availableSection": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["availableLabel", "availableList"]
      },
      "availableLabel": {
        "type": "Eyebrow",
        "props": { "text": "Available" }
      },
      "availableList": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["availableRow"],
        "repeat": {
          "statePath": "/stripe/get_balance/available",
          "key": "currency"
        }
      },
      "availableRow": {
        "type": "Stat",
        "props": {
          "value": {
            "$computed": "stripe_format_currency",
            "args": {
              "amount": { "$item": "amount" },
              "currency": { "$item": "currency" }
            }
          },
          "tone": "success",
          "size": "sm"
        }
      },
      "pendingSection": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["pendingLabel", "pendingList"]
      },
      "pendingLabel": {
        "type": "Eyebrow",
        "props": { "text": "Pending" }
      },
      "pendingList": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["pendingRow"],
        "repeat": {
          "statePath": "/stripe/get_balance/pending",
          "key": "currency"
        }
      },
      "pendingRow": {
        "type": "Stat",
        "props": {
          "value": {
            "$computed": "stripe_format_currency",
            "args": {
              "amount": { "$item": "amount" },
              "currency": { "$item": "currency" }
            }
          },
          "tone": "muted",
          "size": "sm"
        }
      }
    }
  }
}
