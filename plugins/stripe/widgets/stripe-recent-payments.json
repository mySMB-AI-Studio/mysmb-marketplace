{
  "id": "stripe-recent-payments",
  "title": "Recent Payments",
  "description": "Your most recent Stripe payment attempts, with the outcome summed up first — what was collected and at what success rate, what has not been collected yet, and what was cancelled. Below that, one row per attempt showing the customer and when they tried, the amount, the card used, and the precise Stripe status. The three figures cover the payments shown, so a run of failed attempts against one customer is obvious at a glance.",
  "category": "payments",
  "tags": ["stripe", "payments", "transactions", "billing"],
  "keywords": ["payments", "transactions", "stripe", "succeeded", "failed", "cancelled", "incomplete", "processing", "recent", "success rate"],
  "connectorsUsed": ["stripe"],
  "popularity": 0,
  "branding": { "color": "#635bff" },
  "brandColor": "#635bff",
  "sizing": {
    "preferred": { "colSpan": 6, "rowSpan": 8 },
    "min": { "colSpan": 5, "rowSpan": 5 },
    "max": { "colSpan": 10, "rowSpan": 12 }
  },
  "dataProvider": {
    "mcp": "stripe",
    "tool": "list_payments",
    "params": { "limit": 20 }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": ["header", "headerDivider", "body", "footerDivider", "footer"],
        "watch": {
          "/stripe/list_payments/data": [
            {
              "action": "setState",
              "params": { "statePath": "/ui/sortKey", "value": "customer_name|asc" }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/pay",
                "value": {
                  "$computed": "stripe_payment_board",
                  "args": {
                    "value": { "$state": "/stripe/list_payments/data" },
                    "key": "customer_name|asc"
                  }
                }
              }
            }
          ],
          "/ui/sortKey": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/pay",
                "value": {
                  "$computed": "stripe_payment_board",
                  "args": {
                    "value": { "$state": "/stripe/list_payments/data" },
                    "key": { "$state": "/ui/sortKey" }
                  }
                }
              }
            }
          ]
        }
      },

      "header": {
        "type": "Header",
        "props": {},
        "children": ["titleGroup"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "start" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "CreditCard", "tone": "brand", "size": "sm" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["title", "eyebrow"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Recent Payments", "level": "h2" }
      },
      "eyebrow": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "STRIPE · {n} RECENT",
              "n": {
                "$computed": "count",
                "args": { "value": { "$state": "/stripe/list_payments/data" } }
              }
            }
          }
        }
      },
      "headerDivider": { "type": "Divider", "props": {} },

      "body": {
        "type": "Body",
        "props": {},
        "children": ["loading", "empty", "summary", "columnHeaders", "list"]
      },

      "loading": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["skSummary", "sk1", "sk2", "sk3", "sk4"],
        "visible": { "$state": "/_loading/stripe.list_payments" }
      },
      "skSummary": { "type": "Skeleton", "props": { "height": "5rem",   "rounded": "md" } },
      "sk1":       { "type": "Skeleton", "props": { "height": "2.75rem", "rounded": "md" } },
      "sk2":       { "type": "Skeleton", "props": { "height": "2.75rem", "rounded": "md" } },
      "sk3":       { "type": "Skeleton", "props": { "height": "2.75rem", "rounded": "md" } },
      "sk4":       { "type": "Skeleton", "props": { "height": "2.75rem", "rounded": "md" } },

      "empty": {
        "type": "Empty",
        "props": { "message": "No payments found in Stripe." },
        "visible": {
          "$and": [
            { "$state": "/_loading/stripe.list_payments", "not": true },
            { "$state": "/stripe/list_payments/data/0", "not": true }
          ]
        }
      },

      "summary": {
        "type": "Grid",
        "props": { "cols": 3, "gap": "sm" },
        "children": ["sumSucceeded", "sumPending", "sumCancelled"],
        "visible": {
          "$and": [
            { "$state": "/_loading/stripe.list_payments", "not": true },
            { "$state": "/stripe/list_payments/data/0" }
          ]
        }
      },

      "sumSucceeded": {
        "type": "Section",
        "props": { "variant": "muted" },
        "children": ["okStack"]
      },
      "okStack": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["okHead", "okValue", "okCaption"]
      },
      "okHead": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["okDot", "okLabel"]
      },
      "okDot": { "type": "Dot", "props": { "tone": { "$state": "/ui/pay/succeededTone" }, "size": "sm" } },
      "okLabel": { "type": "Eyebrow", "props": { "text": "SUCCEEDED" } },
      "okValue": {
        "type": "Stat",
        "props": { "size": "sm", "value": { "$state": "/ui/pay/succeededTotal" } }
      },
      "okCaption": {
        "type": "Caption",
        "props": {
          "tone": "muted",
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{n} payments · {r}% success rate",
              "n": { "$state": "/ui/pay/succeededCount" },
              "r": { "$state": "/ui/pay/successRate" }
            }
          }
        }
      },

      "sumPending": {
        "type": "Section",
        "props": { "variant": "muted" },
        "children": ["pendStack"]
      },
      "pendStack": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["pendHead", "pendValue", "pendCaption"]
      },
      "pendHead": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["pendDot", "pendLabel"]
      },
      "pendDot": { "type": "Dot", "props": { "tone": { "$state": "/ui/pay/pendingTone" }, "size": "sm" } },
      "pendLabel": { "type": "Eyebrow", "props": { "text": "NOT COLLECTED" } },
      "pendValue": {
        "type": "Stat",
        "props": { "size": "sm", "value": { "$state": "/ui/pay/pendingCount" } }
      },
      "pendCaption": {
        "type": "Caption",
        "props": {
          "tone": "muted",
          "text": {
            "$computed": "fmt",
            "args": { "pattern": "{v} not yet collected", "v": { "$state": "/ui/pay/pendingTotal" } }
          }
        }
      },

      "sumCancelled": {
        "type": "Section",
        "props": { "variant": "muted" },
        "children": ["canStack"]
      },
      "canStack": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["canHead", "canValue", "canCaption"]
      },
      "canHead": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["canDot", "canLabel"]
      },
      "canDot": { "type": "Dot", "props": { "tone": { "$state": "/ui/pay/cancelledTone" }, "size": "sm" } },
      "canLabel": { "type": "Eyebrow", "props": { "text": "CANCELLED" } },
      "canValue": {
        "type": "Stat",
        "props": { "size": "sm", "value": { "$state": "/ui/pay/cancelledCount" } }
      },
      "canCaption": {
        "type": "Caption",
        "props": {
          "tone": "muted",
          "text": {
            "$computed": "fmt",
            "args": { "pattern": "{v} lost", "v": { "$state": "/ui/pay/cancelledTotal" } }
          }
        }
      },

      "columnHeaders": {
        "type": "Row",
        "props": {
          "gap": "md",
          "align": "center",
          "hover": true,
          "template": "minmax(0, 1fr) 5rem 8rem 7rem"
        },
        "children": ["colCustomer", "colAmount", "colMethod", "colStatus"],
        "visible": {
          "$and": [
            { "$state": "/_loading/stripe.list_payments", "not": true },
            { "$state": "/stripe/list_payments/data/0" }
          ]
        }
      },
      "colCustomer": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["colCustomerLabel", "sortCustomerBtn"]
      },
      "colCustomerLabel": { "type": "Eyebrow", "props": { "text": "CUSTOMER" } },
      "sortCustomerBtn": {
        "type": "IconButton",
        "props": { "icon": "ChevronsUpDown", "size": "sm", "variant": "ghost", "ariaLabel": "Sort by customer" },
        "on": {
          "click": {
            "action": "setState",
            "params": {
              "statePath": "/ui/sortKey",
              "value": {
                "$computed": "stripe_set_sort_field",
                "args": { "current": { "$state": "/ui/sortKey" }, "field": "customer_name" }
              }
            }
          }
        }
      },
      "colAmount": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center", "justify": "end" },
        "children": ["colAmountLabel", "sortAmountBtn"]
      },
      "colAmountLabel": { "type": "Eyebrow", "props": { "text": "AMOUNT" } },
      "sortAmountBtn": {
        "type": "IconButton",
        "props": { "icon": "ChevronsUpDown", "size": "sm", "variant": "ghost", "ariaLabel": "Sort by amount" },
        "on": {
          "click": {
            "action": "setState",
            "params": {
              "statePath": "/ui/sortKey",
              "value": {
                "$computed": "stripe_set_sort_field",
                "args": { "current": { "$state": "/ui/sortKey" }, "field": "amount_cents" }
              }
            }
          }
        }
      },
      "colMethod": { "type": "Eyebrow", "props": { "text": "METHOD" } },
      "colStatus": { "type": "Eyebrow", "props": { "text": "STATUS" } },

      "list": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["payRow"],
        "repeat": { "statePath": "/ui/pay/rows", "key": "id" },
        "visible": {
          "$and": [
            { "$state": "/_loading/stripe.list_payments", "not": true },
            { "$state": "/stripe/list_payments/data/0" }
          ]
        }
      },
      "payRow": {
        "type": "Row",
        "props": {
          "gap": "md",
          "align": "center",
          "hover": true,
          "template": "minmax(0, 1fr) 5rem 8rem 7rem"
        },
        "children": ["identity", "amountCell", "methodCell", "statusCellWrap"]
      },
      "identity": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["customerName", "createdAt"]
      },
      "customerName": {
        "type": "Text",
        "props": { "text": { "$item": "customer_name" }, "size": "sm", "weight": "medium", "truncate": true }
      },
      "createdAt": {
        "type": "Caption",
        "props": { "text": { "$item": "created_at" }, "tone": "muted" }
      },
      "amountCell": {
        "type": "Row",
        "props": { "justify": "end" },
        "children": ["amountText"]
      },
      "amountText": {
        "type": "Text",
        "props": { "text": { "$item": "amount" }, "size": "sm", "weight": "medium" }
      },
      "methodCell": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["methodIcon", "methodText"]
      },
      "methodIcon": {
        "type": "Icon",
        "props": { "name": "CreditCard", "tone": "muted", "size": "sm" }
      },
      "methodText": {
        "type": "Caption",
        "props": { "text": { "$item": "method" }, "tone": { "$item": "method_tone" } }
      },
      "statusCellWrap": {
        "type": "Row",
        "props": { "justify": "start" },
        "children": ["statusBadge"]
      },
      "statusBadge": {
        "type": "Badge",
        "props": {
          "text": { "$item": "status_label" },
          "tone": { "$item": "status_tone" },
          "variant": "soft"
        }
      },

      "footerDivider": {
        "type": "Divider",
        "props": {},
        "visible": {
          "$and": [
            { "$state": "/_loading/stripe.list_payments", "not": true },
            { "$state": "/stripe/list_payments/data/0" }
          ]
        }
      },
      "footer": {
        "type": "Caption",
        "props": {
          "tone": "muted",
          "text": "Most recent payment attempts. Summary covers the payments shown."
        },
        "visible": {
          "$and": [
            { "$state": "/_loading/stripe.list_payments", "not": true },
            { "$state": "/stripe/list_payments/data/0" }
          ]
        }
      }
    }
  }
}
