{
  "id": "stripe-mrr",
  "title": "Stripe MRR",
  "description": "Active subscription count and per-subscription breakdown — customer, price interval, and period end.",
  "category": "payments",
  "tags": ["stripe", "subscriptions", "mrr", "billing", "recurring", "revenue"],
  "keywords": ["mrr", "subscriptions", "recurring", "stripe", "active", "monthly", "revenue"],
  "connectorsUsed": ["stripe"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 5, "rowSpan": 6 },
    "min": { "colSpan": 4, "rowSpan": 5 },
    "max": { "colSpan": 10, "rowSpan": 12 }
  },
  "dataProvider": {
    "mcp": "stripe",
    "tool": "list_subscriptions",
    "params": { "status": "active", "limit": 100 }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": ["header", "heroRow", "divider", "body"]
      },
      "header": {
        "type": "Header",
        "props": {},
        "children": ["titleGroup"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "start" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "RefreshCw", "tone": "success", "size": "sm" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "eyebrow"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "MRR Overview", "level": "h2" }
      },
      "eyebrow": {
        "type": "Eyebrow",
        "props": { "text": "Active Subscriptions" }
      },
      "heroRow": {
        "type": "Row",
        "props": { "gap": "xl", "align": "center" },
        "children": ["heroCount"],
        "visible": { "$state": "/_loading/stripe.list_subscriptions", "not": true }
      },
      "heroCount": {
        "type": "Stack",
        "props": { "gap": "none", "align": "center" },
        "children": ["heroCountIcon", "heroCountValue", "heroCountLabel"]
      },
      "heroCountIcon": {
        "type": "Icon",
        "props": { "name": "Users", "tone": "success", "size": "md" }
      },
      "heroCountValue": {
        "type": "Stat",
        "props": {
          "value": {
            "$computed": "count",
            "args": { "value": { "$state": "/stripe/list_subscriptions/data" } }
          },
          "tone": "success"
        }
      },
      "heroCountLabel": {
        "type": "Caption",
        "props": { "text": "Active Subscriptions" }
      },
      "divider": {
        "type": "Divider",
        "props": {}
      },
      "body": {
        "type": "Body",
        "props": {},
        "children": ["loading", "empty", "list"]
      },
      "loading": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["sk1", "sk2", "sk3", "sk4"],
        "visible": { "$state": "/_loading/stripe.list_subscriptions" }
      },
      "sk1": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "sk2": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "sk3": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "sk4": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "empty": {
        "type": "Empty",
        "props": { "message": "No active subscriptions found." },
        "visible": {
          "$and": [
            { "$state": "/_loading/stripe.list_subscriptions", "not": true },
            { "$state": "/stripe/list_subscriptions/data/0", "not": true }
          ]
        }
      },
      "list": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["subRow"],
        "repeat": {
          "statePath": "/stripe/list_subscriptions/data",
          "key": "id"
        },
        "visible": { "$state": "/_loading/stripe.list_subscriptions", "not": true }
      },
      "subRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center",
          "hover": true,
          "template": "minmax(0, 1fr) 9rem"
        },
        "children": ["subIdentity", "subPeriodEnd"]
      },
      "subIdentity": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["subCustomer", "subId"]
      },
      "subCustomer": {
        "type": "Text",
        "props": {
          "text": { "$item": "customer" },
          "size": "sm",
          "weight": "medium",
          "truncate": true
        }
      },
      "subId": {
        "type": "Caption",
        "props": {
          "text": { "$item": "id" },
          "truncate": true
        }
      },
      "subPeriodEnd": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "stripe_format_stripe_date",
            "args": { "value": { "$item": "current_period_end" } }
          }
        }
      }
    }
  }
}
