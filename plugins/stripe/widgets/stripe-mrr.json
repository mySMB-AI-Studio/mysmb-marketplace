{
  "id": "stripe-mrr",
  "title": "Stripe MRR",
  "description": "Monthly recurring revenue and active subscription breakdown.",
  "category": "payments",
  "tags": [
    "stripe",
    "subscriptions",
    "mrr",
    "billing",
    "recurring",
    "revenue"
  ],
  "keywords": [
    "mrr",
    "subscriptions",
    "recurring",
    "stripe",
    "active",
    "monthly",
    "revenue"
  ],
  "connectorsUsed": [
    "stripe"
  ],
  "popularity": 0,
  "sizing": {
    "preferred": {
      "colSpan": 5,
      "rowSpan": 6
    },
    "min": {
      "colSpan": 4,
      "rowSpan": 5
    },
    "max": {
      "colSpan": 10,
      "rowSpan": 12
    }
  },
  "dataProvider": {
    "mcp": "stripe",
    "tool": "list_subscriptions",
    "params": {
      "status": "active",
      "limit": 100
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": [
          "header",
          "kpiRow",
          "divider",
          "body"
        ],
        "watch": {
          "/stripe/list_subscriptions/data": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/subRows",
                "value": {
                  "$computed": "stripe_flatten_subscriptions",
                  "args": {
                    "value": {
                      "$state": "/stripe/list_subscriptions/data"
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "header": {
        "type": "Header",
        "props": {},
        "children": [
          "titleGroup"
        ]
      },
      "titleGroup": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "start"
        },
        "children": [
          "titleIcon",
          "titleStack"
        ]
      },
      "titleIcon": {
        "type": "Icon",
        "props": {
          "name": "TrendingUp",
          "tone": "success",
          "size": "sm"
        }
      },
      "titleStack": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "children": [
          "title",
          "eyebrow"
        ]
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "MRR overview",
          "level": "h2"
        }
      },
      "eyebrow": {
        "type": "Eyebrow",
        "props": {
          "text": "Stripe"
        }
      },
      "kpiRow": {
        "type": "Grid",
        "props": {
          "cols": 2,
          "gap": "sm"
        },
        "children": [
          "tileMrr",
          "tileSubCount"
        ],
        "visible": {
          "$state": "/_loading/stripe.list_subscriptions",
          "not": true
        }
      },
      "tileMrr": {
        "type": "Section",
        "props": {
          "variant": "muted"
        },
        "children": [
          "stackMrr"
        ]
      },
      "stackMrr": {
        "type": "Stack",
        "props": {
          "gap": "xxs",
          "align": "center"
        },
        "children": [
          "iconMrr",
          "valMrr",
          "lblMrr"
        ]
      },
      "iconMrr": {
        "type": "Icon",
        "props": {
          "name": "TrendingUp",
          "size": "sm",
          "tone": "success"
        }
      },
      "valMrr": {
        "type": "Stat",
        "props": {
          "value": {
            "$computed": "stripe_calc_mrr",
            "args": {
              "value": {
                "$state": "/stripe/list_subscriptions/data"
              }
            }
          },
          "tone": "success"
        }
      },
      "lblMrr": {
        "type": "Caption",
        "props": {
          "text": "Monthly recurring revenue"
        }
      },
      "tileSubCount": {
        "type": "Section",
        "props": {
          "variant": "muted"
        },
        "children": [
          "stackSubCount"
        ]
      },
      "stackSubCount": {
        "type": "Stack",
        "props": {
          "gap": "xxs",
          "align": "center"
        },
        "children": [
          "iconSubCount",
          "valSubCount",
          "lblSubCount"
        ]
      },
      "iconSubCount": {
        "type": "Icon",
        "props": {
          "name": "Users",
          "size": "sm",
          "tone": "muted"
        }
      },
      "valSubCount": {
        "type": "Stat",
        "props": {
          "value": {
            "$computed": "count",
            "args": {
              "value": {
                "$state": "/stripe/list_subscriptions/data"
              }
            }
          },
          "tone": "muted"
        }
      },
      "lblSubCount": {
        "type": "Caption",
        "props": {
          "text": "Active subscriptions"
        }
      },
      "divider": {
        "type": "Divider",
        "props": {}
      },
      "body": {
        "type": "Body",
        "props": {},
        "children": [
          "loading",
          "empty",
          "listHeader",
          "list"
        ]
      },
      "loading": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "sk1",
          "sk2",
          "sk3",
          "sk4"
        ],
        "visible": {
          "$state": "/_loading/stripe.list_subscriptions"
        }
      },
      "sk1": {
        "type": "Skeleton",
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        }
      },
      "sk2": {
        "type": "Skeleton",
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        }
      },
      "sk3": {
        "type": "Skeleton",
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        }
      },
      "sk4": {
        "type": "Skeleton",
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        }
      },
      "empty": {
        "type": "Empty",
        "props": {
          "message": "No active subscriptions found."
        },
        "visible": {
          "$and": [
            {
              "$state": "/_loading/stripe.list_subscriptions",
              "not": true
            },
            {
              "$state": "/stripe/list_subscriptions/data/0",
              "not": true
            }
          ]
        }
      },
      "listHeader": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center",
          "template": "minmax(0, 1fr) 6rem 5rem"
        },
        "children": [
          "hdrSubscriber",
          "hdrAmount",
          "hdrRenews"
        ],
        "visible": {
          "$and": [
            {
              "$state": "/_loading/stripe.list_subscriptions",
              "not": true
            },
            {
              "$state": "/stripe/list_subscriptions/data/0"
            }
          ]
        }
      },
      "hdrSubscriber": {
        "type": "Caption",
        "props": {
          "text": "Subscriber"
        }
      },
      "hdrAmount": {
        "type": "Caption",
        "props": {
          "text": "Amount"
        }
      },
      "hdrRenews": {
        "type": "Caption",
        "props": {
          "text": "Renews"
        }
      },
      "list": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "children": [
          "subRow"
        ],
        "repeat": {
          "statePath": "/ui/subRows",
          "key": "id"
        },
        "visible": {
          "$and": [
            {
              "$state": "/_loading/stripe.list_subscriptions",
              "not": true
            },
            {
              "$state": "/stripe/list_subscriptions/data/0"
            }
          ]
        }
      },
      "subRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center",
          "hover": true,
          "template": "minmax(0, 1fr) 6rem 5rem"
        },
        "children": [
          "subIdentity",
          "subAmount",
          "subRenews"
        ]
      },
      "subIdentity": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "children": [
          "subCustomer",
          "subPlan"
        ]
      },
      "subCustomer": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "customer_name"
          },
          "size": "sm",
          "weight": "medium",
          "truncate": true
        }
      },
      "subPlan": {
        "type": "Caption",
        "props": {
          "text": {
            "$item": "plan_name"
          },
          "truncate": true
        }
      },
      "subAmount": {
        "type": "Caption",
        "props": {
          "text": {
            "$item": "amount"
          }
        }
      },
      "subRenews": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "stripe_format_stripe_date_short",
            "args": {
              "value": {
                "$item": "current_period_end"
              }
            }
          }
        }
      }
    }
  }
}
