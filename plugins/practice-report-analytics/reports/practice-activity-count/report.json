{
  "title": "Practice Activity Count",
  "description": "Practice Report Analytics PRA-08: Transaction counters across sales, purchases, banking, journals and payroll (MYOB only), per client, ranked by total activity. One row per client across Xero and MYOB (QuickBooks is one company per connection, so it is not consolidated). Live, validated; mySMB branding by default.",
  "tags": [
    "practice-report-analytics",
    "PRA-08",
    "activity-count"
  ],
  "fileName": "practice-activity-count.html",
  "dataBindings": {
    "inputs": [
      {
        "name": "from_date",
        "label": "From",
        "type": "date",
        "default": "2026-07-01"
      },
      {
        "name": "to_date",
        "label": "To",
        "type": "date",
        "default": "today"
      },
      {
        "name": "clients",
        "label": "Clients",
        "type": "string",
        "maxLength": 500,
        "default": ""
      },
      {
        "name": "org",
        "label": "Xero organisation (set by the report, one per call: leave empty)",
        "type": "string",
        "maxLength": 64,
        "default": ""
      },
      {
        "name": "where",
        "label": "Xero filter (set by the report: leave empty)",
        "type": "string",
        "maxLength": 500,
        "default": ""
      }
    ],
    "bindings": [
      {
        "id": "xero_connections",
        "tool": {
          "mcp": "xero-api",
          "name": "list_connections"
        },
        "params": {}
      },
      {
        "id": "x_inv",
        "tool": {
          "mcp": "xero-api",
          "name": "list_invoices"
        },
        "params": {
          "xero_tenant_id": {
            "kind": "input",
            "input": "org"
          },
          "where": {
            "kind": "input",
            "input": "where"
          },
          "page": {
            "kind": "static",
            "value": 1
          }
        }
      },
      {
        "id": "x_bt",
        "tool": {
          "mcp": "xero-api",
          "name": "list_bank_transactions"
        },
        "params": {
          "xero_tenant_id": {
            "kind": "input",
            "input": "org"
          },
          "where": {
            "kind": "input",
            "input": "where"
          },
          "page": {
            "kind": "static",
            "value": 1
          }
        }
      },
      {
        "id": "x_mj",
        "tool": {
          "mcp": "xero-api",
          "name": "list_manual_journals"
        },
        "params": {
          "xero_tenant_id": {
            "kind": "input",
            "input": "org"
          },
          "where": {
            "kind": "input",
            "input": "where"
          },
          "page": {
            "kind": "static",
            "value": 1
          }
        }
      },
      {
        "id": "myob",
        "tool": {
          "mcp": "myob-accounting",
          "name": "get_practice_activity_count"
        },
        "params": {
          "from_date": {
            "kind": "input",
            "input": "from_date"
          },
          "to_date": {
            "kind": "input",
            "input": "to_date"
          },
          "clients": {
            "kind": "input",
            "input": "clients"
          }
        }
      }
    ]
  }
}
