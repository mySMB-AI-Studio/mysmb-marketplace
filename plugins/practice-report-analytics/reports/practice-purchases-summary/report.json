{
  "title": "Practice Purchases Summary Metrics",
  "description": "Practice Report Analytics PRA-03: Outstanding and overdue bills, payment days (DPO) and supplier counts, per client. One row per client across Xero and MYOB (QuickBooks is one company per connection, so it is not consolidated). Live, validated; mySMB branding by default.",
  "tags": [
    "practice-report-analytics",
    "PRA-03",
    "purchases-summary"
  ],
  "fileName": "practice-purchases-summary.html",
  "dataBindings": {
    "inputs": [
      {
        "name": "from_date",
        "label": "From",
        "type": "date",
        "default": "2026-07-01"
      },
      {
        "name": "to_date",
        "label": "To",
        "type": "date",
        "default": "today"
      },
      {
        "name": "clients",
        "label": "Clients",
        "type": "string",
        "maxLength": 500,
        "default": ""
      },
      {
        "name": "org",
        "label": "Xero organisation (set by the report, one per call: leave empty)",
        "type": "string",
        "maxLength": 64,
        "default": ""
      }
    ],
    "bindings": [
      {
        "id": "xero_connections",
        "tool": {
          "mcp": "xero-api",
          "name": "list_connections"
        },
        "params": {}
      },
      {
        "id": "x_open",
        "tool": {
          "mcp": "xero-api",
          "name": "list_invoices"
        },
        "params": {
          "xero_tenant_id": {
            "kind": "input",
            "input": "org"
          },
          "where": {
            "kind": "static",
            "value": "Type==\"ACCPAY\" AND Status==\"AUTHORISED\""
          }
        }
      },
      {
        "id": "x_bank",
        "tool": {
          "mcp": "xero-api",
          "name": "get_bank_summary"
        },
        "params": {
          "xero_tenant_id": {
            "kind": "input",
            "input": "org"
          },
          "fromDate": {
            "kind": "input",
            "input": "from_date"
          },
          "toDate": {
            "kind": "input",
            "input": "to_date"
          }
        }
      },
      {
        "id": "x_pl",
        "tool": {
          "mcp": "xero-api",
          "name": "get_profit_and_loss"
        },
        "params": {
          "xero_tenant_id": {
            "kind": "input",
            "input": "org"
          },
          "fromDate": {
            "kind": "input",
            "input": "from_date"
          },
          "toDate": {
            "kind": "input",
            "input": "to_date"
          }
        }
      },
      {
        "id": "myob",
        "tool": {
          "mcp": "myob-accounting",
          "name": "get_practice_purchases_summary"
        },
        "params": {
          "from_date": {
            "kind": "input",
            "input": "from_date"
          },
          "to_date": {
            "kind": "input",
            "input": "to_date"
          },
          "clients": {
            "kind": "input",
            "input": "clients"
          }
        }
      }
    ]
  }
}
