{
  "title": "Practice Banking Summary Metrics",
  "description": "Practice Report Analytics PRA-05: Cash in, cash out and net movement across every bank account, per client. One row per client across Xero and MYOB (QuickBooks is one company per connection, so it is not consolidated). Live, validated; mySMB branding by default.",
  "tags": [
    "practice-report-analytics",
    "PRA-05",
    "banking-summary"
  ],
  "fileName": "practice-banking-summary.html",
  "dataBindings": {
    "inputs": [
      {
        "name": "from_date",
        "label": "From",
        "type": "date",
        "default": "2026-07-01"
      },
      {
        "name": "to_date",
        "label": "To",
        "type": "date",
        "default": "today"
      },
      {
        "name": "clients",
        "label": "Clients",
        "type": "string",
        "maxLength": 500,
        "default": ""
      },
      {
        "name": "org",
        "label": "Xero organisation (set by the report, one per call: leave empty)",
        "type": "string",
        "maxLength": 64,
        "default": ""
      },
      {
        "name": "where",
        "label": "Xero filter (set by the report: leave empty)",
        "type": "string",
        "maxLength": 500,
        "default": ""
      },
      {
        "name": "page",
        "label": "Page (set by the report: leave at 1)",
        "type": "number",
        "min": 1,
        "max": 100,
        "default": 1
      }
    ],
    "bindings": [
      {
        "id": "xero_connections",
        "tool": {
          "mcp": "xero-api",
          "name": "list_connections"
        },
        "params": {}
      },
      {
        "id": "x_bank",
        "tool": {
          "mcp": "xero-api",
          "name": "get_bank_summary"
        },
        "params": {
          "xero_tenant_id": {
            "kind": "input",
            "input": "org"
          },
          "fromDate": {
            "kind": "input",
            "input": "from_date"
          },
          "toDate": {
            "kind": "input",
            "input": "to_date"
          }
        }
      },
      {
        "id": "x_unrec",
        "tool": {
          "mcp": "xero-api",
          "name": "list_bank_transactions"
        },
        "params": {
          "xero_tenant_id": {
            "kind": "input",
            "input": "org"
          },
          "where": {
            "kind": "input",
            "input": "where"
          },
          "page": {
            "kind": "input",
            "input": "page"
          }
        }
      },
      {
        "id": "myob",
        "tool": {
          "mcp": "myob-accounting",
          "name": "get_practice_banking_summary"
        },
        "params": {
          "from_date": {
            "kind": "input",
            "input": "from_date"
          },
          "to_date": {
            "kind": "input",
            "input": "to_date"
          },
          "clients": {
            "kind": "input",
            "input": "clients"
          }
        }
      }
    ]
  }
}
