{
  "title": "Practice Banking Summary Metrics",
  "description": "Practice Report Analytics PRA-05: Cash in, cash out and net movement across every bank account, per client. One row per client across Xero, MYOB and QuickBooks. Live, validated; mySMB branding by default.",
  "tags": [
    "practice-report-analytics",
    "PRA-05",
    "banking-summary"
  ],
  "fileName": "practice-banking-summary.html",
  "dataBindings": {
    "inputs": [
      {
        "name": "from_date",
        "label": "From",
        "type": "date",
        "default": "2026-07-01"
      },
      {
        "name": "to_date",
        "label": "To",
        "type": "date",
        "default": "today"
      }
    ],
    "bindings": [
      {
        "id": "xero",
        "tool": {
          "mcp": "xero-accounting",
          "name": "get_practice_banking_summary"
        },
        "params": {
          "from_date": {
            "kind": "input",
            "input": "from_date"
          },
          "to_date": {
            "kind": "input",
            "input": "to_date"
          }
        }
      },
      {
        "id": "myob",
        "tool": {
          "mcp": "myob-accounting",
          "name": "get_practice_banking_summary"
        },
        "params": {
          "from_date": {
            "kind": "input",
            "input": "from_date"
          },
          "to_date": {
            "kind": "input",
            "input": "to_date"
          }
        }
      }
    ]
  }
}
