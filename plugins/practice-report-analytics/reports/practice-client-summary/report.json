{
  "title": "Practice Client Summary Metrics",
  "description": "Practice Report Analytics PRA-01: Counts of contacts, accounts, invoices, bills and employees per client — the practice’s one-page inventory. One row per client across Xero and MYOB (QuickBooks is one company per connection, so it is not consolidated). Live, validated; mySMB branding by default.",
  "tags": [
    "practice-report-analytics",
    "PRA-01",
    "client-summary"
  ],
  "fileName": "practice-client-summary.html",
  "dataBindings": {
    "inputs": [
      {
        "name": "as_at",
        "label": "As at",
        "type": "date",
        "default": "today"
      },
      {
        "name": "clients",
        "label": "Clients",
        "type": "string",
        "maxLength": 500,
        "default": ""
      },
      {
        "name": "org",
        "label": "Xero organisation (set by the report, one per call: leave empty)",
        "type": "string",
        "maxLength": 64,
        "default": ""
      }
    ],
    "bindings": [
      {
        "id": "xero_connections",
        "tool": {
          "mcp": "xero-api",
          "name": "list_connections"
        },
        "params": {}
      },
      {
        "id": "x_contacts",
        "tool": {
          "mcp": "xero-api",
          "name": "list_contacts"
        },
        "params": {
          "xero_tenant_id": {
            "kind": "input",
            "input": "org"
          },
          "page": {
            "kind": "static",
            "value": 1
          },
          "summaryOnly": {
            "kind": "static",
            "value": true
          }
        }
      },
      {
        "id": "x_accounts",
        "tool": {
          "mcp": "xero-api",
          "name": "list_accounts"
        },
        "params": {
          "xero_tenant_id": {
            "kind": "input",
            "input": "org"
          }
        }
      },
      {
        "id": "x_invoices",
        "tool": {
          "mcp": "xero-api",
          "name": "list_invoices"
        },
        "params": {
          "xero_tenant_id": {
            "kind": "input",
            "input": "org"
          },
          "where": {
            "kind": "static",
            "value": "Type==\"ACCREC\""
          },
          "page": {
            "kind": "static",
            "value": 1
          },
          "summaryOnly": {
            "kind": "static",
            "value": true
          }
        }
      },
      {
        "id": "x_bills",
        "tool": {
          "mcp": "xero-api",
          "name": "list_invoices"
        },
        "params": {
          "xero_tenant_id": {
            "kind": "input",
            "input": "org"
          },
          "where": {
            "kind": "static",
            "value": "Type==\"ACCPAY\""
          },
          "page": {
            "kind": "static",
            "value": 1
          },
          "summaryOnly": {
            "kind": "static",
            "value": true
          }
        }
      },
      {
        "id": "x_employees",
        "tool": {
          "mcp": "xero-api",
          "name": "list_employees"
        },
        "params": {
          "xero_tenant_id": {
            "kind": "input",
            "input": "org"
          }
        }
      },
      {
        "id": "myob",
        "tool": {
          "mcp": "myob-accounting",
          "name": "get_practice_client_summary"
        },
        "params": {
          "as_at": {
            "kind": "input",
            "input": "as_at"
          },
          "clients": {
            "kind": "input",
            "input": "clients"
          }
        }
      }
    ]
  }
}
