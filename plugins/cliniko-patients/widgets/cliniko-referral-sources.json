{
  "id": "cliniko-referral-sources",
  "title": "Cliniko — Referral sources",
  "description": "Where your patients come from.",
  "category": "health",
  "tags": [
    "cliniko",
    "patients",
    "marketing",
    "referrals"
  ],
  "keywords": [
    "referral",
    "referral source",
    "marketing",
    "acquisition"
  ],
  "connectorsUsed": [
    "cliniko-patients"
  ],
  "popularity": 20,
  "sizing": {
    "preferred": {
      "colSpan": 6,
      "rowSpan": 6
    },
    "min": {
      "colSpan": 4,
      "rowSpan": 4
    },
    "max": {
      "colSpan": 12,
      "rowSpan": 12
    }
  },
  "dataProvider": {
    "mcp": "cliniko-patients",
    "tool": "list_referral_sources",
    "params": {
      "per_page": 50,
      "sort": "name:asc"
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "header": {
        "type": "Header",
        "props": {},
        "children": [
          "headerRow"
        ]
      },
      "headerRow": {
        "type": "Row",
        "props": {
          "justify": "between",
          "align": "center"
        },
        "children": [
          "titleGroup",
          "refreshBtn"
        ]
      },
      "titleGroup": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center"
        },
        "children": [
          "titleIcon",
          "titleStack"
        ]
      },
      "titleIcon": {
        "type": "Icon",
        "props": {
          "name": "Share2",
          "tone": "accent",
          "size": "sm"
        }
      },
      "titleStack": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "children": [
          "title",
          "count"
        ]
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "Referral sources",
          "level": "h2"
        }
      },
      "count": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{n} total",
              "n": {
                "$state": "/cliniko-patients/list_referral_sources/total_entries"
              }
            }
          }
        }
      },
      "refreshBtn": {
        "type": "IconButton",
        "props": {
          "name": "RefreshCw",
          "size": "sm",
          "ariaLabel": "Refresh"
        },
        "on": {
          "click": {
            "action": "cliniko-patients.list_referral_sources",
            "params": {
              "per_page": 50,
              "sort": "name:asc"
            }
          }
        }
      },
      "body": {
        "type": "Body",
        "props": {},
        "children": [
          "loading",
          "empty",
          "list"
        ]
      },
      "loading": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "children": [
          "lk1",
          "lk2",
          "lk3",
          "lk4"
        ],
        "visible": {
          "$state": "/_loading/cliniko-patients.list_referral_sources"
        }
      },
      "lk1": {
        "type": "Skeleton",
        "props": {
          "height": "3rem",
          "rounded": "md"
        }
      },
      "lk2": {
        "type": "Skeleton",
        "props": {
          "height": "3rem",
          "rounded": "md"
        }
      },
      "lk3": {
        "type": "Skeleton",
        "props": {
          "height": "3rem",
          "rounded": "md"
        }
      },
      "lk4": {
        "type": "Skeleton",
        "props": {
          "height": "3rem",
          "rounded": "md"
        }
      },
      "empty": {
        "type": "Empty",
        "props": {
          "message": "No referral sources yet — these populate as patients record how they found you."
        },
        "visible": {
          "$and": [
            {
              "$state": "/_loading/cliniko-patients.list_referral_sources",
              "not": true
            },
            {
              "$state": "/cliniko-patients/list_referral_sources/referral_sources/0",
              "not": true
            }
          ]
        }
      },
      "list": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "children": [
          "row"
        ],
        "repeat": {
          "statePath": "/cliniko-patients/list_referral_sources/referral_sources",
          "key": "id"
        },
        "visible": {
          "$state": "/_loading/cliniko-patients.list_referral_sources",
          "not": true
        }
      },
      "row": {
        "type": "ListItem",
        "props": {
          "title": {
            "$item": "name"
          },
          "subtitle": {
            "$item": "referral_type"
          }
        }
      },
      "card": {
        "type": "Card",
        "props": {},
        "children": [
          "header",
          "body"
        ]
      }
    }
  },
  "status": "published"
}
