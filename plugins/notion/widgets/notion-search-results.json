{
  "id": "notion-search-results",
  "title": "Recent Notion Content",
  "description": "Recently edited pages and data sources in your Notion workspace — title, type, and last edited time. Click a row to open it in Notion.",
  "category": "productivity",
  "tags": [
    "notion",
    "search",
    "pages",
    "data-sources",
    "knowledge",
    "productivity"
  ],
  "keywords": [
    "notion",
    "search",
    "find",
    "knowledge",
    "pages",
    "databases",
    "wiki"
  ],
  "connectorsUsed": [
    "notion"
  ],
  "popularity": 0,
  "sizing": {
    "preferred": {
      "colSpan": 6,
      "rowSpan": 8
    },
    "min": {
      "colSpan": 4,
      "rowSpan": 6
    },
    "max": {
      "colSpan": 12,
      "rowSpan": 13
    }
  },
  "dataProvider": {
    "mcp": "notion",
    "tool": "search",
    "params": {
      "sort_direction": "descending"
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "children": [
          "header",
          "typeBreakdownSection",
          "colHeader",
          "divider0",
          "body"
        ],
        "watch": {
          "/notion/search/results": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/typeBreakdown",
                "value": {
                  "$computed": "notion_content_type_breakdown",
                  "args": { "results": { "$state": "/notion/search/results" } }
                }
              }
            }
          ]
        }
      },
      "header": {
        "type": "Header",
        "children": [
          "titleRow"
        ]
      },
      "titleRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "start"
        },
        "children": [
          "titleIcon",
          "titleStack"
        ]
      },
      "titleIcon": {
        "type": "Icon",
        "props": {
          "name": "Search",
          "tone": "accent",
          "size": "sm"
        }
      },
      "titleStack": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "children": [
          "title",
          "subtitle"
        ]
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "Recent Notion Content",
          "level": "h2"
        }
      },
      "subtitle": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{n} items",
              "n": {
                "$computed": "count",
                "args": {
                  "value": {
                    "$state": "/notion/search/results"
                  }
                }
              }
            }
          }
        }
      },
      "typeBreakdownSection": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["typeBreakdownHeaderRow", "typeBreakdownBar", "typeBreakdownLegend"],
        "visible": { "$state": "/notion/search/results/0" }
      },
      "typeBreakdownHeaderRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["typeBreakdownCaption", "typeBreakdownTotalCaption"]
      },
      "typeBreakdownCaption": {
        "type": "Caption",
        "props": { "text": "Content Type Breakdown", "tone": "muted" }
      },
      "typeBreakdownTotalCaption": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": { "pattern": "{total} items", "total": { "$state": "/ui/typeBreakdown/total" } }
          },
          "tone": "muted"
        }
      },
      "typeBreakdownBar": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center", "template": { "$state": "/ui/typeBreakdown/template" } },
        "children": ["typeSegment"],
        "repeat": { "statePath": "/ui/typeBreakdown/segments", "key": "status" }
      },
      "typeSegment": {
        "type": "ProgressBar",
        "props": { "value": 100, "tone": { "$item": "tone" } }
      },
      "typeBreakdownLegend": {
        "type": "Row",
        "props": { "gap": "md", "align": "center" },
        "children": ["typeLegendItem"],
        "repeat": { "statePath": "/ui/typeBreakdown/segments", "key": "status" }
      },
      "typeLegendItem": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["typeLegendDot", "typeLegendLabel"]
      },
      "typeLegendDot": {
        "type": "Dot",
        "props": { "tone": { "$item": "tone" }, "size": "sm" }
      },
      "typeLegendLabel": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": { "pattern": "{status} ({count})", "status": { "$item": "status" }, "count": { "$item": "count" } }
          },
          "tone": "muted"
        }
      },

      "colHeader": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center", "template": "auto minmax(0, 1fr) auto" },
        "visible": { "$state": "/notion/search/results/0" },
        "children": ["colIconSpacer", "colContent", "colType"]
      },
      "colIconSpacer": { "type": "Caption", "props": { "text": "" } },
      "colContent": { "type": "Caption", "props": { "text": "Content" } },
      "colType": { "type": "Caption", "props": { "text": "Type" } },

      "divider0": { "type": "Divider", "props": {} },

      "body": {
        "type": "Body",
        "children": [
          "loading",
          "empty",
          "list"
        ]
      },
      "loading": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "visible": {
          "$state": "/_loading/notion.search"
        },
        "children": [
          "sk1",
          "sk2",
          "sk3"
        ]
      },
      "sk1": { "type": "Skeleton", "props": { "height": "3rem", "rounded": "md" } },
      "sk2": { "type": "Skeleton", "props": { "height": "3rem", "rounded": "md" } },
      "sk3": { "type": "Skeleton", "props": { "height": "3rem", "rounded": "md" } },
      "empty": {
        "type": "Empty",
        "props": {
          "message": "No recent Notion content found."
        },
        "visible": {
          "$and": [
            {
              "$state": "/_loading/notion.search",
              "not": true
            },
            {
              "$state": "/notion/search/results/0",
              "not": true
            }
          ]
        }
      },
      "list": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "visible": {
          "$state": "/_loading/notion.search",
          "not": true
        },
        "repeat": {
          "statePath": "/notion/search/results",
          "key": "id"
        },
        "children": [
          "row"
        ]
      },
      "row": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center",
          "template": "auto minmax(0, 1fr) auto",
          "hover": true,
          "clickable": true
        },
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "url": {
                "$bindItem": "url"
              },
              "target": "_blank"
            }
          }
        },
        "children": [
          "typeIcon",
          "labels",
          "typeBadge"
        ]
      },
      "typeIcon": {
        "type": "Icon",
        "props": {
          "name": {
            "$computed": "notion_object_type_icon",
            "args": {
              "value": {
                "$item": "object"
              }
            }
          },
          "tone": "muted",
          "size": "sm"
        }
      },
      "labels": {
        "type": "Stack",
        "props": {
          "gap": "xs",
          "grow": true
        },
        "children": [
          "resultTitle",
          "resultTime"
        ]
      },
      "resultTitle": {
        "type": "Text",
        "props": {
          "text": {
            "$computed": "notion_result_title",
            "args": {
              "item": {
                "$item": ""
              }
            }
          },
          "size": "md",
          "weight": "medium",
          "truncate": true
        }
      },
      "resultTime": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "relative_time",
            "args": {
              "value": {
                "$item": "last_edited_time"
              }
            }
          },
          "tone": "muted"
        }
      },
      "typeBadge": {
        "type": "Badge",
        "props": {
          "text": {
            "$computed": "notion_object_type_label",
            "args": {
              "value": {
                "$item": "object"
              }
            }
          },
          "tone": {
            "$computed": "notion_object_type_tone",
            "args": {
              "value": {
                "$item": "object"
              }
            }
          },
          "variant": "soft"
        }
      }
    }
  }
}
