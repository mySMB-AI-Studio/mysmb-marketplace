{
  "id": "notion-search-results",
  "title": "Recent Notion Content",
  "description": "Recently edited pages and data sources in your Notion workspace — title, type, and last edited time. Click a row to open it in Notion.",
  "category": "productivity",
  "tags": [
    "notion",
    "search",
    "pages",
    "data-sources",
    "knowledge",
    "productivity"
  ],
  "keywords": [
    "notion",
    "search",
    "find",
    "knowledge",
    "pages",
    "databases",
    "wiki"
  ],
  "connectorsUsed": [
    "notion"
  ],
  "popularity": 0,
  "sizing": {
    "preferred": {
      "colSpan": 6,
      "rowSpan": 7
    },
    "min": {
      "colSpan": 4,
      "rowSpan": 5
    },
    "max": {
      "colSpan": 12,
      "rowSpan": 12
    }
  },
  "dataProvider": {
    "mcp": "notion",
    "tool": "search",
    "params": {
      "sort_direction": "descending"
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "children": [
          "header",
          "body"
        ]
      },
      "header": {
        "type": "Header",
        "children": [
          "titleRow"
        ]
      },
      "titleRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "start"
        },
        "children": [
          "titleIcon",
          "titleStack"
        ]
      },
      "titleIcon": {
        "type": "Icon",
        "props": {
          "name": "Search",
          "tone": "accent",
          "size": "sm"
        }
      },
      "titleStack": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "children": [
          "title",
          "subtitle"
        ]
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "Recent Notion Content",
          "level": "h2"
        }
      },
      "subtitle": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{n} items",
              "n": {
                "$computed": "count",
                "args": {
                  "value": {
                    "$state": "/notion/search/results"
                  }
                }
              }
            }
          }
        }
      },
      "body": {
        "type": "Body",
        "children": [
          "loading",
          "empty",
          "list"
        ]
      },
      "loading": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "visible": {
          "$state": "/_loading/notion.search"
        },
        "children": [
          "sk1",
          "sk2",
          "sk3"
        ]
      },
      "sk1": { "type": "Skeleton", "props": { "height": "3rem", "rounded": "md" } },
      "sk2": { "type": "Skeleton", "props": { "height": "3rem", "rounded": "md" } },
      "sk3": { "type": "Skeleton", "props": { "height": "3rem", "rounded": "md" } },
      "empty": {
        "type": "Empty",
        "props": {
          "message": "No recent Notion content found."
        },
        "visible": {
          "$and": [
            {
              "$state": "/_loading/notion.search",
              "not": true
            },
            {
              "$state": "/notion/search/results/0",
              "not": true
            }
          ]
        }
      },
      "list": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "visible": {
          "$state": "/_loading/notion.search",
          "not": true
        },
        "repeat": {
          "statePath": "/notion/search/results",
          "key": "id"
        },
        "children": [
          "row"
        ]
      },
      "row": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center",
          "hover": true,
          "clickable": true,
          "justify": "between"
        },
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "url": {
                "$item": "url"
              }
            }
          }
        },
        "children": [
          "typeIcon",
          "labels",
          "typeBadge"
        ]
      },
      "typeIcon": {
        "type": "Icon",
        "props": {
          "name": {
            "$computed": "notion_object_type_icon",
            "args": {
              "value": {
                "$item": "object"
              }
            }
          },
          "tone": "muted",
          "size": "sm"
        }
      },
      "labels": {
        "type": "Stack",
        "props": {
          "gap": "xs",
          "grow": true
        },
        "children": [
          "resultTitle",
          "resultTime"
        ]
      },
      "resultTitle": {
        "type": "Text",
        "props": {
          "text": {
            "$computed": "notion_result_title",
            "args": {
              "item": {
                "$item": ""
              }
            }
          },
          "size": "md",
          "weight": "medium",
          "truncate": true
        }
      },
      "resultTime": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "relative_time",
            "args": {
              "value": {
                "$item": "last_edited_time"
              }
            }
          },
          "tone": "muted"
        }
      },
      "typeBadge": {
        "type": "Badge",
        "props": {
          "text": {
            "$computed": "notion_object_type_label",
            "args": {
              "value": {
                "$item": "object"
              }
            }
          },
          "tone": "default",
          "variant": "soft"
        }
      }
    }
  }
}
