{
  "id": "notion-recent-pages",
  "title": "Recent Notion Pages",
  "description": "Pages recently created or edited in your Notion workspace — title and last edited time. Click a row to open the page in Notion.",
  "category": "productivity",
  "tags": [
    "notion",
    "pages",
    "docs",
    "wiki",
    "productivity"
  ],
  "keywords": [
    "notion",
    "pages",
    "recent",
    "documents",
    "wiki",
    "notes"
  ],
  "connectorsUsed": [
    "notion"
  ],
  "popularity": 0,
  "sizing": {
    "preferred": {
      "colSpan": 6,
      "rowSpan": 7
    },
    "min": {
      "colSpan": 4,
      "rowSpan": 5
    },
    "max": {
      "colSpan": 12,
      "rowSpan": 13
    }
  },
  "dataProvider": {
    "mcp": "notion",
    "tool": "search",
    "params": {
      "object_type": "page",
      "sort_direction": "descending"
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "children": [
          "header",
          "recencyBreakdownSection",
          "colHeader",
          "divider0",
          "body"
        ],
        "watch": {
          "/notion/search/results": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/recencyBreakdown",
                "value": {
                  "$computed": "notion_recency_breakdown",
                  "args": { "results": { "$state": "/notion/search/results" } }
                }
              }
            }
          ]
        }
      },
      "header": {
        "type": "Header",
        "children": [
          "titleRow"
        ]
      },
      "titleRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "start"
        },
        "children": [
          "titleIcon",
          "titleStack"
        ]
      },
      "titleIcon": {
        "type": "Icon",
        "props": {
          "name": "FileText",
          "tone": "accent",
          "size": "sm"
        }
      },
      "titleStack": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "children": [
          "title",
          "count"
        ]
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "Recent Notion Pages",
          "level": "h2"
        }
      },
      "count": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{n} pages",
              "n": {
                "$computed": "count",
                "args": {
                  "value": {
                    "$state": "/notion/search/results"
                  }
                }
              }
            }
          }
        }
      },
      "recencyBreakdownSection": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["recencyBreakdownHeaderRow", "recencyBreakdownBar", "recencyBreakdownLegend"],
        "visible": { "$state": "/notion/search/results/0" }
      },
      "recencyBreakdownHeaderRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["recencyBreakdownCaption", "recencyBreakdownTotalCaption"]
      },
      "recencyBreakdownCaption": {
        "type": "Caption",
        "props": { "text": "Last Edited Breakdown", "tone": "muted" }
      },
      "recencyBreakdownTotalCaption": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": { "pattern": "{total} pages", "total": { "$state": "/ui/recencyBreakdown/total" } }
          },
          "tone": "muted"
        }
      },
      "recencyBreakdownBar": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center", "template": { "$state": "/ui/recencyBreakdown/template" } },
        "children": ["recencySegment"],
        "repeat": { "statePath": "/ui/recencyBreakdown/segments", "key": "status" }
      },
      "recencySegment": {
        "type": "ProgressBar",
        "props": { "value": 100, "tone": { "$item": "tone" } }
      },
      "recencyBreakdownLegend": {
        "type": "Row",
        "props": { "gap": "md", "align": "center" },
        "children": ["recencyLegendItem"],
        "repeat": { "statePath": "/ui/recencyBreakdown/segments", "key": "status" }
      },
      "recencyLegendItem": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["recencyLegendDot", "recencyLegendLabel"]
      },
      "recencyLegendDot": {
        "type": "Dot",
        "props": { "tone": { "$item": "tone" }, "size": "sm" }
      },
      "recencyLegendLabel": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": { "pattern": "{status} ({count})", "status": { "$item": "status" }, "count": { "$item": "count" } }
          },
          "tone": "muted"
        }
      },

      "colHeader": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center", "template": "auto minmax(0, 1fr) auto" },
        "visible": { "$state": "/notion/search/results/0" },
        "children": ["colIconSpacer", "colPage", "colEdited"]
      },
      "colIconSpacer": { "type": "Caption", "props": { "text": "" } },
      "colPage": { "type": "Caption", "props": { "text": "Page" } },
      "colEdited": { "type": "Caption", "props": { "text": "Last Edited" } },

      "divider0": { "type": "Divider", "props": {} },

      "body": {
        "type": "Body",
        "children": [
          "loading",
          "empty",
          "list"
        ]
      },
      "loading": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "visible": {
          "$state": "/_loading/notion.search"
        },
        "children": [
          "sk1",
          "sk2",
          "sk3",
          "sk4"
        ]
      },
      "sk1": { "type": "Skeleton", "props": { "height": "2.75rem", "rounded": "md" } },
      "sk2": { "type": "Skeleton", "props": { "height": "2.75rem", "rounded": "md" } },
      "sk3": { "type": "Skeleton", "props": { "height": "2.75rem", "rounded": "md" } },
      "sk4": { "type": "Skeleton", "props": { "height": "2.75rem", "rounded": "md" } },
      "empty": {
        "type": "Empty",
        "props": {
          "message": "No pages found in your Notion workspace."
        },
        "visible": {
          "$and": [
            {
              "$state": "/_loading/notion.search",
              "not": true
            },
            {
              "$state": "/notion/search/results/0",
              "not": true
            }
          ]
        }
      },
      "list": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "visible": {
          "$state": "/_loading/notion.search",
          "not": true
        },
        "repeat": {
          "statePath": "/notion/search/results",
          "key": "id"
        },
        "children": [
          "row"
        ]
      },
      "row": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center",
          "template": "auto minmax(0, 1fr) auto",
          "hover": true,
          "clickable": true
        },
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "url": {
                "$bindItem": "url"
              },
              "target": "_blank"
            }
          }
        },
        "children": [
          "pageIcon",
          "labels",
          "editedTime"
        ]
      },
      "pageIcon": {
        "type": "Icon",
        "props": {
          "name": "FileText",
          "tone": {
            "$computed": "notion_page_recency_tone",
            "args": {
              "value": {
                "$item": "last_edited_time"
              }
            }
          },
          "size": "sm"
        }
      },
      "labels": {
        "type": "Stack",
        "props": {
          "gap": "xs",
          "grow": true
        },
        "children": [
          "pageTitle"
        ]
      },
      "pageTitle": {
        "type": "Text",
        "props": {
          "text": {
            "$computed": "notion_result_title",
            "args": {
              "item": {
                "$item": ""
              }
            }
          },
          "size": "md",
          "weight": "medium",
          "truncate": true
        }
      },
      "editedTime": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "relative_time",
            "args": {
              "value": {
                "$item": "last_edited_time"
              }
            }
          },
          "tone": "muted"
        }
      }
    }
  }
}
