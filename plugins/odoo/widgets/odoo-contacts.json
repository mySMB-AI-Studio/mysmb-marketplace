{
  "id": "odoo-contacts",
  "title": "Odoo — Contacts",
  "description": "Contacts from mySMB's Odoo instance — people and companies, with email and phone, via Odoo's native MCP server (ai_tool_search on res.partner).",
  "category": "sales",
  "tags": ["odoo", "contacts", "crm", "erp"],
  "keywords": ["odoo", "contacts", "customers", "partners", "erp"],
  "connectorsUsed": ["odoo"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 5, "rowSpan": 9 },
    "min": { "colSpan": 4, "rowSpan": 6 },
    "max": { "colSpan": 8, "rowSpan": 16 }
  },
  "dataProvider": {
    "kind": "tool",
    "mcp": "odoo",
    "tool": "ai_tool_search",
    "params": {
      "model_name": "res.partner",
      "domain": "[]",
      "fields": ["name", "email", "phone", "is_company"],
      "limit": 30,
      "order": "name asc"
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": { "type": "Card", "props": {}, "children": ["header", "divider1", "body"] },
      "header": { "type": "Header", "props": {}, "children": ["titleGroup"] },
      "titleGroup": { "type": "Row", "props": { "gap": "sm", "align": "center" }, "children": ["titleIcon", "titleStack"] },
      "titleIcon": { "type": "Icon", "props": { "name": "Users", "tone": "accent", "size": "sm" } },
      "titleStack": { "type": "Stack", "props": { "gap": "none" }, "children": ["title", "eyebrow"] },
      "title": { "type": "Heading", "props": { "text": "Contacts", "level": "h2" } },
      "eyebrow": {
        "type": "Eyebrow",
        "props": {
          "text": { "$computed": "fmt", "args": { "pattern": "Odoo · {n} contact(s)", "n": { "$state": "/odoo/ai_tool_search/response/total_count" } } }
        }
      },
      "divider1": { "type": "Divider", "props": {} },

      "body": { "type": "Body", "props": {}, "children": ["errorBanner", "loading", "empty", "content"] },

      "errorBanner": {
        "type": "Caption",
        "props": { "text": { "$template": "Couldn't load contacts: ${/_errors/odoo.ai_tool_search}" }, "tone": "destructive" },
        "visible": { "$state": "/_errors/odoo.ai_tool_search" }
      },

      "loading": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["sk1", "sk2", "sk3"],
        "visible": { "$state": "/_loading/odoo.ai_tool_search" }
      },
      "sk1": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "sk2": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "sk3": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },

      "empty": {
        "type": "Empty",
        "props": { "message": "No contacts found." },
        "visible": {
          "$and": [
            { "$state": "/_loading/odoo.ai_tool_search", "not": true },
            { "$state": "/odoo/ai_tool_search/response/records/0", "not": true }
          ]
        }
      },

      "content": {
        "type": "Stack",
        "props": { "gap": "sm", "maxHeight": 440 },
        "children": ["contactRow"],
        "repeat": { "statePath": "/odoo/ai_tool_search/response/records", "key": "id" },
        "visible": {
          "$and": [
            { "$state": "/_loading/odoo.ai_tool_search", "not": true },
            { "$state": "/odoo/ai_tool_search/response/records/0" }
          ]
        }
      },

      "contactRow": {
        "type": "Row",
        "props": { "align": "center", "gap": "sm", "template": "auto minmax(0,1fr)" },
        "children": ["contactAvatar", "contactInfo"]
      },
      "contactAvatar": {
        "type": "Avatar",
        "props": {
          "size": "sm",
          "tone": { "$computed": "odoo_contact_tone", "args": { "value": { "$item": "is_company" } } },
          "initials": { "$computed": "initials", "args": { "value": { "$item": "name" } } }
        }
      },
      "contactInfo": { "type": "Stack", "props": { "gap": "none" }, "children": ["contactNameRow", "contactMeta"] },
      "contactNameRow": { "type": "Row", "props": { "gap": "xs", "align": "center" }, "children": ["contactName", "companyBadge"] },
      "contactName": { "type": "Text", "props": { "text": { "$item": "name" }, "size": "sm", "weight": "semibold", "truncate": true } },
      "companyBadge": {
        "type": "Badge",
        "props": { "text": "Company", "tone": "accent", "variant": "soft" },
        "visible": { "$item": "is_company" }
      },
      "contactMeta": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "odoo_contact_meta",
            "args": { "email": { "$item": "email" }, "phone": { "$item": "phone" } }
          },
          "tone": "muted"
        }
      }
    }
  },
  "status": "published"
}
