{
  "id": "trello-overdue-cards",
  "title": "Overdue Cards",
  "description": "Cards assigned to you in Trello that are past their due date, with per-card overdue badges and summary stats.",
  "category": "tasks",
  "tags": ["trello", "cards", "overdue", "due dates", "at risk"],
  "keywords": ["trello overdue", "overdue cards", "past due", "late cards", "kanban"],
  "connectorsUsed": ["trello"],
  "popularity": 65,
  "sizing": {
    "preferred": { "colSpan": 5, "rowSpan": 6 },
    "min": { "colSpan": 3, "rowSpan": 4 },
    "max": { "colSpan": 8, "rowSpan": 12 }
  },
  "dataProvider": {
    "mcp": "trello",
    "tool": "list_my_cards",
    "params": {}
  },
  "spec": {
    "root": "card",
    "elements": {

      "card": {
        "type": "Card",
        "props": {},
        "children": ["headerRow", "div0", "loading", "empty", "kpiGrid", "div1", "cardList"],
        "watch": {
          "/trello/list_my_cards/data": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/rows",
                "value": {
                  "$computed": "trello_flatten_overdue_cards",
                  "args": { "value": { "$state": "/trello/list_my_cards/data" } }
                }
              }
            }
          ]
        }
      },

      "headerRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["titleGroup"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": { "type": "Icon", "props": { "name": "TriangleAlert", "tone": "destructive", "size": "sm" } },
      "titleStack": { "type": "Stack", "props": { "gap": "none" }, "children": ["title", "eyebrow"] },
      "title": { "type": "Heading", "props": { "text": "Overdue Cards", "level": "h2" } },
      "eyebrow": { "type": "Eyebrow", "props": { "text": "Trello" } },

      "div0": { "type": "Divider", "props": {} },

      "loading": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["sk1", "sk2", "sk3"],
        "visible": { "$state": "/_loading/trello.list_my_cards" }
      },
      "sk1": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "sk2": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "sk3": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },

      "empty": {
        "type": "Empty",
        "props": { "message": "No overdue cards. You're all caught up!" },
        "visible": {
          "$and": [
            { "$state": "/_loading/trello.list_my_cards", "not": true },
            { "$state": "/ui/rows/0", "not": true }
          ]
        }
      },

      "kpiGrid": {
        "type": "Grid",
        "props": { "cols": 3, "gap": "sm" },
        "children": ["tileOverdue", "tileBoards", "tileLongest"],
        "visible": {
          "$and": [
            { "$state": "/_loading/trello.list_my_cards", "not": true },
            { "$state": "/ui/rows/0" }
          ]
        }
      },

      "tileOverdue": { "type": "Section", "props": { "variant": "muted" }, "children": ["stackOverdue"] },
      "stackOverdue": { "type": "Stack", "props": { "gap": "none", "align": "center" }, "children": ["valOverdue", "lblOverdue"] },
      "valOverdue": { "type": "Stat", "props": { "value": { "$state": "/ui/rows/0/stat_overdue" }, "size": "md" } },
      "lblOverdue": { "type": "Caption", "props": { "text": "Overdue", "tone": "destructive" } },

      "tileBoards": { "type": "Section", "props": { "variant": "muted" }, "children": ["stackBoards"] },
      "stackBoards": { "type": "Stack", "props": { "gap": "none", "align": "center" }, "children": ["valBoards", "lblBoards"] },
      "valBoards": { "type": "Stat", "props": { "value": { "$state": "/ui/rows/0/stat_boards" }, "size": "md" } },
      "lblBoards": { "type": "Caption", "props": { "text": "Boards", "tone": "muted" } },

      "tileLongest": { "type": "Section", "props": { "variant": "muted" }, "children": ["stackLongest"] },
      "stackLongest": { "type": "Stack", "props": { "gap": "none", "align": "center" }, "children": ["valLongest", "lblLongest"] },
      "valLongest": { "type": "Stat", "props": { "value": { "$state": "/ui/rows/0/stat_longest" }, "size": "md" } },
      "lblLongest": { "type": "Caption", "props": { "text": "Longest", "tone": "destructive" } },

      "div1": {
        "type": "Divider",
        "props": {},
        "visible": {
          "$and": [
            { "$state": "/_loading/trello.list_my_cards", "not": true },
            { "$state": "/ui/rows/0" }
          ]
        }
      },

      "cardList": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["cardRow"],
        "repeat": { "statePath": "/ui/rows", "key": "id" },
        "visible": {
          "$and": [
            { "$state": "/_loading/trello.list_my_cards", "not": true },
            { "$state": "/ui/rows/0" }
          ]
        }
      },

      "cardRow": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["cardInfo", "cardOverdueBadge"]
      },
      "cardInfo": {
        "type": "Stack",
        "props": { "gap": "none", "grow": true },
        "children": ["cardTitle", "cardBoard"]
      },
      "cardTitle": {
        "type": "Text",
        "props": { "text": { "$item": "title" }, "size": "sm", "weight": "semibold", "truncate": true }
      },
      "cardBoard": {
        "type": "Caption",
        "props": { "text": { "$item": "board_label" }, "tone": "muted", "truncate": true },
        "visible": { "$item": "board_label" }
      },
      "cardOverdueBadge": {
        "type": "Badge",
        "props": {
          "text": { "$item": "overdue_label" },
          "tone": "destructive",
          "variant": "soft"
        }
      }

    }
  },
  "status": "published"
}
