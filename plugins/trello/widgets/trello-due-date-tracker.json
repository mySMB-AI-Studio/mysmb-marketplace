          "gap": "md"
        },
        "type": "Row",
        "visible": {
          "$state": "/_loading/trello.list_all_cards",
          "not": true
        }
      },
      "trackerCardBoard": {
        "props": {
          "text": {
            "$item": "board_label"
          },
          "tone": "muted",
          "truncate": true
        },
        "type": "Caption"
      },
      "trackerCardDue": {
        "props": {
          "text": {
            "$item": "due_label"
          },
          "tone": "muted"
        },
        "type": "Caption"
      },
      "trackerCardInfo": {
        "children": [
          "trackerCardName",
          "trackerCardBoard"
        ],
        "props": {
          "gap": "none",
          "grow": true
        },
        "type": "Stack"
      },
      "trackerCardName": {
        "props": {
          "size": "sm",
          "text": {
            "$item": "name"
          },
          "truncate": true
        },
        "type": "Text"
      },
      "trackerCardRow": {
        "children": [
          "trackerCardInfo",
          "trackerCardDue"
        ],
        "props": {
          "align": "center",
          "gap": "xs"
