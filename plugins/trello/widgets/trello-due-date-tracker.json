            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/trackerTab/week",
                "value": true
              }
            }
          ]
        },
        "props": {
          "label": "Upcoming",
          "size": "sm",
          "variant": "ghost"
        },
        "type": "Button",
        "visible": {
          "$state": "/ui/trackerTab/week",
          "not": true
        }
      },
      "tabWeekOn": {
        "props": {
          "label": "Upcoming",
          "size": "sm",
          "variant": "primary"
        },
        "type": "Button",
        "visible": {
          "$state": "/ui/trackerTab/week"
        }
      },
      "textOverdue": {
        "props": {
          "text": {
            "$computed": "trello_format_tracker_legend",
            "args": {
              "label": "Overdue",
              "value": {
                "$state": "/ui/tracker/overdue_count"
              }
            }
          }
        },
        "type": "Caption"
      },
      "textOverdueB": {
        "props": {
          "text": {
            "$computed": "trello_format_tracker_legend",
            "args": {
              "label": "Overdue",
              "value": {
                "$state": "/ui/tracker/overdue_count"
              }
            }
          }
        },
        "type": "Caption"
      },
      "textToday": {
        "props": {
          "text": {
            "$computed": "trello_format_tracker_legend",
            "args": {
              "label": "Today",
              "value": {
                "$state": "/ui/tracker/today_count"
              }
            }
          }
        },
        "type": "Caption"
      },
      "textTodayB": {
        "props": {
          "text": {
            "$computed": "trello_format_tracker_legend",
            "args": {
              "label": "Today",
              "value": {
                "$state": "/ui/tracker/today_count"
              }
            }
          }
        },
        "type": "Caption"
      },
      "textWeek": {
        "props": {
          "text": {
            "$computed": "trello_format_tracker_legend",
            "args": {
              "label": "Upcoming",
              "value": {
                "$state": "/ui/tracker/week_count"
              }
            }
          }
        },
        "type": "Caption"
