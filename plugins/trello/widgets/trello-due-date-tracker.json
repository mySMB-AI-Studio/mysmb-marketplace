        ],
        "props": {
          "align": "baseline",
          "gap": "xs"
        },
        "type": "Row"
      },
      "todayLabel": {
        "props": {
          "text": "Due today",
          "tone": "muted"
        },
        "type": "Caption"
      },
      "todayNum": {
        "props": {
          "size": "sm",
