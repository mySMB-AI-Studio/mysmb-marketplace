      "textWeekB": {
        "props": {
          "text": {
            "$computed": "trello_format_tracker_legend",
            "args": {
              "label": "Upcoming",
              "value": {
                "$state": "/ui/tracker/week_count"
              }
            }
          }
        },
        "type": "Caption"
      },
      "title": {
        "props": {
          "level": "h2",
          "text": "Due Date Tracker"
        },
        "type": "Heading"
      },
      "titleIcon": {
        "props": {
          "name": "Clock",
          "size": "sm",
          "tone": "destructive"
        },
        "type": "Icon"
      },
      "titleStack": {
        "children": [
          "title",
          "eyebrow"
