{
  "id": "trello-due-date-tracker",
  "title": "Due Date Tracker",
  "description": "Overdue, due-today, and due-this-week card counts across every open board, with a status breakdown.",
  "category": "tasks",
  "tags": ["trello", "cards", "due dates", "overdue", "tracker"],
  "keywords": ["trello overdue", "due date tracker", "due today", "due this week", "kanban"],
  "connectorsUsed": ["trello"],
  "popularity": 65,
  "sizing": {
    "preferred": { "colSpan": 4, "rowSpan": 6 },
    "min": { "colSpan": 3, "rowSpan": 5 },
    "max": { "colSpan": 6, "rowSpan": 8 }
  },
  "dataProvider": {
    "mcp": "trello",
    "tool": "list_all_cards",
    "params": {}
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": ["headerRow", "loading", "bigStatGroup", "todayWeekRow", "barRow", "legendRowCollapsed", "legendRowExpanded", "trackerDetailSection", "openInTrelloRow"],
        "watch": {
          "/trello/list_all_cards/data": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/tracker",
                "value": {
                  "$computed": "trello_flatten_due_date_tracker",
                  "args": { "value": { "$state": "/trello/list_all_cards/data" } }
                }
              }
            }
          ]
        }
      },

      "headerRow": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": { "type": "Icon", "props": { "name": "Clock", "tone": "destructive", "size": "sm" } },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "eyebrow"]
      },
      "title": { "type": "Heading", "props": { "text": "Due Date Tracker", "level": "h2" } },
      "eyebrow": { "type": "Eyebrow", "props": { "text": "Trello" } },

      "loading": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["sk1", "sk2", "sk3"],
        "visible": { "$state": "/_loading/trello.list_all_cards" }
      },
      "sk1": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "sk2": { "type": "Skeleton", "props": { "height": "1.5rem", "rounded": "md" } },
      "sk3": { "type": "Skeleton", "props": { "height": "1rem", "rounded": "md" } },

      "bigStatGroup": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["statValue", "statLabel"],
        "visible": { "$state": "/_loading/trello.list_all_cards", "not": true }
      },
      "statValue": {
        "type": "Text",
        "props": { "text": { "$state": "/ui/tracker/overdue_count" }, "size": "lg", "weight": "bold", "tone": "destructive" }
      },
      "statLabel": { "type": "Caption", "props": { "text": "Cards overdue", "tone": "default" } },

      "todayWeekRow": {
        "type": "Row",
        "props": { "gap": "md", "align": "center" },
        "children": ["todayGroup", "vDivider", "weekGroup"],
        "visible": { "$state": "/_loading/trello.list_all_cards", "not": true }
      },
      "todayGroup": {
        "type": "Row",
        "props": { "gap": "xs", "align": "baseline" },
        "children": ["todayNum", "todayLabel"]
      },
      "todayNum": {
        "type": "Stat",
        "props": { "value": { "$state": "/ui/tracker/today_count" }, "size": "sm" }
      },
      "todayLabel": { "type": "Caption", "props": { "text": "Due today", "tone": "muted" } },
      "vDivider": { "type": "Divider", "props": { "vertical": true } },
      "weekGroup": {
        "type": "Row",
        "props": { "gap": "xs", "align": "baseline" },
        "children": ["weekNum", "weekLabel"]
      },
      "weekNum": {
        "type": "Stat",
        "props": { "value": { "$state": "/ui/tracker/week_count" }, "size": "sm" }
      },
      "weekLabel": { "type": "Caption", "props": { "text": "Due this week", "tone": "muted" } },

      "barRow": {
        "type": "Row",
        "props": { "gap": "none" },
        "children": ["barOverdue", "barToday", "barWeek"],
        "visible": { "$state": "/_loading/trello.list_all_cards", "not": true }
      },
      "barOverdue": { "type": "ProgressBar", "props": { "value": 100, "tone": "destructive" } },
      "barToday": { "type": "ProgressBar", "props": { "value": 100, "tone": "warning" } },
      "barWeek": { "type": "ProgressBar", "props": { "value": 100, "tone": "info" } },

      "legendRowCollapsed": {
        "type": "Row",
        "props": { "gap": "md", "align": "center", "clickable": true },
        "children": ["legendOverdue", "legendToday", "legendWeek"],
        "visible": {
          "$and": [
            { "$state": "/_loading/trello.list_all_cards", "not": true },
            { "$state": "/ui/trackerExpanded", "not": true }
          ]
        },
        "on": {
          "click": [
            { "action": "setState", "params": { "statePath": "/ui/trackerExpanded", "value": true } },
            { "action": "setState", "params": { "statePath": "/ui/trackerTab/overdue", "value": true } },
            { "action": "setState", "params": { "statePath": "/ui/trackerTab/today", "value": false } },
            { "action": "setState", "params": { "statePath": "/ui/trackerTab/week", "value": false } }
          ]
        }
      },
      "legendRowExpanded": {
        "type": "Row",
        "props": { "gap": "md", "align": "center", "clickable": true },
        "children": ["legendOverdueB", "legendTodayB", "legendWeekB"],
        "visible": {
          "$and": [
            { "$state": "/_loading/trello.list_all_cards", "not": true },
            { "$state": "/ui/trackerExpanded" }
          ]
        },
        "on": {
          "click": [
            { "action": "setState", "params": { "statePath": "/ui/trackerExpanded", "value": false } }
          ]
        }
      },
      "legendOverdue": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["dotOverdue", "textOverdue"]
      },
      "dotOverdue": { "type": "Dot", "props": { "tone": "destructive", "size": "sm" } },
      "textOverdue": {
        "type": "Caption",
        "props": { "text": { "$computed": "trello_format_tracker_legend", "args": { "label": "Overdue", "value": { "$state": "/ui/tracker/overdue_count" } } } }
      },
      "legendToday": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["dotToday", "textToday"]
      },
      "dotToday": { "type": "Dot", "props": { "tone": "warning", "size": "sm" } },
      "textToday": {
        "type": "Caption",
        "props": { "text": { "$computed": "trello_format_tracker_legend", "args": { "label": "Today", "value": { "$state": "/ui/tracker/today_count" } } } }
      },
      "legendWeek": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["dotWeek", "textWeek"]
      },
      "dotWeek": { "type": "Dot", "props": { "tone": "info", "size": "sm" } },
      "textWeek": {
        "type": "Caption",
        "props": { "text": { "$computed": "trello_format_tracker_legend", "args": { "label": "Upcoming", "value": { "$state": "/ui/tracker/week_count" } } } }
      },

      "legendOverdueB": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["dotOverdueB", "textOverdueB"]
      },
      "dotOverdueB": { "type": "Dot", "props": { "tone": "destructive", "size": "sm" } },
      "textOverdueB": {
        "type": "Caption",
        "props": { "text": { "$computed": "trello_format_tracker_legend", "args": { "label": "Overdue", "value": { "$state": "/ui/tracker/overdue_count" } } } }
      },
      "legendTodayB": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["dotTodayB", "textTodayB"]
      },
      "dotTodayB": { "type": "Dot", "props": { "tone": "warning", "size": "sm" } },
      "textTodayB": {
        "type": "Caption",
        "props": { "text": { "$computed": "trello_format_tracker_legend", "args": { "label": "Today", "value": { "$state": "/ui/tracker/today_count" } } } }
      },
      "legendWeekB": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["dotWeekB", "textWeekB"]
      },
      "dotWeekB": { "type": "Dot", "props": { "tone": "info", "size": "sm" } },
      "textWeekB": {
        "type": "Caption",
        "props": { "text": { "$computed": "trello_format_tracker_legend", "args": { "label": "Upcoming", "value": { "$state": "/ui/tracker/week_count" } } } }
      },

      "trackerDetailSection": {
        "type": "Body",
        "props": {},
        "children": ["trackerDetailInner"],
        "visible": { "$state": "/ui/trackerExpanded" }
      },
      "trackerDetailInner": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["trackerTabRow", "overdueContent", "todayContent", "weekContent"]
      },
      "trackerTabRow": {
        "type": "Row",
        "props": { "gap": "xs" },
        "children": ["tabOverdueOn", "tabOverdueOff", "tabTodayOn", "tabTodayOff", "tabWeekOn", "tabWeekOff"]
      },
      "tabOverdueOn": {
        "type": "Button",
        "props": { "label": "Overdue", "variant": "primary", "size": "sm" },
        "visible": { "$state": "/ui/trackerTab/overdue" }
      },
      "tabOverdueOff": {
        "type": "Button",
        "props": { "label": "Overdue", "variant": "ghost", "size": "sm" },
        "visible": { "$state": "/ui/trackerTab/overdue", "not": true },
        "on": {
          "click": [
            { "action": "setState", "params": { "statePath": "/ui/trackerTab/overdue", "value": true } },
            { "action": "setState", "params": { "statePath": "/ui/trackerTab/today", "value": false } },
            { "action": "setState", "params": { "statePath": "/ui/trackerTab/week", "value": false } }
          ]
        }
      },
      "tabTodayOn": {
        "type": "Button",
        "props": { "label": "Today", "variant": "primary", "size": "sm" },
        "visible": { "$state": "/ui/trackerTab/today" }
      },
      "tabTodayOff": {
        "type": "Button",
        "props": { "label": "Today", "variant": "ghost", "size": "sm" },
        "visible": { "$state": "/ui/trackerTab/today", "not": true },
        "on": {
          "click": [
            { "action": "setState", "params": { "statePath": "/ui/trackerTab/overdue", "value": false } },
            { "action": "setState", "params": { "statePath": "/ui/trackerTab/today", "value": true } },
            { "action": "setState", "params": { "statePath": "/ui/trackerTab/week", "value": false } }
          ]
        }
      },
      "tabWeekOn": {
        "type": "Button",
        "props": { "label": "Upcoming", "variant": "primary", "size": "sm" },
        "visible": { "$state": "/ui/trackerTab/week" }
      },
      "tabWeekOff": {
        "type": "Button",
        "props": { "label": "Upcoming", "variant": "ghost", "size": "sm" },
        "visible": { "$state": "/ui/trackerTab/week", "not": true },
        "on": {
          "click": [
            { "action": "setState", "params": { "statePath": "/ui/trackerTab/overdue", "value": false } },
            { "action": "setState", "params": { "statePath": "/ui/trackerTab/today", "value": false } },
            { "action": "setState", "params": { "statePath": "/ui/trackerTab/week", "value": true } }
          ]
        }
      },

      "overdueContent": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["overdueEmpty", "overdueRepeatList"],
        "visible": { "$state": "/ui/trackerTab/overdue" }
      },
      "overdueEmpty": {
        "type": "Empty",
        "props": { "message": "No overdue cards." },
        "visible": { "$state": "/ui/tracker/overdue_rows/0", "not": true }
      },
      "overdueRepeatList": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["trackerCardRow"],
        "repeat": { "statePath": "/ui/tracker/overdue_rows", "key": "id" }
      },

      "todayContent": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["todayEmpty", "todayRepeatList"],
        "visible": { "$state": "/ui/trackerTab/today" }
      },
      "todayEmpty": {
        "type": "Empty",
        "props": { "message": "No cards due today." },
        "visible": { "$state": "/ui/tracker/today_rows/0", "not": true }
      },
      "todayRepeatList": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["trackerCardRow"],
        "repeat": { "statePath": "/ui/tracker/today_rows", "key": "id" }
      },

      "weekContent": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["weekEmpty", "weekRepeatList"],
        "visible": { "$state": "/ui/trackerTab/week" }
      },
      "weekEmpty": {
        "type": "Empty",
        "props": { "message": "No cards due this week." },
        "visible": { "$state": "/ui/tracker/week_rows/0", "not": true }
      },
      "weekRepeatList": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["trackerCardRow"],
        "repeat": { "statePath": "/ui/tracker/week_rows", "key": "id" }
      },

      "trackerCardRow": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["trackerCardInfo", "trackerCardDue"]
      },
      "trackerCardInfo": {
        "type": "Stack",
        "props": { "gap": "none", "grow": true },
        "children": ["trackerCardName", "trackerCardBoard"]
      },
      "trackerCardName": {
        "type": "Text",
        "props": { "text": { "$item": "name" }, "size": "sm", "truncate": true }
      },
      "trackerCardBoard": {
        "type": "Caption",
        "props": { "text": { "$item": "board_label" }, "tone": "muted", "truncate": true }
      },
      "trackerCardDue": {
        "type": "Caption",
        "props": { "text": { "$item": "due_label" }, "tone": "muted" }
      },

      "openInTrelloRow": {
        "type": "Row",
        "props": { "justify": "end" },
        "children": ["openInTrelloButton"]
      },
      "openInTrelloButton": {
        "type": "Button",
        "props": { "label": "Open in Trello", "variant": "ghost", "size": "sm", "leadingIcon": "ExternalLink" },
        "on": {
          "click": { "action": "open_url", "params": { "url": "https://trello.com/b/tcjhGlBx/myimpact-qa-trello-tile-test-data", "target": "_blank" } }
        }
      }
    }
  },
  "status": "published"
}
