{
  "category": "tasks",
  "connectorsUsed": [
    "trello"
  ],
  "dataProvider": {
    "kind": "tool",
    "mcp": "trello",
    "params": {},
    "tool": "get_team_workload"
  },
  "description": "Assigned open card counts per board member across every open board, sorted highest to lowest.",
  "id": "trello-team-workload",
  "keywords": [
    "trello team workload",
    "assigned cards",
    "member workload",
    "idMembers",
    "kanban"
  ],
  "popularity": 60,
  "sizing": {
    "max": {
      "colSpan": 6,
      "rowSpan": 8
    },
    "min": {
      "colSpan": 3,
      "rowSpan": 5
    },
    "preferred": {
      "colSpan": 4,
      "rowSpan": 6
    }
  },
  "spec": {
    "elements": {
      "avatar": {
        "props": {
          "initials": {
            "$item": "initials"
          },
          "size": "md",
          "tone": {
            "$item": "avatar_tone"
          }
        },
        "type": "Avatar"
      },
      "bigStatGroup": {
        "children": [
          "statValue",
          "statLabel"
        ],
        "props": {
          "gap": "none"
        },
        "type": "Stack",
        "visible": {
          "$state": "/_loading/trello.get_team_workload",
          "not": true
        }
      },
      "card": {
        "children": [
          "headerRow",
          "loading",
          "bigStatGroup",
          "memberEmpty",
          "memberList",
          "footerRow"
        ],
        "props": {},
        "type": "Card",
        "watch": {
          "/trello/get_team_workload/members": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/members",
                "value": {
                  "$computed": "trello_flatten_team_workload",
                  "args": {
                    "value": {
                      "$state": "/trello/get_team_workload/members"
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "countText": {
        "props": {
          "size": "sm",
          "text": {
            "$item": "count"
          },
          "weight": "semibold"
        },
        "type": "Text"
      },
      "eyebrow": {
        "props": {
          "text": "Trello"
        },
        "type": "Eyebrow"
      },
      "footerIcon": {
        "props": {
          "name": "Database",
          "size": "sm",
          "tone": "muted"
        },
        "type": "Icon"
      },
      "footerRow": {
        "children": [
          "footerIcon",
          "footerText"
        ],
        "props": {
          "align": "center",
          "gap": "xs"
        },
        "type": "Row"
      },
      "footerText": {
        "props": {
          "text": "Members endpoint + card idMembers fields",
          "tone": "muted"
        },
        "type": "Caption"
      },
      "headerRow": {
        "children": [
          "titleIcon",
          "titleStack"
        ],
        "props": {
          "align": "center",
          "gap": "sm"
        },
        "type": "Row"
      },
      "loading": {
        "children": [
          "sk1",
          "sk2",
          "sk3"
        ],
        "props": {
          "gap": "sm"
        },
        "type": "Stack",
        "visible": {
          "$state": "/_loading/trello.get_team_workload"
        }
      },
      "memberEmpty": {
        "props": {
          "message": "No cards assigned to any member."
        },
        "type": "Empty",
        "visible": {
          "$and": [
            {
              "$state": "/_loading/trello.get_team_workload",
              "not": true
            },
            {
              "$state": "/ui/members/0",
              "not": true
            }
          ]
        }
      },
      "memberList": {
        "children": [
          "memberRow"
        ],
        "props": {
          "gap": "sm"
        },
        "repeat": {
          "key": "member_id",
          "statePath": "/ui/members"
        },
        "type": "Stack",
        "visible": {
          "$state": "/_loading/trello.get_team_workload",
          "not": true
        }
      },
      "memberRow": {
        "children": [
          "avatar",
          "memberStack"
        ],
        "props": {
          "align": "center",
          "gap": "sm"
        },
        "type": "Row"
      },
      "memberStack": {
        "children": [
          "nameCountRow",
          "progressBar"
        ],
        "props": {
          "gap": "xs",
          "grow": true
        },
        "type": "Stack"
      },
      "nameCountRow": {
        "children": [
          "nameText",
          "countText"
        ],
        "props": {
          "align": "center",
          "justify": "between"
        },
        "type": "Row"
      },
      "nameText": {
        "props": {
          "size": "sm",
          "text": {
            "$item": "name"
          },
          "truncate": true,
          "weight": "semibold"
        },
        "type": "Text"
      },
      "progressBar": {
        "props": {
          "tone": "info",
          "value": {
            "$item": "pct"
          }
        },
        "type": "ProgressBar"
      },
      "sk1": {
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "sk2": {
        "props": {
          "height": "3rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "sk3": {
        "props": {
          "height": "3rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "statLabel": {
        "props": {
          "text": "Cards assigned",
          "tone": "muted"
        },
        "type": "Caption"
      },
      "statValue": {
        "props": {
          "size": "lg",
          "value": {
            "$state": "/trello/get_team_workload/total_assigned"
          }
        },
        "type": "Stat"
      },
      "title": {
        "props": {
          "level": "h2",
          "text": "Team Workload"
        },
        "type": "Heading"
      },
      "titleIcon": {
        "props": {
          "name": "Users",
          "size": "sm",
          "tone": "info"
        },
        "type": "Icon"
      },
      "titleStack": {
        "children": [
          "title",
          "eyebrow"
        ],
        "props": {
          "gap": "none"
        },
        "type": "Stack"
      }
    },
    "root": "card"
  },
  "tags": [
    "trello",
    "cards",
    "members",
    "workload",
    "team"
  ],
  "title": "Team Workload"
}
