{
  "category": "tasks",
  "connectorsUsed": [
    "trello"
  ],
  "dataProvider": {
    "kind": "tool",
    "mcp": "trello",
    "params": {},
    "tool": "get_team_workload"
  },
  "description": "Assigned open card counts per board member across every open board, sorted highest to lowest.",
  "id": "trello-team-workload",
  "keywords": [
    "trello team workload",
    "assigned cards",
    "member workload",
    "idMembers",
    "kanban"
  ],
  "popularity": 60,
  "sizing": {
    "max": {
      "colSpan": 6,
      "rowSpan": 8
    },
    "min": {
      "colSpan": 3,
      "rowSpan": 5
    },
    "preferred": {
      "colSpan": 4,
      "rowSpan": 6
    }
  },
  "spec": {
    "elements": {
      "avatar": {
        "props": {
          "initials": {
            "$item": "initials"
          },
          "size": "md",
          "tone": {
            "$item": "avatar_tone"
          }
        },
        "type": "Avatar"
      },
      "bigStatGroup": {
        "children": [
          "statValue",
          "statLabel"
        ],
        "props": {
          "gap": "none"
        },
        "type": "Stack",
        "visible": {
          "$state": "/_loading/trello.get_team_workload",
          "not": true
        }
      },
      "card": {
        "children": [
          "headerRow",
          "loading",
          "bigStatGroup",
          "memberEmpty",
          "memberList",
          "footerRow"
        ],
        "props": {},
        "children": ["headerRow", "loading", "bigStatGroup", "memberEmpty", "memberList", "memberCardsDetailSection", "viewInTrelloRow"],
        "watch": {
          "/trello/get_team_workload/members": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/members",
                "value": {
                  "$computed": "trello_flatten_team_workload",
                  "args": {
                    "value": {
                      "$state": "/trello/get_team_workload/members"
                    }
                  }
                }
              }
            }
          ],
          "/ui/expandedMemberId": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/expandedMemberCards",
                "value": {
                  "$computed": "trello_find_member_cards",
                  "args": {
                    "members": { "$state": "/ui/members" },
                    "member_id": { "$state": "/ui/expandedMemberId" }
                  }
                }
              }
            }
          ]
        }
      },
      "countText": {
        "props": {
          "size": "sm",
          "text": {
            "$item": "count"
          },
          "weight": "semibold"
        },
        "type": "Text"
      },
      "eyebrow": {
        "props": {
          "text": "Trello"
        },
        "type": "Eyebrow"
      },
      "footerIcon": {
        "props": {
          "name": "Database",
          "size": "sm",
          "tone": "muted"
        },
        "type": "Icon"
      },
      "footerRow": {
        "children": [
          "footerIcon",
          "footerText"
        ],
        "props": {
          "align": "center",
          "gap": "xs"
        },
        "type": "Row"
      },
      "footerText": {
        "props": {
          "text": "Members endpoint + card idMembers fields",
          "tone": "muted"
        },
        "type": "Caption"
      },
      "headerRow": {
        "children": [
          "titleIcon",
          "titleStack"
        ],
        "props": {
          "align": "center",
          "gap": "sm"
        },
        "type": "Row"
      },
      "loading": {
        "children": [
          "sk1",
          "sk2",
          "sk3"
        ],
        "props": {
          "gap": "sm"
        },
        "type": "Stack",
        "visible": {
          "$state": "/_loading/trello.get_team_workload"
        }
      },
      "memberEmpty": {
        "props": {
          "message": "No cards assigned to any member."
        },
        "type": "Empty",
        "visible": {
          "$and": [
            {
              "$state": "/_loading/trello.get_team_workload",
              "not": true
            },
            {
              "$state": "/ui/members/0",
              "not": true
            }
          ]
        }
      },
      "memberList": {
        "children": [
          "memberRow"
        ],
        "props": {
          "gap": "sm"
        },
        "repeat": {
          "key": "member_id",
          "statePath": "/ui/members"
        },
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["memberRowCollapsed", "memberRowExpanded"],
        "repeat": { "statePath": "/ui/members", "key": "member_id" },
        "visible": { "$state": "/_loading/trello.get_team_workload", "not": true }
      },

      "memberRowCollapsed": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center", "clickable": true },
        "children": ["avatar", "memberStack"],
        "visible": { "$item": "member_id", "eq": { "$state": "/ui/expandedMemberId" }, "not": true },
        "on": {
          "click": {
            "action": "setState",
            "params": { "statePath": "/ui/expandedMemberId", "value": { "$bindItem": "member_id" } }
          }
        }
      },
      "memberRowExpanded": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center", "clickable": true },
        "children": ["avatarB", "memberStackB"],
        "visible": { "$item": "member_id", "eq": { "$state": "/ui/expandedMemberId" } },
        "on": {
          "click": {
            "action": "setState",
            "params": { "statePath": "/ui/expandedMemberId", "value": "" }
          }
        }
      },

      "avatar": {
        "type": "Avatar",
        "props": { "initials": { "$item": "initials" }, "tone": { "$item": "avatar_tone" }, "size": "md" }
      },
      "memberStack": {
        "type": "Stack",
        "props": { "gap": "xs", "grow": true },
        "children": ["nameCountRow", "progressBarRow"]
      },
      "progressBarRow": {
        "type": "Row",
        "props": {},
        "children": ["progressBar"]
      },
      "nameCountRow": {
        "children": [
          "nameText",
          "countText"
        ],
        "props": {
          "align": "center",
          "justify": "between"
        },
        "type": "Row"
      },
      "nameText": {
        "props": {
          "size": "sm",
          "text": {
            "$item": "name"
          },
          "truncate": true,
          "weight": "semibold"
        },
        "type": "Text"
      },
      "progressBar": {
        "props": {
          "tone": "info",
          "value": {
            "$item": "pct"
          }
        },
        "type": "ProgressBar"
      },

      "avatarB": {
        "type": "Avatar",
        "props": { "initials": { "$item": "initials" }, "tone": { "$item": "avatar_tone" }, "size": "md" }
      },
      "memberStackB": {
        "type": "Stack",
        "props": { "gap": "xs", "grow": true },
        "children": ["nameCountRowB", "progressBarRowB"]
      },
      "progressBarRowB": {
        "type": "Row",
        "props": {},
        "children": ["progressBarB"]
      },
      "nameCountRowB": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["nameTextB", "countTextB"]
      },
      "nameTextB": {
        "type": "Text",
        "props": { "text": { "$item": "name" }, "size": "sm", "weight": "semibold", "truncate": true }
      },
      "countTextB": {
        "type": "Text",
        "props": { "text": { "$item": "count" }, "size": "sm", "weight": "semibold" }
      },
      "progressBarB": {
        "type": "ProgressBar",
        "props": { "value": { "$item": "pct" }, "tone": "info" }
      },

      "memberCardsDetailSection": {
        "type": "Body",
        "props": {},
        "children": ["memberCardsDetailInner"],
        "visible": { "$state": "/ui/expandedMemberId" }
      },
      "memberCardsDetailInner": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["cardsDetailEmpty", "cardsDetailRepeatList"]
      },
      "cardsDetailEmpty": {
        "type": "Empty",
        "props": { "message": "No cards found for this member." },
        "visible": { "$state": "/ui/expandedMemberCards/0", "not": true }
      },
      "cardsDetailRepeatList": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["cardDetailRow"],
        "repeat": { "statePath": "/ui/expandedMemberCards", "key": "id" }
      },
      "cardDetailRow": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["cardDetailName", "cardDetailBoard"]
      },
      "cardDetailName": {
        "type": "Text",
        "props": { "text": { "$item": "name" }, "size": "sm", "truncate": true }
      },
      "cardDetailBoard": {
        "type": "Caption",
        "props": { "text": { "$item": "board_label" }, "tone": "muted", "truncate": true }
      },

      "viewInTrelloRow": {
        "type": "Row",
        "props": { "justify": "end" },
        "children": ["viewInTrelloButton"]
      },
      "viewInTrelloButton": {
        "type": "Button",
        "props": { "label": "View in Trello", "variant": "ghost", "size": "sm", "leadingIcon": "ExternalLink" },
        "on": {
          "click": { "action": "open_url", "params": { "url": "https://trello.com/b/tcjhGlBx/myimpact-qa-trello-tile-test-data", "target": "_blank" } }
        }
      }
    }
  },
  "tags": [
    "trello",
    "cards",
    "members",
    "workload",
    "team"
  ],
  "title": "Team Workload"
}
