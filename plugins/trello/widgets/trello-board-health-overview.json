{
  "id": "trello-board-health-overview",
  "title": "Board Health Overview",
  "description": "Fleet-wide Trello health: completion rate, active boards, and lists/cards tracked across every board.",
  "category": "projects",
  "tags": ["trello", "boards", "lists", "cards", "health", "overview"],
  "keywords": ["trello health", "board overview", "completion rate", "active boards", "kanban"],
  "connectorsUsed": ["trello"],
  "brandColor": "#34DFBA",
  "popularity": 65,
  "sizing": {
    "preferred": { "colSpan": 4, "rowSpan": 6 },
    "min": { "colSpan": 3, "rowSpan": 5 },
    "max": { "colSpan": 6, "rowSpan": 8 }
  },
  "dataProvider": {
    "mcp": "trello",
    "tool": "get_boards_health_summary",
    "params": {}
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": ["headerRow", "div0", "loading", "ringStatRow", "div1", "listsCardsRowCollapsed", "listsCardsRowExpanded", "listsDetailSection", "div2", "footerRow"],
        "watch": {
          "/trello/list_all_lists/data": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/listsRows",
                "value": {
                  "$computed": "trello_flatten_all_lists",
                  "args": { "value": { "$state": "/trello/list_all_lists/data" } }
                }
              }
            }
          ]
        }
      },

      "headerRow": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": { "type": "Icon", "props": { "name": "Columns3", "tone": "brand", "size": "sm" } },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "eyebrow"]
      },
      "title": { "type": "Heading", "props": { "text": "Board Health Overview", "level": "h2" } },
      "eyebrow": { "type": "Eyebrow", "props": { "text": "Trello" } },

      "div0": { "type": "Divider", "props": {} },

      "loading": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["sk1", "sk2"],
        "visible": { "$state": "/_loading/trello.get_boards_health_summary" }
      },
      "sk1": { "type": "Skeleton", "props": { "height": "9rem", "rounded": "md" } },
      "sk2": { "type": "Skeleton", "props": { "height": "2rem", "rounded": "md" } },

      "ringStatRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center", "gap": "md" },
        "children": ["ringGroup", "statGroup"],
        "visible": { "$state": "/_loading/trello.get_boards_health_summary", "not": true }
      },

      "ringGroup": {
        "type": "Stack",
        "props": { "gap": "xs", "align": "center" },
        "children": ["donut"]
      },
      "donut": {
        "type": "Donut",
        "props": {
          "segments": [
            { "label": "Complete", "value": { "$state": "/trello/get_boards_health_summary/completed_due_cards" }, "tone": "success" },
            { "label": "Remaining", "value": { "$state": "/trello/get_boards_health_summary/remaining_due_cards" }, "tone": "muted" }
          ],
          "centerLabel": "tracked",
          "size": 96,
          "thickness": 12
        }
      },

      "statGroup": {
        "type": "Stack",
        "props": { "gap": "none", "align": "center" },
        "children": ["statValue", "statLabel"]
      },
      "statValue": {
        "type": "Stat",
        "props": { "value": { "$state": "/trello/get_boards_health_summary/active_board_count" }, "size": "lg" }
      },
      "statLabel": { "type": "Caption", "props": { "text": "Active boards", "tone": "brand" } },

      "div1": {
        "type": "Divider",
        "props": {},
        "visible": { "$state": "/_loading/trello.get_boards_health_summary", "not": true }
      },

      "listsCardsRowCollapsed": {
        "type": "Row",
        "props": { "justify": "between", "align": "center", "clickable": true },
        "children": ["listsCardsLeftGroup", "listsChevronDown"],
        "visible": {
          "$and": [
            { "$state": "/_loading/trello.get_boards_health_summary", "not": true },
            { "$state": "/ui/listsExpanded", "not": true }
          ]
        },
        "on": {
          "click": [
            { "action": "setState", "params": { "statePath": "/ui/listsExpanded", "value": true } },
            { "action": "trello.list_all_lists", "params": {} }
          ]
        }
      },
      "listsCardsRowExpanded": {
        "type": "Row",
        "props": { "justify": "between", "align": "center", "clickable": true },
        "children": ["listsCardsLeftGroupExpanded", "listsChevronUp"],
        "visible": {
          "$and": [
            { "$state": "/_loading/trello.get_boards_health_summary", "not": true },
            { "$state": "/ui/listsExpanded" }
          ]
        },
        "on": {
          "click": [
            { "action": "setState", "params": { "statePath": "/ui/listsExpanded", "value": false } }
          ]
        }
      },
      "listsCardsLeftGroup": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["listsCardsIcon", "listsCardsText"]
      },
      "listsCardsLeftGroupExpanded": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["listsCardsIconExpanded", "listsCardsTextExpanded"]
      },
      "listsCardsIcon": { "type": "Icon", "props": { "name": "Rows3", "tone": "brand", "size": "sm" } },
      "listsCardsIconExpanded": { "type": "Icon", "props": { "name": "Rows3", "tone": "brand", "size": "sm" } },
      "listsCardsText": {
        "type": "Text",
        "props": {
          "text": { "$computed": "trello_format_lists_cards_summary", "args": { "value": { "$state": "/trello/get_boards_health_summary" } } },
          "size": "sm",
          "tone": "muted"
        }
      },
      "listsCardsTextExpanded": {
        "type": "Text",
        "props": {
          "text": { "$computed": "trello_format_lists_cards_summary", "args": { "value": { "$state": "/trello/get_boards_health_summary" } } },
          "size": "sm",
          "tone": "muted"
        }
      },
      "listsChevronDown": { "type": "Icon", "props": { "name": "ChevronDown", "tone": "muted", "size": "sm" } },
      "listsChevronUp": { "type": "Icon", "props": { "name": "ChevronUp", "tone": "muted", "size": "sm" } },

      "listsDetailSection": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["listsLoading", "listsEmpty", "listsRepeatList"],
        "visible": { "$state": "/ui/listsExpanded" }
      },
      "listsLoading": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["listsSk1", "listsSk2", "listsSk3"],
        "visible": { "$state": "/_loading/trello.list_all_lists" }
      },
      "listsSk1": { "type": "Skeleton", "props": { "height": "1.5rem", "rounded": "md" } },
      "listsSk2": { "type": "Skeleton", "props": { "height": "1.5rem", "rounded": "md" } },
      "listsSk3": { "type": "Skeleton", "props": { "height": "1.5rem", "rounded": "md" } },
      "listsEmpty": {
        "type": "Empty",
        "props": { "message": "No open lists found." },
        "visible": {
          "$and": [
            { "$state": "/_loading/trello.list_all_lists", "not": true },
            { "$state": "/ui/listsRows/0", "not": true }
          ]
        }
      },
      "listsRepeatList": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["listRow"],
        "repeat": { "statePath": "/ui/listsRows", "key": "id" },
        "visible": { "$state": "/_loading/trello.list_all_lists", "not": true }
      },
      "listRow": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["listRowName", "listRowBoard"]
      },
      "listRowName": {
        "type": "Text",
        "props": { "text": { "$item": "name" }, "size": "sm", "truncate": true }
      },
      "listRowBoard": {
        "type": "Caption",
        "props": { "text": { "$item": "board_label" }, "tone": "muted", "truncate": true }
      },

      "div2": {
        "type": "Divider",
        "props": {},
        "visible": { "$state": "/_loading/trello.get_boards_health_summary", "not": true }
      },

      "footerRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["footerGroup", "footerChevron"]
      },
      "footerGroup": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["footerIcon", "footerText"]
      },
      "footerIcon": { "type": "Icon", "props": { "name": "Database", "tone": "muted", "size": "sm" } },
      "footerText": { "type": "Caption", "props": { "text": "Boards, Lists & Cards endpoints", "tone": "muted" } },
      "footerChevron": { "type": "Icon", "props": { "name": "ChevronRight", "tone": "muted", "size": "sm" } }
    }
  },
  "status": "published"
}
