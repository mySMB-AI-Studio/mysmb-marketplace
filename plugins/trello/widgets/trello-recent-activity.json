{
  "id": "trello-recent-activity",
  "title": "Recent Activity",
  "description": "Recent board activity across every open board — cards created, commented on, and moved — searchable by person or card.",
  "category": "tasks",
  "tags": ["trello", "activity", "audit log", "actions", "feed"],
  "keywords": ["trello recent activity", "activity feed", "audit log", "board actions"],
  "connectorsUsed": ["trello"],
  "popularity": 60,
  "sizing": {
    "preferred": { "colSpan": 4, "rowSpan": 6 },
    "min": { "colSpan": 3, "rowSpan": 5 },
    "max": { "colSpan": 6, "rowSpan": 8 }
  },
  "dataProvider": {
    "mcp": "trello",
    "tool": "get_recent_activity",
    "params": {}
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": ["headerRow", "filterRow", "body", "viewInTrelloRow"],
        "watch": {
          "/trello/get_recent_activity/actions": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/activity",
                "value": {
                  "$computed": "trello_flatten_recent_activity",
                  "args": {
                    "value": { "$state": "/trello/get_recent_activity/actions" },
                    "search": { "$state": "/ui/search" },
                    "person": { "$state": "/ui/personFilter" }
                  }
                }
              }
            }
          ],
          "/ui/search": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/activity",
                "value": {
                  "$computed": "trello_flatten_recent_activity",
                  "args": {
                    "value": { "$state": "/trello/get_recent_activity/actions" },
                    "search": { "$state": "/ui/search" },
                    "person": { "$state": "/ui/personFilter" }
                  }
                }
              }
            }
          ],
          "/ui/personFilter": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/activity",
                "value": {
                  "$computed": "trello_flatten_recent_activity",
                  "args": {
                    "value": { "$state": "/trello/get_recent_activity/actions" },
                    "search": { "$state": "/ui/search" },
                    "person": { "$state": "/ui/personFilter" }
                  }
                }
              }
            }
          ]
        }
      },

      "headerRow": {
        "type": "Row",
        "props": { "align": "center" },
        "children": ["titleGroup"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": { "type": "Icon", "props": { "name": "Activity", "tone": "warning", "size": "sm" } },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "eyebrow"]
      },
      "title": { "type": "Heading", "props": { "text": "Recent Activity", "level": "h2" } },
      "eyebrow": { "type": "Eyebrow", "props": { "text": "Trello" } },

      "filterRow": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["searchInput", "personFilter"],
        "visible": { "$state": "/_loading/trello.get_recent_activity", "not": true }
      },
      "searchInput": {
        "type": "TextInput",
        "props": {
          "value": { "$bindState": "/ui/search" },
          "placeholder": "Search activity",
          "size": "sm",
          "debounce": 150
        }
      },
      "personFilter": {
        "type": "Select",
        "props": {
          "value": { "$bindState": "/ui/personFilter" },
          "options": { "$state": "/ui/peopleOptions" },
          "ariaLabel": "Filter by person",
          "size": "sm"
        },
        "watch": {
          "/trello/get_recent_activity/actions": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/peopleOptions",
                "value": {
                  "$computed": "trello_list_activity_people",
                  "args": { "value": { "$state": "/trello/get_recent_activity/actions" } }
                }
              }
            }
          ]
        }
      },

      "body": {
        "type": "Body",
        "props": {},
        "children": ["loading", "activityEmpty", "activityRepeatList"]
      },

      "loading": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["sk1", "sk2", "sk3"],
        "visible": { "$state": "/_loading/trello.get_recent_activity" }
      },
      "sk1": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "sk2": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "sk3": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },

      "activityEmpty": {
        "type": "Empty",
        "props": {
          "message": {
            "$cond": {
              "$or": [
                { "$state": "/ui/search", "neq": "" },
                { "$state": "/ui/personFilter", "neq": "" }
              ]
            },
            "$then": "No activity matches your search or filter.",
            "$else": "No recent activity."
          }
        },
        "visible": {
          "$and": [
            { "$state": "/_loading/trello.get_recent_activity", "not": true },
            { "$state": "/ui/activity/0", "not": true }
          ]
        }
      },
      "activityRepeatList": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["activityRow"],
        "repeat": { "statePath": "/ui/activity", "key": "id" },
        "visible": { "$state": "/_loading/trello.get_recent_activity", "not": true }
      },
      "activityRow": {
        "type": "Row",
        "props": { "gap": "sm", "align": "start" },
        "children": ["activityDot", "activityInfo"]
      },
      "activityDot": { "type": "Dot", "props": { "tone": { "$item": "actor_tone" }, "size": "sm" } },
      "activityInfo": {
        "type": "Stack",
        "props": { "gap": "none", "grow": true },
        "children": ["activityTextRow", "activityTimeRow"]
      },
      "activityTextRow": {
        "type": "Row",
        "props": { "gap": "xs", "align": "baseline" },
        "children": ["activityActorName", "activityActionText"]
      },
      "activityActorName": {
        "type": "Text",
        "props": { "text": { "$item": "actor_name" }, "size": "sm", "weight": "semibold" }
      },
      "activityActionText": {
        "type": "Text",
        "props": { "text": { "$item": "action_text" }, "size": "sm", "truncate": true }
      },
      "activityTimeRow": {
        "type": "Row",
        "props": { "gap": "xs", "align": "baseline" },
        "children": ["activityTime", "activityDateSep", "activityDate"]
      },
      "activityTime": {
        "type": "Caption",
        "props": { "text": { "$computed": "relative_time", "args": { "value": { "$item": "date" } } }, "tone": "muted" }
      },
      "activityDateSep": {
        "type": "Caption",
        "props": { "text": "·", "tone": "muted" }
      },
      "activityDate": {
        "type": "Caption",
        "props": {
          "text": { "$computed": "trello_format_activity_date", "args": { "value": { "$item": "date" } } },
          "tone": "muted"
        }
      },

      "viewInTrelloRow": {
        "type": "Row",
        "props": { "justify": "end" },
        "children": ["viewInTrelloButton"]
      },
      "viewInTrelloButton": {
        "type": "Button",
        "props": { "label": "View in Trello", "variant": "ghost", "size": "sm", "leadingIcon": "ExternalLink" },
        "on": {
          "click": { "action": "open_url", "params": { "url": "https://trello.com/b/tcjhGlBx/myimpact-qa-trello-tile-test-data", "target": "_blank" } }
        }
      }
    }
  },
  "status": "published"
}
