{
  "id": "sprout-employee-directory",
  "title": "Sprout — Employee directory",
  "description": "Browse your Sprout employees with name and employee number.",
  "category": "hr",
  "tags": ["sprout", "hr", "employees", "201", "directory"],
  "keywords": ["staff", "people", "headcount", "employee list", "team"],
  "connectorsUsed": ["sprout-employee"],
  "popularity": 70,
  "sizing": {
    "preferred": { "colSpan": 6, "rowSpan": 6 },
    "min": { "colSpan": 4, "rowSpan": 4 },
    "max": { "colSpan": 12, "rowSpan": 12 }
  },
  "dataProvider": {
    "mcp": "sprout-employee",
    "tool": "list_employees",
    "params": { "RowsPerPage": 25, "SortColumn": "lastName", "SortOrder": "asc" }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": { "type": "Card", "props": {}, "children": ["header", "body"] },
      "header": { "type": "Header", "props": {}, "children": ["headerRow"] },
      "headerRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["titleGroup", "refreshBtn"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": { "type": "Icon", "props": { "name": "Users", "tone": "accent", "size": "sm" } },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "count"]
      },
      "title": { "type": "Heading", "props": { "text": "Employees", "level": "h2" } },
      "count": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{n} total",
              "n": { "$state": "/sprout-employee/list_employees/pagination/totalItems" }
            }
          }
        }
      },
      "refreshBtn": {
        "type": "IconButton",
        "props": { "name": "RefreshCw", "size": "sm", "ariaLabel": "Refresh" },
        "on": {
          "click": {
            "action": "sprout-employee.list_employees",
            "params": { "RowsPerPage": 25, "SortColumn": "lastName", "SortOrder": "asc" }
          }
        }
      },
      "body": { "type": "Body", "props": {}, "children": ["loading", "empty", "list"] },
      "loading": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["lk1", "lk2", "lk3", "lk4"],
        "visible": { "$state": "/_loading/sprout-employee.list_employees" }
      },
      "lk1": { "type": "Skeleton", "props": { "height": "3rem", "rounded": "md" } },
      "lk2": { "type": "Skeleton", "props": { "height": "3rem", "rounded": "md" } },
      "lk3": { "type": "Skeleton", "props": { "height": "3rem", "rounded": "md" } },
      "lk4": { "type": "Skeleton", "props": { "height": "3rem", "rounded": "md" } },
      "empty": {
        "type": "Empty",
        "props": { "message": "No employees found." },
        "visible": {
          "$and": [
            { "$state": "/_loading/sprout-employee.list_employees", "not": true },
            { "$state": "/sprout-employee/list_employees/data/0", "not": true }
          ]
        }
      },
      "list": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["row"],
        "repeat": { "statePath": "/sprout-employee/list_employees/data", "key": "basicInformation/employeeId" },
        "visible": { "$state": "/_loading/sprout-employee.list_employees", "not": true }
      },
      "row": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center", "template": "auto minmax(0, 1fr) auto" },
        "children": ["rowAvatar", "rowIdentity", "rowEmpId"]
      },
      "rowAvatar": {
        "type": "Avatar",
        "props": {
          "initials": {
            "$computed": "initials",
            "args": {
              "value": {
                "$computed": "fmt",
                "args": {
                  "pattern": "{f} {l}",
                  "f": { "$item": "basicInformation/firstName" },
                  "l": { "$item": "basicInformation/lastName" }
                }
              }
            }
          },
          "tone": "info",
          "size": "md"
        }
      },
      "rowIdentity": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["rowName", "rowSub"]
      },
      "rowName": {
        "type": "Text",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{f} {l}",
              "f": { "$item": "basicInformation/firstName" },
              "l": { "$item": "basicInformation/lastName" }
            }
          },
          "size": "sm",
          "weight": "medium",
          "truncate": true
        }
      },
      "rowSub": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": { "pattern": "ID {id}", "id": { "$item": "basicInformation/employeeId" } }
          }
        }
      },
      "rowEmpId": {
        "type": "Icon",
        "props": { "name": "ChevronRight", "tone": "muted", "size": "sm" }
      }
    }
  },
  "status": "published"
}
