{
  "id": "sprout-companies",
  "title": "Sprout — Companies",
  "description": "Companies in your Sprout account and their payroll-sync status.",
  "category": "hr",
  "tags": ["sprout", "hr", "companies", "organization"],
  "keywords": ["company list", "entities", "org", "payroll sync"],
  "connectorsUsed": ["sprout-hr-general"],
  "popularity": 60,
  "sizing": {
    "preferred": { "colSpan": 5, "rowSpan": 5 },
    "min": { "colSpan": 4, "rowSpan": 4 },
    "max": { "colSpan": 12, "rowSpan": 10 }
  },
  "dataProvider": {
    "mcp": "sprout-hr-general",
    "tool": "list_companies",
    "params": { "RowsPerPage": 50 }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": { "type": "Card", "props": {}, "children": ["header", "body"] },
      "header": { "type": "Header", "props": {}, "children": ["headerRow"] },
      "headerRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["titleGroup", "refreshBtn"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": { "type": "Icon", "props": { "name": "Building2", "tone": "accent", "size": "sm" } },
      "titleStack": { "type": "Stack", "props": { "gap": "none" }, "children": ["title", "count"] },
      "title": { "type": "Heading", "props": { "text": "Companies", "level": "h2" } },
      "count": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{n} total",
              "n": { "$state": "/sprout-hr-general/list_companies/pagination/totalItems" }
            }
          }
        }
      },
      "refreshBtn": {
        "type": "IconButton",
        "props": { "name": "RefreshCw", "size": "sm", "ariaLabel": "Refresh" },
        "on": { "click": { "action": "sprout-hr-general.list_companies", "params": { "RowsPerPage": 50 } } }
      },
      "body": { "type": "Body", "props": {}, "children": ["loading", "empty", "list"] },
      "loading": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["lk1", "lk2", "lk3"],
        "visible": { "$state": "/_loading/sprout-hr-general.list_companies" }
      },
      "lk1": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "lk2": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "lk3": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "empty": {
        "type": "Empty",
        "props": { "message": "No companies found." },
        "visible": {
          "$and": [
            { "$state": "/_loading/sprout-hr-general.list_companies", "not": true },
            { "$state": "/sprout-hr-general/list_companies/data/0", "not": true }
          ]
        }
      },
      "list": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["row"],
        "repeat": { "statePath": "/sprout-hr-general/list_companies/data", "key": "id" },
        "visible": { "$state": "/_loading/sprout-hr-general.list_companies", "not": true }
      },
      "row": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center", "template": "minmax(0, 1fr) auto" },
        "children": ["rowName", "rowStatus"]
      },
      "rowName": {
        "type": "Text",
        "props": { "text": { "$item": "companyName" }, "size": "sm", "weight": "medium", "truncate": true }
      },
      "rowStatus": {
        "type": "Badge",
        "props": {
          "text": {
            "$cond": { "$item": "payrollSyncDetails/isConnected", "eq": true },
            "$then": "Payroll connected",
            "$else": "Not connected"
          },
          "tone": {
            "$cond": { "$item": "payrollSyncDetails/isConnected", "eq": true },
            "$then": "success",
            "$else": "neutral"
          },
          "variant": "soft"
        }
      }
    }
  },
  "status": "published"
}
