{
  "id": "surepact-grants-explorer",
  "title": "Grants Explorer",
  "description": "Full-width table of Australian grants for a chosen state — title, funding amount, opening and closing dates, and eligible locations. Built for scanning a long list side by side.",
  "category": "grants",
  "tags": [
    "surepact",
    "grants",
    "funding",
    "government",
    "australia",
    "table",
    "explorer"
  ],
  "keywords": [
    "grants",
    "grant table",
    "funding",
    "browse grants",
    "compare grants",
    "explorer",
    "eligibility"
  ],
  "connectorsUsed": ["surepact-grants"],
  "brandColor": "#1D4ED8",
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 12, "rowSpan": 6 },
    "min": { "colSpan": 6, "rowSpan": 4 },
    "max": { "colSpan": 12, "rowSpan": 12 }
  },
  "dataProvider": {
    "mcp": "surepact-grants",
    "tool": "surepact_search_grants",
    "params": { "state": "NSW", "count": 50 }
  },
  "status": "published",
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": ["header", "body"]
      },

      "header": {
        "type": "Header",
        "props": {},
        "children": ["headerRow"]
      },
      "headerRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["titleGroup", "headerActions"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "Landmark", "tone": "accent", "size": "sm" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "subtitle"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Grants explorer", "level": "h2" }
      },
      "subtitle": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "Showing {n} · {state}",
              "n": { "$state": "/surepact-grants/surepact_search_grants/count" },
              "state": { "$state": "/surepact-grants/surepact_search_grants/state" }
            }
          }
        }
      },

      "headerActions": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["statePicker", "refreshBtn"]
      },
      "statePicker": {
        "type": "Select",
        "props": {
          "value": { "$bindState": "/ui/state" },
          "options": [
            { "value": "NSW", "label": "New South Wales" },
            { "value": "VIC", "label": "Victoria" },
            { "value": "QLD", "label": "Queensland" },
            { "value": "WA", "label": "Western Australia" },
            { "value": "SA", "label": "South Australia" },
            { "value": "TAS", "label": "Tasmania" },
            { "value": "ACT", "label": "Aust. Capital Territory" },
            { "value": "NT", "label": "Northern Territory" }
          ],
          "placeholder": "State…",
          "ariaLabel": "State or territory",
          "size": "sm"
        },
        "on": {
          "change": [
            {
              "action": "bust_tool_cache",
              "params": {
                "mcp": "surepact-grants",
                "tool": "surepact_search_grants"
              }
            },
            {
              "action": "surepact-grants.surepact_search_grants",
              "params": {
                "state": { "$state": "/ui/state" },
                "count": 50
              }
            }
          ]
        }
      },
      "refreshBtn": {
        "type": "IconButton",
        "props": {
          "icon": "RefreshCw",
          "tone": "muted",
          "size": "sm",
          "ariaLabel": "Refresh"
        },
        "on": {
          "click": [
            {
              "action": "bust_tool_cache",
              "params": {
                "mcp": "surepact-grants",
                "tool": "surepact_search_grants"
              }
            },
            {
              "action": "surepact-grants.surepact_search_grants",
              "params": {
                "state": { "$state": "/ui/state" },
                "count": 50
              }
            }
          ]
        }
      },

      "body": {
        "type": "Body",
        "props": {},
        "children": ["empty", "table"]
      },

      "empty": {
        "type": "Empty",
        "props": {
          "message": "No grants currently listed for this state."
        },
        "visible": {
          "$and": [
            {
              "$state": "/_loading/surepact-grants.surepact_search_grants",
              "not": true
            },
            {
              "$state": "/surepact-grants/surepact_search_grants/grants/0",
              "not": true
            }
          ]
        }
      },

      "table": {
        "type": "Table",
        "props": {
          "rows": {
            "$state": "/surepact-grants/surepact_search_grants/grants"
          },
          "loading": {
            "$state": "/_loading/surepact-grants.surepact_search_grants"
          },
          "skeletonRows": 8,
          "columns": [
            {
              "id": "title",
              "header": "Grant",
              "field": "title",
              "priority": 1,
              "width": 340
            },
            {
              "id": "fundingAmount",
              "header": "Funding",
              "field": "fundingAmount",
              "align": "right",
              "priority": 1,
              "width": 140
            },
            {
              "id": "closeDate",
              "header": "Closes",
              "field": "closeDate",
              "priority": 2,
              "width": 180
            },
            {
              "id": "openDate",
              "header": "Opens",
              "field": "openDate",
              "priority": 3,
              "width": 130
            },
            {
              "id": "location",
              "header": "Eligible locations",
              "field": "location",
              "priority": 3,
              "width": 200
            }
          ]
        }
      }
    }
  }
}
