{
  "id": "surepact-grant-opportunities",
  "title": "Grant Opportunities",
  "description": "Australian government and community grants currently listed, filtered by location — funding amount, closing date and a short summary per grant, with a location picker to switch jurisdictions.",
  "category": "grants",
  "tags": [
    "surepact",
    "grants",
    "funding",
    "government",
    "australia",
    "opportunities"
  ],
  "keywords": [
    "grants",
    "grant",
    "funding",
    "government funding",
    "opportunities",
    "apply",
    "subsidy"
  ],
  "connectorsUsed": ["surepact-grants"],
  "brandColor": "#1c1a45",
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 6, "rowSpan": 6 },
    "min": { "colSpan": 4, "rowSpan": 4 },
    "max": { "colSpan": 12, "rowSpan": 12 }
  },
  "dataProvider": {
    "mcp": "surepact-grants",
    "tool": "surepact_search_grants",
    "params": { "state": "NSW", "count": 25 }
  },
  "status": "published",
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": ["header", "body"]
      },

      "header": {
        "type": "Header",
        "props": {},
        "children": ["titleGroup"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "start" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "Landmark", "tone": "accent", "size": "sm" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "subtitle"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Grant opportunities", "level": "h2" }
      },
      "subtitle": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{n} results · {state}",
              "n": { "$state": "/surepact-grants/surepact_search_grants/count" },
              "state": { "$state": "/surepact-grants/surepact_search_grants/state" }
            }
          }
        }
      },

      "body": {
        "type": "Body",
        "props": {},
        "children": ["controls", "loading", "empty", "list", "footer"]
      },

      "controls": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center", "justify": "between" },
        "children": ["controlsLeft", "refreshBtn"]
      },
      "controlsLeft": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["locationLabel", "statePicker"]
      },
      "locationLabel": {
        "type": "Caption",
        "props": { "text": "Location", "tone": "muted" }
      },
      "statePicker": {
        "type": "Select",
        "props": {
          "value": { "$bindState": "/ui/state" },
          "options": [
            { "value": "NSW", "label": "New South Wales" },
            { "value": "VIC", "label": "Victoria" },
            { "value": "QLD", "label": "Queensland" },
            { "value": "WA", "label": "Western Australia" },
            { "value": "SA", "label": "South Australia" },
            { "value": "TAS", "label": "Tasmania" },
            { "value": "ACT", "label": "Aust. Capital Territory" },
            { "value": "NT", "label": "Northern Territory" }
          ],
          "placeholder": "New South Wales",
          "ariaLabel": "State or territory",
          "size": "sm"
        },
        "on": {
          "change": [
            {
              "action": "bust_tool_cache",
              "params": {
                "mcp": "surepact-grants",
                "tool": "surepact_search_grants"
              }
            },
            {
              "action": "surepact-grants.surepact_search_grants",
              "params": {
                "state": { "$state": "/ui/state" },
                "count": 25
              }
            }
          ]
        }
      },
      "refreshBtn": {
        "type": "IconButton",
        "props": {
          "icon": "RefreshCw",
          "tone": "muted",
          "size": "sm",
          "ariaLabel": "Refresh grants"
        },
        "on": {
          "click": [
            {
              "action": "bust_tool_cache",
              "params": {
                "mcp": "surepact-grants",
                "tool": "surepact_search_grants"
              }
            },
            {
              "action": "surepact-grants.surepact_search_grants",
              "params": {
                "state": { "$state": "/ui/state" },
                "count": 25
              }
            }
          ]
        }
      },

      "loading": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "visible": {
          "$state": "/_loading/surepact-grants.surepact_search_grants"
        },
        "children": ["sk1", "sk2", "sk3", "sk4"]
      },
      "sk1": { "type": "Skeleton", "props": { "height": "4rem", "rounded": "md" } },
      "sk2": { "type": "Skeleton", "props": { "height": "4rem", "rounded": "md" } },
      "sk3": { "type": "Skeleton", "props": { "height": "4rem", "rounded": "md" } },
      "sk4": { "type": "Skeleton", "props": { "height": "4rem", "rounded": "md" } },

      "empty": {
        "type": "Empty",
        "props": {
          "message": "No grants currently listed for this location. Try another jurisdiction."
        },
        "visible": {
          "$and": [
            {
              "$state": "/_loading/surepact-grants.surepact_search_grants",
              "not": true
            },
            {
              "$state": "/surepact-grants/surepact_search_grants/grants/0",
              "not": true
            }
          ]
        }
      },

      "list": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "visible": {
          "$state": "/_loading/surepact-grants.surepact_search_grants",
          "not": true
        },
        "repeat": {
          "statePath": "/surepact-grants/surepact_search_grants/grants",
          "key": "title"
        },
        "children": ["resultCard"]
      },

      "resultCard": {
        "type": "Section",
        "props": { "variant": "bordered" },
        "children": ["resultStack"]
      },
      "resultStack": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["resultBadgeRow", "resultTitle", "resultDesc", "resultMetaRow"]
      },
      "resultBadgeRow": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["resultLocationBadge"]
      },
      "resultLocationBadge": {
        "type": "Badge",
        "props": {
          "text": { "$item": "location" },
          "tone": "accent",
          "variant": "soft"
        }
      },
      "resultTitle": {
        "type": "Heading",
        "props": { "text": { "$item": "title" }, "level": "h3", "wrap": true }
      },
      "resultDesc": {
        "type": "Text",
        "props": {
          "text": { "$item": "description" },
          "size": "sm",
          "tone": "muted",
          "truncate": true
        }
      },
      "resultMetaRow": {
        "type": "Row",
        "props": { "gap": "md", "align": "center", "justify": "start" },
        "children": ["metaFunding", "metaClosing"]
      },
      "metaFunding": {
        "type": "KeyValue",
        "props": { "label": "Funding", "value": { "$item": "fundingAmount" } }
      },
      "metaClosing": {
        "type": "KeyValue",
        "props": { "label": "Closing", "value": { "$item": "closeDate" } }
      },

      "footer": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center", "justify": "between" },
        "visible": {
          "$state": "/_loading/surepact-grants.surepact_search_grants",
          "not": true
        },
        "children": ["footerNote", "visitBtn"]
      },
      "footerNote": {
        "type": "Caption",
        "props": { "text": "Grant data from SurePact" }
      },
      "visitBtn": {
        "type": "Button",
        "props": {
          "label": "Open in SurePact",
          "variant": "ghost",
          "size": "sm",
          "leadingIcon": "ExternalLink"
        },
        "on": {
          "click": {
            "action": "open_url",
            "params": { "url": "https://surepact.com/for-recipients/" }
          }
        }
      }
    }
  }
}
