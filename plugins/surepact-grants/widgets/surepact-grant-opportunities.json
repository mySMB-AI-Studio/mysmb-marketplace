{
  "id": "surepact-grant-opportunities",
  "title": "Grant Opportunities",
  "description": "Australian government and community grants currently open, filtered by state — funding amount and closing date at a glance, with a state picker to switch jurisdictions.",
  "category": "grants",
  "tags": [
    "surepact",
    "grants",
    "funding",
    "government",
    "australia",
    "opportunities"
  ],
  "keywords": [
    "grants",
    "grant",
    "funding",
    "government funding",
    "opportunities",
    "apply",
    "subsidy"
  ],
  "connectorsUsed": ["surepact-grants"],
  "brandColor": "#1D4ED8",
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 6, "rowSpan": 6 },
    "min": { "colSpan": 4, "rowSpan": 4 },
    "max": { "colSpan": 12, "rowSpan": 12 }
  },
  "dataProvider": {
    "mcp": "surepact-grants",
    "tool": "surepact_search_grants",
    "params": { "state": "NSW", "count": 25 }
  },
  "status": "published",
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": ["header", "body"]
      },

      "header": {
        "type": "Header",
        "props": {},
        "children": ["headerRow"]
      },
      "headerRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["titleGroup", "headerActions"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "Landmark", "tone": "accent", "size": "sm" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "count"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Grant opportunities", "level": "h2" }
      },
      "count": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "Showing {n} · {state}",
              "n": { "$state": "/surepact-grants/surepact_search_grants/count" },
              "state": { "$state": "/surepact-grants/surepact_search_grants/state" }
            }
          }
        }
      },

      "headerActions": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["statePicker", "refreshBtn"]
      },
      "statePicker": {
        "type": "Select",
        "props": {
          "value": { "$bindState": "/ui/state" },
          "options": [
            { "value": "NSW", "label": "New South Wales" },
            { "value": "VIC", "label": "Victoria" },
            { "value": "QLD", "label": "Queensland" },
            { "value": "WA", "label": "Western Australia" },
            { "value": "SA", "label": "South Australia" },
            { "value": "TAS", "label": "Tasmania" },
            { "value": "ACT", "label": "Aust. Capital Territory" },
            { "value": "NT", "label": "Northern Territory" }
          ],
          "placeholder": "State…",
          "ariaLabel": "State or territory",
          "size": "sm"
        },
        "on": {
          "change": [
            {
              "action": "bust_tool_cache",
              "params": {
                "mcp": "surepact-grants",
                "tool": "surepact_search_grants"
              }
            },
            {
              "action": "surepact-grants.surepact_search_grants",
              "params": {
                "state": { "$state": "/ui/state" },
                "count": 25
              }
            }
          ]
        }
      },
      "refreshBtn": {
        "type": "IconButton",
        "props": {
          "icon": "RefreshCw",
          "tone": "muted",
          "size": "sm",
          "ariaLabel": "Refresh"
        },
        "on": {
          "click": [
            {
              "action": "bust_tool_cache",
              "params": {
                "mcp": "surepact-grants",
                "tool": "surepact_search_grants"
              }
            },
            {
              "action": "surepact-grants.surepact_search_grants",
              "params": {
                "state": { "$state": "/ui/state" },
                "count": 25
              }
            }
          ]
        }
      },

      "body": {
        "type": "Body",
        "props": {},
        "children": ["loading", "empty", "list"]
      },

      "loading": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "visible": {
          "$state": "/_loading/surepact-grants.surepact_search_grants"
        },
        "children": ["sk1", "sk2", "sk3", "sk4"]
      },
      "sk1": { "type": "Skeleton", "props": { "height": "3rem", "rounded": "md" } },
      "sk2": { "type": "Skeleton", "props": { "height": "3rem", "rounded": "md" } },
      "sk3": { "type": "Skeleton", "props": { "height": "3rem", "rounded": "md" } },
      "sk4": { "type": "Skeleton", "props": { "height": "3rem", "rounded": "md" } },

      "empty": {
        "type": "Empty",
        "props": {
          "message": "No grants currently listed for this state."
        },
        "visible": {
          "$and": [
            {
              "$state": "/_loading/surepact-grants.surepact_search_grants",
              "not": true
            },
            {
              "$state": "/surepact-grants/surepact_search_grants/grants/0",
              "not": true
            }
          ]
        }
      },

      "list": {
        "type": "Stack",
        "props": { "gap": "none" },
        "visible": {
          "$state": "/_loading/surepact-grants.surepact_search_grants",
          "not": true
        },
        "repeat": {
          "statePath": "/surepact-grants/surepact_search_grants/grants",
          "key": "title"
        },
        "children": ["row"]
      },
      "row": {
        "type": "ListItem",
        "props": {
          "title": { "$item": "title" },
          "subtitle": {
            "$computed": "fmt",
            "args": {
              "pattern": "Closes {close} · {location}",
              "close": { "$item": "closeDate" },
              "location": { "$item": "location" }
            }
          },
          "value": { "$item": "fundingAmount" },
          "valueHint": "funding"
        }
      }
    }
  }
}
