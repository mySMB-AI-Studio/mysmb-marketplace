{
  "id": "talkdesk-qa-scorecard",
  "title": "Call QA Scorecard",
  "description": "Recent Talkdesk call QA scores — pass/fail breakdown per agent.",
  "category": "support",
  "tags": ["talkdesk", "qa", "calls", "scoring", "support"],
  "keywords": ["call quality", "qa score", "talkdesk", "agent performance", "pass", "fail"],
  "connectorsUsed": ["talkdesk"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 5, "rowSpan": 8 },
    "min":       { "colSpan": 4, "rowSpan": 7 },
    "max":       { "colSpan": 10, "rowSpan": 12 }
  },
  "spec": {
    "root": "card",
    "elements": {

      "card": {
        "type": "Card",
        "children": ["headerRow", "statGrid", "div1", "colHeaders", "callBody", "overlay"]
      },

      "headerRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["titleGroup", "brandBadge"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "ClipboardCheck", "tone": "accent", "size": "sm" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "eyebrow"]
      },
      "brandBadge": {
        "type": "Badge",
        "props": { "label": "talkdesk", "tone": "success" }
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Call QA Scorecard", "level": "h2" }
      },
      "eyebrow": {
        "type": "Eyebrow",
        "props": { "text": "Talkdesk AI Agent · Recent calls" }
      },

      "statGrid": {
        "type": "Grid",
        "props": { "cols": 3 },
        "children": ["statScoredSec", "statPassedSec", "statRateSec"]
      },
      "statScoredSec": {
        "type": "Section",
        "props": { "variant": "muted" },
        "children": ["statScoredStack"]
      },
      "statScoredStack": {
        "type": "Stack",
        "props": { "gap": "xxs", "align": "center" },
        "children": ["statScoredIco", "statScoredVal", "statScoredLbl"]
      },
      "statScoredIco": {
        "type": "Icon",
        "props": { "name": "Phone", "tone": "accent", "size": "sm" }
      },
      "statScoredVal": {
        "type": "Stat",
        "props": { "value": "10", "tone": "accent" }
      },
      "statScoredLbl": {
        "type": "Caption",
        "props": { "text": "Scored" }
      },
      "statPassedSec": {
        "type": "Section",
        "props": { "variant": "muted" },
        "children": ["statPassedStack"]
      },
      "statPassedStack": {
        "type": "Stack",
        "props": { "gap": "xxs", "align": "center" },
        "children": ["statPassedIco", "statPassedVal", "statPassedLbl"]
      },
      "statPassedIco": {
        "type": "Icon",
        "props": { "name": "CheckCircle", "tone": "success", "size": "sm" }
      },
      "statPassedVal": {
        "type": "Stat",
        "props": { "value": "7", "tone": "success" }
      },
      "statPassedLbl": {
        "type": "Caption",
        "props": { "text": "Passed" }
      },
      "statRateSec": {
        "type": "Section",
        "props": { "variant": "muted" },
        "children": ["statRateStack"]
      },
      "statRateStack": {
        "type": "Stack",
        "props": { "gap": "xxs", "align": "center" },
        "children": ["statRateIco", "statRateVal", "statRateLbl"]
      },
      "statRateIco": {
        "type": "Icon",
        "props": { "name": "TrendingUp", "tone": "accent", "size": "sm" }
      },
      "statRateVal": {
        "type": "Stat",
        "props": { "value": "70%", "tone": "accent" }
      },
      "statRateLbl": {
        "type": "Caption",
        "props": { "text": "Pass Rate" }
      },

      "div1": { "type": "Divider" },

      "colHeaders": {
        "type": "Grid",
        "props": { "cols": 3, "gap": "sm" },
        "children": ["hdrCallId", "hdrScore", "hdrResult"]
      },
      "hdrCallId": {
        "type": "Caption",
        "props": { "text": "CALL ID" }
      },
      "hdrScore": {
        "type": "Stack",
        "props": { "align": "center" },
        "children": ["hdrScoreTxt"]
      },
      "hdrScoreTxt": {
        "type": "Caption",
        "props": { "text": "SCORE" }
      },
      "hdrResult": {
        "type": "Stack",
        "props": { "align": "end" },
        "children": ["hdrResultTxt"]
      },
      "hdrResultTxt": {
        "type": "Caption",
        "props": { "text": "RESULT" }
      },

      "callBody": {
        "type": "Body",
        "props": {},
        "children": ["callList"]
      },
      "callList": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["c1", "c2", "c3", "c4", "c5", "c6", "c7", "c8", "c9", "c10"]
      },

      "c1": {
        "type": "Row",
        "props": { "template": "1fr 1fr 1fr", "gap": "sm", "hover": true, "clickable": true },
        "children": ["c1info", "c1mid", "c1pass"],
        "on": {
          "click": {
            "action": "setState",
            "params": {
              "statePath": "/ui/sel",
              "value": {
                "id": "CALL-00121",
                "agentLine": "Support Agent: Alice M.",
                "dt": "29 May 2026 · 12:40 PM",
                "score": "92/100",
                "result": "Pass",
                "resultTone": "success",
                "m1l": "Customer",
                "m1t": "Hi, I'm having trouble processing a payment — it keeps declining.",
                "m2l": "Agent",
                "m2t": "I can help with that. Could you confirm the billing address on the card?",
                "m3l": "Customer",
                "m3t": "It's 12 Oak Street, Melbourne. Oh, that fixed it — payment went through!"
              }
            }
          }
        }
      },
      "c1info": {
