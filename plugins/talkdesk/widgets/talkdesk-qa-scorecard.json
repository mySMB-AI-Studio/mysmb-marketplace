      "detailTitleRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["detailCallId", "detailClose"]
      },
      "detailCallId": {
        "type": "Heading",
        "props": { "text": { "$state": "/ui/sel/id" }, "level": "h3" }
      },
      "detailClose": {
        "type": "Button",
        "props": { "label": "Close", "variant": "ghost", "size": "sm", "leadingIcon": "X" },
        "on": {
          "click": {
            "action": "setState",
            "params": { "statePath": "/ui/sel/id", "value": "" }
          }
        }
      },

      "detailMeta": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["kvDt", "kvCaller", "kvAgent"]
      },
      "kvDt": {
        "type": "KeyValue",
        "props": { "label": "Date & Time", "value": { "$state": "/ui/sel/dt" } }
      },
      "kvCaller": {
        "type": "KeyValue",
        "props": { "label": "Caller", "value": { "$state": "/ui/sel/caller" } }
      },
      "kvAgent": {
        "type": "KeyValue",
        "props": { "label": "Agent", "value": { "$state": "/ui/sel/agent" } }
      },

      "detailScoreRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["detailScoreLbl", "detailScoreRight"]
      },
      "detailScoreLbl": {
        "type": "Caption",
        "props": { "text": "Score" }
      },
      "detailScoreRight": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["detailScore", "detailBadge"]
      },
      "detailScore": {
        "type": "Text",
        "props": { "text": { "$state": "/ui/sel/score" }, "size": "sm", "weight": "medium" }
      },
      "detailBadge": {
        "type": "Badge",
        "props": {
          "text": { "$state": "/ui/sel/result" },
          "tone": { "$state": "/ui/sel/resultTone" }
        }
      },

      "detailSumDiv": { "type": "Divider" },
      "detailSumHdr": {
        "type": "Eyebrow",
        "props": { "text": "SUMMARY" }
      },
      "detailSumText": {
        "type": "Text",
        "props": { "text": { "$state": "/ui/sel/summary" }, "size": "sm" }
      },

      "detailLinkRow": {
        "type": "Row",
        "props": { "justify": "end" },
        "children": ["detailLink"]
      },
      "detailLink": {
        "type": "Button",
        "props": { "label": "View in Talkdesk", "variant": "ghost", "size": "sm", "leadingIcon": "ExternalLink" },
        "on": {
          "click": {
            "action": "open_url",
            "params": { "url": { "$state": "/ui/sel/url" } }
          }
        }
      }

    }
  }
}
