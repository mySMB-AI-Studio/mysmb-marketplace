      },
      "c4badge": {
        "type": "Badge",
        "props": { "text": "Pass", "tone": "success" }
      },

      "c5": {
        "type": "Grid",
        "props": { "cols": 3, "gap": "sm" },
        "children": ["c5info", "c5mid", "c5pass"]
      },
      "c5info": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["c5id", "c5agent", "c5dt"]
      },
      "c5id": {
