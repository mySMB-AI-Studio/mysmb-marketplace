{
  "id": "talkdesk-qa-scorecard",
  "title": "Call QA Scorecard",
  "description": "Recent Talkdesk call QA scores — pass/fail breakdown per agent.",
  "category": "support",
  "tags": ["talkdesk", "qa", "calls", "scoring", "support"],
  "keywords": ["call quality", "qa score", "talkdesk", "agent performance", "pass", "fail"],
  "connectorsUsed": ["talkdesk"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 5, "rowSpan": 8 },
    "min":       { "colSpan": 4, "rowSpan": 7 },
    "max":       { "colSpan": 10, "rowSpan": 12 }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "children": ["headerRow", "statGrid", "div1", "callList", "div2", "footer"]
      },

      "headerRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["titleGroup", "brandBadge"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "ClipboardCheck", "tone": "accent", "size": "sm" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "eyebrow"]
      },
      "brandBadge": {
        "type": "Badge",
        "props": { "label": "talkdesk", "tone": "success" }
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Call QA Scorecard", "level": "h2" }
      },
      "eyebrow": {
        "type": "Eyebrow",
        "props": { "text": "Talkdesk AI Agent · Recent calls" }
      },

      "statGrid": {
        "type": "Grid",
        "props": { "cols": 3 },
        "children": ["statScoredSec", "statPassedSec", "statRateSec"]
      },
      "statScoredSec": {
        "type": "Section",
        "props": { "variant": "muted" },
        "children": ["statScoredStack"]
      },
      "statScoredStack": {
        "type": "Stack",
        "props": { "gap": "xxs", "align": "center" },
        "children": ["statScoredIco", "statScoredVal", "statScoredLbl"]
      },
      "statScoredIco": {
        "type": "Icon",
        "props": { "name": "Phone", "tone": "accent", "size": "sm" }
      },
      "statScoredVal": {
        "type": "Stat",
        "props": { "value": "5", "tone": "accent" }
      },
      "statScoredLbl": {
        "type": "Caption",
        "props": { "text": "Scored" }
      },

      "statPassedSec": {
        "type": "Section",
        "props": { "variant": "muted" },
        "children": ["statPassedStack"]
      },
      "statPassedStack": {
        "type": "Stack",
        "props": { "gap": "xxs", "align": "center" },
        "children": ["statPassedIco", "statPassedVal", "statPassedLbl"]
      },
      "statPassedIco": {
        "type": "Icon",
        "props": { "name": "CheckCircle", "tone": "success", "size": "sm" }
      },
      "statPassedVal": {
        "type": "Stat",
        "props": { "value": "3", "tone": "success" }
      },
      "statPassedLbl": {
        "type": "Caption",
        "props": { "text": "Passed" }
      },

      "statRateSec": {
        "type": "Section",
        "props": { "variant": "muted" },
        "children": ["statRateStack"]
      },
      "statRateStack": {
        "type": "Stack",
        "props": { "gap": "xxs", "align": "center" },
        "children": ["statRateIco", "statRateVal", "statRateLbl"]
      },
      "statRateIco": {
        "type": "Icon",
        "props": { "name": "Percent", "tone": "accent", "size": "sm" }
      },
      "statRateVal": {
        "type": "Stat",
        "props": { "value": "60%", "tone": "accent" }
      },
      "statRateLbl": {
        "type": "Caption",
        "props": { "text": "Pass Rate" }
      },

      "div1": { "type": "Divider" },

      "callList": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["c1", "c2", "c3", "c4", "c5"]
      },

      "c1": {
        "type": "Grid",
        "props": { "cols": 3, "gap": "sm" },
        "children": ["c1info", "c1mid", "c1pass"]
      },
      "c1info": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["c1id", "c1agent", "c1dt"]
      },
      "c1id": {
        "type": "Text",
        "props": { "text": "CALL-00121", "size": "sm", "weight": "medium" }
      },
      "c1agent": {
        "type": "Caption",
        "props": { "text": "Support Agent: Alice M." }
      },
      "c1dt": {
        "type": "Caption",
        "props": { "text": "29 May 2026 · 12:40 PM" }
      },
      "c1mid": {
        "type": "Stack",
        "props": { "align": "center" },
        "children": ["c1score"]
      },
      "c1score": {
        "type": "Text",
        "props": { "text": "92/100", "size": "sm", "weight": "medium" }
      },
      "c1pass": {
        "type": "Stack",
        "props": { "align": "end" },
        "children": ["c1badge"]
      },
      "c1badge": {
        "type": "Badge",
        "props": { "text": "Pass", "tone": "success" }
      },

      "c2": {
        "type": "Grid",
        "props": { "cols": 3, "gap": "sm" },
        "children": ["c2info", "c2mid", "c2pass"]
      },
      "c2info": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["c2id", "c2agent", "c2dt"]
