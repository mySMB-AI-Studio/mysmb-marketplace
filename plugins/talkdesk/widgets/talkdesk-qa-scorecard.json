      "c2mid": {
        "type": "Stack",
        "props": { "align": "center" },
        "children": ["c2score"]
      },
      "c2score": {
        "type": "Text",
        "props": { "text": "74/100", "size": "sm", "weight": "medium" }
      },
      "c2pass": {
        "type": "Stack",
        "props": { "align": "end" },
        "children": ["c2badge"]
      },
      "c2badge": {
        "type": "Badge",
        "props": { "text": "Fail", "tone": "destructive" }
      },

      "c3": {
        "type": "Grid",
        "props": { "cols": 3, "gap": "sm" },
