      "c10badge": { "type": "Badge", "props": { "text": "Pass", "tone": "success" } },

      "overlay": {
        "type": "Overlay",
        "props": { "maxWidth": "28rem" },
        "visible": { "$state": "/ui/sel/id" },
        "on": {
          "backdropClick": {
            "action": "setState",
            "params": { "statePath": "/ui/sel/id", "value": "" }
          }
        },
        "children": ["ovStack"]
      },
      "ovStack": {
        "type": "Stack",
        "props": { "gap": "md" },
        "children": ["ovHeaderRow", "ovMetaRow", "ovDiv", "ovTranscriptHdr", "ovMsg1", "ovMsg2", "ovMsg3"]
      },
      "ovHeaderRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["ovTitleStack", "ovClose"]
      },
      "ovTitleStack": {
        "type": "Stack",
        "props": { "gap": "xxs" },
        "children": ["ovCallId", "ovAgentLine"]
      },
      "ovCallId": {
        "type": "Heading",
        "props": { "text": { "$state": "/ui/sel/id" }, "level": "h3" }
      },
      "ovAgentLine": {
        "type": "Caption",
        "props": { "text": { "$state": "/ui/sel/agentLine" } }
      },
      "ovClose": {
        "type": "Button",
        "props": { "label": "Close", "variant": "ghost", "size": "sm", "leadingIcon": "X" },
        "on": {
          "click": {
            "action": "setState",
            "params": { "statePath": "/ui/sel/id", "value": "" }
          }
        }
      },
      "ovMetaRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["ovDt", "ovScoreGroup"]
      },
      "ovDt": {
        "type": "Caption",
        "props": { "text": { "$state": "/ui/sel/dt" } }
      },
      "ovScoreGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["ovScore", "ovBadge"]
      },
      "ovScore": {
        "type": "Text",
        "props": { "text": { "$state": "/ui/sel/score" }, "size": "sm", "weight": "medium" }
      },
      "ovBadge": {
        "type": "Badge",
        "props": {
          "text": { "$state": "/ui/sel/result" },
          "tone": { "$state": "/ui/sel/resultTone" }
        }
      },
      "ovDiv": { "type": "Divider" },
      "ovTranscriptHdr": {
        "type": "Eyebrow",
        "props": { "text": "TRANSCRIPT" }
      },
      "ovMsg1": {
        "type": "Stack",
        "props": { "gap": "xxs" },
        "children": ["ovMsg1Lbl", "ovMsg1Text"]
      },
      "ovMsg1Lbl": {
        "type": "Caption",
        "props": { "text": { "$state": "/ui/sel/m1l" } }
      },
      "ovMsg1Text": {
        "type": "Text",
        "props": { "text": { "$state": "/ui/sel/m1t" }, "size": "sm" }
      },
      "ovMsg2": {
        "type": "Stack",
        "props": { "gap": "xxs" },
        "children": ["ovMsg2Lbl", "ovMsg2Text"]
      },
      "ovMsg2Lbl": {
        "type": "Caption",
        "props": { "text": { "$state": "/ui/sel/m2l" } }
      },
      "ovMsg2Text": {
        "type": "Text",
        "props": { "text": { "$state": "/ui/sel/m2t" }, "size": "sm" }
      },
      "ovMsg3": {
        "type": "Stack",
        "props": { "gap": "xxs" },
        "children": ["ovMsg3Lbl", "ovMsg3Text"]
      },
      "ovMsg3Lbl": {
        "type": "Caption",
        "props": { "text": { "$state": "/ui/sel/m3l" } }
      },
      "ovMsg3Text": {
        "type": "Text",
        "props": { "text": { "$state": "/ui/sel/m3t" }, "size": "sm" }
      }

    }
  }
}
