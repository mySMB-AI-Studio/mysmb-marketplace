{
  "id": "talkdesk-knowledge-search-v2",
  "title": "Knowledge Search",
  "description": "Browse the mySMB Workspace knowledge base — the same articles Talkdesk AI Agent uses to answer customer queries.",
  "category": "support",
  "tags": ["talkdesk", "knowledge", "search", "articles", "support"],
  "keywords": ["knowledge base", "search", "articles", "faq", "talkdesk"],
  "connectorsUsed": ["talkdesk"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 5, "rowSpan": 7 },
    "min":       { "colSpan": 4, "rowSpan": 6 },
    "max":       { "colSpan": 10, "rowSpan": 10 }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "children": ["headerRow", "statTile", "div1", "articleList", "div2", "footer"]
      },
      "headerRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["titleGroup", "brandBadge"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "Search", "tone": "accent", "size": "sm" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "eyebrow"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Knowledge Search", "level": "h2" }
      },
      "eyebrow": {
        "type": "Eyebrow",
        "props": { "text": "Talkdesk AI Agent · mySMB Workspace" }
      },
      "brandBadge": {
        "type": "Badge",
        "props": { "label": "talkdesk", "tone": "success" }
      },

      "statTile": {
        "type": "Section",
        "props": { "variant": "muted" },
        "children": ["statStack"]
      },
      "statStack": {
        "type": "Stack",
        "props": { "gap": "xxs", "align": "center" },
        "children": ["statIco", "statVal", "statLbl"]
      },
      "statIco": {
        "type": "Icon",
        "props": { "name": "BookOpen", "tone": "accent", "size": "sm" }
      },
      "statVal": {
        "type": "Heading",
        "props": { "text": "5", "level": "h2" }
      },
      "statLbl": {
        "type": "Caption",
        "props": { "text": "Articles in knowledge base" }
      },

      "div1": { "type": "Divider" },

      "articleList": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["a1", "a2", "a3", "a4", "a5"]
      },

      "a1": {
        "type": "Row",
        "props": { "justify": "between", "align": "start", "gap": "md" },
        "children": ["a1left", "a1cat"]
      },
      "a1left": {
        "type": "Stack",
        "props": { "gap": "xxs" },
        "children": ["a1title", "a1excerpt"]
      },
      "a1title": {
        "type": "Text",
        "props": { "text": "How to Reset Your Password", "size": "sm", "weight": "medium" }
      },
      "a1excerpt": {
        "type": "Caption",
        "props": { "text": "Step-by-step guide for resetting account passwords via email or support team." }
      },
      "a1cat": {
        "type": "Badge",
        "props": { "text": "Account & Security", "tone": "accent", "variant": "soft" }
      },

      "a2": {
        "type": "Row",
        "props": { "justify": "between", "align": "start", "gap": "md" },
        "children": ["a2left", "a2cat"]
      },
      "a2left": {
        "type": "Stack",
        "props": { "gap": "xxs" },
        "children": ["a2title", "a2excerpt"]
      },
      "a2title": {
        "type": "Text",
        "props": { "text": "Cancel Your Subscription", "size": "sm", "weight": "medium" }
      },
      "a2excerpt": {
        "type": "Caption",
        "props": { "text": "Instructions to cancel a monthly or annual subscription from the billing portal." }
      },
      "a2cat": {
        "type": "Badge",
        "props": { "text": "Billing & Subscriptions", "tone": "accent", "variant": "soft" }
      },

      "a3": {
        "type": "Row",
        "props": { "justify": "between", "align": "start", "gap": "md" },
        "children": ["a3left", "a3cat"]
      },
      "a3left": {
        "type": "Stack",
        "props": { "gap": "xxs" },
        "children": ["a3title", "a3excerpt"]
      },
      "a3title": {
        "type": "Text",
        "props": { "text": "Download Your Invoice as PDF", "size": "sm", "weight": "medium" }
      },
      "a3excerpt": {
        "type": "Caption",
        "props": { "text": "Export any past invoice as a PDF from the account billing history page." }
      },
      "a3cat": {
        "type": "Badge",
        "props": { "text": "Billing & Payments", "tone": "accent", "variant": "soft" }
      },

      "a4": {
        "type": "Row",
        "props": { "justify": "between", "align": "start", "gap": "md" },
        "children": ["a4left", "a4cat"]
      },
      "a4left": {
        "type": "Stack",
        "props": { "gap": "xxs" },
        "children": ["a4title", "a4excerpt"]
      },
      "a4title": {
        "type": "Text",
        "props": { "text": "Setting Up Two-Factor Authentication", "size": "sm", "weight": "medium" }
      },
      "a4excerpt": {
        "type": "Caption",
        "props": { "text": "Enable 2FA on your account using an authenticator app or SMS verification." }
      },
      "a4cat": {
        "type": "Badge",
        "props": { "text": "Account & Security", "tone": "accent", "variant": "soft" }
      },

      "a5": {
        "type": "Row",
        "props": { "justify": "between", "align": "start", "gap": "md" },
        "children": ["a5left", "a5cat"]
      },
      "a5left": {
        "type": "Stack",
        "props": { "gap": "xxs" },
        "children": ["a5title", "a5excerpt"]
      },
      "a5title": {
        "type": "Text",
        "props": { "text": "Annual Plan Refund Policy", "size": "sm", "weight": "medium" }
      },
      "a5excerpt": {
        "type": "Caption",
        "props": { "text": "Details on eligibility and process for refunds on annual subscription plans." }
      },
      "a5cat": {
        "type": "Badge",
        "props": { "text": "Billing & Subscriptions", "tone": "accent", "variant": "soft" }
      },

      "div2": { "type": "Divider" },

      "footer": {
        "type": "Row",
        "props": { "justify": "end", "gap": "xs", "align": "center" },
        "children": ["footerBtn"]
      },
      "footerBtn": {
        "type": "Button",
        "props": {
          "label": "Open Knowledge Base",
          "variant": "ghost",
          "size": "sm",
          "leadingIcon": "ExternalLink"
        },
        "on": {
          "click": {
            "action": "open_url",
            "params": { "url": "https://my.talkdesk.com", "target": "_blank" }
          }
        }
      }
    }
  },
  "status": "published"
}
