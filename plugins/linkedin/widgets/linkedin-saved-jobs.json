{
  "id": "linkedin-saved-jobs",
  "title": "Saved Jobs",
  "description": "Jobs you have bookmarked on LinkedIn — title, company, location, and when you saved them.",
  "category": "productivity",
  "tags": ["linkedin", "jobs", "saved", "bookmarks", "career"],
  "keywords": ["saved jobs", "bookmarked", "jobs", "career", "linkedin", "applications"],
  "connectorsUsed": ["linkedin"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 4, "rowSpan": 4 },
    "min": { "colSpan": 4, "rowSpan": 3 },
    "max": { "colSpan": 8, "rowSpan": 10 }
  },
  "dataProvider": {
    "mcp": "linkedin",
    "tool": "linkedin_consumer_list_saved_jobs",
    "params": { "limit": 20 }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": { "type": "Card", "props": {}, "children": ["header", "body"] },
      "header": { "type": "Header", "props": {}, "children": ["titleGroup"] },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "start" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": { "type": "Icon", "props": { "name": "Bookmark", "tone": "warning", "size": "sm" } },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "count"]
      },
      "title": { "type": "Heading", "props": { "text": "Saved Jobs", "level": "h2" } },
      "count": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{n} Saved",
              "n": {
                "$computed": "count",
                "args": { "value": { "$state": "/linkedin/linkedin_consumer_list_saved_jobs/elements" } }
              }
            }
          }
        }
      },
      "body": { "type": "Body", "props": {}, "children": ["loading", "empty", "list"] },
      "loading": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["sk1", "sk2", "sk3"],
        "visible": { "$state": "/_loading/linkedin.linkedin_consumer_list_saved_jobs" }
      },
      "sk1": { "type": "Skeleton", "props": { "height": "3.5rem", "rounded": "md" } },
      "sk2": { "type": "Skeleton", "props": { "height": "3.5rem", "rounded": "md" } },
      "sk3": { "type": "Skeleton", "props": { "height": "3.5rem", "rounded": "md" } },
      "empty": {
        "type": "Empty",
        "props": { "message": "No saved jobs — bookmark roles on LinkedIn and they'll appear here." },
        "visible": {
          "$and": [
            { "$state": "/_loading/linkedin.linkedin_consumer_list_saved_jobs", "not": true },
            { "$state": "/linkedin/linkedin_consumer_list_saved_jobs/elements/0", "not": true }
          ]
        }
      },
      "list": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["jobRow"],
        "repeat": {
          "statePath": "/linkedin/linkedin_consumer_list_saved_jobs/elements",
          "key": "jobId"
        },
        "visible": { "$state": "/_loading/linkedin.linkedin_consumer_list_saved_jobs", "not": true }
      },
      "jobRow": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center", "hover": true, "clickable": true },
        "children": ["jobInfo", "savedBadge", "openBtn"],
        "on": { "click": { "action": "open_url", "params": { "url": { "$item": "jobUrl" } } } }
      },
      "jobInfo": {
        "type": "Stack",
        "props": { "gap": "xs", "grow": true },
        "children": ["jobTitle", "jobMeta"]
      },
      "jobTitle": {
        "type": "Text",
        "props": { "text": { "$item": "title" }, "size": "sm", "weight": "medium", "truncate": true }
      },
      "jobMeta": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{company} · {location}",
              "company": { "$item": "company" },
              "location": { "$item": "location" }
            }
          }
        }
      },
      "savedBadge": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "relative_time",
            "args": { "value": { "$item": "savedAt" } }
          }
        }
      },
      "openBtn": {
        "type": "IconButton",
        "props": { "icon": "ExternalLink", "tone": "muted", "ariaLabel": "Open job" },
        "on": { "click": { "action": "open_url", "params": { "url": { "$item": "jobUrl" } } } }
      }
    }
  },
  "status": "published"
}
