{
  "id": "linkedin-network-feed",
  "title": "Network Feed",
  "description": "Recent activity from your LinkedIn network — posts, job changes, and milestones from your connections.",
  "category": "productivity",
  "tags": [
    "linkedin",
    "feed",
    "network",
    "activity",
    "updates"
  ],
  "keywords": [
    "feed",
    "network",
    "activity",
    "posts",
    "updates",
    "connections",
    "linkedin"
  ],
  "connectorsUsed": [
    "linkedin"
  ],
  "popularity": 0,
  "sizing": {
    "preferred": {
      "colSpan": 6,
      "rowSpan": 5
    },
    "min": {
      "colSpan": 4,
      "rowSpan": 4
    },
    "max": {
      "colSpan": 10,
      "rowSpan": 12
    }
  },
  "dataProvider": {
    "mcp": "linkedin",
    "tool": "get_network_feed",
    "params": {
      "limit": 15
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "children": [
          "header",
          "body"
        ]
      },
      "header": {
        "type": "Header",
        "children": [
          "titleGroup"
        ]
      },
      "titleGroup": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "start"
        },
        "children": [
          "titleIcon",
          "titleStack"
        ]
      },
      "titleIcon": {
        "type": "Icon",
        "props": {
          "name": "Rss",
          "tone": "info",
          "size": "sm"
        }
      },
      "titleStack": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "children": [
          "title",
          "subtitle"
        ]
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "Network Feed",
          "level": "h2"
        }
      },
      "subtitle": {
        "type": "Eyebrow",
        "props": {
          "text": "Latest from your connections"
        }
      },
      "body": {
        "type": "Body",
        "children": [
          "loading",
          "empty",
          "list"
        ]
      },
      "loading": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "sk1",
          "sk2",
          "sk3",
          "sk4"
        ],
        "visible": {
          "$state": "/_loading/linkedin.get_network_feed"
        }
      },
      "sk1": {
        "type": "Skeleton",
        "props": {
          "height": "3.5rem",
          "rounded": "md"
        }
      },
      "sk2": {
        "type": "Skeleton",
        "props": {
          "height": "3.5rem",
          "rounded": "md"
        }
      },
      "sk3": {
        "type": "Skeleton",
        "props": {
          "height": "3.5rem",
          "rounded": "md"
        }
      },
      "sk4": {
        "type": "Skeleton",
        "props": {
          "height": "3.5rem",
          "rounded": "md"
        }
      },
      "empty": {
        "type": "Empty",
        "props": {
          "message": "Nothing in your feed right now."
        },
        "visible": {
          "$and": [
            {
              "$state": "/_loading/linkedin.get_network_feed",
              "not": true
            },
            {
              "$state": "/linkedin/get_network_feed/items/0",
              "not": true
            }
          ]
        }
      },
      "list": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "children": [
          "row"
        ],
        "repeat": {
          "statePath": "/linkedin/get_network_feed/items",
          "key": "activityId"
        },
        "visible": {
          "$state": "/_loading/linkedin.get_network_feed",
          "not": true
        }
      },
      "row": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "start",
          "hover": true,
          "clickable": true
        },
        "children": [
          "avatar",
          "content",
          "timestamp"
        ],
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "url": {
                "$item": "postUrl"
              }
            }
          }
        }
      },
      "avatar": {
        "type": "Avatar",
        "props": {
          "initials": {
            "$computed": "initials",
            "args": {
              "value": {
                "$item": "authorName"
              }
            }
          },
          "size": "sm"
        }
      },
      "content": {
        "type": "Stack",
        "props": {
          "gap": "xs",
          "grow": true
        },
        "children": [
          "authorRow",
          "postPreview"
        ]
      },
      "authorRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center"
        },
        "children": [
          "authorName",
          "activityBadge"
        ]
      },
      "authorName": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "authorName"
          },
          "size": "sm",
          "weight": "medium",
          "truncate": true
        }
      },
      "activityBadge": {
        "type": "Badge",
        "props": {
          "text": {
            "$item": "activityType"
          },
          "tone": "default",
          "variant": "soft"
        }
      },
      "postPreview": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "textPreview"
          },
          "size": "sm",
          "tone": "muted",
          "truncate": true
        }
      },
      "timestamp": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "relative_time",
            "args": {
              "value": {
                "$item": "publishedAt"
              }
            }
          }
        }
      }
    }
  },
  "status": "published"
}
