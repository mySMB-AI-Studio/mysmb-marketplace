{
  "id": "linkedin-ad-accounts-demo",
  "title": "Ad Accounts (Demo)",
  "description": "Sample LinkedIn ad accounts tile — static dummy data, no connection required.",
  "category": "marketing",
  "tags": ["linkedin", "marketing", "ads", "b2b", "advertising", "demo"],
  "keywords": ["ad accounts", "sponsored", "advertising", "linkedin", "b2b", "demo"],
  "connectorsUsed": [],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 4, "rowSpan": 4 },
    "min": { "colSpan": 3, "rowSpan": 3 },
    "max": { "colSpan": 8, "rowSpan": 8 }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": { "type": "Card", "children": ["header", "body"] },
      "header": { "type": "Header", "children": ["titleGroup"] },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleText", "demoBadge"]
      },
      "titleIcon": { "type": "Icon", "props": { "name": "Linkedin", "tone": "accent", "size": "sm" } },
      "titleText": { "type": "Heading", "props": { "text": "Ad Accounts", "level": "h2" } },
      "demoBadge": { "type": "Badge", "props": { "text": "Demo", "tone": "warning", "variant": "soft" } },
      "body": { "type": "Body", "children": ["list"] },
      "list": { "type": "Stack", "props": { "gap": "none" }, "children": ["row1", "row2", "row3"] },

      "row1": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center", "justify": "between", "hover": true },
        "children": ["left1", "badge1"]
      },
      "left1": { "type": "Stack", "props": { "gap": "xs", "grow": true }, "children": ["name1", "type1"] },
      "name1": { "type": "Text", "props": { "text": "mySMB Digital Ads", "size": "sm", "weight": "medium" } },
      "type1": { "type": "Caption", "props": { "text": "BUSINESS" } },
      "badge1": { "type": "Badge", "props": { "text": "ACTIVE", "tone": "success", "variant": "soft" } },

      "row2": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center", "justify": "between", "hover": true },
        "children": ["left2", "badge2"]
      },
      "left2": { "type": "Stack", "props": { "gap": "xs", "grow": true }, "children": ["name2", "type2"] },
      "name2": { "type": "Text", "props": { "text": "Brand Awareness Q2", "size": "sm", "weight": "medium" } },
      "type2": { "type": "Caption", "props": { "text": "BUSINESS" } },
      "badge2": { "type": "Badge", "props": { "text": "ACTIVE", "tone": "success", "variant": "soft" } },

      "row3": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center", "justify": "between", "hover": true },
        "children": ["left3", "badge3"]
      },
      "left3": { "type": "Stack", "props": { "gap": "xs", "grow": true }, "children": ["name3", "type3"] },
      "name3": { "type": "Text", "props": { "text": "Talent Recruitment", "size": "sm", "weight": "medium" } },
      "type3": { "type": "Caption", "props": { "text": "ENTERPRISE" } },
      "badge3": { "type": "Badge", "props": { "text": "PAUSED", "tone": "warning", "variant": "soft" } }
    }
  },
  "status": "published"
}
