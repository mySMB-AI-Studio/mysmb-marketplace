{
  "id": "linkedin-pending-invitations-demo",
  "title": "Connection Requests (Demo)",
  "description": "Sample LinkedIn connection requests tile — static dummy data, no connection required.",
  "category": "productivity",
  "tags": ["linkedin", "connections", "network", "invitations", "demo"],
  "keywords": ["connection", "requests", "invitations", "pending", "network", "linkedin", "demo"],
  "connectorsUsed": [],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 4, "rowSpan": 4 },
    "min": { "colSpan": 4, "rowSpan": 3 },
    "max": { "colSpan": 8, "rowSpan": 10 }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": { "type": "Card", "children": ["header", "body"] },
      "header": { "type": "Header", "children": ["titleGroup"] },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "start" },
        "children": ["titleIcon", "titleStack", "demoBadge"]
      },
      "titleIcon": { "type": "Icon", "props": { "name": "UserPlus", "tone": "info", "size": "sm" } },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "count"]
      },
      "title": { "type": "Heading", "props": { "text": "Connection Requests", "level": "h2" } },
      "count": { "type": "Eyebrow", "props": { "text": "3 Pending" } },
      "demoBadge": { "type": "Badge", "props": { "text": "Demo", "tone": "warning", "variant": "soft" } },
      "body": { "type": "Body", "children": ["list"] },
      "list": { "type": "Stack", "props": { "gap": "none" }, "children": ["r1", "r2", "r3"] },

      "r1": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center", "justify": "between", "hover": true },
        "children": ["r1left", "r1btn"]
      },
      "r1left": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center", "grow": true },
        "children": ["r1avatar", "r1labels"]
      },
      "r1avatar": { "type": "Avatar", "props": { "initials": "SC", "size": "md" } },
      "r1labels": {
        "type": "Stack",
        "props": { "gap": "xs", "grow": true },
        "children": ["r1name", "r1headline"]
      },
      "r1name": { "type": "Text", "props": { "text": "Sarah Chen", "size": "sm", "weight": "medium", "truncate": true } },
      "r1headline": { "type": "Caption", "props": { "text": "Head of Partnerships at TechCorp" } },
      "r1btn": {
        "type": "IconButton",
        "props": { "icon": "ExternalLink", "tone": "muted", "ariaLabel": "View profile" },
        "on": { "click": { "action": "open_url", "params": { "url": "https://www.linkedin.com/" } } }
      },

      "r2": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center", "justify": "between", "hover": true },
        "children": ["r2left", "r2btn"]
      },
      "r2left": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center", "grow": true },
        "children": ["r2avatar", "r2labels"]
      },
      "r2avatar": { "type": "Avatar", "props": { "initials": "MT", "size": "md" } },
      "r2labels": {
        "type": "Stack",
        "props": { "gap": "xs", "grow": true },
        "children": ["r2name", "r2headline"]
      },
      "r2name": { "type": "Text", "props": { "text": "Michael Torres", "size": "sm", "weight": "medium", "truncate": true } },
      "r2headline": { "type": "Caption", "props": { "text": "CFO at Growth Ventures" } },
      "r2btn": {
        "type": "IconButton",
        "props": { "icon": "ExternalLink", "tone": "muted", "ariaLabel": "View profile" },
        "on": { "click": { "action": "open_url", "params": { "url": "https://www.linkedin.com/" } } }
      },

      "r3": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center", "justify": "between", "hover": true },
        "children": ["r3left", "r3btn"]
      },
      "r3left": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center", "grow": true },
        "children": ["r3avatar", "r3labels"]
      },
      "r3avatar": { "type": "Avatar", "props": { "initials": "EW", "size": "md" } },
      "r3labels": {
        "type": "Stack",
        "props": { "gap": "xs", "grow": true },
        "children": ["r3name", "r3headline"]
      },
      "r3name": { "type": "Text", "props": { "text": "Emma Williams", "size": "sm", "weight": "medium", "truncate": true } },
      "r3headline": { "type": "Caption", "props": { "text": "Product Manager at StartupHub" } },
      "r3btn": {
        "type": "IconButton",
        "props": { "icon": "ExternalLink", "tone": "muted", "ariaLabel": "View profile" },
        "on": { "click": { "action": "open_url", "params": { "url": "https://www.linkedin.com/" } } }
      }
    }
  },
  "status": "published"
}
