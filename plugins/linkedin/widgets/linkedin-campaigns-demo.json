{
  "id": "linkedin-campaigns-demo",
  "title": "LinkedIn Campaigns (Demo)",
  "description": "Sample LinkedIn campaigns tile — static dummy data, no connection required.",
  "category": "marketing",
  "tags": ["linkedin", "marketing", "campaigns", "ads", "b2b", "demo"],
  "keywords": ["campaigns", "ads", "sponsored", "advertising", "linkedin", "b2b", "demo"],
  "connectorsUsed": [],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 6, "rowSpan": 4 },
    "min": { "colSpan": 4, "rowSpan": 3 },
    "max": { "colSpan": 12, "rowSpan": 10 }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": { "type": "Card", "children": ["header", "body"] },
      "header": { "type": "Header", "children": ["titleGroup"] },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "start" },
        "children": ["titleIcon", "titleStack", "demoBadge"]
      },
      "titleIcon": { "type": "Icon", "props": { "name": "BarChart2", "tone": "accent", "size": "sm" } },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "eyebrow"]
      },
      "title": { "type": "Heading", "props": { "text": "LinkedIn Campaigns", "level": "h2" } },
      "eyebrow": { "type": "Eyebrow", "props": { "text": "3 Campaigns" } },
      "demoBadge": { "type": "Badge", "props": { "text": "Demo", "tone": "warning", "variant": "soft" } },
      "body": { "type": "Body", "children": ["list"] },
      "list": { "type": "Stack", "props": { "gap": "sm" }, "children": ["c1", "c2", "c3"] },

      "c1": { "type": "Section", "props": { "variant": "bordered" }, "children": ["c1top"] },
      "c1top": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center", "justify": "between" },
        "children": ["c1left", "c1badge"]
      },
      "c1left": { "type": "Stack", "props": { "gap": "xs", "grow": true }, "children": ["c1name", "c1type"] },
      "c1name": { "type": "Text", "props": { "text": "Q2 Brand Awareness", "size": "sm", "weight": "medium" } },
      "c1type": { "type": "Caption", "props": { "text": "SPONSORED_UPDATES" } },
      "c1badge": { "type": "Badge", "props": { "text": "ACTIVE", "tone": "info", "variant": "soft" } },

      "c2": { "type": "Section", "props": { "variant": "bordered" }, "children": ["c2top"] },
      "c2top": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center", "justify": "between" },
        "children": ["c2left", "c2badge"]
      },
      "c2left": { "type": "Stack", "props": { "gap": "xs", "grow": true }, "children": ["c2name", "c2type"] },
      "c2name": { "type": "Text", "props": { "text": "Lead Gen — SMBs", "size": "sm", "weight": "medium" } },
      "c2type": { "type": "Caption", "props": { "text": "SPONSORED_CONTENT" } },
      "c2badge": { "type": "Badge", "props": { "text": "ACTIVE", "tone": "info", "variant": "soft" } },

      "c3": { "type": "Section", "props": { "variant": "bordered" }, "children": ["c3top"] },
      "c3top": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center", "justify": "between" },
        "children": ["c3left", "c3badge"]
      },
      "c3left": { "type": "Stack", "props": { "gap": "xs", "grow": true }, "children": ["c3name", "c3type"] },
      "c3name": { "type": "Text", "props": { "text": "Retargeting — Website Visitors", "size": "sm", "weight": "medium" } },
      "c3type": { "type": "Caption", "props": { "text": "SPONSORED_UPDATES" } },
      "c3badge": { "type": "Badge", "props": { "text": "PAUSED", "tone": "warning", "variant": "soft" } }
    }
  },
  "status": "published"
}
