{
  "id": "linkedin-company-page-demo",
  "title": "Company Page (Demo)",
  "description": "Sample LinkedIn company page tile — static dummy data, no connection required.",
  "category": "marketing",
  "tags": ["linkedin", "company", "page", "b2b", "brand", "demo"],
  "keywords": ["company", "page", "organization", "brand", "linkedin", "b2b", "demo"],
  "connectorsUsed": [],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 4, "rowSpan": 4 },
    "min": { "colSpan": 3, "rowSpan": 3 },
    "max": { "colSpan": 8, "rowSpan": 8 }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": { "type": "Card", "children": ["header", "body"] },
      "header": { "type": "Header", "children": ["titleGroup"] },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleText", "demoBadge"]
      },
      "titleIcon": { "type": "Icon", "props": { "name": "Building2", "tone": "accent", "size": "sm" } },
      "titleText": { "type": "Heading", "props": { "text": "Company Page", "level": "h2" } },
      "demoBadge": { "type": "Badge", "props": { "text": "Demo", "tone": "warning", "variant": "soft" } },
      "body": { "type": "Body", "children": ["pageContent"] },
      "pageContent": {
        "type": "Stack",
        "props": { "gap": "md" },
        "children": ["orgName", "orgDesc", "websiteRow", "viewBtn"]
      },
      "orgName": {
        "type": "Heading",
        "props": { "text": "mySMB", "level": "h3" }
      },
      "orgDesc": {
        "type": "Text",
        "props": {
          "text": "AI-powered workspace for small and medium businesses. Connect your apps, automate workflows, and get more done.",
          "size": "sm",
          "tone": "muted"
        }
      },
      "websiteRow": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["webIcon", "webText"]
      },
      "webIcon": { "type": "Icon", "props": { "name": "Globe", "size": "xs", "tone": "muted" } },
      "webText": { "type": "Caption", "props": { "text": "https://mysmb.com" } },
      "viewBtn": {
        "type": "Button",
        "props": {
          "label": "View Company Page",
          "tone": "accent",
          "variant": "solid",
          "size": "md"
        },
        "on": {
          "click": {
            "action": "open_url",
            "params": { "url": "https://www.linkedin.com/company/mysmb/" }
          }
        }
      }
    }
  },
  "status": "published"
}
