{
  "id": "linkedin-my-profile",
  "title": "My LinkedIn Profile",
  "description": "Your LinkedIn profile summary — headline, location, connections, and followers at a glance.",
  "category": "productivity",
  "tags": [
    "linkedin",
    "profile",
    "network",
    "identity"
  ],
  "keywords": [
    "profile",
    "headline",
    "connections",
    "followers",
    "linkedin",
    "me"
  ],
  "connectorsUsed": [
    "linkedin"
  ],
  "popularity": 0,
  "sizing": {
    "preferred": {
      "colSpan": 4,
      "rowSpan": 3
    },
    "min": {
      "colSpan": 3,
      "rowSpan": 2
    },
    "max": {
      "colSpan": 8,
      "rowSpan": 6
    }
  },
  "dataProvider": {
    "mcp": "linkedin",
    "tool": "get_my_profile",
    "params": {}
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "children": [
          "header",
          "body"
        ]
      },
      "header": {
        "type": "Header",
        "children": [
          "titleGroup"
        ]
      },
      "titleGroup": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "start"
        },
        "children": [
          "titleIcon",
          "titleStack"
        ]
      },
      "titleIcon": {
        "type": "Icon",
        "props": {
          "name": "User",
          "tone": "accent",
          "size": "sm"
        }
      },
      "titleStack": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "children": [
          "title",
          "subtitle"
        ]
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "My LinkedIn Profile",
          "level": "h2"
        }
      },
      "subtitle": {
        "type": "Eyebrow",
        "props": {
          "text": "Profile summary"
        }
      },
      "body": {
        "type": "Body",
        "children": [
          "loading",
          "profileContent"
        ]
      },
      "loading": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "sk1",
          "sk2",
          "sk3"
        ],
        "visible": {
          "$state": "/_loading/linkedin.get_my_profile"
        }
      },
      "sk1": {
        "type": "Skeleton",
        "props": {
          "height": "3rem",
          "rounded": "full"
        }
      },
      "sk2": {
        "type": "Skeleton",
        "props": {
          "height": "1.5rem",
          "rounded": "md"
        }
      },
      "sk3": {
        "type": "Skeleton",
        "props": {
          "height": "1rem",
          "rounded": "md"
        }
      },
      "profileContent": {
        "type": "Stack",
        "props": {
          "gap": "md"
        },
        "visible": {
          "$state": "/_loading/linkedin.get_my_profile",
          "not": true
        },
        "children": [
          "nameRow",
          "statsRow"
        ]
      },
      "nameRow": {
        "type": "Row",
        "props": {
          "gap": "md",
          "align": "center"
        },
        "children": [
          "avatar",
          "identity"
        ]
      },
      "avatar": {
        "type": "Avatar",
        "props": {
          "initials": {
            "$computed": "initials",
            "args": {
              "value": {
                "$state": "/linkedin/get_my_profile/fullName"
              }
            }
          },
          "size": "lg",
          "tone": "accent"
        }
      },
      "identity": {
        "type": "Stack",
        "props": {
          "gap": "xs",
          "grow": true
        },
        "children": [
          "nameText",
          "headlineText",
          "locationText"
        ]
      },
      "nameText": {
        "type": "Text",
        "props": {
          "text": {
            "$state": "/linkedin/get_my_profile/fullName"
          },
          "size": "md",
          "weight": "semibold"
        }
      },
      "headlineText": {
        "type": "Text",
        "props": {
          "text": {
            "$state": "/linkedin/get_my_profile/headline"
          },
          "size": "sm",
          "truncate": true
        }
      },
      "locationText": {
        "type": "Caption",
        "props": {
          "text": {
            "$state": "/linkedin/get_my_profile/location"
          }
        }
      },
      "statsRow": {
        "type": "Row",
        "props": {
          "gap": "md",
          "justify": "between"
        },
        "children": [
          "connectionsKv",
          "followersKv",
          "viewsKv"
        ]
      },
      "connectionsKv": {
        "type": "KeyValue",
        "props": {
          "label": "Connections",
          "value": {
            "$state": "/linkedin/get_my_profile/connectionsCount"
          }
        }
      },
      "followersKv": {
        "type": "KeyValue",
        "props": {
          "label": "Followers",
          "value": {
            "$state": "/linkedin/get_my_profile/followersCount"
          }
        }
      },
      "viewsKv": {
        "type": "KeyValue",
        "props": {
          "label": "Profile Views",
          "value": {
            "$state": "/linkedin/get_my_profile/profileViewsLast30Days"
          }
        }
      }
    }
  },
  "status": "published"
}
