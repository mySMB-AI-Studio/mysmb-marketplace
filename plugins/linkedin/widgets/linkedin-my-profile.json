{
  "id": "linkedin-my-profile",
  "title": "My LinkedIn Profile",
  "description": "Your LinkedIn profile — name, headline, location, and a direct link to your public profile.",
  "category": "productivity",
  "tags": ["linkedin", "profile", "network", "identity"],
  "keywords": ["profile", "headline", "linkedin", "me", "identity", "location"],
  "connectorsUsed": ["linkedin"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 4, "rowSpan": 4 },
    "min": { "colSpan": 3, "rowSpan": 3 },
    "max": { "colSpan": 8, "rowSpan": 8 }
  },
  "dataProvider": {
    "mcp": "linkedin",
    "tool": "linkedin_get_profile",
    "params": {}
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": { "type": "Card", "props": {}, "children": ["header", "body"] },
      "header": { "type": "Header", "props": {}, "children": ["titleGroup"] },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleText"]
      },
      "titleIcon": { "type": "Icon", "props": { "name": "Linkedin", "tone": "accent", "size": "sm" } },
      "titleText": { "type": "Heading", "props": { "text": "My LinkedIn Profile", "level": "h2" } },
      "body": { "type": "Body", "props": {}, "children": ["loading", "profileContent"] },
      "loading": {
        "type": "Stack",
        "props": { "gap": "md" },
        "children": ["skAvatar", "skName", "skHeadline", "skLocation"],
        "visible": { "$state": "/_loading/linkedin.linkedin_get_profile" }
      },
      "skAvatar": { "type": "Skeleton", "props": { "height": "4rem", "rounded": "full" } },
      "skName": { "type": "Skeleton", "props": { "height": "1.75rem", "rounded": "md" } },
      "skHeadline": { "type": "Skeleton", "props": { "height": "1rem", "rounded": "md" } },
      "skLocation": { "type": "Skeleton", "props": { "height": "1rem", "rounded": "md" } },
      "profileContent": {
        "type": "Stack",
        "props": { "gap": "lg" },
        "visible": { "$state": "/_loading/linkedin.linkedin_get_profile", "not": true },
        "children": ["profileRow", "viewBtn"]
      },
      "profileRow": {
        "type": "Row",
        "props": { "gap": "md", "align": "center" },
        "children": ["avatar", "identity"]
      },
      "avatar": {
        "type": "Avatar",
        "props": {
          "initials": {
            "$computed": "initials",
            "args": {
              "value": {
                "$computed": "fmt",
                "args": {
                  "pattern": "{first} {last}",
                  "first": { "$state": "/linkedin/linkedin_get_profile/localizedFirstName" },
                  "last": { "$state": "/linkedin/linkedin_get_profile/localizedLastName" }
                }
              }
            }
          },
          "size": "xl",
          "tone": "accent"
        }
      },
      "identity": {
        "type": "Stack",
        "props": { "gap": "xs", "grow": true },
        "children": ["nameText", "headlineText", "locationRow"]
      },
      "nameText": {
        "type": "Heading",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{first} {last}",
              "first": { "$state": "/linkedin/linkedin_get_profile/localizedFirstName" },
              "last": { "$state": "/linkedin/linkedin_get_profile/localizedLastName" }
            }
          },
          "level": "h3"
        }
      },
      "headlineText": {
        "type": "Text",
        "props": {
          "text": { "$state": "/linkedin/linkedin_get_profile/localizedHeadline" },
          "size": "sm",
          "tone": "muted"
        }
      },
      "locationRow": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "visible": { "$state": "/linkedin/linkedin_get_profile/localizedLocation" },
        "children": ["locationIcon", "locationText"]
      },
      "locationIcon": { "type": "Icon", "props": { "name": "MapPin", "size": "xs", "tone": "muted" } },
      "locationText": {
        "type": "Caption",
        "props": { "text": { "$state": "/linkedin/linkedin_get_profile/localizedLocation" } }
      },
      "viewBtn": {
        "type": "Button",
        "props": {
          "label": "View LinkedIn Profile",
          "tone": "accent",
          "variant": "solid",
          "size": "md"
        },
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "url": {
                "$computed": "fmt",
                "args": {
                  "pattern": "https://www.linkedin.com/in/{vanity}/",
                  "vanity": { "$state": "/linkedin/linkedin_get_profile/vanityName" }
                }
              }
            }
          }
        }
      }
    }
  },
  "status": "published"
}
