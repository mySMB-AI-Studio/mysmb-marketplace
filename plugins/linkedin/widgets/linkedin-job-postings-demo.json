{
  "id": "linkedin-job-postings-demo",
  "title": "Job Postings (Demo)",
  "description": "Sample LinkedIn job postings tile — static dummy data, no connection required.",
  "category": "recruiting",
  "tags": ["linkedin", "jobs", "talent", "recruiting", "b2b", "hiring", "demo"],
  "keywords": ["jobs", "postings", "hiring", "recruitment", "talent", "linkedin", "b2b", "demo"],
  "connectorsUsed": [],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 6, "rowSpan": 4 },
    "min": { "colSpan": 4, "rowSpan": 3 },
    "max": { "colSpan": 12, "rowSpan": 10 }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": { "type": "Card", "children": ["header", "body"] },
      "header": { "type": "Header", "children": ["titleGroup"] },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "start" },
        "children": ["titleIcon", "titleStack", "demoBadge"]
      },
      "titleIcon": { "type": "Icon", "props": { "name": "Briefcase", "tone": "accent", "size": "sm" } },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "eyebrow"]
      },
      "title": { "type": "Heading", "props": { "text": "Job Postings", "level": "h2" } },
      "eyebrow": { "type": "Eyebrow", "props": { "text": "3 Open" } },
      "demoBadge": { "type": "Badge", "props": { "text": "Demo", "tone": "warning", "variant": "soft" } },
      "body": { "type": "Body", "children": ["list"] },
      "list": { "type": "Stack", "props": { "gap": "none" }, "children": ["j1", "j2", "j3"] },

      "j1": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center", "justify": "between", "hover": true },
        "children": ["j1left", "j1badge"]
      },
      "j1left": { "type": "Stack", "props": { "gap": "xs", "grow": true }, "children": ["j1title", "j1loc"] },
      "j1title": { "type": "Text", "props": { "text": "Senior Full-Stack Engineer", "size": "sm", "weight": "medium" } },
      "j1loc": { "type": "Caption", "props": { "text": "Remote" } },
      "j1badge": { "type": "Badge", "props": { "text": "REMOTE", "tone": "accent", "variant": "soft" } },

      "j2": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center", "justify": "between", "hover": true },
        "children": ["j2left", "j2badge"]
      },
      "j2left": { "type": "Stack", "props": { "gap": "xs", "grow": true }, "children": ["j2title", "j2loc"] },
      "j2title": { "type": "Text", "props": { "text": "Product Designer", "size": "sm", "weight": "medium" } },
      "j2loc": { "type": "Caption", "props": { "text": "Sydney, NSW" } },
      "j2badge": { "type": "Badge", "props": { "text": "HYBRID", "tone": "info", "variant": "soft" } },

      "j3": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center", "justify": "between", "hover": true },
        "children": ["j3left", "j3badge"]
      },
      "j3left": { "type": "Stack", "props": { "gap": "xs", "grow": true }, "children": ["j3title", "j3loc"] },
      "j3title": { "type": "Text", "props": { "text": "Customer Success Manager", "size": "sm", "weight": "medium" } },
      "j3loc": { "type": "Caption", "props": { "text": "Melbourne, VIC" } },
      "j3badge": { "type": "Badge", "props": { "text": "ON_SITE", "tone": "muted", "variant": "soft" } }
    }
  },
  "status": "published"
}
