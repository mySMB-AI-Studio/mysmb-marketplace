{
  "id": "linkedin-my-posts-demo",
  "title": "My Posts (Demo)",
  "description": "Sample LinkedIn posts tile with engagement metrics — static dummy data, no connection required.",
  "category": "productivity",
  "tags": ["linkedin", "posts", "content", "engagement", "analytics", "demo"],
  "keywords": ["posts", "content", "likes", "comments", "impressions", "engagement", "reposts", "demo"],
  "connectorsUsed": [],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 6, "rowSpan": 4 },
    "min": { "colSpan": 4, "rowSpan": 3 },
    "max": { "colSpan": 12, "rowSpan": 10 }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": { "type": "Card", "children": ["header", "body"] },
      "header": { "type": "Header", "children": ["titleGroup"] },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "start" },
        "children": ["titleIcon", "titleStack", "demoBadge"]
      },
      "titleIcon": { "type": "Icon", "props": { "name": "FileText", "tone": "info", "size": "sm" } },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "count"]
      },
      "title": { "type": "Heading", "props": { "text": "My Posts", "level": "h2" } },
      "count": { "type": "Eyebrow", "props": { "text": "3 Recent" } },
      "demoBadge": { "type": "Badge", "props": { "text": "Demo", "tone": "warning", "variant": "soft" } },
      "body": { "type": "Body", "children": ["list"] },
      "list": { "type": "Stack", "props": { "gap": "sm" }, "children": ["p1", "p2", "p3"] },

      "p1": { "type": "Section", "props": { "variant": "bordered" }, "children": ["p1top", "p1stats"] },
      "p1top": {
        "type": "Row",
        "props": { "gap": "sm", "align": "start", "justify": "between" },
        "children": ["p1text", "p1btn"]
      },
      "p1text": {
        "type": "Text",
        "props": { "text": "Excited to announce our latest integration with Xero — now SMBs can manage their finances directly from the Workspace.", "size": "sm", "truncate": true, "grow": true }
      },
      "p1btn": {
        "type": "IconButton",
        "props": { "icon": "ExternalLink", "tone": "muted", "ariaLabel": "View post" },
        "on": { "click": { "action": "open_url", "params": { "url": "https://www.linkedin.com/" } } }
      },
      "p1stats": {
        "type": "Row",
        "props": { "gap": "md" },
        "children": ["p1imp", "p1likes", "p1comments", "p1reposts"]
      },
      "p1imp": { "type": "Caption", "props": { "text": "2,400 impressions" } },
      "p1likes": { "type": "Badge", "props": { "text": "48 likes", "tone": "accent", "variant": "soft" } },
      "p1comments": { "type": "Badge", "props": { "text": "12 comments", "tone": "info", "variant": "soft" } },
      "p1reposts": { "type": "Badge", "props": { "text": "6 reposts", "tone": "success", "variant": "soft" } },

      "p2": { "type": "Section", "props": { "variant": "bordered" }, "children": ["p2top", "p2stats"] },
      "p2top": {
        "type": "Row",
        "props": { "gap": "sm", "align": "start", "justify": "between" },
        "children": ["p2text", "p2btn"]
      },
      "p2text": {
        "type": "Text",
        "props": { "text": "5 ways AI is changing how small businesses manage their finances. Thread 🧵", "size": "sm", "truncate": true, "grow": true }
      },
      "p2btn": {
        "type": "IconButton",
        "props": { "icon": "ExternalLink", "tone": "muted", "ariaLabel": "View post" },
        "on": { "click": { "action": "open_url", "params": { "url": "https://www.linkedin.com/" } } }
      },
      "p2stats": {
        "type": "Row",
        "props": { "gap": "md" },
        "children": ["p2imp", "p2likes", "p2comments", "p2reposts"]
      },
      "p2imp": { "type": "Caption", "props": { "text": "1,850 impressions" } },
      "p2likes": { "type": "Badge", "props": { "text": "31 likes", "tone": "accent", "variant": "soft" } },
      "p2comments": { "type": "Badge", "props": { "text": "8 comments", "tone": "info", "variant": "soft" } },
      "p2reposts": { "type": "Badge", "props": { "text": "3 reposts", "tone": "success", "variant": "soft" } },

      "p3": { "type": "Section", "props": { "variant": "bordered" }, "children": ["p3top", "p3stats"] },
      "p3top": {
        "type": "Row",
        "props": { "gap": "sm", "align": "start", "justify": "between" },
        "children": ["p3text", "p3btn"]
      },
      "p3text": {
        "type": "Text",
        "props": { "text": "Just wrapped up a great demo with the team today. The future of work for SMBs is looking very exciting.", "size": "sm", "truncate": true, "grow": true }
      },
      "p3btn": {
        "type": "IconButton",
        "props": { "icon": "ExternalLink", "tone": "muted", "ariaLabel": "View post" },
        "on": { "click": { "action": "open_url", "params": { "url": "https://www.linkedin.com/" } } }
      },
      "p3stats": {
        "type": "Row",
        "props": { "gap": "md" },
        "children": ["p3imp", "p3likes", "p3comments", "p3reposts"]
      },
      "p3imp": { "type": "Caption", "props": { "text": "980 impressions" } },
      "p3likes": { "type": "Badge", "props": { "text": "17 likes", "tone": "accent", "variant": "soft" } },
      "p3comments": { "type": "Badge", "props": { "text": "4 comments", "tone": "info", "variant": "soft" } },
      "p3reposts": { "type": "Badge", "props": { "text": "1 repost", "tone": "success", "variant": "soft" } }
    }
  },
  "status": "published"
}
