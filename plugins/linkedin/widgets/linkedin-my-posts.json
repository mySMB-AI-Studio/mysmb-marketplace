{
  "id": "linkedin-my-posts",
  "title": "My Posts",
  "description": "Your recent LinkedIn posts with engagement metrics — impressions, likes, comments, and reposts.",
  "category": "productivity",
  "tags": [
    "linkedin",
    "posts",
    "content",
    "engagement",
    "analytics"
  ],
  "keywords": [
    "posts",
    "content",
    "likes",
    "comments",
    "impressions",
    "engagement",
    "reposts",
    "shares"
  ],
  "connectorsUsed": [
    "linkedin"
  ],
  "popularity": 0,
  "sizing": {
    "preferred": {
      "colSpan": 6,
      "rowSpan": 4
    },
    "min": {
      "colSpan": 4,
      "rowSpan": 3
    },
    "max": {
      "colSpan": 12,
      "rowSpan": 10
    }
  },
  "dataProvider": {
    "mcp": "linkedin",
    "tool": "list_my_posts",
    "params": {
      "limit": 10
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "children": [
          "header",
          "body"
        ]
      },
      "header": {
        "type": "Header",
        "children": [
          "titleGroup"
        ]
      },
      "titleGroup": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "start"
        },
        "children": [
          "titleIcon",
          "titleStack"
        ]
      },
      "titleIcon": {
        "type": "Icon",
        "props": {
          "name": "FileText",
          "tone": "info",
          "size": "sm"
        }
      },
      "titleStack": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "children": [
          "title",
          "count"
        ]
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "My Posts",
          "level": "h2"
        }
      },
      "count": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{n} Recent",
              "n": {
                "$computed": "count",
                "args": {
                  "value": {
                    "$state": "/linkedin/list_my_posts/posts"
                  }
                }
              }
            }
          }
        }
      },
      "body": {
        "type": "Body",
        "children": [
          "loading",
          "empty",
          "list"
        ]
      },
      "loading": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "sk1",
          "sk2",
          "sk3"
        ],
        "visible": {
          "$state": "/_loading/linkedin.list_my_posts"
        }
      },
      "sk1": {
        "type": "Skeleton",
        "props": {
          "height": "4rem",
          "rounded": "md"
        }
      },
      "sk2": {
        "type": "Skeleton",
        "props": {
          "height": "4rem",
          "rounded": "md"
        }
      },
      "sk3": {
        "type": "Skeleton",
        "props": {
          "height": "4rem",
          "rounded": "md"
        }
      },
      "empty": {
        "type": "Empty",
        "props": {
          "message": "You haven't posted anything yet."
        },
        "visible": {
          "$and": [
            {
              "$state": "/_loading/linkedin.list_my_posts",
              "not": true
            },
            {
              "$state": "/linkedin/list_my_posts/posts/0",
              "not": true
            }
          ]
        }
      },
      "list": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "postRow"
        ],
        "repeat": {
          "statePath": "/linkedin/list_my_posts/posts",
          "key": "postId"
        },
        "visible": {
          "$state": "/_loading/linkedin.list_my_posts",
          "not": true
        }
      },
      "postRow": {
        "type": "Section",
        "props": {
          "variant": "bordered"
        },
        "children": [
          "postTop",
          "postStats"
        ]
      },
      "postTop": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "start",
          "justify": "between"
        },
        "children": [
          "postText",
          "openBtn"
        ]
      },
      "postText": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "textPreview"
          },
          "size": "sm",
          "truncate": true,
          "grow": true
        }
      },
      "openBtn": {
        "type": "IconButton",
        "props": {
          "icon": "ExternalLink",
          "tone": "muted",
          "ariaLabel": "View post"
        },
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "url": {
                "$item": "postUrl"
              }
            }
          }
        }
      },
      "postStats": {
        "type": "Row",
        "props": {
          "gap": "md"
        },
        "children": [
          "impressionsStat",
          "likesStat",
          "commentsStat",
          "repostsStat"
        ]
      },
      "impressionsStat": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{n} impressions",
              "n": {
                "$item": "impressionsCount"
              }
            }
          }
        }
      },
      "likesStat": {
        "type": "Badge",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{n} likes",
              "n": {
                "$item": "likesCount"
              }
            }
          },
          "tone": "accent",
          "variant": "soft"
        }
      },
      "commentsStat": {
        "type": "Badge",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{n} comments",
              "n": {
                "$item": "commentsCount"
              }
            }
          },
          "tone": "info",
          "variant": "soft"
        }
      },
      "repostsStat": {
        "type": "Badge",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{n} reposts",
              "n": {
                "$item": "repostsCount"
              }
            }
          },
          "tone": "success",
          "variant": "soft"
        }
      }
    }
  },
  "status": "published"
}
