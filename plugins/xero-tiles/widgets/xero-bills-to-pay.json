{
  "category": "finance",
  "connectorsUsed": [
    "xero-accounting"
  ],
  "dataProvider": {
    "kind": "tool",
    "mcp": "xero-accounting",
    "params": {
      "order": "DueDate ASC",
      "statuses": "AUTHORISED",
      "where": "Type==\"ACCPAY\""
    },
    "tool": "list_invoices"
  },
  "description": "Outstanding invoices as a checklist — tick them as you chase them.",
  "id": "xero-invoices-todo",
  "keywords": [
    "invoice",
    "invoices",
    "todo",
    "checklist",
    "tasks",
    "outstanding",
    "chase"
  ],
  "pluginIcon": "data:image/png;base64,",
  "popularity": 0,
  "sizing": {
    "max": {
      "colSpan": 10,
      "rowSpan": 12
    },
    "min": {
      "colSpan": 4,
      "rowSpan": 4
    },
    "preferred": {
      "colSpan": 4,
      "rowSpan": 4
    }
  },
  "spec": {
    "elements": {
      "amount": {
        "props": {
          "size": "sm",
          "text": {
            "$computed": "format_currency",
            "args": {
              "currency": {
                "$item": "CurrencyCode"
              },
              "value": {
                "$item": "AmountDue"
              }
            }
          },
          "weight": "semibold"
        },
        "type": "Text"
      },
      "body": {
        "children": [
          "loading",
          "empty",
          "list"
        ],
        "type": "Body"
      },
      "card": {
        "children": [
          "header",
          "body"
        ],
        "type": "Card"
      },
      "count": {
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "n": {
                "$computed": "count",
                "args": {
                  "value": {
                    "$state": "/xero-accounting/list_invoices/Invoices"
                  }
                }
              },
              "pattern": "{n} Open"
            }
          }
        },
        "type": "Eyebrow"
      },
      "due": {
        "props": {
          "text": {
            "$computed": "xero-accounting_format_date",
            "args": {
              "format": "medium",
              "value": {
                "$item": "DueDate"
              }
            }
          },
          "tone": "warning",
          "variant": "soft"
        },
        "type": "Badge"
      },
      "empty": {
        "props": {
          "message": "Nothing to pay — you're all clear."
        },
        "type": "Empty",
        "visible": {
          "$and": [
            {
              "$state": "/_loading/xero-accounting.list_invoices",
              "not": true
            },
            {
              "$state": "/xero-accounting/list_invoices/Invoices/0",
              "not": true
            }
          ]
        }
      },
      "header": {
        "children": [
          "titleGroup"
        ],
        "type": "Header"
      },
      "idBottom": {
        "props": {
          "text": {
            "$item": "InvoiceNumber"
          }
        },
        "type": "Caption"
      },
      "idTop": {
        "props": {
          "size": "sm",
          "text": {
            "$item": "Contact/Name"
          },
          "truncate": true,
          "weight": "medium"
        },
        "type": "Text"
      },
      "identity": {
        "children": [
          "idTop",
          "idBottom"
        ],
        "props": {
          "gap": "xs"
        },
        "type": "Stack"
      },
      "list": {
        "children": [
          "row"
        ],
        "props": {
          "gap": "xs"
        },
        "repeat": {
          "key": "InvoiceID",
          "statePath": "/xero-accounting/list_invoices/Invoices"
        },
        "type": "Stack",
        "visible": {
          "$state": "/_loading/xero-accounting.list_invoices",
          "not": true
        }
      },
      "loading": {
        "children": [
          "sk1",
          "sk2",
          "sk3",
          "sk4"
        ],
        "props": {
          "gap": "sm"
        },
        "type": "Stack",
        "visible": {
          "$state": "/_loading/xero-accounting.list_invoices"
        }
      },
      "priority": {
        "props": {
          "size": "sm",
          "tone": "warning"
        },
        "type": "Dot"
      },
      "row": {
        "children": [
          "priority",
          "identity",
          "amount",
          "due"
        ],
        "on": {
          "click": {
            "action": "open_invoice_modal",
            "params": {
              "invoiceId": {
                "$computed": "identity",
                "args": {
                  "value": {
                    "$item": "InvoiceID"
                  }
                }
              }
            }
          }
        },
        "props": {
          "align": "center",
          "clickable": true,
          "gap": "sm",
          "hover": true,
          "template": "auto minmax(0, 1fr) 6rem 7rem"
        },
        "type": "Row"
      },
      "sk1": {
        "props": {
          "height": "2.25rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "sk2": {
        "props": {
          "height": "2.25rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "sk3": {
        "props": {
          "height": "2.25rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "sk4": {
        "props": {
          "height": "2.25rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "title": {
        "props": {
          "level": "h2",
          "text": "Bills to Pay"
        },
        "type": "Heading"
      },
      "titleGroup": {
        "children": [
          "titleIcon",
          "titleStack"
        ],
        "props": {
          "align": "start",
          "gap": "sm"
        },
        "type": "Row"
      },
      "titleIcon": {
        "props": {
          "name": "Receipt",
          "size": "sm",
          "tone": "warning"
        },
        "type": "Icon"
      },
      "titleStack": {
        "children": [
          "title",
          "count"
        ],
        "props": {
          "gap": "none"
        },
        "type": "Stack"
      }
    },
    "root": "card"
  },
  "tags": [
    "xero",
    "invoices",
    "todo",
    "checklist",
    "finance"
  ],
  "title": "Xero — Bills to Pay"
}
