{
  "id": "shopify-account-profile",
  "title": "Account Profile",
  "description": "Authenticated Shopify customer's account details — name, email, phone, default city, order count, and total spent.",
  "category": "ecommerce",
  "tags": [
    "shopify",
    "account",
    "customer",
    "profile",
    "ecommerce"
  ],
  "keywords": [
    "account",
    "profile",
    "customer",
    "shopify",
    "email",
    "address",
    "orders",
    "spend"
  ],
  "connectorsUsed": [
    "shopify-customer"
  ],
  "popularity": 0,
  "sizing": {
    "preferred": {
      "colSpan": 4,
      "rowSpan": 5
    },
    "min": {
      "colSpan": 3,
      "rowSpan": 4
    },
    "max": {
      "colSpan": 6,
      "rowSpan": 8
    }
  },
  "dataProvider": {
    "mcp": "shopify-customer",
    "tool": "get_customer",
    "params": {}
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "children": [
          "header",
          "body"
        ]
      },
      "header": {
        "type": "Header",
        "children": [
          "titleRow"
        ]
      },
      "titleRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "start"
        },
        "children": [
          "titleIcon",
          "titleStack"
        ]
      },
      "titleIcon": {
        "type": "Icon",
        "props": {
          "name": "User",
          "tone": "accent",
          "size": "sm"
        }
      },
      "titleStack": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "children": [
          "title",
          "eyebrow"
        ]
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "Account Profile",
          "level": "h2"
        }
      },
      "eyebrow": {
        "type": "Eyebrow",
        "props": {
          "text": "Your Shopify account"
        }
      },
      "body": {
        "type": "Body",
        "children": [
          "loading",
          "content"
        ]
      },
      "loading": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "visible": {
          "$state": "/_loading/shopify-customer.get_customer"
        },
        "children": [
          "sk1",
          "sk2",
          "sk3"
        ]
      },
      "sk1": {
        "type": "Skeleton",
        "props": {
          "height": "3rem",
          "rounded": "md"
        }
      },
      "sk2": {
        "type": "Skeleton",
        "props": {
          "height": "1.5rem",
          "rounded": "sm"
        }
      },
      "sk3": {
        "type": "Skeleton",
        "props": {
          "height": "1.5rem",
          "rounded": "sm"
        }
      },
      "content": {
        "type": "Stack",
        "props": {
          "gap": "md"
        },
        "visible": {
          "$state": "/_loading/shopify-customer.get_customer",
          "not": true
        },
        "children": [
          "avatarRow",
          "divider1",
          "kvStack",
          "divider2",
          "statsRow"
        ]
      },
      "avatarRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center"
        },
        "children": [
          "avatar",
          "nameStack"
        ]
      },
      "avatar": {
        "type": "Avatar",
        "props": {
          "initials": {
            "$computed": "initials",
            "args": {
              "value": {
                "$computed": "fmt",
                "args": {
                  "pattern": "{first} {last}",
                  "first": {
                    "$state": "/shopify-customer/get_customer/customer/firstName"
                  },
                  "last": {
                    "$state": "/shopify-customer/get_customer/customer/lastName"
                  }
                }
              }
            }
          },
          "size": "lg"
        }
      },
      "nameStack": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "children": [
          "fullName",
          "emailCaption"
        ]
      },
      "fullName": {
        "type": "Heading",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{first} {last}",
              "first": {
                "$state": "/shopify-customer/get_customer/customer/firstName"
              },
              "last": {
                "$state": "/shopify-customer/get_customer/customer/lastName"
              }
            }
          },
          "level": "h3"
        }
      },
      "emailCaption": {
        "type": "Caption",
        "props": {
          "text": {
            "$state": "/shopify-customer/get_customer/customer/email"
          }
        }
      },
      "divider1": {
        "type": "Divider"
      },
      "kvStack": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "kvPhone",
          "kvCity"
        ]
      },
      "kvPhone": {
        "type": "KeyValue",
        "props": {
          "label": "Phone",
          "value": {
            "$state": "/shopify-customer/get_customer/customer/phone"
          }
        }
      },
      "kvCity": {
        "type": "KeyValue",
        "props": {
          "label": "City",
          "value": {
            "$state": "/shopify-customer/get_customer/customer/defaultAddress/city"
          }
        }
      },
      "divider2": {
        "type": "Divider"
      },
      "statsRow": {
        "type": "Row",
        "props": {
          "gap": "md",
          "justify": "around"
        },
        "children": [
          "statOrders",
          "statSpent"
        ]
      },
      "statOrders": {
        "type": "Stack",
        "props": {
          "gap": "xs",
          "align": "center"
        },
        "children": [
          "statOrdersVal",
          "statOrdersLabel"
        ]
      },
      "statOrdersVal": {
        "type": "Heading",
        "props": {
          "text": {
            "$state": "/shopify-customer/get_customer/customer/numberOfOrders"
          },
          "level": "h3"
        }
      },
      "statOrdersLabel": {
        "type": "Caption",
        "props": {
          "text": "Orders"
        }
      },
      "statSpent": {
        "type": "Stack",
        "props": {
          "gap": "xs",
          "align": "center"
        },
        "children": [
          "statSpentVal",
          "statSpentLabel"
        ]
      },
      "statSpentVal": {
        "type": "Heading",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{amount} {currency}",
              "amount": {
                "$state": "/shopify-customer/get_customer/customer/totalSpent/amount"
              },
              "currency": {
                "$state": "/shopify-customer/get_customer/customer/totalSpent/currencyCode"
              }
            }
          },
          "level": "h3"
        }
      },
      "statSpentLabel": {
        "type": "Caption",
        "props": {
          "text": "Total Spent"
        }
      }
    }
  },
  "status": "published"
}
