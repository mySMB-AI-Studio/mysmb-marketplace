      "titleIcon": {
        "type": "Icon",
        "props": { "name": "ShoppingCart", "tone": "accent", "size": "sm" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "count"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Order History", "level": "h2" }
      },
      "count": {
        "type": "Eyebrow",
        "props": { "text": "4 orders" }
      },

      "body": {
        "type": "Body",
        "children": ["colHeader", "divider0", "rows"]
      },

