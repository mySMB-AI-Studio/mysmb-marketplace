      "colStatus": {
        "type": "Caption",
        "props": { "text": "STATUS" }
      },
      "colTotal": {
        "type": "Caption",
        "props": { "text": "TOTAL" }
      },

      "divider0": { "type": "Divider" },

      "rows": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["ord1", "rd1", "ord2", "rd2", "ord3", "rd3", "ord4"]
      },

      "ord1": {
        "type": "Row",
        "props": { "justify": "between", "align": "center", "hover": true },
        "children": ["ord1Left", "ord1Right"]
      },
      "ord1Left": {
        "type": "Stack",
        "props": { "gap": "xs", "grow": true },
        "children": ["ord1Num", "ord1Date"]
      },
      "ord1Num": {
        "type": "Text",
        "props": { "text": "#1042", "size": "sm", "weight": "semibold" }
      },
      "ord1Date": {
        "type": "Caption",
        "props": { "text": "24 Jun 2026" }
      },
      "ord1Right": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["ord1Pay", "ord1Ful", "ord1Total"]
      },
      "ord1Pay": {
        "type": "Badge",
        "props": { "label": "Paid", "tone": "positive" }
      },
      "ord1Ful": {
        "type": "Badge",
        "props": { "label": "Fulfilled", "tone": "positive" }
      },
      "ord1Total": {
