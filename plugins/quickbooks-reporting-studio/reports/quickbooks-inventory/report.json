{
  "dataBindings": {
    "bindings": [
      {
        "id": "inventory_items",
        "params": {
          "maxResults": {
            "kind": "static",
            "value": 1000
          },
          "where": {
            "kind": "static",
            "value": "Type = 'Inventory' AND Active = true"
          }
        },
        "tool": {
          "mcp": "quickbooks-accounting",
          "name": "list_item"
        }
      },
      {
        "id": "inventory_valuation",
        "params": {},
        "tool": {
          "mcp": "quickbooks-accounting",
          "name": "get_report_inventory_valuation_summary"
        }
      },
      {
        "id": "inventory_asset_accounts",
        "params": {
          "maxResults": {
            "kind": "static",
            "value": 50
          },
          "where": {
            "kind": "static",
            "value": "AccountSubType = 'Inventory'"
          }
        },
        "tool": {
          "mcp": "quickbooks-accounting",
          "name": "list_account"
        }
      },
      {
        "id": "purchase_orders",
        "params": {
          "maxResults": {
            "kind": "static",
            "value": 500
          },
          "orderBy": {
            "kind": "static",
            "value": "TxnDate DESC"
          }
        },
        "tool": {
          "mcp": "quickbooks-accounting",
          "name": "list_purchase_order"
        }
      },
      {
        "id": "company_info",
        "params": {
          "query": {
            "kind": "static",
            "value": "SELECT * FROM CompanyInfo"
          }
        },
        "tool": {
          "mcp": "quickbooks-accounting",
          "name": "qbo_query"
        }
      },
      {
        "id": "prefs",
        "params": {},
        "tool": {
          "mcp": "quickbooks-accounting",
          "name": "get_preferences"
        }
      }
    ],
    "inputs": [
      {
        "default": "Bookkeeper",
        "label": "View as",
        "name": "persona",
        "options": [
          "Client",
          "Bookkeeper",
          "Practitioner",
          "Executive"
        ],
        "type": "enum"
      },
      {
        "default": "{\"cents\":1,\"k\":0,\"zeros\":1,\"neg\":\"minus\",\"red\":0,\"hdr\":1,\"ftr\":1,\"style\":\"qbo\",\"dens\":\"100\",\"p\":\"custom\",\"a\":\"custom\",\"c\":\"none\",\"v\":\"valuation\",\"x\":\"\"}",
        "label": "Display settings",
        "maxLength": 300,
        "name": "display",
        "type": "string"
      }
    ]
  },
  "description": "Live, validated QuickBooks Online Inventory Valuation (Q30): Inventory Valuation Summary, Inventory Status, Open Purchase Order List, Stocktake Worksheet.",
  "fileName": "quickbooks-inventory-valuation.html",
  "tags": [
    "quickbooks",
    "inventory"
  ],
  "title": "QuickBooks Inventory Valuation"
}
