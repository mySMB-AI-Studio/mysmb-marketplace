{
  "dataBindings": {
    "bindings": [
      {
        "id": "accounts",
        "params": {
          "maxResults": {
            "kind": "static",
            "value": 1000
          },
          "where": {
            "kind": "static",
            "value": "Active = true"
          }
        },
        "tool": {
          "mcp": "quickbooks-accounting",
          "name": "list_account"
        }
      },
      {
        "id": "aged_receivables",
        "params": {},
        "tool": {
          "mcp": "quickbooks-accounting",
          "name": "get_report_aged_receivables"
        }
      },
      {
        "id": "aged_payables",
        "params": {},
        "tool": {
          "mcp": "quickbooks-accounting",
          "name": "get_report_aged_payables"
        }
      },
      {
        "id": "transactions_30d",
        "params": {
          "end_date": {
            "kind": "context",
            "source": "now.date"
          },
          "start_date": {
            "input": "tx_start",
            "kind": "input"
          }
        },
        "tool": {
          "mcp": "quickbooks-accounting",
          "name": "get_report_transaction_list"
        }
      },
      {
        "id": "balance_sheet",
        "params": {
          "end_date": {
            "kind": "context",
            "source": "now.date"
          }
        },
        "tool": {
          "mcp": "quickbooks-accounting",
          "name": "get_report_balance_sheet"
        }
      },
      {
        "id": "company_info",
        "params": {
          "query": {
            "kind": "static",
            "value": "SELECT * FROM CompanyInfo"
          }
        },
        "tool": {
          "mcp": "quickbooks-accounting",
          "name": "qbo_query"
        }
      },
      {
        "id": "prefs",
        "params": {},
        "tool": {
          "mcp": "quickbooks-accounting",
          "name": "get_preferences"
        }
      }
    ],
    "inputs": [
      {
        "default": "2026-08-27",
        "label": "Transaction volume from",
        "name": "tx_start",
        "type": "date"
      },
      {
        "default": "Practitioner",
        "label": "View as",
        "name": "persona",
        "options": [
          "Client",
          "Bookkeeper",
          "Practitioner",
          "Executive"
        ],
        "type": "enum"
      },
      {
        "default": "{\"cents\":1,\"k\":0,\"zeros\":1,\"neg\":\"minus\",\"red\":0,\"hdr\":1,\"ftr\":1,\"style\":\"qbo\",\"dens\":\"100\",\"p\":\"custom\",\"a\":\"custom\",\"c\":\"none\",\"v\":\"\",\"x\":\"\"}",
        "label": "Display settings",
        "maxLength": 300,
        "name": "display",
        "type": "string"
      }
    ]
  },
  "description": "Live, validated QuickBooks Online Client Overview (Q16): Banking activity, Common issues, Transaction volume.",
  "fileName": "quickbooks-client-overview.html",
  "tags": [
    "quickbooks",
    "accountant",
    "books-review"
  ],
  "title": "QuickBooks Client Overview"
}
