{
  "dataBindings": {
    "bindings": [
      {
        "id": "pl_widget",
        "params": {
          "accounting_method": {
            "kind": "static",
            "value": "Accrual"
          },
          "end_date": {
            "input": "pl_end",
            "kind": "input"
          },
          "start_date": {
            "input": "pl_start",
            "kind": "input"
          },
          "summarize_column_by": {
            "kind": "static",
            "value": "Month"
          }
        },
        "tool": {
          "mcp": "quickbooks-accounting",
          "name": "get_report_profit_and_loss"
        }
      },
      {
        "id": "expenses_widget",
        "params": {
          "accounting_method": {
            "kind": "static",
            "value": "Accrual"
          },
          "end_date": {
            "kind": "context",
            "source": "now.date"
          },
          "start_date": {
            "input": "exp_start",
            "kind": "input"
          },
          "summarize_column_by": {
            "kind": "static",
            "value": "Total"
          }
        },
        "tool": {
          "mcp": "quickbooks-accounting",
          "name": "get_report_profit_and_loss"
        }
      },
      {
        "id": "bank_accounts",
        "params": {
          "maxResults": {
            "kind": "static",
            "value": 200
          },
          "where": {
            "kind": "static",
            "value": "AccountType IN ('Bank', 'Credit Card') AND Active = true"
          }
        },
        "tool": {
          "mcp": "quickbooks-accounting",
          "name": "list_account"
        }
      },
      {
        "id": "cash_flow_12m",
        "params": {
          "end_date": {
            "kind": "context",
            "source": "now.date"
          },
          "start_date": {
            "input": "cf_start",
            "kind": "input"
          },
          "summarize_column_by": {
            "kind": "static",
            "value": "Month"
          }
        },
        "tool": {
          "mcp": "quickbooks-accounting",
          "name": "get_report_cash_flow"
        }
      },
      {
        "id": "company_info",
        "params": {
          "query": {
            "kind": "static",
            "value": "SELECT * FROM CompanyInfo"
          }
        },
        "tool": {
          "mcp": "quickbooks-accounting",
          "name": "qbo_query"
        }
      },
      {
        "id": "prefs",
        "params": {},
        "tool": {
          "mcp": "quickbooks-accounting",
          "name": "get_preferences"
        }
      }
    ],
    "inputs": [
      {
        "default": "2026-07-01",
        "label": "P&L widget from",
        "name": "pl_start",
        "type": "date"
      },
      {
        "default": "2026-08-31",
        "label": "P&L widget to",
        "name": "pl_end",
        "type": "date"
      },
      {
        "default": "2026-08-27",
        "label": "Expenses widget from",
        "name": "exp_start",
        "type": "date"
      },
      {
        "default": "2025-10-01",
        "label": "Cash flow chart from",
        "name": "cf_start",
        "type": "date"
      },
      {
        "default": "Client",
        "label": "View as",
        "name": "persona",
        "options": [
          "Client",
          "Bookkeeper",
          "Practitioner",
          "Executive"
        ],
        "type": "enum"
      },
      {
        "default": "{\"cents\":0,\"k\":0,\"zeros\":1,\"neg\":\"minus\",\"red\":0,\"hdr\":1,\"ftr\":1,\"style\":\"qbo\",\"dens\":\"100\",\"p\":\"custom\",\"a\":\"custom\",\"c\":\"none\",\"v\":\"\",\"x\":\"last_month\"}",
        "label": "Display settings",
        "maxLength": 300,
        "name": "display",
        "type": "string"
      }
    ]
  },
  "description": "Live, validated QuickBooks Online Business Overview (Q00): Profit & Loss widget, Expenses widget, Bank accounts widget, Cash flow widget.",
  "fileName": "quickbooks-business-at-a-glance.html",
  "tags": [
    "quickbooks",
