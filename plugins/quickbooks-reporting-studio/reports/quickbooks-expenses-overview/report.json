{
  "dataBindings": {
    "bindings": [
      {
        "id": "open_bills",
        "params": {
          "maxResults": {
            "kind": "static",
            "value": 1000
          },
          "orderBy": {
            "kind": "static",
            "value": "DueDate"
          },
          "where": {
            "kind": "static",
            "value": "Balance > '0'"
          }
        },
        "tool": {
          "mcp": "quickbooks-accounting",
          "name": "list_bill"
        }
      },
      {
        "id": "bill_payments",
        "params": {
          "maxResults": {
            "kind": "static",
            "value": 1000
          },
          "orderBy": {
            "kind": "static",
            "value": "TxnDate DESC"
          }
        },
        "tool": {
          "mcp": "quickbooks-accounting",
          "name": "list_bill_payment"
        }
      },
      {
        "id": "aged_payables",
        "params": {},
        "tool": {
          "mcp": "quickbooks-accounting",
          "name": "get_report_aged_payables"
        }
      },
      {
        "id": "spend_monthly",
        "params": {
          "accounting_method": {
            "kind": "static",
            "value": "Accrual"
          },
          "end_date": {
            "input": "q_end",
            "kind": "input"
          },
          "start_date": {
            "input": "q_start",
            "kind": "input"
          },
          "summarize_column_by": {
            "kind": "static",
            "value": "Month"
          }
        },
        "tool": {
          "mcp": "quickbooks-accounting",
          "name": "get_report_profit_and_loss"
        }
      },
      {
        "id": "supplier_spend",
        "params": {
          "accounting_method": {
            "kind": "static",
            "value": "Accrual"
          },
          "end_date": {
            "input": "m_end",
            "kind": "input"
          },
          "start_date": {
            "input": "m_start",
            "kind": "input"
          }
        },
        "tool": {
          "mcp": "quickbooks-accounting",
          "name": "get_report_vendor_expenses"
        }
      },
      {
        "id": "company_info",
        "params": {
          "query": {
            "kind": "static",
            "value": "SELECT * FROM CompanyInfo"
          }
        },
        "tool": {
          "mcp": "quickbooks-accounting",
          "name": "qbo_query"
        }
      },
      {
        "id": "prefs",
        "params": {},
        "tool": {
          "mcp": "quickbooks-accounting",
          "name": "get_preferences"
        }
      }
    ],
    "inputs": [
      {
        "default": "2026-04-01",
        "label": "Spend chart from",
        "name": "q_start",
        "type": "date"
      },
      {
        "default": "2026-09-30",
        "label": "Spend chart to",
        "name": "q_end",
        "type": "date"
      },
      {
        "default": "2026-09-01",
        "label": "Spend insights from",
        "name": "m_start",
        "type": "date"
      },
      {
        "default": "2026-09-30",
        "label": "Spend insights to",
        "name": "m_end",
        "type": "date"
      },
      {
        "default": "Bookkeeper",
