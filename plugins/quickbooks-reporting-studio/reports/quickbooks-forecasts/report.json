{
  "dataBindings": {
    "bindings": [
      {
        "id": "pnl_monthly",
        "params": {
          "accounting_method": {
            "input": "basis",
            "kind": "input"
          },
          "end_date": {
            "kind": "context",
            "source": "now.date"
          },
          "start_date": {
            "input": "start_date",
            "kind": "input"
          },
          "summarize_column_by": {
            "kind": "static",
            "value": "Month"
          }
        },
        "tool": {
          "mcp": "quickbooks-accounting",
          "name": "get_report_profit_and_loss"
        }
      },
      {
        "id": "company_info",
        "params": {
          "query": {
            "kind": "static",
            "value": "SELECT * FROM CompanyInfo"
          }
        },
        "tool": {
          "mcp": "quickbooks-accounting",
          "name": "qbo_query"
        }
      },
      {
        "id": "prefs",
        "params": {},
        "tool": {
          "mcp": "quickbooks-accounting",
          "name": "get_preferences"
        }
      }
    ],
    "inputs": [
      {
        "default": "2025-09-01",
        "label": "Base period from",
        "name": "start_date",
        "type": "date"
      },
      {
        "default": "2026-08-31",
        "label": "Base period to",
        "name": "end_date",
        "type": "date"
      },
      {
        "default": "Accrual",
        "label": "Accounting method",
        "name": "basis",
        "options": [
          "Accrual",
          "Cash"
        ],
        "type": "enum"
      },
      {
        "default": "12",
        "label": "Forecast months",
        "name": "horizon",
        "options": [
          "3",
          "6",
          "12",
          "18",
          "24"
        ],
        "type": "enum"
      },
      {
        "default": "trend",
        "label": "Method",
        "name": "method",
        "options": [
          "trend",
          "average",
          "seasonal"
        ],
        "type": "enum"
      },
      {
        "default": "{}",
        "label": "Growth assumptions",
        "maxLength": 400,
        "name": "adjust",
        "type": "string"
      },
      {
        "default": "Executive",
        "label": "View as",
        "name": "persona",
        "options": [
          "Client",
          "Bookkeeper",
          "Practitioner",
          "Executive"
        ],
        "type": "enum"
      },
      {
        "default": "{\"cents\":0,\"k\":0,\"zeros\":1,\"neg\":\"minus\",\"red\":0,\"hdr\":1,\"ftr\":1,\"style\":\"qbo\",\"dens\":\"100\",\"p\":\"last_12m\",\"a\":\"custom\",\"c\":\"none\",\"v\":\"grid\",\"x\":\"\"}",
        "label": "Display settings",
        "maxLength": 300,
        "name": "display",
        "type": "string"
      }
    ]
  },
  "description": "Live, validated QuickBooks Online Forecasts (Q09): Create forecast (base period, growth assumptions), Forecast grid by account × month, Scenario columns, Forecast vs actual, Actual → forecast line with confidence band.",
