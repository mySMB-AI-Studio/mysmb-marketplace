{
  "dataBindings": {
    "bindings": [
      {
        "id": "cash_accounts",
        "params": {
          "maxResults": {
            "kind": "static",
            "value": 200
          },
          "where": {
            "kind": "static",
            "value": "AccountType IN ('Bank', 'Credit Card') AND Active = true"
          }
        },
        "tool": {
          "mcp": "quickbooks-accounting",
          "name": "list_account"
        }
      },
      {
        "id": "cash_flow_12m",
        "params": {
          "end_date": {
            "kind": "context",
            "source": "now.date"
          },
          "start_date": {
            "input": "cf_start",
            "kind": "input"
          },
          "summarize_column_by": {
            "kind": "static",
            "value": "Month"
          }
        },
        "tool": {
          "mcp": "quickbooks-accounting",
          "name": "get_report_cash_flow"
        }
      },
      {
        "id": "open_invoices",
        "params": {
          "maxResults": {
            "kind": "static",
            "value": 1000
          },
          "orderBy": {
            "kind": "static",
            "value": "DueDate"
          },
          "where": {
            "kind": "static",
            "value": "Balance > '0'"
          }
        },
        "tool": {
          "mcp": "quickbooks-accounting",
          "name": "list_invoice"
        }
      },
      {
        "id": "open_bills",
        "params": {
          "maxResults": {
            "kind": "static",
            "value": 1000
          },
          "orderBy": {
            "kind": "static",
            "value": "DueDate"
          },
          "where": {
            "kind": "static",
            "value": "Balance > '0'"
          }
        },
        "tool": {
          "mcp": "quickbooks-accounting",
          "name": "list_bill"
        }
      },
      {
        "id": "payments_received",
        "params": {
          "maxResults": {
            "kind": "static",
            "value": 1000
          },
          "orderBy": {
            "kind": "static",
            "value": "TxnDate DESC"
          }
        },
        "tool": {
          "mcp": "quickbooks-accounting",
          "name": "list_payment"
        }
      },
      {
        "id": "bill_payments",
        "params": {
          "maxResults": {
            "kind": "static",
            "value": 1000
          },
          "orderBy": {
            "kind": "static",
            "value": "TxnDate DESC"
          }
        },
        "tool": {
          "mcp": "quickbooks-accounting",
          "name": "list_bill_payment"
        }
      },
      {
        "id": "expenses_paid",
        "params": {
          "maxResults": {
            "kind": "static",
            "value": 1000
          },
          "orderBy": {
            "kind": "static",
            "value": "TxnDate DESC"
          }
        },
        "tool": {
          "mcp": "quickbooks-accounting",
          "name": "list_purchase"
        }
      },
      {
        "id": "company_info",
        "params": {
          "query": {
            "kind": "static",
            "value": "SELECT * FROM CompanyInfo"
          }
        },
        "tool": {
          "mcp": "quickbooks-accounting",
          "name": "qbo_query"
        }
      },
      {
        "id": "prefs",
        "params": {},
        "tool": {
          "mcp": "quickbooks-accounting",
          "name": "get_preferences"
        }
      }
    ],
    "inputs": [
      {
        "default": "2025-10-01",
        "label": "Chart from",
        "name": "cf_start",
        "type": "date"
      },
      {
        "default": "Client",
        "label": "View as",
        "name": "persona",
        "options": [
          "Client",
          "Bookkeeper",
          "Practitioner",
          "Executive"
        ],
        "type": "enum"
      },
      {
        "default": "{\"cents\":0,\"k\":0,\"zeros\":1,\"neg\":\"minus\",\"red\":0,\"hdr\":1,\"ftr\":1,\"style\":\"qbo\",\"dens\":\"100\",\"p\":\"custom\",\"a\":\"custom\",\"c\":\"none\",\"v\":\"balance\",\"x\":\"upcoming\"}",
        "label": "Display settings",
        "maxLength": 300,
        "name": "display",
        "type": "string"
      }
    ]
  },
  "description": "Live, validated QuickBooks Online Cash Flow Overview (Q07): Today's cash balance (all / bank / credit cards), Cash balance chart / Money in/out, Monthly outlook — Money in / Money out, Upcoming | Paid, 30-day projection.",
  "fileName": "quickbooks-cash-flow-overview.html",
  "tags": [
    "quickbooks",
    "cash",
    "dashboard"
  ],
  "title": "QuickBooks Cash Flow Overview"
}
