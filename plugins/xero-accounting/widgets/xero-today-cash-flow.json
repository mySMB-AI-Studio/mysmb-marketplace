{
  "category": "finance",
  "connectorsUsed": [
    "xero-accounting"
  ],
  "dataProvider": {
    "kind": "tool",
    "mcp": "xero-accounting",
    "params": {
      "fromDate": "$month_start_date",
      "toDate": "$today_date"
    },
    "tool": "get_bank_summary"
  },
  "description": "Cash in vs cash out for a chosen period — sourced from Xero's Bank Summary report so the totals reconcile exactly with Xero.",
  "id": "xero-today-cash-flow",
  "keywords": [
    "cash",
    "flow",
    "cash flow",
    "liquidity",
    "bank",
    "balance",
    "in",
    "out"
  ],
  "pluginIcon": "data:image/png;base64,",
  "popularity": 84,
  "sizing": {
    "max": {
      "colSpan": 10,
      "rowSpan": 8
    },
    "min": {
      "colSpan": 4,
      "rowSpan": 4
    },
    "preferred": {
      "colSpan": 4,
      "rowSpan": 4
    }
  },
  "spec": {
    "elements": {
      "body": {
        "children": [
          "loadingList",
          "table"
        ],
        "type": "Body"
      },
      "card": {
        "children": [
          "header",
          "loadingStats",
          "stats",
          "divider",
          "body"
        ],
        "type": "Card",
        "watch": {
          "/xero-accounting/get_bank_summary/Reports": {
            "action": "setState",
            "params": {
              "statePath": "/ui/cf/rows",
              "value": {
                "$computed": "xero-accounting_flatten_report_rows",
                "args": {
                  "value": {
                    "$state": "/xero-accounting/get_bank_summary/Reports/0"
                  }
                }
              }
            }
          }
        }
      },
      "chip30": {
        "children": [
          "chip30Label"
        ],
        "on": {
          "click": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/cf/period",
                "value": "30d"
              }
            },
            {
              "action": "xero-accounting.get_bank_summary",
              "params": {
                "fromDate": "$days_ago_30_date",
                "toDate": "$today_date"
              }
            }
          ]
        },
        "props": {
          "align": "center",
          "clickable": true,
          "gap": "none",
          "hover": true,
          "selected": {
            "$computed": "equals",
            "args": {
              "a": "30d",
              "b": {
                "$state": "/ui/cf/period"
              }
            }
          }
        },
        "type": "Row"
      },
      "chip30Label": {
        "props": {
          "size": "xs",
          "text": "30 Days",
          "weight": "medium"
        },
        "type": "Text"
      },
      "chipLastMonth": {
        "children": [
          "chipLastMonthLabel"
        ],
        "on": {
          "click": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/cf/period",
                "value": "lastMonth"
              }
            },
            {
              "action": "xero-accounting.get_bank_summary",
              "params": {
                "fromDate": "$last_month_start_date",
                "toDate": "$last_month_end_date"
              }
            }
          ]
        },
        "props": {
          "align": "center",
          "clickable": true,
          "gap": "none",
          "hover": true,
          "selected": {
            "$computed": "equals",
            "args": {
              "a": "lastMonth",
              "b": {
                "$state": "/ui/cf/period"
              }
            }
          }
        },
        "type": "Row"
      },
      "chipLastMonthLabel": {
        "props": {
          "size": "xs",
          "text": "Last Month",
          "weight": "medium"
        },
        "type": "Text"
      },
      "chipMonth": {
        "children": [
          "chipMonthLabel"
        ],
        "on": {
          "click": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/cf/period",
                "value": "month"
              }
            },
            {
              "action": "xero-accounting.get_bank_summary",
              "params": {
                "fromDate": "$month_start_date",
                "toDate": "$today_date"
              }
            }
          ]
        },
        "props": {
          "align": "center",
          "clickable": true,
          "gap": "none",
          "hover": true,
          "selected": {
            "$computed": "equals",
            "args": {
              "a": "month",
              "b": {
                "$state": "/ui/cf/period"
              }
            }
          }
        },
        "type": "Row"
      },
      "chipMonthLabel": {
        "props": {
          "size": "xs",
          "text": "This Month",
          "weight": "medium"
        },
        "type": "Text"
      },
      "chipQuarter": {
        "children": [
          "chipQuarterLabel"
        ],
        "on": {
          "click": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/cf/period",
                "value": "quarter"
              }
            },
            {
              "action": "xero-accounting.get_bank_summary",
              "params": {
                "fromDate": "$quarter_start_date",
                "toDate": "$today_date"
              }
            }
          ]
        },
        "props": {
          "align": "center",
          "clickable": true,
          "gap": "none",
          "hover": true,
          "selected": {
            "$computed": "equals",
            "args": {
              "a": "quarter",
              "b": {
                "$state": "/ui/cf/period"
              }
            }
          }
        },
        "type": "Row"
      },
      "chipQuarterLabel": {
        "props": {
          "size": "xs",
          "text": "This Quarter",
          "weight": "medium"
        },
        "type": "Text"
      },
      "divider": {
        "type": "Divider"
      },
      "header": {
        "children": [
          "titleGroup",
          "periodChips"
        ],
        "type": "Header"
      },
      "inCell": {
        "children": [
          "inLabelRow",
          "inValue"
        ],
        "props": {
          "gap": "xs"
        },
        "type": "Stack"
      },
      "inIcon": {
        "props": {
          "name": "ArrowDownCircle",
          "size": "xs",
          "tone": "success"
        },
        "type": "Icon"
      },
      "inLabel": {
        "props": {
          "text": "Cash In"
        },
        "type": "Eyebrow"
      },
      "inLabelRow": {
        "children": [
          "inIcon",
          "inLabel"
        ],
        "props": {
          "align": "center",
          "gap": "xs"
        },
        "type": "Row"
      },
      "inValue": {
        "props": {
          "tone": "success",
          "value": {
            "$computed": "format_currency",
            "args": {
              "value": {
                "$computed": "sum",
                "args": {
                  "equals": "Row",
                  "field": "c2",
                  "value": {
                    "$state": "/ui/cf/rows"
                  },
                  "whereField": "rowType"
                }
              }
            }
          }
        },
        "type": "Stat"
      },
      "loadStatA": {
        "props": {
          "height": "3rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "loadStatB": {
        "props": {
          "height": "3rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "loadingList": {
        "children": [
          "ls1",
          "ls2",
          "ls3"
        ],
        "props": {
          "gap": "sm"
        },
        "type": "Stack",
        "visible": {
          "$state": "/_loading/xero-accounting.get_bank_summary"
        }
      },
      "loadingStats": {
        "children": [
          "loadStatA",
          "loadStatB"
        ],
        "props": {
          "cols": 2,
          "gap": "md"
        },
        "type": "Grid",
        "visible": {
          "$state": "/_loading/xero-accounting.get_bank_summary"
        }
      },
      "ls1": {
        "props": {
          "height": "2rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "ls2": {
        "props": {
          "height": "2rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "ls3": {
        "props": {
          "height": "2rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "outCell": {
        "children": [
          "outLabelRow",
          "outValue"
        ],
        "props": {
          "gap": "xs"
        },
        "type": "Stack"
      },
      "outIcon": {
        "props": {
          "name": "ArrowUpCircle",
          "size": "xs",
          "tone": "destructive"
        },
        "type": "Icon"
      },
      "outLabel": {
        "props": {
          "text": "Cash Out"
        },
        "type": "Eyebrow"
      },
      "outLabelRow": {
        "children": [
          "outIcon",
          "outLabel"
        ],
        "props": {
          "align": "center",
          "gap": "xs"
        },
        "type": "Row"
      },
      "outValue": {
        "props": {
          "tone": "destructive",
          "value": {
            "$computed": "format_currency",
            "args": {
              "value": {
                "$computed": "sum",
                "args": {
                  "equals": "Row",
                  "field": "c3",
                  "value": {
                    "$state": "/ui/cf/rows"
                  },
                  "whereField": "rowType"
                }
              }
            }
          }
        },
        "type": "Stat"
      },
      "periodChips": {
        "children": [
          "chipMonth",
          "chipLastMonth",
          "chip30",
          "chipQuarter"
        ],
        "props": {
          "align": "center",
          "gap": "xs"
        },
        "type": "Row"
      },
      "periodLabel": {
        "props": {
          "text": {
            "$state": "/xero-accounting/get_bank_summary/Reports/0/ReportTitles/2"
          }
        },
        "type": "Eyebrow"
      },
      "stats": {
        "children": [
          "inCell",
          "outCell"
        ],
        "props": {
          "cols": 2,
          "gap": "md"
        },
        "type": "Grid",
        "visible": {
          "$state": "/_loading/xero-accounting.get_bank_summary",
          "not": true
        }
      },
      "table": {
        "props": {
          "columns": [
            {
              "field": "c0",
              "header": "Account",
              "id": "account",
              "priority": 1
            },
            {
              "align": "right",
              "field": "c2",
              "format": "currency",
              "header": "Cash In",
              "id": "in",
              "priority": 1
            },
            {
              "align": "right",
              "field": "c3",
              "format": "currency",
              "header": "Cash Out",
              "id": "out",
              "priority": 1
            },
            {
              "align": "right",
              "field": "c4",
              "format": "currency",
              "header": "Balance",
              "id": "balance",
              "priority": 2
            }
          ],
          "rows": {
            "$state": "/ui/cf/rows"
          }
        },
        "type": "Table",
        "visible": {
          "$state": "/_loading/xero-accounting.get_bank_summary",
          "not": true
        }
      },
      "title": {
        "props": {
          "level": "h2",
          "text": "Cash Flow"
        },
        "type": "Heading"
      },
      "titleGroup": {
        "children": [
          "titleIcon",
          "titleStack"
        ],
        "props": {
          "align": "start",
          "gap": "sm"
        },
        "type": "Row"
      },
      "titleIcon": {
        "props": {
          "name": "Wallet",
          "size": "sm",
          "tone": "accent"
        },
        "type": "Icon"
      },
      "titleStack": {
        "children": [
          "title",
          "periodLabel"
        ],
        "props": {
          "gap": "none"
        },
        "type": "Stack"
      }
    },
    "root": "card"
  },
  "tags": [
    "xero",
    "cash-flow",
    "finance",
    "report",
    "bank"
  ],
  "title": "Cash Flow"
}
