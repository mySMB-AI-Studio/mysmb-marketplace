{
  "id": "xero-action-queue",
  "title": "Action Queue",
  "description": "Everything needing your attention in Xero — outstanding invoices, bills, bank reconciliation, and expense claims in one scannable list. Each row deep-links directly into the relevant Xero screen.",
  "category": "finance",
  "tags": ["xero", "invoices", "bills", "reconciliation", "expenses", "finance", "action"],
  "keywords": ["action", "queue", "todo", "tasks", "reconcile", "invoices", "bills", "expenses", "attention", "outstanding"],
  "connectorsUsed": ["xero-accounting"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 3, "rowSpan": 5 },
    "min": { "colSpan": 3, "rowSpan": 4 },
    "max": { "colSpan": 6, "rowSpan": 8 }
  },
  "dataProvider": {
    "mcp": "xero-accounting",
    "tool": "list_invoices",
    "params": { "statuses": "AUTHORISED", "order": "DueDate ASC" }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": ["header", "body"],
        "watch": {
          "/xero-accounting/list_invoices": {
            "action": "xero-accounting.list_bank_transactions",
            "params": { "where": "IsReconciled==false", "order": "Date DESC" }
          },
          "/xero-accounting/list_bank_transactions": {
            "action": "xero-accounting.list_expense_claims",
            "params": { "where": "Status==\"SUBMITTED\"" }
          }
        }
      },

      "header": {
        "type": "Header",
        "props": {},
        "children": ["titleRow"]
      },
      "titleRow": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "title"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "LayoutList", "tone": "accent", "size": "sm" }
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Action Queue", "level": "h2" }
      },

      "body": {
        "type": "Body",
        "props": {},
        "children": ["loadingRows", "rows", "footer"]
      },

      "loadingRows": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["sk1", "sk2", "sk3", "sk4"],
        "visible": { "$state": "/_loading/xero-accounting.list_invoices" }
      },
      "sk1": { "type": "Skeleton", "props": { "height": "2.75rem", "rounded": "md" } },
      "sk2": { "type": "Skeleton", "props": { "height": "2.75rem", "rounded": "md" } },
      "sk3": { "type": "Skeleton", "props": { "height": "2.75rem", "rounded": "md" } },
      "sk4": { "type": "Skeleton", "props": { "height": "2.75rem", "rounded": "md" } },

      "rows": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["invoicesRow", "billsRow", "reconcileRow", "expenseRow"],
        "visible": { "$state": "/_loading/xero-accounting.list_invoices", "not": true }
      },

      "invoicesRow": {
        "type": "Row",
        "props": { "gap": "sm", "align": "start", "hover": true, "clickable": true },
        "children": ["invIcon", "invLabels", "invCount", "invChevron"],
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "url": "https://go.xero.com/AccountsReceivable/Search.aspx?invoiceStatus=INVOICESTATUS/AUTHORISED",
              "target": "_blank"
            }
          }
        }
      },
      "invIcon": {
        "type": "Icon",
        "props": { "name": "FileText", "tone": "destructive", "size": "sm" }
      },
      "invLabels": {
        "type": "Stack",
        "props": { "gap": "xs", "grow": true },
        "children": ["invLabel", "invSub"]
      },
      "invLabel": {
        "type": "Text",
        "props": { "text": "Invoices To Collect", "size": "sm", "weight": "medium" }
      },
      "invSub": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{n} Outstanding",
              "n": {
                "$computed": "count_where",
                "args": {
                  "value": { "$state": "/xero-accounting/list_invoices/Invoices" },
                  "whereField": "Type",
                  "equals": "ACCREC"
                }
              }
            }
          }
        }
      },
      "invCount": {
        "type": "Text",
        "props": {
          "text": {
            "$computed": "count_where",
            "args": {
              "value": { "$state": "/xero-accounting/list_invoices/Invoices" },
              "whereField": "Type",
              "equals": "ACCREC"
            }
          },
          "size": "lg",
          "weight": "semibold",
          "tone": "destructive"
        }
      },
      "invChevron": {
        "type": "Icon",
        "props": { "name": "ChevronRight", "tone": "muted", "size": "xs" }
      },

      "billsRow": {
        "type": "Row",
        "props": { "gap": "sm", "align": "start", "hover": true, "clickable": true },
        "children": ["billIcon", "billLabels", "billCount", "billChevron"],
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "url": "https://go.xero.com/AccountsPayable/Search.aspx?invoiceStatus=INVOICESTATUS/AUTHORISED",
              "target": "_blank"
            }
          }
        }
      },
      "billIcon": {
        "type": "Icon",
        "props": { "name": "CreditCard", "tone": "warning", "size": "sm" }
      },
      "billLabels": {
        "type": "Stack",
        "props": { "gap": "xs", "grow": true },
        "children": ["billLabel", "billSub"]
      },
      "billLabel": {
        "type": "Text",
        "props": { "text": "Bills To Pay", "size": "sm", "weight": "medium" }
      },
      "billSub": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{n} Outstanding",
              "n": {
                "$computed": "count_where",
                "args": {
                  "value": { "$state": "/xero-accounting/list_invoices/Invoices" },
                  "whereField": "Type",
                  "equals": "ACCPAY"
                }
              }
            }
          }
        }
      },
      "billCount": {
        "type": "Text",
        "props": {
          "text": {
            "$computed": "count_where",
            "args": {
              "value": { "$state": "/xero-accounting/list_invoices/Invoices" },
              "whereField": "Type",
              "equals": "ACCPAY"
            }
          },
          "size": "lg",
          "weight": "semibold",
          "tone": "warning"
        }
      },
      "billChevron": {
        "type": "Icon",
        "props": { "name": "ChevronRight", "tone": "muted", "size": "xs" }
      },

      "reconcileRow": {
        "type": "Row",
        "props": { "gap": "sm", "align": "start", "hover": true, "clickable": true },
        "children": ["recIcon", "recLabels", "recCount", "recChevron"],
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "url": "https://go.xero.com/Bank/BankRec.aspx",
              "target": "_blank"
            }
          }
        }
      },
      "recIcon": {
        "type": "Icon",
        "props": { "name": "Landmark", "tone": "warning", "size": "sm" }
      },
      "recLabels": {
        "type": "Stack",
        "props": { "gap": "xs", "grow": true },
        "children": ["recLabel", "recSub"]
      },
      "recLabel": {
        "type": "Text",
        "props": { "text": "Reconcile Items", "size": "sm", "weight": "medium" }
      },
      "recSub": {
        "type": "Caption",
        "props": { "text": "Bank Transactions" }
      },
      "recCount": {
        "type": "Text",
        "props": {
          "text": {
            "$cond": { "$state": "/_loading/xero-accounting.list_bank_transactions" },
            "$then": "—",
            "$else": {
              "$computed": "count",
              "args": {
                "value": { "$state": "/xero-accounting/list_bank_transactions/BankTransactions" }
              }
            }
          },
          "size": "lg",
          "weight": "semibold",
          "tone": "warning"
        }
      },
      "recChevron": {
        "type": "Icon",
        "props": { "name": "ChevronRight", "tone": "muted", "size": "xs" }
      },

      "expenseRow": {
        "type": "Row",
        "props": { "gap": "sm", "align": "start", "hover": true, "clickable": true },
        "children": ["expIcon", "expLabels", "expCount", "expChevron"],
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "url": "https://go.xero.com/ExpenseClaims/?status=SUBMITTED",
              "target": "_blank"
            }
          }
        }
      },
      "expIcon": {
        "type": "Icon",
        "props": { "name": "Wallet", "tone": "muted", "size": "sm" }
      },
      "expLabels": {
        "type": "Stack",
        "props": { "gap": "xs", "grow": true },
        "children": ["expLabel", "expSub"]
      },
      "expLabel": {
        "type": "Text",
        "props": { "text": "Expense Claims", "size": "sm", "weight": "medium" }
      },
      "expSub": {
        "type": "Caption",
        "props": { "text": "Awaiting Approval" }
      },
      "expCount": {
        "type": "Text",
        "props": {
          "text": {
            "$cond": { "$state": "/_loading/xero-accounting.list_expense_claims" },
            "$then": "—",
            "$else": {
              "$computed": "count",
              "args": {
                "value": { "$state": "/xero-accounting/list_expense_claims/ExpenseClaims" }
              }
            }
          },
          "size": "lg",
          "weight": "semibold",
          "tone": "muted"
        }
      },
      "expChevron": {
        "type": "Icon",
        "props": { "name": "ChevronRight", "tone": "muted", "size": "xs" }
      },

      "footer": {
        "type": "Row",
        "props": { "justify": "end", "gap": "xs", "align": "center" },
        "children": ["footerBtn"],
        "visible": { "$state": "/_loading/xero-accounting.list_invoices", "not": true }
      },
      "footerBtn": {
        "type": "Button",
        "props": {
          "label": "Open Xero",
          "variant": "ghost",
          "size": "sm",
          "leadingIcon": "ExternalLink"
        },
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "url": "https://go.xero.com/",
              "target": "_blank"
            }
          }
        }
      }
    }
  },
  "status": "draft"
}
