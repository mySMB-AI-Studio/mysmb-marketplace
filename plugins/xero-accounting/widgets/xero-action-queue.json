          "size": "sm"
        }
      },
      "expLabels": {
        "type": "Stack",
        "props": {
          "gap": "xs",
          "grow": true
        },
        "children": [
          "expLabel",
          "expSub"
        ]
      },
      "expLabel": {
        "type": "Text",
        "props": {
          "text": "Expense Claims",
          "size": "sm",
          "weight": "medium"
        }
      },
      "expSub": {
        "type": "Caption",
        "props": {
          "text": {
            "$cond": {
              "$state": "/ui/aq/ready"
            },
            "$then": {
              "$state": "/ui/aq/rows/exp/sub"
            },
            "$else": "—"
          }
        }
      },
      "expRight": {
        "type": "Stack",
        "props": {
          "gap": "xs",
          "align": "end"
        },
        "children": [
          "expCount",
          "expBadge"
        ]
      },
      "expCount": {
        "type": "Text",
        "props": {
          "text": {
            "$cond": {
              "$state": "/ui/aq/ready"
            },
            "$then": {
              "$state": "/ui/aq/rows/exp/count"
            },
            "$else": "—"
          },
          "size": "lg",
          "weight": "medium",
          "tone": {
            "$state": "/ui/aq/rows/exp/countTone"
          }
        }
      },
      "expBadge": {
        "type": "Badge",
        "props": {
          "text": {
            "$state": "/ui/aq/rows/exp/pill"
          },
          "tone": {
            "$state": "/ui/aq/rows/exp/pillTone"
          },
          "variant": "soft"
        },
        "visible": {
          "$state": "/ui/aq/rows/exp/pill"
        }
      },
      "expChevron": {
        "type": "Icon",
        "props": {
          "name": "ChevronRight",
          "tone": "muted",
          "size": "xs"
        }
      },
      "footer": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center",
          "justify": "between"
        },
        "children": [
          "footerNote",
          "footerBtn"
        ],
        "visible": {
          "$state": "/_loading/xero-accounting.list_invoices",
          "not": true
        }
      },
      "footerNote": {
        "type": "Caption",
        "props": {
          "text": "Counts update live from Xero"
        }
      },
      "footerBtn": {
        "type": "Button",
        "props": {
          "label": "Open in Xero",
          "variant": "ghost",
          "size": "sm",
          "leadingIcon": "ExternalLink"
        },
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "url": {
                "$cond": {
                  "$state": "/ui/aq/homeUrl"
                },
                "$then": {
                  "$state": "/ui/aq/homeUrl"
                },
                "$else": "https://go.xero.com/"
              },
              "target": "_blank"
            }
          }
        }
      }
    }
  }
}
