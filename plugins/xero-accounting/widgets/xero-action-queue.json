{
  "id": "xero-action-queue",
  "title": "Action Queue",
  "description": "Everything needing attention in Xero — invoices to collect, bills to pay, unreconciled bank transactions and expense claims awaiting approval, in one scannable list. Each row deep-links to the matching Xero screen.",
  "category": "finance",
  "tags": [
    "xero",
    "invoices",
    "bills",
    "reconciliation",
    "expenses",
    "finance",
    "action"
  ],
  "keywords": [
    "action",
    "queue",
    "todo",
    "tasks",
    "reconcile",
    "invoices",
    "bills",
    "expenses",
    "attention",
    "outstanding"
  ],
  "connectorsUsed": [
    "xero-accounting"
  ],
  "sizing": {
    "preferred": {
      "colSpan": 3,
      "rowSpan": 5
    },
    "min": {
      "colSpan": 3,
      "rowSpan": 4
    },
    "max": {
      "colSpan": 6,
      "rowSpan": 8
    }
  },
  "dataProvider": {
    "mcp": "xero-accounting",
    "tool": "list_invoices",
    "params": {
      "statuses": "AUTHORISED",
      "order": "DueDate ASC"
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "children": [
          "header",
          "body"
        ],
        "watch": {
          "/xero-accounting/list_invoices": {
            "action": "xero-accounting.list_bank_transactions",
            "params": {
              "where": "Status==\"AUTHORISED\"&&IsReconciled==false",
              "order": "Date DESC"
            }
          },
          "/xero-accounting/list_bank_transactions": {
            "action": "xero-accounting.list_expense_claims",
            "params": {
              "where": "Status==\"SUBMITTED\""
            }
          }
        }
      },
      "header": {
        "type": "Header",
        "children": [
          "headStack"
        ]
      },
      "headStack": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "children": [
          "title",
          "headSub"
        ]
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "Action Queue",
          "level": "h1"
        }
      },
      "headSub": {
        "type": "Caption",
        "props": {
          "text": {
            "$cond": {
              "$state": "/xero-accounting/list_invoices/Invoices"
            },
            "$then": {
              "$computed": "fmt",
              "args": {
                "pattern": "{n} items need your attention",
                "n": {
                  "$computed": "add_number",
                  "args": {
                    "a": {
                      "$computed": "add_number",
                      "args": {
                        "a": {
                          "$computed": "count_where",
                          "args": {
                            "value": {
                              "$state": "/xero-accounting/list_invoices/Invoices"
                            },
                            "whereField": "Type",
                            "equals": "ACCREC"
                          }
                        },
                        "b": {
                          "$computed": "count_where",
                          "args": {
                            "value": {
                              "$state": "/xero-accounting/list_invoices/Invoices"
                            },
                            "whereField": "Type",
                            "equals": "ACCPAY"
                          }
                        }
                      }
                    },
                    "b": {
                      "$computed": "add_number",
                      "args": {
                        "a": {
                          "$computed": "count",
                          "args": {
                            "value": {
                              "$state": "/xero-accounting/list_bank_transactions/BankTransactions"
                            }
                          }
                        },
                        "b": {
                          "$computed": "count",
                          "args": {
                            "value": {
                              "$state": "/xero-accounting/list_expense_claims/ExpenseClaims"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            "$else": "Waiting for Xero…"
          }
        }
      },
      "body": {
        "type": "Body",
        "children": [
          "loading",
          "rows",
          "footer"
        ]
      },
      "loading": {
        "type": "Skeleton",
        "props": {
          "height": "12rem",
          "rounded": "md"
        },
        "visible": {
          "$state": "/_loading/xero-accounting.list_invoices"
        }
      },
      "rows": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "invRow",
          "billRow",
          "recRow",
          "expRow"
        ],
        "visible": {
          "$state": "/_loading/xero-accounting.list_invoices",
          "not": true
        }
      },
      "invRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center",
          "hover": true,
          "clickable": true
        },
        "children": [
          "invIcon",
          "invLabels",
          "invRight",
          "invChevron"
        ],
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "url": "https://go.xero.com/AccountsReceivable/Search.aspx?invoiceStatus=INVOICESTATUS/AUTHORISED",
              "target": "_blank"
            }
          }
        }
      },
      "invIcon": {
        "type": "Icon",
        "props": {
          "name": "FileText",
          "tone": "destructive",
          "size": "sm"
        }
      },
      "invLabels": {
        "type": "Stack",
        "props": {
          "gap": "xs",
          "grow": true
        },
        "children": [
          "invLabel",
          "invSub"
        ]
      },
      "invLabel": {
        "type": "Text",
        "props": {
          "text": "Invoices to Collect",
          "size": "sm",
          "weight": "medium"
        }
      },
      "invSub": {
        "type": "Caption",
        "props": {
          "text": {
            "$cond": {
              "$state": "/xero-accounting/list_invoices/Invoices"
            },
            "$then": {
              "$computed": "fmt",
              "args": {
                "pattern": "{n} outstanding",
                "n": {
                  "$computed": "count_where",
                  "args": {
                    "value": {
                      "$state": "/xero-accounting/list_invoices/Invoices"
                    },
                    "whereField": "Type",
                    "equals": "ACCREC"
                  }
                }
              }
            },
            "$else": "—"
          }
        }
      },
      "invRight": {
        "type": "Stack",
        "props": {
          "gap": "xs",
          "align": "end"
        },
        "children": [
          "invCount",
          "invBadge"
        ]
      },
      "invCount": {
        "type": "Text",
        "props": {
          "text": {
            "$cond": {
              "$state": "/xero-accounting/list_invoices/Invoices"
            },
            "$then": {
              "$computed": "count_where",
              "args": {
                "value": {
                  "$state": "/xero-accounting/list_invoices/Invoices"
                },
                "whereField": "Type",
                "equals": "ACCREC"
              }
            },
            "$else": "—"
          },
          "size": "lg",
          "weight": "medium",
          "tone": "destructive"
        }
      },
      "invBadge": {
        "type": "Badge",
        "props": {
          "text": "Chase Up",
          "tone": "destructive",
          "variant": "soft"
        }
      },
      "invChevron": {
        "type": "Icon",
        "props": {
          "name": "ChevronRight",
          "tone": "muted",
          "size": "xs"
        }
      },
      "billRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center",
          "hover": true,
          "clickable": true
        },
        "children": [
          "billIcon",
          "billLabels",
          "billRight",
          "billChevron"
        ],
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "url": "https://go.xero.com/AccountsPayable/Search.aspx?invoiceStatus=INVOICESTATUS/AUTHORISED",
              "target": "_blank"
            }
          }
        }
      },
      "billIcon": {
        "type": "Icon",
        "props": {
          "name": "CreditCard",
          "tone": "warning",
          "size": "sm"
        }
      },
      "billLabels": {
        "type": "Stack",
        "props": {
          "gap": "xs",
          "grow": true
        },
        "children": [
          "billLabel",
          "billSub"
        ]
      },
      "billLabel": {
        "type": "Text",
        "props": {
          "text": "Bills to Pay",
          "size": "sm",
          "weight": "medium"
        }
      },
      "billSub": {
        "type": "Caption",
        "props": {
          "text": {
            "$cond": {
              "$state": "/xero-accounting/list_invoices/Invoices"
            },
            "$then": {
              "$computed": "fmt",
              "args": {
                "pattern": "{n} outstanding",
                "n": {
                  "$computed": "count_where",
                  "args": {
                    "value": {
                      "$state": "/xero-accounting/list_invoices/Invoices"
                    },
                    "whereField": "Type",
                    "equals": "ACCPAY"
                  }
                }
              }
            },
            "$else": "—"
          }
        }
      },
      "billRight": {
        "type": "Stack",
        "props": {
          "gap": "xs",
          "align": "end"
        },
        "children": [
          "billCount",
          "billBadge"
        ]
      },
      "billCount": {
        "type": "Text",
        "props": {
          "text": {
            "$cond": {
              "$state": "/xero-accounting/list_invoices/Invoices"
            },
            "$then": {
              "$computed": "count_where",
              "args": {
                "value": {
                  "$state": "/xero-accounting/list_invoices/Invoices"
                },
                "whereField": "Type",
                "equals": "ACCPAY"
              }
            },
            "$else": "—"
          },
          "size": "lg",
          "weight": "medium",
          "tone": "warning"
        }
      },
      "billBadge": {
        "type": "Badge",
        "props": {
          "text": "Due Soon",
          "tone": "warning",
          "variant": "soft"
        }
      },
      "billChevron": {
        "type": "Icon",
        "props": {
          "name": "ChevronRight",
          "tone": "muted",
          "size": "xs"
        }
      },
      "recRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center",
          "hover": true,
          "clickable": true
        },
        "children": [
          "recIcon",
          "recLabels",
          "recRight",
          "recChevron"
        ],
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "url": "https://go.xero.com/Bank/BankAccounts.aspx",
              "target": "_blank"
            }
          }
        }
      },
      "recIcon": {
        "type": "Icon",
        "props": {
          "name": "Landmark",
          "tone": "warning",
          "size": "sm"
        }
      },
      "recLabels": {
        "type": "Stack",
        "props": {
          "gap": "xs",
          "grow": true
        },
        "children": [
          "recLabel",
          "recSub"
        ]
      },
      "recLabel": {
        "type": "Text",
        "props": {
          "text": "Reconcile Items",
          "size": "sm",
          "weight": "medium"
        }
      },
      "recSub": {
        "type": "Caption",
        "props": {
          "text": "Bank Transactions"
        }
      },
      "recRight": {
        "type": "Stack",
        "props": {
          "gap": "xs",
          "align": "end"
        },
        "children": [
          "recCount",
          "recBadge"
        ]
      },
      "recCount": {
        "type": "Text",
        "props": {
          "text": {
            "$cond": {
              "$state": "/xero-accounting/list_bank_transactions/BankTransactions"
            },
            "$then": {
              "$computed": "count",
              "args": {
                "value": {
                  "$state": "/xero-accounting/list_bank_transactions/BankTransactions"
                }
              }
            },
            "$else": "—"
          },
          "size": "lg",
          "weight": "medium",
          "tone": "warning"
        }
      },
      "recBadge": {
        "type": "Badge",
        "props": {
          "text": "To Review",
          "tone": "warning",
          "variant": "soft"
        }
      },
      "recChevron": {
        "type": "Icon",
        "props": {
          "name": "ChevronRight",
          "tone": "muted",
          "size": "xs"
        }
      },
      "expRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center",
          "hover": true,
          "clickable": true
        },
        "children": [
          "expIcon",
          "expLabels",
          "expRight",
          "expChevron"
        ],
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "url": "https://go.xero.com/ExpenseClaims/?status=SUBMITTED",
              "target": "_blank"
            }
          }
        }
      },
      "expIcon": {
        "type": "Icon",
        "props": {
          "name": "Briefcase",
          "tone": "success",
          "size": "sm"
        }
      },
      "expLabels": {
        "type": "Stack",
        "props": {
          "gap": "xs",
          "grow": true
        },
        "children": [
          "expLabel",
          "expSub"
        ]
      },
      "expLabel": {
        "type": "Text",
        "props": {
          "text": "Expense Claims",
          "size": "sm",
          "weight": "medium"
        }
      },
      "expSub": {
        "type": "Caption",
        "props": {
          "text": "Awaiting Approval"
        }
      },
      "expRight": {
        "type": "Stack",
        "props": {
          "gap": "xs",
          "align": "end"
        },
        "children": [
          "expCount",
          "expBadge"
        ]
      },
      "expCount": {
        "type": "Text",
        "props": {
          "text": {
            "$cond": {
              "$state": "/xero-accounting/list_expense_claims/ExpenseClaims"
            },
            "$then": {
              "$computed": "count",
              "args": {
                "value": {
                  "$state": "/xero-accounting/list_expense_claims/ExpenseClaims"
                }
              }
            },
            "$else": "—"
          },
          "size": "lg",
          "weight": "medium",
          "tone": "success"
        }
      },
      "expBadge": {
        "type": "Badge",
        "props": {
          "text": "All Clear",
          "tone": "success",
          "variant": "soft"
        }
      },
      "expChevron": {
        "type": "Icon",
        "props": {
          "name": "ChevronRight",
          "tone": "muted",
          "size": "xs"
        }
      },
      "footer": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center",
          "justify": "between"
        },
        "children": [
          "footerNote",
          "footerBtn"
        ],
        "visible": {
          "$state": "/_loading/xero-accounting.list_invoices",
          "not": true
        }
      },
      "footerNote": {
        "type": "Caption",
        "props": {
          "text": "Counts update live from Xero"
        }
      },
      "footerBtn": {
        "type": "Button",
        "props": {
          "label": "Open Xero",
          "variant": "ghost",
          "size": "sm",
          "leadingIcon": "ExternalLink"
        },
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "url": "https://go.xero.com/",
              "target": "_blank"
            }
          }
        }
      }
    }
  }
}
