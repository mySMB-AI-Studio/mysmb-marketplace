      "body": {
        "type": "Body",
        "children": [
          "loading",
          "rows",
          "footer"
        ],
        "watch": {
          "/xero-accounting/list_bank_transactions": {
            "action": "xero-accounting.list_accounts",
            "params": {
              "where": "Type==\"BANK\""
            }
          }
        }
      },
      "loading": {
        "type": "Skeleton",
        "props": {
          "height": "12rem",
          "rounded": "md"
        },
        "visible": {
          "$state": "/_loading/xero-accounting.list_invoices"
        }
      },
      "rows": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "invRow",
          "billRow",
          "recRow",
          "expRow"
        ],
        "visible": {
          "$state": "/_loading/xero-accounting.list_invoices",
          "not": true
        }
      },
      "invRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center",
          "hover": true,
          "clickable": true
        },
        "children": [
          "invIcon",
          "invLabels",
          "invRight",
          "invChevron"
        ],
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "url": {
                "$cond": {
                  "$state": "/ui/aq/rows/inv/url"
                },
                "$then": {
                  "$state": "/ui/aq/rows/inv/url"
                },
                "$else": "https://go.xero.com/AccountsReceivable/Search.aspx?invoiceStatus=INVOICESTATUS/AUTHORISED"
              },
              "target": "_blank"
            }
          }
        }
      },
      "invIcon": {
        "type": "Icon",
        "props": {
          "name": "FileText",
          "tone": "destructive",
          "size": "sm"
        }
      },
      "invLabels": {
        "type": "Stack",
        "props": {
          "gap": "xs",
          "grow": true
        },
        "children": [
          "invLabel",
          "invSub"
        ]
      },
      "invLabel": {
        "type": "Text",
        "props": {
          "text": "Invoices to Collect",
          "size": "sm",
          "weight": "medium"
        }
      },
      "invSub": {
        "type": "Caption",
        "props": {
          "text": {
            "$cond": {
              "$state": "/ui/aq/ready"
            },
            "$then": {
              "$state": "/ui/aq/rows/inv/sub"
            },
            "$else": "—"
          }
        }
      },
      "invRight": {
        "type": "Stack",
        "props": {
          "gap": "xs",
          "align": "end"
        },
        "children": [
          "invCount",
          "invBadge"
        ]
      },
      "invCount": {
        "type": "Text",
        "props": {
          "text": {
            "$cond": {
              "$state": "/ui/aq/ready"
            },
            "$then": {
              "$state": "/ui/aq/rows/inv/count"
            },
            "$else": "—"
          },
          "size": "lg",
          "weight": "medium",
          "tone": {
            "$state": "/ui/aq/rows/inv/countTone"
          }
        }
      },
      "invBadge": {
        "type": "Badge",
        "props": {
          "text": {
            "$state": "/ui/aq/rows/inv/pill"
          },
          "tone": {
            "$state": "/ui/aq/rows/inv/pillTone"
          },
          "variant": "soft"
        },
        "visible": {
          "$state": "/ui/aq/rows/inv/pill"
        }
      },
      "invChevron": {
        "type": "Icon",
        "props": {
          "name": "ChevronRight",
          "tone": "muted",
          "size": "xs"
        }
      },
