{
  "id": "xero-action-queue",
  "title": "Action Queue",
  "description": "Everything needing attention in one Xero organisation — invoices to collect, bills to pay, unreconciled transactions and expense claims awaiting approval, in one scannable list. Counts are for the organisation picked in the dashboard's Xero switcher, named in the header; nothing is added up across organisations. Unreconciled transactions are the bank transactions and payments entered in Xero against a bank account that are not yet matched to a bank statement line (a batch payment counts once). That is not Xero's 'Reconcile N items', which counts the bank's own statement lines and is not exposed by Xero's API. Each row, and Open in Xero, opens the matching Xero screen for the same organisation.",
  "category": "finance",
  "tags": [
    "xero",
    "invoices",
    "bills",
    "reconciliation",
    "expenses",
    "finance",
    "action"
  ],
  "keywords": [
    "action",
    "queue",
    "todo",
    "tasks",
    "reconcile",
    "invoices",
    "bills",
    "expenses",
    "attention",
    "outstanding"
  ],
  "connectorsUsed": [
    "xero-accounting"
  ],
  "sizing": {
    "preferred": {
      "colSpan": 3,
      "rowSpan": 5
    },
    "min": {
      "colSpan": 3,
      "rowSpan": 4
    },
    "max": {
      "colSpan": 6,
      "rowSpan": 8
    }
  },
  "dataProvider": {
    "mcp": "xero-accounting",
    "tool": "list_invoices",
    "params": {
      "statuses": "AUTHORISED",
      "order": "DueDate ASC"
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "children": [
          "header",
          "body"
        ],
        "watch": {
          "/xero-accounting/list_invoices": {
            "action": "xero-accounting.list_bank_transactions",
            "params": {
              "where": "Status==\"AUTHORISED\"&&IsReconciled==false",
              "order": "Date DESC"
            }
          }
        }
      },
      "header": {
        "type": "Header",
        "children": [
          "headStack"
        ],
        "watch": {
          "/xero-accounting/list_invoices": {
            "action": "xero-accounting.get_organisation",
            "params": {}
          }
        }
      },
      "headStack": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "children": [
          "title",
          "headSub"
        ],
        "watch": {
          "/xero-accounting/list_invoices": {
            "action": "xero-accounting.list_expense_claims",
            "params": {
              "where": "Status==\"SUBMITTED\""
            }
          }
        }
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "Action Queue",
          "level": "h1"
        },
        "watch": {
          "/xero-accounting/list_bank_transactions": {
            "action": "xero-accounting.list_payments",
            "params": {
              "where": "Status==\"AUTHORISED\"&&IsReconciled==false"
            }
          }
        }
      },
      "headSub": {
        "type": "Caption",
        "props": {
          "text": {
            "$cond": {
              "$state": "/ui/aq/ready"
            },
            "$then": {
              "$state": "/ui/aq/headline"
            },
            "$else": "Waiting for Xero…"
          }
        },
        "watch": {
          "/xero-accounting/list_invoices": {
            "action": "setState",
            "params": {
              "statePath": "/ui/aq",
              "value": {
                "$computed": "xero-accounting_action_queue_view",
                "args": {
                  "invoices": {
                    "$state": "/xero-accounting/list_invoices/Invoices"
                  },
                  "bankTransactions": {
                    "$state": "/xero-accounting/list_bank_transactions/BankTransactions"
                  },
                  "payments": {
                    "$state": "/xero-accounting/list_payments/Payments"
                  },
                  "bankAccounts": {
                    "$state": "/xero-accounting/list_accounts/Accounts"
                  },
                  "expenseClaims": {
                    "$state": "/xero-accounting/list_expense_claims/ExpenseClaims"
                  },
                  "organisation": {
                    "$state": "/xero-accounting/get_organisation/Organisations/0"
                  },
                  "paymentsError": {
                    "$state": "/_errors/xero-accounting.list_payments"
                  },
                  "bankAccountsError": {
                    "$state": "/_errors/xero-accounting.list_accounts"
                  }
                }
              }
            }
          },
          "/xero-accounting/list_bank_transactions": {
