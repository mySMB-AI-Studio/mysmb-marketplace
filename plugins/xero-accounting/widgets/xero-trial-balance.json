{
  "id": "xero-trial-balance",
  "title": "Trial Balance",
  "description": "Trial balance summary \u2014 all GL accounts with debit/credit totals.",
  "category": "finance",
  "tags": [
    "xero",
    "trial-balance",
    "accounts",
    "finance",
    "report"
  ],
  "keywords": [
    "trial",
    "balance",
    "trial balance",
    "gl",
    "accounts",
    "debit",
    "credit"
  ],
  "connectorsUsed": [
    "xero-accounting"
  ],
  "popularity": 0,
  "sizing": {
    "preferred": {
      "colSpan": 8,
      "rowSpan": 4
    },
    "min": {
      "colSpan": 8,
      "rowSpan": 4
    },
    "max": {
      "colSpan": 16,
      "rowSpan": 12
    }
  },
  "dataProvider": {
    "mcp": "xero-accounting",
    "tool": "get_trial_balance",
    "params": {}
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "children": [
          "header",
          "body"
        ],
        "watch": {
          "/xero-accounting/get_trial_balance/Reports": {
            "action": "setState",
            "params": {
              "statePath": "/ui/trialBalance/rows",
              "value": {
                "$computed": "xero-accounting_flatten_report_rows",
                "args": {
                  "value": {
                    "$state": "/xero-accounting/get_trial_balance/Reports/0"
                  }
                }
              }
            }
          }
        }
      },
      "header": {
        "type": "Header",
        "children": [
          "titleGroup"
        ]
      },
      "titleGroup": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "start"
        },
        "children": [
          "titleIcon",
          "titleStack"
        ]
      },
      "titleIcon": {
        "type": "Icon",
        "props": {
          "name": "Scale",
          "tone": "accent",
          "size": "sm"
        }
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "Trial Balance",
          "level": "h2"
        }
      },
      "asOf": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$state": "/xero-accounting/get_trial_balance/Reports/0/ReportDate"
          }
        }
      },
      "body": {
        "type": "Body",
        "children": [
          "loading",
          "table"
        ]
      },
      "loading": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "s1",
          "s2",
          "s3",
          "s4",
          "s5"
        ],
        "visible": {
          "$state": "/_loading/xero-accounting.get_trial_balance"
        }
      },
      "s1": {
        "type": "Skeleton",
        "props": {
          "height": "2rem",
          "rounded": "md"
        }
      },
      "s2": {
        "type": "Skeleton",
        "props": {
          "height": "2rem",
          "rounded": "md"
        }
      },
      "s3": {
        "type": "Skeleton",
        "props": {
          "height": "2rem",
          "rounded": "md"
        }
      },
      "s4": {
        "type": "Skeleton",
        "props": {
          "height": "2rem",
          "rounded": "md"
        }
      },
      "s5": {
        "type": "Skeleton",
        "props": {
          "height": "2rem",
          "rounded": "md"
        }
      },
      "table": {
        "type": "Table",
        "props": {
          "rows": {
            "$state": "/ui/trialBalance/rows"
          },
          "columns": [
            {
              "id": "account",
              "header": "Account",
              "field": "c0",
              "priority": 1
            },
            {
              "id": "debit",
              "header": "Debit",
              "field": "c1",
              "align": "right",
              "format": "currency",
              "priority": 1
            },
            {
              "id": "credit",
              "header": "Credit",
              "field": "c2",
              "align": "right",
              "format": "currency",
              "priority": 1
            },
            {
              "id": "ytdDebit",
              "header": "YTD Debit",
              "field": "c3",
              "align": "right",
              "format": "currency",
              "priority": 3
            },
            {
              "id": "ytdCredit",
              "header": "YTD Credit",
              "field": "c4",
              "align": "right",
              "format": "currency",
              "priority": 3
            }
          ]
        },
        "visible": {
          "$state": "/_loading/xero-accounting.get_trial_balance",
          "not": true
        }
      },
      "titleStack": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "children": [
          "title",
          "asOf"
        ]
      }
    }
  },
  "status": "draft"
}
