{
  "category": "finance",
  "connectorsUsed": [
    "xero-accounting"
  ],
  "dataProvider": {
    "kind": "tool",
    "mcp": "xero-accounting",
    "params": {
      "order": "DueDate ASC",
      "statuses": "AUTHORISED",
      "where": "Type==\"ACCREC\""
    },
    "tool": "list_invoices"
  },
  "description": "Overdue invoices ranked for collections follow-up.",
  "id": "xero-overdue-chase-list",
  "keywords": [
    "overdue",
    "late",
    "collections",
    "chase",
    "follow-up",
    "invoice",
    "invoices",
    "dunning"
  ],
  "popularity": 76,
  "sizing": {
    "max": {
      "colSpan": 12,
      "rowSpan": 12
    },
    "min": {
      "colSpan": 4,
      "rowSpan": 4
    },
    "preferred": {
      "colSpan": 4,
      "rowSpan": 4
    }
  },
  "spec": {
    "elements": {
      "amount": {
        "props": {
          "size": "sm",
          "text": {
            "$computed": "format_currency",
            "args": {
              "currency": {
                "$item": "CurrencyCode"
              },
              "value": {
                "$item": "AmountDue"
              }
            }
          },
          "weight": "semibold"
        },
        "type": "Text"
      },
      "body": {
        "children": [
          "loading",
          "empty",
          "list"
        ],
        "type": "Body"
      },
      "card": {
        "children": [
          "header",
          "body"
        ],
        "type": "Card",
        "watch": {
          "/xero-accounting/list_invoices/Invoices": {
            "action": "setState",
            "params": {
              "statePath": "/ui/overdue/rows",
              "value": {
                "$computed": "xero-accounting_overdue_only",
                "args": {
                  "value": {
                    "$state": "/xero-accounting/list_invoices/Invoices"
                  }
                }
              }
            }
          }
        }
      },
      "count": {
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "n": {
                "$computed": "count",
                "args": {
                  "value": {
                    "$state": "/ui/overdue/rows"
                  }
                }
              },
              "pattern": "{n} Overdue"
            }
          }
        },
        "type": "Eyebrow"
      },
      "empty": {
        "props": {
          "message": "Nothing overdue — nice work."
        },
        "type": "Empty",
        "visible": {
          "$and": [
            {
              "$state": "/_loading/xero-accounting.list_invoices",
              "not": true
            },
            {
              "$state": "/ui/overdue/rows/0",
              "not": true
            }
          ]
        }
      },
      "header": {
        "children": [
          "titleGroup"
        ],
        "type": "Header"
      },
      "idBottom": {
        "props": {
          "text": {
            "$item": "InvoiceNumber"
          }
        },
        "type": "Caption"
      },
      "idTop": {
        "props": {
          "size": "sm",
          "text": {
            "$item": "Contact/Name"
          },
          "truncate": true,
          "weight": "medium"
        },
        "type": "Text"
      },
      "identity": {
        "children": [
          "idTop",
          "idBottom"
        ],
        "props": {
          "gap": "xs"
        },
        "type": "Stack"
      },
      "list": {
        "children": [
          "row"
        ],
        "props": {
          "gap": "xs"
        },
        "repeat": {
          "key": "InvoiceID",
          "statePath": "/ui/overdue/rows"
        },
        "type": "Stack",
        "visible": {
          "$state": "/_loading/xero-accounting.list_invoices",
          "not": true
        }
      },
      "loading": {
        "children": [
          "sk1",
          "sk2",
          "sk3",
          "sk4"
        ],
        "props": {
          "gap": "sm"
        },
        "type": "Stack",
        "visible": {
          "$state": "/_loading/xero-accounting.list_invoices"
        }
      },
      "overdueBadge": {
        "props": {
          "text": {
            "$computed": "xero-accounting_overdue_label",
            "args": {
              "value": {
                "$item": "DueDate"
              }
            }
          },
          "tone": {
            "$computed": "xero-accounting_overdue_tone",
            "args": {
              "value": {
                "$item": "DueDate"
              }
            }
          },
          "variant": "soft"
        },
        "type": "Badge"
      },
      "row": {
        "children": [
          "severity",
          "identity",
          "amount",
          "overdueBadge"
        ],
        "on": {
          "click": {
            "action": "open_invoice_modal",
            "params": {
              "invoiceId": {
                "$computed": "identity",
                "args": {
                  "value": {
                    "$item": "InvoiceID"
                  }
                }
              }
            }
          }
        },
        "props": {
          "align": "center",
          "clickable": true,
          "gap": "sm",
          "hover": true,
          "template": "auto minmax(0, 1fr) 6rem 7rem"
        },
        "type": "Row"
      },
      "severity": {
        "props": {
          "size": "sm",
          "tone": {
            "$computed": "xero-accounting_overdue_tone",
            "args": {
              "value": {
                "$item": "DueDate"
              }
            }
          }
        },
        "type": "Dot"
      },
      "sk1": {
        "props": {
          "height": "2.25rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "sk2": {
        "props": {
          "height": "2.25rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "sk3": {
        "props": {
          "height": "2.25rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "sk4": {
        "props": {
          "height": "2.25rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "title": {
        "props": {
          "level": "h2",
          "text": "Overdue Chase List"
        },
        "type": "Heading"
      },
      "titleGroup": {
        "children": [
          "titleIcon",
          "titleStack"
        ],
        "props": {
          "align": "start",
          "gap": "sm"
        },
        "type": "Row"
      },
      "titleIcon": {
        "props": {
          "name": "AlarmClock",
          "size": "sm",
          "tone": "destructive"
        },
        "type": "Icon"
      },
      "titleStack": {
        "children": [
          "title",
          "count"
        ],
        "props": {
          "gap": "none"
        },
        "type": "Stack"
      }
    },
    "root": "card"
  },
  "tags": [
    "xero",
    "invoices",
    "overdue",
    "collections",
    "chase",
    "finance"
  ],
  "title": "Overdue Chase List"
}
