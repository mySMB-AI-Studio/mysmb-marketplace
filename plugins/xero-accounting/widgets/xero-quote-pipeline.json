{
  "id": "xero-quote-pipeline",
  "title": "Quote Pipeline",
  "description": "Quotes pipeline grouped by status — draft, sent, accepted.",
  "category": "sales",
  "tags": [
    "xero",
    "quotes",
    "pipeline",
    "sales",
    "crm"
  ],
  "keywords": [
    "quote",
    "quotes",
    "estimate",
    "estimates",
    "pipeline",
    "sales",
    "proposal"
  ],
  "connectorsUsed": [
    "xero-accounting"
  ],
  "popularity": 0,
  "sizing": {
    "preferred": {
      "colSpan": 6,
      "rowSpan": 2
    },
    "min": {
      "colSpan": 6,
      "rowSpan": 2
    },
    "max": {
      "colSpan": 14,
      "rowSpan": 12
    }
  },
  "dataProvider": {
    "mcp": "xero-accounting",
    "tool": "list_quotes",
    "params": {
      "order": "UpdatedDateUTC DESC"
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "children": [
          "header",
          "body"
        ]
      },
      "header": {
        "type": "Header",
        "children": [
          "titleGroup",
          "count"
        ]
      },
      "titleGroup": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center"
        },
        "children": [
          "titleIcon",
          "title"
        ]
      },
      "titleIcon": {
        "type": "Icon",
        "props": {
          "name": "GitBranch",
          "tone": "accent",
          "size": "sm"
        }
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "Quote pipeline",
          "level": "h2"
        }
      },
      "count": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{n} quotes",
              "n": {
                "$computed": "count",
                "args": {
                  "value": {
                    "$state": "/xero-accounting/list_quotes/Quotes"
                  }
                }
              }
            }
          }
        }
      },
      "body": {
        "type": "Body",
        "children": [
          "loading",
          "empty",
          "grid"
        ]
      },
      "loading": {
        "type": "Grid",
        "props": {
          "cols": 4,
          "gap": "sm"
        },
        "children": [
          "skCol1",
          "skCol2",
          "skCol3",
          "skCol4"
        ],
        "visible": {
          "$state": "/_loading/xero-accounting.list_quotes"
        }
      },
      "skCol1": {
        "type": "Skeleton",
        "props": {
          "height": "6rem",
          "rounded": "md"
        }
      },
      "skCol2": {
        "type": "Skeleton",
        "props": {
          "height": "6rem",
          "rounded": "md"
        }
      },
      "skCol3": {
        "type": "Skeleton",
        "props": {
          "height": "6rem",
          "rounded": "md"
        }
      },
      "skCol4": {
        "type": "Skeleton",
        "props": {
          "height": "6rem",
          "rounded": "md"
        }
      },
      "empty": {
        "type": "Empty",
        "props": {
          "message": "No quotes yet. Create one from Xero."
        },
        "visible": {
          "$and": [
            {
              "$state": "/_loading/xero-accounting.list_quotes",
              "not": true
            },
            {
              "$state": "/xero-accounting/list_quotes/Quotes/0",
              "not": true
            }
          ]
        }
      },
      "grid": {
        "type": "Grid",
        "props": {
          "cols": 4,
          "gap": "sm"
        },
        "children": [
          "draftCol",
          "sentCol",
          "acceptedCol",
          "invoicedCol"
        ],
        "visible": {
          "$state": "/_loading/xero-accounting.list_quotes",
          "not": true
        }
      },
      "draftCol": {
        "type": "Section",
        "props": {
          "variant": "muted"
        },
        "children": [
          "draftHeader",
          "draftList"
        ]
      },
      "draftHeader": {
        "type": "Heading",
        "props": {
          "text": "Draft",
          "level": "h3"
        }
      },
      "draftList": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "children": [
          "draftRepeat"
        ]
      },
      "draftRepeat": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "children": [
          "draftCard"
        ],
        "repeat": {
          "statePath": "/xero-accounting/list_quotes/Quotes",
          "key": "QuoteID"
        }
      },
      "draftCard": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "children": [
          "draftTop",
          "draftBottom"
        ],
        "visible": {
          "$item": "Status",
          "eq": "DRAFT"
        }
      },
      "draftTop": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "Contact/Name"
          },
          "size": "xs",
          "weight": "medium",
          "truncate": true
        }
      },
      "draftBottom": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "format_currency",
            "args": {
              "value": {
                "$item": "Total"
              },
              "currency": {
                "$item": "CurrencyCode"
              }
            }
          }
        }
      },
      "sentCol": {
        "type": "Section",
        "props": {
          "variant": "bordered"
        },
        "children": [
          "sentHeader",
          "sentRepeat"
        ]
      },
      "sentHeader": {
        "type": "Heading",
        "props": {
          "text": "Sent",
          "level": "h3"
        }
      },
      "sentRepeat": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "children": [
          "sentCard"
        ],
        "repeat": {
          "statePath": "/xero-accounting/list_quotes/Quotes",
          "key": "QuoteID"
        }
      },
      "sentCard": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "children": [
          "sentTop",
          "sentBottom"
        ],
        "visible": {
          "$item": "Status",
          "eq": "SENT"
        }
      },
      "sentTop": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "Contact/Name"
          },
          "size": "xs",
          "weight": "medium",
          "truncate": true
        }
      },
      "sentBottom": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "format_currency",
            "args": {
              "value": {
                "$item": "Total"
              },
              "currency": {
                "$item": "CurrencyCode"
              }
            }
          }
        }
      },
      "acceptedCol": {
        "type": "Section",
        "props": {
          "variant": "bordered"
        },
        "children": [
          "acceptedHeader",
          "acceptedRepeat"
        ]
      },
      "acceptedHeader": {
        "type": "Heading",
        "props": {
          "text": "Accepted",
          "level": "h3"
        }
      },
      "acceptedRepeat": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "children": [
          "acceptedCard"
        ],
        "repeat": {
          "statePath": "/xero-accounting/list_quotes/Quotes",
          "key": "QuoteID"
        }
      },
      "acceptedCard": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "children": [
          "acceptedTop",
          "acceptedBottom"
        ],
        "visible": {
          "$item": "Status",
          "eq": "ACCEPTED"
        }
      },
      "acceptedTop": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "Contact/Name"
          },
          "size": "xs",
          "weight": "medium",
          "truncate": true
        }
      },
      "acceptedBottom": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "format_currency",
            "args": {
              "value": {
                "$item": "Total"
              },
              "currency": {
                "$item": "CurrencyCode"
              }
            }
          }
        }
      },
      "invoicedCol": {
        "type": "Section",
        "props": {
          "variant": "bordered"
        },
        "children": [
          "invoicedHeader",
          "invoicedRepeat"
        ]
      },
      "invoicedHeader": {
        "type": "Heading",
        "props": {
          "text": "Invoiced",
          "level": "h3"
        }
      },
      "invoicedRepeat": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "children": [
          "invoicedCard"
        ],
        "repeat": {
          "statePath": "/xero-accounting/list_quotes/Quotes",
          "key": "QuoteID"
        }
      },
      "invoicedCard": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "children": [
          "invoicedTop",
          "invoicedBottom"
        ],
        "visible": {
          "$item": "Status",
          "eq": "INVOICED"
        }
      },
      "invoicedTop": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "Contact/Name"
          },
          "size": "xs",
          "weight": "medium",
          "truncate": true
        }
      },
      "invoicedBottom": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "format_currency",
            "args": {
              "value": {
                "$item": "Total"
              },
              "currency": {
                "$item": "CurrencyCode"
              }
            }
          }
        }
      }
    }
  },
  "status": "draft"
}
