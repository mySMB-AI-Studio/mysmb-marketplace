{
  "id": "xero-expense-claims",
  "title": "Expense Claims",
  "description": "Expense claims awaiting approval — submitted by staff, ready for review.",
  "category": "finance",
  "tags": [
    "xero",
    "expenses",
    "claims",
    "approval",
    "finance"
  ],
  "keywords": [
    "expense",
    "expenses",
    "claim",
    "claims",
    "reimbursement",
    "approval"
  ],
  "connectorsUsed": [
    "xero-accounting"
  ],
  "popularity": 0,
  "sizing": {
    "preferred": {
      "colSpan": 3,
      "rowSpan": 3
    },
    "min": {
      "colSpan": 3,
      "rowSpan": 3
    },
    "max": {
      "colSpan": 12,
      "rowSpan": 10
    }
  },
  "dataProvider": {
    "mcp": "xero-accounting",
    "tool": "list_expense_claims",
    "params": {}
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "children": [
          "header",
          "body"
        ]
      },
      "header": {
        "type": "Header",
        "children": [
          "titleGroup",
          "count"
        ]
      },
      "titleGroup": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center"
        },
        "children": [
          "titleIcon",
          "title"
        ]
      },
      "titleIcon": {
        "type": "Icon",
        "props": {
          "name": "ReceiptText",
          "tone": "warning",
          "size": "sm"
        }
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "Expense claims",
          "level": "h2"
        }
      },
      "count": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{n} open",
              "n": {
                "$computed": "count",
                "args": {
                  "value": {
                    "$state": "/xero-accounting/list_expense_claims/ExpenseClaims"
                  }
                }
              }
            }
          }
        }
      },
      "body": {
        "type": "Body",
        "children": [
          "loading",
          "empty",
          "list"
        ]
      },
      "loading": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "s1",
          "s2",
          "s3"
        ],
        "visible": {
          "$state": "/_loading/xero-accounting.list_expense_claims"
        }
      },
      "s1": {
        "type": "Skeleton",
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        }
      },
      "s2": {
        "type": "Skeleton",
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        }
      },
      "s3": {
        "type": "Skeleton",
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        }
      },
      "empty": {
        "type": "Empty",
        "props": {
          "message": "No expense claims awaiting approval."
        },
        "visible": {
          "$and": [
            {
              "$state": "/_loading/xero-accounting.list_expense_claims",
              "not": true
            },
            {
              "$state": "/xero-accounting/list_expense_claims/ExpenseClaims/0",
              "not": true
            }
          ]
        }
      },
      "list": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "children": [
          "row"
        ],
        "repeat": {
          "statePath": "/xero-accounting/list_expense_claims/ExpenseClaims",
          "key": "ExpenseClaimID"
        },
        "visible": {
          "$state": "/_loading/xero-accounting.list_expense_claims",
          "not": true
        }
      },
      "row": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center",
          "hover": true
        },
        "children": [
          "icon",
          "labels",
          "statusBadge",
          "amount"
        ]
      },
      "icon": {
        "type": "Icon",
        "props": {
          "name": "Wallet",
          "tone": "muted",
          "size": "sm"
        }
      },
      "labels": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "children": [
          "labelTop",
          "labelBottom"
        ]
      },
      "labelTop": {
        "type": "Text",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{user}",
              "user": {
                "$item": "User/FullName"
              }
            }
          },
          "size": "md",
          "weight": "medium",
          "truncate": true
        }
      },
      "labelBottom": {
        "type": "Text",
        "props": {
          "size": "sm",
          "tone": "muted",
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "Submitted {when}",
              "when": {
                "$computed": "relative_time",
                "args": {
                  "value": {
                    "$item": "UpdatedDateUTC"
                  }
                }
              }
            }
          }
        }
      },
      "statusBadge": {
        "type": "Badge",
        "props": {
          "text": {
            "$item": "Status"
          },
          "tone": {
            "$computed": "xero-accounting_status_tone",
            "args": {
              "value": {
                "$item": "Status"
              }
            }
          },
          "variant": "soft"
        }
      },
      "amount": {
        "type": "Text",
        "props": {
          "text": {
            "$computed": "format_currency",
            "args": {
              "value": {
                "$item": "Total"
              }
            }
          },
          "weight": "semibold",
          "size": "sm"
        }
      }
    }
  },
  "status": "draft"
}
