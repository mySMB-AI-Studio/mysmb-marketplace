{
  "category": "finance",
  "connectorsUsed": [
    "xero-accounting"
  ],
  "dataProvider": {
    "kind": "tool",
    "mcp": "xero-accounting",
    "params": {},
    "tool": "get_xero_bank_balance_difference"
  },
  "description": "Each Xero bank account's balance on the previous business day (Friday on a Monday) next to today's, the difference (green when up, red when down), and the transactions behind it with account code, contact and amount. Click a column heading to sort; switch accounts with the tabs.",
  "id": "xero-bank-balance-difference",
  "keywords": [
    "bank",
    "cash",
    "balance",
    "difference",
    "change",
    "movement",
    "yesterday",
    "previous day",
    "daily",
    "transactions",
    "accounts",
    "account code",
    "sort",
    "reconcile"
  ],
  "pluginIcon": "data:image/png;base64,",
  "popularity": 0,
  "sizing": {
    "max": {
      "colSpan": 12,
      "rowSpan": 16
    },
    "min": {
      "colSpan": 5,
      "rowSpan": 8
    },
    "preferred": {
      "colSpan": 6,
      "rowSpan": 11
    }
  },
  "spec": {
    "elements": {
      "balances": {
        "children": [
          "prevBox",
          "todayBox"
        ],
        "props": {
          "cols": 2,
          "gap": "sm"
        },
        "type": "Grid"
      },
      "body": {
        "children": [
          "loading",
          "empty",
          "content"
        ],
        "type": "Body"
      },
      "cAmount": {
        "props": {
          "text": {
            "$item": "amountDisplay"
          },
          "tone": {
            "$item": "amountTone"
          },
          "weight": "medium"
        },
        "type": "Text"
      },
      "cCode": {
        "children": [
          "cCodeText",
          "cCodeName"
        ],
        "props": {
          "gap": "none"
        },
        "type": "Stack"
      },
      "cCodeName": {
        "props": {
          "text": {
            "$item": "accountName"
          }
        },
        "type": "Caption"
      },
      "cCodeText": {
        "props": {
          "text": {
            "$item": "accountCode"
          },
          "weight": "medium"
        },
        "type": "Text"
      },
      "cContact": {
        "children": [
          "cContactText",
          "cDetail"
        ],
        "props": {
          "gap": "none"
        },
        "type": "Stack"
      },
      "cContactText": {
        "props": {
          "text": {
            "$item": "contact"
          },
          "truncate": true
        },
        "type": "Text"
      },
      "cDetail": {
        "props": {
          "text": {
            "$item": "detail"
          }
        },
        "type": "Caption"
      },
      "card": {
        "children": [
          "header",
          "body"
        ],
        "type": "Card",
        "watch": {
          "/ui/bbd/selectedId": {
            "action": "setState",
            "params": {
              "statePath": "/ui/bbd/view",
              "value": {
                "$computed": "filter_by",
                "args": {
                  "equals": {
                    "$state": "/ui/bbd/selectedId"
                  },
                  "field": "accountId",
                  "value": {
                    "$state": "/xero-accounting/get_xero_bank_balance_difference/accounts"
                  }
                }
              }
            }
          },
          "/ui/bbd/sortDir": {
            "action": "setState",
            "params": {
              "statePath": "/ui/bbd/rows",
              "value": {
                "$computed": "sort_by_priority",
                "args": {
                  "by": [
                    {
                      "direction": {
                        "$state": "/ui/bbd/sortDir"
                      },
                      "field": {
                        "$state": "/ui/bbd/sortField"
                      }
                    },
                    {
                      "field": "contact"
                    },
                    {
                      "field": "amount"
                    }
                  ],
                  "value": {
                    "$state": "/ui/bbd/view/0/transactions"
                  }
                }
              }
            }
          },
          "/ui/bbd/sortField": {
            "action": "setState",
            "params": {
              "statePath": "/ui/bbd/rows",
              "value": {
                "$computed": "sort_by_priority",
                "args": {
                  "by": [
                    {
                      "direction": {
                        "$state": "/ui/bbd/sortDir"
                      },
                      "field": {
                        "$state": "/ui/bbd/sortField"
                      }
                    },
                    {
                      "field": "contact"
                    },
                    {
                      "field": "amount"
                    }
                  ],
                  "value": {
                    "$state": "/ui/bbd/view/0/transactions"
                  }
                }
              }
            }
          },
          "/ui/bbd/view": {
            "action": "setState",
            "params": {
              "statePath": "/ui/bbd/rows",
              "value": {
                "$computed": "sort_by_priority",
                "args": {
                  "by": [
                    {
                      "direction": {
                        "$state": "/ui/bbd/sortDir"
                      },
                      "field": {
                        "$state": "/ui/bbd/sortField"
                      }
                    },
                    {
                      "field": "contact"
                    },
                    {
                      "field": "amount"
                    }
                  ],
                  "value": {
                    "$state": "/ui/bbd/view/0/transactions"
                  }
                }
              }
            }
          },
          "/xero-accounting/get_xero_bank_balance_difference/accounts": {
            "action": "setState",
            "params": {
              "statePath": "/ui/bbd/view",
              "value": {
                "$computed": "filter_by",
                "args": {
                  "equals": {
                    "$state": "/ui/bbd/selectedId"
                  },
                  "field": "accountId",
                  "value": {
                    "$state": "/xero-accounting/get_xero_bank_balance_difference/accounts"
                  }
                }
              }
            }
          },
          "/xero-accounting/get_xero_bank_balance_difference/defaultAccountId": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/bbd/selectedId",
                "value": {
                  "$state": "/xero-accounting/get_xero_bank_balance_difference/defaultAccountId"
                }
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/bbd/sortField",
                "value": "contact"
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/bbd/sortDir",
                "value": "asc"
              }
            }
          ]
        }
      },
      "check": {
        "children": [
          "checkIcon",
          "checkText"
        ],
        "props": {
          "align": "center",
          "gap": "xs"
        },
        "type": "Row",
        "visible": {
          "$state": "/ui/bbd/view/0/transactions/0"
        }
      },
      "checkIcon": {
        "props": {
          "name": "CircleCheck",
          "size": "sm",
          "tone": "success"
        },
        "type": "Icon"
      },
      "checkText": {
        "props": {
          "text": {
            "$state": "/ui/bbd/view/0/checkText"
          },
          "tone": "success"
        },
        "type": "Caption"
      },
      "colHeads": {
        "children": [
          "hCode",
          "hContact",
          "hAmount"
        ],
        "props": {
          "align": "center",
          "gap": "sm",
          "template": "7.5rem 1fr auto"
        },
        "type": "Row"
      },
      "content": {
        "children": [
          "tabs",
          "balances",
          "difference",
          "why",
          "divider2",
          "footer"
        ],
        "props": {
          "gap": "md"
        },
        "type": "Stack",
        "visible": {
          "$and": [
            {
              "$state": "/_loading/xero-accounting.get_xero_bank_balance_difference",
              "not": true
            },
            {
              "$state": "/xero-accounting/get_xero_bank_balance_difference/accounts/0"
            }
          ]
        }
      },
      "diffIcon": {
        "props": {
          "size": "sm",
          "text": {
            "$cond": {
              "$state": "/ui/bbd/view/0/direction",
              "eq": "up"
            },
            "$else": {
              "$cond": {
                "$state": "/ui/bbd/view/0/direction",
                "eq": "down"
              },
              "$else": "–",
              "$then": "▼"
            },
            "$then": "▲"
          },
          "tone": {
            "$state": "/ui/bbd/view/0/tone"
          },
          "weight": "medium"
        },
        "type": "Text"
      },
      "diffLabel": {
        "props": {
          "text": "DIFFERENCE",
          "tone": {
            "$state": "/ui/bbd/view/0/tone"
          },
          "variant": "soft"
        },
        "type": "Badge"
      },
      "diffRow": {
        "children": [
          "diffIcon",
          "diffValue"
        ],
        "props": {
          "align": "center",
          "gap": "sm",
          "justify": "center"
        },
        "type": "Row"
      },
      "diffStack": {
        "children": [
          "diffLabel",
          "diffRow"
        ],
        "props": {
          "align": "center",
          "gap": "xs"
        },
        "type": "Stack"
      },
      "diffValue": {
        "props": {
          "value": {
            "$state": "/ui/bbd/view/0/differenceText"
          }
        },
        "type": "Stat"
      },
      "difference": {
        "children": [
          "diffStack"
        ],
        "props": {
          "variant": "muted"
        },
        "type": "Section"
      },
      "divider0": {
        "type": "Divider"
      },
      "divider1": {
        "type": "Divider"
      },
      "divider2": {
        "type": "Divider"
      },
      "empty": {
        "props": {
          "message": "No bank accounts configured in Xero."
        },
        "type": "Empty",
        "visible": {
          "$and": [
            {
              "$state": "/_loading/xero-accounting.get_xero_bank_balance_difference",
              "not": true
            },
            {
              "$state": "/xero-accounting/get_xero_bank_balance_difference/accounts/0",
              "not": true
            }
          ]
        }
      },
      "footer": {
        "children": [
          "footerText",
          "footerOpen"
        ],
        "props": {
          "align": "center",
          "gap": "sm",
          "justify": "between"
        },
        "type": "Row"
      },
      "footerOpen": {
        "children": [
          "footerOpenText",
          "footerOpenIcon"
        ],
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "target": "_blank",
              "url": {
                "$state": "/xero-accounting/get_xero_bank_balance_difference/summary/xeroUrl"
              }
            }
          }
        },
        "props": {
          "align": "center",
          "clickable": true,
          "gap": "xs",
          "hover": true
        },
        "type": "Row"
      },
      "footerOpenIcon": {
        "props": {
          "name": "ArrowRight",
          "size": "sm"
        },
        "type": "Icon"
      },
      "footerOpenText": {
        "props": {
          "text": "Open in Xero",
          "weight": "medium"
        },
        "type": "Text"
      },
      "footerText": {
        "props": {
          "text": {
            "$state": "/xero-accounting/get_xero_bank_balance_difference/summary/updatedText"
          }
        },
        "type": "Caption"
      },
      "hAmount": {
        "children": [
          "hAmountText"
        ],
        "on": {
          "click": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/bbd/sortDir",
                "value": {
                  "$cond": {
                    "$state": "/ui/bbd/sortField",
                    "eq": "amount"
                  },
                  "$else": "asc",
                  "$then": {
                    "$cond": {
                      "$state": "/ui/bbd/sortDir",
                      "eq": "asc"
                    },
                    "$else": "asc",
                    "$then": "desc"
                  }
                }
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/bbd/sortField",
                "value": "amount"
              }
            }
          ]
        },
        "props": {
          "align": "center",
          "clickable": true,
          "gap": "xs",
          "hover": true,
          "justify": "end"
        },
        "type": "Row"
      },
      "hAmountText": {
        "props": {
          "size": "xs",
          "text": {
            "$cond": {
              "$state": "/ui/bbd/sortField",
              "eq": "amount"
            },
            "$else": "AMOUNT ↕",
            "$then": {
              "$cond": {
                "$state": "/ui/bbd/sortDir",
                "eq": "desc"
              },
              "$else": "AMOUNT ↑ LOW–HIGH",
              "$then": "AMOUNT ↓ HIGH–LOW"
            }
          },
          "tone": {
            "$cond": {
              "$state": "/ui/bbd/sortField",
              "eq": "amount"
            },
            "$else": "muted",
            "$then": "default"
          },
          "weight": "medium"
        },
        "type": "Text"
      },
      "hCode": {
        "children": [
          "hCodeText"
        ],
        "on": {
          "click": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/bbd/sortDir",
                "value": {
                  "$cond": {
                    "$state": "/ui/bbd/sortField",
                    "eq": "accountCode"
                  },
                  "$else": "asc",
                  "$then": {
                    "$cond": {
                      "$state": "/ui/bbd/sortDir",
                      "eq": "asc"
                    },
                    "$else": "asc",
                    "$then": "desc"
                  }
                }
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/bbd/sortField",
                "value": "accountCode"
              }
            }
          ]
        },
        "props": {
          "align": "center",
          "clickable": true,
          "gap": "xs",
          "hover": true
        },
        "type": "Row"
      },
      "hCodeText": {
        "props": {
          "size": "xs",
          "text": {
            "$cond": {
              "$state": "/ui/bbd/sortField",
              "eq": "accountCode"
            },
            "$else": "ACC CODE ↕",
            "$then": {
              "$cond": {
                "$state": "/ui/bbd/sortDir",
                "eq": "desc"
              },
              "$else": "ACC CODE ↑ A–Z",
              "$then": "ACC CODE ↓ Z–A"
            }
          },
          "tone": {
            "$cond": {
              "$state": "/ui/bbd/sortField",
              "eq": "accountCode"
            },
            "$else": "muted",
            "$then": "default"
          },
          "weight": "medium"
        },
        "type": "Text"
      },
      "hContact": {
        "children": [
          "hContactText"
        ],
        "on": {
          "click": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/bbd/sortDir",
                "value": {
                  "$cond": {
                    "$state": "/ui/bbd/sortField",
                    "eq": "contact"
                  },
                  "$else": "asc",
                  "$then": {
                    "$cond": {
                      "$state": "/ui/bbd/sortDir",
                      "eq": "asc"
                    },
                    "$else": "asc",
                    "$then": "desc"
                  }
                }
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/bbd/sortField",
                "value": "contact"
              }
            }
          ]
        },
        "props": {
          "align": "center",
          "clickable": true,
          "gap": "xs",
          "hover": true
        },
        "type": "Row"
      },
      "hContactText": {
        "props": {
          "size": "xs",
          "text": {
            "$cond": {
              "$state": "/ui/bbd/sortField",
              "eq": "contact"
            },
            "$else": "CONTACT ↕",
            "$then": {
              "$cond": {
                "$state": "/ui/bbd/sortDir",
                "eq": "desc"
              },
              "$else": "CONTACT ↑ A–Z",
              "$then": "CONTACT ↓ Z–A"
            }
          },
          "tone": {
            "$cond": {
              "$state": "/ui/bbd/sortField",
              "eq": "contact"
            },
            "$else": "muted",
            "$then": "default"
          },
          "weight": "medium"
        },
        "type": "Text"
      },
      "header": {
        "children": [
          "titleGroup"
        ],
        "type": "Header"
      },
      "loading": {
        "children": [
          "sTabs",
          "sBalances",
          "sList"
        ],
        "props": {
          "gap": "md"
        },
        "type": "Stack",
        "visible": {
          "$state": "/_loading/xero-accounting.get_xero_bank_balance_difference"
        }
      },
      "prevBox": {
        "children": [
          "prevStack"
        ],
        "props": {
          "variant": "muted"
        },
        "type": "Section"
      },
      "prevDate": {
        "props": {
          "text": {
            "$state": "/ui/bbd/view/0/previousDayText"
          }
        },
        "type": "Caption"
      },
      "prevPill": {
        "props": {
          "text": "PREV BUSINESS DAY",
          "tone": "warning",
          "variant": "soft"
        },
        "type": "Badge"
      },
      "prevStack": {
        "children": [
          "prevPill",
          "prevValue",
          "prevDate"
        ],
        "props": {
          "align": "center",
          "gap": "xs"
        },
        "type": "Stack"
      },
      "prevValue": {
        "props": {
          "size": "sm",
          "value": {
            "$state": "/ui/bbd/view/0/previousBalanceText"
          }
        },
        "type": "Stat"
      },
      "s1": {
        "props": {
          "height": "5rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "s2": {
        "props": {
          "height": "5rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "sBalances": {
        "children": [
          "s1",
          "s2"
        ],
        "props": {
          "cols": 2,
          "gap": "md"
        },
        "type": "Grid"
      },
      "sList": {
        "props": {
          "height": "10rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "sTabs": {
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "subtitle": {
        "props": {
          "text": {
            "$state": "/xero-accounting/get_xero_bank_balance_difference/summary/subtitle"
          }
        },
        "type": "Caption",
        "visible": {
          "$state": "/_loading/xero-accounting.get_xero_bank_balance_difference",
          "not": true
        }
      },
      "tab": {
        "children": [
          "tabBox"
        ],
        "on": {
          "click": {
            "action": "setState",
            "params": {
              "statePath": "/ui/bbd/selectedId",
              "value": {
                "$computed": "identity",
                "args": {
                  "value": {
                    "$item": "accountId"
                  }
                }
              }
            }
          }
        },
        "props": {
          "clickable": true,
          "hover": true,
          "selected": {
            "$computed": "equals",
            "args": {
              "a": {
                "$item": "accountId"
              },
              "b": {
                "$state": "/ui/bbd/selectedId"
              }
            }
          },
          "template": "1fr"
        },
        "type": "Row"
      },
      "tabBadge": {
        "props": {
          "text": {
            "$item": "badgeText"
          },
          "tone": {
            "$item": "tone"
          },
          "variant": "soft"
        },
        "type": "Badge"
      },
      "tabBox": {
        "children": [
          "tabRow",
          "tabLine"
        ],
        "props": {
          "variant": "bordered"
        },
        "type": "Section"
      },
      "tabLine": {
        "props": {
          "tone": "info",
          "value": 100
        },
        "type": "ProgressBar",
        "visible": {
          "$item": "accountId",
          "eq": {
            "$state": "/ui/bbd/selectedId"
          }
        }
      },
      "tabName": {
        "props": {
          "text": {
            "$item": "name"
          },
          "tone": {
            "$cond": {
              "$item": "accountId",
              "eq": {
                "$state": "/ui/bbd/selectedId"
              }
            },
            "$else": "muted",
            "$then": "default"
          },
          "truncate": true,
          "weight": "medium"
        },
        "type": "Text"
      },
      "tabRow": {
        "children": [
          "tabName",
          "tabBadge"
        ],
        "props": {
          "align": "center",
          "gap": "sm",
          "justify": "between"
        },
        "type": "Row"
      },
      "tabs": {
        "children": [
          "tab"
        ],
        "props": {
          "cols": 2,
          "gap": "sm"
        },
        "repeat": {
          "key": "accountId",
          "statePath": "/xero-accounting/get_xero_bank_balance_difference/accounts"
        },
        "type": "Grid"
      },
      "title": {
        "props": {
          "level": "h2",
          "text": "Bank Balance Change"
        },
        "type": "Heading"
      },
      "titleGroup": {
        "children": [
          "titleIcon",
          "titleStack"
        ],
        "props": {
          "align": "start",
          "gap": "sm"
        },
        "type": "Row"
      },
      "titleIcon": {
        "props": {
          "name": "Landmark",
          "size": "sm",
          "tone": "accent"
        },
        "type": "Icon"
      },
      "titleStack": {
        "children": [
          "title",
          "subtitle"
        ],
        "props": {
          "gap": "none"
        },
        "type": "Stack"
      },
      "todayBox": {
        "children": [
          "todayStack"
        ],
        "props": {
          "variant": "muted"
        },
        "type": "Section"
      },
      "todayDate": {
        "props": {
          "text": {
            "$state": "/ui/bbd/view/0/todayText"
          }
        },
        "type": "Caption"
      },
      "todayPill": {
        "props": {
          "text": "TODAY",
          "tone": "info",
          "variant": "soft"
        },
        "type": "Badge"
      },
      "todayStack": {
        "children": [
          "todayPill",
          "todayValue",
          "todayDate"
        ],
        "props": {
          "align": "center",
          "gap": "xs"
        },
        "type": "Stack"
      },
      "todayValue": {
        "props": {
          "size": "sm",
          "value": {
            "$state": "/ui/bbd/view/0/balanceText"
          }
        },
        "type": "Stat"
      },
      "totalLabel": {
        "props": {
          "text": "Total",
          "weight": "medium"
        },
        "type": "Text"
      },
      "totalRow": {
        "children": [
          "totalLabel",
          "totalValue"
        ],
        "props": {
          "align": "center",
          "gap": "sm",
          "justify": "between"
        },
        "type": "Row"
      },
      "totalValue": {
        "props": {
          "text": {
            "$state": "/ui/bbd/view/0/totalText"
          },
          "tone": {
            "$cond": {
              "$state": "/ui/bbd/view/0/direction",
              "eq": "down"
            },
            "$else": "default",
            "$then": "destructive"
          },
          "weight": "medium"
        },
        "type": "Text"
      },
      "txnEmpty": {
        "props": {
          "message": "No transactions since the previous business day."
        },
        "type": "Empty",
        "visible": {
          "$state": "/ui/bbd/view/0/transactions/0",
          "not": true
        }
      },
      "txnList": {
        "children": [
          "txnRow"
        ],
        "props": {
          "gap": "xs"
        },
        "repeat": {
          "key": "id",
          "statePath": "/ui/bbd/rows"
        },
        "type": "Stack"
      },
      "txnRow": {
        "children": [
          "cCode",
          "cContact",
          "cAmount"
        ],
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "target": "_blank",
              "url": {
                "$computed": "identity",
                "args": {
                  "value": {
                    "$item": "url"
                  }
                }
              }
            }
          }
        },
        "props": {
          "align": "start",
          "clickable": true,
          "gap": "sm",
          "hover": true,
          "template": "7.5rem 1fr auto"
        },
        "type": "Row"
      },
      "txnTable": {
        "children": [
          "colHeads",
          "divider0",
          "txnList",
          "divider1",
          "totalRow"
        ],
        "props": {
          "gap": "xs"
        },
        "type": "Stack",
        "visible": {
          "$state": "/ui/bbd/view/0/transactions/0"
        }
      },
      "why": {
        "children": [
          "whyHeader",
          "txnEmpty",
          "txnTable",
          "check"
        ],
        "props": {
          "gap": "sm"
        },
        "type": "Stack"
      },
      "whyCount": {
        "props": {
          "text": {
            "$state": "/ui/bbd/view/0/transactionCountText"
          }
        },
        "type": "Caption"
      },
      "whyHeader": {
        "children": [
          "whyTitle",
          "whyCount"
        ],
        "props": {
          "align": "center",
          "gap": "sm",
          "justify": "between"
        },
        "type": "Row"
      },
      "whyTitle": {
        "props": {
          "text": {
            "$cond": {
              "$state": "/ui/bbd/view/0/whyHeading"
            },
            "$else": {
              "$state": "/ui/bbd/view/0/whyTitle"
            },
            "$then": {
              "$state": "/ui/bbd/view/0/whyHeading"
            }
          }
        },
        "type": "Eyebrow"
      }
    },
    "root": "card"
  },
  "tags": [
    "xero",
    "bank",
    "accounts",
    "cash",
    "finance"
  ],
  "title": "Bank Balance Change"
}
