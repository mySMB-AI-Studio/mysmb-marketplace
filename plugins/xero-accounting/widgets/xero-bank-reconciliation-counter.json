{
  "id": "xero-bank-reconciliation-counter",
  "title": "Bank Reconciliation Counter",
  "description": "Unreconciled bank transaction counter per account.",
  "category": "finance",
  "tags": [
    "xero",
    "bank",
    "reconciliation",
    "accounts",
    "finance"
  ],
  "keywords": [
    "bank",
    "reconciliation",
    "reconcile",
    "unreconciled",
    "transactions",
    "account"
  ],
  "connectorsUsed": [
    "xero-accounting"
  ],
  "popularity": 0,
  "sizing": {
    "preferred": {
      "colSpan": 3,
      "rowSpan": 4
    },
    "min": {
      "colSpan": 3,
      "rowSpan": 4
    },
    "max": {
      "colSpan": 8,
      "rowSpan": 8
    }
  },
  "dataProvider": {
    "mcp": "xero-accounting",
    "tool": "list_bank_transactions",
    "params": {
      "where": "IsReconciled==false",
      "order": "Date DESC"
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "children": [
          "header",
          "loadingStats",
          "statRow",
          "divider",
          "body",
          "overlay"
        ]
      },
      "header": {
        "type": "Header",
        "children": [
          "titleGroup"
        ]
      },
      "titleGroup": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center"
        },
        "children": [
          "titleIcon",
          "title"
        ]
      },
      "titleIcon": {
        "type": "Icon",
        "props": {
          "name": "Landmark",
          "tone": "warning",
          "size": "sm"
        }
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "To reconcile",
          "level": "h2"
        }
      },
      "loadingStats": {
        "type": "Grid",
        "props": {
          "cols": 2,
          "gap": "md"
        },
        "children": [
          "loadStatA",
          "loadStatB"
        ],
        "visible": {
          "$state": "/_loading/xero-accounting.list_bank_transactions"
        }
      },
      "loadStatA": {
        "type": "Skeleton",
        "props": {
          "height": "3rem",
          "rounded": "md"
        }
      },
      "loadStatB": {
        "type": "Skeleton",
        "props": {
          "height": "3rem",
          "rounded": "md"
        }
      },
      "statRow": {
        "type": "Grid",
        "props": {
          "cols": 2,
          "gap": "md"
        },
        "children": [
          "countCell",
          "amountCell"
        ],
        "visible": {
          "$state": "/_loading/xero-accounting.list_bank_transactions",
          "not": true
        }
      },
      "countCell": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "children": [
          "countLabelRow",
          "countValue"
        ]
      },
      "countLabelRow": {
        "type": "Row",
        "props": {
          "gap": "xs",
          "align": "center"
        },
        "children": [
          "countIcon",
          "countLabel"
        ]
      },
      "countIcon": {
        "type": "Icon",
        "props": {
          "name": "ListChecks",
          "tone": "warning",
          "size": "xs"
        }
      },
      "countLabel": {
        "type": "Eyebrow",
        "props": {
          "text": "Unreconciled"
        }
      },
      "countValue": {
        "type": "Stat",
        "props": {
          "value": {
            "$computed": "count",
            "args": {
              "value": {
                "$state": "/xero-accounting/list_bank_transactions/BankTransactions"
              }
            }
          },
          "tone": "warning"
        }
      },
      "amountCell": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "children": [
          "amountLabelRow",
          "amountValue"
        ]
      },
      "amountLabelRow": {
        "type": "Row",
        "props": {
          "gap": "xs",
          "align": "center"
        },
        "children": [
          "amountIcon",
          "amountLabel"
        ]
      },
      "amountIcon": {
        "type": "Icon",
        "props": {
          "name": "Coins",
          "tone": "muted",
          "size": "xs"
        }
      },
      "amountLabel": {
        "type": "Eyebrow",
        "props": {
          "text": "Total value"
        }
      },
      "amountValue": {
        "type": "Stat",
        "props": {
          "value": {
            "$computed": "format_currency",
            "args": {
              "value": {
                "$computed": "sum",
                "args": {
                  "value": {
                    "$state": "/xero-accounting/list_bank_transactions/BankTransactions"
                  },
                  "field": "Total"
                }
              }
            }
          }
        }
      },
      "divider": {
        "type": "Divider"
      },
      "body": {
        "type": "Body",
        "children": [
          "loadingList",
          "empty",
          "list"
        ]
      },
      "loadingList": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "ls1",
          "ls2",
          "ls3"
        ],
        "visible": {
          "$state": "/_loading/xero-accounting.list_bank_transactions"
        }
      },
      "ls1": {
        "type": "Skeleton",
        "props": {
          "height": "2rem",
          "rounded": "md"
        }
      },
      "ls2": {
        "type": "Skeleton",
        "props": {
          "height": "2rem",
          "rounded": "md"
        }
      },
      "ls3": {
        "type": "Skeleton",
        "props": {
          "height": "2rem",
          "rounded": "md"
        }
      },
      "empty": {
        "type": "Empty",
        "props": {
          "message": "All transactions reconciled — inbox zero!"
        },
        "visible": {
          "$and": [
            {
              "$state": "/_loading/xero-accounting.list_bank_transactions",
              "not": true
            },
            {
              "$state": "/xero-accounting/list_bank_transactions/BankTransactions/0",
              "not": true
            }
          ]
        }
      },
      "list": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "children": [
          "row"
        ],
        "repeat": {
          "statePath": "/xero-accounting/list_bank_transactions/BankTransactions",
          "key": "BankTransactionID"
        },
        "visible": {
          "$state": "/_loading/xero-accounting.list_bank_transactions",
          "not": true
        }
      },
      "row": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "start",
          "hover": true,
          "clickable": true
        },
        "children": [
          "rowIcon",
          "rowLabel",
          "rowAmount"
        ],
        "on": {
          "click": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/selectedBankTxnId",
                "value": {
                  "$computed": "identity",
                  "args": {
                    "value": {
                      "$item": "BankTransactionID"
                    }
                  }
                }
              }
            },
            {
              "action": "xero-accounting.get_bank_transaction",
              "params": {
                "bankTransactionId": {
                  "$computed": "identity",
                  "args": {
                    "value": {
                      "$item": "BankTransactionID"
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "rowIcon": {
        "type": "Icon",
        "props": {
          "name": {
            "$computed": "xero-accounting_bank_tx_icon",
            "args": {
              "value": {
                "$item": "Type"
              }
            }
          },
          "tone": {
            "$computed": "xero-accounting_bank_tx_tone",
            "args": {
              "value": {
                "$item": "Type"
              }
            }
          },
          "size": "sm"
        }
      },
      "rowLabel": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "children": [
          "rowTop",
          "rowBottom"
        ]
      },
      "rowTop": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "BankAccount/Name"
          },
          "size": "sm",
          "weight": "medium",
          "truncate": true
        }
      },
      "rowBottom": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{type} · {name}",
              "type": {
                "$item": "Type"
              },
              "name": {
                "$item": "Contact/Name"
              }
            }
          }
        }
      },
      "rowAmount": {
        "type": "Stack",
        "props": {
          "gap": "xs",
          "align": "end"
        },
        "children": [
          "rowAmountText",
          "rowDate"
        ]
      },
      "rowAmountText": {
        "type": "Text",
        "props": {
          "text": {
            "$computed": "format_currency",
            "args": {
              "value": {
                "$item": "Total"
              },
              "currency": {
                "$item": "CurrencyCode"
              }
            }
          },
          "weight": "semibold",
          "size": "sm"
        }
      },
      "rowDate": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "xero-accounting_format_date",
            "args": {
              "value": {
                "$item": "Date"
              },
              "format": "short"
            }
          }
        }
      },
      "overlay": {
        "type": "Overlay",
        "props": {
          "maxWidth": "26rem"
        },
        "children": [
          "detailCard"
        ],
        "visible": {
          "$state": "/ui/selectedBankTxnId"
        },
        "on": {
          "backdropClick": {
            "action": "setState",
            "params": {
              "statePath": "/ui/selectedBankTxnId",
              "value": ""
            }
          }
        }
      },
      "detailCard": {
        "type": "Card",
        "children": [
          "detailHeader",
          "detailSpinner",
          "detailBody"
        ]
      },
      "detailHeader": {
        "type": "Header",
        "children": [
          "detailTitle",
          "detailClose"
        ]
      },
      "detailTitle": {
        "type": "Heading",
        "props": {
          "text": "Bank transaction",
          "level": "h2"
        }
      },
      "detailClose": {
        "type": "IconButton",
        "props": {
          "icon": "X",
          "tone": "muted",
          "ariaLabel": "Close"
        },
        "on": {
          "click": {
            "action": "setState",
            "params": {
              "statePath": "/ui/selectedBankTxnId",
              "value": ""
            }
          }
        }
      },
      "detailSpinner": {
        "type": "Spinner",
        "props": {
          "label": "Loading transaction…"
        },
        "visible": {
          "$state": "/xero-accounting/get_bank_transaction/BankTransactions/0/BankTransactionID",
          "neq": {
            "$state": "/ui/selectedBankTxnId"
          }
        }
      },
      "detailBody": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "children": [
          "kvContact",
          "kvType",
          "kvAccount",
          "kvDate",
          "kvTotal",
          "kvReconciled",
          "kvRef"
        ],
        "visible": {
          "$state": "/xero-accounting/get_bank_transaction/BankTransactions/0/BankTransactionID",
          "eq": {
            "$state": "/ui/selectedBankTxnId"
          }
        }
      },
      "kvContact": {
        "type": "KeyValue",
        "props": {
          "label": "Contact",
          "value": {
            "$state": "/xero-accounting/get_bank_transaction/BankTransactions/0/Contact/Name"
          }
        }
      },
      "kvType": {
        "type": "KeyValue",
        "props": {
          "label": "Type",
          "value": {
            "$state": "/xero-accounting/get_bank_transaction/BankTransactions/0/Type"
          }
        }
      },
      "kvAccount": {
        "type": "KeyValue",
        "props": {
          "label": "Account",
          "value": {
            "$state": "/xero-accounting/get_bank_transaction/BankTransactions/0/BankAccount/Name"
          }
        }
      },
      "kvDate": {
        "type": "KeyValue",
        "props": {
          "label": "Date",
          "value": {
            "$computed": "xero-accounting_format_date",
            "args": {
              "value": {
                "$state": "/xero-accounting/get_bank_transaction/BankTransactions/0/Date"
              },
              "format": "medium"
            }
          }
        }
      },
      "kvTotal": {
        "type": "KeyValue",
        "props": {
          "label": "Total",
          "value": {
            "$computed": "format_currency",
            "args": {
              "value": {
                "$state": "/xero-accounting/get_bank_transaction/BankTransactions/0/Total"
              },
              "currency": {
                "$state": "/xero-accounting/get_bank_transaction/BankTransactions/0/CurrencyCode"
              }
            }
          }
        }
      },
      "kvReconciled": {
        "type": "KeyValue",
        "props": {
          "label": "Reconciled",
          "value": {
            "$cond": {
              "$state": "/xero-accounting/get_bank_transaction/BankTransactions/0/IsReconciled"
            },
            "$then": "Yes",
            "$else": "No"
          }
        }
      },
      "kvRef": {
        "type": "KeyValue",
        "props": {
          "label": "Reference",
          "value": {
            "$state": "/xero-accounting/get_bank_transaction/BankTransactions/0/Reference"
          }
        }
      }
    }
  },
  "status": "draft"
}
