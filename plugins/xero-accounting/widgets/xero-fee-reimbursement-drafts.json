{
  "id": "xero-fee-reimbursement-drafts",
  "title": "Fee & Reimbursement Drafts",
  "description": "Drafts the owner's platform fee reimbursement as a DRAFT Bill in Xero — a single recurring line against the owner (already set up as a supplier contact) for the fixed platform fee amount. Nothing is authorised or paid from here; someone still reviews and approves the draft in Xero. Reuses the same create_invoice mechanism as the Bill Entry tile, just scoped to this one recurring purpose.",
  "category": "finance",
  "tags": ["xero", "accounting", "reimbursement", "expenses", "bills", "accounts-payable"],
  "keywords": ["platform fee", "owner reimbursement", "expense claim", "draft bill", "create bill", "reimbursement draft", "xero"],
  "connectorsUsed": ["xero-accounting"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 6, "rowSpan": 9 },
    "min": { "colSpan": 5, "rowSpan": 7 },
    "max": { "colSpan": 10, "rowSpan": 12 }
  },
  "dataProvider": {
    "kind": "tool",
    "mcp": "xero-accounting",
    "tool": "list_contacts",
    "params": { "where": "ContactStatus==\"ACTIVE\"&&IsSupplier==true", "order": "Name" }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": ["header", "divider1", "body", "divider2", "footer", "infoOverlay"],
        "watch": {
          "/xero-accounting/list_contacts/Contacts": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/contactOptions",
                "value": {
                  "$computed": "to_options",
                  "args": {
                    "value": { "$state": "/xero-accounting/list_contacts/Contacts" },
                    "valueField": "ContactID",
                    "labelField": "Name"
                  }
                }
              }
            }
          ],
          "/ui/contactOptions": [
            { "action": "xero-accounting.list_accounts", "params": { "where": "Status==\"ACTIVE\"&&(Type==\"EXPENSE\"||Type==\"DIRECTCOSTS\")" } }
          ],
          "/xero-accounting/list_accounts/Accounts": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/accountOptions",
                "value": {
                  "$computed": "to_options",
                  "args": {
                    "value": { "$state": "/xero-accounting/list_accounts/Accounts" },
                    "valueField": "Code",
                    "labelField": "Name"
                  }
                }
              }
            }
          ],
          "/ui/accountOptions": [
            { "action": "xero-accounting.list_tax_rates", "params": {} }
          ],
          "/xero-accounting/list_tax_rates/TaxRates": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/taxOptions",
                "value": {
                  "$computed": "to_options",
                  "args": {
                    "value": { "$state": "/xero-accounting/list_tax_rates/TaxRates" },
                    "valueField": "TaxType",
                    "labelField": "Name"
                  }
                }
              }
            }
          ],
          "/ui/taxOptions": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/taxRateByType",
                "value": {
                  "$computed": "xero-accounting_bill_entry_tax_rate_lookup",
                  "args": { "taxRates": { "$state": "/xero-accounting/list_tax_rates/TaxRates" } }
                }
              }
            }
          ],
          "/ui/form/contactId": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/supplierBalances",
                "value": {
                  "$computed": "xero-accounting_bill_entry_supplier_balances",
                  "args": {
                    "contacts": { "$state": "/xero-accounting/list_contacts/Contacts" },
                    "contactId": { "$state": "/ui/form/contactId" }
                  }
                }
              }
            }
          ],
          "/ui/form/accountCode": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/form/taxType",
                "value": {
                  "$computed": "xero-accounting_fee_reimbursement_account_tax_type",
                  "args": {
                    "accounts": { "$state": "/xero-accounting/list_accounts/Accounts" },
                    "accountCode": { "$state": "/ui/form/accountCode" },
                    "current": { "$state": "/ui/form/taxType" }
                  }
                }
              }
            }
          ],
          "/xero-accounting/create_invoice/Invoices": [
            {
              "action": "setState",
              "params": { "statePath": "/ui/lastCreatedInvoiceId", "value": { "$state": "/xero-accounting/create_invoice/Invoices/0/InvoiceID" } }
            }
          ],
          "/ui/lastCreatedInvoiceId": [
            { "action": "setState", "params": { "statePath": "/ui/form/amount", "value": "" } }
          ]
        }
      },

      "header": { "type": "Header", "props": {}, "children": ["titleRow"] },
      "titleRow": { "type": "Row", "props": { "gap": "sm", "align": "center", "justify": "between" }, "children": ["titleGroup", "infoBtn"] },
      "titleGroup": { "type": "Row", "props": { "gap": "sm", "align": "center" }, "children": ["titleIcon", "titleStack"] },
      "titleIcon": { "type": "Icon", "props": { "name": "HandCoins", "tone": "accent", "size": "sm" } },
      "titleStack": { "type": "Stack", "props": { "gap": "none" }, "children": ["title", "eyebrow"] },
      "title": { "type": "Heading", "props": { "text": "Fee & Reimbursement Drafts", "level": "h2" } },
      "eyebrow": { "type": "Eyebrow", "props": { "text": "Xero Accounting · platform fee reimbursement" } },
      "infoBtn": {
        "type": "IconButton",
        "props": { "icon": "Info", "size": "sm", "tone": "muted", "ariaLabel": "About this tile" },
        "on": { "click": { "action": "setState", "params": { "statePath": "/ui/showInfo", "value": true } } }
      },

      "divider1": { "type": "Divider", "props": {} },

      "body": { "type": "Body", "props": {}, "children": ["successBanner", "errorBanner", "formStack"] },

      "successBanner": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["successIcon", "successText", "successLink"],
        "visible": { "$state": "/ui/lastCreatedInvoiceId" }
      },
      "successIcon": { "type": "Icon", "props": { "name": "CheckCircle2", "tone": "success", "size": "sm" } },
      "successText": { "type": "Caption", "props": { "text": "Draft reimbursement bill created.", "tone": "success" } },
      "successLink": {
        "type": "Button",
        "props": { "label": "View in Xero", "size": "sm", "variant": "ghost", "leadingIcon": "ExternalLink" },
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "url": { "$template": "https://go.xero.com/AccountsPayable/View.aspx?InvoiceID=${/ui/lastCreatedInvoiceId}" },
              "target": "_blank"
            }
          }
        }
      },

      "errorBanner": {
        "type": "Caption",
        "props": {
          "text": { "$template": "Couldn't create the draft: ${/_errors/xero-accounting.create_invoice}" },
          "tone": "destructive"
        },
        "visible": { "$state": "/_errors/xero-accounting.create_invoice" }
      },

      "formStack": { "type": "Stack", "props": { "gap": "sm" }, "children": ["ownerRow", "ownerBalanceRow", "dateRow", "amountRow", "accountRow", "taxRow", "referenceRow", "validationRow", "submitRow"] },

      "ownerRow": {
        "type": "FormRow",
        "props": { "label": "Owner", "hint": "The supplier contact being reimbursed" },
        "children": ["ownerSelect"]
      },
      "ownerSelect": {
        "type": "Select",
        "props": {
          "value": { "$bindState": "/ui/form/contactId" },
          "options": { "$state": "/ui/contactOptions" },
          "placeholder": "Select the owner…",
          "size": "sm"
        }
      },

      "ownerBalanceRow": {
        "type": "Row",
        "props": { "gap": "lg", "align": "center" },
        "children": ["weOweBlock"],
        "visible": { "$state": "/ui/form/contactId" }
      },
      "weOweBlock": { "type": "Stack", "props": { "gap": "none" }, "children": ["weOweLabel", "weOweValue", "weOweOverdueCaption"] },
      "weOweLabel": { "type": "Caption", "props": { "text": "Already owed to the owner", "tone": "muted" } },
      "weOweValue": {
        "type": "Text",
        "props": {
          "text": { "$state": "/ui/supplierBalances/weOwe" },
          "tone": { "$state": "/ui/supplierBalances/weOweTone" },
          "weight": "semibold",
          "size": "sm"
        }
      },
      "weOweOverdueCaption": {
        "type": "Caption",
        "props": {
          "text": { "$computed": "fmt", "args": { "pattern": "{amt} overdue", "amt": { "$state": "/ui/supplierBalances/weOweOverdue" } } },
          "tone": "destructive"
        },
        "visible": { "$state": "/ui/supplierBalances/weOweIsOverdue" }
      },

      "dateRow": {
        "type": "FormRow",
        "props": { "label": "Date" },
        "children": ["dateInput"]
      },
      "dateInput": {
        "type": "DateInput",
        "props": { "value": { "$bindState": "/ui/form/date" }, "size": "sm" }
      },

      "amountRow": {
        "type": "FormRow",
        "props": { "label": "Platform fee", "hint": "The fixed recurring amount owed to the owner" },
        "children": ["amountInput"]
      },
      "amountInput": {
        "type": "NumberInput",
        "props": { "value": { "$bindState": "/ui/form/amount" }, "min": 0, "step": 0.01, "placeholder": "0.00", "size": "sm" }
      },

      "accountRow": {
        "type": "FormRow",
        "props": { "label": "Expense account" },
        "children": ["accountSelect"]
      },
      "accountSelect": {
        "type": "Select",
        "props": {
          "value": { "$bindState": "/ui/form/accountCode" },
          "options": { "$state": "/ui/accountOptions" },
          "placeholder": "Account…",
          "size": "sm"
        }
      },

      "taxRow": {
        "type": "FormRow",
        "props": { "label": "Tax rate" },
        "children": ["taxSelect"]
      },
      "taxSelect": {
        "type": "Select",
        "props": {
          "value": { "$bindState": "/ui/form/taxType" },
          "options": { "$state": "/ui/taxOptions" },
          "placeholder": "Tax rate…",
          "size": "sm"
        }
      },

      "referenceRow": {
        "type": "FormRow",
        "props": { "label": "Reference", "hint": "Optional — e.g. the billing period" },
        "children": ["referenceInput"]
      },
      "referenceInput": {
        "type": "TextInput",
        "props": { "value": { "$bindState": "/ui/form/reference" }, "placeholder": "e.g. October 2026", "size": "sm" }
      },

      "validationRow": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "xero-accounting_fee_reimbursement_validation_message",
            "args": {
              "contactId": { "$state": "/ui/form/contactId" },
              "date": { "$state": "/ui/form/date" },
              "amount": { "$state": "/ui/form/amount" },
              "accountCode": { "$state": "/ui/form/accountCode" },
              "taxType": { "$state": "/ui/form/taxType" }
            }
          },
          "tone": "warning"
        },
        "visible": {
          "$computed": "xero-accounting_fee_reimbursement_is_invalid",
          "args": {
            "contactId": { "$state": "/ui/form/contactId" },
            "date": { "$state": "/ui/form/date" },
            "amount": { "$state": "/ui/form/amount" },
            "accountCode": { "$state": "/ui/form/accountCode" },
            "taxType": { "$state": "/ui/form/taxType" }
          }
        }
      },

      "submitRow": { "type": "Row", "props": { "justify": "end" }, "children": ["submitBtn"] },
      "submitBtn": {
        "type": "Button",
        "props": {
          "label": "Draft Reimbursement",
          "leadingIcon": "HandCoins",
          "tone": "brand",
          "variant": "primary",
          "disabled": {
            "$computed": "xero-accounting_fee_reimbursement_is_invalid",
            "args": {
              "contactId": { "$state": "/ui/form/contactId" },
              "date": { "$state": "/ui/form/date" },
              "amount": { "$state": "/ui/form/amount" },
              "accountCode": { "$state": "/ui/form/accountCode" },
              "taxType": { "$state": "/ui/form/taxType" }
            }
          }
        },
        "on": {
          "click": {
            "action": "xero-accounting.create_invoice",
            "params": {
              "invoice": {
                "$computed": "xero-accounting_fee_reimbursement_build_payload",
                "args": {
                  "contactId": { "$state": "/ui/form/contactId" },
                  "date": { "$state": "/ui/form/date" },
                  "reference": { "$state": "/ui/form/reference" },
                  "amount": { "$state": "/ui/form/amount" },
                  "accountCode": { "$state": "/ui/form/accountCode" },
                  "taxType": { "$state": "/ui/form/taxType" }
                }
              }
            }
          }
        }
      },

      "divider2": { "type": "Divider", "props": {} },
      "footer": {
        "type": "Row",
        "props": { "justify": "end", "gap": "xs" },
        "children": ["viewAllBillsBtn", "openXeroBtn"]
      },
      "viewAllBillsBtn": {
        "type": "Button",
        "props": { "label": "View All Bills", "tone": "brand", "variant": "ghost", "size": "sm", "leadingIcon": "ExternalLink" },
        "on": {
          "click": { "action": "open_url", "params": { "url": "https://go.xero.com/AccountsPayable/", "target": "_blank" } }
        }
      },
      "openXeroBtn": {
        "type": "Button",
        "props": { "label": "Open Xero", "tone": "brand", "variant": "ghost", "size": "sm", "leadingIcon": "ExternalLink" },
        "on": {
          "click": { "action": "open_url", "params": { "url": "https://go.xero.com/", "target": "_blank" } }
        }
      },

      "infoOverlay": {
        "type": "Overlay",
        "props": { "maxWidth": "28rem" },
        "children": ["infoCard"],
        "visible": { "$state": "/ui/showInfo" },
        "on": {
          "backdropClick": { "action": "setState", "params": { "statePath": "/ui/showInfo", "value": false } }
        }
      },
      "infoCard": {
        "type": "Card",
        "props": {},
        "children": ["infoCloseBtn", "infoTitleRow", "infoDivider", "infoBody"]
      },
      "infoCloseBtn": {
        "type": "IconButton",
        "props": { "icon": "X", "size": "sm", "tone": "muted", "ariaLabel": "Close", "floating": true },
        "on": { "click": { "action": "setState", "params": { "statePath": "/ui/showInfo", "value": false } } }
      },
      "infoTitleRow": { "type": "Row", "props": { "align": "center", "gap": "sm" }, "children": ["infoTitleIcon", "infoTitleText"] },
      "infoTitleIcon": { "type": "Icon", "props": { "name": "Info", "size": "sm", "tone": "info" } },
      "infoTitleText": { "type": "Heading", "props": { "text": "How this tile works", "level": "h2" } },
      "infoDivider": { "type": "Divider", "props": {} },
      "infoBody": {
        "type": "Stack",
        "props": { "gap": "md" },
        "children": ["infoWhatLabel", "infoWhatText", "infoHowLabel", "infoHowText", "infoLimitsLabel", "infoLimitsText"]
      },
      "infoWhatLabel": { "type": "Caption", "props": { "text": "What this is", "tone": "muted", "weight": "semibold" } },
      "infoWhatText": {
        "type": "Text",
        "props": {
          "text": "Drafts the fixed, recurring platform fee the business owner is owed as a reimbursement — recorded against the owner's contact in Xero (already set up as a supplier).",
          "size": "sm"
        }
      },
      "infoHowLabel": { "type": "Caption", "props": { "text": "How it works", "tone": "muted", "weight": "semibold" } },
      "infoHowText": {
        "type": "Text",
        "props": {
          "text": "Pick the owner, date, fee amount, and expense account — the tax rate pre-fills from that account's own default in Xero, but can be changed. \"Draft Reimbursement\" creates a real DRAFT bill; nothing is authorised or paid automatically. Someone still reviews and approves it in Xero.",
          "size": "sm"
        }
      },
      "infoLimitsLabel": { "type": "Caption", "props": { "text": "Good to know", "tone": "muted", "weight": "semibold" } },
      "infoLimitsText": {
        "type": "Text",
        "props": {
          "text": "The fee amount isn't pulled from anywhere — it's a fixed recurring figure you enter each time, since Xero has nothing that tracks it automatically. The owner must already be flagged as a supplier contact in Xero, or they won't appear in the dropdown.",
          "size": "sm"
        }
      }
    }
  },
  "status": "published"
}
