{
  "id": "xero-recurring-invoices",
  "title": "Recurring Invoices",
  "description": "Recurring invoice schedule upcoming runs.",
  "category": "finance",
  "tags": [
    "xero",
    "invoices",
    "recurring",
    "subscription",
    "finance"
  ],
  "keywords": [
    "recurring",
    "subscription",
    "repeat",
    "invoice",
    "invoices",
    "schedule"
  ],
  "connectorsUsed": [
    "xero-accounting"
  ],
  "popularity": 0,
  "sizing": {
    "preferred": {
      "colSpan": 6,
      "rowSpan": 5
    },
    "min": {
      "colSpan": 4,
      "rowSpan": 4
    },
    "max": {
      "colSpan": 12,
      "rowSpan": 10
    }
  },
  "dataProvider": {
    "mcp": "xero-accounting",
    "tool": "list_repeating_invoices",
    "params": {
      "order": "NextScheduledDate ASC"
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "children": [
          "header",
          "body"
        ]
      },
      "header": {
        "type": "Header",
        "children": [
          "titleGroup",
          "count"
        ]
      },
      "titleGroup": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center"
        },
        "children": [
          "titleIcon",
          "title"
        ]
      },
      "titleIcon": {
        "type": "Icon",
        "props": {
          "name": "Repeat",
          "tone": "info",
          "size": "sm"
        }
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "Recurring invoices",
          "level": "h2"
        }
      },
      "count": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{n} active",
              "n": {
                "$computed": "count",
                "args": {
                  "value": {
                    "$state": "/xero-accounting/list_repeating_invoices/RepeatingInvoices"
                  }
                }
              }
            }
          }
        }
      },
      "body": {
        "type": "Body",
        "children": [
          "loading",
          "empty",
          "list"
        ]
      },
      "loading": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "visible": {
          "$state": "/_loading/xero-accounting.list_repeating_invoices"
        },
        "children": [
          "s1",
          "s2",
          "s3"
        ]
      },
      "s1": {
        "type": "Skeleton",
        "props": {
          "height": "2.25rem",
          "rounded": "md"
        }
      },
      "s2": {
        "type": "Skeleton",
        "props": {
          "height": "2.25rem",
          "rounded": "md"
        }
      },
      "s3": {
        "type": "Skeleton",
        "props": {
          "height": "2.25rem",
          "rounded": "md"
        }
      },
      "empty": {
        "type": "Empty",
        "props": {
          "message": "No recurring invoices configured."
        },
        "visible": {
          "$and": [
            {
              "$state": "/_loading/xero-accounting.list_repeating_invoices",
              "not": true
            },
            {
              "$state": "/xero-accounting/list_repeating_invoices/RepeatingInvoices/0",
              "not": true
            }
          ]
        }
      },
      "list": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "visible": {
          "$state": "/_loading/xero-accounting.list_repeating_invoices",
          "not": true
        },
        "repeat": {
          "statePath": "/xero-accounting/list_repeating_invoices/RepeatingInvoices",
          "key": "RepeatingInvoiceID"
        },
        "children": [
          "row"
        ]
      },
      "row": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center",
          "hover": true
        },
        "children": [
          "icon",
          "labels",
          "statusBadge",
          "amount"
        ]
      },
      "icon": {
        "type": "Icon",
        "props": {
          "name": "CalendarRange",
          "tone": "muted",
          "size": "sm"
        }
      },
      "labels": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "children": [
          "labelTop",
          "labelBottom"
        ]
      },
      "labelTop": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "Contact/Name"
          },
          "size": "md",
          "weight": "medium",
          "truncate": true
        }
      },
      "labelBottom": {
        "type": "Text",
        "props": {
          "size": "sm",
          "tone": "muted",
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "Next run: {next}",
              "next": {
                "$computed": "xero-accounting_format_date",
                "args": {
                  "value": {
                    "$item": "Schedule/NextScheduledDate"
                  },
                  "format": "medium"
                }
              }
            }
          }
        }
      },
      "statusBadge": {
        "type": "Badge",
        "props": {
          "text": {
            "$item": "Status"
          },
          "tone": {
            "$computed": "xero-accounting_status_tone",
            "args": {
              "value": {
                "$item": "Status"
              }
            }
          },
          "variant": "soft"
        }
      },
      "amount": {
        "type": "Text",
        "props": {
          "text": {
            "$computed": "format_currency",
            "args": {
              "value": {
                "$item": "Total"
              },
              "currency": {
                "$item": "CurrencyCode"
              }
            }
          },
          "weight": "semibold",
          "size": "sm"
        }
      }
    }
  },
  "status": "draft"
}
