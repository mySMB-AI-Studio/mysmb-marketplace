{
  "id": "xero-top-debtors",
  "title": "Top Debtors",
  "description": "Top debtors by balance receivable.",
  "category": "finance",
  "tags": [
    "xero",
    "debtors",
    "ar",
    "customers",
    "finance"
  ],
  "keywords": [
    "debtors",
    "debtor",
    "customers",
    "ar",
    "accounts receivable",
    "owed",
    "top",
    "owing"
  ],
  "connectorsUsed": [
    "xero-accounting"
  ],
  "popularity": 0,
  "sizing": {
    "preferred": {
      "colSpan": 4,
      "rowSpan": 3
    },
    "min": {
      "colSpan": 4,
      "rowSpan": 4
    },
    "max": {
      "colSpan": 10,
      "rowSpan": 10
    }
  },
  "dataProvider": {
    "mcp": "xero-accounting",
    "tool": "list_invoices",
    "params": {
      "statuses": "AUTHORISED",
      "where": "Type==\"ACCREC\"",
      "order": "AmountDue DESC"
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "children": [
          "header",
          "body"
        ],
        "watch": {
          "/xero-accounting/list_invoices/Invoices": {
            "action": "setState",
            "params": {
              "statePath": "/ui/topDebtors",
              "value": {
                "$computed": "top_n",
                "args": {
                  "value": {
                    "$computed": "group_by_sum",
                    "args": {
                      "value": {
                        "$state": "/xero-accounting/list_invoices/Invoices"
                      },
                      "keyField": "Contact.Name",
                      "sumField": "AmountDue"
                    }
                  },
                  "field": "total",
                  "direction": "desc",
                  "limit": 10
                }
              }
            }
          }
        }
      },
      "header": {
        "type": "Header",
        "children": [
          "titleGroup",
          "subtitle"
        ]
      },
      "titleGroup": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center"
        },
        "children": [
          "titleIcon",
          "title"
        ]
      },
      "titleIcon": {
        "type": "Icon",
        "props": {
          "name": "Users",
          "tone": "warning",
          "size": "sm"
        }
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "Top debtors",
          "level": "h2"
        }
      },
      "subtitle": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "Top {n}",
              "n": {
                "$computed": "count",
                "args": {
                  "value": {
                    "$state": "/ui/topDebtors"
                  }
                }
              }
            }
          }
        }
      },
      "body": {
        "type": "Body",
        "children": [
          "loading",
          "empty",
          "list"
        ]
      },
      "loading": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "s1",
          "s2",
          "s3",
          "s4"
        ],
        "visible": {
          "$state": "/_loading/xero-accounting.list_invoices"
        }
      },
      "s1": {
        "type": "Skeleton",
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        }
      },
      "s2": {
        "type": "Skeleton",
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        }
      },
      "s3": {
        "type": "Skeleton",
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        }
      },
      "s4": {
        "type": "Skeleton",
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        }
      },
      "empty": {
        "type": "Empty",
        "props": {
          "message": "Nobody owes you money — rare and glorious."
        },
        "visible": {
          "$and": [
            {
              "$state": "/_loading/xero-accounting.list_invoices",
              "not": true
            },
            {
              "$state": "/ui/topDebtors/0",
              "not": true
            }
          ]
        }
      },
      "list": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "row"
        ],
        "repeat": {
          "statePath": "/ui/topDebtors",
          "key": "key"
        },
        "visible": {
          "$state": "/_loading/xero-accounting.list_invoices",
          "not": true
        }
      },
      "row": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "children": [
          "rowTop",
          "rowBar"
        ]
      },
      "rowTop": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center",
          "justify": "between"
        },
        "children": [
          "rowLeft",
          "rowAmount"
        ]
      },
      "rowLeft": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center"
        },
        "children": [
          "rowAvatar",
          "rowName"
        ]
      },
      "rowAvatar": {
        "type": "Avatar",
        "props": {
          "initials": {
            "$computed": "initials",
            "args": {
              "value": {
                "$item": "key"
              }
            }
          },
          "size": "sm"
        }
      },
      "rowName": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "children": [
          "rowNameTop",
          "rowCount"
        ]
      },
      "rowNameTop": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "key"
          },
          "size": "md",
          "weight": "medium",
          "truncate": true
        }
      },
      "rowCount": {
        "type": "Text",
        "props": {
          "size": "sm",
          "tone": "muted",
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{n} open invoices",
              "n": {
                "$item": "count"
              }
            }
          }
        }
      },
      "rowAmount": {
        "type": "Text",
        "props": {
          "text": {
            "$computed": "format_currency",
            "args": {
              "value": {
                "$item": "total"
              }
            }
          },
          "weight": "semibold",
          "size": "sm"
        }
      },
      "rowBar": {
        "type": "ProgressBar",
        "props": {
          "value": {
            "$computed": "percent_of_max",
            "args": {
              "value": {
                "$item": "total"
              },
              "array": {
                "$state": "/ui/topDebtors"
              },
              "field": "total"
            }
          },
          "tone": "warning"
        }
      }
    }
  },
  "status": "draft"
}
