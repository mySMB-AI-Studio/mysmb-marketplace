{
  "category": "finance",
  "connectorsUsed": [
    "xero-accounting"
  ],
  "dataProvider": {
    "kind": "tool",
    "mcp": "xero-accounting",
    "params": {
      "fromDate": "$month_start_date",
      "toDate": "$today_date"
    },
    "tool": "get_bank_summary"
  },
  "description": "Bank account tiles — one card per bank account in Xero showing the current closing balance.",
  "id": "xero-cash-at-bank",
  "keywords": [
    "bank",
    "cash",
    "balance",
    "accounts",
    "tiles",
    "liquidity"
  ],
  "pluginIcon": "data:image/png;base64,",
  "popularity": 0,
  "sizing": {
    "max": {
      "colSpan": 12,
      "rowSpan": 8
    },
    "min": {
      "colSpan": 6,
      "rowSpan": 2
    },
    "preferred": {
      "colSpan": 6,
      "rowSpan": 2
    }
  },
  "spec": {
    "elements": {
      "body": {
        "children": [
          "loading",
          "empty",
          "tiles"
        ],
        "type": "Body"
      },
      "card": {
        "children": [
          "header",
          "body"
        ],
        "type": "Card",
        "watch": {
          "/xero-accounting/get_bank_summary/Reports": {
            "action": "setState",
            "params": {
              "statePath": "/ui/cash/bankAccounts",
              "value": {
                "$computed": "filter_by",
                "args": {
                  "equals": "Row",
                  "field": "rowType",
                  "value": {
                    "$computed": "xero-accounting_flatten_report_rows",
                    "args": {
                      "value": {
                        "$state": "/xero-accounting/get_bank_summary/Reports/0"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "count": {
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "n": {
                "$computed": "count",
                "args": {
                  "value": {
                    "$state": "/ui/cash/bankAccounts"
                  }
                }
              },
              "pattern": "{n} Accounts"
            }
          }
        },
        "type": "Eyebrow"
      },
      "empty": {
        "props": {
          "message": "No bank accounts configured in Xero."
        },
        "type": "Empty",
        "visible": {
          "$and": [
            {
              "$state": "/_loading/xero-accounting.get_bank_summary",
              "not": true
            },
            {
              "$state": "/ui/cash/bankAccounts/0",
              "not": true
            }
          ]
        }
      },
      "header": {
        "children": [
          "titleGroup"
        ],
        "type": "Header"
      },
      "loading": {
        "children": [
          "s1",
          "s2"
        ],
        "props": {
          "cols": 2,
          "gap": "md"
        },
        "type": "Grid",
        "visible": {
          "$state": "/_loading/xero-accounting.get_bank_summary"
        }
      },
      "s1": {
        "props": {
          "height": "5rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "s2": {
        "props": {
          "height": "5rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "tile": {
        "children": [
          "tileHeader",
          "tileBalanceWrap"
        ],
        "props": {
          "variant": "bordered"
        },
        "type": "Section"
      },
      "tileBalance": {
        "props": {
          "size": "sm",
          "value": {
            "$computed": "format_currency",
            "args": {
              "value": {
                "$item": "c4"
              }
            }
          }
        },
        "type": "Stat"
      },
      "tileBalanceWrap": {
        "children": [
          "tileBalance"
        ],
        "props": {
          "align": "center",
          "gap": "none"
        },
        "type": "Stack"
      },
      "tileHeader": {
        "children": [
          "tileIcon",
          "tileName"
        ],
        "props": {
          "align": "center",
          "gap": "sm"
        },
        "type": "Row"
      },
      "tileIcon": {
        "props": {
          "name": "Banknote",
          "size": "sm",
          "tone": "success"
        },
        "type": "Icon"
      },
      "tileName": {
        "props": {
          "size": "md",
          "text": {
            "$item": "title"
          },
          "truncate": true,
          "weight": "semibold"
        },
        "type": "Text"
      },
      "tiles": {
        "children": [
          "tile"
        ],
        "props": {
          "cols": 2,
          "gap": "md"
        },
        "repeat": {
          "key": "title",
          "statePath": "/ui/cash/bankAccounts"
        },
        "type": "Grid",
        "visible": {
          "$state": "/_loading/xero-accounting.get_bank_summary",
          "not": true
        }
      },
      "title": {
        "props": {
          "level": "h2",
          "text": "Cash at Bank"
        },
        "type": "Heading"
      },
      "titleGroup": {
        "children": [
          "titleIcon",
          "titleStack"
        ],
        "props": {
          "align": "start",
          "gap": "sm"
        },
        "type": "Row"
      },
      "titleIcon": {
        "props": {
          "name": "Landmark",
          "size": "sm",
          "tone": "accent"
        },
        "type": "Icon"
      },
      "titleStack": {
        "children": [
          "title",
          "count"
        ],
        "props": {
          "gap": "none"
        },
        "type": "Stack"
      }
    },
    "root": "card"
  },
  "tags": [
    "xero",
    "bank",
    "accounts",
    "cash",
    "finance"
  ],
  "title": "Cash at Bank"
}
