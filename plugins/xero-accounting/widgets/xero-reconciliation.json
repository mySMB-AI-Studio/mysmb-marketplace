{
  "category": "finance",
  "connectorsUsed": [
    "xero-accounting"
  ],
  "dataProvider": {
    "kind": "tool",
    "mcp": "xero-accounting",
    "params": {
      "order": "Date DESC",
      "where": "Status==\"AUTHORISED\""
    },
    "tool": "list_bank_transactions"
  },
  "description": "All authorised bank transactions with their reconciliation status — a breakdown of reconciled vs. unreconciled, then every transaction (most recent first), each showing which bank account, who it's with, and the amount. A simpler, IsReconciled-flag view rather than Xero's dedicated Finance API bank-statement-matching view (see xero-finance's get_bank_statement_accounting for that, if that connector is ever usable). Click any row to open that exact transaction in Xero.",
  "id": "xero-reconciliation",
  "keywords": [
    "reconciliation",
    "reconciled",
    "unreconciled",
    "bank transactions",
    "bank account",
    "reconcile"
  ],
  "popularity": 0,
  "sizing": {
    "max": {
      "colSpan": 10,
      "rowSpan": 12
    },
    "min": {
      "colSpan": 5,
      "rowSpan": 5
    },
    "preferred": {
      "colSpan": 6,
      "rowSpan": 8
    }
  },
  "spec": {
    "elements": {
      "body": {
        "children": [
          "empty",
          "table",
          "truncatedCaption"
        ],
        "type": "Body"
      },
      "breakdownBar": {
        "children": [
          "breakdownSegment"
        ],
        "props": {
          "align": "center",
          "gap": "xs",
          "template": {
            "$state": "/ui/breakdown/template"
          }
        },
        "repeat": {
          "key": "status",
          "statePath": "/ui/breakdown/segments"
        },
        "type": "Row"
      },
      "breakdownCaption": {
        "props": {
          "text": "Reconciliation Status",
          "tone": "muted"
        },
        "type": "Caption"
      },
      "breakdownDivider": {
        "props": {},
        "type": "Divider"
      },
      "breakdownHeaderRow": {
        "children": [
          "breakdownCaption",
          "breakdownTotalCaption"
        ],
        "props": {
          "align": "center",
          "justify": "between"
        },
        "type": "Row"
      },
      "breakdownLegend": {
        "children": [
          "legendItem"
        ],
        "props": {
          "align": "center",
          "gap": "md"
        },
        "repeat": {
          "key": "status",
          "statePath": "/ui/breakdown/segments"
        },
        "type": "Row"
      },
      "breakdownSection": {
        "children": [
          "breakdownHeaderRow",
          "breakdownBar",
          "breakdownLegend"
        ],
        "props": {
          "gap": "xs"
        },
        "type": "Stack",
        "visible": {
          "$and": [
            {
              "$state": "/_loading/xero-accounting.list_bank_transactions",
              "not": true
            },
            {
              "$state": "/ui/breakdown/segments/0"
            }
          ]
        }
      },
      "breakdownSegment": {
        "props": {
          "tone": {
            "$item": "tone"
          },
          "value": 100
        },
        "type": "ProgressBar"
      },
      "breakdownTotalCaption": {
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{total} transactions",
              "total": {
                "$state": "/ui/breakdown/total"
              }
            }
          },
          "tone": "muted"
        },
        "type": "Caption"
      },
      "card": {
        "children": [
          "header",
          "breakdownSection",
          "breakdownDivider",
          "body",
          "footer"
        ],
        "type": "Card",
        "watch": {
          "/xero-accounting/list_bank_transactions/BankTransactions": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/breakdown",
                "value": {
                  "$computed": "xero-accounting_reconciliation_breakdown",
                  "args": {
                    "transactions": {
                      "$state": "/xero-accounting/list_bank_transactions/BankTransactions"
                    }
                  }
                }
              }
            }
          ],
          "/ui/breakdown": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/rows",
                "value": {
                  "$computed": "xero-accounting_reconciliation_rows",
                  "args": {
                    "transactions": {
                      "$state": "/xero-accounting/list_bank_transactions/BankTransactions"
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "empty": {
        "props": {
          "message": "No bank transactions found in Xero."
        },
        "type": "Empty",
        "visible": {
          "$and": [
            {
              "$state": "/_loading/xero-accounting.list_bank_transactions",
              "not": true
            },
            {
              "$state": "/ui/rows/0",
              "not": true
            }
          ]
        }
      },
      "eyebrow": {
        "props": {
          "text": "Xero — authorised bank transactions"
        },
        "type": "Eyebrow"
      },
      "footer": {
        "children": [
          "openXeroBtn"
        ],
        "props": {
          "justify": "end"
        },
        "type": "Row"
      },
      "header": {
        "children": [
          "titleGroup"
        ],
        "type": "Header"
      },
      "legendDot": {
        "props": {
          "size": "sm",
          "tone": {
            "$item": "tone"
          }
        },
        "type": "Dot"
      },
      "legendItem": {
        "children": [
          "legendDot",
          "legendLabel"
        ],
        "props": {
          "align": "center",
          "gap": "xs"
        },
        "type": "Row"
      },
      "legendLabel": {
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "count": {
                "$item": "count"
              },
              "pattern": "{status} ({count})",
              "status": {
                "$item": "status"
              }
            }
          },
          "tone": "muted"
        },
        "type": "Caption"
      },
      "openXeroBtn": {
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "target": "_blank",
              "url": "https://go.xero.com/Bank/BankAccounts.aspx"
            }
          }
        },
        "props": {
          "label": "Open Bank Accounts in Xero",
          "leadingIcon": "ExternalLink",
          "size": "sm",
          "tone": "brand",
          "variant": "primary"
        },
        "type": "Button"
      },
      "table": {
        "props": {
          "columns": [
            { "id": "type", "header": "Type", "field": "typeLabel", "width": 70 },
            { "id": "contactAccount", "header": "Contact / Account", "field": "contactAccount", "width": 220 },
            { "id": "amount", "header": "Amount", "field": "amount", "format": "currency", "align": "right", "width": 90 },
            { "id": "status", "header": "Status", "field": "statusLabel", "width": 100 },
            { "id": "date", "header": "Date", "field": "date", "format": "xero_date_short", "width": 90 }
          ],
          "loading": { "$state": "/_loading/xero-accounting.list_bank_transactions" },
          "rowAction": {
            "action": "open_url",
            "params": { "target": "_blank" },
            "fromRow": { "url": "detailUrl" }
          },
          "rows": { "$state": "/ui/rows" }
        },
        "type": "Table",
        "visible": {
          "$and": [
            { "$state": "/_loading/xero-accounting.list_bank_transactions", "not": true },
            { "$state": "/ui/rows/0" }
          ]
        }
      },
      "title": {
        "props": {
          "level": "h2",
          "text": "Reconciliation"
        },
        "type": "Heading"
      },
      "titleGroup": {
        "children": [
          "titleIcon",
          "titleStack"
        ],
        "props": {
          "align": "start",
          "gap": "sm"
        },
        "type": "Row"
      },
      "titleIcon": {
        "props": {
          "name": "Landmark",
          "size": "sm",
          "tone": "info"
        },
        "type": "Icon"
      },
      "titleStack": {
        "children": [
          "title",
          "eyebrow"
        ],
        "props": {
          "gap": "none"
        },
        "type": "Stack"
      },
      "truncatedCaption": {
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "Showing 20 of {total}",
              "total": {
                "$computed": "count",
                "args": {
                  "value": {
                    "$state": "/xero-accounting/list_bank_transactions/BankTransactions"
                  }
                }
              }
            }
          },
          "tone": "muted"
        },
        "type": "Caption",
        "visible": {
          "$state": "/xero-accounting/list_bank_transactions/BankTransactions/20"
        }
      }
    },
    "root": "card"
  },
  "tags": [
    "xero",
    "bank",
    "reconciliation",
    "reconcile",
    "finance"
  ],
  "title": "Xero — Reconciliation"
}
