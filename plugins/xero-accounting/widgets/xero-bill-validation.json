{
  "id": "xero-bill-validation",
  "title": "Bill Validation",
  "description": "Checks every unpaid Xero bill for duplicates, supplier ABN, GST, line totals, bill date and a missing source document — one row per bill, one column per check, so problems stand out before payment.",
  "category": "finance",
  "tags": [
    "xero",
    "bills",
    "validation",
    "compliance",
    "accounts-payable",
    "controls"
  ],
  "keywords": [
    "xero",
    "bill validation",
    "duplicate bill",
    "abn check",
    "gst check",
    "missing attachment",
    "bill errors",
    "accounts payable",
    "pre-payment check",
    "bill review"
  ],
  "connectorsUsed": [
    "xero-accounting"
  ],
  "popularity": 0,
  "sizing": {
    "preferred": {
      "colSpan": 6,
      "rowSpan": 8
    },
    "min": {
      "colSpan": 5,
      "rowSpan": 6
    },
    "max": {
      "colSpan": 12,
      "rowSpan": 16
    }
  },
