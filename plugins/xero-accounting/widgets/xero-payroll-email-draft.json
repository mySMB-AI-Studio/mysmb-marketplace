        "type": "Stack",
        "props": {
          "gap": "md"
        },
        "children": [
          "sk0",
          "sk1",
          "sk2"
        ],
        "visible": {
          "$state": "/_loading/xero-accounting.get_xero_payroll_email_draft"
        }
      },
      "sk0": {
        "type": "Skeleton",
        "props": {
          "height": "2rem",
          "rounded": "md"
        }
      },
      "sk1": {
        "type": "Skeleton",
        "props": {
          "height": "10rem",
          "rounded": "md"
        }
      },
      "sk2": {
        "type": "Skeleton",
