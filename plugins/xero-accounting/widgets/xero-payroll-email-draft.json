{
  "id": "xero-payroll-email-draft",
  "title": "Payroll Email Draft",
  "description": "Fills the payroll client email templates (approval request, payment notice, confirmation, asking the owner for changes) with the pay period and owner payments total from Xero plus what you type in. Missing fields stay visible and are listed, and it only opens in Outlook once nothing is missing. Nothing is sent from the tile.",
  "category": "finance",
  "tags": [
    "xero",
    "payroll",
    "email",
    "templates",
    "approval"
  ],
  "keywords": [
    "payroll email",
    "approval request",
    "payment notice",
    "confirmation",
    "client email",
    "template",
    "outlook",
    "pay run approval"
  ],
  "connectorsUsed": [
    "xero-accounting"
  ],
  "popularity": 0,
  "sizing": {
    "preferred": {
      "colSpan": 6,
      "rowSpan": 11
    },
    "min": {
      "colSpan": 5,
      "rowSpan": 8
    },
    "max": {
      "colSpan": 12,
      "rowSpan": 14
    }
  },
  "dataProvider": {
    "kind": "tool",
    "mcp": "xero-accounting",
    "tool": "get_xero_payroll_email_draft",
    "params": {
      "template": "approval"
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "children": [
          "header",
          "body"
