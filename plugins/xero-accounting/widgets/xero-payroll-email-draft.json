          "label": "Copy",
          "variant": "secondary",
          "size": "sm",
          "leadingIcon": "Copy"
        },
        "on": {
          "click": [
            {
              "action": "copy_to_clipboard",
              "params": {
                "text": {
                  "$state": "/xero-accounting/get_xero_payroll_email_draft/copyText"
                }
              }
