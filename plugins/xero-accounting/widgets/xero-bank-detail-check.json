{
  "category": "finance",
  "connectorsUsed": [
    "xero-accounting"
  ],
  "dataProvider": {
    "kind": "tool",
    "mcp": "xero-accounting",
    "params": {},
    "tool": "list_xero_bank_detail_check"
  },
  "description": "Cross-references unpaid Xero bills against bank account details stored on supplier contacts — surfaces missing or unverifiable bank details before batch payment runs.",
  "id": "xero-bank-detail-check",
  "keywords": [
    "xero",
    "bank detail",
    "check",
    "verify",
    "verified",
    "can't verify",
    "missing",
    "bills",
    "accounts payable",
    "batch payment",
    "supplier",
    "contact",
    "fraud"
  ],
  "popularity": 0,
  "sizing": {
    "max": {
      "colSpan": 10,
      "rowSpan": 14
    },
    "min": {
      "colSpan": 4,
      "rowSpan": 5
    },
    "preferred": {
      "colSpan": 5,
      "rowSpan": 7
    }
  },
  "spec": {
    "elements": {
      "billAmount": {
        "props": {
          "size": "sm",
          "text": {
            "$computed": "format_currency",
            "args": {
              "currency": {
                "$item": "currencyCode"
              },
              "value": {
                "$item": "amountDue"
              }
            }
          },
          "weight": "semibold"
        },
        "type": "Text"
      },
      "billDivider": {
        "props": {},
        "type": "Divider"
      },
      "billDot": {
        "props": {
          "size": "sm",
          "tone": {
            "$item": "tone"
          }
        },
        "type": "Dot"
      },
      "billInfo": {
        "children": [
          "billName",
          "billMeta"
        ],
        "props": {
          "gap": "none"
        },
        "type": "Stack"
      },
      "billList": {
        "children": [
          "billRow"
        ],
        "props": {
          "gap": "none"
        },
        "repeat": {
          "key": "id",
          "statePath": "/xero-accounting/list_xero_bank_detail_check/bills"
        },
        "type": "Stack"
      },
      "billMeta": {
        "props": {
          "text": {
            "$item": "metaLine"
          },
          "tone": "muted",
          "truncate": true
        },
        "type": "Caption"
      },
      "billName": {
        "props": {
          "size": "sm",
          "text": {
            "$item": "contactName"
          },
          "truncate": true,
          "weight": "semibold"
        },
        "type": "Text"
      },
      "billRow": {
        "children": [
          "billRowContent",
          "billDivider"
        ],
        "props": {
          "gap": "xs"
        },
        "type": "Stack"
      },
      "billRowContent": {
        "children": [
          "billDot",
          "billInfo",
          "billAmount"
        ],
        "props": {
          "align": "start",
          "gap": "sm",
          "template": "auto minmax(0,1fr) auto"
        },
        "type": "Row"
      },
      "body": {
        "children": [
          "loading",
          "empty",
          "content"
        ],
        "props": {},
        "type": "Body"
      },
      "card": {
        "children": [
          "header",
          "body"
        ],
        "props": {},
        "type": "Card"
      },
      "content": {
        "children": [
          "statsGrid",
          "divider",
          "billList",
          "footerRow"
        ],
        "props": {
          "gap": "md"
        },
        "type": "Stack",
        "visible": {
          "$and": [
            {
              "$state": "/_loading/xero-accounting.list_xero_bank_detail_check",
              "not": true
            },
            {
              "$state": "/xero-accounting/list_xero_bank_detail_check/bills/0"
            }
          ]
        }
      },
      "divider": {
        "props": {},
        "type": "Divider"
      },
      "empty": {
        "props": {
          "message": "No unpaid bills found."
        },
        "type": "Empty",
        "visible": {
          "$and": [
            {
              "$state": "/_loading/xero-accounting.list_xero_bank_detail_check",
              "not": true
            },
            {
              "$state": "/xero-accounting/list_xero_bank_detail_check/bills/0",
              "not": true
            }
          ]
        }
      },
      "eyebrow": {
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "n": {
                "$state": "/xero-accounting/list_xero_bank_detail_check/summary/total"
              },
              "pattern": "Xero · {n} bills · first 100"
            }
          }
        },
        "type": "Eyebrow"
      },
      "footerLeft": {
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "n": {
                "$state": "/xero-accounting/list_xero_bank_detail_check/summary/total"
              },
              "pattern": "{n} unpaid bills scanned"
            }
          },
          "tone": "muted"
        },
        "type": "Caption"
      },
      "footerRight": {
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "Updated {t}",
              "t": {
                "$state": "/xero-accounting/list_xero_bank_detail_check/updatedTime"
              }
            }
          },
          "tone": "muted"
        },
        "type": "Caption"
      },
      "footerRow": {
        "children": [
          "footerLeft",
          "footerRight"
        ],
        "props": {
          "align": "center",
          "gap": "sm",
          "justify": "between"
        },
        "type": "Row"
      },
      "header": {
        "children": [
          "titleGroup"
        ],
        "props": {},
        "type": "Header"
      },
      "lblCantVerify": {
        "props": {
          "text": "CAN'T VERIFY",
          "tone": "muted"
        },
        "type": "Caption"
      },
      "lblVerified": {
        "props": {
          "text": "VERIFIED",
          "tone": "muted"
        },
        "type": "Caption"
      },
      "loading": {
        "children": [
          "sk1",
          "sk2",
          "sk3",
          "sk4",
          "sk5"
        ],
        "props": {
          "gap": "sm"
        },
        "type": "Stack",
        "visible": {
          "$state": "/_loading/xero-accounting.list_xero_bank_detail_check"
        }
      },
      "sk1": {
        "props": {
          "height": "3.5rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "sk2": {
        "props": {
          "height": "2.75rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "sk3": {
        "props": {
          "height": "2.75rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "sk4": {
        "props": {
          "height": "2.75rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "sk5": {
        "props": {
          "height": "2.75rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "statCantVerify": {
        "children": [
          "valCantVerify",
          "lblCantVerify"
        ],
        "props": {
          "gap": "none"
        },
        "type": "Stack"
      },
      "statVerified": {
        "children": [
          "valVerified",
          "lblVerified"
        ],
        "props": {
          "gap": "none"
        },
        "type": "Stack"
      },
      "statsGrid": {
        "children": [
          "statCantVerify",
          "statVerified"
        ],
        "props": {
          "cols": 2,
          "gap": "sm"
        },
        "type": "Grid"
      },
      "title": {
        "props": {
          "level": "h2",
          "text": "Bank-Detail Check"
        },
        "type": "Heading"
      },
      "titleGroup": {
        "children": [
          "titleIcon",
          "titleStack"
        ],
        "props": {
          "align": "center",
          "gap": "sm"
        },
        "type": "Row"
      },
      "titleIcon": {
        "props": {
          "name": "ShieldCheck",
          "size": "sm",
          "tone": "accent"
        },
        "type": "Icon"
      },
      "titleStack": {
        "children": [
          "title",
          "eyebrow"
        ],
        "props": {
          "gap": "none"
        },
        "type": "Stack"
      },
      "valCantVerify": {
        "props": {
          "tone": "warning",
          "value": {
            "$state": "/xero-accounting/list_xero_bank_detail_check/summary/cantVerify"
          }
        },
        "type": "Stat"
      },
      "valVerified": {
        "props": {
          "tone": "success",
          "value": {
            "$state": "/xero-accounting/list_xero_bank_detail_check/summary/verified"
          }
        },
        "type": "Stat"
      }
    },
    "root": "card"
  },
  "tags": [
    "xero",
    "bills",
    "bank",
    "payments",
    "fraud",
    "verification",
    "accounts-payable"
  ],
  "title": "Bank-Detail Check"
}
