{
  "category": "finance",
  "connectorsUsed": [
    "xero-accounting"
  ],
  "dataProvider": {
    "kind": "tool",
    "mcp": "xero-accounting",
    "params": {
      "order": "DueDate ASC",
      "statuses": "AUTHORISED",
      "where": "Type==\"ACCREC\""
    },
    "tool": "list_invoices"
  },
  "description": "Outstanding AR distributed across aging buckets — click any bucket to see the invoices in it.",
  "id": "xero-aged-receivables",
  "keywords": [
    "aged",
    "aging",
    "receivables",
    "ar",
    "outstanding",
    "buckets",
    "overdue"
  ],
  "popularity": 66,
  "sizing": {
    "max": {
      "colSpan": 10,
      "rowSpan": 10
    },
    "min": {
      "colSpan": 3,
      "rowSpan": 4
    },
    "preferred": {
      "colSpan": 4,
      "rowSpan": 5
    }
  },
  "spec": {
    "elements": {
      "bdAmount": {
        "props": {
          "size": "sm",
          "text": {
            "$computed": "format_currency",
            "args": {
              "currency": {
                "$item": "CurrencyCode"
              },
              "value": {
                "$item": "AmountDue"
              }
            }
          },
          "weight": "semibold"
        },
        "type": "Text"
      },
      "bdContact": {
        "props": {
          "size": "sm",
          "text": {
            "$item": "Contact/Name"
          },
          "truncate": true,
          "weight": "medium"
        },
        "type": "Text"
      },
      "bdLeft": {
        "children": [
          "bdContact",
          "bdMeta"
        ],
        "props": {
          "gap": "none"
        },
        "type": "Stack"
      },
      "bdMeta": {
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "label": {
                "$computed": "xero-accounting_overdue_label",
                "args": {
                  "value": {
                    "$item": "DueDate"
                  }
                }
              },
              "num": {
                "$item": "InvoiceNumber"
              },
              "pattern": "{num} · {label}"
            }
          }
        },
        "type": "Caption"
      },
      "bdRow": {
        "children": [
          "bdLeft",
          "bdAmount"
        ],
        "on": {
          "click": {
            "action": "open_invoice_modal",
            "params": {
              "invoiceId": {
                "$computed": "identity",
                "args": {
                  "value": {
                    "$item": "InvoiceID"
                  }
                }
              }
            }
          }
        },
        "props": {
          "align": "center",
          "clickable": true,
          "gap": "sm",
          "hover": true,
          "justify": "between"
        },
        "type": "Row"
      },
      "body": {
        "children": [
          "loading",
          "empty",
          "buckets",
          "breakdown"
        ],
        "type": "Body"
      },
      "breakdown": {
        "children": [
          "breakdownHeader",
          "breakdownDivider",
          "breakdownList",
          "breakdownEmpty"
        ],
        "props": {
          "gap": "xs"
        },
        "type": "Stack",
        "visible": {
          "$state": "/ui/aged/selectedBucket"
        }
      },
      "breakdownClose": {
        "on": {
          "click": {
            "action": "setState",
            "params": {
              "statePath": "/ui/aged/selectedBucket",
              "value": ""
            }
          }
        },
        "props": {
          "ariaLabel": "Close breakdown",
          "icon": "X",
          "size": "sm",
          "tone": "muted"
        },
        "type": "IconButton"
      },
      "breakdownDivider": {
        "type": "Divider"
      },
      "breakdownEmpty": {
        "props": {
          "text": "No invoices in this bucket."
        },
        "type": "Caption",
        "visible": {
          "$state": "/ui/aged/breakdown/0",
          "not": true
        }
      },
      "breakdownHeader": {
        "children": [
          "breakdownTitle",
          "breakdownClose"
        ],
        "props": {
          "align": "center",
          "gap": "sm",
          "justify": "between"
        },
        "type": "Row"
      },
      "breakdownList": {
        "children": [
          "bdRow"
        ],
        "props": {
          "gap": "xs"
        },
        "repeat": {
          "key": "InvoiceID",
          "statePath": "/ui/aged/breakdown"
        },
        "type": "Stack"
      },
      "breakdownTitle": {
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "bucket": {
                "$state": "/ui/aged/selectedBucket"
              },
              "pattern": "{bucket} breakdown"
            }
          }
        },
        "type": "Caption"
      },
      "bucketDot": {
        "props": {
          "size": "sm",
          "tone": {
            "$item": "tone"
          }
        },
        "type": "Dot"
      },
      "bucketLabel": {
        "props": {
          "size": "sm",
          "text": {
            "$item": "key"
          },
          "weight": "medium"
        },
        "type": "Text"
      },
      "bucketLeft": {
        "children": [
          "bucketDot",
          "bucketTextStack"
        ],
        "props": {
          "align": "center",
          "gap": "sm",
          "grow": true
        },
        "type": "Row"
      },
      "bucketRight": {
        "children": [
          "bucketTotal"
        ],
        "props": {
          "align": "end",
          "gap": "none"
        },
        "type": "Stack"
      },
      "bucketRow": {
        "children": [
          "bucketLeft",
          "bucketRight"
        ],
        "on": {
          "click": {
            "action": "setState",
            "params": {
              "statePath": "/ui/aged/selectedBucket",
              "value": {
                "$computed": "identity",
                "args": {
                  "value": {
                    "$item": "key"
                  }
                }
              }
            }
          }
        },
        "props": {
          "align": "center",
          "clickable": true,
          "gap": "sm",
          "hover": true,
          "justify": "between",
          "selected": {
            "$computed": "equals",
            "args": {
              "a": {
                "$item": "key"
              },
              "b": {
                "$state": "/ui/aged/selectedBucket"
              }
            }
          }
        },
        "type": "Row"
      },
      "bucketSublabel": {
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "n": {
                "$item": "count"
              },
              "pattern": "{n} invoices"
            }
          }
        },
        "type": "Caption"
      },
      "bucketTextStack": {
        "children": [
          "bucketLabel",
          "bucketSublabel"
        ],
        "props": {
          "gap": "none"
        },
        "type": "Stack"
      },
      "bucketTotal": {
        "props": {
          "size": "sm",
          "text": {
            "$computed": "format_currency",
            "args": {
              "value": {
                "$item": "total"
              }
            }
          },
          "weight": "semibold"
        },
        "type": "Text"
      },
      "buckets": {
        "children": [
          "bucketRow"
        ],
        "props": {
          "gap": "xs"
        },
        "repeat": {
          "key": "key",
          "statePath": "/ui/aged/buckets"
        },
        "type": "Stack",
        "visible": {
          "$and": [
            {
              "$state": "/_loading/xero-accounting.list_invoices",
              "not": true
            },
            {
              "$state": "/xero-accounting/list_invoices/Invoices/0"
            }
          ]
        }
      },
      "card": {
        "children": [
          "header",
          "body"
        ],
        "type": "Card",
        "watch": {
          "/ui/aged/selectedBucket": {
            "action": "setState",
            "params": {
              "statePath": "/ui/aged/breakdown",
              "value": {
                "$computed": "xero-accounting_invoices_in_bucket",
                "args": {
                  "bucket": {
                    "$state": "/ui/aged/selectedBucket"
                  },
                  "value": {
                    "$state": "/xero-accounting/list_invoices/Invoices"
                  }
                }
              }
            }
          },
          "/xero-accounting/list_invoices/Invoices": {
            "action": "setState",
            "params": {
              "statePath": "/ui/aged/buckets",
              "value": {
                "$computed": "xero-accounting_age_buckets",
                "args": {
                  "value": {
                    "$state": "/xero-accounting/list_invoices/Invoices"
                  }
                }
              }
            }
          }
        }
      },
      "empty": {
        "props": {
          "message": "No outstanding invoices — you're all caught up."
        },
        "type": "Empty",
        "visible": {
          "$and": [
            {
              "$state": "/_loading/xero-accounting.list_invoices",
              "not": true
            },
            {
              "$state": "/xero-accounting/list_invoices/Invoices/0",
              "not": true
            }
          ]
        }
      },
      "header": {
        "children": [
          "titleGroup"
        ],
        "type": "Header"
      },
      "loading": {
        "children": [
          "sk1",
          "sk2",
          "sk3",
          "sk4",
          "sk5"
        ],
        "props": {
          "gap": "sm"
        },
        "type": "Stack",
        "visible": {
          "$state": "/_loading/xero-accounting.list_invoices"
        }
      },
      "sk1": {
        "props": {
          "height": "2rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "sk2": {
        "props": {
          "height": "2rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "sk3": {
        "props": {
          "height": "2rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "sk4": {
        "props": {
          "height": "2rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "sk5": {
        "props": {
          "height": "2rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "title": {
        "props": {
          "level": "h2",
          "text": "Aged Receivables"
        },
        "type": "Heading"
      },
      "titleGroup": {
        "children": [
          "titleIcon",
          "titleStack"
        ],
        "props": {
          "align": "start",
          "gap": "sm"
        },
        "type": "Row"
      },
      "titleIcon": {
        "props": {
          "name": "CalendarClock",
          "size": "sm",
          "tone": "warning"
        },
        "type": "Icon"
      },
      "titleStack": {
        "children": [
          "title",
          "totalEyebrow"
        ],
        "props": {
          "gap": "none"
        },
        "type": "Stack"
      },
      "totalEyebrow": {
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "amount": {
                "$computed": "format_currency",
                "args": {
                  "value": {
                    "$computed": "sum",
                    "args": {
                      "field": "AmountDue",
                      "value": {
                        "$state": "/xero-accounting/list_invoices/Invoices"
                      }
                    }
                  }
                }
              },
              "n": {
                "$computed": "count",
                "args": {
                  "value": {
                    "$state": "/xero-accounting/list_invoices/Invoices"
                  }
                }
              },
              "pattern": "{n} Open · {amount}"
            }
          }
        },
        "type": "Eyebrow"
      }
    },
    "root": "card"
  },
  "tags": [
    "xero",
    "receivables",
    "aging",
    "ar",
    "finance",
    "report"
  ],
  "title": "Aged Receivables"
}
