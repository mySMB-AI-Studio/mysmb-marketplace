{
  "id": "xero-tracking-breakdown",
  "title": "Tracking Categories",
  "description": "Tracking categories breakdown \u2014 dimension-based analysis.",
  "category": "finance",
  "tags": [
    "xero",
    "tracking",
    "categories",
    "finance",
    "report"
  ],
  "keywords": [
    "tracking",
    "categories",
    "dimension",
    "breakdown",
    "analysis",
    "segment"
  ],
  "connectorsUsed": [
    "xero-accounting"
  ],
  "popularity": 0,
  "sizing": {
    "preferred": {
      "colSpan": 3,
      "rowSpan": 2
    },
    "min": {
      "colSpan": 4,
      "rowSpan": 4
    },
    "max": {
      "colSpan": 12,
      "rowSpan": 10
    }
  },
  "dataProvider": {
    "mcp": "xero-accounting",
    "tool": "list_tracking_categories",
    "params": {}
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "children": [
          "header",
          "body"
        ],
        "watch": {
          "/xero-accounting/list_tracking_categories/TrackingCategories": {
            "action": "setState",
            "params": {
              "statePath": "/ui/trackingRows",
              "value": {
                "$computed": "flatten_nested",
                "args": {
                  "value": {
                    "$state": "/xero-accounting/list_tracking_categories/TrackingCategories"
                  },
                  "childField": "Options",
                  "parentKeys": [
                    "Name",
                    "Status",
                    "TrackingCategoryID"
                  ]
                }
              }
            }
          }
        }
      },
      "header": {
        "type": "Header",
        "children": [
          "titleGroup",
          "count"
        ]
      },
      "titleGroup": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center"
        },
        "children": [
          "titleIcon",
          "title"
        ]
      },
      "titleIcon": {
        "type": "Icon",
        "props": {
          "name": "Tags",
          "tone": "accent",
          "size": "sm"
        }
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "Tracking Categories",
          "level": "h2"
        }
      },
      "count": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{n} Categories",
              "n": {
                "$computed": "count",
                "args": {
                  "value": {
                    "$state": "/xero-accounting/list_tracking_categories/TrackingCategories"
                  }
                }
              }
            }
          }
        }
      },
      "body": {
        "type": "Body",
        "children": [
          "loading",
          "empty",
          "list"
        ]
      },
      "loading": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "s1",
          "s2",
          "s3"
        ],
        "visible": {
          "$state": "/_loading/xero-accounting.list_tracking_categories"
        }
      },
      "s1": {
        "type": "Skeleton",
        "props": {
          "height": "2rem",
          "rounded": "md"
        }
      },
      "s2": {
        "type": "Skeleton",
        "props": {
          "height": "2rem",
          "rounded": "md"
        }
      },
      "s3": {
        "type": "Skeleton",
        "props": {
          "height": "2rem",
          "rounded": "md"
        }
      },
      "empty": {
        "type": "Empty",
        "props": {
          "message": "No tracking categories configured."
        },
        "visible": {
          "$and": [
            {
              "$state": "/_loading/xero-accounting.list_tracking_categories",
              "not": true
            },
            {
              "$state": "/ui/trackingRows/0",
              "not": true
            }
          ]
        }
      },
      "list": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "children": [
          "row"
        ],
        "repeat": {
          "statePath": "/ui/trackingRows",
          "key": "TrackingOptionID"
        },
        "visible": {
          "$state": "/_loading/xero-accounting.list_tracking_categories",
          "not": true
        }
      },
      "row": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "start",
          "hover": true
        },
        "children": [
          "catBadge",
          "optName",
          "optStatus"
        ]
      },
      "catBadge": {
        "type": "Badge",
        "props": {
          "text": {
            "$item": "parent_Name"
          },
          "tone": "accent",
          "variant": "soft"
        }
      },
      "optName": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "Name"
          },
          "size": "sm",
          "weight": "medium",
          "truncate": true
        }
      },
      "optStatus": {
        "type": "Badge",
        "props": {
          "text": {
            "$item": "Status"
          },
          "tone": "muted",
          "variant": "soft"
        }
      }
    }
  },
  "status": "draft"
}
