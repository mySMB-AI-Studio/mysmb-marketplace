{
  "category": "finance",
  "connectorsUsed": [
    "xero-accounting"
  ],
  "dataProvider": {
    "kind": "tool",
    "mcp": "xero-accounting",
    "params": {
      "order": "UpdatedDateUTC DESC",
      "where": "Status==\"DRAFT\""
    },
    "tool": "list_receipts"
  },
  "description": "Employee expense receipts started in Xero but not yet submitted for reimbursement (Receipt Status==\"DRAFT\" — the draft stage sits one level below ExpenseClaim, which always starts at SUBMITTED). Flags receipts with no line items and a $0 total as empty — someone opened it and never finished — since that's the real action item, not just \"still a draft\".",
  "id": "xero-reimbursement-drafts",
  "keywords": [
    "reimbursement",
    "reimbursement draft",
    "expense claim",
    "receipts",
    "employee expenses",
    "draft"
  ],
  "popularity": 0,
  "sizing": {
    "max": {
      "colSpan": 8,
      "rowSpan": 10
    },
    "min": {
      "colSpan": 4,
      "rowSpan": 4
    },
    "preferred": {
      "colSpan": 5,
      "rowSpan": 6
    }
  },
  "spec": {
    "elements": {
      "amount": {
        "props": {
          "size": "sm",
          "text": {
            "$computed": "format_currency",
            "args": {
              "currency": {
                "$item": "currencyCode"
              },
              "value": {
                "$item": "amount"
              }
            }
          },
          "weight": "semibold"
        },
        "type": "Text"
      },
      "body": {
        "children": [
          "loading",
          "empty",
          "list"
        ],
        "type": "Body"
      },
      "card": {
        "children": [
          "header",
          "body"
        ],
        "type": "Card",
        "watch": {
          "/xero-accounting/list_receipts/Receipts": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/rows",
                "value": {
                  "$computed": "xero-accounting_reimbursement_draft_rows",
                  "args": {
                    "receipts": {
                      "$state": "/xero-accounting/list_receipts/Receipts"
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "count": {
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "n": {
                "$computed": "count",
                "args": {
                  "value": {
                    "$state": "/ui/rows"
                  }
                }
              },
              "pattern": "{n} Drafts"
            }
          }
        },
        "type": "Eyebrow"
      },
      "empty": {
        "props": {
          "message": "No draft reimbursements — all caught up."
        },
        "type": "Empty",
        "visible": {
          "$and": [
            {
              "$state": "/_loading/xero-accounting.list_receipts",
              "not": true
            },
            {
              "$state": "/ui/rows/0",
              "not": true
            }
          ]
        }
      },
      "header": {
        "children": [
          "titleGroup"
        ],
        "type": "Header"
      },
      "idBottom": {
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "age": {
                "$computed": "relative_time",
                "args": {
                  "value": {
                    "$item": "updatedDate"
                  }
                }
              },
              "pattern": "{user} · {age}",
              "user": {
                "$item": "userName"
              }
            }
          }
        },
        "type": "Caption"
      },
      "idTop": {
        "props": {
          "size": "sm",
          "text": {
            "$item": "payee"
          },
          "truncate": true,
          "weight": "medium"
        },
        "type": "Text"
      },
      "identity": {
        "children": [
          "idTop",
          "idBottom"
        ],
        "props": {
          "gap": "xs"
        },
        "type": "Stack"
      },
      "list": {
        "children": [
          "row"
        ],
        "props": {
          "gap": "xs"
        },
        "repeat": {
          "key": "id",
          "statePath": "/ui/rows"
        },
        "type": "Stack",
        "visible": {
          "$state": "/_loading/xero-accounting.list_receipts",
          "not": true
        }
      },
      "loading": {
        "children": [
          "sk1",
          "sk2",
          "sk3"
        ],
        "props": {
          "gap": "sm"
        },
        "type": "Stack",
        "visible": {
          "$state": "/_loading/xero-accounting.list_receipts"
        }
      },
      "priority": {
        "props": {
          "size": "sm",
          "tone": {
            "$cond": {
              "$item": "isEmpty"
            },
            "$else": "info",
            "$then": "warning"
          }
        },
        "type": "Dot"
      },
      "row": {
        "children": [
          "priority",
          "identity",
          "amount",
          "statusBadge"
        ],
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "target": "_blank",
              "url": {
                "$computed": "fmt",
                "args": {
                  "id": {
                    "$item": "id"
                  },
                  "pattern": "https://go.xero.com/Expenses/EditReceipt.aspx?ReceiptID={id}"
                }
              }
            }
          }
        },
        "props": {
          "align": "center",
          "clickable": true,
          "gap": "sm",
          "hover": true,
          "template": "auto minmax(0, 1fr) 5rem 5.5rem"
        },
        "type": "Row"
      },
      "sk1": {
        "props": {
          "height": "2.25rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "sk2": {
        "props": {
          "height": "2.25rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "sk3": {
        "props": {
          "height": "2.25rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "statusBadge": {
        "props": {
          "text": {
            "$cond": {
              "$item": "isEmpty"
            },
            "$else": "Draft",
            "$then": "Empty draft"
          },
          "tone": {
            "$cond": {
              "$item": "isEmpty"
            },
            "$else": "muted",
            "$then": "warning"
          },
          "variant": "soft"
        },
        "type": "Badge"
      },
      "title": {
        "props": {
          "level": "h2",
          "text": "Reimbursement Drafts"
        },
        "type": "Heading"
      },
      "titleGroup": {
        "children": [
          "titleIcon",
          "titleStack"
        ],
        "props": {
          "align": "start",
          "gap": "sm"
        },
        "type": "Row"
      },
      "titleIcon": {
        "props": {
          "name": "Receipt",
          "size": "sm",
          "tone": "info"
        },
        "type": "Icon"
      },
      "titleStack": {
        "children": [
          "title",
          "count"
        ],
        "props": {
          "gap": "none"
        },
        "type": "Stack"
      }
    },
    "root": "card"
  },
  "tags": [
    "xero",
    "reimbursement",
    "expenses",
    "receipts",
    "expense claims",
    "finance"
  ],
  "title": "Xero — Reimbursement Drafts"
}
