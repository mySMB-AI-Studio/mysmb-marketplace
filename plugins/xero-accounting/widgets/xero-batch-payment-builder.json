{
  "id": "xero-batch-payment-builder",
  "title": "Batch Payment Builder",
  "description": "Stage multiple payments into a batch file before export.",
  "category": "finance",
  "tags": [
    "xero",
    "payments",
    "batch",
    "finance"
  ],
  "keywords": [
    "batch",
    "payments",
    "payment",
    "bulk",
    "pay",
    "supplier"
  ],
  "connectorsUsed": [
    "xero-accounting"
  ],
  "popularity": 0,
  "sizing": {
    "preferred": {
      "colSpan": 5,
      "rowSpan": 4
    },
    "min": {
      "colSpan": 5,
      "rowSpan": 4
    },
    "max": {
      "colSpan": 14,
      "rowSpan": 12
    }
  },
  "dataProvider": {
    "mcp": "xero-accounting",
    "tool": "list_invoices",
    "params": {
      "statuses": "AUTHORISED",
      "where": "Type==\"ACCPAY\"",
      "order": "DueDate ASC"
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "children": [
          "header",
          "body"
        ],
        "watch": {
          "/xero-accounting/list_invoices/Invoices": {
            "action": "xero-accounting.list_accounts",
            "params": {
              "where": "Type==\"BANK\""
            }
          },
          "/xero-accounting/list_accounts/Accounts": {
            "action": "setState",
            "params": {
              "statePath": "/ui/batch/bankOptions",
              "value": {
                "$computed": "to_options",
                "args": {
                  "value": {
                    "$state": "/xero-accounting/list_accounts/Accounts"
                  },
                  "valueField": "AccountID",
                  "labelPattern": "{Name} ({Code})"
                }
              }
            }
          }
        }
      },
      "header": {
        "type": "Header",
        "children": [
          "titleGroup",
          "selCount"
        ]
      },
      "titleGroup": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center"
        },
        "children": [
          "titleIcon",
          "title"
        ]
      },
      "titleIcon": {
        "type": "Icon",
        "props": {
          "name": "ListChecks",
          "tone": "accent",
          "size": "sm"
        }
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "Batch payment",
          "level": "h2"
        }
      },
      "selCount": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{n} picked · {amt}",
              "n": {
                "$computed": "count_where",
                "args": {
                  "value": {
                    "$state": "/xero-accounting/list_invoices/Invoices"
                  },
                  "whereField": "_picked",
                  "equals": true
                }
              },
              "amt": {
                "$computed": "format_currency",
                "args": {
                  "value": {
                    "$computed": "sum",
                    "args": {
                      "value": {
                        "$state": "/xero-accounting/list_invoices/Invoices"
                      },
                      "field": "AmountDue",
                      "whereField": "_picked",
                      "equals": true
                    }
                  }
                }
              }
            }
          }
        }
      },
      "body": {
        "type": "Body",
        "children": [
          "fromRow",
          "loading",
          "empty",
          "list",
          "divider",
          "actions",
          "successBanner",
          "errorBanner"
        ]
      },
      "fromRow": {
        "type": "FormRow",
        "props": {
          "label": "Pay from"
        },
        "children": [
          "fromSelect"
        ]
      },
      "fromSelect": {
        "type": "Select",
        "props": {
          "value": {
            "$bindState": "/ui/batch/bankAccountId"
          },
          "options": {
            "$state": "/ui/batch/bankOptions"
          },
          "placeholder": "Choose bank account…"
        }
      },
      "loading": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "s1",
          "s2",
          "s3"
        ],
        "visible": {
          "$state": "/_loading/xero-accounting.list_invoices"
        }
      },
      "s1": {
        "type": "Skeleton",
        "props": {
          "height": "2.25rem",
          "rounded": "md"
        }
      },
      "s2": {
        "type": "Skeleton",
        "props": {
          "height": "2.25rem",
          "rounded": "md"
        }
      },
      "s3": {
        "type": "Skeleton",
        "props": {
          "height": "2.25rem",
          "rounded": "md"
        }
      },
      "empty": {
        "type": "Empty",
        "props": {
          "message": "No authorised bills to pay."
        },
        "visible": {
          "$and": [
            {
              "$state": "/_loading/xero-accounting.list_invoices",
              "not": true
            },
            {
              "$state": "/xero-accounting/list_invoices/Invoices/0",
              "not": true
            }
          ]
        }
      },
      "list": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "children": [
          "row"
        ],
        "repeat": {
          "statePath": "/xero-accounting/list_invoices/Invoices",
          "key": "InvoiceID"
        },
        "visible": {
          "$state": "/_loading/xero-accounting.list_invoices",
          "not": true
        }
      },
      "row": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center",
          "hover": true
        },
        "children": [
          "rowCheck",
          "rowLabel",
          "rowDue",
          "rowAmount"
        ]
      },
      "rowCheck": {
        "type": "Checkbox",
        "props": {
          "checked": {
            "$bindItem": "_picked"
          },
          "ariaLabel": "Pick for batch"
        },
        "on": {
          "toggle": {
            "action": "setState",
            "params": {
              "statePath": {
                "$item": "_picked"
              },
              "value": {
                "$cond": {
                  "$item": "_picked"
                },
                "$then": false,
                "$else": true
              }
            }
          }
        }
      },
      "rowLabel": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "children": [
          "rowTop",
          "rowBottom"
        ]
      },
      "rowTop": {
        "type": "Text",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{num} · {name}",
              "num": {
                "$item": "InvoiceNumber"
              },
              "name": {
                "$item": "Contact/Name"
              }
            }
          },
          "size": "sm",
          "weight": "medium",
          "truncate": true
        }
      },
      "rowBottom": {
        "type": "Caption",
        "props": {
          "text": {
            "$item": "Reference"
          }
        }
      },
      "rowDue": {
        "type": "Badge",
        "props": {
          "text": {
            "$computed": "xero-accounting_overdue_label",
            "args": {
              "value": {
                "$item": "DueDate"
              }
            }
          },
          "tone": {
            "$computed": "xero-accounting_overdue_tone",
            "args": {
              "value": {
                "$item": "DueDate"
              }
            }
          },
          "variant": "soft"
        }
      },
      "rowAmount": {
        "type": "Text",
        "props": {
          "text": {
            "$computed": "format_currency",
            "args": {
              "value": {
                "$item": "AmountDue"
              },
              "currency": {
                "$item": "CurrencyCode"
              }
            }
          },
          "weight": "semibold",
          "size": "sm"
        }
      },
      "divider": {
        "type": "Divider"
      },
      "actions": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "justify": "end"
        },
        "children": [
          "payBtn"
        ]
      },
      "payBtn": {
        "type": "Button",
        "props": {
          "label": "Create batch payment",
          "variant": "primary",
          "size": "sm",
          "leadingIcon": "CreditCard"
        },
        "on": {
          "click": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/batch/saved",
                "value": ""
              }
            },
            {
              "action": "xero-accounting.create_batch_payment",
              "params": {
                "batchPayment": {
                  "Account": {
                    "AccountID": {
                      "$state": "/ui/batch/bankAccountId"
                    }
                  },
                  "Date": {
                    "$computed": "xero-accounting_format_date",
                    "args": {
                      "value": null,
                      "format": "iso"
                    }
                  }
                }
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/batch/saved",
                "value": {
                  "$cond": {
                    "$state": "/_errors/xero-accounting.create_batch_payment"
                  },
                  "$then": "",
                  "$else": true
                }
              }
            }
          ]
        }
      },
      "successBanner": {
        "type": "Section",
        "props": {
          "variant": "muted"
        },
        "children": [
          "successRow"
        ],
        "visible": {
          "$state": "/ui/batch/saved"
        }
      },
      "successRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center"
        },
        "children": [
          "successIcon",
          "successText"
        ]
      },
      "successIcon": {
        "type": "Icon",
        "props": {
          "name": "CheckCircle2",
          "tone": "success",
          "size": "sm"
        }
      },
      "successText": {
        "type": "Text",
        "props": {
          "text": "Batch payment created.",
          "size": "sm",
          "tone": "success"
        }
      },
      "errorBanner": {
        "type": "Section",
        "props": {
          "variant": "bordered"
        },
        "children": [
          "errorRow"
        ],
        "visible": {
          "$state": "/_errors/xero-accounting.create_batch_payment"
        }
      },
      "errorRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center"
        },
        "children": [
          "errorIcon",
          "errorText"
        ]
      },
      "errorIcon": {
        "type": "Icon",
        "props": {
          "name": "AlertTriangle",
          "tone": "destructive",
          "size": "sm"
        }
      },
      "errorText": {
        "type": "Text",
        "props": {
          "text": {
            "$state": "/_errors/xero-accounting.create_batch_payment"
          },
          "size": "sm",
          "tone": "destructive"
        }
      }
    }
  },
  "status": "draft"
}
