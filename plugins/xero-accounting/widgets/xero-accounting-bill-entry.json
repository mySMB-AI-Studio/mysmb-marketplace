{
  "id": "xero-accounting-bill-entry",
  "title": "Bill Entry",
  "description": "Record a new supplier bill as a Xero draft — pick the supplier, date, and line items (account + tax rate per line), with inline validation before it can be submitted. Always creates the bill as DRAFT in Xero; nothing is authorised or paid from here. Never resolves its own xero_tenant_id — relies on the dashboard's org switcher to inject the correct tenant, same as every other xero-accounting tile.",
  "category": "accounting",
  "tags": ["xero", "accounting", "bills", "accounts-payable", "data-entry"],
  "keywords": ["bill entry", "record bill", "draft bill", "create bill", "accounts payable", "xero", "supplier bill"],
  "connectorsUsed": ["xero-accounting"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 8, "rowSpan": 10 },
    "min": { "colSpan": 6, "rowSpan": 8 },
    "max": { "colSpan": 12, "rowSpan": 16 }
  },
  "dataProvider": {
    "kind": "tool",
    "mcp": "xero-accounting",
    "tool": "list_contacts",
    "params": { "where": "ContactStatus==\"ACTIVE\"&&IsSupplier==true", "order": "Name" }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": ["header", "divider1", "body", "divider2", "footer"],
        "watch": {
          "/xero-accounting/list_contacts/Contacts": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/contactOptions",
                "value": {
                  "$computed": "to_options",
                  "args": {
                    "value": { "$state": "/xero-accounting/list_contacts/Contacts" },
                    "valueField": "ContactID",
                    "labelField": "Name"
                  }
                }
              }
            }
          ],
          "/ui/contactOptions": [
            { "action": "xero-accounting.list_accounts", "params": { "where": "Status==\"ACTIVE\"" } }
          ],
          "/xero-accounting/list_accounts/Accounts": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/accountOptions",
                "value": {
                  "$computed": "to_options",
                  "args": {
                    "value": { "$state": "/xero-accounting/list_accounts/Accounts" },
                    "valueField": "Code",
                    "labelField": "Name"
                  }
                }
              }
            }
          ],
          "/ui/accountOptions": [
            { "action": "xero-accounting.list_tax_rates", "params": {} }
          ],
          "/xero-accounting/list_tax_rates/TaxRates": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/taxOptions",
                "value": {
                  "$computed": "to_options",
                  "args": {
                    "value": { "$state": "/xero-accounting/list_tax_rates/TaxRates" },
                    "valueField": "TaxType",
                    "labelField": "Name"
                  }
                }
              }
            }
          ],
          "/ui/taxOptions": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/taxRateByType",
                "value": {
                  "$computed": "xero-accounting_bill_entry_tax_rate_lookup",
                  "args": { "taxRates": { "$state": "/xero-accounting/list_tax_rates/TaxRates" } }
                }
              }
            }
          ],
          "/ui/form/contactId": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/supplierBalances",
                "value": {
                  "$computed": "xero-accounting_bill_entry_supplier_balances",
                  "args": {
                    "contacts": { "$state": "/xero-accounting/list_contacts/Contacts" },
                    "contactId": { "$state": "/ui/form/contactId" }
                  }
                }
              }
            }
          ],
          "/xero-accounting/create_invoice/Invoices": [
            {
              "action": "setState",
              "params": { "statePath": "/ui/lastCreatedInvoiceId", "value": { "$state": "/xero-accounting/create_invoice/Invoices/0/InvoiceID" } }
            }
          ],
          "/ui/lastCreatedInvoiceId": [
            {
              "action": "setState",
              "params": { "statePath": "/ui/lineItems", "value": [] }
            }
          ]
        }
      },

      "header": { "type": "Header", "props": {}, "children": ["titleGroup"] },
      "titleGroup": { "type": "Row", "props": { "gap": "sm", "align": "center" }, "children": ["titleIcon", "titleStack"] },
      "titleIcon": { "type": "Icon", "props": { "name": "FilePlus2", "tone": "accent", "size": "sm" } },
      "titleStack": { "type": "Stack", "props": { "gap": "none" }, "children": ["title", "eyebrow"] },
      "title": { "type": "Heading", "props": { "text": "Bill Entry", "level": "h2" } },
      "eyebrow": { "type": "Eyebrow", "props": { "text": "Xero Accounting · record a draft bill" } },

      "divider1": { "type": "Divider", "props": {} },

      "body": { "type": "Body", "props": {}, "children": ["successBanner", "errorBanner", "formStack"] },

      "successBanner": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["successIcon", "successText", "successLink"],
        "visible": { "$state": "/ui/lastCreatedInvoiceId" }
      },
      "successIcon": { "type": "Icon", "props": { "name": "CheckCircle2", "tone": "success", "size": "sm" } },
      "successText": { "type": "Caption", "props": { "text": "Draft bill created.", "tone": "success" } },
      "successLink": {
        "type": "Button",
        "props": { "label": "View in Xero", "size": "sm", "variant": "ghost", "leadingIcon": "ExternalLink" },
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "url": { "$template": "https://go.xero.com/AccountsPayable/View.aspx?InvoiceID=${/ui/lastCreatedInvoiceId}" },
              "target": "_blank"
            }
          }
        }
      },

      "errorBanner": {
        "type": "Caption",
        "props": {
          "text": { "$template": "Couldn't create the bill: ${/_errors/xero-accounting.create_invoice}" },
          "tone": "destructive"
        },
        "visible": { "$state": "/_errors/xero-accounting.create_invoice" }
      },

      "formStack": { "type": "Stack", "props": { "gap": "sm" }, "children": ["supplierRow", "supplierBalanceRow", "datesRow", "referenceRow", "lineItemsSection", "totalsRow", "validationRow", "submitRow"] },

      "supplierRow": {
        "type": "FormRow",
        "props": { "label": "Supplier" },
        "children": ["supplierSelect"]
      },
      "supplierSelect": {
        "type": "Select",
        "props": {
          "value": { "$bindState": "/ui/form/contactId" },
          "options": { "$state": "/ui/contactOptions" },
          "placeholder": "Select a supplier…",
          "size": "sm"
        }
      },

      "supplierBalanceRow": {
        "type": "Row",
        "props": { "gap": "lg", "align": "center" },
        "children": ["weOweBlock", "theyOweBlock"],
        "visible": { "$state": "/ui/form/contactId" }
      },
      "weOweBlock": { "type": "Stack", "props": { "gap": "none" }, "children": ["weOweLabel", "weOweValue", "weOweOverdueCaption"] },
      "weOweLabel": { "type": "Caption", "props": { "text": "We owe them", "tone": "muted" } },
      "weOweValue": {
        "type": "Text",
        "props": {
          "text": { "$state": "/ui/supplierBalances/weOwe" },
          "tone": { "$state": "/ui/supplierBalances/weOweTone" },
          "weight": "semibold",
          "size": "sm"
        }
      },
      "weOweOverdueCaption": {
        "type": "Caption",
        "props": {
          "text": { "$computed": "fmt", "args": { "pattern": "{amt} overdue", "amt": { "$state": "/ui/supplierBalances/weOweOverdue" } } },
          "tone": "destructive"
        },
        "visible": { "$state": "/ui/supplierBalances/weOweIsOverdue" }
      },
      "theyOweBlock": { "type": "Stack", "props": { "gap": "none" }, "children": ["theyOweLabel", "theyOweValue", "theyOweOverdueCaption"] },
      "theyOweLabel": { "type": "Caption", "props": { "text": "They owe us", "tone": "muted" } },
      "theyOweValue": {
        "type": "Text",
        "props": {
          "text": { "$state": "/ui/supplierBalances/theyOwe" },
          "tone": { "$state": "/ui/supplierBalances/theyOweTone" },
          "weight": "semibold",
          "size": "sm"
        }
      },
      "theyOweOverdueCaption": {
        "type": "Caption",
        "props": {
          "text": { "$computed": "fmt", "args": { "pattern": "{amt} overdue", "amt": { "$state": "/ui/supplierBalances/theyOweOverdue" } } },
          "tone": "warning"
        },
        "visible": { "$state": "/ui/supplierBalances/theyOweIsOverdue" }
      },

      "datesRow": {
        "type": "Row",
        "props": { "gap": "md" },
        "children": ["dateField", "dueDateField"]
      },
      "dateField": {
        "type": "FormRow",
        "props": { "label": "Date" },
        "children": ["dateInput"]
      },
      "dateInput": {
        "type": "DateInput",
        "props": { "value": { "$bindState": "/ui/form/date" }, "size": "sm" }
      },
      "dueDateField": {
        "type": "FormRow",
        "props": { "label": "Due date" },
        "children": ["dueDateInput"]
      },
      "dueDateInput": {
        "type": "DateInput",
        "props": { "value": { "$bindState": "/ui/form/dueDate" }, "size": "sm" }
      },

      "referenceRow": {
        "type": "FormRow",
        "props": { "label": "Reference", "hint": "Optional — e.g. supplier invoice number" },
        "children": ["referenceInput"]
      },
      "referenceInput": {
        "type": "TextInput",
        "props": { "value": { "$bindState": "/ui/form/reference" }, "placeholder": "INV-1234", "size": "sm" }
      },

      "lineItemsSection": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["lineItemsHeaderRow", "lineItemsColHeader", "lineItemsList", "addLineRow"]
      },
      "lineItemsHeaderRow": {
        "type": "Caption",
        "props": { "text": "Line items", "tone": "muted" }
      },
      "lineItemsColHeader": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center", "template": "minmax(0, 1fr) 4.5rem 6rem 6rem 2rem" },
        "children": ["colDesc", "colQty", "colUnit", "colLineTotal", "colRemoveSpacer"]
      },
      "colDesc": { "type": "Caption", "props": { "text": "Description" } },
      "colQty": { "type": "Caption", "props": { "text": "Qty" } },
      "colUnit": { "type": "Caption", "props": { "text": "Unit price" } },
      "colLineTotal": { "type": "Caption", "props": { "text": "Line total" } },
      "colRemoveSpacer": { "type": "Caption", "props": { "text": "" } },

      "lineItemsList": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["lineItemCard"],
        "repeat": { "statePath": "/ui/lineItems", "key": "id" }
      },
      "lineItemCard": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["lineRow", "lineRow2"]
      },
      "lineRow": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center", "template": "minmax(0, 1fr) 4.5rem 6rem 6rem 2rem" },
        "children": ["lineDesc", "lineQty", "lineUnit", "lineTotal", "lineRemoveBtn"]
      },
      "lineDesc": {
        "type": "TextInput",
        "props": { "value": { "$bindItem": "description" }, "placeholder": "Item or service", "size": "sm" }
      },
      "lineQty": {
        "type": "NumberInput",
        "props": { "value": { "$bindItem": "quantity" }, "min": 0, "step": 1, "size": "sm" }
      },
      "lineUnit": {
        "type": "NumberInput",
        "props": { "value": { "$bindItem": "unitAmount" }, "min": 0, "step": 0.01, "size": "sm" }
      },
      "lineTotal": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "xero-accounting_bill_entry_line_total",
            "args": { "quantity": { "$item": "quantity" }, "unitAmount": { "$item": "unitAmount" } }
          },
          "tone": "muted"
        }
      },
      "lineRemoveBtn": {
        "type": "IconButton",
        "props": { "icon": "X", "size": "sm", "variant": "ghost", "ariaLabel": "Remove line" },
        "on": {
          "click": {
            "action": "list_remove_by_field",
            "params": { "listPaths": "/ui/lineItems", "field": "id", "value": { "$bindItem": "id" } }
          }
        }
      },
      "lineRow2": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center", "template": "minmax(0, 1fr) minmax(0, 1fr) 6rem 2rem" },
        "children": ["lineAccount", "lineTax", "lineTaxAmount", "lineRow2Spacer"]
      },
      "lineAccount": {
        "type": "Select",
        "props": { "value": { "$bindItem": "accountCode" }, "options": { "$state": "/ui/accountOptions" }, "placeholder": "Account…", "size": "sm" }
      },
      "lineTax": {
        "type": "Select",
        "props": { "value": { "$bindItem": "taxType" }, "options": { "$state": "/ui/taxOptions" }, "placeholder": "Tax rate…", "size": "sm" }
      },
      "lineTaxAmount": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "xero-accounting_bill_entry_line_tax",
            "args": {
              "quantity": { "$item": "quantity" },
              "unitAmount": { "$item": "unitAmount" },
              "taxType": { "$item": "taxType" },
              "taxRateMap": { "$state": "/ui/taxRateByType" }
            }
          },
          "tone": "muted"
        }
      },
      "lineRow2Spacer": { "type": "Caption", "props": { "text": "" } },

      "addLineRow": {
        "type": "Row",
        "props": { "justify": "start" },
        "children": ["addLineBtn"]
      },
      "addLineBtn": {
        "type": "Button",
        "props": { "label": "Add line", "leadingIcon": "Plus", "size": "sm", "variant": "secondary" },
        "on": {
          "click": {
            "action": "setState",
            "params": {
              "statePath": "/ui/lineItems",
              "value": { "$computed": "xero-accounting_bill_entry_add_line", "args": { "lines": { "$state": "/ui/lineItems" } } }
            }
          }
        }
      },

      "totalsRow": {
        "type": "Row",
        "props": { "justify": "end", "gap": "xs", "align": "center" },
        "children": ["totalsLabel", "totalsValue"],
        "visible": { "$state": "/ui/lineItems/0" }
      },
      "totalsLabel": { "type": "Caption", "props": { "text": "Total", "tone": "muted" } },
      "totalsValue": {
        "type": "Text",
        "props": {
          "text": { "$computed": "xero-accounting_bill_entry_grand_total", "args": { "lines": { "$state": "/ui/lineItems" } } },
          "weight": "semibold",
          "size": "sm"
        }
      },

      "validationRow": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "xero-accounting_bill_entry_validation_message",
            "args": {
              "contactId": { "$state": "/ui/form/contactId" },
              "date": { "$state": "/ui/form/date" },
              "lines": { "$state": "/ui/lineItems" }
            }
          },
          "tone": "warning"
        },
        "visible": {
          "$computed": "xero-accounting_bill_entry_is_invalid",
          "args": {
            "contactId": { "$state": "/ui/form/contactId" },
            "date": { "$state": "/ui/form/date" },
            "lines": { "$state": "/ui/lineItems" }
          }
        }
      },

      "submitRow": { "type": "Row", "props": { "justify": "end" }, "children": ["submitBtn"] },
      "submitBtn": {
        "type": "Button",
        "props": {
          "label": "Create Draft Bill",
          "leadingIcon": "FilePlus2",
          "tone": "brand",
          "variant": "primary",
          "disabled": {
            "$computed": "xero-accounting_bill_entry_is_invalid",
            "args": {
              "contactId": { "$state": "/ui/form/contactId" },
              "date": { "$state": "/ui/form/date" },
              "lines": { "$state": "/ui/lineItems" }
            }
          }
        },
        "on": {
          "click": {
            "action": "xero-accounting.create_invoice",
            "params": {
              "invoice": {
                "$computed": "xero-accounting_bill_entry_build_payload",
                "args": {
                  "contactId": { "$state": "/ui/form/contactId" },
                  "date": { "$state": "/ui/form/date" },
                  "dueDate": { "$state": "/ui/form/dueDate" },
                  "reference": { "$state": "/ui/form/reference" },
                  "lines": { "$state": "/ui/lineItems" }
                }
              }
            }
          }
        }
      },

      "divider2": { "type": "Divider", "props": {} },
      "footer": {
        "type": "Row",
        "props": { "justify": "end", "gap": "xs" },
        "children": ["viewAllBillsBtn", "openXeroBtn"]
      },
      "viewAllBillsBtn": {
        "type": "Button",
        "props": { "label": "View All Bills", "tone": "brand", "variant": "ghost", "size": "sm", "leadingIcon": "ExternalLink" },
        "on": {
          "click": { "action": "open_url", "params": { "url": "https://go.xero.com/AccountsPayable/", "target": "_blank" } }
        }
      },
      "openXeroBtn": {
        "type": "Button",
        "props": { "label": "Open Xero", "tone": "brand", "variant": "ghost", "size": "sm", "leadingIcon": "ExternalLink" },
        "on": {
          "click": { "action": "open_url", "params": { "url": "https://go.xero.com/", "target": "_blank" } }
        }
      }
    }
  },
  "status": "published"
}
