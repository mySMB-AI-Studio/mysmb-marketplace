{
  "category": "finance",
  "connectorsUsed": [
    "xero-accounting"
  ],
  "dataProvider": {
    "kind": "tool",
    "mcp": "xero-accounting",
    "tool": "get_xero_bank_balance_difference",
    "params": {}
  },
  "description": "Each Xero bank balance with the change since the previous business day (Friday on a Monday) — green when up, red when down — and the transactions behind it. Click an account to see why it changed.",
  "id": "xero-bank-balance-difference",
  "keywords": [
    "bank",
    "cash",
    "balance",
    "difference",
    "change",
    "movement",
    "yesterday",
    "previous day",
    "daily",
    "transactions",
    "accounts"
  ],
  "popularity": 0,
  "sizing": {
    "max": {
      "colSpan": 12,
      "rowSpan": 14
    },
    "min": {
      "colSpan": 6,
      "rowSpan": 6
    },
    "preferred": {
      "colSpan": 6,
      "rowSpan": 9
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "children": [
          "header",
          "body"
        ],
        "watch": {
          "/xero-accounting/get_xero_bank_balance_difference/defaultAccountId": {
            "action": "setState",
            "params": {
              "statePath": "/ui/bbd/selectedId",
              "value": {
                "$state": "/xero-accounting/get_xero_bank_balance_difference/defaultAccountId"
              }
            }
          },
          "/xero-accounting/get_xero_bank_balance_difference/accounts": {
            "action": "setState",
            "params": {
              "statePath": "/ui/bbd/view",
              "value": {
                "$computed": "filter_by",
                "args": {
                  "value": {
                    "$state": "/xero-accounting/get_xero_bank_balance_difference/accounts"
                  },
                  "field": "accountId",
                  "equals": {
                    "$state": "/ui/bbd/selectedId"
                  }
                }
              }
            }
          },
          "/ui/bbd/selectedId": {
            "action": "setState",
            "params": {
              "statePath": "/ui/bbd/view",
              "value": {
                "$computed": "filter_by",
                "args": {
                  "value": {
                    "$state": "/xero-accounting/get_xero_bank_balance_difference/accounts"
                  },
                  "field": "accountId",
                  "equals": {
                    "$state": "/ui/bbd/selectedId"
                  }
                }
              }
            }
          }
        }
      },
      "header": {
        "type": "Header",
        "children": [
          "titleGroup"
        ]
      },
      "titleGroup": {
        "type": "Row",
        "props": {
          "align": "start",
          "gap": "sm"
        },
        "children": [
          "titleIcon",
          "titleStack"
        ]
      },
      "titleIcon": {
        "type": "Icon",
        "props": {
          "name": "Landmark",
          "size": "sm",
          "tone": "accent"
        }
      },
      "titleStack": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "children": [
          "title",
          "eyebrow"
        ]
      },
      "title": {
        "type": "Heading",
        "props": {
          "level": "h2",
          "text": "Bank Balance Change"
        }
      },
      "eyebrow": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$state": "/xero-accounting/get_xero_bank_balance_difference/summary/eyebrow"
          }
        },
        "visible": {
          "$state": "/_loading/xero-accounting.get_xero_bank_balance_difference",
          "not": true
        }
      },
      "body": {
        "type": "Body",
        "children": [
          "loading",
          "empty",
          "content"
        ]
      },
      "loading": {
        "type": "Stack",
        "props": {
          "gap": "md"
        },
        "children": [
          "sAll",
          "loadingGrid",
          "sList"
        ],
        "visible": {
          "$state": "/_loading/xero-accounting.get_xero_bank_balance_difference"
        }
      },
      "sAll": {
        "type": "Skeleton",
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        }
      },
      "loadingGrid": {
        "type": "Grid",
        "props": {
          "cols": 2,
          "gap": "md"
        },
        "children": [
          "s1",
          "s2"
        ]
      },
      "s1": {
        "type": "Skeleton",
        "props": {
          "height": "6rem",
          "rounded": "md"
        }
      },
      "s2": {
        "type": "Skeleton",
        "props": {
          "height": "6rem",
          "rounded": "md"
        }
      },
      "sList": {
        "type": "Skeleton",
        "props": {
          "height": "10rem",
          "rounded": "md"
        }
      },
      "empty": {
        "type": "Empty",
        "props": {
          "message": "No bank accounts configured in Xero."
        },
        "visible": {
          "$and": [
            {
              "$state": "/_loading/xero-accounting.get_xero_bank_balance_difference",
              "not": true
            },
            {
              "$state": "/xero-accounting/get_xero_bank_balance_difference/accounts/0",
              "not": true
            }
          ]
        }
      },
      "content": {
        "type": "Stack",
        "props": {
          "gap": "md"
        },
        "children": [
          "allAccounts",
          "tiles",
          "divider1",
          "why",
          "divider3",
          "footer"
        ],
        "visible": {
          "$and": [
            {
              "$state": "/_loading/xero-accounting.get_xero_bank_balance_difference",
              "not": true
            },
            {
              "$state": "/xero-accounting/get_xero_bank_balance_difference/accounts/0"
            }
          ]
        }
      },
      "allAccounts": {
        "type": "Section",
        "props": {
          "variant": "muted"
        },
        "children": [
          "allRow"
        ]
      },
      "allRow": {
        "type": "Row",
        "props": {
          "align": "center",
          "justify": "between",
          "gap": "sm"
        },
        "children": [
          "allLabel",
          "allBadge"
        ]
      },
      "allLabel": {
        "type": "Row",
        "props": {
          "align": "baseline",
          "gap": "xs"
        },
        "children": [
          "allTitle",
          "allCaption"
        ]
      },
      "allTitle": {
        "type": "Text",
        "props": {
          "text": "All accounts",
          "weight": "medium"
        }
      },
      "allCaption": {
        "type": "Caption",
        "props": {
          "text": {
            "$state": "/xero-accounting/get_xero_bank_balance_difference/summary/allAccountsCaption"
          }
        }
      },
      "allBadge": {
        "type": "Badge",
        "props": {
          "text": {
            "$state": "/xero-accounting/get_xero_bank_balance_difference/summary/totalBadgeText"
          },
          "tone": {
            "$state": "/xero-accounting/get_xero_bank_balance_difference/summary/totalTone"
          },
          "variant": "soft"
        }
      },
      "tiles": {
        "type": "Grid",
        "props": {
          "cols": 2,
          "gap": "md"
        },
        "children": [
          "tile"
        ],
        "repeat": {
          "statePath": "/xero-accounting/get_xero_bank_balance_difference/accounts",
          "key": "accountId"
        }
      },
      "tile": {
        "type": "Row",
        "props": {
          "template": "1fr",
          "clickable": true,
          "hover": true,
          "selected": {
            "$computed": "equals",
            "args": {
              "a": {
                "$item": "accountId"
              },
              "b": {
                "$state": "/ui/bbd/selectedId"
              }
            }
          }
        },
        "children": [
          "tileBox"
        ],
        "on": {
          "click": {
            "action": "setState",
            "params": {
              "statePath": "/ui/bbd/selectedId",
              "value": {
                "$computed": "identity",
                "args": {
                  "value": {
                    "$item": "accountId"
                  }
                }
              }
            }
          }
        }
      },
      "tileBox": {
        "type": "Section",
        "props": {
          "variant": "bordered"
        },
        "children": [
          "tileHeader",
          "tileBalance",
          "tileBadgeRow",
          "tileWas"
        ]
      },
      "tileHeader": {
        "type": "Row",
        "props": {
          "align": "center",
          "gap": "sm"
        },
        "children": [
          "tileIcon",
          "tileName"
        ]
      },
      "tileIcon": {
        "type": "Icon",
        "props": {
          "name": "Banknote",
          "size": "sm",
          "tone": "success"
        }
      },
      "tileName": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "name"
          },
          "truncate": true,
          "weight": "medium"
        }
      },
      "tileBalance": {
        "type": "Stat",
        "props": {
          "size": "sm",
          "value": {
            "$item": "balanceText"
          }
        }
      },
      "tileBadgeRow": {
        "type": "Row",
        "props": {
          "gap": "xs"
        },
        "children": [
          "tileBadge"
        ]
      },
      "tileBadge": {
        "type": "Badge",
        "props": {
          "text": {
            "$item": "badgeText"
          },
          "tone": {
            "$item": "tone"
          },
          "variant": "soft"
        }
      },
      "tileWas": {
        "type": "Caption",
        "props": {
          "text": {
            "$item": "wasText"
          }
        }
      },
      "divider1": {
        "type": "Divider"
      },
      "why": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "whyHeader",
          "txnEmpty",
          "txnList",
          "divider2",
          "recon"
        ]
      },
      "whyHeader": {
        "type": "Row",
        "props": {
          "align": "center",
          "justify": "between",
          "gap": "sm"
        },
        "children": [
          "whyTitle",
          "whyCount"
        ]
      },
      "whyTitle": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$state": "/ui/bbd/view/0/whyTitle"
          }
        }
      },
      "whyCount": {
        "type": "Caption",
        "props": {
          "text": {
            "$state": "/ui/bbd/view/0/transactionCountText"
          }
        }
      },
      "txnEmpty": {
        "type": "Empty",
        "props": {
          "message": "No transactions since the previous business day."
        },
        "visible": {
          "$state": "/ui/bbd/view/0/transactions/0",
          "not": true
        }
      },
      "txnList": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "children": [
          "txnRow"
        ],
        "repeat": {
          "statePath": "/ui/bbd/view/0/transactions",
          "key": "id"
        }
      },
      "txnRow": {
        "type": "Row",
        "props": {
          "align": "center",
          "justify": "between",
          "gap": "sm",
          "hover": true,
          "clickable": true
        },
        "children": [
          "txnText",
          "txnAmount"
        ],
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "url": {
                "$computed": "identity",
                "args": {
                  "value": {
                    "$item": "url"
                  }
                }
              },
              "target": "_blank"
            }
          }
        }
      },
      "txnText": {
        "type": "Stack",
        "props": {
          "gap": "none",
          "grow": true
        },
        "children": [
          "txnName",
          "txnMeta"
        ]
      },
      "txnName": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "title"
          },
          "truncate": true,
          "weight": "medium"
        }
      },
      "txnMeta": {
        "type": "Caption",
        "props": {
          "text": {
            "$item": "subtitle"
          }
        }
      },
      "txnAmount": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "amountText"
          },
          "tone": {
            "$item": "tone"
          },
          "weight": "medium"
        }
      },
      "divider2": {
        "type": "Divider"
      },
      "recon": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "children": [
          "closing",
          "moneyIn",
          "moneyOut",
          "reconDivider",
          "now"
        ]
      },
      "closing": {
        "type": "Row",
        "props": {
          "align": "center",
          "justify": "between",
          "gap": "sm"
        },
        "children": [
          "closingLabel",
          "closingValue"
        ]
      },
      "closingLabel": {
        "type": "Text",
        "props": {
          "text": {
            "$state": "/ui/bbd/view/0/closingLabel"
          }
        }
      },
      "closingValue": {
        "type": "Text",
        "props": {
          "text": {
            "$state": "/ui/bbd/view/0/previousBalanceText"
          },
          "weight": "medium"
        }
      },
      "moneyIn": {
        "type": "Row",
        "props": {
          "align": "center",
          "justify": "between",
          "gap": "sm"
        },
        "children": [
          "moneyInLabel",
          "moneyInValue"
        ]
      },
      "moneyInLabel": {
        "type": "Text",
        "props": {
          "text": "Money in"
        }
      },
      "moneyInValue": {
        "type": "Text",
        "props": {
          "text": {
            "$state": "/ui/bbd/view/0/moneyInText"
          },
          "weight": "medium",
          "tone": {
            "$cond": {
              "$state": "/ui/bbd/view/0/moneyInText",
              "eq": "A$0.00"
            },
            "$then": "muted",
            "$else": "success"
          }
        }
      },
      "moneyOut": {
        "type": "Row",
        "props": {
          "align": "center",
          "justify": "between",
          "gap": "sm"
        },
        "children": [
          "moneyOutLabel",
          "moneyOutValue"
        ]
      },
      "moneyOutLabel": {
        "type": "Text",
        "props": {
          "text": "Money out"
        }
      },
      "moneyOutValue": {
        "type": "Text",
        "props": {
          "text": {
            "$state": "/ui/bbd/view/0/moneyOutText"
          },
          "weight": "medium",
          "tone": {
            "$cond": {
              "$state": "/ui/bbd/view/0/moneyOutText",
              "eq": "A$0.00"
            },
            "$then": "muted",
            "$else": "destructive"
          }
        }
      },
      "reconDivider": {
        "type": "Divider"
      },
      "now": {
        "type": "Row",
        "props": {
          "align": "center",
          "justify": "between",
          "gap": "sm"
        },
        "children": [
          "nowLabel",
          "nowValue"
        ]
      },
      "nowLabel": {
        "type": "Text",
        "props": {
          "text": "Balance now",
          "weight": "medium"
        }
      },
      "nowValue": {
        "type": "Text",
        "props": {
          "text": {
            "$state": "/ui/bbd/view/0/balanceText"
          },
          "weight": "medium"
        }
      },
      "divider3": {
        "type": "Divider"
      },
      "footer": {
        "type": "Row",
        "props": {
          "align": "center",
          "justify": "between",
          "gap": "sm"
        },
        "children": [
          "footerText",
          "footerOpen"
        ]
      },
      "footerText": {
        "type": "Caption",
        "props": {
          "text": {
            "$state": "/xero-accounting/get_xero_bank_balance_difference/summary/updatedText"
          }
        }
      },
      "footerOpen": {
        "type": "Row",
        "props": {
          "align": "center",
          "gap": "xs",
          "hover": true,
          "clickable": true
        },
        "children": [
          "footerOpenText",
          "footerOpenIcon"
        ],
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "url": {
                "$state": "/xero-accounting/get_xero_bank_balance_difference/summary/xeroUrl"
              },
              "target": "_blank"
            }
          }
        }
      },
      "footerOpenText": {
        "type": "Text",
        "props": {
          "text": "Open in Xero",
          "weight": "medium"
        }
      },
      "footerOpenIcon": {
        "type": "Icon",
        "props": {
          "name": "ArrowRight",
          "size": "sm"
        }
      }
    }
  },
  "tags": [
    "xero",
    "bank",
    "accounts",
    "cash",
    "finance"
  ],
  "title": "Bank Balance Change"
}
