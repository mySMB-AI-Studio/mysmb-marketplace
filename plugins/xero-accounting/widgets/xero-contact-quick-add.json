{
  "id": "xero-contact-quick-add",
  "title": "New Contact Quick-Add",
  "description": "Quick form to add a new contact to Xero.",
  "category": "crm",
  "tags": [
    "xero",
    "contacts",
    "form",
    "crm",
    "create"
  ],
  "keywords": [
    "contact",
    "contacts",
    "customer",
    "add",
    "new",
    "create",
    "quick"
  ],
  "connectorsUsed": [
    "xero-accounting"
  ],
  "popularity": 0,
  "sizing": {
    "preferred": {
      "colSpan": 5,
      "rowSpan": 4
    },
    "min": {
      "colSpan": 4,
      "rowSpan": 4
    },
    "max": {
      "colSpan": 8,
      "rowSpan": 10
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "children": [
          "header",
          "body"
        ]
      },
      "header": {
        "type": "Header",
        "children": [
          "titleGroup"
        ]
      },
      "titleGroup": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center"
        },
        "children": [
          "titleIcon",
          "title"
        ]
      },
      "titleIcon": {
        "type": "Icon",
        "props": {
          "name": "UserPlus",
          "tone": "accent",
          "size": "sm"
        }
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "New Contact",
          "level": "h2"
        }
      },
      "body": {
        "type": "Body",
        "children": [
          "form",
          "divider",
          "actions",
          "successBanner",
          "errorBanner"
        ]
      },
      "form": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "nameRow",
          "emailRow",
          "firstRow",
          "lastRow",
          "phoneRow"
        ]
      },
      "nameRow": {
        "type": "FormRow",
        "props": {
          "label": "Name",
          "hint": "Required"
        },
        "children": [
          "nameInput"
        ]
      },
      "nameInput": {
        "type": "TextInput",
        "props": {
          "value": {
            "$bindState": "/ui/form/contact/Name"
          },
          "placeholder": "Acme Corp"
        }
      },
      "emailRow": {
        "type": "FormRow",
        "props": {
          "label": "Email"
        },
        "children": [
          "emailInput"
        ]
      },
      "emailInput": {
        "type": "TextInput",
        "props": {
          "value": {
            "$bindState": "/ui/form/contact/EmailAddress"
          },
          "placeholder": "hello@acme.com",
          "type": "email"
        }
      },
      "firstRow": {
        "type": "FormRow",
        "props": {
          "label": "First name"
        },
        "children": [
          "firstInput"
        ]
      },
      "firstInput": {
        "type": "TextInput",
        "props": {
          "value": {
            "$bindState": "/ui/form/contact/FirstName"
          }
        }
      },
      "lastRow": {
        "type": "FormRow",
        "props": {
          "label": "Last name"
        },
        "children": [
          "lastInput"
        ]
      },
      "lastInput": {
        "type": "TextInput",
        "props": {
          "value": {
            "$bindState": "/ui/form/contact/LastName"
          }
        }
      },
      "phoneRow": {
        "type": "FormRow",
        "props": {
          "label": "Phone"
        },
        "children": [
          "phoneInput"
        ]
      },
      "phoneInput": {
        "type": "TextInput",
        "props": {
          "value": {
            "$bindState": "/ui/form/contact/_Phone"
          },
          "type": "tel",
          "placeholder": "+1 555 0100"
        }
      },
      "divider": {
        "type": "Divider"
      },
      "actions": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "justify": "end"
        },
        "children": [
          "resetBtn",
          "saveBtn"
        ]
      },
      "resetBtn": {
        "type": "Button",
        "props": {
          "label": "Reset",
          "variant": "secondary",
          "size": "sm"
        },
        "on": {
          "click": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/form/contact",
                "value": {}
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/form/contactSaved",
                "value": ""
              }
            }
          ]
        }
      },
      "saveBtn": {
        "type": "Button",
        "props": {
          "label": "Create contact",
          "variant": "primary",
          "size": "sm",
          "leadingIcon": "UserPlus"
        },
        "on": {
          "click": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/form/contactSaved",
                "value": ""
              }
            },
            {
              "action": "xero-accounting.create_contact",
              "params": {
                "contact": {
                  "$state": "/ui/form/contact"
                }
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/form/contactSaved",
                "value": {
                  "$cond": {
                    "$state": "/_errors/xero-accounting.create_contact"
                  },
                  "$then": "",
                  "$else": true
                }
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/form/contact",
                "value": {
                  "$cond": {
                    "$state": "/_errors/xero-accounting.create_contact"
                  },
                  "$then": {
                    "$state": "/ui/form/contact"
                  },
                  "$else": {}
                }
              }
            }
          ]
        }
      },
      "successBanner": {
        "type": "Section",
        "props": {
          "variant": "muted"
        },
        "children": [
          "successRow"
        ],
        "visible": {
          "$state": "/ui/form/contactSaved"
        }
      },
      "successRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center"
        },
        "children": [
          "successIcon",
          "successText"
        ]
      },
      "successIcon": {
        "type": "Icon",
        "props": {
          "name": "CheckCircle2",
          "tone": "success",
          "size": "sm"
        }
      },
      "successText": {
        "type": "Text",
        "props": {
          "text": "Contact created in Xero.",
          "size": "sm",
          "tone": "success"
        }
      },
      "errorBanner": {
        "type": "Section",
        "props": {
          "variant": "bordered"
        },
        "children": [
          "errorRow"
        ],
        "visible": {
          "$state": "/_errors/xero-accounting.create_contact"
        }
      },
      "errorRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center"
        },
        "children": [
          "errorIcon",
          "errorText"
        ]
      },
      "errorIcon": {
        "type": "Icon",
        "props": {
          "name": "AlertTriangle",
          "tone": "destructive",
          "size": "sm"
        }
      },
      "errorText": {
        "type": "Text",
        "props": {
          "text": {
            "$state": "/_errors/xero-accounting.create_contact"
          },
          "size": "sm",
          "tone": "destructive"
        }
      }
    }
  },
  "status": "draft"
}
