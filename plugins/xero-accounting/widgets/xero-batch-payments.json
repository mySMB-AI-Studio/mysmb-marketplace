{
  "category": "finance",
  "connectorsUsed": [
    "xero-accounting"
  ],
  "dataProvider": {
    "kind": "tool",
    "mcp": "xero-accounting",
    "params": {},
    "tool": "list_xero_batch_payment_bills"
  },
  "description": "Lists outstanding Xero supplier bills pre-classified for a batch payment run — ready (valid BSB + account on file) vs excluded (missing or invalid bank details).",
  "id": "xero-batch-payments",
  "keywords": [
    "xero",
    "batch payment",
    "supplier",
    "bills",
    "bank details",
    "bsb",
    "accounts payable",
    "pay run"
  ],
  "pluginIcon": "data:image/png;base64,",
  "popularity": 0,
  "sizing": {
    "max": {
      "colSpan": 10,
      "rowSpan": 16
    },
    "min": {
      "colSpan": 4,
      "rowSpan": 7
    },
    "preferred": {
      "colSpan": 5,
      "rowSpan": 9
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": [
          "header",
          "body"
        ],
        "watch": {
          "/xero-accounting/list_xero_batch_payment_bills/bills": {
            "action": "setState",
            "params": {
              "statePath": "/ui/bp",
              "value": {
                "$computed": "xero-accounting_paginate",
                "args": {
                  "value": {
                    "$state": "/xero-accounting/list_xero_batch_payment_bills/bills"
                  },
                  "page": 0,
                  "delta": 0,
                  "size": 30
                }
              }
            }
          }
        }
      },
      "header": {
        "type": "Header",
        "props": {},
        "children": [
          "titleGroup"
        ]
      },
      "titleGroup": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center"
        },
        "children": [
          "titleIcon",
          "title"
        ]
      },
      "titleIcon": {
        "type": "Icon",
        "props": {
          "name": "Banknote",
          "tone": "accent",
          "size": "sm"
        }
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "Batch Payments",
          "level": "h2"
        }
      },
      "body": {
        "type": "Body",
        "props": {},
        "children": [
          "loading",
          "empty",
          "content"
        ]
      },
      "loading": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "sk1",
          "sk2",
          "sk3",
          "sk4",
          "sk5"
        ],
        "visible": {
          "$state": "/_loading/xero-accounting.list_xero_batch_payment_bills"
        }
      },
      "sk1": {
        "type": "Skeleton",
        "props": {
          "height": "4rem",
          "rounded": "md"
        }
      },
      "sk2": {
        "type": "Skeleton",
        "props": {
          "height": "2.75rem",
          "rounded": "md"
        }
      },
      "sk3": {
        "type": "Skeleton",
        "props": {
          "height": "2.75rem",
          "rounded": "md"
        }
      },
      "sk4": {
        "type": "Skeleton",
        "props": {
          "height": "2.75rem",
          "rounded": "md"
        }
      },
      "sk5": {
        "type": "Skeleton",
        "props": {
          "height": "2.75rem",
          "rounded": "md"
        }
      },
      "empty": {
        "type": "Empty",
        "props": {
          "message": "No outstanding bills found."
        },
        "visible": {
          "$and": [
            {
              "$state": "/_loading/xero-accounting.list_xero_batch_payment_bills",
              "not": true
            },
            {
              "$state": "/xero-accounting/list_xero_batch_payment_bills/bills/0",
              "not": true
            }
          ]
        }
      },
      "content": {
        "type": "Stack",
        "props": {
          "gap": "md"
        },
        "children": [
          "summary",
          "summaryDivider",
          "billList",
          "pagerRow",
          "footerDivider",
          "footerRow"
        ],
        "visible": {
          "$and": [
            {
              "$state": "/_loading/xero-accounting.list_xero_batch_payment_bills",
              "not": true
            },
            {
              "$state": "/xero-accounting/list_xero_batch_payment_bills/bills/0"
            }
          ]
        }
      },
      "summary": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "children": [
          "eyebrow",
          "totalAmount",
          "metaRow"
        ]
      },
      "eyebrow": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "Bills due this week · {n}",
              "n": {
                "$state": "/xero-accounting/list_xero_batch_payment_bills/summary/total"
              }
            }
          }
        }
      },
      "totalAmount": {
        "type": "Stat",
        "props": {
          "value": {
            "$computed": "format_currency",
            "args": {
              "value": {
                "$state": "/xero-accounting/list_xero_batch_payment_bills/summary/totalAmount"
              },
              "currency": "AUD"
            }
          }
        }
      },
      "metaRow": {
        "type": "Row",
        "props": {
          "gap": "md",
          "align": "center"
        },
        "children": [
          "nextDueGroup",
          "blockedGroup"
        ]
      },
      "nextDueGroup": {
        "type": "Row",
        "props": {
          "gap": "xs",
          "align": "center"
        },
        "children": [
          "nextDueLabel",
          "nextDueValue"
        ],
        "visible": {
          "$state": "/xero-accounting/list_xero_batch_payment_bills/summary/nextDueDate"
        }
      },
      "nextDueLabel": {
        "type": "Caption",
        "props": {
          "text": "Next due:",
          "tone": "muted"
        }
      },
      "nextDueValue": {
        "type": "Text",
        "props": {
          "text": {
            "$state": "/xero-accounting/list_xero_batch_payment_bills/summary/nextDueDate"
          },
          "size": "xs",
          "weight": "medium"
        }
      },
      "blockedGroup": {
        "type": "Row",
        "props": {
          "gap": "xs",
          "align": "center"
        },
        "children": [
          "blockedLabel",
          "blockedValue"
        ],
        "visible": {
          "$state": "/xero-accounting/list_xero_batch_payment_bills/summary/excludedCount"
        }
      },
      "blockedLabel": {
        "type": "Caption",
        "props": {
          "text": "Blocked:",
          "tone": "muted"
        }
      },
      "blockedValue": {
        "type": "Text",
        "props": {
          "text": {
            "$state": "/xero-accounting/list_xero_batch_payment_bills/summary/excludedCount"
          },
          "size": "xs",
          "weight": "medium",
          "tone": "destructive"
        }
      },
      "summaryDivider": {
        "type": "Divider",
        "props": {}
      },
      "billList": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "billRow"
        ],
        "repeat": {
          "statePath": "/ui/bp/items",
          "key": "id"
        }
      },
      "billRow": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "billRowContent",
          "billDivider"
        ]
      },
      "billRowContent": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "start",
          "template": "auto minmax(0,1fr) auto"
        },
        "children": [
          "billDotGroup",
          "billInfo",
          "billAmount"
        ]
      },
      "billDotGroup": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "children": [
          "billDotMismatch",
          "billDotMissing",
          "billDotReady"
        ]
      },
      "billInfo": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "children": [
          "billName",
          "billMeta",
          "billBadgeRow"
        ]
      },
      "billName": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "contactName"
          },
          "size": "md",
          "weight": "medium",
          "truncate": true
        }
      },
      "billMeta": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "Due {d} · {n}",
              "d": {
                "$item": "dueDate"
              },
              "n": {
                "$item": "invoiceNumber"
              }
            }
          },
          "tone": "muted"
        }
      },
      "billBadgeRow": {
        "type": "Row",
        "props": {
          "gap": "xs",
          "align": "center"
        },
        "children": [
          "billBadgeMismatch",
          "billBadgeMissing",
          "billBadgeReady"
        ]
      },
      "billDotMismatch": {
        "type": "Dot",
        "props": {
          "size": "sm",
          "tone": "destructive"
        },
        "visible": {
          "$item": "bankStatus",
          "eq": "mismatch"
        }
      },
      "billBadgeMismatch": {
        "type": "Badge",
        "props": {
          "text": "Bank detail mismatch",
          "tone": "destructive",
          "variant": "soft"
        },
        "visible": {
          "$item": "bankStatus",
          "eq": "mismatch"
        }
      },
      "billDotMissing": {
        "type": "Dot",
        "props": {
          "size": "sm",
          "tone": "warning"
        },
        "visible": {
          "$item": "bankStatus",
          "eq": "missing"
        }
      },
      "billBadgeMissing": {
        "type": "Badge",
        "props": {
          "text": "No bank details",
          "tone": "warning",
          "variant": "soft"
        },
        "visible": {
          "$item": "bankStatus",
          "eq": "missing"
        }
      },
      "billDotReady": {
        "type": "Dot",
        "props": {
          "size": "sm",
          "tone": "success"
        },
        "visible": {
          "$item": "bankStatus",
          "eq": "ready"
        }
      },
      "billBadgeReady": {
        "type": "Badge",
        "props": {
          "text": "Ready",
          "tone": "success",
          "variant": "soft"
        },
        "visible": {
          "$item": "bankStatus",
          "eq": "ready"
        }
      },
      "billAmount": {
        "type": "Text",
        "props": {
          "text": {
            "$computed": "format_currency",
            "args": {
              "value": {
                "$item": "amountDue"
              },
              "currency": {
                "$item": "currencyCode"
              }
            }
          },
          "size": "md",
          "weight": "medium"
        }
      },
      "billDivider": {
        "type": "Divider",
        "props": {}
      },
      "pagerRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center",
          "justify": "between"
        },
        "children": [
          "pagerLabel",
          "pagerButtons"
        ],
        "visible": {
          "$state": "/ui/bp/hasPages"
        }
      },
      "pagerLabel": {
        "type": "Caption",
        "props": {
          "text": {
            "$state": "/ui/bp/label"
          },
          "tone": "muted"
        }
      },
      "pagerButtons": {
        "type": "Row",
        "props": {
          "gap": "xs",
          "align": "center"
        },
        "children": [
          "pagerPrev",
          "pagerNext"
        ]
      },
      "pagerPrev": {
        "type": "Button",
        "props": {
          "label": "Previous",
          "variant": "secondary",
          "size": "sm",
          "leadingIcon": "ChevronLeft"
        },
        "on": {
          "click": {
            "action": "setState",
            "params": {
              "statePath": "/ui/bp",
              "value": {
                "$computed": "xero-accounting_paginate",
                "args": {
                  "value": {
                    "$state": "/xero-accounting/list_xero_batch_payment_bills/bills"
                  },
                  "page": {
                    "$state": "/ui/bp/page"
                  },
                  "delta": -1,
                  "size": 30
                }
              }
            }
          }
        },
        "visible": {
          "$state": "/ui/bp/hasPrev"
        }
      },
      "pagerNext": {
        "type": "Button",
        "props": {
          "label": "Next page",
          "variant": "secondary",
          "size": "sm",
          "leadingIcon": "ChevronRight"
        },
        "on": {
          "click": {
            "action": "setState",
            "params": {
              "statePath": "/ui/bp",
              "value": {
                "$computed": "xero-accounting_paginate",
                "args": {
                  "value": {
                    "$state": "/xero-accounting/list_xero_batch_payment_bills/bills"
                  },
                  "page": {
                    "$state": "/ui/bp/page"
                  },
                  "delta": 1,
                  "size": 30
                }
              }
            }
          }
        },
        "visible": {
          "$state": "/ui/bp/hasNext"
        }
      },
      "footerDivider": {
        "type": "Divider",
        "props": {}
      },
      "footerRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "end",
          "justify": "between"
        },
        "children": [
          "footerLeft",
          "footerOpen"
        ]
      },
      "footerLeft": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "children": [
          "footerLabel",
          "footerTotals"
        ]
      },
      "footerLabel": {
        "type": "Caption",
        "props": {
          "text": "Ready to pay",
          "tone": "muted"
        }
      },
      "footerTotals": {
        "type": "Row",
        "props": {
          "gap": "xs",
          "align": "center"
        },
        "children": [
          "footerCount",
          "footerSep",
          "footerAmount"
        ]
      },
      "footerCount": {
        "type": "Text",
        "props": {
          "text": {
            "$state": "/xero-accounting/list_xero_batch_payment_bills/summary/readyOfTotalText"
          },
          "size": "sm",
          "weight": "medium"
        }
      },
      "footerSep": {
        "type": "Text",
        "props": {
          "text": "·",
          "size": "sm",
          "tone": "muted"
        }
      },
      "footerAmount": {
        "type": "Text",
        "props": {
          "text": {
            "$computed": "format_currency",
            "args": {
              "value": {
                "$state": "/xero-accounting/list_xero_batch_payment_bills/summary/readyAmount"
              },
              "currency": "AUD"
            }
          },
          "size": "sm",
          "weight": "medium"
        }
      },
      "footerOpen": {
        "type": "Row",
        "props": {
          "gap": "xs",
          "align": "center",
          "hover": true,
          "clickable": true
        },
        "children": [
          "footerOpenText",
          "footerOpenIcon"
        ],
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "url": {
                "$state": "/xero-accounting/list_xero_batch_payment_bills/billsUrl"
              },
              "target": "_blank"
            }
          }
        }
      },
      "footerOpenText": {
        "type": "Text",
        "props": {
          "text": "Open in Xero",
          "size": "sm",
          "weight": "medium",
          "tone": "info"
        }
      },
      "footerOpenIcon": {
        "type": "Icon",
        "props": {
          "name": "ArrowRight",
          "size": "xs",
          "tone": "info"
        }
      }
    }
  },
  "tags": [
    "xero",
    "bills",
    "batch",
    "payments",
    "bank",
    "accounts-payable"
  ],
  "title": "Batch Payments"
}
