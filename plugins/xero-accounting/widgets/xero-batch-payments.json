{
  "category": "finance",
  "connectorsUsed": [
    "xero-accounting"
  ],
  "dataProvider": {
    "kind": "tool",
    "mcp": "xero-accounting",
    "params": {},
    "tool": "list_xero_batch_payment_bills"
  },
  "description": "Lists outstanding Xero supplier bills pre-classified for a batch payment run — ready (valid BSB + account on file) vs excluded (missing or invalid bank details).",
  "id": "xero-batch-payments",
  "keywords": [
    "xero",
    "batch payment",
    "supplier",
    "bills",
    "bank details",
    "bsb",
    "accounts payable",
    "pay run"
  ],
  "popularity": 0,
  "sizing": {
    "max": {
      "colSpan": 10,
      "rowSpan": 16
    },
    "min": {
      "colSpan": 4,
      "rowSpan": 7
    },
    "preferred": {
      "colSpan": 5,
      "rowSpan": 9
    }
  },
  "spec": {
    "elements": {
      "billAmount": {
        "props": {
          "size": "sm",
          "text": {
            "$computed": "format_currency",
            "args": {
              "currency": {
                "$item": "currencyCode"
              },
              "value": {
                "$item": "amountDue"
              }
            }
          },
          "weight": "semibold"
        },
        "type": "Text"
      },
      "billDivider": {
        "props": {},
        "type": "Divider"
      },
      "billDot": {
        "props": {
          "size": "sm",
          "tone": {
            "$item": "tone"
          }
        },
        "type": "Dot"
      },
      "billInfo": {
        "children": [
          "billName",
          "billMeta"
        ],
        "props": {
          "gap": "none"
        },
        "type": "Stack"
      },
      "billList": {
        "children": [
          "billRow"
        ],
        "props": {
          "gap": "none"
        },
        "repeat": {
          "key": "id",
          "statePath": "/xero-accounting/list_xero_batch_payment_bills/bills"
        },
        "type": "Stack"
      },
      "billMeta": {
        "props": {
          "text": {
            "$item": "metaLine"
          },
          "tone": "muted",
          "truncate": true
        },
        "type": "Caption"
      },
      "billName": {
        "props": {
          "size": "sm",
          "text": {
            "$item": "contactName"
          },
          "truncate": true,
          "weight": "semibold"
        },
        "type": "Text"
      },
      "billRow": {
        "children": [
          "billRowContent",
          "billDivider"
        ],
        "props": {
          "gap": "xs"
        },
        "type": "Stack"
      },
      "billRowContent": {
        "children": [
          "billDot",
          "billInfo",
          "billAmount"
        ],
        "props": {
          "align": "start",
          "gap": "sm",
          "template": "auto minmax(0,1fr) auto"
        },
        "type": "Row"
      },
      "blockedLabel": {
        "props": {
          "text": "Blocked:",
          "tone": "muted"
        },
        "type": "Caption",
        "visible": {
          "$state": "/xero-accounting/list_xero_batch_payment_bills/summary/excludedCount"
        }
      },
      "blockedReasonRow": {
        "props": {
          "text": {
            "$state": "/xero-accounting/list_xero_batch_payment_bills/summary/blockedReason"
          },
          "tone": "warning"
        },
        "type": "Caption",
        "visible": {
          "$state": "/xero-accounting/list_xero_batch_payment_bills/summary/blockedReason"
        }
      },
      "blockedValue": {
        "props": {
          "text": {
            "$state": "/xero-accounting/list_xero_batch_payment_bills/summary/excludedCount"
          },
          "tone": "warning",
          "weight": "semibold"
        },
        "type": "Caption",
        "visible": {
          "$state": "/xero-accounting/list_xero_batch_payment_bills/summary/excludedCount"
        }
      },
      "body": {
        "children": [
          "loading",
          "empty",
          "content"
        ],
        "props": {},
        "type": "Body"
      },
      "card": {
        "children": [
          "header",
          "body"
        ],
        "props": {},
        "type": "Card"
      },
      "content": {
        "children": [
          "summarySection",
          "divider1",
          "billList",
          "footerRow"
        ],
        "props": {
          "gap": "md"
        },
        "type": "Stack",
        "visible": {
          "$and": [
            {
              "$state": "/_loading/xero-accounting.list_xero_batch_payment_bills",
              "not": true
            },
            {
              "$state": "/xero-accounting/list_xero_batch_payment_bills/bills/0"
            }
          ]
        }
      },
      "divider1": {
        "props": {},
        "type": "Divider"
      },
      "empty": {
        "props": {
          "message": "No outstanding bills found."
        },
        "type": "Empty",
        "visible": {
          "$and": [
            {
              "$state": "/_loading/xero-accounting.list_xero_batch_payment_bills",
              "not": true
            },
            {
              "$state": "/xero-accounting/list_xero_batch_payment_bills/bills/0",
              "not": true
            }
          ]
        }
      },
      "eyebrow": {
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "n": {
                "$state": "/xero-accounting/list_xero_batch_payment_bills/summary/total"
              },
              "pattern": "Bills Due This Week · {n}"
            }
          }
        },
        "type": "Eyebrow"
      },
      "footerAmount": {
        "props": {
          "text": {
            "$computed": "format_currency",
            "args": {
              "currency": "AUD",
              "value": {
                "$state": "/xero-accounting/list_xero_batch_payment_bills/summary/readyAmount"
              }
            }
          },
          "weight": "semibold"
        },
        "type": "Caption"
      },
      "footerCount": {
        "props": {
          "text": {
            "$state": "/xero-accounting/list_xero_batch_payment_bills/summary/readyOfTotalText"
          },
          "weight": "semibold"
        },
        "type": "Caption"
      },
      "footerLeft": {
        "children": [
          "footerCount",
          "footerSep",
          "footerAmount"
        ],
        "props": {
          "align": "center",
          "gap": "xs"
        },
        "type": "Row"
      },
      "footerRight": {
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "url": {
                "$state": "/xero-accounting/list_xero_batch_payment_bills/billsUrl"
              }
            }
          }
        },
        "props": {
          "label": "Open in Xero",
          "size": "sm",
          "variant": "secondary"
        },
        "type": "Button"
      },
      "footerRow": {
        "children": [
          "footerLeft",
          "footerRight"
        ],
        "props": {
          "align": "center",
          "gap": "sm",
          "justify": "between"
        },
        "type": "Row"
      },
      "footerSep": {
        "props": {
          "text": "|",
          "tone": "muted"
        },
        "type": "Caption"
      },
      "header": {
        "children": [
          "titleGroup"
        ],
        "props": {},
        "type": "Header"
      },
      "loading": {
        "children": [
          "sk1",
          "sk2",
          "sk3",
          "sk4",
          "sk5",
          "sk6"
        ],
        "props": {
          "gap": "sm"
        },
        "type": "Stack",
        "visible": {
          "$state": "/_loading/xero-accounting.list_xero_batch_payment_bills"
        }
      },
      "metaRow": {
        "children": [
          "nextDueLabel",
          "nextDueValue",
          "blockedLabel",
          "blockedValue"
        ],
        "props": {
          "align": "center",
          "gap": "xs"
        },
        "type": "Row"
      },
      "nextDueLabel": {
        "props": {
          "text": "Next due:",
          "tone": "muted"
        },
        "type": "Caption"
      },
      "nextDueValue": {
        "props": {
          "text": {
            "$state": "/xero-accounting/list_xero_batch_payment_bills/summary/nextDueDate"
          },
          "weight": "semibold"
        },
        "type": "Caption"
      },
      "sk1": {
        "props": {
          "height": "4rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "sk2": {
        "props": {
          "height": "2.75rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "sk3": {
        "props": {
          "height": "2.75rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "sk4": {
        "props": {
          "height": "2.75rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "sk5": {
        "props": {
          "height": "2.75rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "sk6": {
        "props": {
          "height": "2.75rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "summarySection": {
        "children": [
          "totalAmountText",
          "metaRow",
          "blockedReasonRow"
        ],
        "props": {
          "gap": "xs"
        },
        "type": "Stack"
      },
      "title": {
        "props": {
          "level": "h2",
          "text": "Batch Payments"
        },
        "type": "Heading"
      },
      "titleGroup": {
        "children": [
          "titleIcon",
          "titleStack"
        ],
        "props": {
          "align": "center",
          "gap": "sm"
        },
        "type": "Row"
      },
      "titleIcon": {
        "props": {
          "name": "Banknote",
          "size": "sm",
          "tone": "accent"
        },
        "type": "Icon"
      },
      "titleStack": {
        "children": [
          "title",
          "eyebrow"
        ],
        "props": {
          "gap": "none"
        },
        "type": "Stack"
      },
      "totalAmountText": {
        "props": {
          "value": {
            "$computed": "format_currency",
            "args": {
              "currency": "AUD",
              "value": {
                "$state": "/xero-accounting/list_xero_batch_payment_bills/summary/totalAmount"
              }
            }
          }
        },
        "type": "Stat"
      }
    },
    "root": "card"
  },
  "tags": [
    "xero",
    "bills",
    "batch",
    "payments",
    "bank",
    "accounts-payable"
  ],
  "title": "Batch Payments"
}
