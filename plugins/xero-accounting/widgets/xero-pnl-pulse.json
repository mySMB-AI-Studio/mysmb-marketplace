{
  "category": "finance",
  "connectorsUsed": [
    "xero-accounting"
  ],
  "dataProvider": {
    "kind": "tool",
    "mcp": "xero-accounting",
    "params": {
      "fromDate": "$fiscal_year_start",
      "toDate": "$today"
    },
    "tool": "get_profit_and_loss"
  },
  "description": "Profit & loss pulse — revenue vs expenses at a glance.",
  "id": "xero-pnl-pulse",
  "keywords": [
    "pnl",
    "p&l",
    "profit",
    "loss",
    "income",
    "expenses",
    "revenue",
    "earnings"
  ],
  "pluginIcon": "data:image/png;base64,",
  "popularity": 0,
  "sizing": {
    "max": {
      "colSpan": 10,
      "rowSpan": 8
    },
    "min": {
      "colSpan": 5,
      "rowSpan": 4
    },
    "preferred": {
      "colSpan": 5,
      "rowSpan": 4
    }
  },
  "spec": {
    "elements": {
      "asOf": {
        "props": {
          "text": {
            "$state": "/xero-accounting/get_profit_and_loss/Reports/0/ReportDate"
          }
        },
        "type": "Eyebrow"
      },
      "body": {
        "children": [
          "loading",
          "breakdownHeading",
          "table"
        ],
        "type": "Body"
      },
      "breakdownHeading": {
        "props": {
          "level": "h3",
          "text": "Line Items"
        },
        "type": "Heading",
        "visible": {
          "$state": "/_loading/xero-accounting.get_profit_and_loss",
          "not": true
        }
      },
      "card": {
        "children": [
          "header",
          "stats",
          "divider",
          "body"
        ],
        "type": "Card",
        "watch": {
          "/xero-accounting/get_profit_and_loss/Reports": {
            "action": "setState",
            "params": {
              "statePath": "/ui/pnl/rows",
              "value": {
                "$computed": "xero-accounting_flatten_report_rows",
                "args": {
                  "value": {
                    "$state": "/xero-accounting/get_profit_and_loss/Reports/0"
                  }
                }
              }
            }
          }
        }
      },
      "chipFY2": {
        "children": [
          "chipFY2Label"
        ],
        "on": {
          "click": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/pnl/period",
                "value": "fy-2"
              }
            },
            {
              "action": "xero-accounting.get_profit_and_loss",
              "params": {
                "fromDate": "$fiscal_year_minus_2_start",
                "toDate": "$fiscal_year_minus_2_end"
              }
            }
          ]
        },
        "props": {
          "align": "center",
          "clickable": true,
          "gap": "none",
          "hover": true,
          "selected": {
            "$computed": "equals",
            "args": {
              "a": "fy-2",
              "b": {
                "$state": "/ui/pnl/period"
              }
            }
          }
        },
        "type": "Row"
      },
      "chipFY2Label": {
        "props": {
          "size": "xs",
          "text": "FY-2",
          "weight": "medium"
        },
        "type": "Text"
      },
      "chipLastFY": {
        "children": [
          "chipLastFYLabel"
        ],
        "on": {
          "click": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/pnl/period",
                "value": "lastFY"
              }
            },
            {
              "action": "xero-accounting.get_profit_and_loss",
              "params": {
                "fromDate": "$last_fiscal_year_start",
                "toDate": "$last_fiscal_year_end"
              }
            }
          ]
        },
        "props": {
          "align": "center",
          "clickable": true,
          "gap": "none",
          "hover": true,
          "selected": {
            "$computed": "equals",
            "args": {
              "a": "lastFY",
              "b": {
                "$state": "/ui/pnl/period"
              }
            }
          }
        },
        "type": "Row"
      },
      "chipLastFYLabel": {
        "props": {
          "size": "xs",
          "text": "Last FY",
          "weight": "medium"
        },
        "type": "Text"
      },
      "chipThisFY": {
        "children": [
          "chipThisFYLabel"
        ],
        "on": {
          "click": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/pnl/period",
                "value": "thisFY"
              }
            },
            {
              "action": "xero-accounting.get_profit_and_loss",
              "params": {
                "fromDate": "$fiscal_year_start",
                "toDate": "$today"
              }
            }
          ]
        },
        "props": {
          "align": "center",
          "clickable": true,
          "gap": "none",
          "hover": true,
          "selected": {
            "$computed": "equals",
            "args": {
              "a": "thisFY",
              "b": {
                "$state": "/ui/pnl/period"
              }
            }
          }
        },
        "type": "Row"
      },
      "chipThisFYLabel": {
        "props": {
          "size": "xs",
          "text": "This FY",
          "weight": "medium"
        },
        "type": "Text"
      },
      "divider": {
        "type": "Divider"
      },
      "expCell": {
        "children": [
          "expLabelRow",
          "expValue"
        ],
        "props": {
          "gap": "xs"
        },
        "type": "Stack"
      },
      "expIcon": {
        "props": {
          "name": "ArrowDownRight",
          "size": "xs",
          "tone": "destructive"
        },
        "type": "Icon"
      },
      "expLabel": {
        "props": {
          "text": "Expenses"
        },
        "type": "Eyebrow"
      },
      "expLabelRow": {
        "children": [
          "expIcon",
          "expLabel"
        ],
        "props": {
          "align": "center",
          "gap": "xs"
        },
        "type": "Row"
      },
      "expValue": {
        "props": {
          "size": "sm",
          "tone": "destructive",
          "value": {
            "$computed": "format_currency",
            "args": {
              "value": {
                "$computed": "xero-accounting_report_find_row",
                "args": {
                  "cell": 1,
                  "title": "Total Operating Expenses",
                  "value": {
                    "$state": "/ui/pnl/rows"
                  }
                }
              }
            }
          }
        },
        "type": "Stat"
      },
      "header": {
        "children": [
          "titleGroup",
          "periodChips"
        ],
        "type": "Header"
      },
      "loading": {
        "children": [
          "ls1",
          "ls2",
          "ls3",
          "ls4"
        ],
        "props": {
          "gap": "sm"
        },
        "type": "Stack",
        "visible": {
          "$state": "/_loading/xero-accounting.get_profit_and_loss"
        }
      },
      "ls1": {
        "props": {
          "height": "2rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "ls2": {
        "props": {
          "height": "2rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "ls3": {
        "props": {
          "height": "2rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "ls4": {
        "props": {
          "height": "2rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "netCell": {
        "children": [
          "netLabelRow",
          "netValue"
        ],
        "props": {
          "gap": "xs"
        },
        "type": "Stack"
      },
      "netIcon": {
        "props": {
          "name": "Target",
          "size": "xs",
          "tone": "accent"
        },
        "type": "Icon"
      },
      "netLabel": {
        "props": {
          "text": "Net Profit"
        },
        "type": "Eyebrow"
      },
      "netLabelRow": {
        "children": [
          "netIcon",
          "netLabel"
        ],
        "props": {
          "align": "center",
          "gap": "xs"
        },
        "type": "Row"
      },
      "netValue": {
        "props": {
          "size": "sm",
          "value": {
            "$computed": "format_currency",
            "args": {
              "value": {
                "$computed": "xero-accounting_report_find_row",
                "args": {
                  "cell": 1,
                  "title": "Net Profit",
                  "value": {
                    "$state": "/ui/pnl/rows"
                  }
                }
              }
            }
          }
        },
        "type": "Stat"
      },
      "periodChips": {
        "children": [
          "chipThisFY",
          "chipLastFY",
          "chipFY2"
        ],
        "props": {
          "align": "center",
          "gap": "xs"
        },
        "type": "Row"
      },
      "revCell": {
        "children": [
          "revLabelRow",
          "revValue"
        ],
        "props": {
          "gap": "xs"
        },
        "type": "Stack"
      },
      "revIcon": {
        "props": {
          "name": "ArrowUpRight",
          "size": "xs",
          "tone": "success"
        },
        "type": "Icon"
      },
      "revLabel": {
        "props": {
          "text": "Revenue"
        },
        "type": "Eyebrow"
      },
      "revLabelRow": {
        "children": [
          "revIcon",
          "revLabel"
        ],
        "props": {
          "align": "center",
          "gap": "xs"
        },
        "type": "Row"
      },
      "revValue": {
        "props": {
          "size": "sm",
          "tone": "success",
          "value": {
            "$computed": "format_currency",
            "args": {
              "value": {
                "$computed": "xero-accounting_report_find_row",
                "args": {
                  "cell": 1,
                  "title": "Total Income",
                  "value": {
                    "$state": "/ui/pnl/rows"
                  }
                }
              }
            }
          }
        },
        "type": "Stat"
      },
      "stats": {
        "children": [
          "revCell",
          "expCell",
          "netCell"
        ],
        "props": {
          "cols": 3,
          "gap": "md"
        },
        "type": "Grid",
        "visible": {
          "$state": "/_loading/xero-accounting.get_profit_and_loss",
          "not": true
        }
      },
      "table": {
        "props": {
          "columns": [
            {
              "field": "title",
              "header": "Line",
              "id": "line",
              "priority": 1
            },
            {
              "align": "right",
              "field": "c1",
              "format": "currency",
              "header": "Amount",
              "id": "amount",
              "priority": 1
            }
          ],
          "rows": {
            "$state": "/ui/pnl/rows"
          }
        },
        "type": "Table",
        "visible": {
          "$state": "/_loading/xero-accounting.get_profit_and_loss",
          "not": true
        }
      },
      "title": {
        "props": {
          "level": "h2",
          "text": "P&L Pulse"
        },
        "type": "Heading"
      },
      "titleGroup": {
        "children": [
          "titleIcon",
          "titleStack"
        ],
        "props": {
          "align": "start",
          "gap": "sm"
        },
        "type": "Row"
      },
      "titleIcon": {
        "props": {
          "name": "TrendingUp",
          "size": "sm",
          "tone": "success"
        },
        "type": "Icon"
      },
      "titleStack": {
        "children": [
          "title",
          "asOf"
        ],
        "props": {
          "gap": "none"
        },
        "type": "Stack"
      }
    },
    "root": "card"
  },
  "tags": [
    "xero",
    "pnl",
    "profit",
    "loss",
    "finance",
    "report"
  ],
  "title": "P&L Pulse"
}
