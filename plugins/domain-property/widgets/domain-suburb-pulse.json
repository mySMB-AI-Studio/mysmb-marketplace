{
  "id": "domain-suburb-pulse",
  "title": "Suburb Pulse",
  "description": "Market performance snapshot for a target suburb — median sold price, sales volume and top sale. Edit dataProvider.params to change suburb.",
  "category": "real-estate",
  "tags": ["domain", "suburb", "median price", "market performance"],
  "keywords": ["suburb stats", "median", "sales volume", "appraisal", "market report"],
  "connectorsUsed": ["domain-property"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 6, "rowSpan": 3 },
    "min": { "colSpan": 4, "rowSpan": 2 },
    "max": { "colSpan": 12, "rowSpan": 4 }
  },
  "dataProvider": {
    "mcp": "domain-property",
    "tool": "get_suburb_performance",
    "params": {
      "state": "NSW",
      "suburb": "Parramatta",
      "postcode": "2150",
      "property_category": "house",
      "chronological_span": 12,
      "periods_back": 1
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": { "type": "Card", "props": {}, "children": ["header", "body"] },
      "header": { "type": "Header", "props": {}, "children": ["headerRow"] },
      "headerRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["titleGroup", "refreshBtn"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": { "type": "Icon", "props": { "name": "MapPin", "tone": "accent", "size": "sm" } },
      "titleStack": { "type": "Stack", "props": { "gap": "none" }, "children": ["title", "eyebrow"] },
      "title": { "type": "Heading", "props": { "text": "Parramatta NSW 2150", "level": "h2" } },
      "eyebrow": { "type": "Eyebrow", "props": { "text": "Houses · 12 months · powered by Domain" } },
      "refreshBtn": {
        "type": "IconButton",
        "props": { "name": "RefreshCw", "size": "sm", "ariaLabel": "Refresh" },
        "on": {
          "click": {
            "action": "domain-property.get_suburb_performance",
            "params": {
              "state": "NSW",
              "suburb": "Parramatta",
              "postcode": "2150",
              "property_category": "house",
              "chronological_span": 12,
              "periods_back": 1
            }
          }
        }
      },
      "body": { "type": "Body", "props": {}, "children": ["loading", "empty", "statsGrid"] },
      "loading": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["lk1", "lk2"],
        "visible": { "$state": "/_loading/domain-property.get_suburb_performance" }
      },
      "lk1": { "type": "Skeleton", "props": { "height": "3rem", "rounded": "md" } },
      "lk2": { "type": "Skeleton", "props": { "height": "3rem", "rounded": "md" } },
      "empty": {
        "type": "Empty",
        "props": { "message": "No suburb statistics available." },
        "visible": {
          "$and": [
            { "$state": "/_loading/domain-property.get_suburb_performance", "not": true },
            {
              "$state": "/domain-property/get_suburb_performance/series/seriesInfo/0/values/medianSoldPrice",
              "not": true
            }
          ]
        }
      },
      "statsGrid": {
        "type": "Grid",
        "props": { "cols": 3, "gap": "sm" },
        "children": ["statMedian", "statSold", "statHighest"],
        "visible": { "$state": "/_loading/domain-property.get_suburb_performance", "not": true }
      },
      "statMedian": {
        "type": "Stat",
        "props": {
          "label": "Median sold",
          "value": {
            "$computed": "format_currency",
            "args": {
              "value": {
                "$state": "/domain-property/get_suburb_performance/series/seriesInfo/0/values/medianSoldPrice"
              },
              "fractionDigits": 0
            }
          }
        }
      },
      "statSold": {
        "type": "Stat",
        "props": {
          "label": "Sales",
          "value": {
            "$state": "/domain-property/get_suburb_performance/series/seriesInfo/0/values/numberSold"
          }
        }
      },
      "statHighest": {
        "type": "Stat",
        "props": {
          "label": "Top sale",
          "value": {
            "$computed": "format_currency",
            "args": {
              "value": {
                "$state": "/domain-property/get_suburb_performance/series/seriesInfo/0/values/highestSoldPrice"
              },
              "fractionDigits": 0
            }
          }
        }
      }
    }
  }
}
