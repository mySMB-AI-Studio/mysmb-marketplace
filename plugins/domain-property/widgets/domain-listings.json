{
  "id": "domain-listings",
  "title": "Listings Feed",
  "description": "Current for-sale residential listings in a target suburb. Edit dataProvider.params to change suburb or switch to Rent.",
  "category": "real-estate",
  "tags": ["domain", "listings", "for sale", "prospecting"],
  "keywords": ["listings", "for sale", "properties", "stock", "competition"],
  "connectorsUsed": ["domain-property"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 6, "rowSpan": 6 },
    "min": { "colSpan": 4, "rowSpan": 4 },
    "max": { "colSpan": 12, "rowSpan": 12 }
  },
  "dataProvider": {
    "mcp": "domain-property",
    "tool": "search_listings",
    "params": {
      "listing_type": "Sale",
      "suburb": "Parramatta",
      "state": "NSW",
      "include_surrounding_suburbs": true,
      "page_size": 15
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": { "type": "Card", "props": {}, "children": ["header", "body"] },
      "header": { "type": "Header", "props": {}, "children": ["headerRow"] },
      "headerRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["titleGroup", "refreshBtn"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": { "type": "Icon", "props": { "name": "Home", "tone": "accent", "size": "sm" } },
      "titleStack": { "type": "Stack", "props": { "gap": "none" }, "children": ["title", "eyebrow"] },
      "title": { "type": "Heading", "props": { "text": "For sale — Parramatta", "level": "h2" } },
      "eyebrow": { "type": "Eyebrow", "props": { "text": "Incl. surrounding suburbs · powered by Domain" } },
      "refreshBtn": {
        "type": "IconButton",
        "props": { "name": "RefreshCw", "size": "sm", "ariaLabel": "Refresh" },
        "on": {
          "click": {
            "action": "domain-property.search_listings",
            "params": {
              "listing_type": "Sale",
              "suburb": "Parramatta",
              "state": "NSW",
              "include_surrounding_suburbs": true,
              "page_size": 15
            }
          }
        }
      },
      "body": { "type": "Body", "props": {}, "children": ["loading", "empty", "list", "attribution"] },
      "loading": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["lk1", "lk2", "lk3", "lk4"],
        "visible": { "$state": "/_loading/domain-property.search_listings" }
      },
      "lk1": { "type": "Skeleton", "props": { "height": "3rem", "rounded": "md" } },
      "lk2": { "type": "Skeleton", "props": { "height": "3rem", "rounded": "md" } },
      "lk3": { "type": "Skeleton", "props": { "height": "3rem", "rounded": "md" } },
      "lk4": { "type": "Skeleton", "props": { "height": "3rem", "rounded": "md" } },
      "empty": {
        "type": "Empty",
        "props": { "message": "No current listings match." },
        "visible": {
          "$and": [
            { "$state": "/_loading/domain-property.search_listings", "not": true },
            { "$state": "/domain-property/search_listings/0", "not": true }
          ]
        }
      },
      "list": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["rowItem"],
        "repeat": {
          "statePath": "/domain-property/search_listings",
          "key": "listing/id"
        },
        "visible": { "$state": "/_loading/domain-property.search_listings", "not": true }
      },
      "rowItem": {
        "type": "ListItem",
        "props": {
          "title": { "$item": "listing/propertyDetails/displayableAddress" },
          "subtitle": {
            "$computed": "fmt",
            "args": {
              "pattern": "{beds} bed · {baths} bath · {type}",
              "beds": { "$item": "listing/propertyDetails/bedrooms" },
              "baths": { "$item": "listing/propertyDetails/bathrooms" },
              "type": { "$item": "listing/propertyDetails/propertyType" }
            }
          },
          "value": { "$item": "listing/priceDetails/displayPrice" }
        }
      },
      "attribution": {
        "type": "Caption",
        "props": { "text": "Listings data powered by Domain — view full details on domain.com.au" },
        "visible": { "$state": "/_loading/domain-property.search_listings", "not": true }
      }
    }
  }
}
