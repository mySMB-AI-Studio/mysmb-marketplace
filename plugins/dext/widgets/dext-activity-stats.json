{
  "id": "dext-activity-stats",
  "title": "Client Activity Stats",
  "description": "Rolling turnover and transaction activity for a client across Annual, Quarterly avg, and Monthly avg periods.",
  "category": "analytics",
  "tags": ["dext", "activity", "stats", "turnover", "invoices", "transactions"],
  "keywords": ["dext stats", "client activity", "turnover", "sales invoices", "bills", "bank transactions", "quarterly monthly annual"],
  "connectorsUsed": ["dext"],
  "popularity": 65,
  "sizing": {
    "preferred": { "colSpan": 4, "rowSpan": 7 },
    "min": { "colSpan": 3, "rowSpan": 5 },
    "max": { "colSpan": 8, "rowSpan": 12 }
  },
  "dataProvider": {
    "mcp": "dext",
    "tool": "list_clients",
    "params": {}
  },
  "spec": {
    "root": "card",
    "elements": {

      "card": {
        "type": "Card",
        "props": {},
        "children": ["header", "activityLoading", "activityEmpty", "noDataEmpty", "tabRow", "annualContent", "quarterlyContent", "monthlyContent"],
        "watch": {
          "/dext/list_clients/data": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/clientId",
                "value": { "$computed": "identity", "args": { "value": { "$state": "/dext/list_clients/data/0/id" } } }
              }
            }
          ],
          "/ui/clientId": [
            {
              "action": "dext.get_client_activity_stats",
              "params": { "clientId": { "$state": "/ui/clientId" } }
            }
          ],
          "/dext/get_client_activity_stats": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/rows",
                "value": {
                  "$computed": "dext_flatten_activity_stats_rows",
                  "args": { "stats": { "$state": "/dext/get_client_activity_stats" } }
                }
              }
            },
            { "action": "setState", "params": { "statePath": "/ui/tab/annual",    "value": true  } },
            { "action": "setState", "params": { "statePath": "/ui/tab/quarterly", "value": false } },
            { "action": "setState", "params": { "statePath": "/ui/tab/monthly",   "value": false } }
          ]
        }
      },

      "header": {
        "type": "Header",
        "children": ["titleGroup"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIconBox", "titleStack"]
      },
      "titleIconBox": {
        "type": "Section",
        "props": { "tone": "destructive" },
        "children": ["titleIcon"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "BarChart2", "tone": "destructive", "size": "md" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "eyebrow"]
      },
      "title": { "type": "Heading", "props": { "text": "Client Activity Stats", "level": "h2" } },
      "eyebrow": { "type": "Eyebrow", "props": { "text": "DEXT", "tone": "destructive" } },

      "activityLoading": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["sk1", "sk2", "sk3", "sk4"],
        "visible": {
          "$or": [
            { "$state": "/_loading/dext.list_clients" },
            { "$state": "/_loading/dext.get_client_activity_stats" }
          ]
        }
      },
      "sk1": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "sm" } },
      "sk2": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "sm" } },
      "sk3": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "sm" } },
      "sk4": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "sm" } },

      "activityEmpty": {
        "type": "Empty",
        "props": { "message": "No client data available." },
        "visible": {
          "$and": [
            { "$state": "/_loading/dext.list_clients", "not": true },
            { "$state": "/_loading/dext.get_client_activity_stats", "not": true },
            { "$state": "/ui/clientId", "not": true }
          ]
        }
      },

      "noDataEmpty": {
        "type": "Empty",
        "props": { "message": "No activity data available for this client." },
        "visible": {
          "$and": [
            { "$state": "/_loading/dext.list_clients", "not": true },
            { "$state": "/_loading/dext.get_client_activity_stats", "not": true },
            { "$state": "/ui/clientId" },
            { "$state": "/ui/rows/annual/0", "not": true }
          ]
        }
      },

      "tabRow": {
        "type": "Row",
        "props": { "gap": "xs" },
        "children": ["tabAnnualOn", "tabAnnualOff", "tabQuarterlyOn", "tabQuarterlyOff", "tabMonthlyOn", "tabMonthlyOff"],
        "visible": { "$state": "/ui/rows/annual/0" }
      },

      "tabAnnualOn": {
        "type": "Button",
        "props": { "label": "Annual", "variant": "link", "size": "sm" },
        "visible": {
          "$and": [
            { "$state": "/ui/tab/quarterly", "not": true },
            { "$state": "/ui/tab/monthly",   "not": true }
          ]
        }
      },
      "tabAnnualOff": {
        "type": "Button",
        "props": { "label": "Annual", "variant": "ghost", "size": "sm" },
        "visible": {
          "$or": [
            { "$state": "/ui/tab/quarterly" },
            { "$state": "/ui/tab/monthly"   }
          ]
        },
        "on": {
          "click": [
            { "action": "setState", "params": { "statePath": "/ui/tab/annual",    "value": true  } },
            { "action": "setState", "params": { "statePath": "/ui/tab/quarterly", "value": false } },
            { "action": "setState", "params": { "statePath": "/ui/tab/monthly",   "value": false } }
          ]
        }
      },

      "tabQuarterlyOn": {
        "type": "Button",
        "props": { "label": "Quarterly avg", "variant": "link", "size": "sm" },
        "visible": { "$state": "/ui/tab/quarterly" }
      },
      "tabQuarterlyOff": {
        "type": "Button",
        "props": { "label": "Quarterly avg", "variant": "ghost", "size": "sm" },
        "visible": { "$state": "/ui/tab/quarterly", "not": true },
        "on": {
          "click": [
            { "action": "setState", "params": { "statePath": "/ui/tab/annual",    "value": false } },
            { "action": "setState", "params": { "statePath": "/ui/tab/quarterly", "value": true  } },
            { "action": "setState", "params": { "statePath": "/ui/tab/monthly",   "value": false } }
          ]
        }
      },

      "tabMonthlyOn": {
        "type": "Button",
        "props": { "label": "Monthly avg", "variant": "link", "size": "sm" },
        "visible": { "$state": "/ui/tab/monthly" }
      },
      "tabMonthlyOff": {
        "type": "Button",
        "props": { "label": "Monthly avg", "variant": "ghost", "size": "sm" },
        "visible": { "$state": "/ui/tab/monthly", "not": true },
        "on": {
          "click": [
            { "action": "setState", "params": { "statePath": "/ui/tab/annual",    "value": false } },
            { "action": "setState", "params": { "statePath": "/ui/tab/quarterly", "value": false } },
            { "action": "setState", "params": { "statePath": "/ui/tab/monthly",   "value": true  } }
          ]
        }
      },

      "annualContent": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["annualEmpty", "annualList"],
        "visible": {
          "$and": [
            { "$state": "/ui/tab/quarterly", "not": true },
            { "$state": "/ui/tab/monthly",   "not": true }
          ]
        }
      },
      "annualEmpty": {
        "type": "Empty",
        "props": { "message": "No annual data available." },
        "visible": { "$state": "/ui/rows/annual/0", "not": true }
      },
      "annualList": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["activityRow"],
        "repeat": { "statePath": "/ui/rows/annual", "key": "id" }
      },

      "quarterlyContent": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["quarterlyEmpty", "quarterlyList"],
        "visible": { "$state": "/ui/tab/quarterly" }
      },
      "quarterlyEmpty": {
        "type": "Empty",
        "props": { "message": "No quarterly data available." },
        "visible": { "$state": "/ui/rows/quarterly/0", "not": true }
      },
      "quarterlyList": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["activityRow"],
        "repeat": { "statePath": "/ui/rows/quarterly", "key": "id" }
      },

      "monthlyContent": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["monthlyEmpty", "monthlyList"],
        "visible": { "$state": "/ui/tab/monthly" }
      },
      "monthlyEmpty": {
        "type": "Empty",
        "props": { "message": "No monthly data available." },
        "visible": { "$state": "/ui/rows/monthly/0", "not": true }
      },
      "monthlyList": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["activityRow"],
        "repeat": { "statePath": "/ui/rows/monthly", "key": "id" }
      },

      "activityRow": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["rowIconUp", "rowIconDown", "rowIconMinus", "rowInfo", "rowValue"]
      },
      "rowIconUp": {
        "type": "Icon",
        "props": { "name": "ArrowUp", "tone": "success", "size": "sm" },
        "visible": { "$item": "dot_tone", "eq": "success" }
      },
      "rowIconDown": {
        "type": "Icon",
        "props": { "name": "ArrowDown", "tone": "destructive", "size": "sm" },
        "visible": { "$item": "dot_tone", "eq": "destructive" }
      },
      "rowIconMinus": {
        "type": "Icon",
        "props": { "name": "Minus", "tone": "muted", "size": "sm" },
        "visible": { "$item": "dot_tone", "eq": "muted" }
      },
      "rowInfo": {
        "type": "Stack",
        "props": { "gap": "none", "grow": true },
        "children": ["rowLabel", "rowSubLabel"]
      },
      "rowLabel": {
        "type": "Text",
        "props": { "text": { "$item": "label" }, "size": "sm", "weight": "semibold" }
      },
      "rowSubLabel": {
        "type": "Caption",
        "props": { "text": { "$item": "sub_label" }, "tone": { "$item": "dot_tone" } },
        "visible": { "$item": "sub_label" }
      },
      "rowValue": {
        "type": "Stat",
        "props": { "value": { "$item": "badge_label" }, "size": "sm" }
      }

    }
  },
  "status": "published"
}
