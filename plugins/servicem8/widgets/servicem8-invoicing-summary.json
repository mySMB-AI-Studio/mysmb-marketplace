{
  "id": "servicem8-invoicing-summary",
  "title": "ServiceM8 — Invoicing Summary",
  "description": "A live Status | Amount summary of jobs from your ServiceM8 account — Quotes, Work Orders, Completed - Pending Approval, and Completed - Awaiting Payment, each showing the total invoice value of jobs in that state, always shown even at 0.00 — matching ServiceM8's own Invoicing tab's Summary view. Inactive (archived) jobs, Unsuccessful jobs, and fully paid jobs are excluded, same as that screen — a paid job has nothing left pending. Any status outside ServiceM8's defaults falls into an \"Other\" row (shown only when non-empty) rather than being silently dropped from the total. No currency symbol is shown — ServiceM8's API exposes no account-currency field, and a hardcoded symbol would be wrong for accounts not using AUD. Only the first page of jobs is summed (ServiceM8's API returns up to 1,000 jobs per page) — an account with more jobs than that will under-total rather than paginate further.",
  "category": "field-service",
  "tags": ["servicem8", "invoicing", "jobs", "field-service", "trades", "finance"],
  "keywords": ["invoicing", "invoices", "quotes", "work orders", "completed", "pending approval", "awaiting payment", "summary", "field service", "servicem8"],
  "connectorsUsed": ["servicem8"],
  "popularity": 0,
  "brandColor": "#34DFBA",
  "sizing": {
    "preferred": { "colSpan": 5, "rowSpan": 6 },
    "min": { "colSpan": 4, "rowSpan": 5 },
    "max": { "colSpan": 8, "rowSpan": 9 }
  },
  "dataProvider": {
    "mcp": "servicem8",
    "tool": "list_jobs",
    "params": {}
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": ["header", "divider0", "body", "footer"],
        "watch": {
          "/servicem8/list_jobs/jobs": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/rows",
                "value": {
                  "$computed": "servicem8_invoicing_summary",
                  "args": { "value": { "$state": "/servicem8/list_jobs/jobs" } }
                }
              }
            }
          ]
        }
      },

      "header": { "type": "Header", "props": {}, "children": ["headerRow"] },
      "headerRow": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": { "type": "Icon", "props": { "name": "Receipt", "tone": "brand", "size": "sm" } },
      "titleStack": { "type": "Stack", "props": { "gap": "none" }, "children": ["title", "subtitle"] },
      "title": { "type": "Heading", "props": { "text": "Invoicing Summary", "level": "h2" } },
      "subtitle": { "type": "Eyebrow", "props": { "text": "ServiceM8" } },

      "divider0": { "type": "Divider", "props": {} },

      "body": { "type": "Body", "props": {}, "children": ["loading", "empty", "table"] },

      "loading": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["sk1", "sk2", "sk3", "sk4"],
        "visible": {
          "$and": [
            { "$state": "/_loading/servicem8.list_jobs" },
            { "$state": "/ui/rows/0", "not": true }
          ]
        }
      },
      "sk1": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "sk2": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "sk3": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "sk4": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },

      "empty": {
        "type": "Empty",
        "props": { "message": "No jobs found in this ServiceM8 account." },
        "visible": {
          "$and": [
            { "$state": "/_loading/servicem8.list_jobs", "not": true },
            { "$state": "/ui/rows/0", "not": true }
          ]
        }
      },

      "table": {
        "type": "Table",
        "props": {
          "loading": { "$state": "/_loading/servicem8.list_jobs" },
          "skeletonRows": 4,
          "rows": { "$state": "/ui/rows" },
          "columns": [
            { "id": "status", "header": "Status", "field": "status_label", "priority": 1 },
            { "id": "amount", "header": "Amount", "field": "amount", "width": 110, "priority": 1 }
          ]
        },
        "visible": { "$state": "/ui/rows/0" }
      },

      "footer": {
        "type": "Row",
        "props": { "justify": "end" },
        "children": ["openServiceM8Btn"]
      },
      "openServiceM8Btn": {
        "type": "Button",
        "props": { "label": "Open in ServiceM8", "tone": "brand", "variant": "primary", "size": "sm", "leadingIcon": "ExternalLink" },
        "on": {
          "click": {
            "action": "open_url",
            "params": { "url": "https://go.servicem8.com/", "target": "_blank" }
          }
        }
      }
    }
  },
  "status": "published"
}
