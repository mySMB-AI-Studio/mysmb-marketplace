{
  "id": "servicem8-job-list",
  "title": "ServiceM8 — Job list",
  "description": "A live list of jobs from ServiceM8, showing job description (falling back to the client's name, then the job number, when there's no description), address, status, and an Active/Inactive badge. The client name is resolved from the job's raw company_uuid via a separate list_companies call (ServiceM8 has no combined job+client endpoint), same cross-referencing pattern as the Staff Roster tile's security-role lookup — a company_uuid that doesn't resolve (deleted client, or the companies call hasn't landed yet) falls through to the job number instead of showing a placeholder. Filter by Active/Inactive/All jobs (defaults to All). Click an active job's row to open it in the ServiceM8 web app in a new tab; clicking an inactive (archived) job shows a notice instead, since ServiceM8's own web app refuses to open an inactive job's page directly. \"Open Dispatch Board\" opens ServiceM8's app home page (there is no separate documented Dispatch Board URL — it's the default view after login).",
  "category": "field-service",
  "tags": ["servicem8", "jobs", "field-service", "trades", "operations"],
  "keywords": ["jobs", "work orders", "field service", "trades", "clients", "servicem8"],
  "connectorsUsed": ["servicem8"],
  "popularity": 0,
  "brandColor": "#34DFBA",
  "sizing": {
    "preferred": { "colSpan": 8, "rowSpan": 8 },
    "min": { "colSpan": 4, "rowSpan": 4 },
    "max": { "colSpan": 12, "rowSpan": 12 }
  },
  "dataProvider": {
    "mcp": "servicem8",
    "tool": "list_jobs",
    "params": {}
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": ["header", "body", "footer"],
        "watch": {
          "/servicem8/list_jobs/jobs": [
            {
              "action": "servicem8.list_companies",
              "params": {}
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/rows",
                "value": {
                  "$computed": "servicem8_join_job_companies",
                  "args": {
                    "jobs": { "$state": "/servicem8/list_jobs/jobs" },
                    "companies": { "$state": "/servicem8/list_companies/companies" }
                  }
                }
              }
            }
          ],
          "/servicem8/list_companies/companies": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/rows",
                "value": {
                  "$computed": "servicem8_join_job_companies",
                  "args": {
                    "jobs": { "$state": "/servicem8/list_jobs/jobs" },
                    "companies": { "$state": "/servicem8/list_companies/companies" }
                  }
                }
              }
            }
          ]
        }
      },
      "header": { "type": "Header", "props": {}, "children": ["headerRow"] },
      "headerRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["titleGroup", "headerActions"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "Briefcase", "tone": "brand", "size": "sm" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "subtitle"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Jobs", "level": "h2" }
      },
      "subtitle": {
        "type": "Eyebrow",
        "props": { "text": "ServiceM8" }
      },
      "headerActions": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["statusFilter", "refreshBtn"]
      },
      "statusFilter": {
        "type": "Select",
        "props": {
          "value": { "$bindState": "/ui/statusFilter" },
          "options": [
            { "value": "all", "label": "All jobs" },
            { "value": "active", "label": "Active" },
            { "value": "inactive", "label": "Inactive" }
          ],
          "placeholder": "All jobs",
          "ariaLabel": "Filter by job status",
          "size": "sm"
        },
        "on": {
          "change": [
            {
              "action": "bust_tool_cache",
              "params": { "mcp": "servicem8", "tool": "list_jobs" }
            },
            {
              "action": "servicem8.list_jobs",
              "params": {
                "filter": {
                  "$cond": { "$state": "/ui/statusFilter", "eq": "active" },
                  "$then": "active eq 1",
                  "$else": {
                    "$cond": { "$state": "/ui/statusFilter", "eq": "inactive" },
                    "$then": "active eq 0",
                    "$else": ""
                  }
                }
              }
            }
          ]
        }
      },
      "refreshBtn": {
        "type": "IconButton",
        "props": { "name": "RefreshCw", "size": "sm", "ariaLabel": "Refresh" },
        "on": {
          "click": [
            {
              "action": "bust_tool_cache",
              "params": { "mcp": "servicem8", "tool": "list_jobs" }
            },
            {
              "action": "servicem8.list_jobs",
              "params": {
                "filter": {
                  "$cond": { "$state": "/ui/statusFilter", "eq": "active" },
                  "$then": "active eq 1",
                  "$else": {
                    "$cond": { "$state": "/ui/statusFilter", "eq": "inactive" },
                    "$then": "active eq 0",
                    "$else": ""
                  }
                }
              }
            }
          ]
        }
      },
      "body": { "type": "Body", "props": {}, "children": ["loading", "empty", "list"] },
      "loading": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["lk1", "lk2", "lk3", "lk4"],
        "visible": {
          "$and": [
            { "$state": "/_loading/servicem8.list_jobs" },
            { "$state": "/ui/rows/0", "not": true }
          ]
        }
      },
      "lk1": { "type": "Skeleton", "props": { "height": "3rem", "rounded": "md" } },
      "lk2": { "type": "Skeleton", "props": { "height": "3rem", "rounded": "md" } },
      "lk3": { "type": "Skeleton", "props": { "height": "3rem", "rounded": "md" } },
      "lk4": { "type": "Skeleton", "props": { "height": "3rem", "rounded": "md" } },
      "empty": {
        "type": "Empty",
        "props": { "message": "No jobs found for the selected filter." },
        "visible": {
          "$and": [
            { "$state": "/_loading/servicem8.list_jobs", "not": true },
            { "$state": "/ui/rows/0", "not": true }
          ]
        }
      },
      "list": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["row"],
        "repeat": {
          "statePath": "/ui/rows",
          "key": "uuid"
        },
        "limit": 20,
        "visible": {
          "$and": [
            { "$state": "/_loading/servicem8.list_jobs", "not": true },
            { "$state": "/ui/rows/0" }
          ]
        }
      },
      "row": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center", "template": "auto minmax(0, 1fr) auto", "hover": true, "clickable": true },
        "on": {
          "click": [
            {
              "action": "toast",
              "params": {
                "message": {
                  "$cond": { "$item": "active", "eq": 0 },
                  "$then": "This job is inactive in ServiceM8 and can't be opened directly from here.",
                  "$else": ""
                },
                "tone": "info"
              }
            },
            {
              "action": "open_url",
              "params": {
                "url": {
                  "$cond": { "$item": "active", "eq": 0 },
                  "$then": "",
                  "$else": {
                    "$computed": "fmt",
                    "args": { "pattern": "https://go.servicem8.com/OpenJob/{uuid}", "uuid": { "$item": "uuid" } }
                  }
                },
                "target": "_blank"
              }
            }
          ]
        },
        "children": ["rowIcon", "rowDetails", "rowBadges"]
      },
      "rowIcon": {
        "type": "Icon",
        "props": { "name": "Briefcase", "tone": "brand", "size": "sm" }
      },
      "rowDetails": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["rowTitle", "rowAddress"]
      },
      "rowTitle": {
        "type": "Text",
        "props": {
          "text": {
            "$cond": { "$item": "job_description" },
            "$then": { "$item": "job_description" },
            "$else": {
              "$cond": { "$item": "company_name" },
              "$then": { "$item": "company_name" },
              "$else": { "$item": "generated_job_id" }
            }
          },
          "size": "sm",
          "weight": "medium",
          "truncate": true
        }
      },
      "rowAddress": {
        "type": "Caption",
        "props": {
          "text": { "$item": "job_address" }
        }
      },
      "rowBadges": {
        "type": "Stack",
        "props": { "gap": "xs", "align": "end" },
        "children": ["rowStatus", "rowActiveBadge"]
      },
      "rowStatus": {
        "type": "Badge",
        "props": {
          "text": { "$item": "status" },
          "tone": {
            "$cond": { "$item": "status", "eq": "Completed" },
            "$then": "success",
            "$else": {
              "$cond": { "$item": "status", "eq": "Unsuccessful" },
              "$then": "destructive",
              "$else": {
                "$cond": { "$item": "status", "eq": "Quote" },
                "$then": "warning",
                "$else": "info"
              }
            }
          }
        }
      },
      "rowActiveBadge": {
        "type": "Badge",
        "props": {
          "text": {
            "$cond": { "$item": "active", "eq": 1 },
            "$then": "Active",
            "$else": "Inactive"
          },
          "tone": {
            "$cond": { "$item": "active", "eq": 1 },
            "$then": "success",
            "$else": "muted"
          },
          "variant": "outline"
        }
      },

      "footer": {
        "type": "Row",
        "props": { "justify": "end" },
        "children": ["dispatchBoardBtn"]
      },
      "dispatchBoardBtn": {
        "type": "Button",
        "props": { "label": "Open Dispatch Board", "tone": "brand", "variant": "primary", "size": "sm", "leadingIcon": "ExternalLink" },
        "on": {
          "click": {
            "action": "open_url",
            "params": { "url": "https://go.servicem8.com/", "target": "_blank" }
          }
        }
      }
    }
  }
}
