{
  "id": "servicem8-job-list",
  "title": "ServiceM8 — Job list",
  "description": "A live list of jobs from ServiceM8, showing job number, client, address, and status.",
  "category": "field-service",
  "tags": ["servicem8", "jobs", "field-service", "trades", "operations"],
  "keywords": ["jobs", "work orders", "field service", "trades", "clients", "servicem8"],
  "connectorsUsed": ["servicem8"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 8, "rowSpan": 8 },
    "min": { "colSpan": 4, "rowSpan": 4 },
    "max": { "colSpan": 12, "rowSpan": 12 }
  },
  "dataProvider": {
    "mcp": "servicem8",
    "tool": "list_jobs",
    "params": {}
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": { "type": "Card", "props": {}, "children": ["header", "body"] },
      "header": { "type": "Header", "props": {}, "children": ["headerRow"] },
      "headerRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["titleGroup", "refreshBtn"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "Briefcase", "tone": "accent", "size": "sm" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "subtitle"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Jobs", "level": "h2" }
      },
      "subtitle": {
        "type": "Eyebrow",
        "props": { "text": "ServiceM8" }
      },
      "refreshBtn": {
        "type": "IconButton",
        "props": { "name": "RefreshCw", "size": "sm", "ariaLabel": "Refresh" },
        "on": {
          "click": {
            "action": "servicem8.list_jobs",
            "params": {}
          }
        }
      },
      "body": { "type": "Body", "props": {}, "children": ["loading", "empty", "list"] },
      "loading": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["lk1", "lk2", "lk3", "lk4"],
        "visible": { "$state": "/_loading/servicem8.list_jobs" }
      },
      "lk1": { "type": "Skeleton", "props": { "height": "3rem", "rounded": "md" } },
      "lk2": { "type": "Skeleton", "props": { "height": "3rem", "rounded": "md" } },
      "lk3": { "type": "Skeleton", "props": { "height": "3rem", "rounded": "md" } },
      "lk4": { "type": "Skeleton", "props": { "height": "3rem", "rounded": "md" } },
      "empty": {
        "type": "Empty",
        "props": { "message": "No jobs found." },
        "visible": {
          "$and": [
            { "$state": "/_loading/servicem8.list_jobs", "not": true },
            { "$state": "/servicem8/list_jobs/0", "not": true }
          ]
        }
      },
      "list": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["row"],
        "repeat": {
          "statePath": "/servicem8/list_jobs",
          "key": "uuid"
        },
        "visible": { "$state": "/_loading/servicem8.list_jobs", "not": true }
      },
      "row": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center", "template": "auto minmax(0, 1fr) auto" },
        "children": ["rowIcon", "rowDetails", "rowStatus"]
      },
      "rowIcon": {
        "type": "Icon",
        "props": { "name": "Briefcase", "tone": "accent", "size": "sm" }
      },
      "rowDetails": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["rowClient", "rowAddress"]
      },
      "rowClient": {
        "type": "Text",
        "props": {
          "text": { "$item": "contact_full_name" },
          "size": "sm",
          "weight": "medium",
          "truncate": true
        }
      },
      "rowAddress": {
        "type": "Caption",
        "props": {
          "text": { "$item": "job_address" }
        }
      },
      "rowStatus": {
        "type": "Badge",
        "props": {
          "text": { "$item": "status" },
          "tone": {
            "$cond": { "$item": "status", "eq": "Completed" },
            "$then": "positive",
            "$else": {
              "$cond": { "$item": "status", "eq": "Cancelled" },
              "$then": "critical",
              "$else": {
                "$cond": { "$item": "status", "eq": "Quote" },
                "$then": "warning",
                "$else": "info"
              }
            }
          }
        }
      }
    }
  }
}
