{
  "id": "servicem8-job-history",
  "title": "ServiceM8 — Job History",
  "description": "A live, chronological table of every job in your ServiceM8 account — Date, Job Number, Customer Name, and Job Status — sorted by date, most recent first, matching ServiceM8's own job list view. Unlike the Job List tile, this shows every job regardless of Active/Inactive state (there's no filter here) since a history view should include archived/completed work, not just current jobs. The customer name is resolved from the job's raw company_uuid via a separate list_companies call (ServiceM8 has no combined job+client endpoint); an unresolved company_uuid shows an em dash. Click a row to open that job in the ServiceM8 web app in a new tab; an inactive (archived) job shows a notice instead, since ServiceM8's own web app refuses to open an inactive job's page directly.",
  "category": "field-service",
  "tags": ["servicem8", "jobs", "history", "field-service", "trades", "operations"],
  "keywords": ["job history", "jobs", "past jobs", "work orders", "field service", "servicem8"],
  "connectorsUsed": ["servicem8"],
  "popularity": 0,
  "brandColor": "#34DFBA",
  "sizing": {
    "preferred": { "colSpan": 8, "rowSpan": 9 },
    "min": { "colSpan": 6, "rowSpan": 5 },
    "max": { "colSpan": 12, "rowSpan": 12 }
  },
  "dataProvider": {
    "mcp": "servicem8",
    "tool": "list_jobs",
    "params": {}
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": ["header", "statusBreakdownSection", "breakdownDivider", "colHeader", "divider", "body", "footer"],
        "watch": {
          "/servicem8/list_jobs/jobs": [
            {
              "action": "servicem8.list_companies",
              "params": {}
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/rows",
                "value": {
                  "$computed": "servicem8_job_history_rows",
                  "args": {
                    "jobs": { "$state": "/servicem8/list_jobs/jobs" },
                    "companies": { "$state": "/servicem8/list_companies/companies" }
                  }
                }
              }
            }
          ],
          "/servicem8/list_companies/companies": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/rows",
                "value": {
                  "$computed": "servicem8_job_history_rows",
                  "args": {
                    "jobs": { "$state": "/servicem8/list_jobs/jobs" },
                    "companies": { "$state": "/servicem8/list_companies/companies" }
                  }
                }
              }
            }
          ],
          "/ui/rows": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/statusBreakdown",
                "value": {
                  "$computed": "servicem8_job_status_breakdown",
                  "args": { "jobs": { "$state": "/ui/rows" } }
                }
              }
            }
          ]
        }
      },

      "header": { "type": "Header", "props": {}, "children": ["headerRow"] },
      "headerRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["titleGroup", "headerActions"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "History", "tone": "brand", "size": "sm" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "subtitle"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Job History", "level": "h2" }
      },
      "subtitle": {
        "type": "Eyebrow",
        "props": { "text": "ServiceM8" }
      },
      "headerActions": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["refreshBtn"]
      },
      "refreshBtn": {
        "type": "IconButton",
        "props": { "name": "RefreshCw", "size": "sm", "ariaLabel": "Refresh" },
        "on": {
          "click": [
            {
              "action": "bust_tool_cache",
              "params": { "mcp": "servicem8", "tool": "list_jobs" }
            },
            {
              "action": "bust_tool_cache",
              "params": { "mcp": "servicem8", "tool": "list_companies" }
            },
            {
              "action": "servicem8.list_jobs",
              "params": {}
            }
          ]
        }
      },

      "statusBreakdownSection": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["statusBreakdownHeaderRow", "statusBreakdownBar", "statusBreakdownLegend"],
        "visible": {
          "$and": [
            { "$state": "/_loading/servicem8.list_jobs", "not": true },
            { "$state": "/ui/rows/0" }
          ]
        }
      },
      "statusBreakdownHeaderRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["statusBreakdownCaption", "statusBreakdownTotalCaption"]
      },
      "statusBreakdownCaption": {
        "type": "Caption",
        "props": { "text": "Job Status Breakdown", "tone": "muted" }
      },
      "statusBreakdownTotalCaption": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": { "pattern": "{total} jobs", "total": { "$state": "/ui/statusBreakdown/total" } }
          },
          "tone": "muted"
        }
      },
      "statusBreakdownBar": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center", "template": { "$state": "/ui/statusBreakdown/template" } },
        "children": ["statusSegment"],
        "repeat": { "statePath": "/ui/statusBreakdown/segments", "key": "status" }
      },
      "statusSegment": {
        "type": "ProgressBar",
        "props": { "value": 100, "tone": { "$item": "tone" } }
      },
      "statusBreakdownLegend": {
        "type": "Row",
        "props": { "gap": "md", "align": "center" },
        "children": ["legendItem"],
        "repeat": { "statePath": "/ui/statusBreakdown/segments", "key": "status" }
      },
      "legendItem": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["legendDot", "legendLabel"]
      },
      "legendDot": {
        "type": "Dot",
        "props": { "tone": { "$item": "tone" }, "size": "sm" }
      },
      "legendLabel": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": { "pattern": "{status} ({count})", "status": { "$item": "status" }, "count": { "$item": "count" } }
          },
          "tone": "muted"
        }
      },

      "breakdownDivider": { "type": "Divider", "props": {} },

      "colHeader": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center", "template": "5.5rem 4rem minmax(0, 1fr) auto" },
        "children": ["colDate", "colJobNumber", "colCustomer", "colStatus"]
      },
      "colDate": { "type": "Caption", "props": { "text": "Date" } },
      "colJobNumber": { "type": "Caption", "props": { "text": "Job Number" } },
      "colCustomer": { "type": "Caption", "props": { "text": "Customer Name" } },
      "colStatus": { "type": "Caption", "props": { "text": "Job Status" } },

      "divider": { "type": "Divider", "props": {} },

      "body": { "type": "Body", "props": {}, "children": ["loading", "empty", "list"] },
      "loading": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["lk1", "lk2", "lk3", "lk4"],
        "visible": {
          "$and": [
            { "$state": "/_loading/servicem8.list_jobs" },
            { "$state": "/ui/rows/0", "not": true }
          ]
        }
      },
      "lk1": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "lk2": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "lk3": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "lk4": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },

      "empty": {
        "type": "Empty",
        "props": { "message": "No jobs found in this ServiceM8 account." },
        "visible": {
          "$and": [
            { "$state": "/_loading/servicem8.list_jobs", "not": true },
            { "$state": "/ui/rows/0", "not": true }
          ]
        }
      },

      "list": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["row"],
        "repeat": {
          "statePath": "/ui/rows",
          "key": "uuid"
        },
        "limit": 20,
        "visible": {
          "$and": [
            { "$state": "/_loading/servicem8.list_jobs", "not": true },
            { "$state": "/ui/rows/0" }
          ]
        }
      },

      "row": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center", "template": "5.5rem 4rem minmax(0, 1fr) auto", "hover": true, "clickable": true },
        "on": {
          "click": [
            {
              "action": "toast",
              "params": {
                "message": {
                  "$cond": { "$item": "active", "eq": 0 },
                  "$then": "This job is inactive in ServiceM8 and can't be opened directly from here.",
                  "$else": ""
                },
                "tone": "info"
              }
            },
            {
              "action": "open_url",
              "params": {
                "url": {
                  "$cond": { "$item": "active", "eq": 0 },
                  "$then": "",
                  "$else": {
                    "$computed": "fmt",
                    "args": { "pattern": "https://go.servicem8.com/OpenJob/{uuid}", "uuid": { "$item": "uuid" } }
                  }
                },
                "target": "_blank"
              }
            }
          ]
        },
        "children": ["rowDate", "rowJobNumber", "rowCustomer", "rowStatus"]
      },
      "rowDate": {
        "type": "Text",
        "props": {
          "text": {
            "$computed": "format_date",
            "args": { "value": { "$item": "date" }, "format": "dd-mmm-yy" }
          },
          "size": "sm",
          "truncate": true
        }
      },
      "rowJobNumber": {
        "type": "Text",
        "props": {
          "text": { "$item": "generated_job_id" },
          "size": "sm",
          "truncate": true
        }
      },
      "rowCustomer": {
        "type": "Text",
        "props": {
          "text": {
            "$cond": { "$item": "company_name" },
            "$then": { "$item": "company_name" },
            "$else": "—"
          },
          "size": "sm",
          "weight": "medium",
          "truncate": true
        }
      },
      "rowStatus": {
        "type": "Badge",
        "props": {
          "text": { "$item": "status" },
          "tone": {
            "$cond": { "$item": "status", "eq": "Completed" },
            "$then": "success",
            "$else": {
              "$cond": { "$item": "status", "eq": "Unsuccessful" },
              "$then": "destructive",
              "$else": {
                "$cond": { "$item": "status", "eq": "Quote" },
                "$then": "warning",
                "$else": "info"
              }
            }
          }
        }
      },

      "footer": {
        "type": "Row",
        "props": { "justify": "end" },
        "children": ["openServiceM8Btn"]
      },
      "openServiceM8Btn": {
        "type": "Button",
        "props": { "label": "Open in ServiceM8", "tone": "brand", "variant": "primary", "size": "sm", "leadingIcon": "ExternalLink" },
        "on": {
          "click": {
            "action": "open_url",
            "params": { "url": "https://go.servicem8.com/", "target": "_blank" }
          }
        }
      }
    }
  }
}
