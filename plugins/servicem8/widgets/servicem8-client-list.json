{
  "id": "servicem8-client-list",
  "title": "ServiceM8 — Clients",
  "description": "A live directory of every client (company) in your ServiceM8 account — Name, Address, and Status — including inactive/archived clients, since this is meant as a full directory rather than a filtered workload view. Click \"Open\" on any row to view that client's page in the ServiceM8 web app in a new tab.",
  "category": "field-service",
  "tags": ["servicem8", "clients", "companies", "customers", "directory", "field-service", "trades"],
  "keywords": ["clients", "customers", "companies", "contacts", "directory", "field service", "servicem8"],
  "connectorsUsed": ["servicem8"],
  "popularity": 0,
  "brandColor": "#34DFBA",
  "sizing": {
    "preferred": { "colSpan": 8, "rowSpan": 7 },
    "min": { "colSpan": 5, "rowSpan": 5 },
    "max": { "colSpan": 12, "rowSpan": 12 }
  },
  "dataProvider": {
    "mcp": "servicem8",
    "tool": "list_companies",
    "params": {}
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": ["header", "divider0", "body", "footer"],
        "watch": {
          "/servicem8/list_companies/companies": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/rows",
                "value": {
                  "$computed": "servicem8_client_rows",
                  "args": { "companies": { "$state": "/servicem8/list_companies/companies" } }
                }
              }
            }
          ]
        }
      },

      "header": { "type": "Header", "props": {}, "children": ["headerRow"] },
      "headerRow": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": { "type": "Icon", "props": { "name": "Building2", "tone": "brand", "size": "sm" } },
      "titleStack": { "type": "Stack", "props": { "gap": "none" }, "children": ["title", "subtitle"] },
      "title": { "type": "Heading", "props": { "text": "Clients", "level": "h2" } },
      "subtitle": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": { "pattern": "ServiceM8 · {n} clients", "n": { "$computed": "count", "args": { "value": { "$state": "/ui/rows" } } } }
          }
        },
        "visible": { "$state": "/ui/rows/0" }
      },

      "divider0": { "type": "Divider", "props": {} },

      "body": { "type": "Body", "props": {}, "children": ["loading", "empty", "table"] },

      "loading": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["sk1", "sk2", "sk3", "sk4"],
        "visible": {
          "$and": [
            { "$state": "/_loading/servicem8.list_companies" },
            { "$state": "/ui/rows/0", "not": true }
          ]
        }
      },
      "sk1": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "sk2": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "sk3": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "sk4": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },

      "empty": {
        "type": "Empty",
        "props": { "message": "No clients found in this ServiceM8 account." },
        "visible": {
          "$and": [
            { "$state": "/_loading/servicem8.list_companies", "not": true },
            { "$state": "/ui/rows/0", "not": true }
          ]
        }
      },

      "table": {
        "type": "Table",
        "props": {
          "loading": { "$state": "/_loading/servicem8.list_companies" },
          "skeletonRows": 4,
          "rows": { "$state": "/ui/rows" },
          "columns": [
            { "id": "name", "header": "Client Name", "field": "name", "priority": 1 },
            { "id": "address", "header": "Address", "field": "address_label", "priority": 2 },
            { "id": "status", "header": "Status", "field": "status_label", "width": 90, "priority": 3 },
            {
              "id": "open",
              "header": "",
              "width": 90,
              "resizable": false,
              "priority": 1,
              "variant": "button",
              "buttonLabel": "Open",
              "buttonVariant": "primary",
              "buttonTone": "brand",
              "buttonSize": "sm",
              "buttonLeadingIcon": "ExternalLink",
              "buttonAction": {
                "action": "open_url",
                "params": { "target": "_blank" },
                "fromRow": { "url": "open_url" }
              }
            }
          ]
        },
        "visible": { "$state": "/ui/rows/0" }
      },

      "footer": {
        "type": "Row",
        "props": { "justify": "end" },
        "children": ["openServiceM8Btn"]
      },
      "openServiceM8Btn": {
        "type": "Button",
        "props": { "label": "Open in ServiceM8", "tone": "brand", "variant": "primary", "size": "sm", "leadingIcon": "ExternalLink" },
        "on": {
          "click": {
            "action": "open_url",
            "params": { "url": "https://go.servicem8.com/", "target": "_blank" }
          }
        }
      }
    }
  },
  "status": "published"
}
