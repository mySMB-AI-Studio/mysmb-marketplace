{
  "id": "filemaker-open-invoices",
  "title": "Open Invoices",
  "description": "A filtered set of FileMaker records — by default, invoices with an Open status. Edit the layout name, find query, and field bindings below to match your own FileMaker solution.",
  "category": "finance",
  "tags": ["filemaker", "claris", "invoices", "find"],
  "keywords": ["invoices", "open", "overdue", "find", "filemaker"],
  "connectorsUsed": ["filemaker"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 6, "rowSpan": 5 },
    "min": { "colSpan": 4, "rowSpan": 4 },
    "max": { "colSpan": 12, "rowSpan": 10 }
  },
  "dataProvider": {
    "mcp": "filemaker",
    "tool": "find_records",
    "params": {
      "layout": "Invoices",
      "query": [{ "Status": "Open" }],
      "sort": [{ "fieldName": "DueDate", "sortOrder": "ascend" }],
      "limit": 20
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": { "type": "Card", "props": {}, "children": ["titleRow", "div0", "body"] },
      "titleRow": { "type": "Row", "props": { "justify": "between", "align": "center" }, "children": ["titleGroup"] },
      "titleGroup": { "type": "Row", "props": { "gap": "sm", "align": "center" }, "children": ["titleIcon", "titleStack"] },
      "titleIcon": { "type": "Icon", "props": { "name": "FileText", "tone": "accent", "size": "sm" } },
      "titleStack": { "type": "Stack", "props": { "gap": "none" }, "children": ["title", "eyebrow"] },
      "title": { "type": "Heading", "props": { "text": "Open Invoices", "level": "h2" } },
      "eyebrow": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "FileMaker · {n} open invoices",
              "n": { "$computed": "count", "args": { "value": { "$state": "/filemaker/find_records/data" } } }
            }
          }
        }
      },

      "div0": { "type": "Divider", "props": {} },

      "body": { "type": "Body", "props": {}, "children": ["loading", "empty", "table"] },

      "loading": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["sk1", "sk2", "sk3"],
        "visible": { "$state": "/_loading/filemaker.find_records" }
      },
      "sk1": { "type": "Skeleton", "props": { "height": "2rem", "rounded": "md" } },
      "sk2": { "type": "Skeleton", "props": { "height": "2rem", "rounded": "md" } },
      "sk3": { "type": "Skeleton", "props": { "height": "2rem", "rounded": "md" } },

      "empty": {
        "type": "Empty",
        "props": { "message": "No matching records found." },
        "visible": {
          "$and": [
            { "$state": "/_loading/filemaker.find_records", "not": true },
            { "$state": "/filemaker/find_records/data/0", "not": true }
          ]
        }
      },

      "table": {
        "type": "Table",
        "props": {
          "loading": { "$state": "/_loading/filemaker.find_records" },
          "skeletonRows": 6,
          "rows": { "$state": "/filemaker/find_records/data" },
          "columns": [
            { "id": "invoice", "header": "Invoice", "field": "fieldData.InvoiceNumber", "priority": 1 },
            { "id": "customer", "header": "Customer", "field": "fieldData.CustomerName", "priority": 2 },
            { "id": "due", "header": "Due Date", "field": "fieldData.DueDate", "format": "dd_mmm_yy", "width": 100, "priority": 2 },
            { "id": "amount", "header": "Amount", "field": "fieldData.Amount", "align": "right", "width": 100, "priority": 1 },
            { "id": "status", "header": "Status", "field": "fieldData.Status", "width": 90, "priority": 3 }
          ]
        },
        "visible": { "$state": "/filemaker/find_records/data/0" }
      }
    }
  },
  "status": "published"
}
