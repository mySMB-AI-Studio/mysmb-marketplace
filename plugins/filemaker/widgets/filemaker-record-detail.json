    "max": {
      "colSpan": 6,
      "rowSpan": 8
    },
    "min": {
      "colSpan": 3,
      "rowSpan": 5
    },
    "preferred": {
      "colSpan": 4,
      "rowSpan": 6
    }
  },
  "spec": {
    "elements": {
      "balance": {
        "props": {
          "label": "Balance Owing",
          "value": {
            "$state": "/filemaker/get_record/fieldData/BalanceOwing"
          }
        },
        "type": "KeyValue"
      },
      "card": {
        "children": [
          "titleRow",
          "div0",
          "loading",
          "fields",
          "div1",
          "statusRow"
