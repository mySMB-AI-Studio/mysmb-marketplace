      },
      "contact": {
        "props": {
          "label": "Primary Contact",
          "value": {
            "$state": "/filemaker/get_record/fieldData/PrimaryContact"
          }
        },
        "type": "KeyValue"
      },
      "div0": {
        "props": {},
        "type": "Divider"
      },
      "div1": {
        "props": {},
        "type": "Divider"
      },
      "eyebrow": {
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "id": {
                "$state": "/filemaker/get_record/recordId"
              },
              "pattern": "FileMaker · Customers layout, record {id}"
            }
          }
        },
        "type": "Eyebrow"
      },
      "fields": {
        "children": [
          "contact",
          "phone",
          "balance"
        ],
        "props": {
          "gap": "sm"
        },
        "type": "Stack",
        "visible": {
          "$state": "/_loading/filemaker.get_record",
          "not": true
        }
      },
      "loading": {
        "children": [
          "sk1",
          "sk2",
          "sk3"
        ],
        "props": {
          "gap": "sm"
        },
        "type": "Stack",
        "visible": {
          "$state": "/_loading/filemaker.get_record"
        }
      },
      "phone": {
        "props": {
          "label": "Phone",
          "value": {
            "$state": "/filemaker/get_record/fieldData/Phone"
          }
        },
        "type": "KeyValue"
      },
      "sk1": {
        "props": {
          "height": "1.5rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "sk2": {
        "props": {
          "height": "1.5rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "sk3": {
        "props": {
          "height": "1.5rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "statusBadge": {
        "props": {
          "text": {
            "$state": "/filemaker/get_record/fieldData/Status"
          }
        },
        "type": "Badge"
      },
      "statusLabel": {
        "props": {
          "size": "sm",
          "text": "Account Status"
        },
        "type": "Text"
      },
      "statusRow": {
        "children": [
          "statusLabel",
          "statusBadge"
        ],
        "props": {
          "align": "center",
          "justify": "between"
        },
        "type": "Row",
        "visible": {
          "$state": "/_loading/filemaker.get_record",
          "not": true
        }
      },
      "title": {
        "props": {
          "level": "h2",
          "text": {
