{
  "id": "filemaker-recent-records",
  "title": "Recent Records",
  "description": "Most recently created records on a FileMaker layout, sorted newest first. Edit the layout name and column field bindings below to match your own FileMaker solution.",
  "category": "operations",
  "tags": ["filemaker", "claris", "records", "database"],
  "keywords": ["records", "recent", "layout", "filemaker", "database"],
  "connectorsUsed": ["filemaker"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 5, "rowSpan": 5 },
    "min": { "colSpan": 3, "rowSpan": 4 },
    "max": { "colSpan": 10, "rowSpan": 10 }
  },
  "dataProvider": {
    "mcp": "filemaker",
    "tool": "get_records",
    "params": {
      "layout": "Customers",
      "sort": [{ "fieldName": "CreatedDate", "sortOrder": "descend" }],
      "limit": 20
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": { "type": "Card", "props": {}, "children": ["titleRow", "div0", "body"] },
      "titleRow": { "type": "Row", "props": { "justify": "between", "align": "center" }, "children": ["titleGroup"] },
      "titleGroup": { "type": "Row", "props": { "gap": "sm", "align": "center" }, "children": ["titleIcon", "titleStack"] },
      "titleIcon": { "type": "Icon", "props": { "name": "Database", "tone": "accent", "size": "sm" } },
      "titleStack": { "type": "Stack", "props": { "gap": "none" }, "children": ["title", "eyebrow"] },
      "title": { "type": "Heading", "props": { "text": "Recent Records", "level": "h2" } },
      "eyebrow": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "FileMaker · Customers layout · {n} shown",
              "n": { "$computed": "count", "args": { "value": { "$state": "/filemaker/get_records/data" } } }
            }
          }
        }
      },

      "div0": { "type": "Divider", "props": {} },

      "body": { "type": "Body", "props": {}, "children": ["loading", "empty", "table"] },

      "loading": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["sk1", "sk2", "sk3"],
        "visible": { "$state": "/_loading/filemaker.get_records" }
      },
      "sk1": { "type": "Skeleton", "props": { "height": "2rem", "rounded": "md" } },
      "sk2": { "type": "Skeleton", "props": { "height": "2rem", "rounded": "md" } },
      "sk3": { "type": "Skeleton", "props": { "height": "2rem", "rounded": "md" } },

      "empty": {
        "type": "Empty",
        "props": { "message": "No records found on this layout." },
        "visible": {
          "$and": [
            { "$state": "/_loading/filemaker.get_records", "not": true },
            { "$state": "/filemaker/get_records/data/0", "not": true }
          ]
        }
      },

      "table": {
        "type": "Table",
        "props": {
          "loading": { "$state": "/_loading/filemaker.get_records" },
          "skeletonRows": 6,
          "rows": { "$state": "/filemaker/get_records/data" },
          "columns": [
            { "id": "name", "header": "Customer", "field": "fieldData.CustomerName", "priority": 1 },
            { "id": "created", "header": "Created", "field": "fieldData.CreatedDate", "format": "dd_mmm_yy", "width": 100, "priority": 2 },
            { "id": "status", "header": "Status", "field": "fieldData.Status", "width": 90, "priority": 2 }
          ]
        },
        "visible": { "$state": "/filemaker/get_records/data/0" }
      }
    }
  },
  "status": "published"
}
