      },
      {
        "default": 14,
        "editableBy": "manager",
        "key": "proposalValidDays",
        "max": 60,
        "min": 1,
        "type": "number"
      },
      {
        "default": 2,
        "editableBy": "manager",
        "key": "reminderDays",
        "max": 10,
        "min": 1,
        "type": "number"
      }
    ],
