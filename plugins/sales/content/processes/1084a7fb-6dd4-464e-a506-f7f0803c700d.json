{
  "contentHash": "823e09b6af1393214cb97c936ed87b9f9f3d18a270324973bd56e0d1422c7f35",
  "definition": {
    "cancellation": {
      "compensation": [
        {
          "afterStep": "clientConfirms",
          "capability": "email.send_reviewed",
          "template": "proposalWithdrawalNotice"
        }
      ]
