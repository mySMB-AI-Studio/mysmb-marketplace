{
  "apiConnectors": {
    "xero-api": {
      "displayName": "Xero API",
      "description": "Read Xero accounting data straight from the Xero API for tiles, automations and reports. Operation names and inputs match the xero-accounting connector.",
      "baseUrl": "https://api.xero.com",
      "auth": {
        "type": "oauth2",
        "authorizationServer": "https://identity.xero.com",
        "scopes": ["offline_access", "accounting.transactions.read", "accounting.contacts.read", "accounting.settings.read", "accounting.reports.read", "accounting.journals.read", "accounting.budgets.read", "accounting.attachments.read"]
      },
      "context": {
        "xero_tenant_id": {
          "in": "header",
          "name": "Xero-tenant-id",
          "required": true,
          "description": "The Xero organisation to read. One of the tenantId values from list_connections; defaults to the first.",
          "discover": { "operation": "list_connections", "valuePath": "0.tenantId" }
        }
      },
      "verify": "list_connections",
      "connection": {
        "authType": "oauth_client",
        "instructions": "Create a Web app at developer.xero.com, add this workspace's redirect URL, then paste its Client ID and Client Secret here.",
        "docUrl": "https://developer.xero.com/documentation/guides/oauth2/auth-flow",
        "fields": [
          { "name": "OAUTH_CLIENT_ID", "label": "Client ID", "type": "text", "required": true, "role": "client_id" },
          { "name": "OAUTH_CLIENT_SECRET", "label": "Client Secret", "type": "password", "required": true, "role": "client_secret" }
        ],
        "scopes": ["offline_access", "accounting.transactions.read", "accounting.contacts.read", "accounting.settings.read", "accounting.reports.read", "accounting.journals.read", "accounting.budgets.read", "accounting.attachments.read"],
        "serverClientEnv": { "clientId": "XERO_MCP_OAUTH_CLIENT_ID", "clientSecret": "XERO_MCP_OAUTH_CLIENT_SECRET" }
      },
      "operations": {
        "get_item": { "description": "Get a single Xero item by ID.", "method": "GET", "path": "/api.xro/2.0/Items/{itemId}", "effect": "read", "input": { "itemId": { "in": "path", "type": "string", "required": true } } },
        "get_user": { "description": "Get a single Xero user by ID.", "method": "GET", "path": "/api.xro/2.0/Users/{userId}", "effect": "read", "input": { "userId": { "in": "path", "type": "string", "required": true } } },
        "get_quote": { "description": "Get a single Xero quote by ID.", "method": "GET", "path": "/api.xro/2.0/Quotes/{quoteId}", "effect": "read", "input": { "quoteId": { "in": "path", "type": "string", "required": true } } },
        "get_budget": { "description": "Get a single Xero budget by ID.", "method": "GET", "path": "/api.xro/2.0/Budgets/{budgetId}", "effect": "read", "input": { "budgetId": { "in": "path", "type": "string", "required": true } } },
        "list_items": { "description": "List Xero inventory items with optional filters.", "method": "GET", "path": "/api.xro/2.0/Items", "effect": "read", "input": { "order": { "in": "query", "type": "string" }, "where": { "in": "query", "type": "string" }, "unitdp": { "in": "query", "type": "integer" } } },
        "list_users": { "description": "List Xero users on the organisation.", "method": "GET", "path": "/api.xro/2.0/Users", "effect": "read", "input": { "order": { "in": "query", "type": "string" }, "where": { "in": "query", "type": "string" } } },
        "get_account": { "description": "Get a single Xero account by ID.", "method": "GET", "path": "/api.xro/2.0/Accounts/{accountId}", "effect": "read", "input": { "accountId": { "in": "path", "type": "string", "required": true } } },
        "get_contact": { "description": "Get a single Xero contact by ID.", "method": "GET", "path": "/api.xro/2.0/Contacts/{contactId}", "effect": "read", "input": { "contactId": { "in": "path", "type": "string", "required": true } } },
        "get_invoice": { "description": "Get a single Xero invoice by ID.", "method": "GET", "path": "/api.xro/2.0/Invoices/{invoiceId}", "effect": "read", "input": { "invoiceId": { "in": "path", "type": "string", "required": true } } },
        "get_payment": { "description": "Get a single Xero payment by ID.", "method": "GET", "path": "/api.xro/2.0/Payments/{paymentId}", "effect": "read", "input": { "paymentId": { "in": "path", "type": "string", "required": true } } },
        "get_receipt": { "description": "Get a single Xero receipt by ID.", "method": "GET", "path": "/api.xro/2.0/Receipts/{receiptId}", "effect": "read", "input": { "receiptId": { "in": "path", "type": "string", "required": true } } },
        "list_quotes": { "description": "List Xero quotes with optional filters.", "method": "GET", "path": "/api.xro/2.0/Quotes", "effect": "read", "input": { "page": { "in": "query", "type": "integer" }, "order": { "in": "query", "type": "string" }, "dateTo": { "in": "query", "type": "string" }, "status": { "in": "query", "type": "string" }, "dateFrom": { "in": "query", "type": "string" }, "contactID": { "in": "query", "type": "string" }, "expiryDateTo": { "in": "query", "type": "string" }, "expiryDateFrom": { "in": "query", "type": "string" } } },
        "get_employee": { "description": "Get a single Xero employee by ID.", "method": "GET", "path": "/api.xro/2.0/Employees/{employeeId}", "effect": "read", "input": { "employeeId": { "in": "path", "type": "string", "required": true } } },
        "list_budgets": { "description": "List Xero budgets with optional filters.", "method": "GET", "path": "/api.xro/2.0/Budgets", "effect": "read", "input": { "dateTo": { "in": "query", "type": "string" }, "dateFrom": { "in": "query", "type": "string" } } },
        "list_history": { "description": "List the history and notes on a Xero record.", "method": "GET", "path": "/api.xro/2.0/{hostType}/{hostId}/History", "effect": "read", "input": { "hostId": { "in": "path", "type": "string", "required": true, "description": "The record's ID." }, "hostType": { "in": "path", "type": "string", "required": true, "description": "The kind of record.", "enum": ["Invoices", "CreditNotes", "BankTransactions", "BankTransfers", "Contacts", "PurchaseOrders", "Quotes", "Receipts", "ExpenseClaims", "ManualJournals", "RepeatingInvoices", "Payments", "Overpayments", "Prepayments", "Items"] } } },
        "list_accounts": { "description": "List Xero chart of accounts with optional filters.", "method": "GET", "path": "/api.xro/2.0/Accounts", "effect": "read", "input": { "order": { "in": "query", "type": "string" }, "where": { "in": "query", "type": "string" } } },
        "list_contacts": { "description": "List Xero contacts with optional filters.", "method": "GET", "path": "/api.xro/2.0/Contacts", "effect": "read", "input": { "ids": { "in": "query", "type": "string" }, "page": { "in": "query", "type": "integer" }, "order": { "in": "query", "type": "string" }, "where": { "in": "query", "type": "string" }, "searchTerm": { "in": "query", "type": "string" }, "summaryOnly": { "in": "query", "type": "boolean" }, "includeArchived": { "in": "query", "type": "boolean" } } },
        "list_invoices": { "description": "List Xero invoices with optional filters (status, contact, date, etc).", "method": "GET", "path": "/api.xro/2.0/Invoices", "effect": "read", "input": { "ids": { "in": "query", "type": "string" }, "page": { "in": "query", "type": "integer" }, "order": { "in": "query", "type": "string" }, "where": { "in": "query", "type": "string" }, "statuses": { "in": "query", "type": "string" }, "contactIDs": { "in": "query", "type": "string" }, "searchTerm": { "in": "query", "type": "string" }, "summaryOnly": { "in": "query", "type": "boolean" }, "createdByMyApp": { "in": "query", "type": "boolean" }, "invoiceNumbers": { "in": "query", "type": "string" }, "includeArchived": { "in": "query", "type": "boolean" } } },
        "list_journals": { "description": "List Xero journals (read-only general ledger entries) with optional offset pagination.", "method": "GET", "path": "/api.xro/2.0/Journals", "effect": "read", "input": { "offset": { "in": "query", "type": "integer" }, "paymentsOnly": { "in": "query", "type": "boolean" } } },
        "list_payments": { "description": "List Xero payments with optional filters.", "method": "GET", "path": "/api.xro/2.0/Payments", "effect": "read", "input": { "page": { "in": "query", "type": "integer" }, "order": { "in": "query", "type": "string" }, "where": { "in": "query", "type": "string" } } },
        "list_receipts": { "description": "List Xero receipts (spent-money records awaiting reimbursement via expense claim).", "method": "GET", "path": "/api.xro/2.0/Receipts", "effect": "read", "input": { "page": { "in": "query", "type": "integer" }, "order": { "in": "query", "type": "string" }, "where": { "in": "query", "type": "string" } } },
        "get_prepayment": { "description": "Get a single Xero prepayment by ID.", "method": "GET", "path": "/api.xro/2.0/Prepayments/{prepaymentId}", "effect": "read", "input": { "prepaymentId": { "in": "path", "type": "string", "required": true } } },
        "list_employees": { "description": "List Xero employees with optional filters.", "method": "GET", "path": "/api.xro/2.0/Employees", "effect": "read", "input": { "order": { "in": "query", "type": "string" }, "where": { "in": "query", "type": "string" } } },
        "list_tax_rates": { "description": "List Xero tax rates with optional filters.", "method": "GET", "path": "/api.xro/2.0/TaxRates", "effect": "read", "input": { "order": { "in": "query", "type": "string" }, "where": { "in": "query", "type": "string" } } },
        "get_credit_note": { "description": "Get a single Xero credit note by ID.", "method": "GET", "path": "/api.xro/2.0/CreditNotes/{creditNoteId}", "effect": "read", "input": { "creditNoteId": { "in": "path", "type": "string", "required": true } } },
        "get_overpayment": { "description": "Get a single Xero overpayment by ID.", "method": "GET", "path": "/api.xro/2.0/Overpayments/{overpaymentId}", "effect": "read", "input": { "overpaymentId": { "in": "path", "type": "string", "required": true } } },
        "list_currencies": { "description": "List currencies configured on the Xero organisation.", "method": "GET", "path": "/api.xro/2.0/Currencies", "effect": "read" },
        "get_bank_summary": { "description": "Fetch Xero Bank Summary report for a date range.", "method": "GET", "path": "/api.xro/2.0/Reports/BankSummary", "effect": "read", "input": { "toDate": { "in": "query", "type": "string" }, "fromDate": { "in": "query", "type": "string" } } },
        "get_organisation": { "description": "Get Xero organisation details for the currently selected tenant.", "method": "GET", "path": "/api.xro/2.0/Organisation", "effect": "read" },
        "list_attachments": { "description": "List the attachments on a Xero record.", "method": "GET", "path": "/api.xro/2.0/{hostType}/{hostId}/Attachments", "effect": "read", "input": { "hostId": { "in": "path", "type": "string", "required": true, "description": "The record's ID." }, "hostType": { "in": "path", "type": "string", "required": true, "description": "The kind of record.", "enum": ["Accounts", "BankTransfers", "Invoices", "CreditNotes", "BankTransactions", "Receipts", "ManualJournals", "Contacts", "RepeatingInvoices", "PurchaseOrders"] } } },
        "list_connections": { "description": "List the Xero organisations this connection can reach. Each has a tenantId to pass as xero_tenant_id.", "method": "GET", "path": "/connections", "effect": "read", "context": false },
        "list_prepayments": { "description": "List Xero prepayments with optional filters.", "method": "GET", "path": "/api.xro/2.0/Prepayments", "effect": "read", "input": { "page": { "in": "query", "type": "integer" }, "order": { "in": "query", "type": "string" }, "where": { "in": "query", "type": "string" } } },
        "get_balance_sheet": { "description": "Fetch Xero Balance Sheet report as of a given date.", "method": "GET", "path": "/api.xro/2.0/Reports/BalanceSheet", "effect": "read", "input": { "date": { "in": "query", "type": "string" }, "periods": { "in": "query", "type": "integer" }, "timeframe": { "in": "query", "type": "string", "enum": ["MONTH", "QUARTER", "YEAR"] }, "paymentsOnly": { "in": "query", "type": "boolean" }, "standardLayout": { "in": "query", "type": "boolean" }, "trackingOptionID1": { "in": "query", "type": "string" }, "trackingOptionID2": { "in": "query", "type": "string" } } },
        "get_bank_transfer": { "description": "Get a single Xero bank transfer by ID.", "method": "GET", "path": "/api.xro/2.0/BankTransfers/{bankTransferId}", "effect": "read", "input": { "bankTransferId": { "in": "path", "type": "string", "required": true } } },
        "get_batch_payment": { "description": "Get a single batch payment by ID, including all constituent payments.", "method": "GET", "path": "/api.xro/2.0/BatchPayments/{batchPaymentId}", "effect": "read", "input": { "batchPaymentId": { "in": "path", "type": "string", "required": true } } },
        "get_contact_group": { "description": "Get a single Xero contact group by ID, including its contacts.", "method": "GET", "path": "/api.xro/2.0/ContactGroups/{contactGroupId}", "effect": "read", "input": { "contactGroupId": { "in": "path", "type": "string", "required": true } } },
        "get_expense_claim": { "description": "Get a single Xero expense claim by ID.", "method": "GET", "path": "/api.xro/2.0/ExpenseClaims/{expenseClaimId}", "effect": "read", "input": { "expenseClaimId": { "in": "path", "type": "string", "required": true } } },
        "get_trial_balance": { "description": "Fetch Xero Trial Balance report as of a given date.", "method": "GET", "path": "/api.xro/2.0/Reports/TrialBalance", "effect": "read", "input": { "date": { "in": "query", "type": "string" }, "paymentsOnly": { "in": "query", "type": "boolean" } } },
        "list_credit_notes": { "description": "List Xero credit notes with optional filters.", "method": "GET", "path": "/api.xro/2.0/CreditNotes", "effect": "read", "input": { "page": { "in": "query", "type": "integer" }, "order": { "in": "query", "type": "string" }, "where": { "in": "query", "type": "string" } } },
        "list_overpayments": { "description": "List Xero overpayments with optional filters.", "method": "GET", "path": "/api.xro/2.0/Overpayments", "effect": "read", "input": { "page": { "in": "query", "type": "integer" }, "order": { "in": "query", "type": "string" }, "where": { "in": "query", "type": "string" } } },
        "get_budget_summary": { "description": "Fetch Xero Budget Summary report.", "method": "GET", "path": "/api.xro/2.0/Reports/BudgetSummary", "effect": "read", "input": { "date": { "in": "query", "type": "string" }, "periods": { "in": "query", "type": "integer" }, "timeframe": { "in": "query", "type": "integer" } } },
        "get_manual_journal": { "description": "Get a single Xero manual journal by ID.", "method": "GET", "path": "/api.xro/2.0/ManualJournals/{manualJournalId}", "effect": "read", "input": { "manualJournalId": { "in": "path", "type": "string", "required": true } } },
        "get_purchase_order": { "description": "Get a single Xero purchase order by ID.", "method": "GET", "path": "/api.xro/2.0/PurchaseOrders/{purchaseOrderId}", "effect": "read", "input": { "purchaseOrderId": { "in": "path", "type": "string", "required": true } } },
        "get_profit_and_loss": { "description": "Fetch Xero Profit and Loss report for a date range.", "method": "GET", "path": "/api.xro/2.0/Reports/ProfitAndLoss", "effect": "read", "input": { "toDate": { "in": "query", "type": "string" }, "periods": { "in": "query", "type": "integer" }, "fromDate": { "in": "query", "type": "string" }, "timeframe": { "in": "query", "type": "string", "enum": ["MONTH", "QUARTER", "YEAR"] }, "paymentsOnly": { "in": "query", "type": "boolean" }, "standardLayout": { "in": "query", "type": "boolean" }, "trackingOptionID": { "in": "query", "type": "string" }, "trackingOptionID2": { "in": "query", "type": "string" }, "trackingCategoryID": { "in": "query", "type": "string" }, "trackingCategoryID2": { "in": "query", "type": "string" } } },
        "list_bank_transfers": { "description": "List Xero bank transfers with optional filters.", "method": "GET", "path": "/api.xro/2.0/BankTransfers", "effect": "read", "input": { "order": { "in": "query", "type": "string" }, "where": { "in": "query", "type": "string" } } },
        "list_batch_payments": { "description": "List Xero batch payments with optional filters.", "method": "GET", "path": "/api.xro/2.0/BatchPayments", "effect": "read", "input": { "page": { "in": "query", "type": "integer" }, "order": { "in": "query", "type": "string" }, "where": { "in": "query", "type": "string" } } },
        "list_contact_groups": { "description": "List all Xero contact groups.", "method": "GET", "path": "/api.xro/2.0/ContactGroups", "effect": "read" },
        "list_expense_claims": { "description": "List Xero expense claims with optional filters.", "method": "GET", "path": "/api.xro/2.0/ExpenseClaims", "effect": "read", "input": { "page": { "in": "query", "type": "integer" }, "order": { "in": "query", "type": "string" }, "where": { "in": "query", "type": "string" } } },
        "get_bank_transaction": { "description": "Get a single Xero bank transaction by ID.", "method": "GET", "path": "/api.xro/2.0/BankTransactions/{bankTransactionId}", "effect": "read", "input": { "bankTransactionId": { "in": "path", "type": "string", "required": true } } },
        "list_branding_themes": { "description": "List Xero invoice branding themes available on the organisation.", "method": "GET", "path": "/api.xro/2.0/BrandingThemes", "effect": "read" },
        "list_manual_journals": { "description": "List Xero manual journals with optional filters.", "method": "GET", "path": "/api.xro/2.0/ManualJournals", "effect": "read", "input": { "page": { "in": "query", "type": "integer" }, "order": { "in": "query", "type": "string" }, "where": { "in": "query", "type": "string" } } },
        "list_purchase_orders": { "description": "List Xero purchase orders with optional filters.", "method": "GET", "path": "/api.xro/2.0/PurchaseOrders", "effect": "read", "input": { "page": { "in": "query", "type": "integer" }, "order": { "in": "query", "type": "string" }, "where": { "in": "query", "type": "string" }, "dateTo": { "in": "query", "type": "string" }, "status": { "in": "query", "type": "string" }, "dateFrom": { "in": "query", "type": "string" } } },
        "get_executive_summary": { "description": "Fetch Xero Executive Summary report.", "method": "GET", "path": "/api.xro/2.0/Reports/ExecutiveSummary", "effect": "read", "input": { "date": { "in": "query", "type": "string" } } },
        "get_repeating_invoice": { "description": "Get a single Xero repeating invoice template by ID.", "method": "GET", "path": "/api.xro/2.0/RepeatingInvoices/{repeatingInvoiceId}", "effect": "read", "input": { "repeatingInvoiceId": { "in": "path", "type": "string", "required": true } } },
        "get_tracking_category": { "description": "Get a single Xero tracking category by ID.", "method": "GET", "path": "/api.xro/2.0/TrackingCategories/{trackingCategoryId}", "effect": "read", "input": { "trackingCategoryId": { "in": "path", "type": "string", "required": true } } },
        "list_payment_services": { "description": "List Xero payment services (online payment methods available on invoices).", "method": "GET", "path": "/api.xro/2.0/PaymentServices", "effect": "read" },
        "get_linked_transaction": { "description": "Get a single linked transaction by ID.", "method": "GET", "path": "/api.xro/2.0/LinkedTransactions/{linkedTransactionId}", "effect": "read", "input": { "linkedTransactionId": { "in": "path", "type": "string", "required": true } } },
        "list_bank_transactions": { "description": "List Xero bank transactions with optional filters. A count of transactions with IsReconciled==false is NOT Xero's \\\"Reconcile N items\\\" figure: that counts bank statement lines (from the bank feed) not yet matched, which the Accounting API does not expose. IsReconciled==false counts entries recorded in Xero that no statement line has matched yet, so the two numbers differ (often by a lot). Label such a count \\\"Unreconciled transactions in Xero\\\", never \\\"Reconcile items\\\" or \\\"Items to reconcile\\\".", "method": "GET", "path": "/api.xro/2.0/BankTransactions", "effect": "read", "input": { "page": { "in": "query", "type": "integer" }, "order": { "in": "query", "type": "string" }, "where": { "in": "query", "type": "string" }, "unitdp": { "in": "query", "type": "integer" } } },
        "list_repeating_invoices": { "description": "List Xero repeating invoice templates.", "method": "GET", "path": "/api.xro/2.0/RepeatingInvoices", "effect": "read", "input": { "order": { "in": "query", "type": "string" }, "where": { "in": "query", "type": "string" } } },
        "get_organisation_actions": { "description": "List actions the authenticated user can perform against the Xero organisation.", "method": "GET", "path": "/api.xro/2.0/Organisation/Actions", "effect": "read" },
        "list_linked_transactions": { "description": "List Xero linked transactions. Each links a line on a bill (ACCPAY) to an invoice (ACCREC) for billable-expense passthrough.", "method": "GET", "path": "/api.xro/2.0/LinkedTransactions", "effect": "read", "input": { "page": { "in": "query", "type": "integer" }, "status": { "in": "query", "name": "Status", "type": "string", "enum": ["APPROVED", "DRAFT", "ONDRAFT", "BILLED", "VOIDED"] }, "sourceTransactionId": { "in": "query", "name": "SourceTransactionID", "type": "string", "description": "Filter by bill InvoiceID." }, "targetTransactionId": { "in": "query", "name": "TargetTransactionID", "type": "string", "description": "Filter by invoice InvoiceID." } } },
        "list_tracking_categories": { "description": "List Xero tracking categories with optional filters.", "method": "GET", "path": "/api.xro/2.0/TrackingCategories", "effect": "read", "input": { "order": { "in": "query", "type": "string" }, "where": { "in": "query", "type": "string" }, "includeArchived": { "in": "query", "type": "boolean" } } },
        "get_aged_payables_by_contact": { "description": "Fetch Xero Aged Payables by Contact report.", "method": "GET", "path": "/api.xro/2.0/Reports/AgedPayablesByContact", "effect": "read", "input": { "date": { "in": "query", "type": "string" }, "toDate": { "in": "query", "type": "string" }, "fromDate": { "in": "query", "type": "string" }, "contactID": { "in": "query", "type": "string" } } },
        "get_aged_receivables_by_contact": { "description": "Fetch Xero Aged Receivables by Contact report.", "method": "GET", "path": "/api.xro/2.0/Reports/AgedReceivablesByContact", "effect": "read", "input": { "date": { "in": "query", "type": "string" }, "toDate": { "in": "query", "type": "string" }, "fromDate": { "in": "query", "type": "string" }, "contactID": { "in": "query", "type": "string" } } }
      }
    }
  }
}
