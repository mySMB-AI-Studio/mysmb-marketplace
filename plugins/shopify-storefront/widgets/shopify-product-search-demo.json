{
  "id": "shopify-product-search-demo",
  "title": "Product Search (Demo)",
  "description": "Sample Shopify product search tile — static dummy data, no connection required.",
  "category": "ecommerce",
  "tags": ["shopify", "products", "catalog", "search", "ecommerce", "demo"],
  "keywords": ["products", "catalog", "search", "shopify", "inventory", "store", "demo"],
  "connectorsUsed": [],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 6, "rowSpan": 6 },
    "min": { "colSpan": 4, "rowSpan": 4 },
    "max": { "colSpan": 12, "rowSpan": 12 }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": { "type": "Card", "children": ["header", "body"] },
      "header": { "type": "Header", "children": ["titleRow"] },
      "titleRow": {
        "type": "Row",
        "props": { "gap": "sm", "align": "start" },
        "children": ["titleIcon", "titleStack", "demoBadge"]
      },
      "titleIcon": { "type": "Icon", "props": { "name": "ShoppingBag", "tone": "accent", "size": "sm" } },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "count"]
      },
      "title": { "type": "Heading", "props": { "text": "Product Search", "level": "h2" } },
      "count": { "type": "Eyebrow", "props": { "text": "4 products" } },
      "demoBadge": { "type": "Badge", "props": { "text": "Demo", "tone": "warning", "variant": "soft" } },
      "body": { "type": "Body", "children": ["list"] },
      "list": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["p1", "p2", "p3", "p4"]
      },

      "p1": {
        "type": "Row",
        "props": { "gap": "sm", "justify": "between", "align": "center", "hover": true },
        "children": ["p1left", "p1price"]
      },
      "p1left": { "type": "Stack", "props": { "gap": "xs", "grow": true }, "children": ["p1title", "p1vendor"] },
      "p1title": { "type": "Text", "props": { "text": "Premium Leather Wallet", "size": "md", "weight": "medium", "truncate": true } },
      "p1vendor": { "type": "Caption", "props": { "text": "Artisan Co." } },
      "p1price": { "type": "Text", "props": { "text": "49.00 AUD", "size": "sm", "weight": "semibold", "tone": "muted" } },

      "p2": {
        "type": "Row",
        "props": { "gap": "sm", "justify": "between", "align": "center", "hover": true },
        "children": ["p2left", "p2price"]
      },
      "p2left": { "type": "Stack", "props": { "gap": "xs", "grow": true }, "children": ["p2title", "p2vendor"] },
      "p2title": { "type": "Text", "props": { "text": "Wireless Earbuds Pro", "size": "md", "weight": "medium", "truncate": true } },
      "p2vendor": { "type": "Caption", "props": { "text": "TechGear" } },
      "p2price": { "type": "Text", "props": { "text": "129.00 AUD", "size": "sm", "weight": "semibold", "tone": "muted" } },

      "p3": {
        "type": "Row",
        "props": { "gap": "sm", "justify": "between", "align": "center", "hover": true },
        "children": ["p3left", "p3price"]
      },
      "p3left": { "type": "Stack", "props": { "gap": "xs", "grow": true }, "children": ["p3title", "p3vendor"] },
      "p3title": { "type": "Text", "props": { "text": "Organic Face Serum", "size": "md", "weight": "medium", "truncate": true } },
      "p3vendor": { "type": "Caption", "props": { "text": "NaturalGlow" } },
      "p3price": { "type": "Text", "props": { "text": "34.00 AUD", "size": "sm", "weight": "semibold", "tone": "muted" } },

      "p4": {
        "type": "Row",
        "props": { "gap": "sm", "justify": "between", "align": "center", "hover": true },
        "children": ["p4left", "p4price"]
      },
      "p4left": { "type": "Stack", "props": { "gap": "xs", "grow": true }, "children": ["p4title", "p4vendor"] },
      "p4title": { "type": "Text", "props": { "text": "Stainless Steel Water Bottle", "size": "md", "weight": "medium", "truncate": true } },
      "p4vendor": { "type": "Caption", "props": { "text": "EcoLife" } },
      "p4price": { "type": "Text", "props": { "text": "28.00 AUD", "size": "sm", "weight": "semibold", "tone": "muted" } }
    }
  },
  "status": "published"
}
