{
  "id": "shopify-product-search",
  "title": "Product Catalog",
  "description": "Browse active Shopify products sorted A–Z. Filter by name using the search bar. Click column headers to sort.",
  "category": "ecommerce",
  "tags": [
    "shopify",
    "products",
    "catalog",
    "search",
    "ecommerce"
  ],
  "keywords": [
    "products",
    "catalog",
    "search",
    "shopify",
    "inventory",
    "store"
  ],
  "connectorsUsed": [
    "shopify-ucp"
  ],
  "popularity": 0,
  "sizing": {
    "preferred": {
      "colSpan": 8,
      "rowSpan": 6
    },
    "min": {
      "colSpan": 6,
      "rowSpan": 4
    },
    "max": {
      "colSpan": 12,
      "rowSpan": 12
    }
  },
  "dataProvider": {
    "mcp": "shopify-ucp",
    "tool": "search_catalog",
    "params": {
      "query": "status:active",
      "pagination": {
        "limit": 25
      },
      "meta": {
        "ucp-agent": {
          "profile": "https://shopify.dev/ucp/agent-profiles/examples/2026-04-08/valid-with-capabilities.json"
        }
      }
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "children": [
          "header",
          "body"
        ]
      },
      "header": {
        "type": "Header",
        "children": [
          "titleRow"
        ]
      },
      "titleRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "start"
        },
        "children": [
          "titleIcon",
          "titleStack"
        ]
      },
      "titleIcon": {
        "type": "Icon",
        "props": {
          "name": "ShoppingBag",
          "tone": "accent",
          "size": "sm"
        }
      },
      "titleStack": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "children": [
          "title",
          "count"
        ]
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "Product Catalog",
          "level": "h2"
        }
      },
      "count": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{n} active · {oos} out of stock",
              "n": {
                "$computed": "count",
                "args": {
                  "value": {
                    "$state": "/shopify-ucp/search_catalog/products"
                  }
                }
              },
              "oos": {
                "$computed": "count_where",
                "args": {
                  "value": {
                    "$state": "/shopify-ucp/search_catalog/products"
                  },
                  "whereField": "totalInventory",
                  "equals": 0
                }
              }
            }
          }
        }
      },
      "body": {
        "type": "Body",
        "children": [
          "searchRow",
          "loading",
          "empty",
          "table"
        ]
      },
      "searchRow": {
        "type": "Row",
        "props": {
          "gap": "sm"
        },
        "visible": {
          "$state": "/_loading/shopify-ucp.search_catalog",
          "not": true
        },
        "children": [
          "searchInput"
        ]
      },
      "searchInput": {
        "type": "TextInput",
        "props": {
          "value": {
            "$bindState": "/ui/search"
          },
          "placeholder": "Filter by product name...",
          "size": "sm",
          "debounce": 150
        }
      },
      "loading": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "visible": {
          "$state": "/_loading/shopify-ucp.search_catalog"
        },
        "children": [
          "sk1",
          "sk2",
          "sk3",
          "sk4"
        ]
      },
      "sk1": {
        "type": "Skeleton",
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        }
      },
      "sk2": {
        "type": "Skeleton",
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        }
      },
      "sk3": {
        "type": "Skeleton",
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        }
      },
      "sk4": {
        "type": "Skeleton",
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        }
      },
      "empty": {
        "type": "Empty",
        "props": {
          "message": "No active products found in your Shopify store."
        },
        "visible": {
          "$and": [
            {
              "$state": "/_loading/shopify-ucp.search_catalog",
              "not": true
            },
            {
              "$state": "/shopify-ucp/search_catalog/products/0",
              "not": true
            }
          ]
        }
      },
      "table": {
        "type": "Table",
        "props": {
          "rows": {
            "$computed": "filter_by",
            "args": {
              "value": {
                "$state": "/shopify-ucp/search_catalog/products"
              },
              "field": "titleLower",
              "startsWith": {
                "$state": "/ui/search"
              }
            }
          },
          "columns": [
            {
              "id": "name",
              "header": "Product",
              "field": "title",
              "priority": 1
            },
            {
              "id": "vendor",
              "header": "Vendor",
              "field": "vendor",
              "priority": 2
            },
            {
              "id": "stock",
              "header": "Stock",
              "field": "stockStatus",
              "width": 120,
              "priority": 2
            },
            {
              "id": "price",
              "header": "Price",
              "field": "price",
              "width": 110,
              "priority": 1
            }
          ]
        },
        "visible": {
          "$state": "/_loading/shopify-ucp.search_catalog",
          "not": true
        }
      }
    }
  },
  "status": "published"
}
