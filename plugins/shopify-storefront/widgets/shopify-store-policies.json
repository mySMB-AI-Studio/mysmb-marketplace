{
  "id": "shopify-store-policies",
  "title": "Store Policies",
  "description": "View your Shopify store policies — returns, shipping, privacy, and terms. Select a policy to display it.",
  "category": "ecommerce",
  "tags": [
    "shopify",
    "policies",
    "returns",
    "shipping",
    "faq",
    "ecommerce"
  ],
  "keywords": [
    "policies",
    "returns",
    "refund",
    "shipping",
    "faq",
    "shopify",
    "help"
  ],
  "connectorsUsed": [
    "shopify-storefront"
  ],
  "popularity": 0,
  "sizing": {
    "preferred": {
      "colSpan": 6,
      "rowSpan": 5
    },
    "min": {
      "colSpan": 4,
      "rowSpan": 3
    },
    "max": {
      "colSpan": 12,
      "rowSpan": 10
    }
  },
  "dataProvider": {
    "mcp": "shopify-storefront",
    "tool": "search_shop_policies_and_faqs",
    "params": {
      "query": "return policy"
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "children": [
          "header",
          "body"
        ],
        "watch": {
          "/ui/selectedPolicy": [
            {
              "action": "bust_tool_cache",
              "params": {
                "mcp": "shopify-storefront",
                "tool": "search_shop_policies_and_faqs"
              }
            },
            {
              "action": "shopify-storefront.search_shop_policies_and_faqs",
              "params": {
                "query": {
                  "$state": "/ui/selectedPolicy"
                }
              }
            }
          ]
        }
      },
      "header": {
        "type": "Header",
        "children": [
          "titleRow"
        ]
      },
      "titleRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "start"
        },
        "children": [
          "titleIcon",
          "titleStack"
        ]
      },
      "titleIcon": {
        "type": "Icon",
        "props": {
          "name": "FileText",
          "tone": "accent",
          "size": "sm"
        }
      },
      "titleStack": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "children": [
          "title",
          "eyebrow"
        ]
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "Store Policies",
          "level": "h2"
        }
      },
      "eyebrow": {
        "type": "Eyebrow",
        "props": {
          "text": "Select a policy to view it"
        }
      },
      "body": {
        "type": "Body",
        "children": [
          "policyPicker",
          "loading",
          "empty",
          "content"
        ]
      },
      "policyPicker": {
        "type": "Select",
        "props": {
          "value": {
            "$bindState": "/ui/selectedPolicy"
          },
          "placeholder": "Choose a policy...",
          "options": [
            { "label": "Return Policy", "value": "return policy" },
            { "label": "Shipping Policy", "value": "shipping policy" },
            { "label": "Privacy Policy", "value": "privacy policy" },
            { "label": "Terms of Service", "value": "terms of service" }
          ]
        }
      },
      "loading": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "visible": {
          "$state": "/_loading/shopify-storefront.search_shop_policies_and_faqs"
        },
        "children": [
          "sk1",
          "sk2",
          "sk3"
        ]
      },
      "sk1": {
        "type": "Skeleton",
        "props": {
          "height": "1.25rem",
          "rounded": "sm"
        }
      },
      "sk2": {
        "type": "Skeleton",
        "props": {
          "height": "1.25rem",
          "rounded": "sm"
        }
      },
      "sk3": {
        "type": "Skeleton",
        "props": {
          "height": "1.25rem",
          "rounded": "sm"
        }
      },
      "empty": {
        "type": "Empty",
        "props": {
          "message": "Select a policy above to view it."
        },
        "visible": {
          "$and": [
            {
              "$state": "/_loading/shopify-storefront.search_shop_policies_and_faqs",
              "not": true
            },
            {
              "$state": "/shopify-storefront/search_shop_policies_and_faqs/answer",
              "not": true
            }
          ]
        }
      },
      "content": {
        "type": "RichHtml",
        "props": {
          "html": {
            "$state": "/shopify-storefront/search_shop_policies_and_faqs/answer"
          },
          "maxHeight": 420
        },
        "visible": {
          "$and": [
            {
              "$state": "/_loading/shopify-storefront.search_shop_policies_and_faqs",
              "not": true
            },
            {
              "$state": "/shopify-storefront/search_shop_policies_and_faqs/answer"
            }
          ]
        }
      }
    }
  },
  "status": "published"
}
