{
  "id": "shopify-store-policies",
  "title": "Store Policies",
  "description": "Surface key Shopify store policies and FAQ answers — returns, shipping, privacy, and more. Configurable query.",
  "category": "ecommerce",
  "tags": [
    "shopify",
    "policies",
    "returns",
    "shipping",
    "faq",
    "ecommerce"
  ],
  "keywords": [
    "policies",
    "returns",
    "refund",
    "shipping",
    "faq",
    "shopify",
    "help"
  ],
  "connectorsUsed": [
    "shopify-storefront"
  ],
  "popularity": 0,
  "sizing": {
    "preferred": {
      "colSpan": 6,
      "rowSpan": 4
    },
    "min": {
      "colSpan": 4,
      "rowSpan": 3
    },
    "max": {
      "colSpan": 12,
      "rowSpan": 8
    }
  },
  "dataProvider": {
    "mcp": "shopify-storefront",
    "tool": "search_shop_policies_and_faqs",
    "params": {
      "query": "return policy"
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "children": [
          "header",
          "body"
        ]
      },
      "header": {
        "type": "Header",
        "children": [
          "titleRow"
        ]
      },
      "titleRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "start"
        },
        "children": [
          "titleIcon",
          "titleStack"
        ]
      },
      "titleIcon": {
        "type": "Icon",
        "props": {
          "name": "FileText",
          "tone": "accent",
          "size": "sm"
        }
      },
      "titleStack": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "children": [
          "title",
          "eyebrow"
        ]
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "Store Policies",
          "level": "h2"
        }
      },
      "eyebrow": {
        "type": "Eyebrow",
        "props": {
          "text": "Policies and FAQs from your Shopify store"
        }
      },
      "body": {
        "type": "Body",
        "children": [
          "loading",
          "empty",
          "content"
        ]
      },
      "loading": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "visible": {
          "$state": "/_loading/shopify-storefront.search_shop_policies_and_faqs"
        },
        "children": [
          "sk1",
          "sk2",
          "sk3"
        ]
      },
      "sk1": {
        "type": "Skeleton",
        "props": {
          "height": "1.25rem",
          "rounded": "sm"
        }
      },
      "sk2": {
        "type": "Skeleton",
        "props": {
          "height": "1.25rem",
          "rounded": "sm"
        }
      },
      "sk3": {
        "type": "Skeleton",
        "props": {
          "height": "1.25rem",
          "rounded": "sm"
        }
      },
      "empty": {
        "type": "Empty",
        "props": {
          "message": "No policy information found for this query."
        },
        "visible": {
          "$and": [
            {
              "$state": "/_loading/shopify-storefront.search_shop_policies_and_faqs",
              "not": true
            },
            {
              "$state": "/shopify-storefront/search_shop_policies_and_faqs/answer",
              "not": true
            }
          ]
        }
      },
      "content": {
        "type": "Text",
        "props": {
          "text": {
            "$state": "/shopify-storefront/search_shop_policies_and_faqs/answer"
          },
          "wrap": true
        },
        "visible": {
          "$state": "/_loading/shopify-storefront.search_shop_policies_and_faqs",
          "not": true
        }
      }
    }
  }
}
