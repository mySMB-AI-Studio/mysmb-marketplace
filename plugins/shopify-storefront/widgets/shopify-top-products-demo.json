      "t6": { "type": "Section", "props": { "variant": "bordered" }, "children": ["t6name", "t6vendor", "t6price"] },
      "t6name": { "type": "Text", "props": { "text": "Coffee Blend — Dark Roast", "size": "sm", "weight": "semibold", "truncate": true } },
      "t6vendor": { "type": "Caption", "props": { "text": "BrewHouse" } },
      "t6price": { "type": "Text", "props": { "text": "22.00 AUD", "size": "sm", "weight": "medium", "tone": "accent" } }
    }
  },
  "status": "published"
}
