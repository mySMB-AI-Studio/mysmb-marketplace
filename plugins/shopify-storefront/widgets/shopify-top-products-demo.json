{
  "id": "shopify-top-products-demo",
  "title": "Top Products (Demo)",
  "description": "Sample Shopify top products tile in a grid — static dummy data, no connection required.",
  "category": "ecommerce",
  "tags": ["shopify", "products", "catalog", "featured", "bestseller", "ecommerce", "demo"],
  "keywords": ["products", "bestseller", "featured", "catalog", "shopify", "top", "popular", "grid", "demo"],
  "connectorsUsed": [],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 8, "rowSpan": 6 },
    "min": { "colSpan": 6, "rowSpan": 4 },
    "max": { "colSpan": 12, "rowSpan": 10 }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": { "type": "Card", "children": ["header", "body"] },
      "header": { "type": "Header", "children": ["titleRow"] },
      "titleRow": {
        "type": "Row",
        "props": { "gap": "sm", "align": "start" },
        "children": ["titleIcon", "titleStack", "demoBadge"]
      },
      "titleIcon": { "type": "Icon", "props": { "name": "Star", "tone": "accent", "size": "sm" } },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "eyebrow"]
      },
      "title": { "type": "Heading", "props": { "text": "Top Products", "level": "h2" } },
      "eyebrow": { "type": "Eyebrow", "props": { "text": "6 products" } },
      "demoBadge": { "type": "Badge", "props": { "text": "Demo", "tone": "warning", "variant": "soft" } },
      "body": { "type": "Body", "children": ["grid"] },
      "grid": {
        "type": "Grid",
        "props": { "cols": 3, "gap": "md" },
        "children": ["t1", "t2", "t3", "t4", "t5", "t6"]
      },

      "t1": { "type": "Section", "props": { "variant": "bordered" }, "children": ["t1name", "t1vendor", "t1price"] },
      "t1name": { "type": "Text", "props": { "text": "Premium Leather Wallet", "size": "sm", "weight": "semibold", "truncate": true } },
      "t1vendor": { "type": "Caption", "props": { "text": "Artisan Co." } },
      "t1price": { "type": "Text", "props": { "text": "49.00 AUD", "size": "sm", "weight": "medium", "tone": "accent" } },

      "t2": { "type": "Section", "props": { "variant": "bordered" }, "children": ["t2name", "t2vendor", "t2price"] },
      "t2name": { "type": "Text", "props": { "text": "Wireless Earbuds Pro", "size": "sm", "weight": "semibold", "truncate": true } },
      "t2vendor": { "type": "Caption", "props": { "text": "TechGear" } },
      "t2price": { "type": "Text", "props": { "text": "129.00 AUD", "size": "sm", "weight": "medium", "tone": "accent" } },

      "t3": { "type": "Section", "props": { "variant": "bordered" }, "children": ["t3name", "t3vendor", "t3price"] },
      "t3name": { "type": "Text", "props": { "text": "Organic Face Serum", "size": "sm", "weight": "semibold", "truncate": true } },
      "t3vendor": { "type": "Caption", "props": { "text": "NaturalGlow" } },
      "t3price": { "type": "Text", "props": { "text": "34.00 AUD", "size": "sm", "weight": "medium", "tone": "accent" } },

      "t4": { "type": "Section", "props": { "variant": "bordered" }, "children": ["t4name", "t4vendor", "t4price"] },
      "t4name": { "type": "Text", "props": { "text": "Stainless Steel Water Bottle", "size": "sm", "weight": "semibold", "truncate": true } },
      "t4vendor": { "type": "Caption", "props": { "text": "EcoLife" } },
      "t4price": { "type": "Text", "props": { "text": "28.00 AUD", "size": "sm", "weight": "medium", "tone": "accent" } },

      "t5": { "type": "Section", "props": { "variant": "bordered" }, "children": ["t5name", "t5vendor", "t5price"] },
      "t5name": { "type": "Text", "props": { "text": "Yoga Mat Deluxe", "size": "sm", "weight": "semibold", "truncate": true } },
