{
  "id": "shopify-store-policies-demo",
  "title": "Store Policies (Demo)",
  "description": "Sample Shopify store policies tile — static dummy data, no connection required.",
  "category": "ecommerce",
  "tags": ["shopify", "policies", "returns", "shipping", "faq", "ecommerce", "demo"],
  "keywords": ["policies", "returns", "refund", "shipping", "faq", "shopify", "help", "demo"],
  "connectorsUsed": [],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 6, "rowSpan": 4 },
    "min": { "colSpan": 4, "rowSpan": 3 },
    "max": { "colSpan": 12, "rowSpan": 8 }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": { "type": "Card", "children": ["header", "body"] },
      "header": { "type": "Header", "children": ["titleRow"] },
      "titleRow": {
        "type": "Row",
        "props": { "gap": "sm", "align": "start" },
        "children": ["titleIcon", "titleStack", "demoBadge"]
      },
      "titleIcon": { "type": "Icon", "props": { "name": "FileText", "tone": "accent", "size": "sm" } },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "eyebrow"]
      },
      "title": { "type": "Heading", "props": { "text": "Store Policies", "level": "h2" } },
      "eyebrow": { "type": "Eyebrow", "props": { "text": "Policies and FAQs from your Shopify store" } },
      "demoBadge": { "type": "Badge", "props": { "text": "Demo", "tone": "warning", "variant": "soft" } },
      "body": { "type": "Body", "children": ["content"] },
      "content": {
        "type": "Text",
        "props": {
          "text": "We offer a 30-day return policy on all items. Products must be in their original condition with tags attached. To initiate a return, contact our support team with your order number. Refunds are processed within 5–7 business days of receiving the returned item. Shipping costs for returns are covered by the customer unless the item arrives defective or incorrect.",
          "wrap": true
        }
      }
    }
  },
  "status": "published"
}
