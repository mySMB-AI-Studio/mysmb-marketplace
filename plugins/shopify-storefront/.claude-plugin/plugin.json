{
  "name": "shopify-storefront",
  "version": "0.1.0",
  "description": "Connect to Shopify's public Storefront and UCP catalog MCP servers. Browse products, manage shopping carts, and look up store policies — no authentication required.",
  "author": {
    "name": "mySMB AI Studio"
  },
  "homepage": "https://github.com/mySMB-AI-Studio/mysmb-marketplace/tree/main/plugins/shopify-storefront",
  "license": "MIT",
  "keywords": [
    "shopify",
    "ecommerce",
    "storefront",
    "cart",
    "products",
    "catalog",
    "smb"
  ],
  "connection": {
    "authType": "none",
    "instructions": "Enter your Shopify store's myshopify.com subdomain (e.g. `my-store` for `my-store.myshopify.com`). This enables product search via the UCP catalog, cart management, and store policy lookup — no sign-in required.",
    "fields": [
      {
        "name": "SHOPIFY_SHOP_SUBDOMAIN",
        "label": "Shop subdomain",
        "type": "text",
        "required": true,
        "placeholder": "my-store",
        "helpText": "The subdomain of your Shopify store — the part before .myshopify.com. Used to build both the Storefront and UCP MCP server URLs."
      }
    ]
  },
  "widgetElements": "widget-elements/dist/index.js",
  "widgets": "widgets",
  "displayName": "Shopify Storefront",
  "icon": "data:image/png;base64,"
}
