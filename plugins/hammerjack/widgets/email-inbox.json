{
  "category": "productivity",
  "connectorsUsed": [
    "m365-mail-read",
    "m365-mail-send"
  ],
  "dataProvider": {
    "kind": "tool",
    "mcp": "m365-mail-read",
    "params": {
      "limit": 20
    },
    "tool": "list_emails"
  },
  "description": "Recent inbox messages with unread indicator, sender avatar, and one-click reply.",
  "id": "m365-mail-inbox",
  "keywords": [
    "email",
    "inbox",
    "outlook",
    "message",
    "messages",
    "mail",
    "unread"
  ],
  "popularity": 95,
  "sizing": {
    "max": {
      "colSpan": 12,
      "rowSpan": 12
    },
    "min": {
      "colSpan": 4,
      "rowSpan": 4
    },
    "preferred": {
      "colSpan": 7,
      "rowSpan": 5
    }
  },
  "spec": {
    "elements": {
      "actions": {
        "children": [
          "openBtn"
        ],
        "props": {
          "gap": "sm",
          "justify": "end"
        },
        "type": "Row"
      },
      "avatar": {
        "props": {
          "initials": {
            "$computed": "initials",
            "args": {
              "value": {
                "$item": "from/emailAddress/name"
              }
            }
          },
          "size": "sm"
        },
        "type": "Avatar"
      },
      "body": {
        "children": [
          "loading",
          "empty",
          "list"
        ],
        "type": "Body"
      },
      "bodyHtml": {
        "props": {
          "html": {
            "$state": "/m365-mail-read/get_email/body/content"
          },
          "maxHeight": 520,
          "minHeight": 120
        },
        "type": "RichHtml"
      },
      "bodyPreview": {
        "children": [
          "bodyHtml"
        ],
        "props": {
          "variant": "muted"
        },
        "type": "Section"
      },
      "card": {
        "children": [
          "header",
          "body",
          "overlay"
        ],
        "type": "Card"
      },
      "detailBody": {
        "children": [
          "kvFrom",
          "kvReceived",
          "bodyPreview",
          "actions"
        ],
        "props": {
          "gap": "sm"
        },
        "type": "Stack",
        "visible": {
          "$state": "/m365-mail-read/get_email/id",
          "eq": {
            "$state": "/ui/selectedEmailId"
          }
        }
      },
      "detailCard": {
        "children": [
          "detailHeader",
          "detailSpinner",
          "detailBody"
        ],
        "type": "Card"
      },
      "detailClose": {
        "on": {
          "click": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/selectedEmailId",
                "value": ""
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/replyText",
                "value": ""
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/replySent",
                "value": ""
              }
            }
          ]
        },
        "props": {
          "ariaLabel": "Close",
          "icon": "X",
          "size": "md",
          "tone": "default",
          "variant": "outlined"
        },
        "type": "IconButton"
      },
      "detailHeader": {
        "children": [
          "detailTitle",
          "detailClose"
        ],
        "props": {
          "align": "center",
          "gap": "sm",
          "justify": "between"
        },
        "type": "Row"
      },
      "detailSpinner": {
        "props": {
          "label": "Loading message…"
        },
        "type": "Spinner",
        "visible": {
          "$state": "/m365-mail-read/get_email/id",
          "neq": {
            "$state": "/ui/selectedEmailId"
          }
        }
      },
      "detailTitle": {
        "props": {
          "level": "h2",
          "text": {
            "$state": "/m365-mail-read/get_email/subject"
          }
        },
        "type": "Heading"
      },
      "empty": {
        "props": {
          "message": "Inbox zero — enjoy it while it lasts."
        },
        "type": "Empty",
        "visible": {
          "$and": [
            {
              "$state": "/_loading/m365-mail-read.list_emails",
              "not": true
            },
            {
              "$state": "/m365-mail-read/list_emails/0",
              "not": true
            }
          ]
        }
      },
      "header": {
        "children": [
          "titleGroup"
        ],
        "type": "Header"
      },
      "kvFrom": {
        "props": {
          "label": "From",
          "value": {
            "$computed": "fmt",
            "args": {
              "addr": {
                "$state": "/m365-mail-read/get_email/from/emailAddress/address"
              },
              "name": {
                "$state": "/m365-mail-read/get_email/from/emailAddress/name"
              },
              "pattern": "{name} <{addr}>"
            }
          }
        },
        "type": "KeyValue"
      },
      "kvReceived": {
        "props": {
          "label": "Received",
          "value": {
            "$computed": "relative_time",
            "args": {
              "value": {
                "$state": "/m365-mail-read/get_email/receivedDateTime"
              }
            }
          }
        },
        "type": "KeyValue"
      },
      "labelBottom": {
        "props": {
          "size": "sm",
          "text": {
            "$computed": "email_preview",
            "args": {
              "maxLength": 140,
              "value": {
                "$item": "bodyPreview"
              }
            }
          },
          "tone": "muted"
        },
        "type": "Text"
      },
      "labelTop": {
        "props": {
          "size": "md",
          "text": {
            "$computed": "fmt",
            "args": {
              "name": {
                "$item": "from/emailAddress/name"
              },
              "pattern": "{name} — {subject}",
              "subject": {
                "$item": "subject"
              }
            }
          },
          "truncate": true,
          "weight": "medium"
        },
        "type": "Text"
      },
      "labels": {
        "children": [
          "labelTop",
          "labelBottom"
        ],
        "props": {
          "gap": "xs",
          "grow": true
        },
        "type": "Stack"
      },
      "list": {
        "children": [
          "row"
        ],
        "props": {
          "gap": "none"
        },
        "repeat": {
          "key": "id",
          "statePath": "/m365-mail-read/list_emails"
        },
        "type": "Stack",
        "visible": {
          "$state": "/_loading/m365-mail-read.list_emails",
          "not": true
        }
      },
      "loading": {
        "children": [
          "s1",
          "s2",
          "s3",
          "s4"
        ],
        "props": {
          "gap": "sm"
        },
        "type": "Stack",
        "visible": {
          "$state": "/_loading/m365-mail-read.list_emails"
        }
      },
      "openBtn": {
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "url": {
                "$state": "/m365-mail-read/get_email/webLink"
              }
            }
          }
        },
        "props": {
          "label": "Open in Outlook",
          "leadingIcon": "ExternalLink",
          "size": "sm",
          "variant": "primary"
        },
        "type": "Button"
      },
      "overlay": {
        "children": [
          "detailCard"
        ],
        "on": {
          "backdropClick": {
            "action": "setState",
            "params": {
              "statePath": "/ui/selectedEmailId",
              "value": ""
            }
          }
        },
        "props": {
          "maxWidth": "48rem"
        },
        "type": "Overlay",
        "visible": {
          "$state": "/ui/selectedEmailId"
        }
      },
      "received": {
        "props": {
          "text": {
            "$computed": "relative_time",
            "args": {
              "value": {
                "$item": "receivedDateTime"
              }
            }
          }
        },
        "type": "Caption"
      },
      "row": {
        "children": [
          "unreadDot",
          "avatar",
          "labels",
          "received"
        ],
        "on": {
          "click": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/selectedEmailId",
                "value": {
                  "$computed": "identity",
                  "args": {
                    "value": {
                      "$item": "id"
                    }
                  }
                }
              }
            },
            {
              "action": "m365-mail-read.get_email",
              "params": {
                "id": {
                  "$computed": "identity",
                  "args": {
                    "value": {
                      "$item": "id"
                    }
                  }
                }
              }
            }
          ]
        },
        "props": {
          "align": "start",
          "clickable": true,
          "gap": "sm",
          "hover": true,
          "justify": "between"
        },
        "type": "Row"
      },
      "s1": {
        "props": {
          "height": "2.75rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "s2": {
        "props": {
          "height": "2.75rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "s3": {
        "props": {
          "height": "2.75rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "s4": {
        "props": {
          "height": "2.75rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "title": {
        "props": {
          "level": "h2",
          "text": "Inbox"
        },
        "type": "Heading"
      },
      "titleGroup": {
        "children": [
          "titleIcon",
          "titleStack"
        ],
        "props": {
          "align": "start",
          "gap": "sm"
        },
        "type": "Row"
      },
      "titleIcon": {
        "props": {
          "name": "Mail",
          "size": "sm",
          "tone": "accent"
        },
        "type": "Icon"
      },
      "titleStack": {
        "children": [
          "title",
          "unreadCount"
        ],
        "props": {
          "gap": "none"
        },
        "type": "Stack"
      },
      "unreadCount": {
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "n": {
                "$computed": "count_where",
                "args": {
                  "equals": false,
                  "value": {
                    "$state": "/m365-mail-read/list_emails"
                  },
                  "whereField": "isRead"
                }
              },
              "pattern": "{n} Unread"
            }
          }
        },
        "type": "Eyebrow"
      },
      "unreadDot": {
        "props": {
          "size": "sm",
          "tone": {
            "$cond": {
              "$item": "isRead"
            },
            "$else": "accent",
            "$then": "muted"
          }
        },
        "type": "Dot"
      }
    },
    "root": "card"
  },
  "tags": [
    "m365",
    "email",
    "inbox",
    "outlook",
    "productivity"
  ],
  "title": "Email Inbox"
}
