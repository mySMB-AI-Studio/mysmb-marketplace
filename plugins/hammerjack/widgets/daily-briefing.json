          }
        },
        "type": "Stat"
      },
      "statMail": {
        "children": [
          "statMailEyebrow",
          "statMailValue"
        ],
        "props": {
          "align": "center",
          "gap": "xs"
        },
        "type": "Stack"
      },
      "statMailEyebrow": {
        "props": {
          "text": "Unread"
        },
        "type": "Eyebrow"
      },
      "statMailValue": {
        "props": {
          "tone": "accent",
          "value": {
            "$computed": "count_where",
            "args": {
              "equals": false,
              "value": {
                "$state": "/m365-mail-read/list_emails"
              },
              "whereField": "isRead"
            }
          }
        },
        "type": "Stat"
      },
      "statsRow": {
        "children": [
