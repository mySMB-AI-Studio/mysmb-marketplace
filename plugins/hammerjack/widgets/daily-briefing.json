        "type": "Heading"
      },
      "titleIcon": {
        "props": {
          "name": "Sunrise",
          "size": "sm",
          "tone": "warning"
        },
        "type": "Icon"
      },
      "titleRow": {
        "children": [
          "titleIcon",
          "title"
        ],
        "props": {
          "align": "center",
          "gap": "sm"
        },
        "type": "Row"
      }
