{
  "category": "fleet-management",
  "connectorsUsed": [
    "geotab"
  ],
  "dataProvider": {
    "kind": "tool",
    "mcp": "geotab",
    "params": {
      "database": "demo_mysmb_dev",
      "resultsLimit": 500,
      "typeName": "DeviceStatusInfo"
    },
    "tool": "Get"
  },
  "description": "Live driving/stopped/offline status per vehicle, computed from real DeviceStatusInfo records via the connected MyGeotab account. Originally scoped as live geofence on-site/in-transit detection, but that needs a second Geotab entity type (Zone) fetched in the same widget, which MyHub's widget runtime can't do today (state is keyed purely by <mcp>.<tool>, no per-params disambiguation) -- see the widget-elements source comment for the full finding.",
  "id": "geotab-vehicle-status",
  "keywords": [
    "vehicle status",
    "driving",
    "stopped",
    "offline",
    "live"
  ],
  "popularity": 0,
  "sizing": {
    "max": {
      "colSpan": 10,
      "rowSpan": 14
    },
    "min": {
      "colSpan": 4,
      "rowSpan": 8
    },
    "preferred": {
      "colSpan": 6,
      "rowSpan": 6
    }
  },
  "spec": {
    "elements": {
      "body": {
        "children": [
          "loading",
          "empty",
          "content"
        ],
        "props": {},
        "type": "Body"
      },
      "card": {
        "children": [
          "headerRow",
          "div0",
          "body"
        ],
        "props": {},
        "type": "Card",
        "watch": {
          "/geotab/Get": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/dashboard",
                "value": {
                  "$computed": "geotab_vehicle_status_dashboard",
                  "args": {
                    "statuses": {
                      "$state": "/geotab/Get/result"
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "content": {
        "children": [
          "pillRow",
          "div1",
          "vehicleRows"
        ],
        "props": {
          "gap": "md"
        },
        "type": "Stack",
        "visible": {
          "$state": "/_loading/geotab.Get",
          "not": true
        }
      },
      "div0": {
        "props": {},
        "type": "Divider"
      },
      "div1": {
        "props": {},
        "type": "Divider"
      },
      "empty": {
        "props": {
          "message": "No device status data available."
        },
        "type": "Empty",
        "visible": {
          "$and": [
            {
              "$state": "/_loading/geotab.Get",
              "not": true
            },
            {
              "$state": "/ui/dashboard/totalCount",
              "not": true
            }
          ]
        }
      },
      "eyebrow": {
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "n": {
                "$state": "/ui/dashboard/totalCount"
              },
              "pattern": "Live · {n} vehicles"
            }
          }
        },
        "type": "Eyebrow"
      },
      "headerRow": {
        "children": [
          "titleGroup"
        ],
        "props": {
          "align": "center",
          "justify": "between"
        },
        "type": "Row"
      },
      "lk1": {
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "lk2": {
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "lk3": {
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "loading": {
        "children": [
          "lk1",
          "lk2",
          "lk3"
        ],
        "props": {
          "gap": "sm"
        },
        "type": "Stack",
        "visible": {
          "$state": "/_loading/geotab.Get"
        }
      },
      "pillDriving": {
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "n": {
                "$state": "/ui/dashboard/drivingCount"
              },
              "pattern": "Driving {n}"
            }
          },
          "tone": "info",
          "variant": "solid"
        },
        "type": "Badge"
      },
      "pillOffline": {
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "n": {
                "$state": "/ui/dashboard/offlineCount"
              },
              "pattern": "Offline {n}"
            }
          },
          "tone": "warning"
        },
        "type": "Badge"
      },
      "pillRow": {
        "children": [
          "pillDriving",
          "pillStopped",
          "pillOffline"
        ],
        "props": {
          "gap": "sm"
        },
        "type": "Row"
      },
      "pillStopped": {
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "n": {
                "$state": "/ui/dashboard/stoppedCount"
              },
              "pattern": "Stopped {n}"
            }
          },
          "tone": "muted"
        },
        "type": "Badge"
      },
      "title": {
        "props": {
          "level": "h2",
          "text": "Vehicle Status"
        },
        "type": "Heading"
      },
      "titleGroup": {
        "children": [
          "titleIcon",
          "titleStack"
        ],
        "props": {
          "align": "center",
          "gap": "sm"
        },
        "type": "Row"
      },
      "titleIcon": {
        "props": {
          "name": "Truck",
          "size": "sm",
          "tone": "muted"
        },
        "type": "Icon"
      },
      "titleStack": {
        "children": [
          "title",
          "eyebrow"
        ],
        "props": {
          "gap": "none"
        },
        "type": "Stack"
      },
      "vBadge": {
        "props": {
          "text": {
            "$item": "state"
          },
          "tone": {
            "$computed": "geotab_vehicle_state_tone",
            "args": {
              "value": {
                "$item": "state"
              }
            }
          }
        },
        "type": "Badge"
      },
      "vCaption": {
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{v} km/h · {t} in this state",
              "t": {
                "$computed": "geotab_format_duration_hm",
                "args": {
                  "minutes": {
                    "$item": "stateMinutes"
                  }
                }
              },
              "v": {
                "$item": "speedKmh"
              }
            }
          }
        },
        "type": "Caption"
      },
      "vLabel": {
        "props": {
          "size": "sm",
          "text": {
            "$item": "deviceName"
          },
          "truncate": true
        },
        "type": "Text"
      },
      "vLabelStack": {
        "children": [
          "vLabel",
          "vCaption"
        ],
        "props": {
          "gap": "none"
        },
        "type": "Stack"
      },
      "vehicleRow": {
        "children": [
          "vLabelStack",
          "vBadge"
        ],
        "props": {
          "align": "center",
          "justify": "between"
        },
        "type": "Row"
      },
      "vehicleRows": {
        "children": [
          "vehicleRow"
        ],
        "props": {
          "gap": "sm"
        },
        "repeat": {
          "key": "deviceName",
          "statePath": "/ui/dashboard/rows"
        },
        "type": "Stack"
      }
    },
    "root": "card"
  },
  "tags": [
    "geotab",
    "fleet",
    "live-tracking"
  ],
  "title": "Vehicle Status"
}
