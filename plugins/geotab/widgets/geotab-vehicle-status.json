{
  "id": "geotab-vehicle-status",
  "title": "Vehicle Status",
  "description": "Live driving/stopped/offline status per vehicle, computed from real DeviceStatusInfo records via the connected MyGeotab account. Originally scoped as live geofence on-site/in-transit detection, but that needs a second Geotab entity type (Zone) fetched in the same widget, which MyHub's widget runtime can't do today (state is keyed purely by <mcp>.<tool>, no per-params disambiguation) -- see the widget-elements source comment for the full finding.",
  "category": "fleet-management",
  "tags": ["geotab", "fleet", "live-tracking"],
  "keywords": ["vehicle status", "driving", "stopped", "offline", "live"],
  "connectorsUsed": ["geotab"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 6, "rowSpan": 6 },
    "min":       { "colSpan": 4, "rowSpan": 8 },
    "max":       { "colSpan": 10, "rowSpan": 14 }
  },
  "dataProvider": {
    "mcp": "geotab",
    "tool": "Get",
    "params": {
      "database": "demo_mysmb_dev",
      "typeName": "DeviceStatusInfo",
      "resultsLimit": 500
    }
  },
  "spec": {
    "root": "card",
    "elements": {

      "card": {
        "type": "Card",
        "props": {},
        "children": ["headerRow", "div0", "body"],
        "watch": {
          "/geotab/Get": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/dashboard",
                "value": {
                  "$computed": "geotab_vehicle_status_dashboard",
                  "args": { "statuses": { "$state": "/geotab/Get/result" } }
                }
              }
            }
          ]
        }
      },

      "headerRow": { "type": "Row", "props": { "justify": "between", "align": "center" }, "children": ["titleGroup"] },
      "titleGroup": { "type": "Row", "props": { "gap": "sm", "align": "center" }, "children": ["titleIcon", "titleStack"] },
      "titleIcon": { "type": "Icon", "props": { "name": "Truck", "tone": "muted", "size": "sm" } },
      "titleStack": { "type": "Stack", "props": { "gap": "none" }, "children": ["title", "eyebrow"] },
      "title": { "type": "Heading", "props": { "text": "Vehicle Status", "level": "h2" } },
      "eyebrow": {
        "type": "Eyebrow",
        "props": {
          "text": { "$computed": "fmt", "args": { "pattern": "Live · {n} vehicles", "n": { "$state": "/ui/dashboard/totalCount" } } }
        }
      },

      "div0": { "type": "Divider", "props": {} },

      "body": { "type": "Body", "props": {}, "children": ["loading", "empty", "content"] },

      "loading": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["lk1", "lk2", "lk3"],
        "visible": { "$state": "/_loading/geotab.Get" }
      },
      "lk1": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "lk2": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "lk3": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },

      "empty": {
        "type": "Empty",
        "props": { "message": "No device status data available." },
        "visible": {
          "$and": [
            { "$state": "/_loading/geotab.Get", "not": true },
            { "$state": "/ui/dashboard/totalCount", "not": true }
          ]
        }
      },

      "content": {
        "type": "Stack",
        "props": { "gap": "md" },
        "visible": { "$state": "/_loading/geotab.Get", "not": true },
        "children": ["pillRow", "div1", "vehicleRows"]
      },

      "pillRow": { "type": "Row", "props": { "gap": "sm" }, "children": ["pillDriving", "pillStopped", "pillOffline"] },
      "pillDriving": {
        "type": "Badge",
        "props": {
          "text": { "$computed": "fmt", "args": { "pattern": "Driving {n}", "n": { "$state": "/ui/dashboard/drivingCount" } } },
          "tone": "info",
          "variant": "solid"
        }
      },
      "pillStopped": {
        "type": "Badge",
        "props": {
          "text": { "$computed": "fmt", "args": { "pattern": "Stopped {n}", "n": { "$state": "/ui/dashboard/stoppedCount" } } },
          "tone": "muted"
        }
      },
      "pillOffline": {
        "type": "Badge",
        "props": {
          "text": { "$computed": "fmt", "args": { "pattern": "Offline {n}", "n": { "$state": "/ui/dashboard/offlineCount" } } },
          "tone": "warning"
        }
      },

      "div1": { "type": "Divider", "props": {} },

      "vehicleRows": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["vehicleRow"],
        "repeat": { "statePath": "/ui/dashboard/rows", "key": "deviceName" },
        "limit": 20
      },

      "vehicleRow": { "type": "Row", "props": { "justify": "between", "align": "center" }, "children": ["vLabelStack", "vBadge"] },
      "vLabelStack": { "type": "Stack", "props": { "gap": "none" }, "children": ["vLabel", "vCaption"] },
      "vLabel": { "type": "Text", "props": { "text": { "$item": "deviceName" }, "size": "sm", "truncate": true } },
      "vCaption": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{v} km/h · {t} in this state",
              "v": { "$item": "speedKmh" },
              "t": { "$computed": "geotab_format_duration_hm", "args": { "minutes": { "$item": "stateMinutes" } } }
            }
          }
        }
      },
      "vBadge": {
        "type": "Badge",
        "props": {
          "text": { "$item": "state" },
          "tone": { "$computed": "geotab_vehicle_state_tone", "args": { "value": { "$item": "state" } } }
        }
      }

    }
  },
  "status": "published"
}
