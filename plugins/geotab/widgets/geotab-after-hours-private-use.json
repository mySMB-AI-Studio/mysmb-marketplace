{
  "category": "fleet-management",
  "connectorsUsed": [
    "geotab"
  ],
  "dataProvider": {
    "kind": "tool",
    "mcp": "geotab",
    "params": {
      "database": "demo_mysmb_dev",
      "resultsLimit": 1000,
      "search": {
        "fromDate": "$quarter_start_date",
        "toDate": "$today_date"
      },
      "typeName": "Trip"
    },
    "tool": "Get"
  },
  "description": "Quarter-to-date after-hours vehicle use and 12-week logbook coverage, computed from real Trip records via the connected MyGeotab account. Trip has no explicit business/private split field, so this tracks after-hours distance/trips specifically, not a business-vs-private percentage.",
  "id": "geotab-after-hours-private-use",
  "keywords": [
    "after hours",
    "logbook",
    "ato",
    "vehicles"
  ],
  "popularity": 0,
  "sizing": {
    "max": {
      "colSpan": 10,
      "rowSpan": 14
    },
    "min": {
      "colSpan": 4,
      "rowSpan": 8
    },
    "preferred": {
      "colSpan": 8,
      "rowSpan": 6
    }
  },
  "spec": {
    "elements": {
      "body": {
        "children": [
          "loading",
          "empty",
          "content"
        ],
        "props": {},
        "type": "Body"
      },
      "card": {
        "children": [
          "headerRow",
          "div0",
          "body"
        ],
        "props": {},
        "type": "Card",
        "watch": {
          "/geotab/Get": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/dashboard",
                "value": {
                  "$computed": "geotab_after_hours_dashboard",
                  "args": {
                    "trips": {
                      "$state": "/geotab/Get/result"
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "content": {
        "children": [
          "statRow",
          "div1",
          "coverageLabel",
          "coverageBarRow",
          "coverageCaption",
          "div3",
          "vehiclesLabel",
          "vehicleList",
          "noteSection",
          "footerDiv",
          "footerRow"
        ],
        "props": {
          "gap": "md"
        },
        "type": "Stack",
        "visible": {
          "$state": "/_loading/geotab.Get",
          "not": true
        }
      },
      "coverageBar": {
        "props": {
          "tone": "info",
          "value": {
            "$state": "/ui/dashboard/coveragePercent"
          }
        },
        "type": "ProgressBar"
      },
      "coverageBarRow": {
        "children": [
          "coverageBar"
        ],
        "props": {},
        "type": "Row"
      },
      "coverageCaption": {
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "p": {
                "$state": "/ui/dashboard/coveragePercent"
              },
              "pattern": "{p}% through the required 12-week sample period"
            }
          }
        },
        "type": "Caption"
      },
      "coverageLabel": {
        "children": [
          "coverageLabelText",
          "coverageValueText"
        ],
        "props": {
          "justify": "between"
        },
        "type": "Row"
      },
      "coverageLabelText": {
        "props": {
          "size": "sm",
          "text": "12-week logbook coverage"
        },
        "type": "Text"
      },
      "coverageValueText": {
        "props": {
          "size": "sm",
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{w} of 12 weeks",
              "w": {
                "$state": "/ui/dashboard/coverageWeeks"
              }
            }
          },
          "weight": "medium"
        },
        "type": "Text"
      },
      "div0": {
        "props": {},
        "type": "Divider"
      },
      "div1": {
        "props": {},
        "type": "Divider"
      },
      "div3": {
        "props": {},
        "type": "Divider"
      },
      "empty": {
        "props": {
          "message": "No trips found in the fetched window."
        },
        "type": "Empty",
        "visible": {
          "$and": [
            {
              "$state": "/_loading/geotab.Get",
              "not": true
            },
            {
              "$state": "/ui/dashboard/rows/0",
              "not": true
            }
          ]
        }
      },
      "eyebrow": {
        "props": {
          "text": "Quarter to date · MyGeotab"
        },
        "type": "Eyebrow"
      },
      "footerButton": {
        "on": {
          "click": [
            {
              "action": "open_todo_modal",
              "params": {
                "description": {
                  "$state": "/ui/dashboard/flagNote"
                },
                "title": {
                  "$computed": "fmt",
                  "args": {
                    "pattern": "Review {v} after-hours use",
                    "v": {
                      "$state": "/ui/dashboard/flagDeviceName"
                    }
                  }
                }
              }
            }
          ]
        },
        "props": {
          "label": "Send to WorkQ",
          "size": "sm",
          "variant": "outline"
        },
        "type": "Button"
      },
      "footerDiv": {
        "props": {},
        "type": "Divider"
      },
      "footerRow": {
        "children": [
          "footerButton"
        ],
        "props": {
          "justify": "end"
        },
        "type": "Row"
      },
      "headerRow": {
        "children": [
          "titleGroup"
        ],
        "props": {
          "align": "center",
          "justify": "between"
        },
        "type": "Row"
      },
      "lk1": {
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "lk2": {
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "lk3": {
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "loading": {
        "children": [
          "lk1",
          "lk2",
          "lk3"
        ],
        "props": {
          "gap": "sm"
        },
        "type": "Stack",
        "visible": {
          "$state": "/_loading/geotab.Get"
        }
      },
      "noteCaption": {
        "props": {
          "text": {
            "$state": "/ui/dashboard/flagNote"
          },
          "tone": "warning"
        },
        "type": "Caption"
      },
      "noteSection": {
        "children": [
          "noteCaption"
        ],
        "props": {
          "variant": "muted"
        },
        "type": "Section"
      },
      "statKm": {
        "props": {
          "label": "After-hours km",
          "value": {
            "$state": "/ui/dashboard/totalKm"
          }
        },
        "type": "Stat"
      },
      "statRow": {
        "children": [
          "statKm",
          "statTrips"
        ],
        "props": {
          "align": "start",
          "gap": "lg"
        },
        "type": "Row"
      },
      "statTrips": {
        "props": {
          "label": "After-hours trips",
          "value": {
            "$state": "/ui/dashboard/afterHoursTripCount"
          }
        },
        "type": "Stat"
      },
      "title": {
        "props": {
          "level": "h2",
          "text": "After-Hours & Private Use"
        },
        "type": "Heading"
      },
      "titleGroup": {
        "children": [
          "titleIcon",
          "titleStack"
        ],
        "props": {
          "align": "center",
          "gap": "sm"
        },
        "type": "Row"
      },
      "titleIcon": {
        "props": {
          "name": "Clock",
          "size": "sm",
          "tone": "muted"
        },
        "type": "Icon"
      },
      "titleStack": {
        "children": [
          "title",
          "eyebrow"
        ],
        "props": {
          "gap": "none"
        },
        "type": "Stack"
      },
      "vBar": {
        "props": {
          "tone": {
            "$computed": "geotab_private_km_tone",
            "args": {
              "value": {
                "$item": "afterHoursKm"
              }
            }
          },
          "value": {
            "$item": "barPercent"
          }
        },
        "type": "ProgressBar"
      },
      "vBarRow": {
        "children": [
          "vBar"
        ],
        "props": {},
        "type": "Row"
      },
      "vLabel": {
        "props": {
          "size": "sm",
          "text": {
            "$item": "deviceName"
          },
          "truncate": true
        },
        "type": "Text"
      },
      "vRow": {
        "children": [
          "vLabel",
          "vVal"
        ],
        "props": {
          "justify": "between"
        },
        "type": "Row"
      },
      "vVal": {
        "props": {
          "size": "sm",
          "text": {
            "$computed": "fmt",
            "args": {
              "km": {
                "$item": "afterHoursKm"
              },
              "pattern": "{km} km"
            }
          },
          "weight": "medium"
        },
        "type": "Text"
      },
      "vehicleList": {
        "children": [
          "vehicleRow"
        ],
        "props": {
          "gap": "sm"
        },
        "repeat": {
          "key": "deviceId",
          "statePath": "/ui/dashboard/rows"
        },
        "type": "Stack"
      },
      "vehicleRow": {
        "children": [
          "vRow",
          "vBarRow"
        ],
        "props": {
          "gap": "xs"
        },
        "type": "Stack"
      },
      "vehiclesLabel": {
        "props": {
          "text": "After-hours km by vehicle"
        },
        "type": "Eyebrow"
      }
    },
    "root": "card"
  },
  "tags": [
    "geotab",
    "fleet",
    "compliance",
    "logbook"
  ],
  "title": "After-Hours & Private Use"
}
