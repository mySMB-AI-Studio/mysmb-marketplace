{
  "category": "fleet-management",
  "connectorsUsed": [
    "geotab"
  ],
  "dataProvider": {
    "kind": "tool",
    "mcp": "geotab",
    "params": {
      "database": "demo_mysmb_dev",
      "resultsLimit": 500,
      "search": {
        "fromDate": "$today_date",
        "toDate": "$today_date"
      },
      "typeName": "Trip"
    },
    "tool": "Get"
  },
  "description": "Today's on-site vs travel vs idle time across the fleet, with a per-vehicle productive ratio, computed from real Trip records via the connected MyGeotab account. Grouped by vehicle, not driver — Driver's field schema wasn't confirmed against Geotab's docs.",
  "id": "geotab-travel-vs-onsite-time",
  "keywords": [
    "travel time",
    "on site",
    "idle",
    "productive ratio",
    "vehicles"
  ],
  "popularity": 0,
  "sizing": {
    "max": {
      "colSpan": 10,
      "rowSpan": 14
    },
    "min": {
      "colSpan": 4,
      "rowSpan": 8
    },
    "preferred": {
      "colSpan": 8,
      "rowSpan": 6
    }
  },
  "spec": {
    "elements": {
      "body": {
        "children": [
          "loading",
          "empty",
          "content"
        ],
        "props": {},
        "type": "Body"
      },
      "card": {
        "children": [
          "headerRow",
          "div0",
          "body"
        ],
        "props": {},
        "type": "Card",
        "watch": {
          "/geotab/Get": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/dashboard",
                "value": {
                  "$computed": "geotab_travel_onsite_dashboard",
                  "args": {
                    "trips": {
                      "$state": "/geotab/Get/result"
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "content": {
        "children": [
          "statBlock",
          "div1",
          "pillRow",
          "div2",
          "techLabel",
          "techRows"
        ],
        "props": {
          "gap": "md"
        },
        "type": "Stack",
        "visible": {
          "$state": "/_loading/geotab.Get",
          "not": true
        }
      },
      "div0": {
        "props": {},
        "type": "Divider"
      },
      "div1": {
        "props": {},
        "type": "Divider"
      },
      "div2": {
        "props": {},
        "type": "Divider"
      },
      "empty": {
        "props": {
          "message": "No trips found for today yet."
        },
        "type": "Empty",
        "visible": {
          "$and": [
            {
              "$state": "/_loading/geotab.Get",
              "not": true
            },
            {
              "$state": "/ui/dashboard/rows/0",
              "not": true
            }
          ]
        }
      },
      "eyebrow": {
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "n": {
                "$state": "/ui/dashboard/vehicleCount"
              },
              "pattern": "Today · {n} vehicles"
            }
          }
        },
        "type": "Eyebrow"
      },
      "headerRow": {
        "children": [
          "titleGroup"
        ],
        "props": {
          "align": "center",
          "justify": "between"
        },
        "type": "Row"
      },
      "lk1": {
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "lk2": {
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "lk3": {
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "loading": {
        "children": [
          "lk1",
          "lk2",
          "lk3"
        ],
        "props": {
          "gap": "sm"
        },
        "type": "Stack",
        "visible": {
          "$state": "/_loading/geotab.Get"
        }
      },
      "pillIdle": {
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "Idle {v}",
              "v": {
                "$computed": "geotab_format_duration_hm",
                "args": {
                  "minutes": {
                    "$state": "/ui/dashboard/idleMinutes"
                  }
                }
              }
            }
          },
          "tone": "warning"
        },
        "type": "Badge"
      },
      "pillOnSite": {
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "On site {v}",
              "v": {
                "$computed": "geotab_format_duration_hm",
                "args": {
                  "minutes": {
                    "$state": "/ui/dashboard/onSiteMinutes"
                  }
                }
              }
            }
          },
          "tone": "muted",
          "variant": "solid"
        },
        "type": "Badge"
      },
      "pillRow": {
        "children": [
          "pillOnSite",
          "pillTravel",
          "pillIdle"
        ],
        "props": {
          "gap": "sm"
        },
        "type": "Row"
      },
      "pillTravel": {
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "Travel {v}",
              "v": {
                "$computed": "geotab_format_duration_hm",
                "args": {
                  "minutes": {
                    "$state": "/ui/dashboard/travelMinutes"
                  }
                }
              }
            }
          },
          "tone": "muted"
        },
        "type": "Badge"
      },
      "statBlock": {
        "children": [
          "statOnSite",
          "statCaption"
        ],
        "props": {
          "gap": "xs"
        },
        "type": "Stack"
      },
      "statCaption": {
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "p": {
                "$state": "/ui/dashboard/fleetProductivePercent"
              },
              "pattern": "{t} in the van · {p}% productive",
              "t": {
                "$computed": "geotab_format_duration_hm",
                "args": {
                  "minutes": {
                    "$state": "/ui/dashboard/travelMinutes"
                  }
                }
              }
            }
          }
        },
        "type": "Caption"
      },
      "statOnSite": {
        "props": {
          "label": "On site",
          "value": {
            "$computed": "geotab_format_duration_hm",
            "args": {
              "minutes": {
                "$state": "/ui/dashboard/onSiteMinutes"
              }
            }
          }
        },
        "type": "Stat"
      },
      "tBar": {
        "props": {
          "tone": {
            "$computed": "geotab_productivity_tone",
            "args": {
              "value": {
                "$item": "productivePercent"
              }
            }
          },
          "value": {
            "$item": "productivePercent"
          }
        },
        "type": "ProgressBar"
      },
      "tBarRow": {
        "children": [
          "tBar"
        ],
        "props": {},
        "type": "Row"
      },
      "tLabel": {
        "props": {
          "size": "sm",
          "text": {
            "$item": "deviceName"
          },
          "truncate": true
        },
        "type": "Text"
      },
      "tRow": {
        "children": [
          "tLabel",
          "tVal"
        ],
        "props": {
          "justify": "between"
        },
        "type": "Row"
      },
      "tVal": {
        "props": {
          "size": "sm",
          "text": {
            "$computed": "fmt",
            "args": {
              "p": {
                "$item": "productivePercent"
              },
              "pattern": "{p}%"
            }
          },
          "weight": "medium"
        },
        "type": "Text"
      },
      "techLabel": {
        "props": {
          "text": "Productive ratio by vehicle"
        },
        "type": "Eyebrow"
      },
      "techRow": {
        "children": [
          "tRow",
          "tBarRow"
        ],
        "props": {
          "gap": "xs"
        },
        "type": "Stack"
      },
      "techRows": {
        "children": [
          "techRow"
        ],
        "props": {
          "gap": "sm"
        },
        "repeat": {
          "key": "deviceId",
          "statePath": "/ui/dashboard/rows"
        },
        "type": "Stack"
      },
      "title": {
        "props": {
          "level": "h2",
          "text": "Travel vs On-Site Time"
        },
        "type": "Heading"
      },
      "titleGroup": {
        "children": [
          "titleIcon",
          "titleStack"
        ],
        "props": {
          "align": "center",
          "gap": "sm"
        },
        "type": "Row"
      },
      "titleIcon": {
        "props": {
          "name": "BarChart2",
          "size": "sm",
          "tone": "muted"
        },
        "type": "Icon"
      },
      "titleStack": {
        "children": [
          "title",
          "eyebrow"
        ],
        "props": {
          "gap": "none"
        },
        "type": "Stack"
      }
    },
    "root": "card"
  },
  "tags": [
    "geotab",
    "fleet",
    "field-service",
    "productivity"
  ],
  "title": "Travel vs On-Site Time"
}
