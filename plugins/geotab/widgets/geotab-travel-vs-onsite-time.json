{
  "id": "geotab-travel-vs-onsite-time",
  "title": "Travel vs On-Site Time",
  "description": "Today's on-site vs travel vs idle time across the fleet, with a per-vehicle productive ratio, computed from real Trip records via the connected MyGeotab account. Grouped by vehicle, not driver — Driver's field schema wasn't confirmed against Geotab's docs.",
  "category": "fleet-management",
  "tags": ["geotab", "fleet", "field-service", "productivity"],
  "keywords": ["travel time", "on site", "idle", "productive ratio", "vehicles"],
  "connectorsUsed": ["geotab"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 8, "rowSpan": 6 },
    "min":       { "colSpan": 4, "rowSpan": 8 },
    "max":       { "colSpan": 10, "rowSpan": 14 }
  },
  "dataProvider": {
    "mcp": "geotab",
    "tool": "Get",
    "params": {
      "database": "demo_mysmb_dev",
      "typeName": "Trip",
      "search": { "fromDate": "$today_date", "toDate": "$today_date" },
      "resultsLimit": 500
    }
  },
  "spec": {
    "root": "card",
    "elements": {

      "card": {
        "type": "Card",
        "props": {},
        "children": ["headerRow", "div0", "body"],
        "watch": {
          "/geotab/Get": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/dashboard",
                "value": {
                  "$computed": "geotab_travel_onsite_dashboard",
                  "args": { "trips": { "$state": "/geotab/Get/result" } }
                }
              }
            }
          ]
        }
      },

      "headerRow": { "type": "Row", "props": { "justify": "between", "align": "center" }, "children": ["titleGroup"] },
      "titleGroup": { "type": "Row", "props": { "gap": "sm", "align": "center" }, "children": ["titleIcon", "titleStack"] },
      "titleIcon": { "type": "Icon", "props": { "name": "BarChart2", "tone": "muted", "size": "sm" } },
      "titleStack": { "type": "Stack", "props": { "gap": "none" }, "children": ["title", "eyebrow"] },
      "title": { "type": "Heading", "props": { "text": "Travel vs On-Site Time", "level": "h2" } },
      "eyebrow": {
        "type": "Eyebrow",
        "props": {
          "text": { "$computed": "fmt", "args": { "pattern": "Today · {n} vehicles", "n": { "$state": "/ui/dashboard/vehicleCount" } } }
        }
      },

      "div0": { "type": "Divider", "props": {} },

      "body": { "type": "Body", "props": {}, "children": ["loading", "empty", "content"] },

      "loading": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["lk1", "lk2", "lk3"],
        "visible": { "$state": "/_loading/geotab.Get" }
      },
      "lk1": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "lk2": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "lk3": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },

      "empty": {
        "type": "Empty",
        "props": { "message": "No trips found for today yet." },
        "visible": {
          "$and": [
            { "$state": "/_loading/geotab.Get", "not": true },
            { "$state": "/ui/dashboard/rows/0", "not": true }
          ]
        }
      },

      "content": {
        "type": "Stack",
        "props": { "gap": "md" },
        "visible": { "$state": "/_loading/geotab.Get", "not": true },
        "children": ["statBlock", "div1", "pillRow", "div2", "techLabel", "techRows"]
      },

      "statBlock": { "type": "Stack", "props": { "gap": "xs" }, "children": ["statOnSite", "statCaption"] },
      "statOnSite": {
        "type": "Stat",
        "props": {
          "label": "On site",
          "value": { "$computed": "geotab_format_duration_hm", "args": { "minutes": { "$state": "/ui/dashboard/onSiteMinutes" } } }
        }
      },
      "statCaption": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{t} in the van · {p}% productive",
              "t": { "$computed": "geotab_format_duration_hm", "args": { "minutes": { "$state": "/ui/dashboard/travelMinutes" } } },
              "p": { "$state": "/ui/dashboard/fleetProductivePercent" }
            }
          }
        }
      },

      "div1": { "type": "Divider", "props": {} },

      "pillRow": { "type": "Row", "props": { "gap": "sm" }, "children": ["pillOnSite", "pillTravel", "pillIdle"] },
      "pillOnSite": {
        "type": "Badge",
        "props": {
          "text": { "$computed": "fmt", "args": { "pattern": "On site {v}", "v": { "$computed": "geotab_format_duration_hm", "args": { "minutes": { "$state": "/ui/dashboard/onSiteMinutes" } } } } },
          "tone": "muted",
          "variant": "solid"
        }
      },
      "pillTravel": {
        "type": "Badge",
        "props": {
          "text": { "$computed": "fmt", "args": { "pattern": "Travel {v}", "v": { "$computed": "geotab_format_duration_hm", "args": { "minutes": { "$state": "/ui/dashboard/travelMinutes" } } } } },
          "tone": "muted"
        }
      },
      "pillIdle": {
        "type": "Badge",
        "props": {
          "text": { "$computed": "fmt", "args": { "pattern": "Idle {v}", "v": { "$computed": "geotab_format_duration_hm", "args": { "minutes": { "$state": "/ui/dashboard/idleMinutes" } } } } },
          "tone": "warning"
        }
      },

      "div2": { "type": "Divider", "props": {} },

      "techLabel": { "type": "Eyebrow", "props": { "text": "Productive ratio by vehicle" } },
      "techRows": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["techRow"],
        "repeat": { "statePath": "/ui/dashboard/rows", "key": "deviceId" },
        "limit": 20
      },

      "techRow": { "type": "Stack", "props": { "gap": "xs" }, "children": ["tRow", "tBarRow"] },
      "tRow": { "type": "Row", "props": { "justify": "between" }, "children": ["tLabel", "tVal"] },
      "tLabel": { "type": "Text", "props": { "text": { "$item": "deviceName" }, "size": "sm", "truncate": true } },
      "tVal": {
        "type": "Text",
        "props": {
          "text": { "$computed": "fmt", "args": { "pattern": "{p}%", "p": { "$item": "productivePercent" } } },
          "size": "sm",
          "weight": "medium"
        }
      },
      "tBarRow": { "type": "Row", "props": {}, "children": ["tBar"] },
      "tBar": {
        "type": "ProgressBar",
        "props": {
          "value": { "$item": "productivePercent" },
          "tone": { "$computed": "geotab_productivity_tone", "args": { "value": { "$item": "productivePercent" } } }
        }
      }

    }
  },
  "status": "published"
}
