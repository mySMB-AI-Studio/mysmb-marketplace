{
  "id": "zoho-desk-agent-workload",
  "title": "Agent Workload",
  "description": "Active Zoho Desk tickets (open and on hold) assigned to each agent, with online or invite status and role; click an agent to list their tickets, or the total to list every agent's tickets.",
  "category": "support",
  "tags": [
    "zoho",
    "zoho-desk",
    "support",
    "agents",
    "workload"
  ],
  "keywords": [
    "agent workload",
    "tickets per agent",
    "assigned tickets",
    "support team",
    "zoho desk"
  ],
  "connectorsUsed": [
    "zoho-desk"
  ],
  "popularity": 0,
  "branding": {
    "color": "#1A73E8"
  },
  "sizing": {
    "preferred": {
      "colSpan": 4,
      "rowSpan": 6
    },
    "min": {
      "colSpan": 3,
      "rowSpan": 5
    },
    "max": {
      "colSpan": 8,
      "rowSpan": 8
    }
  },
  "dataProvider": {
    "kind": "tool",
    "mcp": "zoho-desk",
    "tool": "agent_workload",
    "params": {}
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": [
          "header",
          "body"
        ],
        "watch": {
          "/zoho-desk/agent_workload": {
            "action": "setState",
            "params": {
              "statePath": "/ui/workload",
              "value": {
                "$computed": "zoho-desk_agent_workload_dashboard",
                "args": {
                  "report": {
                    "$state": "/zoho-desk/agent_workload"
                  },
                  "selected": {
                    "$state": "/ui/workloadAgent"
                  },
                  "showList": {
                    "$state": "/ui/showWorkloadTickets"
                  }
                }
              }
            }
          },
          "/ui/workloadAgent": {
            "action": "setState",
            "params": {
              "statePath": "/ui/workload",
              "value": {
                "$computed": "zoho-desk_agent_workload_dashboard",
                "args": {
                  "report": {
                    "$state": "/zoho-desk/agent_workload"
                  },
                  "selected": {
                    "$state": "/ui/workloadAgent"
                  },
                  "showList": {
                    "$state": "/ui/showWorkloadTickets"
                  }
                }
              }
            }
          },
          "/ui/showWorkloadTickets": {
            "action": "setState",
            "params": {
              "statePath": "/ui/workload",
              "value": {
                "$computed": "zoho-desk_agent_workload_dashboard",
                "args": {
                  "report": {
                    "$state": "/zoho-desk/agent_workload"
                  },
                  "selected": {
                    "$state": "/ui/workloadAgent"
                  },
                  "showList": {
                    "$state": "/ui/showWorkloadTickets"
                  }
                }
              }
            }
          }
        }
      },
      "header": {
        "type": "Header",
        "props": {},
        "children": [
          "titleGroup"
        ]
      },
      "titleGroup": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "start"
        },
        "children": [
          "titleIcon",
          "titleStack"
        ]
      },
      "titleIcon": {
        "type": "Icon",
        "props": {
          "name": "Users",
          "tone": "brand",
          "size": "lg"
        }
      },
      "titleStack": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "children": [
          "title",
          "eyebrow"
        ]
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "Agent Workload",
          "level": "h2"
        }
      },
      "eyebrow": {
        "type": "Eyebrow",
        "props": {
          "text": "Zoho Desk"
        }
      },
      "body": {
        "type": "Body",
        "props": {},
        "children": [
          "loading",
          "error",
          "empty",
          "content"
        ]
      },
      "loading": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "skRows",
          "skFooter"
        ],
        "visible": {
          "$and": [
            {
              "$state": "/ui/workload/loaded",
              "not": true
            },
            {
              "$state": "/_errors/zoho-desk.agent_workload",
              "not": true
            }
          ]
        }
      },
      "skRows": {
        "type": "Skeleton",
        "props": {
          "height": "10rem",
          "rounded": "md"
        }
      },
      "skFooter": {
        "type": "Skeleton",
        "props": {
          "height": "3rem",
          "rounded": "md"
        }
      },
      "error": {
        "type": "Empty",
        "props": {
          "message": "Couldn't load agents from Zoho Desk. Please try again in a few minutes."
        },
        "visible": {
          "$state": "/_errors/zoho-desk.agent_workload"
        }
      },
      "empty": {
        "type": "Empty",
        "props": {
          "message": "No active agents in Zoho Desk yet."
        },
        "visible": {
          "$and": [
            {
              "$state": "/ui/workload/loaded"
            },
            {
              "$state": "/ui/workload/hasData",
              "not": true
            }
          ]
        }
      },
      "content": {
        "type": "Stack",
        "props": {
          "gap": "md"
        },
        "children": [
          "scopeLabel",
          "agentList",
          "agentNote",
          "footerBox"
        ],
        "visible": {
          "$and": [
            {
              "$state": "/ui/workload/loaded"
            },
            {
              "$state": "/ui/workload/hasData"
            }
          ]
        }
      },
      "scopeLabel": {
        "type": "Text",
        "props": {
          "text": "Tickets assigned per agent",
          "size": "sm",
          "weight": "medium"
        }
      },
      "agentList": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "agentItem"
        ],
        "repeat": {
          "statePath": "/ui/workload/agents",
          "key": "id"
        }
      },
      "agentItem": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "children": [
          "agentRow",
          "ticketBox"
        ]
      },
      "agentRow": {
        "type": "Row",
        "props": {
          "template": "auto minmax(0, 1fr) auto auto",
          "gap": "sm",
          "align": "center",
          "hover": true,
          "clickable": true
        },
        "children": [
          "agentAvatar",
          "agentMain",
          "agentCount",
          "agentChevron"
        ],
        "on": {
          "click": {
            "action": "setState",
            "params": {
              "statePath": "/ui/workloadAgent",
              "value": {
                "$computed": "identity",
                "args": {
                  "value": {
                    "$item": "toggle"
                  }
                }
              }
            }
          }
        }
      },
      "agentAvatar": {
        "type": "Avatar",
        "props": {
          "initials": {
            "$item": "initials"
          },
          "tone": {
            "$item": "avatarTone"
          },
          "size": "md"
        }
      },
      "agentMain": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "children": [
          "agentName",
          "agentDetailRow"
        ]
      },
      "agentName": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "name"
          },
          "size": "sm",
          "weight": "semibold",
          "truncate": true
        }
      },
      "agentDetailRow": {
        "type": "Row",
        "props": {
          "template": "auto minmax(0, 1fr)",
          "gap": "xs",
          "align": "center"
        },
        "children": [
          "agentDot",
          "agentDetail"
        ]
      },
      "agentDot": {
        "type": "Dot",
        "props": {
          "tone": {
            "$item": "dotTone"
          },
          "size": "xs"
        }
      },
      "agentDetail": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "detail"
          },
          "tone": "muted",
          "truncate": true
        }
      },
      "agentCount": {
        "type": "Badge",
        "props": {
          "text": {
            "$item": "countDisplay"
          },
          "tone": {
            "$item": "countTone"
          },
          "variant": "soft"
        }
      },
      "agentChevron": {
        "type": "Icon",
        "props": {
          "name": {
            "$item": "chevron"
          },
          "tone": "muted",
          "size": "sm"
        }
      },
      "agentNote": {
        "type": "Caption",
        "props": {
          "text": {
            "$state": "/ui/workload/agentNote"
          }
        },
        "visible": {
          "$state": "/ui/workload/agentNote"
        }
      },
      "ticketBox": {
        "type": "Section",
        "props": {
          "variant": "bordered"
        },
        "children": [
          "ticketStack"
        ],
        "visible": {
          "$item": "expanded"
        }
      },
      "ticketStack": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "ticketList",
          "ticketEmpty",
          "ticketNote"
        ]
      },
      "ticketList": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "ticketItem"
        ],
        "repeat": {
          "statePath": "/ui/workload/selectedTickets",
          "key": "id"
        }
      },
      "ticketItem": {
        "type": "Row",
        "props": {
          "template": "auto minmax(0, 1fr) auto",
          "gap": "sm",
          "align": "center"
        },
        "children": [
          "ticketNumber",
          "ticketSubject",
          "ticketStatus"
        ]
      },
      "ticketNumber": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "number"
          },
          "tone": "muted"
        }
      },
      "ticketSubject": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "subject"
          },
          "size": "sm",
          "truncate": true
        }
      },
      "ticketStatus": {
        "type": "Badge",
        "props": {
          "text": {
            "$item": "status"
          },
          "tone": {
            "$item": "tone"
          },
          "variant": "soft"
        }
      },
      "ticketEmpty": {
        "type": "Caption",
        "props": {
          "text": "No active tickets assigned."
        },
        "visible": {
          "$state": "/ui/workload/selectedEmpty"
        }
      },
      "ticketNote": {
        "type": "Caption",
        "props": {
          "text": {
            "$state": "/ui/workload/selectedNote"
          }
        },
        "visible": {
          "$state": "/ui/workload/selectedNote"
        }
      },
      "footerBox": {
        "type": "Section",
        "props": {
          "variant": "muted"
        },
        "children": [
          "footerStack"
        ]
      },
      "footerStack": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "footerRow",
          "allTicketList",
          "allTicketsEmpty",
          "allTicketsNote"
        ]
      },
      "footerRow": {
        "type": "Row",
        "props": {
          "template": "minmax(0, 1fr) auto",
          "gap": "sm",
          "align": "center"
        },
        "children": [
          "totalToggleRow",
          "viewRow"
        ]
      },
      "totalToggleRow": {
        "type": "Row",
        "props": {
          "template": "auto auto minmax(0, 1fr)",
          "gap": "xs",
          "align": "center",
          "hover": true,
          "clickable": true
        },
        "children": [
          "totalLabel",
          "totalChevron"
        ],
        "on": {
          "click": {
            "action": "setState",
            "params": {
              "statePath": "/ui/showWorkloadTickets",
              "value": {
                "$computed": "identity",
                "args": {
                  "value": {
                    "$state": "/ui/workload/listToggle"
                  }
                }
              }
            }
          }
        }
      },
      "totalLabel": {
        "type": "Text",
        "props": {
          "text": {
            "$state": "/ui/workload/totalLabel"
          },
          "size": "sm"
        }
      },
      "totalChevron": {
        "type": "Icon",
        "props": {
          "name": {
            "$state": "/ui/workload/listChevron"
          },
          "tone": "muted",
          "size": "sm"
        }
      },
      "viewRow": {
        "type": "Row",
        "props": {
          "template": "auto auto",
          "gap": "xs",
          "align": "center",
          "hover": true,
          "clickable": true
        },
        "children": [
          "viewLabel",
          "viewArrow"
        ],
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "url": "https://desk.zoho.com/agent/mysmbcom",
              "target": "_blank"
            }
          }
        }
      },
      "viewLabel": {
        "type": "Text",
        "props": {
          "text": "View in Zoho Desk",
          "tone": "brand",
          "size": "sm",
          "weight": "semibold"
        }
      },
      "viewArrow": {
        "type": "Icon",
        "props": {
          "name": "ArrowRight",
          "tone": "brand",
          "size": "md"
        }
      },
      "allTicketList": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "allTicketItem"
        ],
        "repeat": {
          "statePath": "/ui/workload/ticketList",
          "key": "id"
        },
        "visible": {
          "$state": "/ui/workload/listExpanded"
        }
      },
      "allTicketItem": {
        "type": "Row",
        "props": {
          "template": "auto minmax(0, 1fr) auto",
          "gap": "sm",
          "align": "center"
        },
        "children": [
          "allTicketNumber",
          "allTicketSubject",
          "allTicketStatus"
        ]
      },
      "allTicketNumber": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "number"
          },
          "tone": "muted"
        }
      },
      "allTicketSubject": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "subject"
          },
          "size": "sm",
          "truncate": true
        }
      },
      "allTicketStatus": {
        "type": "Badge",
        "props": {
          "text": {
            "$item": "status"
          },
          "tone": {
            "$item": "tone"
          },
          "variant": "soft"
        }
      },
      "allTicketsEmpty": {
        "type": "Caption",
        "props": {
          "text": "No active tickets assigned."
        },
        "visible": {
          "$state": "/ui/workload/listEmpty"
        }
      },
      "allTicketsNote": {
        "type": "Caption",
        "props": {
          "text": {
            "$state": "/ui/workload/listNote"
          }
        },
        "visible": {
          "$state": "/ui/workload/listNote"
        }
      }
    }
  }
}
