{
  "id": "zoho-desk-ticket-status-overview",
  "title": "Ticket Status Overview",
  "description": "Zoho Desk tickets by status (Open, On Hold, Escalated, Closed), with this week's and this month's new-ticket totals. Filter by status and period (today, this week, this month or a custom date range) to list the matching tickets, newest first; hide or show the list, and open Zoho Desk.",
  "category": "support",
  "tags": [
    "zoho",
    "zoho-desk",
    "support",
    "tickets",
    "help-desk"
  ],
  "keywords": [
    "ticket status",
    "open tickets",
    "on hold",
    "escalated",
    "closed tickets",
    "zoho desk",
    "tickets over time",
    "new tickets",
    "date range"
  ],
  "connectorsUsed": [
    "zoho-desk"
  ],
  "popularity": 0,
  "branding": {
    "color": "#1A73E8"
  },
  "sizing": {
    "preferred": {
      "colSpan": 4,
      "rowSpan": 6
    },
    "min": {
      "colSpan": 3,
      "rowSpan": 5
    },
    "max": {
      "colSpan": 8,
      "rowSpan": 8
    }
  },
  "dataProvider": {
    "kind": "tool",
    "mcp": "zoho-desk",
    "tool": "tickets_count_by_field",
    "params": {
      "field": "status"
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": [
          "header",
          "body"
        ],
        "watch": {
          "/zoho-desk/tickets_count_by_field": {
            "action": "setState",
            "params": {
              "statePath": "/ui/ticketStatus",
              "value": {
                "$computed": "zoho-desk_ticket_status_dashboard",
                "args": {
                  "report": {
                    "$state": "/zoho-desk/tickets_count_by_field"
                  }
                }
              }
            }
          },
          "/ui/ticketStatus/loaded": {
            "action": "zoho-desk.search_tickets",
            "params": {
              "createdTimeRange": {
                "$computed": "zoho-desk_ticket_created_range",
                "args": {}
              },
              "sortBy": "-createdTime",
              "limit": 100
            }
          },
          "/zoho-desk/search_tickets": {
            "action": "setState",
            "params": {
              "statePath": "/ui/ticketTime",
              "value": {
                "$computed": "zoho-desk_ticket_activity_dashboard",
                "args": {
                  "search": {
                    "$state": "/zoho-desk/search_tickets"
                  },
                  "custom": {
                    "$state": "/zoho-desk/passthrough_get"
                  },
                  "period": {
                    "$state": "/ui/ticketPeriod"
                  },
                  "from": {
                    "$state": "/ui/ticketDates/from"
                  },
                  "to": {
                    "$state": "/ui/ticketDates/to"
                  },
                  "prevRange": {
                    "$state": "/ui/ticketTime/customRange"
                  },
                  "status": {
                    "$state": "/ui/ticketStatusFilter"
                  },
                  "listOpen": {
                    "$state": "/ui/showTicketList"
                  }
                }
              }
            }
          },
          "/zoho-desk/passthrough_get": {
            "action": "setState",
            "params": {
              "statePath": "/ui/ticketTime",
              "value": {
                "$computed": "zoho-desk_ticket_activity_dashboard",
                "args": {
                  "search": {
                    "$state": "/zoho-desk/search_tickets"
                  },
                  "custom": {
                    "$state": "/zoho-desk/passthrough_get"
                  },
                  "period": {
                    "$state": "/ui/ticketPeriod"
                  },
                  "from": {
                    "$state": "/ui/ticketDates/from"
                  },
                  "to": {
                    "$state": "/ui/ticketDates/to"
                  },
                  "prevRange": {
                    "$state": "/ui/ticketTime/customRange"
                  },
                  "status": {
                    "$state": "/ui/ticketStatusFilter"
                  },
                  "listOpen": {
                    "$state": "/ui/showTicketList"
                  }
                }
              }
            }
          },
          "/ui/ticketPeriod": {
            "action": "setState",
            "params": {
              "statePath": "/ui/ticketTime",
              "value": {
                "$computed": "zoho-desk_ticket_activity_dashboard",
                "args": {
                  "search": {
                    "$state": "/zoho-desk/search_tickets"
                  },
                  "custom": {
                    "$state": "/zoho-desk/passthrough_get"
                  },
                  "period": {
                    "$state": "/ui/ticketPeriod"
                  },
                  "from": {
                    "$state": "/ui/ticketDates/from"
                  },
                  "to": {
                    "$state": "/ui/ticketDates/to"
                  },
                  "prevRange": {
                    "$state": "/ui/ticketTime/customRange"
                  },
                  "status": {
                    "$state": "/ui/ticketStatusFilter"
                  },
                  "listOpen": {
                    "$state": "/ui/showTicketList"
                  }
                }
              }
            }
          },
          "/ui/ticketDates/from": {
            "action": "setState",
            "params": {
              "statePath": "/ui/ticketTime",
              "value": {
                "$computed": "zoho-desk_ticket_activity_dashboard",
                "args": {
                  "search": {
                    "$state": "/zoho-desk/search_tickets"
                  },
                  "custom": {
                    "$state": "/zoho-desk/passthrough_get"
                  },
                  "period": {
                    "$state": "/ui/ticketPeriod"
                  },
                  "from": {
                    "$state": "/ui/ticketDates/from"
                  },
                  "to": {
                    "$state": "/ui/ticketDates/to"
                  },
                  "prevRange": {
                    "$state": "/ui/ticketTime/customRange"
                  },
                  "status": {
                    "$state": "/ui/ticketStatusFilter"
                  },
                  "listOpen": {
                    "$state": "/ui/showTicketList"
                  }
                }
              }
            }
          },
          "/ui/ticketDates/to": {
            "action": "setState",
            "params": {
              "statePath": "/ui/ticketTime",
              "value": {
                "$computed": "zoho-desk_ticket_activity_dashboard",
                "args": {
                  "search": {
                    "$state": "/zoho-desk/search_tickets"
                  },
                  "custom": {
                    "$state": "/zoho-desk/passthrough_get"
                  },
                  "period": {
                    "$state": "/ui/ticketPeriod"
                  },
                  "from": {
                    "$state": "/ui/ticketDates/from"
                  },
                  "to": {
                    "$state": "/ui/ticketDates/to"
                  },
                  "prevRange": {
                    "$state": "/ui/ticketTime/customRange"
                  },
                  "status": {
                    "$state": "/ui/ticketStatusFilter"
                  },
                  "listOpen": {
                    "$state": "/ui/showTicketList"
                  }
                }
              }
            }
          },
          "/ui/ticketTime/customRange": {
            "action": "zoho-desk.passthrough_get",
            "params": {
              "path": "/tickets/search",
              "params": {
                "createdTimeRange": {
                  "$state": "/ui/ticketTime/customRange"
                },
                "sortBy": "-createdTime",
                "limit": 100
              }
            }
          },
          "/ui/ticketStatusFilter": {
            "action": "setState",
            "params": {
              "statePath": "/ui/ticketTime",
              "value": {
                "$computed": "zoho-desk_ticket_activity_dashboard",
                "args": {
                  "search": {
                    "$state": "/zoho-desk/search_tickets"
                  },
                  "custom": {
                    "$state": "/zoho-desk/passthrough_get"
                  },
                  "period": {
                    "$state": "/ui/ticketPeriod"
                  },
                  "from": {
                    "$state": "/ui/ticketDates/from"
                  },
                  "to": {
                    "$state": "/ui/ticketDates/to"
                  },
                  "prevRange": {
                    "$state": "/ui/ticketTime/customRange"
                  },
                  "status": {
                    "$state": "/ui/ticketStatusFilter"
                  },
                  "listOpen": {
                    "$state": "/ui/showTicketList"
                  }
                }
              }
            }
          },
          "/ui/showTicketList": {
            "action": "setState",
            "params": {
              "statePath": "/ui/ticketTime",
              "value": {
                "$computed": "zoho-desk_ticket_activity_dashboard",
                "args": {
                  "search": {
                    "$state": "/zoho-desk/search_tickets"
                  },
                  "custom": {
                    "$state": "/zoho-desk/passthrough_get"
                  },
                  "period": {
                    "$state": "/ui/ticketPeriod"
                  },
                  "from": {
                    "$state": "/ui/ticketDates/from"
                  },
                  "to": {
                    "$state": "/ui/ticketDates/to"
                  },
                  "prevRange": {
                    "$state": "/ui/ticketTime/customRange"
                  },
                  "status": {
                    "$state": "/ui/ticketStatusFilter"
                  },
                  "listOpen": {
                    "$state": "/ui/showTicketList"
                  }
                }
              }
            }
          }
        }
      },
      "header": {
        "type": "Header",
        "props": {},
        "children": [
          "titleGroup"
        ]
      },
      "titleGroup": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "start"
        },
        "children": [
          "titleIcon",
          "titleStack"
        ]
      },
      "titleIcon": {
        "type": "Icon",
        "props": {
          "name": "Ticket",
          "tone": "brand",
          "size": "lg"
        }
      },
      "titleStack": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "children": [
          "title",
          "eyebrow"
        ]
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "Ticket Status Overview",
          "level": "h2"
        }
      },
      "eyebrow": {
        "type": "Eyebrow",
        "props": {
          "text": "Zoho Desk"
        }
      },
      "body": {
        "type": "Body",
        "props": {},
        "children": [
          "loading",
          "error",
          "empty",
          "content"
        ]
      },
      "loading": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "skRows",
          "skTime"
        ],
        "visible": {
          "$and": [
            {
              "$state": "/ui/ticketStatus/loaded",
              "not": true
            },
            {
              "$state": "/_errors/zoho-desk.tickets_count_by_field",
              "not": true
            }
          ]
        }
      },
      "skRows": {
        "type": "Skeleton",
        "props": {
          "height": "9rem",
          "rounded": "md"
        }
      },
      "skTime": {
        "type": "Skeleton",
        "props": {
          "height": "7rem",
          "rounded": "md"
        }
      },
      "error": {
        "type": "Empty",
        "props": {
          "message": "Couldn't load tickets from Zoho Desk. Please try again in a few minutes."
        },
        "visible": {
          "$state": "/_errors/zoho-desk.tickets_count_by_field"
        }
      },
      "empty": {
        "type": "Empty",
        "props": {
          "message": "There are no tickets in Zoho Desk yet."
        },
        "visible": {
          "$and": [
            {
              "$state": "/ui/ticketStatus/loaded"
            },
            {
              "$state": "/ui/ticketStatus/hasData",
              "not": true
            }
          ]
        }
      },
      "content": {
        "type": "Stack",
        "props": {
          "gap": "md"
        },
        "children": [
          "scopeRow",
          "statusList",
          "timeDivider",
          "timeSection"
        ],
        "visible": {
          "$and": [
            {
              "$state": "/ui/ticketStatus/loaded"
            },
            {
              "$state": "/ui/ticketStatus/hasData"
            }
          ]
        }
      },
      "scopeRow": {
        "type": "Row",
        "props": {
          "template": "minmax(0, 1fr)",
          "gap": "sm",
          "align": "center"
        },
        "children": [
          "scopeStack"
        ]
      },
      "scopeStack": {
        "type": "Row",
        "props": {
          "template": "auto minmax(0, 1fr)",
          "gap": "xs",
          "align": "center"
        },
        "children": [
          "scopeLabel",
          "scopeMeta"
        ]
      },
      "scopeLabel": {
        "type": "Text",
        "props": {
          "text": "All Tickets",
          "size": "xs",
          "weight": "medium"
        }
      },
      "scopeMeta": {
        "type": "Text",
        "props": {
          "text": {
            "$state": "/ui/ticketStatus/asOfLabel"
          },
          "size": "xs",
          "truncate": true
        },
        "visible": {
          "$state": "/ui/ticketStatus/loaded"
        }
      },
      "statusList": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "rowOpen",
          "divOpen",
          "rowOnHold",
          "divOnHold",
          "rowEscalated",
          "divEscalated",
          "rowClosed"
        ]
      },
      "rowOpen": {
        "type": "Row",
        "props": {
          "template": "auto minmax(0, 1fr) auto",
          "gap": "sm",
          "align": "center"
        },
        "children": [
          "dotOpen",
          "labelOpen",
          "countOpen"
        ]
      },
      "dotOpen": {
        "type": "Dot",
        "props": {
          "tone": "info",
          "size": "sm"
        }
      },
      "labelOpen": {
        "type": "Text",
        "props": {
          "text": "Open",
          "size": "sm"
        }
      },
      "countOpen": {
        "type": "Text",
        "props": {
          "text": {
            "$state": "/ui/ticketStatus/openDisplay"
          },
          "size": "sm",
          "weight": "semibold",
          "align": "right"
        }
      },
      "divOpen": {
        "type": "Divider",
        "props": {}
      },
      "rowOnHold": {
        "type": "Row",
        "props": {
          "template": "auto minmax(0, 1fr) auto",
          "gap": "sm",
          "align": "center"
        },
        "children": [
          "dotOnHold",
          "labelOnHold",
          "countOnHold"
        ]
      },
      "dotOnHold": {
        "type": "Dot",
        "props": {
          "tone": "warning",
          "size": "sm"
        }
      },
      "labelOnHold": {
        "type": "Text",
        "props": {
          "text": "On Hold",
          "size": "sm"
        }
      },
      "countOnHold": {
        "type": "Text",
        "props": {
          "text": {
            "$state": "/ui/ticketStatus/onHoldDisplay"
          },
          "size": "sm",
          "weight": "semibold",
          "align": "right"
        }
      },
      "divOnHold": {
        "type": "Divider",
        "props": {}
      },
      "rowEscalated": {
        "type": "Row",
        "props": {
          "template": "auto minmax(0, 1fr) auto",
          "gap": "sm",
          "align": "center"
        },
        "children": [
          "dotEscalated",
          "labelEscalated",
          "countEscalated"
        ]
      },
      "dotEscalated": {
        "type": "Dot",
        "props": {
          "tone": "destructive",
          "size": "sm"
        }
      },
      "labelEscalated": {
        "type": "Text",
        "props": {
          "text": "Escalated",
          "size": "sm"
        }
      },
      "countEscalated": {
        "type": "Text",
        "props": {
          "text": {
            "$state": "/ui/ticketStatus/escalatedDisplay"
          },
          "size": "sm",
          "weight": "semibold",
          "align": "right"
        }
      },
      "divEscalated": {
        "type": "Divider",
        "props": {}
      },
      "rowClosed": {
        "type": "Row",
        "props": {
          "template": "auto minmax(0, 1fr) auto",
          "gap": "sm",
          "align": "center"
        },
        "children": [
          "dotClosed",
          "labelClosed",
          "countClosed"
        ]
      },
      "dotClosed": {
        "type": "Dot",
        "props": {
          "tone": "success",
          "size": "sm"
        }
      },
      "labelClosed": {
        "type": "Text",
        "props": {
          "text": "Closed",
          "size": "sm"
        }
      },
      "countClosed": {
        "type": "Text",
        "props": {
          "text": {
            "$state": "/ui/ticketStatus/closedDisplay"
          },
          "size": "sm",
          "weight": "semibold",
          "align": "right"
        }
      },
      "timeDivider": {
        "type": "Divider",
        "props": {}
      },
      "timeSection": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "timeHeader",
          "timeError",
          "timeLoading",
          "timeBody"
        ]
      },
      "timeHeader": {
        "type": "Row",
        "props": {
          "template": "minmax(0, 1fr) auto auto",
          "gap": "sm",
          "align": "center"
        },
        "children": [
          "monthWrap",
          "statusFilter",
          "periodSelect"
        ]
      },
      "monthWrap": {
        "type": "Row",
        "props": {
          "justify": "start",
          "align": "center"
        },
        "children": [
          "monthChip"
        ]
      },
      "monthChip": {
        "type": "Section",
        "props": {
          "variant": "muted"
        },
        "children": [
          "monthRow"
        ],
        "visible": {
          "$state": "/ui/ticketTime/loaded"
        }
      },
      "monthRow": {
        "type": "Row",
        "props": {
          "template": "auto auto",
          "gap": "xs",
          "align": "center"
        },
        "children": [
          "monthCount",
          "monthLabel"
        ]
      },
      "monthCount": {
        "type": "Text",
        "props": {
          "text": {
            "$state": "/ui/ticketTime/monthDisplay"
          },
          "size": "sm",
          "weight": "semibold"
        }
      },
      "monthLabel": {
        "type": "Text",
        "props": {
          "text": "Total this month",
          "tone": "muted",
          "size": "xs"
        }
      },
      "statusFilter": {
        "type": "Select",
        "props": {
          "value": {
            "$bindState": "/ui/ticketStatusFilter"
          },
          "options": {
            "$state": "/ui/ticketTime/statusOptions"
          },
          "ariaLabel": "Status",
          "size": "sm"
        },
        "visible": {
          "$state": "/ui/ticketTime/loaded"
        },
        "on": {
          "change": {
            "action": "setState",
            "params": {
              "statePath": "/ui/showTicketList",
              "value": true
            }
          }
        }
      },
      "periodSelect": {
        "type": "Select",
        "props": {
          "value": {
            "$bindState": "/ui/ticketPeriod"
          },
          "options": {
            "$state": "/ui/ticketTime/periodOptions"
          },
          "ariaLabel": "Period",
          "size": "sm"
        },
        "visible": {
          "$state": "/ui/ticketTime/loaded"
        },
        "on": {
          "change": {
            "action": "setState",
            "params": {
              "statePath": "/ui/showTicketList",
              "value": true
            }
          }
        }
      },
      "timeError": {
        "type": "Caption",
        "props": {
          "text": "Couldn't load ticket dates from Zoho Desk. Please try again in a few minutes."
        },
        "visible": {
          "$state": "/_errors/zoho-desk.search_tickets"
        }
      },
      "timeLoading": {
        "type": "Skeleton",
        "props": {
          "height": "5rem",
          "rounded": "md"
        },
        "visible": {
          "$and": [
            {
              "$state": "/ui/ticketTime/loaded",
              "not": true
            },
            {
              "$state": "/_errors/zoho-desk.search_tickets",
              "not": true
            }
          ]
        }
      },
      "timeBody": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "hideWrap",
          "customRow",
          "clearWrap",
          "customHint",
          "customError",
          "customLoading",
          "showWrap",
          "breakdownEmpty",
          "breakdownList",
          "breakdownNote",
          "viewWrap"
        ],
        "visible": {
          "$state": "/ui/ticketTime/loaded"
        }
      },
      "customRow": {
        "type": "Grid",
        "props": {
          "cols": 2,
          "gap": "sm"
        },
        "children": [
          "fromField",
          "toField"
        ],
        "visible": {
          "$state": "/ui/ticketTime/isCustom"
        }
      },
      "fromField": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "children": [
          "fromLabel",
          "fromInput"
        ]
      },
      "fromLabel": {
        "type": "Text",
        "props": {
          "text": "From",
          "tone": "muted",
          "size": "xs"
        }
      },
      "fromInput": {
        "type": "DateInput",
        "props": {
          "value": {
            "$bindState": "/ui/ticketDates/from"
          },
          "ariaLabel": "Start date",
          "size": "sm"
        },
        "on": {
          "change": {
            "action": "setState",
            "params": {
              "statePath": "/ui/showTicketList",
              "value": true
            }
          }
        }
      },
      "toField": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "children": [
          "toLabel",
          "toInput"
        ]
      },
      "toLabel": {
        "type": "Text",
        "props": {
          "text": "To",
          "tone": "muted",
          "size": "xs"
        }
      },
      "hideCustomRow": {
        "type": "Row",
        "props": {
          "template": "auto auto",
          "gap": "xs",
          "align": "center",
          "hover": true,
          "clickable": true
        },
        "children": [
          "hideCustomLabel",
          "hideCustomIcon"
        ],
        "on": {
          "click": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/showTicketList",
                "value": false
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/ticketPeriod",
                "value": ""
              }
            }
          ]
        },
        "visible": {
          "$state": "/ui/ticketTime/isCustom"
        }
      },
      "hideCustomLabel": {
        "type": "Text",
        "props": {
          "text": "Hide list",
          "tone": "muted",
          "size": "xs"
        }
      },
      "hideCustomIcon": {
        "type": "Icon",
        "props": {
          "name": "ChevronUp",
          "tone": "muted",
          "size": "xs"
        }
      },
      "toInput": {
        "type": "DateInput",
        "props": {
          "value": {
            "$bindState": "/ui/ticketDates/to"
          },
          "ariaLabel": "End date",
          "size": "sm"
        },
        "on": {
          "change": {
            "action": "setState",
            "params": {
              "statePath": "/ui/showTicketList",
              "value": true
            }
          }
        }
      },
      "clearWrap": {
        "type": "Row",
        "props": {
          "justify": "end",
          "align": "center"
        },
        "children": [
          "clearRow"
        ],
        "visible": {
          "$state": "/ui/ticketTime/hasDates"
        }
      },
      "clearRow": {
        "type": "Row",
        "props": {
          "template": "auto auto",
          "gap": "xs",
          "align": "center",
          "hover": true,
          "clickable": true
        },
        "children": [
          "clearIcon",
          "clearLabel"
        ],
        "on": {
          "click": {
            "action": "setState",
            "params": {
              "statePath": "/ui/ticketDates",
              "value": {}
            }
          }
        }
      },
      "clearIcon": {
        "type": "Icon",
        "props": {
          "name": "X",
          "tone": "muted",
          "size": "xs"
        }
      },
      "clearLabel": {
        "type": "Text",
        "props": {
          "text": "Clear dates",
          "tone": "muted",
          "size": "xs"
        }
      },
      "customHint": {
        "type": "Caption",
        "props": {
          "text": {
            "$state": "/ui/ticketTime/customHint"
          }
        },
        "visible": {
          "$state": "/ui/ticketTime/customHint"
        }
      },
      "customError": {
        "type": "Caption",
        "props": {
          "text": "Couldn't load tickets for these dates. Please try again."
        },
        "visible": {
          "$and": [
            {
              "$state": "/ui/ticketTime/isCustom"
            },
            {
              "$state": "/ui/ticketTime/hasPeriod"
            },
            {
              "$state": "/_errors/zoho-desk.passthrough_get"
            }
          ]
        }
      },
      "customLoading": {
        "type": "Skeleton",
        "props": {
          "height": "5rem",
          "rounded": "md"
        },
        "visible": {
          "$and": [
            {
              "$state": "/ui/ticketTime/isCustom"
            },
            {
              "$state": "/_loading/zoho-desk.passthrough_get"
            }
          ]
        }
      },
      "hideWrap": {
        "type": "Row",
        "props": {
          "justify": "end",
          "align": "center",
          "gap": "sm"
        },
        "children": [
          "shownCount",
          "hideRow",
          "hideCustomRow"
        ],
        "visible": {
          "$or": [
            {
              "$state": "/ui/ticketTime/listExpanded"
            },
            {
              "$state": "/ui/ticketTime/isCustom"
            }
          ]
        }
      },
      "shownCount": {
        "type": "Text",
        "props": {
          "text": {
            "$state": "/ui/ticketTime/shownCount"
          },
          "tone": "muted",
          "size": "xs"
        },
        "visible": {
          "$and": [
            {
              "$state": "/ui/ticketTime/listExpanded"
            },
            {
              "$or": [
                {
                  "$state": "/ui/ticketTime/isCustom",
                  "not": true
                },
                {
                  "$and": [
                    {
                      "$state": "/_loading/zoho-desk.passthrough_get",
                      "not": true
                    },
                    {
                      "$state": "/_errors/zoho-desk.passthrough_get",
                      "not": true
                    }
                  ]
                }
              ]
            }
          ]
        }
      },
      "hideRow": {
        "type": "Row",
        "props": {
          "template": "auto auto",
          "gap": "xs",
          "align": "center",
          "hover": true,
          "clickable": true
        },
        "children": [
          "hideLabel",
          "hideIcon"
        ],
        "on": {
          "click": {
            "action": "setState",
            "params": {
              "statePath": "/ui/showTicketList",
              "value": false
            }
          }
        },
        "visible": {
          "$state": "/ui/ticketTime/isCustom",
          "not": true
        }
      },
      "hideLabel": {
        "type": "Text",
        "props": {
          "text": "Hide list",
          "tone": "muted",
          "size": "xs"
        }
      },
      "hideIcon": {
        "type": "Icon",
        "props": {
          "name": "ChevronUp",
          "tone": "muted",
          "size": "xs"
        }
      },
      "showWrap": {
        "type": "Row",
        "props": {
          "justify": "end",
          "align": "center"
        },
        "children": [
          "showRow"
        ],
        "visible": {
          "$state": "/ui/ticketTime/listHidden"
        }
      },
      "showRow": {
        "type": "Row",
        "props": {
          "template": "auto auto",
          "gap": "xs",
          "align": "center",
          "hover": true,
          "clickable": true
        },
        "children": [
          "showLabel",
          "showIcon"
        ],
        "on": {
          "click": {
            "action": "setState",
            "params": {
              "statePath": "/ui/showTicketList",
              "value": true
            }
          }
        }
      },
      "showLabel": {
        "type": "Text",
        "props": {
          "text": "Show list",
          "tone": "muted",
          "size": "xs"
        }
      },
      "showIcon": {
        "type": "Icon",
        "props": {
          "name": "ChevronDown",
          "tone": "muted",
          "size": "xs"
        }
      },
      "breakdownEmpty": {
        "type": "Caption",
        "props": {
          "text": {
            "$state": "/ui/ticketTime/emptyText"
          }
        },
        "visible": {
          "$and": [
            {
              "$state": "/ui/ticketTime/listEmpty"
            },
            {
              "$or": [
                {
                  "$state": "/ui/ticketTime/isCustom",
                  "not": true
                },
                {
                  "$and": [
                    {
                      "$state": "/_loading/zoho-desk.passthrough_get",
                      "not": true
                    },
                    {
                      "$state": "/_errors/zoho-desk.passthrough_get",
                      "not": true
                    }
                  ]
                }
              ]
            }
          ]
        }
      },
      "breakdownList": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "ticketItem"
        ],
        "repeat": {
          "statePath": "/ui/ticketTime/list",
          "key": "id"
        },
        "visible": {
          "$and": [
            {
              "$state": "/ui/ticketTime/listExpanded"
            },
            {
              "$state": "/ui/ticketTime/hasPeriod"
            },
            {
              "$or": [
                {
                  "$state": "/ui/ticketTime/isCustom",
                  "not": true
                },
                {
                  "$and": [
                    {
                      "$state": "/_loading/zoho-desk.passthrough_get",
                      "not": true
                    },
                    {
                      "$state": "/_errors/zoho-desk.passthrough_get",
                      "not": true
                    }
                  ]
                }
              ]
            }
          ]
        }
      },
      "ticketItem": {
        "type": "Row",
        "props": {
          "template": "auto minmax(0, 1fr) auto",
          "gap": "sm",
          "align": "center"
        },
        "children": [
          "ticketNumber",
          "ticketSubject",
          "ticketStatus"
        ]
      },
      "ticketNumber": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "number"
          },
          "tone": "muted",
          "size": "sm"
        }
      },
      "ticketSubject": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "subject"
          },
          "size": "sm",
          "truncate": true
        }
      },
      "ticketStatus": {
        "type": "Badge",
        "props": {
          "text": {
            "$item": "label"
          },
          "tone": {
            "$item": "tone"
          },
          "variant": "soft"
        }
      },
      "breakdownNote": {
        "type": "Caption",
        "props": {
          "text": {
            "$state": "/ui/ticketTime/note"
          }
        },
        "visible": {
          "$and": [
            {
              "$and": [
                {
                  "$state": "/ui/ticketTime/note"
                },
                {
                  "$state": "/ui/ticketTime/listExpanded"
                }
              ]
            },
            {
              "$or": [
                {
                  "$state": "/ui/ticketTime/isCustom",
                  "not": true
                },
                {
                  "$and": [
                    {
                      "$state": "/_loading/zoho-desk.passthrough_get",
                      "not": true
                    },
                    {
                      "$state": "/_errors/zoho-desk.passthrough_get",
                      "not": true
                    }
                  ]
                }
              ]
            }
          ]
        }
      },
      "viewWrap": {
        "type": "Row",
        "props": {
          "justify": "end",
          "align": "center"
        },
        "children": [
          "viewRow"
        ]
      },
      "viewRow": {
        "type": "Row",
        "props": {
          "template": "auto",
          "gap": "xs",
          "align": "center",
          "hover": true,
          "clickable": true
        },
        "children": [
          "viewLabel"
        ],
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "url": "https://desk.zoho.com/agent/mysmbcom",
              "target": "_blank"
            }
          }
        }
      },
      "viewLabel": {
        "type": "Text",
        "props": {
          "text": "View in Zoho Desk",
          "tone": "brand",
          "size": "xs",
          "weight": "medium"
        }
      }
    }
  }
}
