{
  "brandColor": "#34DFBA",
  "category": "marketing",
  "connectorsUsed": [
    "eventbrite"
  ],
  "dataProvider": {
    "kind": "tool",
    "mcp": "eventbrite",
    "params": {},
    "tool": "list_organizations"
  },
  "description": "Browse your Eventbrite organization's events and view live check-in progress — checked-in count, percentage, and the attendee list — for whichever one you select. Zero-config: auto-resolves your organization, defaulting to the FIRST organization on the connected account if there is more than one (see this plugin's README).",
  "id": "eventbrite-checkin-progress",
  "keywords": [
    "eventbrite check-in",
    "attendee check-in",
    "event day",
    "registration",
    "attendees",
    "event lookup"
  ],
  "popularity": 0,
  "sizing": {
    "max": {
      "colSpan": 10,
      "rowSpan": 14
    },
    "min": {
      "colSpan": 5,
      "rowSpan": 7
    },
    "preferred": {
      "colSpan": 6,
      "rowSpan": 9
    }
  },
  "spec": {
    "elements": {
      "attendeeBadge": {
        "props": {
          "text": {
            "$item": "checkin_label"
          },
          "tone": {
            "$item": "checkin_tone"
          },
          "variant": "soft"
        },
        "type": "Badge"
      },
      "attendeeEmail": {
        "props": {
          "text": {
            "$item": "email"
          },
          "tone": "muted",
          "truncate": true
        },
        "type": "Caption"
      },
      "attendeeInfo": {
        "children": [
          "attendeeName",
          "attendeeEmail",
          "attendeeTicket"
        ],
        "props": {
          "gap": "none",
          "grow": true
        },
        "type": "Stack"
      },
      "attendeeList": {
        "children": [
          "attendeeRow"
        ],
        "props": {
          "gap": "xs"
        },
        "repeat": {
          "key": "id",
          "statePath": "/ui/attendeeRows"
        },
        "type": "Stack",
        "visible": {
          "$state": "/ui/attendeeRows/0"
        }
      },
      "attendeeLoading": {
        "children": [
          "sk4",
          "sk5"
        ],
        "props": {
          "gap": "sm"
        },
        "type": "Stack",
        "visible": {
          "$state": "/_loading/eventbrite.list_attendees"
        }
      },
      "attendeeName": {
        "props": {
          "size": "sm",
          "text": {
            "$item": "name"
          },
          "truncate": true,
          "weight": "medium"
        },
        "type": "Text"
      },
      "attendeeRow": {
        "children": [
          "attendeeInfo",
          "attendeeBadge"
        ],
        "props": {
          "align": "center",
          "gap": "sm",
          "justify": "between"
        },
        "type": "Row"
      },
      "attendeeTicket": {
        "props": {
          "text": {
            "$item": "ticket_label"
          },
          "tone": "muted"
        },
        "type": "Caption"
      },
      "attendeesHeading": {
        "props": {
          "text": "Attendees",
          "tone": "muted"
        },
        "type": "Caption",
        "visible": {
          "$state": "/ui/attendeeRows/0"
        }
      },
      "body": {
        "children": [
          "loadingEvents",
          "emptyEvents",
          "mainContent"
        ],
        "props": {},
        "type": "Body"
      },
      "card": {
        "children": [
          "header",
          "divider0",
          "body"
        ],
        "props": {},
        "type": "Card",
        "watch": {
          "/eventbrite/list_attendees/attendees": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/checkin",
                "value": {
                  "$computed": "eventbrite_checkin_summary",
                  "args": {
                    "attendees": {
                      "$state": "/eventbrite/list_attendees/attendees"
                    },
                    "capacity": {
                      "$state": "/ui/selectedEvent/capacity"
                    }
                  }
                }
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/attendeeRows",
                "value": {
                  "$computed": "eventbrite_flatten_attendees",
                  "args": {
                    "value": {
                      "$state": "/eventbrite/list_attendees/attendees"
                    }
                  }
                }
              }
            }
          ],
          "/eventbrite/list_events/events": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/rows",
                "value": {
                  "$computed": "eventbrite_flatten_upcoming_events",
                  "args": {
                    "value": {
                      "$state": "/eventbrite/list_events/events"
                    }
                  }
                }
              }
            }
          ],
          "/eventbrite/list_organizations/organizations/0/id": {
            "action": "eventbrite.list_events",
            "params": {
              "order_by": "start_desc",
              "organization_id": {
                "$state": "/eventbrite/list_organizations/organizations/0/id"
              },
              "page_size": 20,
              "time_filter": "all"
            }
          }
        }
      },
      "checkedInLine": {
        "children": [
          "checkedInText",
          "percentBadge"
        ],
        "props": {
          "align": "center",
          "justify": "between"
        },
        "type": "Row",
        "visible": {
          "$state": "/ui/checkin/total"
        }
      },
      "checkedInText": {
        "props": {
          "size": "sm",
          "text": {
            "$computed": "fmt",
            "args": {
              "checked": {
                "$state": "/ui/checkin/checked_in"
              },
              "pattern": "{checked} of {total} checked in",
              "total": {
                "$state": "/ui/checkin/total"
              }
            }
          },
          "weight": "semibold"
        },
        "type": "Text"
      },
      "checkinDetail": {
        "children": [
          "seatsLine",
          "unlimitedCaption",
          "noAttendeesCaption",
          "checkedInLine",
          "progressBar",
          "remainingCaption",
          "attendeesHeading",
          "attendeeList",
          "truncationNote",
          "openBtnRow"
        ],
        "props": {
          "gap": "sm"
        },
        "type": "Stack",
        "visible": {
          "$state": "/_loading/eventbrite.list_attendees",
          "not": true
        }
      },
      "detailArea": {
        "children": [
          "detailDivider",
          "selectedEventInfo",
          "attendeeLoading",
          "checkinDetail"
        ],
        "props": {
          "gap": "sm"
        },
        "type": "Stack",
        "visible": {
          "$state": "/ui/selectedEvent/id"
        }
      },
      "detailDivider": {
        "props": {},
        "type": "Divider"
      },
      "divider0": {
        "props": {},
        "type": "Divider"
      },
      "emptyEvents": {
        "props": {
          "message": "No events found for this organization."
        },
        "type": "Empty",
        "visible": {
          "$and": [
            {
              "$state": "/_loading/eventbrite.list_organizations",
              "not": true
            },
            {
              "$state": "/_loading/eventbrite.list_events",
              "not": true
            },
            {
              "$state": "/ui/rows/0",
              "not": true
            }
          ]
        }
      },
      "eventList": {
        "children": [
          "eventRow"
        ],
        "props": {
          "gap": "xs"
        },
        "repeat": {
          "key": "id",
          "statePath": "/ui/rows"
        },
        "type": "Stack"
      },
      "eventRow": {
        "children": [
          "eventRowInfo",
          "eventRowBadge"
        ],
        "on": {
          "click": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/selectedEvent",
                "value": {
                  "$bindItem": ""
                }
              }
            },
            {
              "action": "eventbrite.list_attendees",
              "params": {
                "event_id": {
                  "$bindItem": "id"
                },
                "page_size": 200
              }
            }
          ]
        },
        "props": {
          "align": "center",
          "clickable": true,
          "gap": "sm",
          "hover": true,
          "justify": "between"
        },
        "type": "Row"
      },
      "eventRowBadge": {
        "props": {
          "text": {
            "$item": "status_label"
          },
          "tone": {
            "$item": "status_tone"
          },
          "variant": "soft"
        },
        "type": "Badge"
      },
      "eventRowDate": {
        "props": {
          "text": {
            "$item": "date_label"
          },
          "tone": "muted"
        },
        "type": "Caption"
      },
      "eventRowInfo": {
        "children": [
          "eventRowName",
          "eventRowDate"
        ],
        "props": {
          "gap": "none",
          "grow": true
        },
        "type": "Stack"
      },
      "eventRowName": {
        "props": {
          "size": "sm",
          "text": {
            "$item": "name"
          },
          "truncate": true,
          "weight": "semibold"
        },
        "type": "Text"
      },
      "eventsCaption": {
        "props": {
          "text": "Events",
          "tone": "muted"
        },
        "type": "Caption"
      },
      "eyebrow": {
        "props": {
          "text": "Eventbrite · Select an event"
        },
        "type": "Eyebrow"
      },
      "filledBadge": {
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{pct}% filled",
              "pct": {
                "$state": "/ui/checkin/filled_percent"
              }
            }
          },
          "tone": "brand",
          "variant": "soft"
        },
        "type": "Badge"
      },
      "header": {
        "children": [
          "titleGroup"
        ],
        "props": {},
        "type": "Header"
      },
      "loadingEvents": {
        "children": [
          "sk1",
          "sk2",
          "sk3"
        ],
        "props": {
          "gap": "sm"
        },
        "type": "Stack",
        "visible": {
          "$or": [
            {
              "$state": "/_loading/eventbrite.list_organizations"
            },
            {
              "$state": "/_loading/eventbrite.list_events"
            }
          ]
        }
      },
      "mainContent": {
        "children": [
          "eventsCaption",
          "eventList",
          "noSelectionHint",
          "detailArea"
        ],
        "props": {
          "gap": "sm"
        },
        "type": "Stack",
        "visible": {
          "$and": [
            {
              "$state": "/_loading/eventbrite.list_events",
              "not": true
            },
            {
              "$state": "/ui/rows/0"
            }
          ]
        }
      },
      "noAttendeesCaption": {
        "props": {
          "text": "No attendees registered for this event yet.",
          "tone": "muted"
        },
        "type": "Caption",
        "visible": {
          "$state": "/ui/checkin/total",
          "not": true
        }
      },
      "noSelectionHint": {
        "props": {
          "text": "Select an event above to see its check-in details.",
          "tone": "muted"
        },
        "type": "Caption",
        "visible": {
          "$state": "/ui/selectedEvent/id",
          "not": true
        }
      },
      "openBtn": {
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "target": "_blank",
              "url": {
                "$state": "/ui/selectedEvent/url"
              }
            }
          }
        },
        "props": {
          "label": "Open Eventbrite",
          "leadingIcon": "ExternalLink",
          "size": "sm",
          "tone": "brand",
          "variant": "primary"
        },
        "type": "Button"
      },
      "openBtnRow": {
        "children": [
          "openBtn"
        ],
        "props": {
          "justify": "end",
          "pt": "sm"
        },
        "type": "Row"
      },
      "percentBadge": {
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{pct}%",
              "pct": {
                "$state": "/ui/checkin/percent"
              }
            }
          },
          "tone": "brand",
          "variant": "soft"
        },
        "type": "Badge"
      },
      "progressBar": {
        "props": {
          "tone": "brand",
          "value": {
            "$state": "/ui/checkin/percent"
          }
        },
        "type": "ProgressBar",
        "visible": {
          "$state": "/ui/checkin/total"
        }
      },
      "remainingCaption": {
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{remaining} not yet checked in",
              "remaining": {
                "$state": "/ui/checkin/remaining"
              }
            }
          },
          "tone": "muted"
        },
        "type": "Caption",
        "visible": {
          "$state": "/ui/checkin/total"
        }
      },
      "seatsLine": {
        "children": [
          "seatsText",
          "filledBadge"
        ],
        "props": {
          "align": "center",
          "justify": "between"
        },
        "type": "Row",
        "visible": {
          "$state": "/ui/checkin/capacity"
        }
      },
      "seatsText": {
        "props": {
          "size": "sm",
          "text": {
            "$computed": "fmt",
            "args": {
              "capacity": {
                "$state": "/ui/checkin/capacity"
              },
              "pattern": "{total} of {capacity} seats",
              "total": {
                "$state": "/ui/checkin/total"
              }
            }
          },
          "weight": "semibold"
        },
        "type": "Text"
      },
      "selectedEventDate": {
        "props": {
          "text": {
            "$state": "/ui/selectedEvent/date_label"
          },
          "tone": "muted"
        },
        "type": "Caption"
      },
      "selectedEventInfo": {
        "children": [
          "selectedEventName",
          "selectedEventDate"
        ],
        "props": {
          "gap": "none"
        },
        "type": "Stack"
      },
      "selectedEventName": {
        "props": {
          "level": "h3",
          "text": {
            "$state": "/ui/selectedEvent/name"
          }
        },
        "type": "Heading"
      },
      "sk1": {
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "sk2": {
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "sk3": {
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "sk4": {
        "props": {
          "height": "1.5rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "sk5": {
        "props": {
          "height": "2rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "title": {
        "props": {
          "level": "h2",
          "text": "Check-In Progress"
        },
        "type": "Heading"
      },
      "titleGroup": {
        "children": [
          "titleIcon",
          "titleStack"
        ],
        "props": {
          "align": "center",
          "gap": "sm"
        },
        "type": "Row"
      },
      "titleIcon": {
        "props": {
          "name": "UserCheck",
          "size": "sm",
          "tone": "accent"
        },
        "type": "Icon"
      },
      "titleStack": {
        "children": [
          "title",
          "eyebrow"
        ],
        "props": {
          "gap": "none"
        },
        "type": "Stack"
      },
      "truncationNote": {
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "Showing 20 of {total} attendees",
              "total": {
                "$state": "/ui/checkin/total"
              }
            }
          },
          "tone": "muted"
        },
        "type": "Caption",
        "visible": {
          "$state": "/ui/checkin/total",
          "gt": 20
        }
      },
      "unlimitedCaption": {
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{total} registered · unlimited capacity",
              "total": {
                "$state": "/ui/checkin/total"
              }
            }
          },
          "tone": "muted"
        },
        "type": "Caption",
        "visible": {
          "$state": "/ui/checkin/capacity",
          "not": true
        }
      }
    },
    "root": "card"
  },
  "tags": [
    "eventbrite",
    "events",
    "attendees",
    "check-in"
  ],
  "title": "Check-In Progress"
}
