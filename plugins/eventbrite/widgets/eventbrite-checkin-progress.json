{
  "id": "eventbrite-checkin-progress",
  "title": "Check-In Progress",
  "description": "Browse your Eventbrite organization's events and view live check-in progress — checked-in count, percentage, and the attendee list — for whichever one you select. Zero-config: auto-resolves your organization, defaulting to the FIRST organization on the connected account if there is more than one (see this plugin's README).",
  "category": "marketing",
  "tags": ["eventbrite", "events", "attendees", "check-in"],
  "keywords": ["eventbrite check-in", "attendee check-in", "event day", "registration", "attendees", "event lookup"],
  "connectorsUsed": ["eventbrite"],
  "popularity": 0,
  "brandColor": "#34DFBA",
  "sizing": {
    "preferred": { "colSpan": 6, "rowSpan": 9 },
    "min": { "colSpan": 5, "rowSpan": 7 },
    "max": { "colSpan": 10, "rowSpan": 14 }
  },
  "dataProvider": {
    "mcp": "eventbrite",
    "tool": "list_organizations",
    "params": {}
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": ["header", "divider0", "body"],
        "watch": {
          "/eventbrite/list_organizations/organizations/0/id": {
            "action": "eventbrite.list_events",
            "params": {
              "organization_id": { "$state": "/eventbrite/list_organizations/organizations/0/id" },
              "time_filter": "all",
              "order_by": "start_desc",
              "page_size": 20
            }
          },
          "/eventbrite/list_events/events": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/rows",
                "value": {
                  "$computed": "eventbrite_flatten_upcoming_events",
                  "args": { "value": { "$state": "/eventbrite/list_events/events" } }
                }
              }
            }
          ],
          "/eventbrite/list_attendees/attendees": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/checkin",
                "value": {
                  "$computed": "eventbrite_checkin_summary",
                  "args": {
                    "attendees": { "$state": "/eventbrite/list_attendees/attendees" },
                    "capacity": { "$state": "/ui/selectedEvent/capacity" }
                  }
                }
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/attendeeRows",
                "value": {
                  "$computed": "eventbrite_flatten_attendees",
                  "args": { "value": { "$state": "/eventbrite/list_attendees/attendees" } }
                }
              }
            }
          ]
        }
      },

      "header": { "type": "Header", "props": {}, "children": ["titleGroup"] },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": { "type": "Icon", "props": { "name": "UserCheck", "tone": "accent", "size": "sm" } },
      "titleStack": { "type": "Stack", "props": { "gap": "none" }, "children": ["title", "eyebrow"] },
      "title": { "type": "Heading", "props": { "text": "Check-In Progress", "level": "h2" } },
      "eyebrow": { "type": "Eyebrow", "props": { "text": "Eventbrite · Select an event" } },

      "divider0": { "type": "Divider", "props": {} },

      "body": { "type": "Body", "props": {}, "children": ["loadingEvents", "emptyEvents", "mainContent"] },

      "loadingEvents": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["sk1", "sk2", "sk3"],
        "visible": {
          "$or": [
            { "$state": "/_loading/eventbrite.list_organizations" },
            { "$state": "/_loading/eventbrite.list_events" }
          ]
        }
      },
      "sk1": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "sk2": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "sk3": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },

      "emptyEvents": {
        "type": "Empty",
        "props": { "message": "No events found for this organization." },
        "visible": {
          "$and": [
            { "$state": "/_loading/eventbrite.list_organizations", "not": true },
            { "$state": "/_loading/eventbrite.list_events", "not": true },
            { "$state": "/ui/rows/0", "not": true }
          ]
        }
      },

      "mainContent": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["eventsCaption", "eventList", "noSelectionHint", "detailArea"],
        "visible": {
          "$and": [
            { "$state": "/_loading/eventbrite.list_events", "not": true },
            { "$state": "/ui/rows/0" }
          ]
        }
      },

      "eventsCaption": { "type": "Caption", "props": { "text": "Events", "tone": "muted" } },
      "eventList": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["eventRow"],
        "repeat": { "statePath": "/ui/rows", "key": "id" }
      },
      "eventRow": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center", "justify": "between", "hover": true, "clickable": true },
        "on": {
          "click": [
            {
              "action": "setState",
              "params": { "statePath": "/ui/selectedEvent", "value": { "$bindItem": "" } }
            },
            {
              "action": "eventbrite.list_attendees",
              "params": { "event_id": { "$bindItem": "id" }, "page_size": 200 }
            }
          ]
        },
        "children": ["eventRowInfo", "eventRowBadge"]
      },
      "eventRowInfo": {
        "type": "Stack",
        "props": { "gap": "none", "grow": true },
        "children": ["eventRowName", "eventRowDate"]
      },
      "eventRowName": {
        "type": "Text",
        "props": { "text": { "$item": "name" }, "size": "sm", "weight": "semibold", "truncate": true }
      },
      "eventRowDate": {
        "type": "Caption",
        "props": { "text": { "$item": "date_label" }, "tone": "muted" }
      },
      "eventRowBadge": {
        "type": "Badge",
        "props": { "text": { "$item": "status_label" }, "tone": { "$item": "status_tone" }, "variant": "soft" }
      },

      "noSelectionHint": {
        "type": "Caption",
        "props": { "text": "Select an event above to see its check-in details.", "tone": "muted" },
        "visible": { "$state": "/ui/selectedEvent/id", "not": true }
      },

      "detailArea": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": [
          "detailDivider",
          "selectedEventInfo",
          "attendeeLoading",
          "checkinDetail"
        ],
        "visible": { "$state": "/ui/selectedEvent/id" }
      },

      "detailDivider": { "type": "Divider", "props": {} },

      "selectedEventInfo": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["selectedEventName", "selectedEventDate"]
      },
      "selectedEventName": {
        "type": "Heading",
        "props": { "text": { "$state": "/ui/selectedEvent/name" }, "level": "h3" }
      },
      "selectedEventDate": {
        "type": "Caption",
        "props": { "text": { "$state": "/ui/selectedEvent/date_label" }, "tone": "muted" }
      },
      "openBtnRow": {
        "type": "Row",
        "props": { "justify": "end", "pt": "sm" },
        "children": ["openBtn"]
      },
      "openBtn": {
        "type": "Button",
        "props": { "label": "Open Eventbrite", "variant": "primary", "tone": "brand", "size": "sm", "leadingIcon": "ExternalLink" },
        "on": {
          "click": {
            "action": "open_url",
            "params": { "url": { "$state": "/ui/selectedEvent/url" }, "target": "_blank" }
          }
        }
      },

      "attendeeLoading": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["sk4", "sk5"],
        "visible": { "$state": "/_loading/eventbrite.list_attendees" }
      },
      "sk4": { "type": "Skeleton", "props": { "height": "1.5rem", "rounded": "md" } },
      "sk5": { "type": "Skeleton", "props": { "height": "2rem", "rounded": "md" } },

      "checkinDetail": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": [
          "seatsLine",
          "unlimitedCaption",
          "noAttendeesCaption",
          "checkedInLine",
          "progressBar",
          "remainingCaption",
          "attendeesHeading",
          "attendeeList",
          "truncationNote",
          "openBtnRow"
        ],
        "visible": { "$state": "/_loading/eventbrite.list_attendees", "not": true }
      },

      "seatsLine": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["seatsText", "filledBadge"],
        "visible": { "$state": "/ui/checkin/capacity" }
      },
      "seatsText": {
        "type": "Text",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{total} of {capacity} seats",
              "total": { "$state": "/ui/checkin/total" },
              "capacity": { "$state": "/ui/checkin/capacity" }
            }
          },
          "size": "sm",
          "weight": "semibold"
        }
      },
      "filledBadge": {
        "type": "Badge",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": { "pattern": "{pct}% filled", "pct": { "$state": "/ui/checkin/filled_percent" } }
          },
          "tone": "brand",
          "variant": "soft"
        }
      },
      "unlimitedCaption": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": { "pattern": "{total} registered · unlimited capacity", "total": { "$state": "/ui/checkin/total" } }
          },
          "tone": "muted"
        },
        "visible": { "$state": "/ui/checkin/capacity", "not": true }
      },

      "noAttendeesCaption": {
        "type": "Caption",
        "props": { "text": "No attendees registered for this event yet.", "tone": "muted" },
        "visible": { "$state": "/ui/checkin/total", "not": true }
      },

      "checkedInLine": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["checkedInText", "percentBadge"],
        "visible": { "$state": "/ui/checkin/total" }
      },
      "checkedInText": {
        "type": "Text",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{checked} of {total} checked in",
              "checked": { "$state": "/ui/checkin/checked_in" },
              "total": { "$state": "/ui/checkin/total" }
            }
          },
          "size": "sm",
          "weight": "semibold"
        }
      },
      "percentBadge": {
        "type": "Badge",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": { "pattern": "{pct}%", "pct": { "$state": "/ui/checkin/percent" } }
          },
          "tone": "brand",
          "variant": "soft"
        }
      },

      "progressBar": {
        "type": "ProgressBar",
        "props": { "value": { "$state": "/ui/checkin/percent" }, "tone": "brand" },
        "visible": { "$state": "/ui/checkin/total" }
      },

      "remainingCaption": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{remaining} not yet checked in",
              "remaining": { "$state": "/ui/checkin/remaining" }
            }
          },
          "tone": "muted"
        },
        "visible": { "$state": "/ui/checkin/total" }
      },

      "attendeesHeading": {
        "type": "Caption",
        "props": { "text": "Attendees", "tone": "muted" },
        "visible": { "$state": "/ui/attendeeRows/0" }
      },
      "attendeeList": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["attendeeRow"],
        "repeat": { "statePath": "/ui/attendeeRows", "key": "id" },
        "visible": { "$state": "/ui/attendeeRows/0" }
      },
      "attendeeRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center", "gap": "sm" },
        "children": ["attendeeInfo", "attendeeBadge"]
      },
      "attendeeInfo": {
        "type": "Stack",
        "props": { "gap": "none", "grow": true },
        "children": ["attendeeName", "attendeeEmail", "attendeeTicket"]
      },
      "attendeeName": {
        "type": "Text",
        "props": { "text": { "$item": "name" }, "size": "sm", "weight": "medium", "truncate": true }
      },
      "attendeeEmail": {
        "type": "Caption",
        "props": { "text": { "$item": "email" }, "tone": "muted", "truncate": true }
      },
      "attendeeTicket": {
        "type": "Caption",
        "props": { "text": { "$item": "ticket_label" }, "tone": "muted" }
      },
      "attendeeBadge": {
        "type": "Badge",
        "props": { "text": { "$item": "checkin_label" }, "tone": { "$item": "checkin_tone" }, "variant": "soft" }
      },

      "truncationNote": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": { "pattern": "Showing 20 of {total} attendees", "total": { "$state": "/ui/checkin/total" } }
          },
          "tone": "muted"
        },
        "visible": { "$state": "/ui/checkin/total", "gt": 20 }
      }
    }
  },
  "status": "published"
}
