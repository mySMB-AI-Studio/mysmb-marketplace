{
  "brandColor": "#34DFBA",
  "category": "marketing",
  "connectorsUsed": [
    "eventbrite"
  ],
  "dataProvider": {
    "kind": "tool",
    "mcp": "eventbrite",
    "params": {},
    "tool": "list_organizations"
  },
  "description": "Current and future events for your Eventbrite organization. Zero-config: auto-resolves your organization from list_organizations, then fetches its upcoming events — defaults to the FIRST organization on the connected account if there is more than one (see this plugin's README).",
  "id": "eventbrite-upcoming-events",
  "keywords": [
    "eventbrite events",
    "upcoming events",
    "event list",
    "ticketing",
    "registration"
  ],
  "popularity": 0,
  "sizing": {
    "max": {
      "colSpan": 10,
      "rowSpan": 12
    },
    "min": {
      "colSpan": 4,
      "rowSpan": 4
    },
    "preferred": {
      "colSpan": 5,
      "rowSpan": 6
    }
  },
  "spec": {
    "elements": {
      "body": {
        "children": [
          "loading",
          "empty",
          "eventList"
        ],
        "props": {},
        "type": "Body"
      },
      "card": {
        "children": [
          "header",
          "div0",
          "body",
          "footerRow"
        ],
        "props": {},
        "type": "Card",
        "watch": {
          "/eventbrite/list_events/events": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/rows",
                "value": {
                  "$computed": "eventbrite_flatten_upcoming_events",
                  "args": {
                    "value": {
                      "$state": "/eventbrite/list_events/events"
                    }
                  }
                }
              }
            }
          ],
          "/eventbrite/list_organizations/organizations/0/id": {
            "action": "eventbrite.list_events",
            "params": {
              "order_by": "start_asc",
              "organization_id": {
                "$state": "/eventbrite/list_organizations/organizations/0/id"
              },
              "page_size": 20,
              "time_filter": "current_future"
            }
          }
        }
      },
      "div0": {
        "props": {},
        "type": "Divider"
      },
      "empty": {
        "props": {
          "message": "No upcoming events found for this organization."
        },
        "type": "Empty",
        "visible": {
          "$and": [
            {
              "$state": "/_loading/eventbrite.list_organizations",
              "not": true
            },
            {
              "$state": "/_loading/eventbrite.list_events",
              "not": true
            },
            {
              "$state": "/ui/rows/0",
              "not": true
            }
          ]
        }
      },
      "eventDivider": {
        "props": {},
        "type": "Divider"
      },
      "eventInfo": {
        "children": [
          "eventName",
          "eventMeta"
        ],
        "props": {
          "gap": "none",
          "grow": true
        },
        "type": "Stack"
      },
      "eventList": {
        "children": [
          "eventRow"
        ],
        "props": {
          "gap": "xs"
        },
        "repeat": {
          "key": "id",
          "statePath": "/ui/rows"
        },
        "type": "Stack",
        "visible": {
          "$and": [
            {
              "$state": "/_loading/eventbrite.list_events",
              "not": true
            },
            {
              "$state": "/ui/rows/0"
            }
          ]
        }
      },
      "eventMeta": {
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "date": {
                "$item": "date_label"
              },
              "location": {
                "$item": "location_label"
              },
              "pattern": "{date} · {location}"
            }
          },
          "tone": "muted"
        },
        "type": "Caption"
      },
      "eventName": {
        "props": {
          "size": "sm",
          "text": {
            "$item": "name"
          },
          "truncate": true,
          "weight": "semibold"
        },
        "type": "Text"
      },
      "eventRow": {
        "children": [
          "eventRowContent",
          "eventDivider"
        ],
        "props": {
          "gap": "xs"
        },
        "type": "Stack"
      },
      "eventRowContent": {
        "children": [
          "eventInfo",
          "eventStatusBadge"
        ],
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "target": "_blank",
              "url": {
                "$bindItem": "url"
              }
            }
          }
        },
        "props": {
          "align": "center",
          "clickable": true,
          "gap": "sm",
          "hover": true,
          "justify": "between"
        },
        "type": "Row"
      },
      "eventStatusBadge": {
        "props": {
          "text": {
            "$item": "status_label"
          },
          "tone": {
            "$item": "status_tone"
          },
          "variant": "soft"
        },
        "type": "Badge"
      },
      "eyebrow": {
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "n": {
                "$computed": "count",
                "args": {
                  "value": {
                    "$state": "/eventbrite/list_events/events"
                  }
                }
              },
              "pattern": "Eventbrite · {n} events"
            }
          }
        },
        "type": "Eyebrow",
        "visible": {
          "$state": "/ui/rows/0"
        }
      },
      "footerOpenBtn": {
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "target": "_blank",
              "url": "https://www.eventbrite.com"
            }
          }
        },
        "props": {
          "label": "Open Eventbrite",
          "leadingIcon": "ExternalLink",
          "size": "sm",
          "tone": "brand",
          "variant": "primary"
        },
        "type": "Button"
      },
      "footerRow": {
        "children": [
          "footerOpenBtn"
        ],
        "props": {
          "justify": "end",
          "pt": "sm"
        },
        "type": "Row"
      },
      "header": {
        "children": [
          "titleGroup"
        ],
        "props": {},
        "type": "Header"
      },
      "loading": {
        "children": [
          "sk1",
          "sk2",
          "sk3",
          "sk4"
        ],
        "props": {
          "gap": "sm"
        },
        "type": "Stack",
        "visible": {
          "$or": [
            {
              "$state": "/_loading/eventbrite.list_organizations"
            },
            {
              "$state": "/_loading/eventbrite.list_events"
            }
          ]
        }
      },
      "sk1": {
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "sk2": {
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "sk3": {
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "sk4": {
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "title": {
        "props": {
          "level": "h2",
          "text": "Upcoming Events"
        },
        "type": "Heading"
      },
      "titleGroup": {
        "children": [
          "titleIcon",
          "titleStack"
        ],
        "props": {
          "align": "center",
          "gap": "sm"
        },
        "type": "Row"
      },
      "titleIcon": {
        "props": {
          "name": "Ticket",
          "size": "sm",
          "tone": "accent"
        },
        "type": "Icon"
      },
      "titleStack": {
        "children": [
          "title",
          "eyebrow"
        ],
        "props": {
          "gap": "none"
        },
        "type": "Stack"
      }
    },
    "root": "card"
  },
  "tags": [
    "eventbrite",
    "events",
    "tickets",
    "registration"
  ],
  "title": "Upcoming Events"
}
