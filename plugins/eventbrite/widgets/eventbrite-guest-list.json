{
  "brandColor": "#34DFBA",
  "category": "marketing",
  "connectorsUsed": [
    "eventbrite"
  ],
  "dataProvider": {
    "kind": "tool",
    "mcp": "eventbrite",
    "params": {},
    "tool": "list_organizations"
  },
  "description": "Browse your Eventbrite organization's events and pull up the full guest roster for whichever one you select — every registrant, not just a check-in percentage — split into All / Checked In / Not Checked In / Cancelled tabs. Zero-config: auto-resolves your organization, defaulting to the FIRST organization on the connected account if there is more than one (see this plugin's README). Complements the Check-In Progress tile: that one answers \"how full is the room right now\", this one answers \"who exactly is on the list\" (search a name, see who's cancelled/refunded, etc.).",
  "id": "eventbrite-guest-list",
  "keywords": [
    "eventbrite guest list",
    "attendee directory",
    "guest roster",
    "event attendees",
    "registration list",
    "who's coming"
  ],
  "popularity": 0,
  "sizing": {
    "max": {
      "colSpan": 10,
      "rowSpan": 14
    },
    "min": {
      "colSpan": 5,
      "rowSpan": 7
    },
    "preferred": {
      "colSpan": 6,
      "rowSpan": 9
    }
  },
  "spec": {
    "elements": {
      "allContent": {
        "children": [
          "allEmpty",
          "allList",
          "allTruncation"
        ],
        "props": {
          "gap": "xs"
        },
        "type": "Stack",
        "visible": {
          "$state": "/ui/tab",
          "eq": "all"
        }
      },
      "allEmpty": {
        "props": {
          "message": "No registrations for this event yet."
        },
        "type": "Empty",
        "visible": {
          "$state": "/ui/guests/all/0",
          "not": true
        }
      },
      "allList": {
        "children": [
          "guestRow"
        ],
        "props": {
          "gap": "xs"
        },
        "repeat": {
          "key": "id",
          "statePath": "/ui/guests/all"
        },
        "type": "Stack"
      },
      "allTruncation": {
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "n": {
                "$state": "/ui/guests/all_total"
              },
              "pattern": "Showing 20 of {n}"
            }
          },
          "tone": "muted"
        },
        "type": "Caption",
        "visible": {
          "$state": "/ui/guests/all_total",
          "gt": 20
        }
      },
      "attendeeLoading": {
        "children": [
          "sk4",
          "sk5"
        ],
        "props": {
          "gap": "sm"
        },
        "type": "Stack",
        "visible": {
          "$state": "/_loading/eventbrite.list_attendees"
        }
      },
      "body": {
        "children": [
          "loadingEvents",
          "emptyEvents",
          "mainContent"
        ],
        "props": {},
        "type": "Body"
      },
      "cancelledContent": {
        "children": [
          "cancelledEmpty",
          "cancelledList",
          "cancelledTruncation"
        ],
        "props": {
          "gap": "xs"
        },
        "type": "Stack",
        "visible": {
          "$state": "/ui/tab",
          "eq": "cancelled"
        }
      },
      "cancelledEmpty": {
        "props": {
          "message": "No cancelled or refunded registrations."
        },
        "type": "Empty",
        "visible": {
          "$state": "/ui/guests/cancelled/0",
          "not": true
        }
      },
      "cancelledList": {
        "children": [
          "guestRow"
        ],
        "props": {
          "gap": "xs"
        },
        "repeat": {
          "key": "id",
          "statePath": "/ui/guests/cancelled"
        },
        "type": "Stack"
      },
      "cancelledTruncation": {
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "n": {
                "$state": "/ui/guests/cancelled_total"
              },
              "pattern": "Showing 20 of {n}"
            }
          },
          "tone": "muted"
        },
        "type": "Caption",
        "visible": {
          "$state": "/ui/guests/cancelled_total",
          "gt": 20
        }
      },
      "card": {
        "children": [
          "header",
          "divider0",
          "body"
        ],
        "props": {},
        "type": "Card",
        "watch": {
          "/eventbrite/list_attendees/attendees": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/guests",
                "value": {
                  "$computed": "eventbrite_flatten_guest_list",
                  "args": {
                    "value": {
                      "$state": "/eventbrite/list_attendees/attendees"
                    }
                  }
                }
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/tab",
                "value": "all"
              }
            }
          ],
          "/eventbrite/list_events/events": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/rows",
                "value": {
                  "$computed": "eventbrite_flatten_upcoming_events",
                  "args": {
                    "value": {
                      "$state": "/eventbrite/list_events/events"
                    }
                  }
                }
              }
            }
          ],
          "/eventbrite/list_organizations/organizations/0/id": {
            "action": "eventbrite.list_events",
            "params": {
              "order_by": "start_desc",
              "organization_id": {
                "$state": "/eventbrite/list_organizations/organizations/0/id"
              },
              "page_size": 20,
              "time_filter": "all"
            }
          }
        }
      },
      "checkedInContent": {
        "children": [
          "checkedInEmpty",
          "checkedInList",
          "checkedInTruncation"
        ],
        "props": {
          "gap": "xs"
        },
        "type": "Stack",
        "visible": {
          "$state": "/ui/tab",
          "eq": "checked_in"
        }
      },
      "checkedInEmpty": {
        "props": {
          "message": "No one has checked in yet."
        },
        "type": "Empty",
        "visible": {
          "$state": "/ui/guests/checked_in/0",
          "not": true
        }
      },
      "checkedInList": {
        "children": [
          "guestRow"
        ],
        "props": {
          "gap": "xs"
        },
        "repeat": {
          "key": "id",
          "statePath": "/ui/guests/checked_in"
        },
        "type": "Stack"
      },
      "checkedInTruncation": {
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "n": {
                "$state": "/ui/guests/checked_in_total"
              },
              "pattern": "Showing 20 of {n}"
            }
          },
          "tone": "muted"
        },
        "type": "Caption",
        "visible": {
          "$state": "/ui/guests/checked_in_total",
          "gt": 20
        }
      },
      "detailArea": {
        "children": [
          "detailDivider",
          "selectedEventInfo",
          "attendeeLoading",
          "guestListDetail"
        ],
        "props": {
          "gap": "sm"
        },
        "type": "Stack",
        "visible": {
          "$state": "/ui/selectedEvent/id"
        }
      },
      "detailDivider": {
        "props": {},
        "type": "Divider"
      },
      "divider0": {
        "props": {},
        "type": "Divider"
      },
      "emptyEvents": {
        "props": {
          "message": "No events found for this organization."
        },
        "type": "Empty",
        "visible": {
          "$and": [
            {
              "$state": "/_loading/eventbrite.list_organizations",
              "not": true
            },
            {
              "$state": "/_loading/eventbrite.list_events",
              "not": true
            },
            {
              "$state": "/ui/rows/0",
              "not": true
            }
          ]
        }
      },
      "eventList": {
        "children": [
          "eventRow"
        ],
        "props": {
          "gap": "xs"
        },
        "repeat": {
          "key": "id",
          "statePath": "/ui/rows"
        },
        "type": "Stack"
      },
      "eventRow": {
        "children": [
          "eventRowIcon",
          "eventRowInfo",
          "eventRowBadge"
        ],
        "on": {
          "click": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/selectedEvent",
                "value": {
                  "$bindItem": ""
                }
              }
            },
            {
              "action": "eventbrite.list_attendees",
              "params": {
                "event_id": {
                  "$bindItem": "id"
                },
                "page_size": 200
              }
            }
          ]
        },
        "props": {
          "align": "center",
          "clickable": true,
          "gap": "sm",
          "hover": true,
          "justify": "between"
        },
        "type": "Row"
      },
      "eventRowBadge": {
        "props": {
          "text": {
            "$item": "status_label"
          },
          "tone": {
            "$item": "status_tone"
          },
          "variant": "soft"
        },
        "type": "Badge"
      },
      "eventRowDate": {
        "props": {
          "text": {
            "$item": "date_label"
          },
          "tone": "muted"
        },
        "type": "Caption"
      },
      "eventRowIcon": {
        "props": {
          "name": "Calendar",
          "size": "sm",
          "tone": {
            "$item": "status_tone"
          }
        },
        "type": "Icon"
      },
      "eventRowInfo": {
        "children": [
          "eventRowName",
          "eventRowDate"
        ],
        "props": {
          "gap": "none",
          "grow": true
        },
        "type": "Stack"
      },
      "eventRowName": {
        "props": {
          "size": "sm",
          "text": {
            "$item": "name"
          },
          "truncate": true,
          "weight": "semibold"
        },
        "type": "Text"
      },
      "eventsCaption": {
        "props": {
          "text": "Events",
          "tone": "muted"
        },
        "type": "Caption"
      },
      "eyebrow": {
        "props": {
          "text": "Eventbrite · Select an event"
        },
        "type": "Eyebrow"
      },
      "guestAvatar": {
        "props": {
          "initials": {
            "$computed": "initials",
            "args": {
              "value": {
                "$item": "name"
              }
            }
          },
          "size": "sm",
          "tone": {
            "$item": "status_tone"
          }
        },
        "type": "Avatar"
      },
      "guestBadge": {
        "props": {
          "text": {
            "$item": "status_label"
          },
          "tone": {
            "$item": "status_tone"
          },
          "variant": "soft"
        },
        "type": "Badge"
      },
      "guestEmail": {
        "props": {
          "text": {
            "$item": "email"
          },
          "tone": "muted",
          "truncate": true
        },
        "type": "Caption"
      },
      "guestInfo": {
        "children": [
          "guestName",
          "guestEmail",
          "guestTicket"
        ],
        "props": {
          "gap": "none",
          "grow": true
        },
        "type": "Stack"
      },
      "guestListDetail": {
        "children": [
          "tabRow",
          "allContent",
          "checkedInContent",
          "notCheckedInContent",
          "cancelledContent",
          "openBtnRow"
        ],
        "props": {
          "gap": "sm"
        },
        "type": "Stack",
        "visible": {
          "$state": "/_loading/eventbrite.list_attendees",
          "not": true
        }
      },
      "guestName": {
        "props": {
          "size": "sm",
          "text": {
            "$item": "name"
          },
          "truncate": true,
          "weight": "medium"
        },
        "type": "Text"
      },
      "guestRow": {
        "children": [
          "guestAvatar",
          "guestInfo",
          "guestBadge"
        ],
        "props": {
          "align": "center",
          "gap": "sm",
          "justify": "between"
        },
        "type": "Row"
      },
      "guestTicket": {
        "props": {
          "text": {
            "$item": "ticket_label"
          },
          "tone": "muted"
        },
        "type": "Caption"
      },
      "header": {
        "children": [
          "titleGroup"
        ],
        "props": {},
        "type": "Header"
      },
      "loadingEvents": {
        "children": [
          "sk1",
          "sk2",
          "sk3"
        ],
        "props": {
          "gap": "sm"
        },
        "type": "Stack",
        "visible": {
          "$or": [
            {
              "$state": "/_loading/eventbrite.list_organizations"
            },
            {
              "$state": "/_loading/eventbrite.list_events"
            }
          ]
        }
      },
      "mainContent": {
        "children": [
          "eventsCaption",
          "eventList",
          "noSelectionHint",
          "detailArea"
        ],
        "props": {
          "gap": "sm"
        },
        "type": "Stack",
        "visible": {
          "$and": [
            {
              "$state": "/_loading/eventbrite.list_events",
              "not": true
            },
            {
              "$state": "/ui/rows/0"
            }
          ]
        }
      },
      "noSelectionHint": {
        "props": {
          "text": "Select an event above to see its guest list.",
          "tone": "muted"
        },
        "type": "Caption",
        "visible": {
          "$state": "/ui/selectedEvent/id",
          "not": true
        }
      },
      "notCheckedInContent": {
        "children": [
          "notCheckedInEmpty",
          "notCheckedInList",
          "notCheckedInTruncation"
        ],
        "props": {
          "gap": "xs"
        },
        "type": "Stack",
        "visible": {
          "$state": "/ui/tab",
          "eq": "not_checked_in"
        }
      },
      "notCheckedInEmpty": {
        "props": {
          "message": "Everyone registered has checked in."
        },
        "type": "Empty",
        "visible": {
          "$state": "/ui/guests/not_checked_in/0",
          "not": true
        }
      },
      "notCheckedInList": {
        "children": [
          "guestRow"
        ],
        "props": {
          "gap": "xs"
        },
        "repeat": {
          "key": "id",
          "statePath": "/ui/guests/not_checked_in"
        },
        "type": "Stack"
      },
      "notCheckedInTruncation": {
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "n": {
                "$state": "/ui/guests/not_checked_in_total"
              },
              "pattern": "Showing 20 of {n}"
            }
          },
          "tone": "muted"
        },
        "type": "Caption",
        "visible": {
          "$state": "/ui/guests/not_checked_in_total",
          "gt": 20
        }
      },
      "openBtn": {
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "target": "_blank",
              "url": {
                "$state": "/ui/selectedEvent/url"
              }
            }
          }
        },
        "props": {
          "label": "Open Eventbrite",
          "leadingIcon": "ExternalLink",
          "size": "sm",
          "tone": "brand",
          "variant": "primary"
        },
        "type": "Button"
      },
      "openBtnRow": {
        "children": [
          "openBtn"
        ],
        "props": {
          "justify": "end",
          "pt": "sm"
        },
        "type": "Row"
      },
      "selectedEventDate": {
        "props": {
          "text": {
            "$state": "/ui/selectedEvent/date_label"
          },
          "tone": "muted"
        },
        "type": "Caption"
      },
      "selectedEventInfo": {
        "children": [
          "selectedEventName",
          "selectedEventDate"
        ],
        "props": {
          "gap": "none"
        },
        "type": "Stack"
      },
      "selectedEventName": {
        "props": {
          "level": "h3",
          "text": {
            "$state": "/ui/selectedEvent/name"
          }
        },
        "type": "Heading"
      },
      "sk1": {
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "sk2": {
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "sk3": {
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "sk4": {
        "props": {
          "height": "1.5rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "sk5": {
        "props": {
          "height": "2rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "tabAllOff": {
        "on": {
          "click": {
            "action": "setState",
            "params": {
              "statePath": "/ui/tab",
              "value": "all"
            }
          }
        },
        "props": {
          "label": {
            "$computed": "fmt",
            "args": {
              "n": {
                "$state": "/ui/guests/all_total"
              },
              "pattern": "All ({n})"
            }
          },
          "size": "sm",
          "variant": "ghost"
        },
        "type": "Button",
        "visible": {
          "$state": "/ui/tab",
          "eq": "all",
          "not": true
        }
      },
      "tabAllOn": {
        "props": {
          "label": {
            "$computed": "fmt",
            "args": {
              "n": {
                "$state": "/ui/guests/all_total"
              },
              "pattern": "All ({n})"
            }
          },
          "size": "sm",
          "tone": "brand",
          "variant": "primary"
        },
        "type": "Button",
        "visible": {
          "$state": "/ui/tab",
          "eq": "all"
        }
      },
      "tabCancelledOff": {
        "on": {
          "click": {
            "action": "setState",
            "params": {
              "statePath": "/ui/tab",
              "value": "cancelled"
            }
          }
        },
        "props": {
          "label": {
            "$computed": "fmt",
            "args": {
              "n": {
                "$state": "/ui/guests/cancelled_total"
              },
              "pattern": "Cancelled ({n})"
            }
          },
          "size": "sm",
          "variant": "ghost"
        },
        "type": "Button",
        "visible": {
          "$state": "/ui/tab",
          "eq": "cancelled",
          "not": true
        }
      },
      "tabCancelledOn": {
        "props": {
          "label": {
            "$computed": "fmt",
            "args": {
              "n": {
                "$state": "/ui/guests/cancelled_total"
              },
              "pattern": "Cancelled ({n})"
            }
          },
          "size": "sm",
          "tone": "destructive",
          "variant": "primary"
        },
        "type": "Button",
        "visible": {
          "$state": "/ui/tab",
          "eq": "cancelled"
        }
      },
      "tabCheckedInOff": {
        "on": {
          "click": {
            "action": "setState",
            "params": {
              "statePath": "/ui/tab",
              "value": "checked_in"
            }
          }
        },
        "props": {
          "label": {
            "$computed": "fmt",
            "args": {
              "n": {
                "$state": "/ui/guests/checked_in_total"
              },
              "pattern": "Checked In ({n})"
            }
          },
          "size": "sm",
          "variant": "ghost"
        },
        "type": "Button",
        "visible": {
          "$state": "/ui/tab",
          "eq": "checked_in",
          "not": true
        }
      },
      "tabCheckedInOn": {
        "props": {
          "label": {
            "$computed": "fmt",
            "args": {
              "n": {
                "$state": "/ui/guests/checked_in_total"
              },
              "pattern": "Checked In ({n})"
            }
          },
          "size": "sm",
          "tone": "success",
          "variant": "primary"
        },
        "type": "Button",
        "visible": {
          "$state": "/ui/tab",
          "eq": "checked_in"
        }
      },
      "tabNotCheckedInOff": {
        "on": {
          "click": {
            "action": "setState",
            "params": {
              "statePath": "/ui/tab",
              "value": "not_checked_in"
            }
          }
        },
        "props": {
          "label": {
            "$computed": "fmt",
            "args": {
              "n": {
                "$state": "/ui/guests/not_checked_in_total"
              },
              "pattern": "Not Checked In ({n})"
            }
          },
          "size": "sm",
          "variant": "ghost"
        },
        "type": "Button",
        "visible": {
          "$state": "/ui/tab",
          "eq": "not_checked_in",
          "not": true
        }
      },
      "tabNotCheckedInOn": {
        "props": {
          "label": {
            "$computed": "fmt",
            "args": {
              "n": {
                "$state": "/ui/guests/not_checked_in_total"
              },
              "pattern": "Not Checked In ({n})"
            }
          },
          "size": "sm",
          "variant": "primary"
        },
        "type": "Button",
        "visible": {
          "$state": "/ui/tab",
          "eq": "not_checked_in"
        }
      },
      "tabRow": {
        "children": [
          "tabAllOn",
          "tabAllOff",
          "tabCheckedInOn",
          "tabCheckedInOff",
          "tabNotCheckedInOn",
          "tabNotCheckedInOff",
          "tabCancelledOn",
          "tabCancelledOff"
        ],
        "props": {
          "gap": "xs",
          "wrap": true
        },
        "type": "Row"
      },
      "title": {
        "props": {
          "level": "h2",
          "text": "Guest List"
        },
        "type": "Heading"
      },
      "titleGroup": {
        "children": [
          "titleIcon",
          "titleStack"
        ],
        "props": {
          "align": "center",
          "gap": "sm"
        },
        "type": "Row"
      },
      "titleIcon": {
        "props": {
          "name": "BookUser",
          "size": "sm",
          "tone": "accent"
        },
        "type": "Icon"
      },
      "titleStack": {
        "children": [
          "title",
          "eyebrow"
        ],
        "props": {
          "gap": "none"
        },
        "type": "Stack"
      }
    },
    "root": "card"
  },
  "tags": [
    "eventbrite",
    "events",
    "attendees",
    "guest list",
    "directory"
  ],
  "title": "Guest List"
}
