{
  "id": "simpro-materials-required-demo",
  "title": "Materials Required (Demo)",
  "description": "Static demo of the Simpro Materials Required widget — 3 hardcoded jobs with item lists, supplier info, and stock status.",
  "category": "operations",
  "tags": ["simpro", "materials", "parts", "procurement", "field-service", "electrical", "trade", "demo"],
  "keywords": ["materials", "parts", "awaiting", "procurement", "supplier", "stock", "simpro", "jobs", "demo"],
  "connectorsUsed": ["simpro"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 5, "rowSpan": 8 },
    "min":       { "colSpan": 4, "rowSpan": 5 },
    "max":       { "colSpan": 10, "rowSpan": 12 }
  },
  "spec": {
    "root": "card",
    "elements": {

      "card": {
        "type": "Card",
        "props": {},
        "children": ["titleRow", "sub", "divider", "scrollBody"]
      },

      "titleRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["titleGroup"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "Package", "tone": "accent", "size": "sm" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "eyebrow"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Materials Required", "level": "h2" }
      },
      "eyebrow": {
        "type": "Eyebrow",
        "props": { "text": "Simpro" }
      },

      "sub": {
        "type": "Text",
        "props": { "text": "Required per job · supplier orders tracked", "size": "xs", "tone": "muted" }
      },

      "divider": { "type": "Divider", "props": {} },

      "scrollBody": {
        "type": "Body",
        "props": {},
        "children": ["rows"]
      },

      "rows": {
        "type": "Stack",
        "props": { "gap": "md" },
        "children": ["m1", "d1", "m2", "d2", "m3"]
      },

      "d1": { "type": "Divider", "props": {} },
      "d2": { "type": "Divider", "props": {} },

      "m1":       { "type": "Stack",  "props": { "gap": "xs" },                                  "children": ["m1Head", "m1Items", "m1Sup"] },
      "m1Head":   { "type": "Row",    "props": { "gap": "xs", "align": "center" },               "children": ["m1No", "m1Name"] },
      "m1No":     { "type": "Badge",  "props": { "text": "J-2301", "tone": "accent" } },
      "m1Name":   { "type": "Text",   "props": { "text": "Brunswick cafe fitout", "size": "sm", "weight": "semibold" } },
      "m1Items":  { "type": "Text",   "props": { "text": "6× double GPO · 50m TPS 2.5mm · 2× CAT6 run · cable tray 3m", "size": "xs", "tone": "muted" } },
      "m1Sup":    { "type": "Row",    "props": { "gap": "xs", "align": "center", "wrap": true }, "children": ["m1Status", "m1SupText"] },
      "m1Status": { "type": "Badge",  "props": { "text": "RFQ sent", "tone": "destructive" } },
      "m1SupText":{ "type": "Text",   "props": { "text": "Lawrence & Hanson · awaiting price 3 days", "size": "xs", "tone": "muted", "truncate": true } },

      "m2":       { "type": "Stack",  "props": { "gap": "xs" },                                  "children": ["m2Head", "m2Items", "m2Sup"] },
      "m2Head":   { "type": "Row",    "props": { "gap": "xs", "align": "center" },               "children": ["m2No", "m2Name"] },
      "m2No":     { "type": "Badge",  "props": { "text": "J-2295", "tone": "accent" } },
      "m2Name":   { "type": "Text",   "props": { "text": "Patel safety switches", "size": "sm", "weight": "semibold" } },
      "m2Items":  { "type": "Text",   "props": { "text": "2× Clipsal RCD 25A Type A", "size": "xs", "tone": "muted" } },
      "m2Sup":    { "type": "Row",    "props": { "gap": "xs", "align": "center", "wrap": true }, "children": ["m2Status", "m2SupText"] },
      "m2Status": { "type": "Badge",  "props": { "text": "On order", "tone": "success" } },
      "m2SupText":{ "type": "Text",   "props": { "text": "Middy's Preston · pickup today 1pm", "size": "xs", "tone": "muted", "truncate": true } },

      "m3":       { "type": "Stack",  "props": { "gap": "xs" },                                  "children": ["m3Head", "m3Items", "m3Sup"] },
      "m3Head":   { "type": "Row",    "props": { "gap": "xs", "align": "center" },               "children": ["m3No", "m3Name"] },
      "m3No":     { "type": "Badge",  "props": { "text": "J-2287", "tone": "accent" } },
      "m3Name":   { "type": "Text",   "props": { "text": "Hargreaves switchboard", "size": "sm", "weight": "semibold" } },
      "m3Items":  { "type": "Text",   "props": { "text": "100A main switch · 12-pole enclosure · 6× MCB", "size": "xs", "tone": "muted" } },
      "m3Sup":    { "type": "Row",    "props": { "gap": "xs", "align": "center", "wrap": true }, "children": ["m3Status", "m3SupText"] },
      "m3Status": { "type": "Badge",  "props": { "text": "In stock — van", "tone": "success" } },
      "m3SupText":{ "type": "Text",   "props": { "text": "from existing stock", "size": "xs", "tone": "muted", "truncate": true } }

    }
  },
  "status": "published"
}
