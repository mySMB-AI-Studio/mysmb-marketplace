{
  "id": "simpro-active-jobs-demo",
  "title": "Active Jobs (Demo)",
  "description": "Static demo of the SimPro Active Jobs widget — 7 hardcoded electrical contractor jobs.",
  "category": "operations",
  "tags": ["simpro", "jobs", "field-service", "electrical", "trade", "work-orders", "demo"],
  "keywords": ["jobs", "active jobs", "work orders", "field service", "simpro", "job management", "demo"],
  "connectorsUsed": ["simpro"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 5, "rowSpan": 8 },
    "min":       { "colSpan": 4, "rowSpan": 5 },
    "max":       { "colSpan": 10, "rowSpan": 12 }
  },
  "spec": {
    "root": "card",
    "elements": {

      "card": {
        "type": "Card",
        "props": {},
        "children": ["titleRow", "colHeader", "divider", "scrollBody"]
      },

      "titleRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["titleGroup"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "Briefcase", "tone": "accent", "size": "sm" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "eyebrow"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Active Jobs", "level": "h2" }
      },
      "eyebrow": {
        "type": "Eyebrow",
        "props": { "text": "SimPro" }
      },

      "colHeader": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["colLeft", "colRight"]
      },
      "colLeft":  { "type": "Caption", "props": { "text": "JOB / CUSTOMER" } },
      "colRight": { "type": "Caption", "props": { "text": "TOTAL / STATUS" } },

      "divider": { "type": "Divider", "props": {} },

      "scrollBody": {
        "type": "Body",
        "props": {},
        "children": ["rows"]
      },

      "rows": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["j1", "rd1", "j2", "rd2", "j3", "rd3", "j4", "rd4", "j5", "rd5", "j6", "rd6", "j7"]
      },

      "rd1": { "type": "Divider", "props": {} },
      "rd2": { "type": "Divider", "props": {} },
      "rd3": { "type": "Divider", "props": {} },
      "rd4": { "type": "Divider", "props": {} },
      "rd5": { "type": "Divider", "props": {} },
      "rd6": { "type": "Divider", "props": {} },

      "j1":         { "type": "Row",    "props": { "align": "start" },                            "children": ["j1Left", "j1Right"] },
      "j1Left":     { "type": "Row",    "props": { "gap": "sm", "align": "start", "grow": true },  "children": ["j1Av", "j1Body"] },
      "j1Av":       { "type": "Avatar", "props": { "initials": "BT", "size": "md" } },
      "j1Body":     { "type": "Stack",  "props": { "gap": "xs", "grow": true },                    "children": ["j1Name", "j1Customer"] },
      "j1Name":     { "type": "Text",   "props": { "text": "Bunnings Trade Centre — Switchboard",  "size": "sm", "weight": "medium", "truncate": true } },
      "j1Customer": { "type": "Text",   "props": { "text": "Bunnings Group",                      "size": "xs", "tone": "muted",   "truncate": true } },
      "j1Right":    { "type": "Stack",  "props": { "gap": "none", "align": "end" },                "children": ["j1Total", "j1Status"] },
      "j1Total":    { "type": "Text",   "props": { "text": "$54,300",                             "size": "sm", "weight": "semibold" } },
      "j1Status":   { "type": "Text",   "props": { "text": "In Progress",                         "size": "xs", "tone": "muted" } },

      "j2":         { "type": "Row",    "props": { "align": "start" },                            "children": ["j2Left", "j2Right"] },
      "j2Left":     { "type": "Row",    "props": { "gap": "sm", "align": "start", "grow": true },  "children": ["j2Av", "j2Body"] },
      "j2Av":       { "type": "Avatar", "props": { "initials": "LO", "size": "md" } },
