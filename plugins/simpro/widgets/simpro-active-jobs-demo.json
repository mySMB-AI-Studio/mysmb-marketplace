      "j7":         { "type": "Row",    "props": { "align": "start" },                            "children": ["j7Left", "j7Right"] },
      "j7Left":     { "type": "Row",    "props": { "gap": "sm", "align": "start", "grow": true },  "children": ["j7Av", "j7Body"] },
