      "j6Body":     { "type": "Stack",  "props": { "gap": "xs", "grow": true },                    "children": ["j6Name", "j6Customer"] },
      "j6Name":     { "type": "Text",   "props": { "text": "School Gymnasium Lighting",           "size": "sm", "weight": "medium", "truncate": true } },
      "j6Customer": { "type": "Text",   "props": { "text": "Dept of Education",                  "size": "xs", "tone": "muted",   "truncate": true } },
      "j6Right":    { "type": "Stack",  "props": { "gap": "none", "align": "end" },                "children": ["j6Total", "j6Status"] },
      "j6Total":    { "type": "Text",   "props": { "text": "$16,800",                             "size": "sm", "weight": "semibold" } },
