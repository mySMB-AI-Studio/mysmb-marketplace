      "j3Right":    { "type": "Stack",  "props": { "gap": "none", "align": "end" },                "children": ["j3Total", "j3Status"] },
      "j3Total":    { "type": "Text",   "props": { "text": "$41,700",                             "size": "sm", "weight": "semibold" } },
      "j3Status":   { "type": "Text",   "props": { "text": "Pending Inspection",                  "size": "xs", "tone": "muted" } },

      "j4":         { "type": "Row",    "props": { "align": "start" },                            "children": ["j4Left", "j4Right"] },
