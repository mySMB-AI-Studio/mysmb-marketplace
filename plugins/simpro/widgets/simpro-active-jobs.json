{
  "id": "simpro-active-jobs",
  "title": "Active Jobs",
  "description": "Live Simpro jobs — active, pending, and completed — with customer, total, and status.",
  "category": "operations",
  "tags": ["simpro", "jobs", "field-service", "electrical", "trade", "work-orders"],
  "keywords": ["jobs", "active jobs", "work orders", "field service", "simpro", "job management"],
  "connectorsUsed": ["simpro"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 5, "rowSpan": 8 },
    "min":       { "colSpan": 4, "rowSpan": 5 },
    "max":       { "colSpan": 10, "rowSpan": 12 }
  },
  "dataProvider": {
    "mcp": "simpro",
    "tool": "list_jobs",
    "params": { "page": 1 }
  },
  "spec": {
    "root": "card",
    "elements": {

      "card": {
        "type": "Card",
        "props": {},
        "children": ["titleRow", "colHeader", "divider", "loading", "empty", "scrollBody"]
      },

      "titleRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["titleGroup"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "Briefcase", "tone": "accent", "size": "sm" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "eyebrow"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Active Jobs", "level": "h2" }
      },
      "eyebrow": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "Simpro · {n} jobs",
              "n": { "$computed": "count", "args": { "value": { "$state": "/simpro/list_jobs/jobs" } } }
            }
          }
        }
      },

      "colHeader": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["colLeft", "colRight"]
      },
      "colLeft":  { "type": "Caption", "props": { "text": "JOB / CUSTOMER" } },
      "colRight": { "type": "Caption", "props": { "text": "TOTAL / STATUS" } },

      "divider": { "type": "Divider", "props": {} },

      "loading": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["s1", "s2", "s3", "s4"],
        "visible": { "$state": "/_loading/simpro.list_jobs" }
      },
      "s1": { "type": "Skeleton", "props": { "height": "3rem", "rounded": "md" } },
      "s2": { "type": "Skeleton", "props": { "height": "3rem", "rounded": "md" } },
      "s3": { "type": "Skeleton", "props": { "height": "3rem", "rounded": "md" } },
      "s4": { "type": "Skeleton", "props": { "height": "3rem", "rounded": "md" } },

      "empty": {
        "type": "Empty",
        "props": { "message": "No jobs found." },
        "visible": {
          "$and": [
            { "$state": "/_loading/simpro.list_jobs", "not": true },
            { "$state": "/simpro/list_jobs/jobs/0", "not": true }
          ]
        }
      },

      "scrollBody": {
        "type": "Body",
        "props": {},
        "children": ["list"],
        "visible": { "$state": "/_loading/simpro.list_jobs", "not": true }
      },

      "list": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["row"],
        "repeat": {
          "statePath": "/simpro/list_jobs/jobs",
          "key": "ID"
        }
      },

      "row": {
        "type": "Row",
        "props": { "align": "start", "hover": true, "clickable": true },
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "url": {
                "$computed": "simpro_build_record_url",
                "args": {
                  "build_domain": { "$state": "/simpro/list_jobs/buildDomain" },
                  "kind": "job",
                  "id": { "$item": "ID" }
                }
              }
            }
          }
        },
        "children": ["rowLeft", "rowRight"]
      },
      "rowLeft": {
        "type": "Row",
        "props": { "gap": "sm", "align": "start", "grow": true },
        "children": ["rowAvatar", "rowBody"]
      },
      "rowAvatar": {
        "type": "Avatar",
        "props": {
          "initials": {
            "$computed": "initials",
            "args": { "value": { "$item": "CustomerName" } }
          },
          "size": "md"
        }
      },
      "rowBody": {
        "type": "Stack",
        "props": { "gap": "xs", "grow": true },
        "children": ["rowName", "rowCustomer"]
      },
      "rowName": {
        "type": "Text",
        "props": {
          "text": { "$item": "Name" },
          "size": "sm",
          "weight": "medium",
          "truncate": true
        }
      },
      "rowCustomer": {
        "type": "Text",
        "props": {
          "text": { "$item": "CustomerName" },
          "size": "xs",
          "tone": "muted",
          "truncate": true
        }
      },

      "rowRight": {
        "type": "Stack",
        "props": { "gap": "xs", "align": "end" },
        "children": ["rowTotal", "rowStatusBadge"]
      },
      "rowTotal": {
        "type": "Text",
        "props": {
          "text": {
            "$computed": "format_currency",
            "args": { "value": { "$item": "Total" } }
          },
          "size": "sm",
          "weight": "semibold"
        }
      },
      "rowStatusBadge": {
        "type": "Badge",
        "props": {
          "text": { "$item": "Status" },
          "tone": {
            "$computed": "simpro_job_status_tone",
            "args": { "value": { "$item": "Status" } }
          }
        }
      }

    }
  },
  "status": "published"
}
