{
  "id": "simpro-invoice-summary-demo",
  "title": "Invoice Summary (Demo)",
  "description": "Static demo of the SimPro Invoice Summary widget — 8 hardcoded invoices spanning all status types.",
  "category": "finance",
  "tags": ["simpro", "invoices", "finance", "billing", "accounts-receivable", "electrical", "trade", "demo"],
  "keywords": ["invoices", "billing", "finance", "accounts receivable", "paid", "overdue", "simpro", "demo"],
  "connectorsUsed": ["simpro"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 3, "rowSpan": 6 },
    "min":       { "colSpan": 2, "rowSpan": 5 },
    "max":       { "colSpan": 8, "rowSpan": 10 }
  },
  "spec": {
    "root": "card",
    "elements": {

      "card": {
        "type": "Card",
        "props": {},
        "children": ["titleRow", "colHeader", "divider", "scrollBody"]
      },

      "titleRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["titleGroup"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "Receipt", "tone": "accent", "size": "sm" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "eyebrow"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Invoice Summary", "level": "h2" }
      },
      "eyebrow": {
        "type": "Eyebrow",
        "props": { "text": "SimPro" }
      },

      "colHeader": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["colLeft", "colRight"]
      },
      "colLeft":  { "type": "Caption", "props": { "text": "INVOICE / JOB" } },
      "colRight": { "type": "Caption", "props": { "text": "AMOUNT / STATUS" } },

      "divider": { "type": "Divider", "props": {} },

      "scrollBody": {
        "type": "Body",
        "props": {},
        "children": ["rows"]
      },

      "rows": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["i1", "rd1", "i2", "rd2", "i3", "rd3", "i4", "rd4", "i5", "rd5", "i6", "rd6", "i7", "rd7", "i8"]
      },

      "rd1": { "type": "Divider", "props": {} },
      "rd2": { "type": "Divider", "props": {} },
      "rd3": { "type": "Divider", "props": {} },
      "rd4": { "type": "Divider", "props": {} },
      "rd5": { "type": "Divider", "props": {} },
      "rd6": { "type": "Divider", "props": {} },
      "rd7": { "type": "Divider", "props": {} },

      "i1":      { "type": "Row",   "props": { "align": "start" },               "children": ["i1Left", "i1Right"] },
      "i1Left":  { "type": "Stack", "props": { "gap": "xs", "grow": true },       "children": ["i1Id", "i1Job"] },
      "i1Id":    { "type": "Text",  "props": { "text": "INV-2041", "size": "sm", "weight": "medium", "truncate": true } },
      "i1Job":   { "type": "Text",  "props": { "text": "JOB-1834", "size": "xs", "tone": "muted",   "truncate": true } },
