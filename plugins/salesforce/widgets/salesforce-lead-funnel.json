{
  "id": "salesforce-lead-funnel",
  "title": "Lead Funnel",
  "description": "Lead conversion funnel by status, driven by live Salesforce data.",
  "category": "sales",
  "tags": ["salesforce", "crm", "leads", "funnel", "conversion", "pipeline"],
  "keywords": ["lead", "leads", "funnel", "conversion", "pipeline", "stage", "status", "salesforce", "crm"],
  "connectorsUsed": ["salesforce"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 5, "rowSpan": 6 },
    "min":       { "colSpan": 4, "rowSpan": 5 },
    "max":       { "colSpan": 10, "rowSpan": 10 }
  },
  "dataProvider": {
    "mcp": "salesforce",
    "tool": "soql_query",
    "params": {
      "query": "SELECT Status, COUNT(Id) cnt FROM Lead GROUP BY Status ORDER BY COUNT(Id) DESC"
    }
  },
  "spec": {
    "root": "card",
    "elements": {

      "card": {
        "type": "Card",
        "props": {},
        "children": ["titleRow", "divider", "loading", "empty", "scrollBody", "footer"]
      },

      "titleRow": {
        "type": "Row",
        "props": { "align": "center" },
        "children": ["titleGroup"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": { "type": "Icon", "props": { "name": "Filter", "tone": "accent", "size": "sm" } },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "eyebrow"]
      },
      "title":   { "type": "Heading", "props": { "text": "Lead Funnel", "level": "h2" } },
      "eyebrow": { "type": "Eyebrow", "props": { "text": "Salesforce" } },

      "divider": { "type": "Divider", "props": {} },

      "loading": {
        "type": "Stack",
        "props": { "gap": "md" },
        "children": ["s1", "s2", "s3", "s4"],
        "visible": { "$state": "/_loading/salesforce.soql_query" }
      },
      "s1": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "s2": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "s3": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "s4": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },

      "empty": {
        "type": "Empty",
        "props": { "message": "No lead data available." },
        "visible": {
          "$and": [
            { "$state": "/_loading/salesforce.soql_query", "not": true },
            { "$state": "/salesforce/soql_query/records/0", "not": true }
          ]
        }
      },

      "scrollBody": {
        "type": "Body",
        "props": {},
        "children": ["list"],
        "visible": { "$state": "/_loading/salesforce.soql_query", "not": true }
      },

      "list": {
        "type": "Stack",
        "props": { "gap": "md" },
        "children": ["row"],
        "repeat": {
          "statePath": "/salesforce/soql_query/records",
          "key": "Status"
        }
      },

      "row": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["rowHeader", "rowBar"]
      },
      "rowHeader": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["rowStatus", "rowMeta"]
      },
      "rowStatus": {
        "type": "Text",
        "props": {
          "text": { "$item": "Status" },
          "size": "sm",
          "weight": "medium"
        }
      },
      "rowMeta": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["rowCount", "rowPct"]
      },
      "rowCount": {
        "type": "Text",
        "props": {
          "text": { "$item": "cnt" },
          "size": "sm",
          "weight": "semibold"
        }
      },
      "rowPct": {
        "type": "Text",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{p}% of max",
              "p": {
                "$computed": "salesforce_pct_of_max",
                "args": {
                  "value": { "$item": "cnt" },
                  "items": { "$state": "/salesforce/soql_query/records" },
                  "field": "cnt"
                }
              }
            }
          },
          "size": "xs",
          "tone": "muted"
        }
      },
      "rowBar": {
        "type": "ProgressBar",
        "props": {
          "value": {
            "$computed": "salesforce_pct_of_max",
            "args": {
              "value": { "$item": "cnt" },
              "items": { "$state": "/salesforce/soql_query/records" },
              "field": "cnt"
            }
          },
          "max": 100,
          "tone": {
            "$computed": "salesforce_probability_tone",
            "args": {
              "value": {
                "$computed": "salesforce_pct_of_max",
                "args": {
                  "value": { "$item": "cnt" },
                  "items": { "$state": "/salesforce/soql_query/records" },
                  "field": "cnt"
                }
              }
            }
          }
        }
      },

      "footer": {
        "type": "Row",
        "props": { "justify": "center" },
        "children": ["footerText"],
        "visible": {
          "$and": [
            { "$state": "/_loading/salesforce.soql_query", "not": true },
            { "$state": "/salesforce/soql_query/records/0" }
          ]
        }
      },
      "footerText": {
        "type": "Caption",
        "props": {
          "text": "Bars are relative to the largest stage (percent_of_max) · live counts"
        }
      }

    }
  },
  "status": "published"
}
