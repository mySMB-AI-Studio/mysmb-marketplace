{
  "id": "salesforce-events-at-risk",
  "title": "Top 3 Events at Risk",
  "description": "The 3 upcoming Salesforce Campaign events with the lowest registered attendance, ranked worst first. Each row pairs the event with how soon it starts — a dot turns amber inside a month and red inside a fortnight — so a thinly-booked event that is nearly here stands apart from one that still has time to fill. Reads active/planned Campaigns of event types ordered by NumberOfContacts ascending.",
  "category": "crm",
  "tags": ["salesforce", "crm", "events", "campaigns", "attendance", "at-risk"],
  "keywords": ["events", "at risk", "attendance", "campaigns", "low attendance", "engagement", "event management", "registrations"],
  "connectorsUsed": ["salesforce"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 6, "rowSpan": 5 },
    "min": { "colSpan": 5, "rowSpan": 4 },
    "max": { "colSpan": 10, "rowSpan": 8 }
  },
  "dataProvider": {
    "mcp": "salesforce",
    "tool": "soql_query",
    "params": {
      "query": "SELECT Id, Name, NumberOfContacts, StartDate, Type, Status FROM Campaign WHERE Type IN ('Conference', 'Event', 'Seminar', 'Public Speaking', 'Trade Show', 'Webinar') AND Status IN ('Active', 'Planned') AND StartDate >= TODAY ORDER BY NumberOfContacts ASC NULLS FIRST LIMIT 3"
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": ["header", "headerDivider", "body", "footerDivider", "footer"],
        "watch": {
          "/salesforce/soql_query/records": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/ev",
                "value": {
                  "$computed": "salesforce_events_at_risk",
                  "args": { "value": { "$state": "/salesforce/soql_query/records" } }
                }
              }
            }
          ]
        }
      },

      "header": {
        "type": "Header",
        "props": {},
        "children": ["titleGroup"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "start" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "AlertTriangle", "tone": "warning", "size": "sm" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "subtitle"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Top 3 Events at Risk", "level": "h2" }
      },
      "subtitle": {
        "type": "Eyebrow",
        "props": { "text": "Lowest Registered Attendance" }
      },
      "headerDivider": { "type": "Divider", "props": {} },

      "body": {
        "type": "Body",
        "props": {},
        "children": ["loading", "empty", "eventList"]
      },

      "loading": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["sk1", "sk2", "sk3"],
        "visible": { "$state": "/_loading/salesforce.soql_query" }
      },
      "sk1": { "type": "Skeleton", "props": { "height": "4.5rem", "rounded": "lg" } },
      "sk2": { "type": "Skeleton", "props": { "height": "4.5rem", "rounded": "lg" } },
      "sk3": { "type": "Skeleton", "props": { "height": "4.5rem", "rounded": "lg" } },

      "empty": {
        "type": "Empty",
        "props": { "message": "No upcoming events found in Salesforce. This tile reads Campaigns of an event type that are Active or Planned and start today or later." },
        "visible": {
          "$and": [
            { "$state": "/_loading/salesforce.soql_query", "not": true },
            { "$state": "/ui/ev/count", "not": true }
          ]
        }
      },

      "eventList": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["eventCard"],
        "repeat": { "statePath": "/ui/ev/rows", "key": "id" },
        "visible": {
          "$and": [
            { "$state": "/_loading/salesforce.soql_query", "not": true },
            { "$state": "/ui/ev/count" }
          ]
        }
      },
      "eventCard": {
        "type": "Section",
        "props": { "variant": "muted" },
        "children": ["eventRow"]
      },
      "eventRow": {
        "type": "Row",
        "props": { "template": "auto minmax(0, 1fr) auto", "gap": "md", "align": "center" },
        "children": ["rankBadge", "eventMain", "attendeeCell"]
      },
      "rankBadge": {
        "type": "Badge",
        "props": {
          "text": { "$item": "rank" },
          "tone": { "$item": "rankTone" },
          "variant": "soft"
        }
      },
      "eventMain": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["eventName", "eventMetaRow"]
      },
      "eventName": {
        "type": "Text",
        "props": { "text": { "$item": "name" }, "size": "sm", "weight": "medium", "truncate": true }
      },
      "eventMetaRow": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["eventTypeBadge", "eventDot", "eventMeta"]
      },
      "eventTypeBadge": {
        "type": "Badge",
        "props": { "text": { "$item": "type" }, "variant": "outline" }
      },
      "eventDot": {
        "type": "Dot",
        "props": { "tone": { "$item": "dotTone" }, "size": "sm" }
      },
      "eventMeta": {
        "type": "Caption",
        "props": { "text": { "$item": "meta" }, "tone": "muted" }
      },
      "attendeeCell": {
        "type": "Stack",
        "props": { "gap": "none", "align": "end" },
        "children": ["attendeeCount", "attendeeLabel"]
      },
      "attendeeCount": {
        "type": "Stat",
        "props": { "value": { "$item": "attendees" }, "size": "sm" }
      },
      "attendeeLabel": {
        "type": "Caption",
        "props": { "text": "registered", "tone": "muted" }
      },

      "footerDivider": {
        "type": "Divider",
        "props": {},
        "visible": {
          "$and": [
            { "$state": "/_loading/salesforce.soql_query", "not": true },
            { "$state": "/ui/ev/count" }
          ]
        }
      },
      "footer": {
        "type": "Caption",
        "props": { "text": "Upcoming events with the fewest registrations. Starts today or later.", "tone": "muted" },
        "visible": {
          "$and": [
            { "$state": "/_loading/salesforce.soql_query", "not": true },
            { "$state": "/ui/ev/count" }
          ]
        }
      }
    }
  },
  "status": "published"
}
