{
  "id": "salesforce-membership-by-category",
  "title": "Membership by Category",
  "description": "Total membership with a breakdown by membership type/category (e.g. Full/Accredited, Student, Associate, Retired/Honorary), computed from Salesforce Contacts using the `Membership_Type__c` custom field. A headline total sits above a two-column grid of category cards, each showing its count, its share of the total and a bar scaled against the largest category. Assumes the connected org has a `Membership_Type__c` field on the Contact object — if the field doesn't exist the SOQL query will error; if it exists but is unpopulated, the tile shows an empty state. Categories are colour-coded by rank (highest count first), not by matching specific category names, since membership-type labels vary across orgs. Best suited for association-management customers who track member type on the Contact record.",
  "category": "crm",
  "tags": ["salesforce", "membership", "contacts", "category", "association"],
  "keywords": ["members by category", "membership breakdown", "membership type", "membership tier", "association", "statistics"],
  "connectorsUsed": ["salesforce"],
  "popularity": 35,
  "sizing": {
    "preferred": { "colSpan": 4, "rowSpan": 4 },
    "min": { "colSpan": 4, "rowSpan": 4 },
    "max": { "colSpan": 8, "rowSpan": 10 }
  },
  "dataProvider": {
    "mcp": "salesforce",
    "tool": "soql_query",
    "params": {
      "query": "SELECT Membership_Type__c, COUNT(Id) cnt FROM Contact WHERE Membership_Type__c != null GROUP BY Membership_Type__c ORDER BY COUNT(Id) DESC"
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": ["header", "body", "footerDivider", "footer"],
        "watch": {
          "/salesforce/soql_query/records": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/mc",
                "value": {
                  "$computed": "salesforce_category_breakdown",
                  "args": { "value": { "$state": "/salesforce/soql_query/records" } }
                }
              }
            }
          ]
        }
      },

      "header": {
        "type": "Header",
        "props": {},
        "children": ["titleGroup"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "start" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "PieChart", "tone": "accent", "size": "sm" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "subtitle"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Membership by Category", "level": "h2" }
      },
      "subtitle": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{total} Active Members Across {n} Categories",
              "total": { "$state": "/ui/mc/total" },
              "n": { "$state": "/ui/mc/categoryCount" }
            }
          }
        }
      },

      "body": {
        "type": "Body",
        "props": {},
        "children": ["loading", "empty", "hero", "categoryGrid"]
      },

      "loading": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["skHero", "skGrid"],
        "visible": { "$state": "/_loading/salesforce.soql_query" }
      },
      "skHero": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "skGrid": { "type": "Skeleton", "props": { "height": "9rem", "rounded": "md" } },

      "empty": {
        "type": "Empty",
        "props": {
          "message": "No membership data found. Make sure a `Membership_Type__c` custom field exists on the Contact object in this Salesforce org and that Contacts have the field populated."
        },
        "visible": {
          "$and": [
            { "$state": "/_loading/salesforce.soql_query", "not": true },
            { "$state": "/ui/mc/total", "not": true }
          ]
        }
      },

      "hero": {
        "type": "Row",
        "props": { "gap": "sm", "align": "baseline" },
        "children": ["heroValue", "heroCaption"],
        "visible": {
          "$and": [
            { "$state": "/_loading/salesforce.soql_query", "not": true },
            { "$state": "/ui/mc/total" }
          ]
        }
      },
      "heroValue": {
        "type": "Stat",
        "props": { "value": { "$state": "/ui/mc/total" }, "size": "lg" }
      },
      "heroCaption": {
        "type": "Caption",
        "props": { "text": "Active Members", "tone": "muted" }
      },

      "categoryGrid": {
        "type": "Grid",
        "props": { "cols": 2, "gap": "sm" },
        "children": ["categoryCell"],
        "repeat": { "statePath": "/ui/mc/rows", "key": "id" },
        "visible": {
          "$and": [
            { "$state": "/_loading/salesforce.soql_query", "not": true },
            { "$state": "/ui/mc/total" }
          ]
        }
      },
      "categoryCell": {
        "type": "Section",
        "props": { "variant": "muted" },
        "children": ["categoryLabelRow", "categoryFigures", "categoryBarRow"]
      },
      "categoryLabelRow": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["categoryDot", "categoryLabel"]
      },
      "categoryDot": {
        "type": "Dot",
        "props": { "tone": { "$item": "tone" }, "size": "sm" }
      },
      "categoryLabel": {
        "type": "Text",
        "props": { "text": { "$item": "value" }, "size": "sm", "weight": "medium", "truncate": true }
      },
      "categoryFigures": {
        "type": "Row",
        "props": { "gap": "xs", "align": "baseline" },
        "children": ["categoryCount", "categoryPct"]
      },
      "categoryCount": {
        "type": "Stat",
        "props": { "value": { "$item": "count" }, "size": "sm" }
      },
      "categoryPct": {
        "type": "Caption",
        "props": { "text": { "$item": "pct" }, "tone": "muted" }
      },
      "categoryBarRow": {
        "type": "Row",
        "props": {},
        "children": ["categoryBar"]
      },
      "categoryBar": {
        "type": "ProgressBar",
        "props": { "value": { "$item": "bar" }, "tone": { "$item": "tone" } }
      },

      "footerDivider": {
        "type": "Divider",
        "props": {},
        "visible": {
          "$and": [
            { "$state": "/_loading/salesforce.soql_query", "not": true },
            { "$state": "/ui/mc/total" }
          ]
        }
      },
      "footer": {
        "type": "Caption",
        "props": { "text": "Synced from Salesforce", "tone": "muted" },
        "visible": {
          "$and": [
            { "$state": "/_loading/salesforce.soql_query", "not": true },
            { "$state": "/ui/mc/total" }
          ]
        }
      }
    }
  },
  "status": "published"
}
