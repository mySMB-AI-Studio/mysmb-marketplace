{
  "id": "salesforce-sales-overview-demo",
  "title": "Sales Overview (Demo)",
  "description": "STATIC DEMO — quarterly sales KPIs with sparkline trends. Hardcoded sample data, no connector required. Switch to a live version once Salesforce OAuth is configured.",
  "category": "sales",
  "tags": ["salesforce", "crm", "sales", "kpi", "overview", "pipeline", "demo"],
  "keywords": ["sales overview", "kpi", "opportunities", "pipeline", "closed won", "win rate", "salesforce", "crm", "demo"],
  "connectorsUsed": ["salesforce"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 8, "rowSpan": 4 },
    "min":       { "colSpan": 6, "rowSpan": 3 },
    "max":       { "colSpan": 12, "rowSpan": 6 }
  },
  "spec": {
    "root": "card",
    "elements": {

      "card": {
        "type": "Card",
        "props": {},
        "children": ["titleRow", "kpiGrid"]
      },

      "titleRow": {
        "type": "Row",
        "props": { "align": "center" },
        "children": ["leftGroup"]
      },
      "leftGroup": {
        "type": "Row",
        "props": { "gap": "md", "align": "center" },
        "children": ["titleGroup", "quarterBadge"]
      },
      "quarterBadge": { "type": "Badge", "props": { "text": "This Quarter ▾", "tone": "default" } },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": { "type": "Icon", "props": { "name": "TrendingUp", "tone": "accent", "size": "sm" } },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "eyebrow"]
      },
      "title":   { "type": "Heading", "props": { "text": "Sales Overview", "level": "h2" } },
      "eyebrow": { "type": "Eyebrow", "props": { "text": "Salesforce" } },
      "kpiGrid": {
        "type": "Grid",
        "props": { "cols": 4, "gap": "sm" },
        "children": ["box1", "box2", "box3", "box4"]
      },

      "box1": { "type": "Section", "props": { "variant": "muted" }, "children": ["cell1"] },
      "cell1": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["lbl1", "val1", "delta1", "spark1"]
      },
      "lbl1":   { "type": "Text",      "props": { "text": "Opportunities",          "size": "xs", "tone": "muted" } },
      "val1":   { "type": "Heading",   "props": { "text": "128",                    "level": "h1" } },
      "delta1": { "type": "Text",      "props": { "text": "↑ 12% vs Last Quarter",  "size": "xs", "tone": "success" } },
      "spark1": { "type": "Sparkline", "props": { "values": [82, 88, 79, 95, 101, 108, 112, 119, 128], "tone": "accent", "height": 40 } },

      "box2": { "type": "Section", "props": { "variant": "muted" }, "children": ["cell2"] },
      "cell2": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["lbl2", "val2", "delta2", "spark2"]
      },
      "lbl2":   { "type": "Text",      "props": { "text": "Pipeline Value",         "size": "xs", "tone": "muted" } },
      "val2":   { "type": "Heading",   "props": { "text": "$2.45M",                 "level": "h1" } },
      "delta2": { "type": "Text",      "props": { "text": "↑ 18% vs Last Quarter",  "size": "xs", "tone": "success" } },
      "spark2": { "type": "Sparkline", "props": { "values": [140, 150, 160, 180, 190, 200, 210, 230, 245], "tone": "accent", "height": 40 } },

      "box3": { "type": "Section", "props": { "variant": "muted" }, "children": ["cell3"] },
      "cell3": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["lbl3", "val3", "delta3", "spark3"]
      },
      "lbl3":   { "type": "Text",      "props": { "text": "Closed Won",             "size": "xs", "tone": "muted" } },
      "val3":   { "type": "Heading",   "props": { "text": "$980K",                  "level": "h1" } },
      "delta3": { "type": "Text",      "props": { "text": "↑ 15% vs Last Quarter",  "size": "xs", "tone": "success" } },
      "spark3": { "type": "Sparkline", "props": { "values": [520, 580, 610, 640, 700, 750, 810, 870, 980], "tone": "accent", "height": 40 } },

      "box4": { "type": "Section", "props": { "variant": "muted" }, "children": ["cell4"] },
      "cell4": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["lbl4", "val4", "delta4", "spark4"]
      },
      "lbl4":   { "type": "Text",      "props": { "text": "Win Rate",               "size": "xs", "tone": "muted" } },
      "val4":   { "type": "Heading",   "props": { "text": "32%",                    "level": "h1" } },
      "delta4": { "type": "Text",      "props": { "text": "↑ 5% vs Last Quarter",   "size": "xs", "tone": "success" } },
      "spark4": { "type": "Sparkline", "props": { "values": [22, 24, 25, 26, 27, 28, 29, 30, 32], "tone": "accent", "height": 40 } }

    }
  },
  "status": "draft"
}
