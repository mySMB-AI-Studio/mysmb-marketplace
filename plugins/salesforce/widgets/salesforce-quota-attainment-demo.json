      "rep3Av":     { "type": "Avatar",      "props": { "initials": "PK", "size": "md" } },
      "rep3Body":   { "type": "Stack",       "props": { "gap": "xs", "grow": true },                    "children": ["rep3Name", "rep3Quota", "rep3BarRow"] },
      "rep3Name":   { "type": "Text",        "props": { "text": "Priya Kumar",              "size": "sm", "weight": "medium", "truncate": true } },
      "rep3Quota":  { "type": "Text",        "props": { "text": "$540K closed · $700K quota", "size": "xs", "tone": "muted",   "truncate": true } },
      "rep3BarRow": { "type": "Row",         "props": { "gap": "xs", "align": "center" },               "children": ["rep3Bar", "rep3BarVal"] },
      "rep3Bar":    { "type": "ProgressBar", "props": { "value": 77, "max": 100, "tone": "warning" } },
      "rep3BarVal": { "type": "Caption",     "props": { "text": "77%" } },
      "rep3Right":  { "type": "Stack",       "props": { "gap": "none", "align": "end" },                "children": ["rep3Badge"] },
      "rep3Badge":  { "type": "Badge",       "props": { "text": "77%", "tone": "warning" } },

      "rep4":       { "type": "Row",         "props": { "align": "start" },                             "children": ["rep4Left", "rep4Right"] },
      "rep4Left":   { "type": "Row",         "props": { "gap": "sm", "align": "start", "grow": true },  "children": ["rep4Av", "rep4Body"] },
      "rep4Av":     { "type": "Avatar",      "props": { "initials": "JL", "size": "md" } },
      "rep4Body":   { "type": "Stack",       "props": { "gap": "xs", "grow": true },                    "children": ["rep4Name", "rep4Quota", "rep4BarRow"] },
      "rep4Name":   { "type": "Text",        "props": { "text": "James Lee",               "size": "sm", "weight": "medium", "truncate": true } },
      "rep4Quota":  { "type": "Text",        "props": { "text": "$410K closed · $700K quota", "size": "xs", "tone": "muted",   "truncate": true } },
      "rep4BarRow": { "type": "Row",         "props": { "gap": "xs", "align": "center" },               "children": ["rep4Bar", "rep4BarVal"] },
      "rep4Bar":    { "type": "ProgressBar", "props": { "value": 59, "max": 100, "tone": "warning" } },
      "rep4BarVal": { "type": "Caption",     "props": { "text": "59%" } },
      "rep4Right":  { "type": "Stack",       "props": { "gap": "none", "align": "end" },                "children": ["rep4Badge"] },
      "rep4Badge":  { "type": "Badge",       "props": { "text": "59%", "tone": "warning" } },

      "rep5":       { "type": "Row",         "props": { "align": "start" },                             "children": ["rep5Left", "rep5Right"] },
      "rep5Left":   { "type": "Row",         "props": { "gap": "sm", "align": "start", "grow": true },  "children": ["rep5Av", "rep5Body"] },
      "rep5Av":     { "type": "Avatar",      "props": { "initials": "AO", "size": "md" } },
      "rep5Body":   { "type": "Stack",       "props": { "gap": "xs", "grow": true },                    "children": ["rep5Name", "rep5Quota", "rep5BarRow"] },
      "rep5Name":   { "type": "Text",        "props": { "text": "Ana Ortega",              "size": "sm", "weight": "medium", "truncate": true } },
      "rep5Quota":  { "type": "Text",        "props": { "text": "$280K closed · $700K quota", "size": "xs", "tone": "muted",   "truncate": true } },
      "rep5BarRow": { "type": "Row",         "props": { "gap": "xs", "align": "center" },               "children": ["rep5Bar", "rep5BarVal"] },
      "rep5Bar":    { "type": "ProgressBar", "props": { "value": 40, "max": 100, "tone": "destructive" } },
      "rep5BarVal": { "type": "Caption",     "props": { "text": "40%" } },
      "rep5Right":  { "type": "Stack",       "props": { "gap": "none", "align": "end" },                "children": ["rep5Badge"] },
      "rep5Badge":  { "type": "Badge",       "props": { "text": "40%", "tone": "destructive" } }

    }
  },
  "status": "draft"
}
