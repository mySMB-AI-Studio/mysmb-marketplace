{
  "id": "salesforce-opportunities-demo",
  "title": "Recent Opportunities (Demo)",
  "description": "STATIC DEMO — hardcoded sample data, no connector required. Switch to salesforce-open-opportunities once Salesforce OAuth is configured.",
  "category": "sales",
  "tags": ["salesforce", "crm", "opportunities", "pipeline", "sales", "demo"],
  "keywords": ["opportunity", "opportunities", "deal", "deals", "pipeline", "stage", "probability", "salesforce", "crm", "demo"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 5, "rowSpan": 7 },
    "min":       { "colSpan": 4, "rowSpan": 5 },
    "max":       { "colSpan": 10, "rowSpan": 12 }
  },
  "spec": {
    "root": "card",
    "elements": {

      "card": {
        "type": "Card",
        "props": {},
        "children": ["titleRow", "colHeader", "divider", "rows"]
      },

      "titleRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["titleGroup", "sfLogo"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": { "type": "Icon", "props": { "name": "BarChart2", "tone": "accent", "size": "sm" } },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "eyebrow"]
      },
      "title":   { "type": "Heading", "props": { "text": "Recent Opportunities", "level": "h2" } },
      "eyebrow": { "type": "Eyebrow", "props": { "text": "Salesforce" } },
      "sfLogo":  { "type": "Icon", "props": { "name": "Cloud", "tone": "accent", "size": "md" } },

      "colHeader": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["colOpp", "colAmt"]
      },
      "colOpp": { "type": "Caption", "props": { "text": "OPPORTUNITY" } },
      "colAmt": { "type": "Caption", "props": { "text": "AMOUNT / STAGE" } },

      "divider": { "type": "Divider", "props": {} },

      "rows": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["opp1", "opp2", "opp3", "opp4"]
      },

      "opp1": { "type": "Stack", "props": { "gap": "xs" }, "children": ["opp1Top", "opp1Bar"] },
      "opp1Top": { "type": "Row", "props": { "justify": "between", "align": "center" }, "children": ["opp1Left", "opp1Right"] },
      "opp1Left": { "type": "Row", "props": { "gap": "sm", "align": "center" }, "children": ["opp1Av", "opp1Info"] },
      "opp1Av":   { "type": "Avatar", "props": { "initials": "AC", "tone": "warning", "size": "sm" } },
      "opp1Info": { "type": "Stack", "props": { "gap": "none" }, "children": ["opp1Name", "opp1Acct"] },
      "opp1Name": { "type": "Text", "props": { "text": "Acme Corp - New Deal", "size": "sm", "weight": "medium", "truncate": true } },
      "opp1Acct": { "type": "Text", "props": { "text": "Acme Corporation", "size": "xs", "tone": "muted", "truncate": true } },
      "opp1Right": { "type": "Stack", "props": { "gap": "none", "align": "end" }, "children": ["opp1Amt", "opp1Meta"] },
      "opp1Amt":  { "type": "Text", "props": { "text": "$750,000", "size": "sm", "weight": "semibold" } },
      "opp1Meta": { "type": "Text", "props": { "text": "Negotiation · 75%", "size": "xs", "tone": "muted" } },
      "opp1Bar":  { "type": "ProgressBar", "props": { "value": 75, "tone": "positive" } },

      "opp2": { "type": "Stack", "props": { "gap": "xs" }, "children": ["opp2Top", "opp2Bar"] },
      "opp2Top": { "type": "Row", "props": { "justify": "between", "align": "center" }, "children": ["opp2Left", "opp2Right"] },
      "opp2Left": { "type": "Row", "props": { "gap": "sm", "align": "center" }, "children": ["opp2Av", "opp2Info"] },
      "opp2Av":   { "type": "Avatar", "props": { "initials": "GM", "tone": "accent", "size": "sm" } },
      "opp2Info": { "type": "Stack", "props": { "gap": "none" }, "children": ["opp2Name", "opp2Acct"] },
      "opp2Name": { "type": "Text", "props": { "text": "Global Media - Upgrade", "size": "sm", "weight": "medium", "truncate": true } },
      "opp2Acct": { "type": "Text", "props": { "text": "Global Media", "size": "xs", "tone": "muted", "truncate": true } },
      "opp2Right": { "type": "Stack", "props": { "gap": "none", "align": "end" }, "children": ["opp2Amt", "opp2Meta"] },
      "opp2Amt":  { "type": "Text", "props": { "text": "$450,000", "size": "sm", "weight": "semibold" } },
      "opp2Meta": { "type": "Text", "props": { "text": "Proposal · 50%", "size": "xs", "tone": "muted" } },
      "opp2Bar":  { "type": "ProgressBar", "props": { "value": 50, "tone": "accent" } },

      "opp3": { "type": "Stack", "props": { "gap": "xs" }, "children": ["opp3Top", "opp3Bar"] },
      "opp3Top": { "type": "Row", "props": { "justify": "between", "align": "center" }, "children": ["opp3Left", "opp3Right"] },
      "opp3Left": { "type": "Row", "props": { "gap": "sm", "align": "center" }, "children": ["opp3Av", "opp3Info"] },
      "opp3Av":   { "type": "Avatar", "props": { "initials": "GI", "tone": "info", "size": "sm" } },
      "opp3Info": { "type": "Stack", "props": { "gap": "none" }, "children": ["opp3Name", "opp3Acct"] },
      "opp3Name": { "type": "Text", "props": { "text": "Greenfield Inc. - Renewal", "size": "sm", "weight": "medium", "truncate": true } },
      "opp3Acct": { "type": "Text", "props": { "text": "Greenfield Inc.", "size": "xs", "tone": "muted", "truncate": true } },
      "opp3Right": { "type": "Stack", "props": { "gap": "none", "align": "end" }, "children": ["opp3Amt", "opp3Meta"] },
      "opp3Amt":  { "type": "Text", "props": { "text": "$200,000", "size": "sm", "weight": "semibold" } },
      "opp3Meta": { "type": "Text", "props": { "text": "Qualification · 25%", "size": "xs", "tone": "muted" } },
      "opp3Bar":  { "type": "ProgressBar", "props": { "value": 25, "tone": "warning" } },

      "opp4": { "type": "Stack", "props": { "gap": "xs" }, "children": ["opp4Top", "opp4Bar"] },
      "opp4Top": { "type": "Row", "props": { "justify": "between", "align": "center" }, "children": ["opp4Left", "opp4Right"] },
      "opp4Left": { "type": "Row", "props": { "gap": "sm", "align": "center" }, "children": ["opp4Av", "opp4Info"] },
      "opp4Av":   { "type": "Avatar", "props": { "initials": "SI", "tone": "positive", "size": "sm" } },
      "opp4Info": { "type": "Stack", "props": { "gap": "none" }, "children": ["opp4Name", "opp4Acct"] },
      "opp4Name": { "type": "Text", "props": { "text": "StartUp.io - New Business", "size": "sm", "weight": "medium", "truncate": true } },
      "opp4Acct": { "type": "Text", "props": { "text": "StartUp.io", "size": "xs", "tone": "muted", "truncate": true } },
      "opp4Right": { "type": "Stack", "props": { "gap": "none", "align": "end" }, "children": ["opp4Amt", "opp4Meta"] },
      "opp4Amt":  { "type": "Text", "props": { "text": "$150,000", "size": "sm", "weight": "semibold" } },
      "opp4Meta": { "type": "Text", "props": { "text": "Discovery · 10%", "size": "xs", "tone": "muted" } },
      "opp4Bar":  { "type": "ProgressBar", "props": { "value": 10, "tone": "destructive" } }

    }
  },
  "status": "draft"
}
