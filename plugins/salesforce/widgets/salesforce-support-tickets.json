{
  "id": "salesforce-support-tickets",
  "title": "Support Tickets",
  "description": "Open Salesforce Cases with a priority breakdown across the top — Open, High, Medium and Low — then the queue itself, highest priority first. Each row shows the subject, a status pill and a colour-coded priority badge; click a row to reveal the case number and created date. Uses the standard Case object, no custom setup required.",
  "category": "support",
  "tags": ["salesforce", "crm", "cases", "support", "helpdesk", "tickets"],
  "keywords": ["tickets", "support", "cases", "helpdesk", "open tickets", "priority", "queue"],
  "connectorsUsed": ["salesforce"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 5, "rowSpan": 6 },
    "min": { "colSpan": 4, "rowSpan": 5 },
    "max": { "colSpan": 12, "rowSpan": 10 }
  },
  "dataProvider": {
    "mcp": "salesforce",
    "tool": "soql_query",
    "params": {
      "query": "SELECT Id, CaseNumber, Subject, Status, Priority, CreatedDate FROM Case WHERE IsClosed = false ORDER BY CreatedDate DESC LIMIT 20"
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": ["header", "body", "footerDivider", "footer"],
        "watch": {
          "/salesforce/soql_query/records": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/caseRows",
                "value": {
                  "$computed": "sort_by_priority",
                  "args": {
                    "value": { "$state": "/salesforce/soql_query/records" },
                    "by": [
                      { "field": "Priority", "order": ["High", "Medium", "Low"] },
                      { "field": "CreatedDate", "direction": "desc" }
                    ]
                  }
                }
              }
            }
          ]
        }
      },

      "header": {
        "type": "Header",
        "props": {},
        "children": ["titleGroup"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "start" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "LifeBuoy", "tone": "warning", "size": "sm" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "subtitle"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Support Tickets", "level": "h2" }
      },
      "subtitle": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{n} Open Cases",
              "n": {
                "$computed": "count",
                "args": { "value": { "$state": "/salesforce/soql_query/records" } }
              }
            }
          }
        }
      },

      "body": {
        "type": "Body",
        "props": {},
        "children": ["loading", "empty", "statGrid", "statDivider", "ticketList"]
      },

      "loading": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["skStats", "sk1", "sk2", "sk3", "sk4"],
        "visible": { "$state": "/_loading/salesforce.soql_query" }
      },
      "skStats": { "type": "Skeleton", "props": { "height": "3.5rem", "rounded": "md" } },
      "sk1": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "sk2": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "sk3": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "sk4": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },

      "empty": {
        "type": "Empty",
        "props": { "message": "No open cases found in Salesforce." },
        "visible": {
          "$and": [
            { "$state": "/_loading/salesforce.soql_query", "not": true },
            { "$state": "/salesforce/soql_query/records/0", "not": true }
          ]
        }
      },

      "statGrid": {
        "type": "Grid",
        "props": { "cols": 4, "gap": "sm" },
        "children": ["statOpen", "statHigh", "statMedium", "statLow"],
        "visible": {
          "$and": [
            { "$state": "/_loading/salesforce.soql_query", "not": true },
            { "$state": "/salesforce/soql_query/records/0" }
          ]
        }
      },

      "statOpen": {
        "type": "Section",
        "props": { "variant": "muted" },
        "children": ["statOpenLabel", "statOpenValue"]
      },
      "statOpenLabel": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["statOpenDot", "statOpenText"]
      },
      "statOpenDot": { "type": "Dot", "props": { "tone": "accent", "size": "sm" } },
      "statOpenText": { "type": "Eyebrow", "props": { "text": "Open" } },
      "statOpenValue": {
        "type": "Stat",
        "props": {
          "size": "sm",
          "value": {
            "$computed": "count",
            "args": { "value": { "$state": "/salesforce/soql_query/records" } }
          }
        }
      },

      "statHigh": {
        "type": "Section",
        "props": { "variant": "muted" },
        "children": ["statHighLabel", "statHighValue"]
      },
      "statHighLabel": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["statHighDot", "statHighText"]
      },
      "statHighDot": { "type": "Dot", "props": { "tone": "destructive", "size": "sm" } },
      "statHighText": { "type": "Eyebrow", "props": { "text": "High" } },
      "statHighValue": {
        "type": "Stat",
        "props": {
          "size": "sm",
          "value": {
            "$computed": "count_where",
            "args": {
              "value": { "$state": "/salesforce/soql_query/records" },
              "whereField": "Priority",
              "equals": "High"
            }
          }
        }
      },

      "statMedium": {
        "type": "Section",
        "props": { "variant": "muted" },
        "children": ["statMediumLabel", "statMediumValue"]
      },
      "statMediumLabel": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["statMediumDot", "statMediumText"]
      },
      "statMediumDot": { "type": "Dot", "props": { "tone": "warning", "size": "sm" } },
      "statMediumText": { "type": "Eyebrow", "props": { "text": "Medium" } },
      "statMediumValue": {
        "type": "Stat",
        "props": {
          "size": "sm",
          "value": {
            "$computed": "count_where",
            "args": {
              "value": { "$state": "/salesforce/soql_query/records" },
              "whereField": "Priority",
              "equals": "Medium"
            }
          }
        }
      },

      "statLow": {
        "type": "Section",
        "props": { "variant": "muted" },
        "children": ["statLowLabel", "statLowValue"]
      },
      "statLowLabel": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["statLowDot", "statLowText"]
      },
      "statLowDot": { "type": "Dot", "props": { "tone": "success", "size": "sm" } },
      "statLowText": { "type": "Eyebrow", "props": { "text": "Low" } },
      "statLowValue": {
        "type": "Stat",
        "props": {
          "size": "sm",
          "value": {
            "$computed": "count_where",
            "args": {
              "value": { "$state": "/salesforce/soql_query/records" },
              "whereField": "Priority",
              "equals": "Low"
            }
          }
        }
      },

      "statDivider": {
        "type": "Divider",
        "props": {},
        "visible": {
          "$and": [
            { "$state": "/_loading/salesforce.soql_query", "not": true },
            { "$state": "/salesforce/soql_query/records/0" }
          ]
        }
      },

      "ticketList": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["ticketRow"],
        "repeat": {
          "statePath": "/ui/caseRows",
          "key": "Id"
        },
        "visible": {
          "$and": [
            { "$state": "/_loading/salesforce.soql_query", "not": true },
            { "$state": "/ui/caseRows/0" }
          ]
        }
      },
      "ticketRow": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["ticketTopRow", "ticketDetail"]
      },
      "ticketTopRow": {
        "type": "Row",
        "props": { "gap": "sm", "align": "start", "justify": "between", "hover": true, "clickable": true },
        "children": ["ticketDot", "ticketLeft", "priorityBadge"],
        "on": {
          "click": {
            "action": "setState",
            "params": {
              "statePath": "/ui/selectedCaseId",
              "value": {
                "$cond": { "$item": "Id", "eq": { "$state": "/ui/selectedCaseId" } },
                "$then": "",
                "$else": { "$item": "Id" }
              }
            }
          }
        }
      },
      "ticketDot": {
        "type": "Dot",
        "props": {
          "size": "sm",
          "tone": {
            "$computed": "salesforce_case_priority_tone",
            "args": { "value": { "$item": "Priority" } }
          }
        }
      },
      "ticketLeft": {
        "type": "Stack",
        "props": { "gap": "xs", "grow": true },
        "children": ["ticketSubject", "ticketStatusRow"]
      },
      "ticketSubject": {
        "type": "Text",
        "props": {
          "text": {
            "$computed": "salesforce_case_subject",
            "args": { "value": { "$item": "Subject" } }
          },
          "size": "sm",
          "weight": "medium",
          "truncate": true
        }
      },
      "ticketStatusRow": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center", "justify": "start" },
        "children": ["ticketStatusBadge"]
      },
      "ticketStatusBadge": {
        "type": "Badge",
        "props": {
          "text": { "$item": "Status" },
          "tone": "info",
          "variant": "soft"
        }
      },
      "priorityBadge": {
        "type": "Badge",
        "props": {
          "text": { "$item": "Priority" },
          "tone": {
            "$computed": "salesforce_case_priority_tone",
            "args": { "value": { "$item": "Priority" } }
          },
          "variant": "soft"
        }
      },
      "ticketDetail": {
        "type": "Section",
        "props": { "variant": "muted", "inset": true },
        "visible": { "$item": "Id", "eq": { "$state": "/ui/selectedCaseId" } },
        "children": ["ticketDetailId", "ticketDetailCreated"]
      },
      "ticketDetailId": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": { "pattern": "Case #: {num}", "num": { "$item": "CaseNumber" } }
          }
        }
      },
      "ticketDetailCreated": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "Created: {date}",
              "date": { "$computed": "salesforce_format_date", "args": { "value": { "$item": "CreatedDate" } } }
            }
          }
        }
      },

      "footerDivider": {
        "type": "Divider",
        "props": {},
        "visible": {
          "$and": [
            { "$state": "/_loading/salesforce.soql_query", "not": true },
            { "$state": "/ui/caseRows/0" }
          ]
        }
      },
      "footer": {
        "type": "Caption",
        "props": { "text": "Open cases, highest priority first.", "tone": "muted" },
        "visible": {
          "$and": [
            { "$state": "/_loading/salesforce.soql_query", "not": true },
            { "$state": "/ui/caseRows/0" }
          ]
        }
      }
    }
  },
  "status": "published"
}
