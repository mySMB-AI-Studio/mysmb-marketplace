{
  "id": "salesforce-deals-pipeline",
  "title": "Deals Pipeline",
  "description": "Open Salesforce Opportunities in a table layout — deal name, stage (colour-coded badge), close date, and amount. Excludes closed-won/closed-lost deals. Uses the standard Opportunity object, no custom setup required.",
  "category": "crm",
  "tags": ["salesforce", "crm", "opportunities", "pipeline", "sales"],
  "keywords": ["deals", "pipeline", "stage", "forecast", "revenue", "opportunities"],
  "connectorsUsed": ["salesforce"],
  "popularity": 72,
  "sizing": {
    "preferred": { "colSpan": 5, "rowSpan": 3 },
    "min": { "colSpan": 3, "rowSpan": 3 },
    "max": { "colSpan": 10, "rowSpan": 10 }
  },
  "dataProvider": {
    "mcp": "salesforce",
    "tool": "soql_query",
    "params": {
      "query": "SELECT Id, Name, StageName, Amount, CloseDate FROM Opportunity WHERE IsClosed = false ORDER BY CloseDate ASC LIMIT 50"
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": ["header", "body"]
      },
      "header": {
        "type": "Header",
        "props": {},
        "children": ["titleGroup"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "start" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "TrendingUp", "tone": "accent", "size": "sm" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "subtitle"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Deals Pipeline", "level": "h2" }
      },
      "subtitle": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{n} open deals",
              "n": {
                "$computed": "count",
                "args": { "value": { "$state": "/salesforce/soql_query/records" } }
              }
            }
          }
        }
      },
      "body": {
        "type": "Body",
        "props": {},
        "children": ["loading", "empty", "tableHeaderRow", "dealList"]
      },
      "loading": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["sk1", "sk2", "sk3", "sk4", "sk5"],
        "visible": { "$state": "/_loading/salesforce.soql_query" }
      },
      "sk1": { "type": "Skeleton", "props": { "height": "2rem", "rounded": "md" } },
      "sk2": { "type": "Skeleton", "props": { "height": "2rem", "rounded": "md" } },
      "sk3": { "type": "Skeleton", "props": { "height": "2rem", "rounded": "md" } },
      "sk4": { "type": "Skeleton", "props": { "height": "2rem", "rounded": "md" } },
      "sk5": { "type": "Skeleton", "props": { "height": "2rem", "rounded": "md" } },
      "empty": {
        "type": "Empty",
        "props": { "message": "No open opportunities found in Salesforce." },
        "visible": {
          "$and": [
            { "$state": "/_loading/salesforce.soql_query", "not": true },
            { "$state": "/salesforce/soql_query/records/0", "not": true }
          ]
        }
      },
      "tableHeaderRow": {
        "type": "Row",
        "props": { "template": "minmax(0, 1fr) 150px 85px 85px", "gap": "sm" },
        "children": ["headerDeal", "headerStage", "headerCloseDate", "headerAmount"],
        "visible": {
          "$and": [
            { "$state": "/_loading/salesforce.soql_query", "not": true },
            { "$state": "/salesforce/soql_query/records/0" }
          ]
        }
      },
      "headerDeal":      { "type": "Caption", "props": { "text": "Deal",       "weight": "semibold" } },
      "headerStage":     { "type": "Caption", "props": { "text": "Stage",      "weight": "semibold", "align": "center" } },
      "headerCloseDate": { "type": "Caption", "props": { "text": "Close Date", "weight": "semibold" } },
      "headerAmount":    { "type": "Caption", "props": { "text": "Amount",     "weight": "semibold", "align": "right" } },
      "dealList": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["dealRow"],
        "repeat": {
          "statePath": "/salesforce/soql_query/records",
          "key": "Id"
        },
        "visible": {
          "$and": [
            { "$state": "/_loading/salesforce.soql_query", "not": true },
            { "$state": "/salesforce/soql_query/records/0" }
          ]
        }
      },
      "dealRow": {
        "type": "Row",
        "props": { "template": "minmax(0, 1fr) 150px 85px 85px", "gap": "sm", "align": "center", "hover": true },
        "children": ["dealName", "dealStageCell", "dealCloseDate", "dealAmount"]
      },
      "dealName": {
        "type": "Text",
        "props": {
          "text": { "$item": "Name" },
          "size": "sm",
          "weight": "medium",
          "truncate": true
        }
      },
      "dealStageCell": {
        "type": "Row",
        "props": { "justify": "center" },
        "children": ["dealStage"]
      },
      "dealStage": {
        "type": "Badge",
        "props": {
          "text": { "$item": "StageName" },
          "tone": {
            "$computed": "salesforce_deal_stage_tone",
            "args": { "value": { "$item": "StageName" } }
          },
          "variant": "soft"
        }
      },
      "dealCloseDate": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "format_date",
            "args": { "value": { "$item": "CloseDate" } }
          }
        }
      },
      "dealAmount": {
        "type": "Text",
        "props": {
          "text": {
            "$computed": "format_currency",
            "args": { "value": { "$item": "Amount" } }
          },
          "size": "sm",
          "weight": "semibold",
          "align": "right"
        }
      }
    }
  },
  "status": "published"
}
