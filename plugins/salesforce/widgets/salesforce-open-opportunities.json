{
  "id": "salesforce-open-opportunities-v1",
  "title": "Open Opportunities",
  "description": "Open Salesforce opportunities sorted by close date — name, account, stage, amount, and days until close.",
  "category": "sales",
  "tags": ["salesforce", "crm", "opportunities", "pipeline", "forecast", "sales"],
  "keywords": ["opportunities", "pipeline", "deals", "forecast", "close date", "sales", "salesforce"],
  "connectorsUsed": ["salesforce"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 8, "rowSpan": 6 },
    "min":       { "colSpan": 5, "rowSpan": 4 },
    "max":       { "colSpan": 12, "rowSpan": 12 }
  },
  "dataProvider": {
    "mcp": "salesforce",
    "tool": "soql_query",
    "params": {
      "query": "SELECT Id, Name, Account.Name, StageName, Amount, CloseDate, Probability FROM Opportunity WHERE IsClosed = false ORDER BY CloseDate ASC LIMIT 50"
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": ["titleRow", "statGrid", "divider", "tableBody", "footerDivider", "footer"]
      },

      "titleRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["titleGroup", "refreshBtn"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": { "type": "Icon", "props": { "name": "TrendingUp", "tone": "accent", "size": "sm" } },
      "titleStack": { "type": "Stack", "props": { "gap": "none" }, "children": ["title", "eyebrow"] },
      "title": { "type": "Heading", "props": { "text": "Open Opportunities", "level": "h2" } },
      "eyebrow": { "type": "Eyebrow", "props": { "text": "Salesforce CRM" } },
      "refreshBtn": {
        "type": "IconButton",
        "props": { "icon": "RefreshCw", "tone": "muted", "size": "sm", "ariaLabel": "Refresh" },
        "on": {
          "click": {
            "action": "salesforce.soql_query",
            "params": {
              "query": "SELECT Id, Name, Account.Name, StageName, Amount, CloseDate, Probability FROM Opportunity WHERE IsClosed = false ORDER BY CloseDate ASC LIMIT 50"
            }
          }
        }
      },

      "statGrid": {
        "type": "Grid",
        "props": { "cols": 2 },
        "children": ["tileCount", "tileValue"]
      },
      "tileCount": { "type": "Section", "props": { "variant": "muted" }, "children": ["stackCount"] },
      "stackCount": { "type": "Stack", "props": { "gap": "xxs", "align": "center" }, "children": ["iconCount", "valCount", "lblCount"] },
      "iconCount": { "type": "Icon", "props": { "name": "TrendingUp", "size": "sm", "tone": "accent" } },
      "valCount": {
        "type": "Stat",
        "props": {
          "value": { "$computed": "count", "args": { "value": { "$state": "/salesforce/soql_query/records" } } }
        }
      },
      "lblCount": { "type": "Caption", "props": { "text": "Open" } },

      "tileValue": { "type": "Section", "props": { "variant": "muted" }, "children": ["stackValue"] },
      "stackValue": { "type": "Stack", "props": { "gap": "xxs", "align": "center" }, "children": ["iconValue", "valValue", "lblValue"] },
      "iconValue": { "type": "Icon", "props": { "name": "Banknote", "size": "sm", "tone": "positive" } },
      "valValue": {
        "type": "Stat",
        "props": {
          "value": {
            "$computed": "format_currency",
            "args": {
              "value": {
                "$computed": "sum",
                "args": {
                  "value": { "$state": "/salesforce/soql_query/records" },
                  "field": "Amount"
                }
              }
            }
          },
          "level": "h2"
        }
      },
      "lblValue": { "type": "Caption", "props": { "text": "Pipeline Value" } },

      "divider": { "type": "Divider", "props": {} },

      "tableBody": { "type": "Body", "props": {}, "children": ["loading", "empty", "table"] },

      "loading": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "visible": { "$state": "/_loading/salesforce.soql_query" },
        "children": ["sk1", "sk2", "sk3", "sk4", "sk5"]
      },
      "sk1": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "sk2": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "sk3": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "sk4": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "sk5": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },

      "empty": {
        "type": "Empty",
        "props": { "message": "No open opportunities — time to prospect." },
        "visible": {
          "$and": [
            { "$state": "/_loading/salesforce.soql_query", "not": true },
            { "$state": "/salesforce/soql_query/records/0", "not": true }
          ]
        }
      },

      "table": {
        "type": "Table",
        "props": {
          "loading": { "$state": "/_loading/salesforce.soql_query" },
          "skeletonRows": 5,
          "rows": { "$state": "/salesforce/soql_query/records" },
          "columns": [
            { "id": "name",    "header": "Opportunity",  "field": "Name",          "priority": 1 },
            { "id": "account", "header": "Account",      "field": "Account.Name",  "width": 140, "priority": 2 },
            { "id": "stage",   "header": "Stage",        "field": "StageName",     "width": 120, "priority": 2 },
            { "id": "amount",  "header": "Amount",       "field": "Amount",        "width": 110, "priority": 1, "format": "currency" },
            { "id": "close",   "header": "Close Date",   "field": "CloseDate",     "width": 110, "priority": 1, "format": "relative" },
            { "id": "prob",    "header": "Prob %",       "field": "Probability",   "width": 75,  "priority": 3 }
          ]
        },
        "visible": {
          "$and": [
            { "$state": "/_loading/salesforce.soql_query", "not": true },
            { "$state": "/salesforce/soql_query/records/0" }
          ]
        }
      },

      "footerDivider": { "type": "Divider", "props": {} },
      "footer": {
        "type": "Row",
        "props": { "justify": "end", "gap": "xs", "align": "center" },
        "children": ["footerBtn"]
      },
      "footerBtn": {
        "type": "Button",
        "props": { "label": "Open in Salesforce", "variant": "ghost", "size": "sm", "leadingIcon": "ExternalLink" },
        "on": {
          "click": {
            "action": "open_url",
            "params": { "url": "https://salesforce.com", "target": "_blank" }
          }
        }
      }
    }
  }
}
