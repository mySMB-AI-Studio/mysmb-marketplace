{
  "id": "salesforce-membership-by-state",
  "title": "Membership by State",
  "description": "Active contacts by state as an Australian tile-map — each state sits where it belongs on the map, showing its member count, its share of the total and a bar scaled against the busiest state. Headline figures across the top cover total members, the leading state and the top-two share, and an insight line below calls out where to run a flagship event versus a regional meetup. Orgs outside Australia get a ranked list instead.",
  "category": "sales",
  "tags": ["salesforce", "crm", "contacts", "state", "membership", "distribution"],
  "keywords": ["membership", "state", "territory", "contacts", "distribution", "breakdown", "map", "NSW", "VIC", "QLD"],
  "connectorsUsed": ["salesforce"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 4, "rowSpan": 7 },
    "min":       { "colSpan": 4, "rowSpan": 6 },
    "max":       { "colSpan": 8, "rowSpan": 10 }
  },
  "dataProvider": {
    "mcp": "salesforce",
    "tool": "soql_query",
    "params": {
      "query": "SELECT MailingState, COUNT(Id) cnt FROM Contact WHERE MailingState != null GROUP BY MailingState ORDER BY COUNT(Id) DESC LIMIT 20"
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": ["header", "body", "footerDivider", "footer"],
        "watch": {
          "/salesforce/soql_query/records": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/ms",
                "value": {
                  "$computed": "salesforce_membership_map",
                  "args": { "value": { "$state": "/salesforce/soql_query/records" } }
                }
              }
            }
          ]
        }
      },

      "header": {
        "type": "Header",
        "props": {},
        "children": ["titleGroup"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "start" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "MapPin", "tone": "success", "size": "sm" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "subtitle"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Membership by State", "level": "h2" }
      },
      "subtitle": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "Active Members Across {n} States/Territories",
              "n": { "$state": "/ui/ms/stateCount" }
            }
          }
        }
      },

      "body": {
        "type": "Body",
        "props": {},
        "children": ["loading", "empty", "statGrid", "mapGrid", "rankList", "otherNote"]
      },

      "loading": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["skStats", "skMap"],
        "visible": { "$state": "/_loading/salesforce.soql_query" }
      },
      "skStats": { "type": "Skeleton", "props": { "height": "3.5rem", "rounded": "md" } },
      "skMap": { "type": "Skeleton", "props": { "height": "10rem", "rounded": "md" } },

      "empty": {
        "type": "Empty",
        "props": { "message": "No contact state data found." },
        "visible": {
          "$and": [
            { "$state": "/_loading/salesforce.soql_query", "not": true },
            { "$state": "/ui/ms/total", "not": true }
          ]
        }
      },

      "statGrid": {
        "type": "Grid",
        "props": { "cols": 3, "gap": "sm" },
        "children": ["statMembers", "statTop", "statShare"],
        "visible": {
          "$and": [
            { "$state": "/_loading/salesforce.soql_query", "not": true },
            { "$state": "/ui/ms/total" }
          ]
        }
      },
      "statMembers": {
        "type": "Section",
        "props": { "variant": "muted" },
        "children": ["statMembersLabel", "statMembersValue"]
      },
      "statMembersLabel": { "type": "Eyebrow", "props": { "text": "Active Members" } },
      "statMembersValue": {
        "type": "Stat",
        "props": { "size": "sm", "value": { "$state": "/ui/ms/total" } }
      },
      "statTop": {
        "type": "Section",
        "props": { "variant": "muted" },
        "children": ["statTopLabel", "statTopRow"]
      },
      "statTopLabel": { "type": "Eyebrow", "props": { "text": "Top State" } },
      "statTopRow": {
        "type": "Row",
        "props": { "gap": "xs", "align": "baseline" },
        "children": ["statTopValue", "statTopPct"]
      },
      "statTopValue": {
        "type": "Stat",
        "props": { "size": "sm", "value": { "$state": "/ui/ms/topCode" } }
      },
      "statTopPct": {
        "type": "Caption",
        "props": { "text": { "$state": "/ui/ms/topPct" }, "tone": "muted" }
      },
      "statShare": {
        "type": "Section",
        "props": { "variant": "muted" },
        "children": ["statShareLabel", "statShareValue"]
      },
      "statShareLabel": { "type": "Eyebrow", "props": { "text": "Top 2 Share" } },
      "statShareValue": {
        "type": "Stat",
        "props": { "size": "sm", "value": { "$state": "/ui/ms/top2Pct" } }
      },

      "mapGrid": {
        "type": "Grid",
        "props": { "cols": 4, "gap": "sm" },
        "children": ["mapSlot"],
        "repeat": { "statePath": "/ui/ms/cells", "key": "id" },
        "visible": {
          "$and": [
            { "$state": "/_loading/salesforce.soql_query", "not": true },
            { "$state": "/ui/ms/isAu" }
          ]
        }
      },
      "mapSlot": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["mapCell"]
      },
      "mapCell": {
        "type": "Section",
        "props": { "variant": "muted" },
        "visible": { "$item": "filled" },
        "children": ["mapCellTop", "mapCellCount", "mapCellBar"]
      },
      "mapCellTop": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center", "justify": "between" },
        "children": ["mapCellCode", "mapCellPct"]
      },
      "mapCellCode": {
        "type": "Eyebrow",
        "props": { "text": { "$item": "code" } }
      },
      "mapCellPct": {
        "type": "Badge",
        "props": {
          "text": { "$item": "pct" },
          "tone": "success",
          "variant": { "$item": "badgeVariant" }
        }
      },
      "mapCellCount": {
        "type": "Stat",
        "props": { "size": "sm", "value": { "$item": "count" } }
      },
      "mapCellBar": {
        "type": "Row",
        "props": {},
        "children": ["mapCellBarFill"]
      },
      "mapCellBarFill": {
        "type": "ProgressBar",
        "props": { "value": { "$item": "bar" }, "tone": "success" }
      },

      "rankList": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["rankRow"],
        "repeat": { "statePath": "/ui/ms/rows", "key": "id" },
        "visible": {
          "$and": [
            { "$state": "/_loading/salesforce.soql_query", "not": true },
            { "$state": "/ui/ms/total" },
            { "$state": "/ui/ms/isAu", "not": true }
          ]
        }
      },
      "rankRow": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["rankTopRow", "rankBar"]
      },
      "rankTopRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["rankName", "rankStats"]
      },
      "rankName": {
        "type": "Text",
        "props": { "text": { "$item": "code" }, "size": "sm", "weight": "medium", "truncate": true }
      },
      "rankStats": {
        "type": "Caption",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{count} · {pct}%",
              "count": { "$item": "count" },
              "pct": { "$item": "percentage" }
            }
          }
        }
      },
      "rankBar": {
        "type": "ProgressBar",
        "props": { "value": { "$item": "percentage" }, "tone": "success" }
      },

      "otherNote": {
        "type": "Caption",
        "props": { "text": { "$state": "/ui/ms/otherText" }, "tone": "muted" },
        "visible": { "$state": "/ui/ms/otherText" }
      },

      "footerDivider": {
        "type": "Divider",
        "props": {},
        "visible": { "$state": "/ui/ms/insight" }
      },
      "footer": {
        "type": "Row",
        "props": { "gap": "sm", "align": "start" },
        "children": ["insightIcon", "insightText"],
        "visible": { "$state": "/ui/ms/insight" }
      },
      "insightIcon": {
        "type": "Icon",
        "props": { "name": "Lightbulb", "tone": "muted", "size": "sm" }
      },
      "insightText": {
        "type": "Text",
        "props": { "text": { "$state": "/ui/ms/insight" }, "size": "sm" }
      }
    }
  },
  "status": "published"
}
