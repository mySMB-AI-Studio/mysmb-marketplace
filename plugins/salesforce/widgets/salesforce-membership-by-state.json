{
  "id": "salesforce-membership-by-state",
  "title": "Membership by State",
  "description": "Active contact count broken down by state/territory with relative progress bars and a top-2 insight summary.",
  "category": "sales",
  "tags": ["salesforce", "crm", "contacts", "state", "membership", "distribution"],
  "keywords": ["membership", "state", "territory", "contacts", "distribution", "breakdown", "NSW", "VIC", "QLD"],
  "connectorsUsed": ["salesforce"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 5, "rowSpan": 7 },
    "min":       { "colSpan": 4, "rowSpan": 5 },
    "max":       { "colSpan": 8, "rowSpan": 14 }
  },
  "dataProvider": {
    "mcp": "salesforce",
    "tool": "soql_query",
    "params": {
      "query": "SELECT MailingState, COUNT(Id) cnt FROM Contact WHERE MailingState != null GROUP BY MailingState ORDER BY COUNT(Id) DESC LIMIT 20"
    }
  },
  "spec": {
    "root": "card",
    "elements": {

      "card": {
        "type": "Card",
        "props": {},
        "children": ["titleRow", "subtitleRow", "divider", "body"],
        "watch": {
          "/salesforce/soql_query/records": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/stateRows",
                "value": {
                  "$computed": "salesforce_flatten_by_state",
                  "args": { "value": { "$state": "/salesforce/soql_query/records" } }
                }
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/statsSummary",
                "value": {
                  "$computed": "salesforce_state_summary",
                  "args": {
                    "value": { "$state": "/salesforce/soql_query/records" },
                    "label": "members"
                  }
                }
              }
            }
          ]
        }
      },

      "titleRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["titleGroup"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "MapPin", "tone": "accent", "size": "sm" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "eyebrow"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Membership by State", "level": "h2" }
      },
      "eyebrow": {
        "type": "Eyebrow",
        "props": { "text": "Salesforce · Contacts" }
      },

      "subtitleRow": {
        "type": "Row",
        "props": { "align": "center" },
        "children": ["subtitleText"],
        "visible": {
          "$and": [
            { "$state": "/_loading/salesforce.soql_query", "not": true },
            { "$state": "/ui/stateRows/0" }
          ]
        }
      },
      "subtitleText": {
        "type": "Text",
        "props": {
          "text": { "$state": "/ui/statsSummary/subtitleText" },
          "size": "sm",
          "tone": "muted"
        }
      },

      "divider": { "type": "Divider", "props": {} },

      "body": {
        "type": "Body",
        "props": {},
        "children": ["loading", "empty", "stateList", "insightBox"]
      },

      "loading": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["sk1", "sk2", "sk3", "sk4", "sk5"],
        "visible": { "$state": "/_loading/salesforce.soql_query" }
      },
      "sk1": { "type": "Skeleton", "props": { "height": "1.5rem", "rounded": "md" } },
      "sk2": { "type": "Skeleton", "props": { "height": "1.5rem", "rounded": "md" } },
      "sk3": { "type": "Skeleton", "props": { "height": "1.5rem", "rounded": "md" } },
      "sk4": { "type": "Skeleton", "props": { "height": "1.5rem", "rounded": "md" } },
      "sk5": { "type": "Skeleton", "props": { "height": "1.5rem", "rounded": "md" } },

      "empty": {
        "type": "Empty",
        "props": { "message": "No contact state data found." },
        "visible": {
          "$and": [
            { "$state": "/_loading/salesforce.soql_query", "not": true },
            { "$state": "/ui/stateRows/0", "not": true }
          ]
        }
      },

      "stateList": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["stateRow"],
        "repeat": { "statePath": "/ui/stateRows", "key": "id" },
        "visible": {
          "$and": [
            { "$state": "/_loading/salesforce.soql_query", "not": true },
            { "$state": "/ui/stateRows/0" }
          ]
        }
      },

      "stateRow": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center", "template": "4rem minmax(0,1fr) 5.5rem" },
        "children": ["stateName", "stateBar", "stateCountWrap"]
      },
      "stateName": {
        "type": "Text",
        "props": {
          "text": { "$item": "state" },
          "size": "sm",
          "weight": "medium"
        }
      },
      "stateBar": {
        "type": "ProgressBar",
        "props": {
          "value": { "$item": "bar_value" },
          "max": 100,
          "tone": "success"
        }
      },
      "stateCountWrap": {
        "type": "Stack",
        "props": { "align": "end" },
        "children": ["stateCountText"]
      },
      "stateCountText": {
        "type": "Text",
        "props": {
          "text": { "$item": "count_label" },
          "size": "xs",
          "tone": "muted"
        }
      },

      "insightBox": {
        "type": "Section",
        "props": { "variant": "muted" },
        "children": ["insightRow"],
        "visible": {
          "$and": [
            { "$state": "/_loading/salesforce.soql_query", "not": true },
            { "$state": "/ui/statsSummary/insightText" }
          ]
        }
      },
      "insightRow": {
        "type": "Row",
        "props": { "gap": "sm", "align": "start" },
        "children": ["insightIcon", "insightText"]
      },
      "insightIcon": {
        "type": "Icon",
        "props": { "name": "Zap", "tone": "accent", "size": "xs" }
      },
      "insightText": {
        "type": "Text",
        "props": {
          "text": { "$state": "/ui/statsSummary/insightText" },
          "size": "xs",
          "tone": "muted"
        }
      }

    }
  },
  "status": "published"
}
