{
  "id": "salesforce-member-engagement",
  "title": "Member Engagement",
  "description": "Engagement breakdown of active members using the `Engagement_Level__c` custom field on Contact. A donut and headline share show how much of the membership is engaged, with a plain-English summary beside it, then one row per tier with its count, share and bar. Requires `Engagement_Level__c` to be populated with values: Engaged, Less Engaged, Does Not Engage. Any other value the org uses is listed as its own tier rather than dropped.",
  "category": "crm",
  "tags": ["salesforce", "membership", "engagement", "contacts", "association"],
  "keywords": ["engagement", "member engagement", "engaged", "less engaged", "active members", "participation"],
  "connectorsUsed": ["salesforce"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 4, "rowSpan": 4 },
    "min":       { "colSpan": 4, "rowSpan": 4 },
    "max":       { "colSpan": 8, "rowSpan": 8 }
  },
  "dataProvider": {
    "mcp": "salesforce",
    "tool": "soql_query",
    "params": {
      "query": "SELECT Engagement_Level__c, COUNT(Id) cnt FROM Contact WHERE Membership_Type__c != null GROUP BY Engagement_Level__c"
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": ["header", "body", "footerDivider", "footer"],
        "watch": {
          "/salesforce/soql_query/records": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/me",
                "value": {
                  "$computed": "salesforce_engagement_breakdown",
                  "args": { "value": { "$state": "/salesforce/soql_query/records" } }
                }
              }
            }
          ]
        }
      },

      "header": {
        "type": "Header",
        "props": {},
        "children": ["titleGroup"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "start" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "Users", "tone": "success", "size": "sm" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "subtitle"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Member Engagement", "level": "h2" }
      },
      "subtitle": {
        "type": "Eyebrow",
        "props": {
          "text": {
            "$computed": "fmt",
            "args": {
              "pattern": "{total} Active Members",
              "total": { "$state": "/ui/me/total" }
            }
          }
        }
      },

      "body": {
        "type": "Body",
        "props": {},
        "children": ["loading", "empty", "hero", "breakdown"]
      },

      "loading": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["skHero", "sk1", "sk2", "sk3"],
        "visible": { "$state": "/_loading/salesforce.soql_query" }
      },
      "skHero": { "type": "Skeleton", "props": { "height": "6rem",   "rounded": "md" } },
      "sk1":    { "type": "Skeleton", "props": { "height": "2.25rem", "rounded": "md" } },
      "sk2":    { "type": "Skeleton", "props": { "height": "2.25rem", "rounded": "md" } },
      "sk3":    { "type": "Skeleton", "props": { "height": "2.25rem", "rounded": "md" } },

      "empty": {
        "type": "Empty",
        "props": { "message": "No engagement data found. Make sure an `Engagement_Level__c` custom field exists on the Contact object and is populated for members." },
        "visible": {
          "$and": [
            { "$state": "/_loading/salesforce.soql_query", "not": true },
            { "$state": "/ui/me/total", "not": true }
          ]
        }
      },

      "hero": {
        "type": "Section",
        "props": { "variant": "muted" },
        "children": ["heroHeadline", "heroSummary"],
        "visible": {
          "$and": [
            { "$state": "/_loading/salesforce.soql_query", "not": true },
            { "$state": "/ui/me/total" }
          ]
        }
      },
      "heroHeadline": {
        "type": "Row",
        "props": { "gap": "xs", "align": "baseline" },
        "children": ["heroPct", "heroLabel"]
      },
      "heroPct": {
        "type": "Stat",
        "props": { "value": { "$state": "/ui/me/engagedPct" }, "size": "sm" }
      },
      "heroLabel": {
        "type": "Text",
        "props": { "text": "Highly Engaged", "size": "sm", "weight": "medium" }
      },
      "heroSummary": {
        "type": "Caption",
        "props": { "text": { "$state": "/ui/me/summary" }, "tone": "muted" }
      },

      "breakdown": {
        "type": "Donut",
        "props": {
          "segments": { "$state": "/ui/me/segments" },
          "centerLabel": "Members",
          "size": 104,
          "thickness": 14
        },
        "visible": {
          "$and": [
            { "$state": "/_loading/salesforce.soql_query", "not": true },
            { "$state": "/ui/me/total" }
          ]
        }
      },

      "footerDivider": {
        "type": "Divider",
        "props": {},
        "visible": {
          "$and": [
            { "$state": "/_loading/salesforce.soql_query", "not": true },
            { "$state": "/ui/me/total" }
          ]
        }
      },
      "footer": {
        "type": "Caption",
        "props": { "text": "Synced from Salesforce", "tone": "muted" },
        "visible": {
          "$and": [
            { "$state": "/_loading/salesforce.soql_query", "not": true },
            { "$state": "/ui/me/total" }
          ]
        }
      }
    }
  },
  "status": "published"
}
