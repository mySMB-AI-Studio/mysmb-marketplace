{
  "id": "salesforce-recent-accounts",
  "title": "Recent Accounts",
  "description": "Recently viewed Salesforce accounts with type, industry, phone, and billing state.",
  "category": "sales",
  "tags": ["salesforce", "crm", "accounts", "customers", "sales"],
  "keywords": ["account", "accounts", "customer", "customers", "recent accounts", "industry", "type", "phone", "state", "billing", "salesforce", "crm"],
  "connectorsUsed": ["salesforce"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 5, "rowSpan": 6 },
    "min": { "colSpan": 4, "rowSpan": 4 },
    "max": { "colSpan": 10, "rowSpan": 10 }
  },
  "dataProvider": {
    "mcp": "salesforce",
    "tool": "soql_query",
    "params": {
      "query": "SELECT Id, Name, Type, Industry, Owner.Name, Phone, BillingState, Website, AnnualRevenue FROM Account ORDER BY LastViewedDate DESC NULLS LAST LIMIT 20"
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": ["titleRow", "colHeader", "divider", "loading", "empty", "scrollBody", "detailOverlay"],
        "watch": {
          "/salesforce/soql_query/records": [
            { "action": "setState", "params": { "statePath": "/ui/sortKey", "value": "Name|asc" } },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/sorted",
                "value": {
                  "$computed": "salesforce_sort_by_key",
                  "args": { "value": { "$state": "/salesforce/soql_query/records" }, "key": "Name|asc" }
                }
              }
            }
          ],
          "/ui/sortKey": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/sorted",
                "value": {
                  "$computed": "salesforce_sort_by_key",
                  "args": { "value": { "$state": "/salesforce/soql_query/records" }, "key": { "$state": "/ui/sortKey" } }
                }
              }
            }
          ]
        }
      },

      "titleRow": { "type": "Row", "props": { "justify": "between", "align": "center" }, "children": ["titleGroup"] },
      "titleGroup": { "type": "Row", "props": { "gap": "sm", "align": "center" }, "children": ["titleIcon", "titleStack"] },
      "titleIcon": { "type": "Icon", "props": { "name": "Building2", "tone": "accent", "size": "sm" } },
      "titleStack": { "type": "Stack", "props": { "gap": "none" }, "children": ["title", "eyebrow"] },
      "title": { "type": "Heading", "props": { "text": "Recent Accounts", "level": "h2" } },
      "eyebrow": { "type": "Eyebrow", "props": { "text": "Salesforce" } },

      "colHeader": {
        "type": "Row",
        "props": { "align": "center", "template": "minmax(0, 1fr) 9rem 5rem 7rem" },
        "children": ["colLeft", "colPhone", "colState", "colType"]
      },
      "colLeft": { "type": "Row", "props": { "gap": "xs", "align": "center" }, "children": ["colAcct", "sortBtn"] },
      "colAcct": { "type": "Caption", "props": { "text": "Account" } },
      "sortBtn": {
        "type": "Button",
        "props": { "leadingIcon": "ArrowUpDown", "variant": "ghost", "size": "sm", "ariaLabel": "Cycle sort order" },
        "on": {
          "click": {
            "action": "setState",
            "params": {
              "statePath": "/ui/sortKey",
              "value": { "$computed": "salesforce_cycle_sort", "args": { "current": { "$state": "/ui/sortKey" } } }
            }
          }
        }
      },
      "colPhone": { "type": "Caption", "props": { "text": "Phone" } },
      "colState": { "type": "Caption", "props": { "text": "State" } },
      "colType": { "type": "Caption", "props": { "text": "Type" } },

      "divider": { "type": "Divider", "props": {} },

      "loading": {
        "type": "Stack", "props": { "gap": "sm" }, "children": ["s1", "s2", "s3", "s4"],
        "visible": { "$state": "/_loading/salesforce.soql_query" }
      },
      "s1": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "s2": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "s3": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "s4": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },

      "empty": {
        "type": "Empty",
        "props": { "message": "No recently viewed accounts." },
        "visible": {
          "$and": [
            { "$state": "/_loading/salesforce.soql_query", "not": true },
            { "$state": "/salesforce/soql_query/records/0", "not": true }
          ]
        }
      },

      "scrollBody": {
        "type": "Body", "props": {}, "children": ["list"],
        "visible": { "$state": "/_loading/salesforce.soql_query", "not": true }
      },
      "list": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "row"
        ],
        "repeat": {
          "statePath": "/salesforce/soql_query/records",
          "key": "Id"
        }
      },
      "row": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "rowContent",
          "rowDivider"
        ]
      },

      "row": { "type": "Stack", "props": { "gap": "sm" }, "children": ["rowContent", "rowDivider"] },
      "rowContent": {
        "type": "Row",
        "props": { "align": "center", "hover": true, "clickable": true, "template": "minmax(0, 1fr) 9rem 5rem 7rem" },
        "children": ["rowLeft", "rowPhoneCell", "rowStateCell", "rowTypeCell"],
        "on": {
          "click": [
            { "action": "setState", "params": { "statePath": "/ui/sel/id",           "value": { "$computed": "identity", "args": { "value": { "$item": "Id" } } } } },
            { "action": "setState", "params": { "statePath": "/ui/sel/name",         "value": { "$computed": "identity", "args": { "value": { "$item": "Name" } } } } },
            { "action": "setState", "params": { "statePath": "/ui/sel/type",         "value": { "$computed": "identity", "args": { "value": { "$item": "Type" } } } } },
            { "action": "setState", "params": { "statePath": "/ui/sel/typeTone",     "value": { "$computed": "identity", "args": { "value": { "$computed": "salesforce_account_type_tone", "args": { "value": { "$item": "Type" } } } } } } },
            { "action": "setState", "params": { "statePath": "/ui/sel/industry",     "value": { "$computed": "identity", "args": { "value": { "$item": "Industry" } } } } },
            { "action": "setState", "params": { "statePath": "/ui/sel/owner",        "value": { "$computed": "identity", "args": { "value": { "$item": "Owner/Name" } } } } },
            { "action": "setState", "params": { "statePath": "/ui/sel/phone",        "value": { "$computed": "identity", "args": { "value": { "$item": "Phone" } } } } },
            { "action": "setState", "params": { "statePath": "/ui/sel/billingState", "value": { "$computed": "identity", "args": { "value": { "$item": "BillingState" } } } } },
            { "action": "setState", "params": { "statePath": "/ui/sel/website",      "value": { "$computed": "identity", "args": { "value": { "$item": "Website" } } } } },
            { "action": "setState", "params": { "statePath": "/ui/sel/revenue",      "value": { "$computed": "identity", "args": { "value": { "$item": "AnnualRevenue" } } } } }
          ]
        }
      },
      "rowDivider": { "type": "Divider", "props": {} },

      "rowLeft": { "type": "Row", "props": { "gap": "sm", "align": "center", "grow": true }, "children": ["rowAvatar", "rowInfo"] },
      "rowAvatar": {
        "type": "Avatar",
        "props": { "initials": { "$computed": "initials", "args": { "value": { "$item": "Name" } } }, "size": "md" }
      },
      "rowInfo": { "type": "Stack", "props": { "gap": "none", "grow": true }, "children": ["rowName", "rowIndustry"] },
      "rowName": { "type": "Text", "props": { "text": { "$item": "Name" }, "size": "sm", "weight": "medium", "truncate": true } },
      "rowIndustry": {
        "type": "Text",
        "props": { "text": { "$item": "Industry" }, "size": "xs", "tone": "muted", "truncate": true },
        "visible": { "$item": "Industry" }
      },

      "rowPhoneCell": { "type": "Stack", "props": {}, "children": ["rowPhone"] },
      "rowPhone": {
        "type": "Text",
        "props": {
          "text": { "$computed": "salesforce_or_dash", "args": { "value": { "$item": "Phone" } } },
          "size": "xs", "tone": "muted", "truncate": true
        }
      },

      "rowStateCell": { "type": "Stack", "props": {}, "children": ["rowState"] },
      "rowState": {
        "type": "Text",
        "props": {
          "text": { "$computed": "salesforce_or_dash", "args": { "value": { "$item": "BillingState" } } },
          "size": "xs", "tone": "muted", "truncate": true
        }
      },

      "rowTypeCell": { "type": "Stack", "props": { "align": "start" }, "children": ["rowType"] },
      "rowType": {
        "type": "Badge",
        "props": {
          "text": { "$computed": "salesforce_or_dash", "args": { "value": { "$item": "Type" } } },
          "tone": { "$computed": "salesforce_account_type_tone", "args": { "value": { "$item": "Type" } } },
          "variant": "soft"
        }
      },

      "detailOverlay": {
        "type": "Overlay", "props": { "open": true, "maxWidth": "30rem" },
        "visible": { "$state": "/ui/sel/id" },
        "children": ["detailStack"]
      },
      "detailStack": {
        "type": "Stack", "props": { "gap": "md" },
        "children": ["detailTitleRow", "detailMeta", "detailContact", "detailRevRow", "detailWebsiteRow"]
      },

      "detailTitleRow": {
        "type": "Row", "props": { "justify": "between", "align": "center" },
        "children": ["detailNameGroup", "detailCloseX"]
      },
      "detailNameGroup": {
        "type": "Row", "props": { "gap": "sm", "align": "center" },
        "children": ["detailName", "detailTypeBadge"]
      },
      "detailName": { "type": "Heading", "props": { "text": { "$state": "/ui/sel/name" }, "level": "h3" } },
      "detailTypeBadge": {
        "type": "Badge",
        "props": { "text": { "$state": "/ui/sel/type" }, "tone": { "$state": "/ui/sel/typeTone" } },
        "visible": { "$state": "/ui/sel/type" }
      },
      "detailCloseX": {
        "type": "OverlayClose", "props": {},
        "on": { "click": { "action": "setState", "params": { "statePath": "/ui/sel/id", "value": "" } } }
      },

      "detailMeta": {
        "type": "Grid", "props": { "cols": 2, "gap": "md" },
        "children": ["metaTypeCell", "metaIndustryCell"]
      },
      "metaTypeCell": { "type": "Stack", "props": { "gap": "xxs" }, "children": ["metaTypeLbl", "metaTypeVal"] },
      "metaTypeLbl": { "type": "Caption", "props": { "text": "Type" } },
      "metaTypeVal": {
        "type": "Text",
        "props": {
          "text": { "$computed": "salesforce_or_dash", "args": { "value": { "$state": "/ui/sel/type" } } },
          "size": "sm"
        }
      },
      "metaIndustryCell": { "type": "Stack", "props": { "gap": "xxs" }, "children": ["metaIndustryLbl", "metaIndustryVal"] },
      "metaIndustryLbl": { "type": "Caption", "props": { "text": "Industry" } },
      "metaIndustryVal": {
        "type": "Text",
        "props": {
          "text": { "$computed": "salesforce_or_dash", "args": { "value": { "$state": "/ui/sel/industry" } } },
          "size": "sm"
        }
      },

      "detailContact": {
        "type": "Grid", "props": { "cols": 2, "gap": "md" },
        "children": ["metaOwnerCell", "metaPhoneCell", "metaBillingStateCell"]
      },
      "metaOwnerCell": { "type": "Stack", "props": { "gap": "xxs" }, "children": ["metaOwnerLbl", "metaOwnerVal"] },
      "metaOwnerLbl": { "type": "Caption", "props": { "text": "Account Owner" } },
      "metaOwnerVal": { "type": "Text", "props": { "text": { "$state": "/ui/sel/owner" }, "size": "sm" } },
      "metaPhoneCell": { "type": "Stack", "props": { "gap": "xxs" }, "children": ["metaPhoneLbl", "metaPhoneVal"] },
      "metaPhoneLbl": { "type": "Caption", "props": { "text": "Phone" } },
      "metaPhoneVal": {
        "type": "Text",
        "props": {
          "text": { "$computed": "salesforce_or_dash", "args": { "value": { "$state": "/ui/sel/phone" } } },
          "size": "sm"
        }
      },
      "metaBillingStateCell": { "type": "Stack", "props": { "gap": "xxs" }, "children": ["metaBillingStateLbl", "metaBillingStateVal"] },
      "metaBillingStateLbl": { "type": "Caption", "props": { "text": "Billing State" } },
      "metaBillingStateVal": {
        "type": "Text",
        "props": {
          "text": { "$computed": "salesforce_or_dash", "args": { "value": { "$state": "/ui/sel/billingState" } } },
          "size": "sm"
        }
      },

      "detailRevRow": { "type": "Stack", "props": { "gap": "xxs" }, "children": ["metaRevLbl", "metaRevVal"] },
      "metaRevLbl": { "type": "Caption", "props": { "text": "Annual Revenue" } },
      "metaRevVal": {
        "type": "Text",
        "props": {
          "text": { "$computed": "format_currency", "args": { "value": { "$state": "/ui/sel/revenue" } } },
          "size": "sm", "weight": "medium"
        }
      },

      "detailWebsiteRow": {
        "type": "Row", "props": { "justify": "end" }, "children": ["detailWebsiteBtn"],
        "visible": { "$state": "/ui/sel/website" }
      },
      "detailWebsiteBtn": {
        "type": "Button",
        "props": { "label": "Open Website", "variant": "ghost", "size": "sm", "leadingIcon": "ExternalLink" },
        "on": { "click": { "action": "open_url", "params": { "url": { "$state": "/ui/sel/website" } } } }
      }
    }
  },
  "status": "published"
}
