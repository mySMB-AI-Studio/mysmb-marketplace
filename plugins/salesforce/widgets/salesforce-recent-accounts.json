{
  "id": "salesforce-recent-accounts",
  "title": "Key Accounts",
  "description": "Recently viewed Salesforce accounts with industry and account type.",
  "category": "sales",
  "tags": ["salesforce", "crm", "accounts", "customers", "sales"],
  "keywords": ["account", "accounts", "customer", "customers", "key accounts", "industry", "type", "salesforce", "crm"],
  "connectorsUsed": ["salesforce"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 4, "rowSpan": 6 },
    "min":       { "colSpan": 4, "rowSpan": 4 },
    "max":       { "colSpan": 10, "rowSpan": 10 }
  },
  "dataProvider": {
    "mcp": "salesforce",
    "tool": "soql_query",
    "params": {
      "query": "SELECT Id, Name, Type, Industry, Owner.Name, Phone, Website, AnnualRevenue FROM Account ORDER BY LastViewedDate DESC NULLS LAST LIMIT 20"
    }
  },
  "spec": {
    "root": "card",
    "elements": {

      "card": {
        "type": "Card",
        "props": {},
        "children": ["titleRow", "colHeader", "divider", "loading", "empty", "scrollBody", "detailOverlay"]
      },

      "titleRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["titleGroup"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": { "type": "Icon", "props": { "name": "Star", "tone": "accent", "size": "sm" } },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "eyebrow"]
      },
      "title":   { "type": "Heading", "props": { "text": "Key Accounts", "level": "h2" } },
      "eyebrow": { "type": "Eyebrow", "props": { "text": "Salesforce" } },

      "colHeader": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["colAcct", "colType"]
      },
      "colAcct": { "type": "Caption", "props": { "text": "ACCOUNT" } },
      "colType": { "type": "Caption", "props": { "text": "TYPE" } },

      "divider": { "type": "Divider", "props": {} },

      "loading": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["s1", "s2", "s3", "s4"],
        "visible": { "$state": "/_loading/salesforce.soql_query" }
      },
      "s1": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "s2": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "s3": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "s4": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },

      "empty": {
        "type": "Empty",
        "props": { "message": "No recently viewed accounts." },
        "visible": {
          "$and": [
            { "$state": "/_loading/salesforce.soql_query", "not": true },
            { "$state": "/salesforce/soql_query/records/0", "not": true }
          ]
        }
      },

      "scrollBody": {
        "type": "Body",
        "props": {},
        "children": ["list"],
        "visible": { "$state": "/_loading/salesforce.soql_query", "not": true }
      },

      "list": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["row"],
        "repeat": {
          "statePath": "/salesforce/soql_query/records",
          "key": "Id"
        }
      },

      "row": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["rowContent", "rowDivider"]
      },
      "rowContent": {
        "type": "Row",
        "props": { "justify": "between", "align": "center", "hover": true, "clickable": true },
        "children": ["rowLeft", "rowType"],
        "on": {
          "click": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/sel/id",
                "value": { "$computed": "identity", "args": { "value": { "$item": "Id" } } }
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/sel/name",
                "value": { "$computed": "identity", "args": { "value": { "$item": "Name" } } }
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/sel/type",
                "value": { "$computed": "identity", "args": { "value": { "$item": "Type" } } }
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/sel/typeTone",
                "value": {
                  "$computed": "identity",
                  "args": {
                    "value": {
                      "$computed": "salesforce_account_type_tone",
                      "args": { "value": { "$item": "Type" } }
                    }
                  }
                }
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/sel/industry",
                "value": { "$computed": "identity", "args": { "value": { "$item": "Industry" } } }
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/sel/owner",
                "value": { "$computed": "identity", "args": { "value": { "$item": "Owner/Name" } } }
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/sel/phone",
                "value": { "$computed": "identity", "args": { "value": { "$item": "Phone" } } }
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/sel/website",
                "value": { "$computed": "identity", "args": { "value": { "$item": "Website" } } }
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/sel/revenue",
                "value": { "$computed": "identity", "args": { "value": { "$item": "AnnualRevenue" } } }
              }
            }
          ]
        }
      },
      "rowDivider": { "type": "Divider", "props": {} },
      "rowLeft": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center", "grow": true },
        "children": ["rowAvatar", "rowInfo"]
      },
      "rowAvatar": {
        "type": "Avatar",
        "props": {
          "initials": {
            "$computed": "initials",
            "args": { "value": { "$item": "Name" } }
          },
          "size": "md"
        }
      },
      "rowInfo": {
        "type": "Stack",
        "props": { "gap": "none", "grow": true },
        "children": ["rowName", "rowIndustry"]
      },
      "rowName": {
        "type": "Text",
        "props": {
          "text": { "$item": "Name" },
          "size": "sm",
          "weight": "medium",
          "truncate": true
        }
      },
      "rowIndustry": {
        "type": "Text",
        "props": {
          "text": { "$item": "Industry" },
          "size": "xs",
          "tone": "muted",
          "truncate": true
        },
        "visible": { "$item": "Industry" }
      },
      "rowType": {
        "type": "Badge",
        "props": {
          "text": { "$item": "Type" },
          "tone": { "$computed": "salesforce_account_type_tone", "args": { "value": { "$item": "Type" } } },
          "variant": "soft"
        },
        "visible": { "$item": "Type" }
      },
      "rowDivider": { "type": "Divider", "props": {} },

      "detailOverlay": {
        "type": "Overlay",
        "props": { "open": true, "maxWidth": "30rem" },
        "visible": { "$state": "/ui/sel/id" },
        "children": ["detailStack"]
      },
      "detailStack": {
        "type": "Stack",
        "props": { "gap": "md" },
        "children": ["detailTitleRow", "detailMeta", "detailContact", "detailRevRow", "detailWebsiteRow"]
      },

      "detailTitleRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["detailNameGroup", "detailCloseX"]
      },
      "detailNameGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["detailName", "detailTypeBadge"]
      },
      "detailName": {
        "type": "Heading",
        "props": { "text": { "$state": "/ui/sel/name" }, "level": "h3" }
      },
      "detailTypeBadge": {
        "type": "Badge",
        "props": {
          "text": { "$state": "/ui/sel/type" },
          "tone": { "$state": "/ui/sel/typeTone" }
        }
      },
      "detailCloseX": {
        "type": "OverlayClose",
        "props": {},
        "on": {
          "click": {
            "action": "setState",
            "params": { "statePath": "/ui/sel/id", "value": "" }
          }
        }
      },

      "detailMeta": {
        "type": "Grid",
        "props": { "cols": 2, "gap": "md" },
        "children": ["metaTypeCell", "metaIndustryCell"]
      },
      "metaTypeCell": {
        "type": "Stack",
        "props": { "gap": "xxs" },
        "children": ["metaTypeLbl", "metaTypeVal"]
      },
      "metaTypeLbl":    { "type": "Caption", "props": { "text": "Type" } },
      "metaTypeVal":    { "type": "Text",    "props": { "text": { "$state": "/ui/sel/type" },     "size": "sm" } },
      "metaIndustryCell": {
        "type": "Stack",
        "props": { "gap": "xxs" },
        "children": ["metaIndustryLbl", "metaIndustryVal"]
      },
      "metaIndustryLbl": { "type": "Caption", "props": { "text": "Industry" } },
      "metaIndustryVal": { "type": "Text",    "props": { "text": { "$state": "/ui/sel/industry" }, "size": "sm" } },

      "detailContact": {
        "type": "Grid",
        "props": { "cols": 2, "gap": "md" },
        "children": ["metaOwnerCell", "metaPhoneCell"]
      },
      "metaOwnerCell": {
        "type": "Stack",
        "props": { "gap": "xxs" },
        "children": ["metaOwnerLbl", "metaOwnerVal"]
      },
      "metaOwnerLbl": { "type": "Caption", "props": { "text": "Account Owner" } },
      "metaOwnerVal": { "type": "Text",    "props": { "text": { "$state": "/ui/sel/owner" }, "size": "sm" } },
      "metaPhoneCell": {
        "type": "Stack",
        "props": { "gap": "xxs" },
        "children": ["metaPhoneLbl", "metaPhoneVal"]
      },
      "metaPhoneLbl": { "type": "Caption", "props": { "text": "Phone" } },
      "metaPhoneVal": { "type": "Text",    "props": { "text": { "$state": "/ui/sel/phone" }, "size": "sm" } },

      "detailRevRow": {
        "type": "Stack",
        "props": { "gap": "xxs" },
        "children": ["metaRevLbl", "metaRevVal"]
      },
      "metaRevLbl": { "type": "Caption", "props": { "text": "Annual Revenue" } },
      "metaRevVal": {
        "type": "Text",
        "props": {
          "text": {
            "$computed": "format_currency",
            "args": { "value": { "$state": "/ui/sel/revenue" } }
          },
          "size": "sm",
          "weight": "medium"
        }
      },

      "detailWebsiteRow": {
        "type": "Row",
        "props": { "justify": "end" },
        "children": ["detailWebsiteBtn"],
        "visible": { "$state": "/ui/sel/website" }
      },
      "detailWebsiteBtn": {
        "type": "Button",
        "props": { "label": "Open Website", "variant": "ghost", "size": "sm", "leadingIcon": "ExternalLink" },
        "on": {
          "click": {
            "action": "open_url",
            "params": { "url": { "$state": "/ui/sel/website" } }
          }
        }
      }

    }
  },
  "status": "published"
}
