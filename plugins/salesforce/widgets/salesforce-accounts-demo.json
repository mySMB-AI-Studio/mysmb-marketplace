{
  "id": "salesforce-accounts-demo",
  "title": "Key Accounts (Demo)",
  "description": "STATIC DEMO — hardcoded sample data, no connector required. Switch to salesforce-recent-accounts once Salesforce OAuth is configured.",
  "category": "sales",
  "tags": ["salesforce", "crm", "accounts", "customers", "sales", "demo"],
  "keywords": ["account", "accounts", "customer", "customers", "key accounts", "industry", "type", "salesforce", "crm", "demo"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 4, "rowSpan": 5 },
    "min":       { "colSpan": 4, "rowSpan": 4 },
    "max":       { "colSpan": 10, "rowSpan": 10 }
  },
  "spec": {
    "root": "card",
    "elements": {

      "card": {
        "type": "Card",
        "props": {},
        "children": ["titleRow", "colHeader", "divider", "rows"]
      },

      "titleRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["titleGroup", "sfLogo"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": { "type": "Icon", "props": { "name": "Building2", "tone": "accent", "size": "sm" } },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "eyebrow"]
      },
      "title":   { "type": "Heading", "props": { "text": "Key Accounts", "level": "h2" } },
      "eyebrow": { "type": "Eyebrow", "props": { "text": "Salesforce" } },
      "sfLogo":  { "type": "Icon", "props": { "name": "Cloud", "tone": "accent", "size": "md" } },

      "colHeader": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["colAcct", "colType"]
      },
      "colAcct": { "type": "Caption", "props": { "text": "ACCOUNT" } },
      "colType": { "type": "Caption", "props": { "text": "TYPE" } },

      "divider": { "type": "Divider", "props": {} },

      "rows": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["acct1", "acct2", "acct3", "acct4"]
      },

      "acct1": { "type": "Row", "props": { "justify": "between", "align": "center" }, "children": ["acct1Left", "acct1Type"] },
      "acct1Left": { "type": "Row", "props": { "gap": "sm", "align": "center" }, "children": ["acct1Av", "acct1Info"] },
      "acct1Av":   { "type": "Avatar", "props": { "initials": "A", "tone": "accent", "size": "sm" } },
      "acct1Info": { "type": "Stack", "props": { "gap": "none" }, "children": ["acct1Name", "acct1Ind"] },
      "acct1Name": { "type": "Text", "props": { "text": "Acme Corporation", "size": "sm", "weight": "medium", "truncate": true } },
      "acct1Ind":  { "type": "Text", "props": { "text": "Technology", "size": "xs", "tone": "muted", "truncate": true } },
      "acct1Type": { "type": "Badge", "props": { "text": "Customer", "tone": "positive", "variant": "soft" } },

      "acct2": { "type": "Row", "props": { "justify": "between", "align": "center" }, "children": ["acct2Left", "acct2Type"] },
      "acct2Left": { "type": "Row", "props": { "gap": "sm", "align": "center" }, "children": ["acct2Av", "acct2Info"] },
      "acct2Av":   { "type": "Avatar", "props": { "initials": "G", "tone": "info", "size": "sm" } },
      "acct2Info": { "type": "Stack", "props": { "gap": "none" }, "children": ["acct2Name", "acct2Ind"] },
      "acct2Name": { "type": "Text", "props": { "text": "Global Media", "size": "sm", "weight": "medium", "truncate": true } },
      "acct2Ind":  { "type": "Text", "props": { "text": "Media & Entertainment", "size": "xs", "tone": "muted", "truncate": true } },
      "acct2Type": { "type": "Badge", "props": { "text": "Customer", "tone": "positive", "variant": "soft" } },

      "acct3": { "type": "Row", "props": { "justify": "between", "align": "center" }, "children": ["acct3Left", "acct3Type"] },
      "acct3Left": { "type": "Row", "props": { "gap": "sm", "align": "center" }, "children": ["acct3Av", "acct3Info"] },
      "acct3Av":   { "type": "Avatar", "props": { "initials": "G", "tone": "positive", "size": "sm" } },
      "acct3Info": { "type": "Stack", "props": { "gap": "none" }, "children": ["acct3Name", "acct3Ind"] },
      "acct3Name": { "type": "Text", "props": { "text": "Greenfield Inc.", "size": "sm", "weight": "medium", "truncate": true } },
      "acct3Ind":  { "type": "Text", "props": { "text": "Manufacturing", "size": "xs", "tone": "muted", "truncate": true } },
      "acct3Type": { "type": "Badge", "props": { "text": "Prospect", "tone": "warning", "variant": "soft" } },

      "acct4": { "type": "Row", "props": { "justify": "between", "align": "center" }, "children": ["acct4Left", "acct4Type"] },
      "acct4Left": { "type": "Row", "props": { "gap": "sm", "align": "center" }, "children": ["acct4Av", "acct4Info"] },
      "acct4Av":   { "type": "Avatar", "props": { "initials": "S", "tone": "muted", "size": "sm" } },
      "acct4Info": { "type": "Stack", "props": { "gap": "none" }, "children": ["acct4Name", "acct4Ind"] },
      "acct4Name": { "type": "Text", "props": { "text": "StartUp.io", "size": "sm", "weight": "medium", "truncate": true } },
      "acct4Ind":  { "type": "Text", "props": { "text": "Software", "size": "xs", "tone": "muted", "truncate": true } },
      "acct4Type": { "type": "Badge", "props": { "text": "Partner", "tone": "accent", "variant": "soft" } }

    }
  },
  "status": "draft"
}
