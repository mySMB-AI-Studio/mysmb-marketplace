{
  "id": "zoho-crm-account-activity-feed",
  "title": "Account Activity Feed",
  "description": "Zoho CRM accounts whose open deals changed this week, newest first, with each account's contacts and its largest open deal's value and stage. Click an account to see its contacts.",
  "category": "crm",
  "tags": [
    "zoho",
    "zoho-crm",
    "crm",
    "accounts",
    "activity",
    "sales"
  ],
  "keywords": [
    "accounts",
    "account activity",
    "recent activity",
    "open deals",
    "contacts",
    "this week",
    "zoho crm"
  ],
  "connectorsUsed": [
    "zoho-crm"
  ],
  "popularity": 0,
  "branding": {
    "color": "#1A73E8"
  },
  "sizing": {
    "preferred": {
      "colSpan": 6,
      "rowSpan": 7
    },
    "min": {
      "colSpan": 4,
      "rowSpan": 5
    },
    "max": {
      "colSpan": 10,
      "rowSpan": 12
    }
  },
  "dataProvider": {
    "kind": "tool",
    "mcp": "zoho-crm",
    "tool": "coql_query",
    "params": {
      "select_query": "select Deal_Name, Amount, Currency, Stage, Probability, Modified_Time, Account_Name.id, Account_Name.Account_Name, Contact_Name.Full_Name, Contact_Name.Email from Deals where Stage not in ('Closed Won', 'Closed Lost', 'Closed Lost to Competition') and Modified_Time is not null order by Modified_Time desc limit 200"
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": [
          "header",
          "body"
        ],
        "watch": {
          "/zoho-crm/coql_query/data": {
            "action": "setState",
            "params": {
              "statePath": "/ui/activity",
              "value": {
                "$computed": "zoho-crm_account_activity_dashboard",
                "args": {
                  "value": {
                    "$state": "/zoho-crm/coql_query/data"
                  },
                  "moreRecords": {
                    "$state": "/zoho-crm/coql_query/info/more_records"
                  },
                  "contacts": {
                    "$state": "/zoho-crm/list_records/data"
                  },
                  "currency": "USD",
                  "selected": {
                    "$state": "/ui/selectedAccount"
                  }
                }
              }
            }
          },
          "/zoho-crm/list_records/data": {
            "action": "setState",
            "params": {
              "statePath": "/ui/activity",
              "value": {
                "$computed": "zoho-crm_account_activity_dashboard",
                "args": {
                  "value": {
                    "$state": "/zoho-crm/coql_query/data"
                  },
                  "moreRecords": {
                    "$state": "/zoho-crm/coql_query/info/more_records"
                  },
                  "contacts": {
                    "$state": "/zoho-crm/list_records/data"
                  },
                  "currency": "USD",
                  "selected": {
                    "$state": "/ui/selectedAccount"
                  }
                }
              }
            }
          },
          "/ui/selectedAccount": {
            "action": "setState",
            "params": {
              "statePath": "/ui/activity",
              "value": {
                "$computed": "zoho-crm_account_activity_dashboard",
                "args": {
                  "value": {
                    "$state": "/zoho-crm/coql_query/data"
                  },
                  "moreRecords": {
                    "$state": "/zoho-crm/coql_query/info/more_records"
                  },
                  "contacts": {
                    "$state": "/zoho-crm/list_records/data"
                  },
                  "currency": "USD",
                  "selected": {
                    "$state": "/ui/selectedAccount"
                  }
                }
              }
            }
          }
        }
      },
      "header": {
        "type": "Header",
        "props": {},
        "children": [
          "titleGroup"
        ]
      },
      "titleGroup": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "start"
        },
        "children": [
          "titleIcon",
          "titleStack"
        ]
      },
      "titleIcon": {
        "type": "Icon",
        "props": {
          "name": "Building2",
          "tone": "brand",
          "size": "lg"
        }
      },
      "titleStack": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "children": [
          "title",
          "eyebrow"
        ]
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "Account Activity Feed",
          "level": "h2"
        }
      },
      "eyebrow": {
        "type": "Eyebrow",
        "props": {
          "text": "Zoho CRM"
        }
      },
      "body": {
        "type": "Body",
        "props": {},
        "children": [
          "loading",
          "error",
          "empty",
          "content"
        ],
        "watch": {
          "/zoho-crm/coql_query/data": {
            "action": "zoho-crm.list_records",
            "params": {
              "module": "Contacts",
              "fields": "Full_Name,Email,Account_Name",
              "per_page": 200,
              "sort_by": "Modified_Time",
              "sort_order": "desc"
            }
          }
        }
      },
      "loading": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "skHero",
          "skRow1",
          "skRow2",
          "skRow3"
        ],
        "visible": {
          "$state": "/_loading/zoho-crm.coql_query"
        }
      },
      "skHero": {
        "type": "Skeleton",
        "props": {
          "height": "4rem",
          "rounded": "md"
        }
      },
      "skRow1": {
        "type": "Skeleton",
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        }
      },
      "skRow2": {
        "type": "Skeleton",
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        }
      },
      "skRow3": {
        "type": "Skeleton",
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        }
      },
      "error": {
        "type": "Empty",
        "props": {
          "message": "Couldn't load account activity from Zoho CRM. Please try again."
        },
        "visible": {
          "$and": [
            {
              "$state": "/_loading/zoho-crm.coql_query",
              "not": true
            },
            {
              "$state": "/_errors/zoho-crm.coql_query"
            }
          ]
        }
      },
      "empty": {
        "type": "Empty",
        "props": {
          "message": "No account activity this week."
        },
        "visible": {
          "$and": [
            {
              "$state": "/_loading/zoho-crm.coql_query",
              "not": true
            },
            {
              "$state": "/_errors/zoho-crm.coql_query",
              "not": true
            },
            {
              "$state": "/ui/activity/accounts/0",
              "not": true
            }
          ]
        }
      },
      "content": {
        "type": "Stack",
        "props": {
          "gap": "md"
        },
        "children": [
          "hero",
          "divider",
          "accountList",
          "footer"
        ],
        "visible": {
          "$and": [
            {
              "$state": "/_loading/zoho-crm.coql_query",
              "not": true
            },
            {
              "$state": "/_errors/zoho-crm.coql_query",
              "not": true
            },
            {
              "$state": "/ui/activity/accounts/0"
            }
          ]
        }
      },
      "hero": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "children": [
          "accountCount",
          "heroCaption"
        ]
      },
      "accountCount": {
        "type": "Stat",
        "props": {
          "value": {
            "$state": "/ui/activity/accountCount"
          },
          "size": "lg"
        }
      },
      "heroCaption": {
        "type": "Text",
        "props": {
          "text": {
            "$state": "/ui/activity/heroCaption"
          },
          "tone": "muted"
        }
      },
      "divider": {
        "type": "Divider",
        "props": {}
      },
      "accountList": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "accountItem"
        ],
        "repeat": {
          "statePath": "/ui/activity/accounts",
          "key": "id"
        }
      },
      "accountItem": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "children": [
          "accountRow",
          "contactsPanel"
        ]
      },
      "accountRow": {
        "type": "Row",
        "props": {
          "template": "auto minmax(0, 1fr) auto 14px",
          "gap": "sm",
          "align": "center",
          "hover": true,
          "clickable": true
        },
        "children": [
          "accountAvatar",
          "accountMain",
          "dealBadge",
          "accountChevron"
        ],
        "on": {
          "click": {
            "action": "setState",
            "params": {
              "statePath": "/ui/selectedAccount",
              "value": {
                "$computed": "identity",
                "args": {
                  "value": {
                    "$item": "toggleValue"
                  }
                }
              }
            }
          }
        }
      },
      "accountAvatar": {
        "type": "Avatar",
        "props": {
          "initials": {
            "$item": "initials"
          },
          "tone": {
            "$item": "tone"
          },
          "size": "lg"
        }
      },
      "accountMain": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "children": [
          "accountName",
          "accountMeta"
        ]
      },
      "accountName": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "name"
          },
          "size": "sm",
          "weight": "semibold",
          "truncate": true
        }
      },
      "accountMeta": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "meta"
          },
          "tone": "muted",
          "truncate": true
        }
      },
      "dealBadge": {
        "type": "Badge",
        "props": {
          "text": {
            "$item": "dealLabel"
          },
          "tone": {
            "$item": "tone"
          },
          "variant": "soft"
        }
      },
      "accountChevron": {
        "type": "Icon",
        "props": {
          "name": {
            "$item": "chevron"
          },
          "tone": "muted",
          "size": "sm"
        }
      },
      "contactsPanel": {
        "type": "Section",
        "props": {
          "variant": "muted"
        },
        "children": [
          "contactList",
          "contactsEmpty"
        ],
        "visible": {
          "$item": "expanded"
        }
      },
      "contactList": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "contactRow"
        ],
        "repeat": {
          "statePath": "/ui/activity/openContacts",
          "key": "id"
        }
      },
      "contactRow": {
        "type": "Row",
        "props": {
          "template": "auto minmax(0, 1fr)",
          "gap": "sm",
          "align": "center"
        },
        "children": [
          "contactAvatar",
          "contactMain"
        ]
      },
      "contactAvatar": {
        "type": "Avatar",
        "props": {
          "initials": {
            "$item": "initials"
          },
          "tone": "brand",
          "size": "sm"
        }
      },
      "contactMain": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "children": [
          "contactName",
          "contactEmail"
        ]
      },
      "contactName": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "name"
          },
          "size": "sm",
          "weight": "medium",
          "truncate": true
        }
      },
      "contactEmail": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "email"
          },
          "tone": "muted",
          "truncate": true
        },
        "visible": {
          "$item": "email"
        }
      },
      "contactsEmpty": {
        "type": "Text",
        "props": {
          "text": "No contacts linked to this account yet.",
          "tone": "muted"
        },
        "visible": {
          "$state": "/ui/activity/openEmpty"
        }
      },
      "footer": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "children": [
          "divider2",
          "coverageNote",
          "footerActions"
        ]
      },
      "divider2": {
        "type": "Divider",
        "props": {}
      },
      "coverageNote": {
        "type": "Caption",
        "props": {
          "text": {
            "$state": "/ui/activity/coverageText"
          }
        },
        "visible": {
          "$state": "/ui/activity/truncated"
        }
      },
      "footerActions": {
        "type": "Row",
        "props": {
          "justify": "end",
          "align": "center"
        },
        "children": [
          "openButton"
        ]
      },
      "openButton": {
        "type": "Button",
        "props": {
          "label": "View all accounts",
          "size": "sm",
          "variant": "primary",
          "tone": "brand",
          "leadingIcon": "ExternalLink"
        },
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "url": "https://crm.zoho.com/crm/tab/Accounts",
              "target": "_blank"
            }
          }
        }
      }
    }
  }
}
