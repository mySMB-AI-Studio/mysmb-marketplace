{
  "category": "tasks",
  "connectorsUsed": [
    "asana"
  ],
  "dataProvider": {
    "kind": "tool",
    "mcp": "asana",
    "params": {
      "member_limit": 10
    },
    "tool": "get_team_workload"
  },
  "description": "Active task counts per team member in your Asana workspace, sorted by workload.",
  "id": "asana-team-workload",
  "keywords": [
    "team workload",
    "asana team",
    "task distribution",
    "active tasks"
  ],
  "popularity": 60,
  "sizing": {
    "max": {
      "colSpan": 8,
      "rowSpan": 12
    },
    "min": {
      "colSpan": 3,
      "rowSpan": 4
    },
    "preferred": {
      "colSpan": 5,
      "rowSpan": 6
    }
  },
  "spec": {
    "elements": {
      "card": {
        "children": [
          "headerRow",
          "div0",
          "loading",
          "empty",
          "memberList",
          "memberFooter"
        ],
        "props": {},
        "type": "Card",
        "watch": {
          "/asana/get_team_workload/data": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/rows",
                "value": {
                  "$computed": "asana_flatten_team_workload",
                  "args": {
                    "value": {
                      "$state": "/asana/get_team_workload/data"
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "div0": {
        "props": {},
        "type": "Divider"
      },
      "empty": {
        "props": {
          "message": "No team members found."
        },
        "type": "Empty",
        "visible": {
          "$and": [
            {
              "$state": "/_loading/asana.get_team_workload",
              "not": true
            },
            {
              "$state": "/ui/rows/0",
              "not": true
            }
          ]
        }
      },
      "eyebrow": {
        "props": {
          "text": "Asana"
        },
        "type": "Eyebrow"
      },
      "headerRow": {
        "children": [
          "titleGroup"
        ],
        "props": {
          "align": "center",
          "justify": "between"
        },
        "type": "Row"
      },
      "loading": {
        "children": [
          "sk1",
          "sk2",
          "sk3"
        ],
        "props": {
          "gap": "sm"
        },
        "type": "Stack",
        "visible": {
          "$state": "/_loading/asana.get_team_workload"
        }
      },
      "memberAvatar": {
        "props": {
          "initials": {
            "$item": "initials"
          },
          "size": "sm"
        },
        "type": "Avatar"
      },
      "memberBar": {
        "props": {
          "tone": "success",
          "value": {
            "$item": "pct"
          }
        },
        "type": "ProgressBar"
      },
      "memberBarRow": {
        "children": [
          "memberBar"
        ],
        "props": {},
        "type": "Row"
      },
      "memberFooter": {
        "props": {
          "text": {
            "$state": "/ui/rows/0/footer_label"
          },
          "tone": "muted"
        },
        "type": "Caption",
        "visible": {
          "$and": [
            {
              "$state": "/_loading/asana.get_team_workload",
              "not": true
            },
            {
              "$state": "/ui/rows/0/footer_label"
            }
          ]
        }
      },
      "memberList": {
        "children": [
          "memberRow"
        ],
        "props": {
          "gap": "sm"
        },
        "repeat": {
          "key": "id",
          "statePath": "/ui/rows"
        },
        "type": "Stack",
        "visible": {
          "$and": [
            {
              "$state": "/_loading/asana.get_team_workload",
              "not": true
            },
            {
              "$state": "/ui/rows/0"
            }
          ]
        }
      },
      "memberName": {
        "props": {
          "grow": true,
          "size": "sm",
          "text": {
            "$item": "display_name"
          },
          "weight": "semibold"
        },
        "type": "Text"
      },
      "memberRow": {
        "children": [
          "memberTopRow",
          "memberBarRow"
        ],
        "props": {
          "gap": "xs"
        },
        "type": "Stack"
      },
      "memberTaskCount": {
        "props": {
          "size": "sm",
          "text": {
            "$item": "task_label"
          },
          "tone": "muted"
        },
        "type": "Text"
      },
      "memberTopRow": {
        "children": [
          "memberAvatar",
          "memberName",
          "memberTaskCount"
        ],
        "props": {
          "align": "center",
          "gap": "sm"
        },
        "type": "Row"
      },
      "sk1": {
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "sk2": {
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "sk3": {
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "title": {
        "props": {
          "level": "h2",
          "text": "Team Workload"
        },
        "type": "Heading"
      },
      "titleGroup": {
        "children": [
          "titleIcon",
          "titleStack"
        ],
        "props": {
          "align": "center",
          "gap": "sm"
        },
        "type": "Row"
      },
      "titleIcon": {
        "props": {
          "name": "UsersRound",
          "size": "sm",
          "tone": "accent"
        },
        "type": "Icon"
      },
      "titleStack": {
        "children": [
          "title",
          "eyebrow"
        ],
        "props": {
          "gap": "none"
        },
        "type": "Stack"
      }
    },
    "root": "card"
  },
  "tags": [
    "asana",
    "team",
    "workload",
    "tasks",
    "assignee"
  ],
  "title": "Team Workload"
}
