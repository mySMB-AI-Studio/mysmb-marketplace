{
  "brandColor": "#6C5CE7",
  "category": "tasks",
  "connectorsUsed": [
    "asana"
  ],
  "dataProvider": {
    "kind": "tool",
    "mcp": "asana",
    "params": {
      "member_limit": 10
    },
    "tool": "get_team_workload"
  },
  "description": "Active task load per workspace member against a capacity you set: a team total with a balance read, a per-person bar that changes colour at capacity, and a legend counting who is near it and who is past it. Capacity is a tile control, not an Asana field -- this connector reports no per-person capacity, so every '% load', 'Over by N' and colour is measured against the number in the stepper (default 8). Three further limits, all read off the server source and confirmed live on 2026-11-12: get_team_workload counts incomplete tasks with limit 100 and no pagination, so anyone past 100 active tasks reads as exactly 100 (the tile's footnote says so when it happens); the member list is the first member_limit users /users returns for the workspace, not a curated team, so it can include people with no tasks and omit people who have them; and the response is one number per person, with no due dates, projects or overdue split, so a member's load cannot be broken down any further. The reference design's vertical column chart is drawn as horizontal bars -- no system element has a settable height, and the capacity rule is the gap between the two bar tracks rather than a dashed overlay, which absolute positioning would be needed for.",
  "id": "asana-team-workload",
  "keywords": [
    "team workload",
    "asana team",
    "task distribution",
    "active tasks",
    "capacity",
    "over capacity",
    "workload balance"
  ],
  "popularity": 60,
  "sizing": {
    "max": {
      "colSpan": 8,
      "rowSpan": 12
    },
    "min": {
      "colSpan": 3,
      "rowSpan": 4
    },
    "preferred": {
      "colSpan": 5,
      "rowSpan": 6
    }
  },
  "spec": {
    "elements": {
