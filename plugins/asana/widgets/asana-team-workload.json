        "props": {
          "tone": {
            "$item": "tone"
          },
          "value": {
            "$item": "fill_pct"
          }
        },
        "type": "ProgressBar"
      },
      "barOver": {
        "props": {
          "tone": "destructive",
          "value": {
            "$item": "over_pct"
          }
        },
        "type": "ProgressBar"
      },
      "barRow": {
