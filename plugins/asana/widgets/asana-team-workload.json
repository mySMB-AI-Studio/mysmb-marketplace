          "barOver"
        ],
        "props": {
          "gap": "xs",
          "template": {
            "$state": "/ui/board/bar_template"
          }
        },
        "type": "Row"
      },
      "body": {
        "children": [
          "loading",
          "content"
        ],
        "props": {},
        "type": "Body"
      },
      "busiestCaption": {
        "props": {
          "text": {
            "$state": "/ui/board/busiest_label"
          },
          "tone": "muted"
        },
        "type": "Caption"
      },
      "capGroup": {
        "children": [
          "capLabel",
          "capMinus",
          "capValue",
          "capPlus"
        ],
        "props": {
          "align": "center",
          "gap": "xs"
        },
        "type": "Row"
      },
      "capLabel": {
        "props": {
          "text": "Capacity",
          "tone": "muted"
        },
        "type": "Caption"
      },
      "capMinus": {
        "on": {
          "click": {
            "action": "setState",
            "params": {
              "statePath": "/ui/cap",
              "value": {
                "$computed": "asana_step_capacity",
                "args": {
                  "delta": -1,
                  "value": {
                    "$state": "/ui/cap"
                  }
                }
              }
            }
          }
        },
        "props": {
          "ariaLabel": "Decrease capacity",
          "disabled": {
            "$state": "/ui/board/cap_at_min"
          },
          "icon": "Minus",
          "size": "sm",
          "tone": "muted",
          "variant": "outlined"
        },
        "type": "IconButton"
      },
      "capPlus": {
        "on": {
          "click": {
            "action": "setState",
            "params": {
              "statePath": "/ui/cap",
              "value": {
                "$computed": "asana_step_capacity",
                "args": {
                  "delta": 1,
                  "value": {
                    "$state": "/ui/cap"
                  }
                }
              }
            }
          }
        },
        "props": {
          "ariaLabel": "Increase capacity",
          "disabled": {
            "$state": "/ui/board/cap_at_max"
          },
          "icon": "Plus",
          "size": "sm",
          "tone": "muted",
          "variant": "outlined"
        },
        "type": "IconButton"
      },
      "capValue": {
        "props": {
          "size": "sm",
          "text": {
            "$state": "/ui/board/cap_value"
          },
          "weight": "medium"
        },
        "type": "Text"
      },
      "card": {
        "children": [
          "header",
          "body",
          "footnote",
          "footerDivider",
          "footerRow"
        ],
        "props": {},
        "type": "Card",
        "watch": {
          "/asana/get_team_workload/data": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/cap",
                "value": 8
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/sort",
                "value": "most"
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/board",
                "value": {
                  "$computed": "asana_flatten_workload_board",
                  "args": {
                    "cap": {
                      "$state": "/ui/cap"
                    },
                    "sort": {
                      "$state": "/ui/sort"
                    },
                    "value": {
                      "$state": "/asana/get_team_workload/data"
                    }
                  }
                }
              }
            }
          ],
          "/ui/cap": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/board",
                "value": {
                  "$computed": "asana_flatten_workload_board",
                  "args": {
                    "cap": {
                      "$state": "/ui/cap"
                    },
                    "sort": {
                      "$state": "/ui/sort"
                    },
                    "value": {
                      "$state": "/asana/get_team_workload/data"
                    }
                  }
                }
              }
            }
          ],
          "/ui/sort": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/board",
                "value": {
                  "$computed": "asana_flatten_workload_board",
                  "args": {
                    "cap": {
                      "$state": "/ui/cap"
                    },
                    "sort": {
                      "$state": "/ui/sort"
                    },
                    "value": {
                      "$state": "/asana/get_team_workload/data"
                    }
                  }
                }
              }
            }
          ]
        }
      },
