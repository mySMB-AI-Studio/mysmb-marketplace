          "empty",
          "hero",
          "controlsRow",
          "list",
          "legendRow"
        ],
        "props": {
          "gap": "md"
        },
        "type": "Stack",
        "visible": {
          "$state": "/_loading/asana.get_team_workload",
          "not": true
