{
  "id": "asana-my-tasks",
  "title": "My Tasks",
  "description": "Tasks assigned to you in Asana with due date labels and a due-today summary.",
  "category": "tasks",
  "tags": ["asana", "tasks", "my tasks", "due dates", "overdue"],
  "keywords": ["asana tasks", "my tasks", "due today", "overdue", "assigned tasks"],
  "connectorsUsed": ["asana"],
  "popularity": 70,
  "sizing": {
    "preferred": { "colSpan": 5, "rowSpan": 6 },
    "min": { "colSpan": 3, "rowSpan": 5 },
    "max": { "colSpan": 8, "rowSpan": 12 }
  },
  "dataProvider": {
    "mcp": "asana",
    "tool": "list_tasks",
    "params": { "assignee": "me", "completed_since": "now", "limit": 50 }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": ["header", "body"],
        "watch": {
          "/asana/list_tasks/data": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/rows",
                "value": {
                  "$computed": "asana_flatten_my_tasks",
                  "args": { "value": { "$state": "/asana/list_tasks/data" } }
                }
              }
            }
          ]
        }
      },

      "header": { "type": "Header", "props": {}, "children": ["titleStack"] },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "eyebrow"]
      },
      "title": { "type": "Heading", "props": { "text": "My Tasks", "level": "h2" } },
      "eyebrow": { "type": "Eyebrow", "props": { "text": "Asana" } },

      "body": { "type": "Body", "props": {}, "children": ["loading", "empty", "contentArea"] },

      "loading": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["sk1", "sk2", "sk3"],
        "visible": { "$state": "/_loading/asana.list_tasks" }
      },
      "sk1": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "sk2": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "sk3": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },

      "empty": {
        "type": "Empty",
        "props": { "message": "No tasks assigned to you." },
        "visible": {
          "$and": [
            { "$state": "/_loading/asana.list_tasks", "not": true },
            { "$state": "/ui/rows/0", "not": true }
          ]
        }
      },

      "contentArea": {
        "type": "Stack",
        "props": { "gap": "sm", "pt": "sm" },
        "children": ["taskList", "taskFooter"],
        "visible": {
          "$and": [
            { "$state": "/_loading/asana.list_tasks", "not": true },
            { "$state": "/ui/rows/0" }
          ]
        }
      },

      "taskList": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["taskRow"],
        "repeat": { "statePath": "/ui/rows", "key": "id" }
      },

      "taskRow": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["taskCircle", "taskInfo", "taskDueBadge"]
      },
      "taskDivider": { "type": "Divider", "props": {} },
      "taskCircle": {
        "type": "Icon",
        "props": { "name": "Circle", "tone": { "$item": "circle_tone" }, "size": "sm" }
      },
      "taskInfo": {
        "type": "Stack",
        "props": { "gap": "none", "grow": true },
        "children": ["taskTitle", "taskProject"]
      },
      "taskTitle": {
        "type": "Text",
        "props": { "text": { "$item": "title" }, "size": "sm", "weight": "semibold", "truncate": true }
      },
      "taskProject": {
        "type": "Caption",
        "props": { "text": { "$item": "project_label" }, "tone": "muted", "truncate": true },
        "visible": { "$item": "project_label" }
      },
      "taskDueBadge": {
        "type": "Badge",
        "props": {
          "text": { "$item": "due_label" },
          "tone": { "$item": "due_tone" },
          "variant": "soft"
        },
        "visible": { "$item": "due_label" }
      },

      "taskFooter": {
        "type": "Caption",
        "props": { "text": { "$state": "/ui/rows/0/footer_label" }, "tone": "muted" },
        "visible": { "$state": "/ui/rows/0/footer_label" }
      }
    }
  },
  "status": "published"
}
