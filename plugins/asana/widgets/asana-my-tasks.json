{
  "category": "tasks",
  "connectorsUsed": [
    "asana"
  ],
  "dataProvider": {
    "kind": "tool",
    "mcp": "asana",
    "params": {
      "assignee": "me",
      "completed_since": "2026-01-01T00:00:00.000Z",
      "limit": 50
    },
    "tool": "list_tasks"
  },
  "description": "Tasks assigned to you in Asana, organised into Upcoming, Overdue, and Completed tabs.",
  "id": "asana-my-tasks",
  "keywords": [
    "asana tasks",
    "my tasks",
    "due today",
    "overdue",
    "assigned tasks"
  ],
  "popularity": 70,
  "sizing": {
    "max": {
      "colSpan": 8,
      "rowSpan": 12
    },
    "min": {
      "colSpan": 3,
      "rowSpan": 5
    },
    "preferred": {
      "colSpan": 5,
      "rowSpan": 7
    }
  },
  "spec": {
    "elements": {
      "card": {
        "children": [
          "headerRow",
          "div0",
          "loading",
          "tabRow",
          "upcomingContent",
          "overdueContent",
          "completedContent"
        ],
        "props": {},
        "type": "Card",
        "watch": {
          "/asana/list_tasks/data": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/data",
                "value": {
                  "$computed": "asana_flatten_my_tasks_tabs",
                  "args": {
                    "value": {
                      "$state": "/asana/list_tasks/data"
                    }
                  }
                }
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/tab/upcoming",
                "value": true
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/tab/overdue",
                "value": false
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/tab/completed",
                "value": false
              }
            }
          ]
        }
      },
      "completedContent": {
        "children": [
          "completedEmpty",
          "completedList"
        ],
        "props": {
          "gap": "sm"
        },
        "type": "Stack",
        "visible": {
          "$state": "/ui/tab/completed"
        }
      },
      "completedEmpty": {
        "props": {
          "message": "No recently completed tasks."
        },
        "type": "Empty",
        "visible": {
          "$state": "/ui/data/completed/0",
          "not": true
        }
      },
      "completedList": {
        "children": [
          "taskRow"
        ],
        "props": {
          "gap": "sm"
        },
        "repeat": {
          "key": "id",
          "statePath": "/ui/data/completed"
        },
        "type": "Stack"
      },
      "div0": {
        "props": {},
        "type": "Divider"
      },
      "eyebrow": {
        "props": {
          "text": "Asana"
        },
        "type": "Eyebrow"
      },
      "headerRow": {
        "children": [
          "titleGroup"
        ],
        "props": {
          "align": "center",
          "justify": "between"
        },
        "type": "Row"
      },
      "loading": {
        "children": [
          "sk1",
          "sk2",
          "sk3"
        ],
        "props": {
          "gap": "sm"
        },
        "type": "Stack",
        "visible": {
          "$state": "/_loading/asana.list_tasks"
        }
      },
      "overdueContent": {
        "children": [
          "overdueEmpty",
          "overdueList"
        ],
        "props": {
          "gap": "sm"
        },
        "type": "Stack",
        "visible": {
          "$state": "/ui/tab/overdue"
        }
      },
      "overdueEmpty": {
        "props": {
          "message": "No overdue tasks."
        },
        "type": "Empty",
        "visible": {
          "$state": "/ui/data/overdue/0",
          "not": true
        }
      },
      "overdueList": {
        "children": [
          "taskRow"
        ],
        "props": {
          "gap": "sm"
        },
        "repeat": {
          "key": "id",
          "statePath": "/ui/data/overdue"
        },
        "type": "Stack"
      },
      "sk1": {
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "sk2": {
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "sk3": {
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "tabCompletedOff": {
        "on": {
          "click": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/tab/upcoming",
                "value": false
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/tab/overdue",
                "value": false
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/tab/completed",
                "value": true
              }
            }
          ]
        },
        "props": {
          "label": "Completed",
          "size": "sm",
          "variant": "ghost"
        },
        "type": "Button",
        "visible": {
          "$state": "/ui/tab/completed",
          "not": true
        }
      },
      "tabCompletedOn": {
        "props": {
          "label": "Completed",
          "size": "sm",
          "variant": "primary"
        },
        "type": "Button",
        "visible": {
          "$state": "/ui/tab/completed"
        }
      },
      "tabOverdueOff": {
        "on": {
          "click": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/tab/upcoming",
                "value": false
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/tab/overdue",
                "value": true
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/tab/completed",
                "value": false
              }
            }
          ]
        },
        "props": {
          "label": "Overdue",
          "size": "sm",
          "variant": "ghost"
        },
        "type": "Button",
        "visible": {
          "$state": "/ui/tab/overdue",
          "not": true
        }
      },
      "tabOverdueOn": {
        "props": {
          "label": "Overdue",
          "size": "sm",
          "variant": "primary"
        },
        "type": "Button",
        "visible": {
          "$state": "/ui/tab/overdue"
        }
      },
      "tabRow": {
        "children": [
          "tabUpcomingOn",
          "tabUpcomingOff",
          "tabOverdueOn",
          "tabOverdueOff",
          "tabCompletedOn",
          "tabCompletedOff"
        ],
        "props": {
          "gap": "xs"
        },
        "type": "Row",
        "visible": {
          "$state": "/_loading/asana.list_tasks",
          "not": true
        }
      },
      "tabUpcomingOff": {
        "on": {
          "click": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/tab/upcoming",
                "value": true
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/tab/overdue",
                "value": false
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/tab/completed",
                "value": false
              }
            }
          ]
        },
        "props": {
          "label": "Upcoming",
          "size": "sm",
          "variant": "ghost"
        },
        "type": "Button",
        "visible": {
          "$state": "/ui/tab/upcoming",
          "not": true
        }
      },
      "tabUpcomingOn": {
        "props": {
          "label": "Upcoming",
          "size": "sm",
          "variant": "primary"
        },
        "type": "Button",
        "visible": {
          "$state": "/ui/tab/upcoming"
        }
      },
      "taskCircle": {
        "props": {
          "name": "Circle",
          "size": "sm",
          "tone": {
            "$item": "circle_tone"
          }
        },
        "type": "Icon"
      },
      "taskDueBadge": {
        "props": {
          "text": {
            "$item": "due_label"
          },
          "tone": {
            "$item": "due_tone"
          },
          "variant": "soft"
        },
        "type": "Badge",
        "visible": {
          "$item": "due_label"
        }
      },
      "taskInfo": {
        "children": [
          "taskTitle",
          "taskProject"
        ],
        "props": {
          "gap": "none",
          "grow": true
        },
        "type": "Stack"
      },
      "taskProject": {
        "props": {
          "text": {
            "$item": "project_label"
          },
          "tone": "muted",
          "truncate": true
        },
        "type": "Caption",
        "visible": {
          "$item": "project_label"
        }
      },
      "taskRow": {
        "children": [
          "taskCircle",
          "taskInfo",
          "taskDueBadge"
        ],
        "props": {
          "align": "center",
          "gap": "sm"
        },
        "type": "Row"
      },
      "taskTitle": {
        "props": {
          "size": "sm",
          "text": {
            "$item": "title"
          },
          "truncate": true,
          "weight": "semibold"
        },
        "type": "Text"
      },
      "title": {
        "props": {
          "level": "h2",
          "text": "My Tasks"
        },
        "type": "Heading"
      },
      "titleGroup": {
        "children": [
          "titleIcon",
          "titleStack"
        ],
        "props": {
          "align": "center",
          "gap": "sm"
        },
        "type": "Row"
      },
      "titleIcon": {
        "props": {
          "name": "SquareCheck",
          "size": "sm",
          "tone": "info"
        },
        "type": "Icon"
      },
      "titleStack": {
        "children": [
          "title",
          "eyebrow"
        ],
        "props": {
          "gap": "none"
        },
        "type": "Stack"
      },
      "upcomingContent": {
        "children": [
          "upcomingEmpty",
          "upcomingList"
        ],
        "props": {
          "gap": "sm"
        },
        "type": "Stack",
        "visible": {
          "$state": "/ui/tab/upcoming"
        }
      },
      "upcomingEmpty": {
        "props": {
          "message": "No upcoming tasks."
        },
        "type": "Empty",
        "visible": {
          "$state": "/ui/data/upcoming/0",
          "not": true
        }
      },
      "upcomingList": {
        "children": [
          "taskRow"
        ],
        "props": {
          "gap": "sm"
        },
        "repeat": {
          "key": "id",
          "statePath": "/ui/data/upcoming"
        },
        "type": "Stack"
      }
    },
    "root": "card"
  },
  "tags": [
    "asana",
    "tasks",
    "my tasks",
    "due dates",
    "overdue"
  ],
  "title": "My Tasks"
}
