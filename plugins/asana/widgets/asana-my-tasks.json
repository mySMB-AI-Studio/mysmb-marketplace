{
  "category": "tasks",
  "connectorsUsed": [
    "asana"
  ],
  "dataProvider": {
    "kind": "tool",
    "mcp": "asana",
    "params": {
      "assignee": "me",
      "completed_since": "$days_ago_30",
      "limit": 100
    },
    "tool": "list_tasks"
  },
  "description": "Your Asana tasks across Overdue, Upcoming and Completed, grouped by how close the due date is, filterable by project, with one-tap complete.",
  "id": "asana-my-tasks",
  "keywords": [
    "asana tasks",
    "my tasks",
    "due today",
    "overdue",
    "assigned tasks",
    "complete task",
    "task list"
  ],
  "popularity": 70,
  "sizing": {
    "max": {
      "colSpan": 8,
      "rowSpan": 12
    },
    "min": {
      "colSpan": 3,
      "rowSpan": 5
    },
    "preferred": {
      "colSpan": 5,
      "rowSpan": 7
    }
  },
  "spec": {
    "elements": {
      "body": {
        "children": [
          "loading",
          "tabs",
          "chipsRow",
          "empty",
          "list"
        ],
        "props": {},
        "type": "Body"
      },
      "card": {
        "children": [
          "header",
          "body",
          "footerDivider",
          "footerRow"
        ],
        "props": {},
        "type": "Card",
        "watch": {
          "/asana/list_tasks/data": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/project",
                "value": "All"
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/tab",
                "value": "overdue"
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/board",
                "value": {
                  "$computed": "asana_flatten_my_tasks_board",
                  "args": {
                    "project": {
                      "$state": "/ui/project"
                    },
                    "tab": {
                      "$state": "/ui/tab"
                    },
                    "value": {
                      "$state": "/asana/list_tasks/data"
                    }
                  }
                }
              }
            }
          ],
          "/ui/project": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/board",
                "value": {
                  "$computed": "asana_flatten_my_tasks_board",
                  "args": {
                    "project": {
                      "$state": "/ui/project"
                    },
                    "tab": {
                      "$state": "/ui/tab"
                    },
                    "value": {
                      "$state": "/asana/list_tasks/data"
                    }
                  }
                }
              }
            }
          ],
          "/ui/tab": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/board",
                "value": {
                  "$computed": "asana_flatten_my_tasks_board",
                  "args": {
                    "project": {
                      "$state": "/ui/project"
                    },
                    "tab": {
                      "$state": "/ui/tab"
                    },
                    "value": {
                      "$state": "/asana/list_tasks/data"
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "chipAll": {
        "children": [
          "chipAllLabel",
          "chipAllCount"
        ],
        "on": {
          "click": {
            "action": "setState",
            "params": {
              "statePath": "/ui/project",
              "value": "All"
            }
          }
        },
        "props": {
          "align": "center",
          "clickable": true,
          "gap": "xs",
          "padded": true,
          "selected": {
            "$state": "/ui/board/all_selected"
          }
        },
        "type": "Row"
      },
      "chipAllCount": {
        "props": {
          "text": {
            "$state": "/ui/board/all_count"
          },
          "tone": "muted"
        },
        "type": "Caption"
      },
      "chipAllLabel": {
        "props": {
          "text": "All",
          "weight": "medium"
        },
        "type": "Caption"
      },
      "chipCount": {
        "props": {
          "text": {
            "$item": "count"
          },
          "tone": "muted"
        },
        "type": "Caption"
      },
      "chipDot": {
        "props": {
          "size": "xs",
          "tone": {
            "$item": "tone"
          }
        },
        "type": "Dot"
      },
      "chipLabel": {
        "props": {
          "size": "xs",
          "text": {
            "$item": "label"
          },
          "truncate": true,
          "weight": "medium"
        },
        "type": "Text"
      },
      "chipProject": {
        "children": [
          "chipDot",
          "chipLabel",
          "chipCount"
        ],
        "on": {
          "click": {
            "action": "setState",
            "params": {
              "statePath": "/ui/project",
              "value": {
                "$computed": "identity",
                "args": {
                  "value": {
                    "$item": "label"
                  }
                }
              }
            }
          }
        },
        "props": {
          "align": "center",
          "clickable": true,
          "gap": "xs",
          "padded": true,
          "selected": {
            "$item": "selected"
          }
        },
        "repeat": {
          "key": "id",
          "statePath": "/ui/board/projects"
        },
        "type": "Row"
      },
      "chipsRow": {
        "children": [
          "chipAll",
          "chipProject"
        ],
        "props": {
          "align": "center",
          "gap": "xs"
        },
        "type": "Row",
        "visible": {
          "$state": "/ui/board/show_projects"
        }
      },
      "empty": {
        "props": {
          "message": {
            "$state": "/ui/board/empty_message"
          }
        },
        "type": "Empty",
        "visible": {
          "$and": [
            {
              "$state": "/_loading/asana.list_tasks",
              "not": true
            },
            {
              "$state": "/ui/board/has_rows",
              "not": true
            }
          ]
        }
      },
      "eyebrow": {
        "props": {
          "text": {
            "$state": "/ui/board/header_label"
          }
        },
        "type": "Eyebrow"
      },
      "footerDivider": {
        "props": {},
        "type": "Divider"
      },
      "footerLabel": {
        "props": {
          "text": {
            "$state": "/ui/board/footer_label"
          }
        },
        "type": "Caption",
        "visible": {
          "$state": "/ui/board/footer_label"
        }
      },
      "footerRow": {
        "children": [
          "footerLabel",
          "openInAsanaBtn"
        ],
        "props": {
          "align": "center",
          "justify": "between"
        },
        "type": "Row"
      },
      "groupCount": {
        "props": {
          "text": {
            "$item": "group_count"
          },
          "tone": "muted"
        },
        "type": "Caption"
      },
      "groupHeader": {
        "children": [
          "groupLabel",
          "groupCount"
        ],
        "props": {
          "align": "center",
          "gap": "xs"
        },
        "type": "Row",
        "visible": {
          "$item": "show_group"
        }
      },
      "groupLabel": {
        "props": {
          "text": {
            "$item": "group_label"
          },
          "tone": {
            "$item": "group_tone"
          },
          "weight": "medium"
        },
        "type": "Caption"
      },
      "header": {
        "children": [
          "titleGroup"
        ],
        "props": {},
        "type": "Header"
      },
      "list": {
        "children": [
          "groupHeader",
          "taskRow"
        ],
        "props": {
          "gap": "xs"
        },
        "repeat": {
          "key": "id",
          "statePath": "/ui/board/rows"
        },
        "type": "Stack",
        "visible": {
          "$and": [
            {
              "$state": "/_loading/asana.list_tasks",
              "not": true
            },
            {
              "$state": "/ui/board/has_rows"
            }
          ]
        }
      },
      "loading": {
        "children": [
          "sk1",
          "sk2",
          "sk3"
        ],
        "props": {
          "gap": "sm"
        },
        "type": "Stack",
        "visible": {
          "$state": "/_loading/asana.list_tasks"
        }
      },
      "openInAsanaBtn": {
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "target": "_blank",
              "url": "https://app.asana.com/"
            }
          }
        },
        "props": {
          "label": "Open Asana",
          "size": "sm",
          "tone": "brand",
          "variant": "primary"
        },
        "type": "Button"
      },
      "sk1": {
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "sk2": {
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "sk3": {
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "tabCompleted": {
        "children": [
          "tabCompletedStack"
        ],
        "on": {
          "click": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/project",
                "value": "All"
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/tab",
                "value": "completed"
              }
            }
          ]
        },
        "props": {
          "clickable": true,
          "justify": "center",
          "padded": true,
          "selected": {
            "$state": "/ui/board/tab_completed_selected"
          }
        },
        "type": "Row"
      },
      "tabCompletedLabel": {
        "props": {
          "text": "Completed",
          "tone": "success",
          "weight": "medium"
        },
        "type": "Caption"
      },
      "tabCompletedStack": {
        "children": [
          "tabCompletedValue",
          "tabCompletedLabel"
        ],
        "props": {
          "align": "center",
          "gap": "none"
        },
        "type": "Stack"
      },
      "tabCompletedValue": {
        "props": {
          "size": "sm",
          "value": {
            "$state": "/ui/board/completed_count"
          }
        },
        "type": "Stat"
      },
      "tabOverdue": {
        "children": [
          "tabOverdueStack"
        ],
        "on": {
          "click": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/project",
                "value": "All"
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/tab",
                "value": "overdue"
              }
            }
          ]
        },
        "props": {
          "clickable": true,
          "justify": "center",
          "padded": true,
          "selected": {
            "$state": "/ui/board/tab_overdue_selected"
          }
        },
        "type": "Row"
      },
      "tabOverdueLabel": {
        "props": {
          "text": "Overdue",
          "tone": "destructive",
          "weight": "medium"
        },
        "type": "Caption"
      },
      "tabOverdueStack": {
        "children": [
          "tabOverdueValue",
          "tabOverdueLabel"
        ],
        "props": {
          "align": "center",
          "gap": "none"
        },
        "type": "Stack"
      },
      "tabOverdueValue": {
        "props": {
          "size": "sm",
          "value": {
            "$state": "/ui/board/overdue_count"
          }
        },
        "type": "Stat"
      },
      "tabUpcoming": {
        "children": [
          "tabUpcomingStack"
        ],
        "on": {
          "click": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/project",
                "value": "All"
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/tab",
                "value": "upcoming"
              }
            }
          ]
        },
        "props": {
          "clickable": true,
          "justify": "center",
          "padded": true,
          "selected": {
            "$state": "/ui/board/tab_upcoming_selected"
          }
        },
        "type": "Row"
      },
      "tabUpcomingLabel": {
        "props": {
          "text": "Upcoming",
          "tone": "muted",
          "weight": "medium"
        },
        "type": "Caption"
      },
      "tabUpcomingStack": {
        "children": [
          "tabUpcomingValue",
          "tabUpcomingLabel"
        ],
        "props": {
          "align": "center",
          "gap": "none"
        },
        "type": "Stack"
      },
      "tabUpcomingValue": {
        "props": {
          "size": "sm",
          "value": {
            "$state": "/ui/board/upcoming_count"
          }
        },
        "type": "Stat"
      },
      "tabs": {
        "children": [
          "tabOverdue",
          "tabUpcoming",
          "tabCompleted"
        ],
        "props": {
          "cols": 3,
          "gap": "sm"
        },
        "type": "Grid",
        "visible": {
          "$state": "/_loading/asana.list_tasks",
          "not": true
        }
      },
      "taskCircle": {
        "on": {
          "click": [
            {
              "action": "asana.complete_task",
              "params": {
                "completed": {
                  "$computed": "identity",
                  "args": {
                    "value": {
                      "$item": "complete_to"
                    }
                  }
                },
                "task_gid": {
                  "$computed": "identity",
                  "args": {
                    "value": {
                      "$item": "id"
                    }
                  }
                }
              }
            },
            {
              "action": "bust_tool_cache",
              "params": {
                "mcp": "asana",
                "tool": "list_tasks"
              }
            },
            {
              "action": "asana.list_tasks",
              "params": {
                "assignee": "me",
                "completed_since": "$days_ago_30",
                "limit": 100
              }
            }
          ]
        },
        "props": {
          "ariaLabel": {
            "$item": "circle_label"
          },
          "icon": {
            "$item": "circle_icon"
          },
          "size": "sm",
          "tone": {
            "$item": "circle_tone"
          }
        },
        "type": "IconButton"
      },
      "taskDue": {
        "props": {
          "text": {
            "$item": "due_label"
          },
          "tone": {
            "$item": "due_tone"
          },
          "variant": "soft"
        },
        "type": "Badge"
      },
      "taskMain": {
        "children": [
          "taskTitle",
          "taskProjectRow"
        ],
        "props": {
          "gap": "none",
          "grow": true
        },
        "type": "Stack"
      },
      "taskProject": {
        "props": {
          "size": "xs",
          "text": {
            "$item": "project_label"
          },
          "tone": "muted",
          "truncate": true
        },
        "type": "Text"
      },
      "taskProjectDot": {
        "props": {
          "size": "xs",
          "tone": {
            "$item": "project_tone"
          }
        },
        "type": "Dot"
      },
      "taskProjectRow": {
        "children": [
          "taskProjectDot",
          "taskProject"
        ],
        "props": {
          "align": "center",
          "gap": "xs"
        },
        "type": "Row",
        "visible": {
          "$item": "show_project"
        }
      },
      "taskRow": {
        "children": [
          "taskCircle",
          "taskMain",
          "taskDue"
        ],
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "target": "_blank",
              "url": {
                "$computed": "identity",
                "args": {
                  "value": {
                    "$item": "url"
                  }
                }
              }
            }
          }
        },
        "props": {
          "align": "center",
          "clickable": {
            "$item": "has_url"
          },
          "gap": "sm",
          "hover": true
        },
        "type": "Row"
      },
      "taskTitle": {
        "props": {
          "size": "sm",
          "text": {
            "$item": "title"
          },
          "tone": {
            "$item": "title_tone"
          },
          "truncate": true,
          "weight": "medium"
        },
        "type": "Text"
      },
      "title": {
        "props": {
          "level": "h2",
          "text": "My Tasks"
        },
        "type": "Heading"
      },
      "titleGroup": {
        "children": [
          "titleIcon",
          "titleStack"
        ],
        "props": {
          "align": "center",
          "gap": "sm"
        },
        "type": "Row"
      },
      "titleIcon": {
        "props": {
          "name": "SquareCheck",
          "size": "sm",
          "tone": "brand"
        },
        "type": "Icon"
      },
      "titleStack": {
        "children": [
          "title",
          "eyebrow"
        ],
        "props": {
          "gap": "none"
        },
        "type": "Stack"
      }
    },
    "root": "card"
  },
  "tags": [
    "asana",
    "tasks",
    "my tasks",
    "due dates",
    "overdue"
  ],
  "title": "My Tasks"
}
