{
  "id": "asana-my-tasks",
  "title": "My Tasks",
  "description": "Tasks assigned to the current user in Asana, with due dates and project labels.",
  "category": "tasks",
  "tags": ["asana", "tasks", "my tasks", "due dates"],
  "keywords": ["asana tasks", "my tasks", "due dates", "overdue", "assigned tasks"],
  "connectorsUsed": ["asana"],
  "popularity": 70,
  "sizing": {
    "preferred": { "colSpan": 5, "rowSpan": 6 },
    "min": { "colSpan": 4, "rowSpan": 5 },
    "max": { "colSpan": 8, "rowSpan": 10 }
  },
  "dataProvider": {
    "mcp": "asana",
    "tool": "list_tasks",
    "params": { "assignee": "me", "completed": false, "limit": 50 }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": ["header", "body"],
        "watch": {
          "/asana/list_tasks/data": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/rows",
                "value": {
                  "$computed": "asana_flatten_my_tasks",
                  "args": { "value": { "$state": "/asana/list_tasks/data" } }
                }
              }
            }
          ]
        }
      },

      "header": { "type": "Header", "props": {}, "children": ["titleStack"] },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "eyebrow"]
      },
      "title": { "type": "Heading", "props": { "text": "My Tasks", "level": "h2" } },
      "eyebrow": { "type": "Eyebrow", "props": { "text": "Asana" } },

      "body": { "type": "Body", "props": {}, "children": ["loading", "empty", "contentArea"] },

      "loading": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["sk1", "sk2", "sk3"],
        "visible": { "$state": "/_loading/asana.list_tasks" }
      },
      "sk1": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "sk2": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "sk3": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },

      "empty": {
        "type": "Empty",
        "props": { "message": "No tasks assigned to you." },
        "visible": {
          "$and": [
            { "$state": "/_loading/asana.list_tasks", "not": true },
            { "$state": "/ui/rows/0", "not": true }
          ]
        }
      },

      "contentArea": {
        "type": "Stack",
        "props": { "gap": "md" },
        "children": ["statsRow", "taskList"],
        "visible": {
          "$and": [
            { "$state": "/_loading/asana.list_tasks", "not": true },
            { "$state": "/ui/rows/0" }
          ]
        }
      },

      "statsRow": {
        "type": "Row",
        "props": { "gap": "sm", "template": "1fr 1fr 1fr" },
        "children": ["statTotalWrap", "statOverdueWrap", "statDueTodayWrap"]
      },

      "statTotalWrap": { "type": "Stack", "props": { "gap": "none" }, "children": ["statTotal"] },
      "statTotal": {
        "type": "Section",
        "props": { "variant": "muted", "padding": "sm" },
        "children": ["statTotalNum", "statTotalLabel"]
      },
      "statTotalNum": {
        "type": "Heading",
        "props": { "text": { "$state": "/ui/rows/0/stat_total" }, "level": "h2" }
      },
      "statTotalLabel": { "type": "Caption", "props": { "text": "Total Tasks" } },

      "statOverdueWrap": { "type": "Stack", "props": { "gap": "none" }, "children": ["statOverdue"] },
      "statOverdue": {
        "type": "Section",
        "props": { "variant": "muted", "padding": "sm" },
        "children": ["statOverdueNum", "statOverdueLabel"]
      },
      "statOverdueNum": {
        "type": "Heading",
        "props": { "text": { "$state": "/ui/rows/0/stat_overdue" }, "level": "h2", "tone": "danger" }
      },
      "statOverdueLabel": { "type": "Caption", "props": { "text": "Overdue" } },

      "statDueTodayWrap": { "type": "Stack", "props": { "gap": "none" }, "children": ["statDueToday"] },
      "statDueToday": {
        "type": "Section",
        "props": { "variant": "muted", "padding": "sm" },
        "children": ["statDueTodayNum", "statDueTodayLabel"]
      },
      "statDueTodayNum": {
        "type": "Heading",
        "props": { "text": { "$state": "/ui/rows/0/stat_due_today" }, "level": "h2", "tone": "warning" }
      },
      "statDueTodayLabel": { "type": "Caption", "props": { "text": "Due Today" } },

      "taskList": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["taskRow"],
        "repeat": { "statePath": "/ui/rows", "key": "id" }
      },

      "taskRow": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["taskRowContent", "taskDivider"]
      },
      "taskRowContent": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["taskInfo", "taskDueBadge"]
      },
      "taskInfo": {
        "type": "Stack",
        "props": { "gap": "none", "grow": true },
        "children": ["taskTitle", "taskProject"]
      },
      "taskTitle": {
        "type": "Text",
        "props": { "text": { "$item": "title" }, "size": "sm", "weight": "semibold", "truncate": true }
      },
      "taskProject": {
        "type": "Caption",
        "props": { "text": { "$item": "project_label" }, "tone": "muted", "truncate": true },
        "visible": { "$item": "project_label" }
      },
      "taskDueBadge": {
        "type": "Badge",
        "props": {
          "text": { "$item": "due_label" },
          "tone": { "$item": "due_tone" },
          "variant": "soft"
        }
      },
      "taskDivider": { "type": "Divider", "props": {} }
    }
  },
  "status": "published"
}
