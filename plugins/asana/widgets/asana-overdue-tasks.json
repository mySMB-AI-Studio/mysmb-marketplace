{
  "category": "tasks",
  "connectorsUsed": [
    "asana"
  ],
  "dataProvider": {
    "kind": "tool",
    "mcp": "asana",
    "params": {
      "assignee": "me",
      "completed_since": "now",
      "limit": 100
    },
    "tool": "list_tasks"
  },
  "description": "Your overdue Asana tasks, with how late each one is, a severity breakdown, filters by age bucket, grouping by age or project, and one-tap complete.",
  "id": "asana-overdue-tasks",
  "keywords": [
    "asana overdue",
    "overdue tasks",
    "past due",
    "late tasks",
    "asana"
  ],
  "popularity": 65,
  "sizing": {
    "max": {
      "colSpan": 8,
      "rowSpan": 12
    },
    "min": {
      "colSpan": 3,
      "rowSpan": 5
    },
    "preferred": {
      "colSpan": 5,
      "rowSpan": 7
    }
  },
  "spec": {
    "elements": {
      "barSegment": {
        "props": {
          "tone": {
            "$item": "tone"
          },
          "value": 100
        },
        "type": "ProgressBar"
      },
      "body": {
        "children": [
          "loading",
          "content"
        ],
        "props": {},
        "type": "Body"
      },
      "card": {
        "children": [
          "header",
          "body",
          "footerDivider",
          "footerRow"
        ],
        "props": {},
        "type": "Card",
        "watch": {
          "/asana/list_tasks/data": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/bucket",
                "value": "all"
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/group",
                "value": "age"
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/board",
                "value": {
                  "$computed": "asana_flatten_overdue_board",
                  "args": {
                    "bucket": {
                      "$state": "/ui/bucket"
                    },
                    "group": {
                      "$state": "/ui/group"
                    },
                    "value": {
                      "$state": "/asana/list_tasks/data"
                    }
                  }
                }
              }
            }
          ],
          "/ui/bucket": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/board",
                "value": {
                  "$computed": "asana_flatten_overdue_board",
                  "args": {
                    "bucket": {
                      "$state": "/ui/bucket"
                    },
                    "group": {
                      "$state": "/ui/group"
                    },
                    "value": {
                      "$state": "/asana/list_tasks/data"
                    }
                  }
                }
              }
            }
          ],
          "/ui/group": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/board",
                "value": {
                  "$computed": "asana_flatten_overdue_board",
                  "args": {
                    "bucket": {
                      "$state": "/ui/bucket"
                    },
                    "group": {
                      "$state": "/ui/group"
                    },
                    "value": {
                      "$state": "/asana/list_tasks/data"
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "chipItem": {
        "children": [
          "chipOn",
          "chipOff"
        ],
        "on": {
          "click": {
            "action": "setState",
            "params": {
              "statePath": "/ui/bucket",
              "value": {
                "$computed": "identity",
                "args": {
                  "value": {
                    "$item": "bucket"
                  }
                }
              }
            }
          }
        },
        "props": {
          "align": "center",
          "clickable": true
        },
        "type": "Row"
      },
      "chipOff": {
        "props": {
          "text": {
            "$item": "chip_text"
          },
          "tone": {
            "$item": "tone"
          },
          "variant": "outline"
        },
        "type": "Badge",
        "visible": {
          "$item": "selected",
          "not": true
        }
      },
      "chipOn": {
        "props": {
          "text": {
            "$item": "chip_text"
          },
          "tone": {
            "$item": "tone"
          },
          "variant": "soft"
        },
        "type": "Badge",
        "visible": {
          "$item": "selected"
        }
      },
      "chipsRow": {
        "children": [
          "chipItem"
        ],
        "props": {
          "align": "center",
          "gap": "xs"
        },
        "repeat": {
          "key": "id",
          "statePath": "/ui/board/chips"
        },
        "type": "Row"
      },
      "content": {
        "children": [
          "empty",
          "kpiGrid",
          "severityBar",
          "controlsRow",
          "list"
        ],
        "props": {
          "gap": "md"
        },
        "type": "Stack",
        "visible": {
          "$state": "/_loading/asana.list_tasks",
          "not": true
        }
      },
      "controlsRow": {
        "children": [
          "chipsRow",
          "groupToggle"
        ],
        "props": {
          "align": "center",
          "gap": "sm",
          "justify": "between"
        },
        "type": "Row",
        "visible": {
          "$state": "/ui/board/show_chips"
        }
      },
      "dueBadge": {
        "props": {
          "text": {
            "$item": "due_label"
          },
          "tone": {
            "$item": "sev_tone"
          },
          "variant": "soft"
        },
        "type": "Badge"
      },
      "empty": {
        "props": {
          "message": {
            "$state": "/ui/board/empty_message"
          }
        },
        "type": "Empty",
        "visible": {
          "$state": "/ui/board/has_tasks",
          "not": true
        }
      },
      "eyebrow": {
        "props": {
          "text": {
            "$state": "/ui/board/header_label"
          }
        },
        "type": "Eyebrow"
      },
      "footerDivider": {
        "props": {},
        "type": "Divider"
      },
      "footerLabel": {
        "props": {
          "text": {
            "$state": "/ui/board/footer_label"
          }
        },
        "type": "Caption",
        "visible": {
          "$state": "/ui/board/has_tasks"
        }
      },
      "footerRow": {
        "children": [
          "footerLabel",
          "openInAsanaBtn"
        ],
        "props": {
          "align": "center",
          "justify": "between"
        },
        "type": "Row"
      },
      "groupCount": {
        "props": {
          "text": {
            "$item": "group_count"
          },
          "tone": "muted"
        },
        "type": "Caption"
      },
      "groupDot": {
        "props": {
          "size": "xs",
          "tone": {
            "$item": "group_dot_tone"
          }
        },
        "type": "Dot",
        "visible": {
          "$item": "show_group_dot"
        }
      },
      "groupHeader": {
        "children": [
          "groupDot",
          "groupLabel",
          "groupCount",
          "groupMeta"
        ],
        "props": {
          "align": "center",
          "gap": "xs"
        },
        "type": "Row",
        "visible": {
          "$item": "show_group"
        }
      },
      "groupLabel": {
        "props": {
          "text": {
            "$item": "group_label"
          },
          "tone": {
            "$item": "group_tone"
          }
        },
        "type": "Caption"
      },
      "groupMeta": {
        "props": {
          "text": {
            "$item": "group_meta"
          },
          "tone": "muted"
        },
        "type": "Caption",
        "visible": {
          "$item": "show_group_meta"
        }
      },
      "groupToggle": {
        "children": [
          "groupToggleAge",
          "groupToggleProject"
        ],
        "props": {
          "align": "center"
        },
        "type": "Row"
      },
      "groupToggleAge": {
        "children": [
          "groupToggleAgeBadge"
        ],
        "on": {
          "click": {
            "action": "setState",
            "params": {
              "statePath": "/ui/group",
              "value": "project"
            }
          }
        },
        "props": {
          "align": "center",
          "clickable": true
        },
        "type": "Row",
        "visible": {
          "$state": "/ui/board/group_age_selected"
        }
      },
      "groupToggleAgeBadge": {
        "props": {
          "text": "Group: Age",
          "tone": "default",
          "variant": "outline"
        },
        "type": "Badge"
      },
      "groupToggleProject": {
        "children": [
          "groupToggleProjectBadge"
        ],
        "on": {
          "click": {
            "action": "setState",
            "params": {
              "statePath": "/ui/group",
              "value": "age"
            }
          }
        },
        "props": {
          "align": "center",
          "clickable": true
        },
        "type": "Row",
        "visible": {
          "$state": "/ui/board/group_project_selected"
        }
      },
      "groupToggleProjectBadge": {
        "props": {
          "text": "Group: Project",
          "tone": "default",
          "variant": "outline"
        },
        "type": "Badge"
      },
      "header": {
        "children": [
          "titleGroup"
        ],
        "props": {},
        "type": "Header"
      },
      "kpiGrid": {
        "children": [
          "kpiOverdue",
          "kpiProjects",
          "kpiLongest"
        ],
        "props": {
          "cols": 3,
          "gap": "sm"
        },
        "type": "Grid",
        "visible": {
          "$state": "/ui/board/has_tasks"
        }
      },
      "kpiLongest": {
        "children": [
          "stackLongest"
        ],
        "props": {
          "variant": "muted"
        },
        "type": "Section"
      },
      "kpiOverdue": {
        "children": [
          "stackOverdue"
        ],
        "props": {
          "variant": "muted"
        },
        "type": "Section"
      },
      "kpiProjects": {
        "children": [
          "stackProjects"
        ],
        "props": {
          "variant": "muted"
        },
        "type": "Section"
      },
      "lblLongest": {
        "props": {
          "text": "Longest",
          "tone": "warning"
        },
        "type": "Caption"
      },
      "lblOverdue": {
        "props": {
          "text": "Overdue",
          "tone": "destructive"
        },
        "type": "Caption"
      },
      "lblProjects": {
        "props": {
          "text": "Projects",
          "tone": "muted"
        },
        "type": "Caption"
      },
      "list": {
        "children": [
          "groupHeader",
          "taskRow"
        ],
        "props": {
          "gap": "sm"
        },
        "repeat": {
          "key": "id",
          "statePath": "/ui/board/rows"
        },
        "type": "Stack",
        "visible": {
          "$state": "/ui/board/has_rows"
        }
      },
      "loading": {
        "children": [
          "sk1",
          "sk2",
          "sk3"
        ],
        "props": {
          "gap": "sm"
        },
        "type": "Stack",
        "visible": {
          "$state": "/_loading/asana.list_tasks"
        }
      },
      "openInAsanaBtn": {
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "target": "_blank",
              "url": "https://app.asana.com/"
            }
          }
        },
        "props": {
          "label": "Open in Asana",
          "size": "sm",
          "tone": "brand",
          "variant": "primary"
        },
        "type": "Button"
      },
      "severityBar": {
        "children": [
          "barSegment"
        ],
        "props": {
          "gap": "xs",
          "template": {
            "$state": "/ui/board/bar_template"
          }
        },
        "repeat": {
          "key": "id",
          "statePath": "/ui/board/segments"
        },
        "type": "Row",
        "visible": {
          "$state": "/ui/board/has_tasks"
        }
      },
      "sk1": {
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "sk2": {
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "sk3": {
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "stackLongest": {
        "children": [
          "valLongest",
          "lblLongest"
        ],
        "props": {
          "align": "center",
          "gap": "none"
        },
        "type": "Stack"
      },
      "stackOverdue": {
        "children": [
          "valOverdue",
          "lblOverdue"
        ],
        "props": {
          "align": "center",
          "gap": "none"
        },
        "type": "Stack"
      },
      "stackProjects": {
        "children": [
          "valProjects",
          "lblProjects"
        ],
        "props": {
          "align": "center",
          "gap": "none"
        },
        "type": "Stack"
      },
      "subProjectDot": {
        "props": {
          "size": "xs",
          "tone": {
            "$item": "project_tone"
          }
        },
        "type": "Dot",
        "visible": {
          "$item": "show_project"
        }
      },
      "subRow": {
        "children": [
          "subProjectDot",
          "subTextWrap"
        ],
        "props": {
          "align": "center",
          "gap": "xs"
        },
        "type": "Row"
      },
      "subText": {
        "props": {
          "size": "xs",
          "text": {
            "$item": "sub_label"
          },
          "tone": "muted",
          "truncate": true
        },
        "type": "Text"
      },
      "subTextWrap": {
        "children": [
          "subText"
        ],
        "props": {
          "gap": "none",
          "grow": true
        },
        "type": "Stack"
      },
      "taskMain": {
        "children": [
          "taskTitle",
          "subRow"
        ],
        "props": {
          "gap": "xs",
          "grow": true
        },
        "type": "Stack"
      },
      "taskRow": {
        "children": [
          "taskSevDot",
          "taskMain",
          "dueBadge",
          "taskTick"
        ],
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "target": "_blank",
              "url": {
                "$computed": "identity",
                "args": {
                  "value": {
                    "$item": "url"
                  }
                }
              }
            }
          }
        },
        "props": {
          "align": "center",
          "clickable": {
            "$item": "has_url"
          },
          "gap": "sm",
          "hover": true,
          "template": "auto 1fr auto auto"
        },
        "type": "Row"
      },
      "taskSevDot": {
        "props": {
          "size": "sm",
          "tone": {
            "$item": "sev_tone"
          }
        },
        "type": "Dot"
      },
      "taskTick": {
        "on": {
          "click": [
            {
              "action": "asana.complete_task",
              "params": {
                "completed": true,
                "task_gid": {
                  "$computed": "identity",
                  "args": {
                    "value": {
                      "$item": "id"
                    }
                  }
                }
              }
            },
            {
              "action": "bust_tool_cache",
              "params": {
                "mcp": "asana",
                "tool": "list_tasks"
              }
            },
            {
              "action": "asana.list_tasks",
              "params": {
                "assignee": "me",
                "completed_since": "now",
                "limit": 100
              }
            }
          ]
        },
        "props": {
          "ariaLabel": {
            "$item": "circle_label"
          },
          "icon": "Circle",
          "size": "md",
          "tone": "muted"
        },
        "type": "IconButton"
      },
      "taskTitle": {
        "props": {
          "size": "sm",
          "text": {
            "$item": "title"
          },
          "truncate": true,
          "weight": "medium"
        },
        "type": "Text"
      },
      "title": {
        "props": {
          "level": "h2",
          "text": "Overdue Tasks"
        },
        "type": "Heading"
      },
      "titleGroup": {
        "children": [
          "titleIcon",
          "titleStack"
        ],
        "props": {
          "align": "center",
          "gap": "sm"
        },
        "type": "Row"
      },
      "titleIcon": {
        "props": {
          "name": "TriangleAlert",
          "size": "sm",
          "tone": "destructive"
        },
        "type": "Icon"
      },
      "titleStack": {
        "children": [
          "title",
          "eyebrow"
        ],
        "props": {
          "gap": "none"
        },
        "type": "Stack"
      },
      "valLongest": {
        "props": {
          "size": "md",
          "value": {
            "$state": "/ui/board/stat_longest"
          }
        },
        "type": "Stat"
      },
      "valOverdue": {
        "props": {
          "size": "md",
          "value": {
            "$state": "/ui/board/stat_overdue"
          }
        },
        "type": "Stat"
      },
      "valProjects": {
        "props": {
          "size": "md",
          "value": {
            "$state": "/ui/board/stat_projects"
          }
        },
        "type": "Stat"
      }
    },
    "root": "card"
  },
  "tags": [
    "asana",
    "tasks",
    "overdue",
    "due dates",
    "at risk"
  ],
  "title": "Overdue Tasks"
}
