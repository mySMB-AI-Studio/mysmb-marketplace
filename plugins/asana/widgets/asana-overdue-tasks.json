{
  "category": "tasks",
  "connectorsUsed": [
    "asana"
  ],
  "dataProvider": {
    "kind": "tool",
    "mcp": "asana",
    "params": {
      "assignee": "me",
      "completed_since": "now",
      "limit": 50
    },
    "tool": "list_tasks"
  },
  "description": "Tasks assigned to you in Asana that are past their due date, with per-task overdue badges and summary stats.",
  "id": "asana-overdue-tasks",
  "keywords": [
    "asana overdue",
    "overdue tasks",
    "past due",
    "late tasks",
    "asana"
  ],
  "popularity": 65,
  "sizing": {
    "max": {
      "colSpan": 8,
      "rowSpan": 12
    },
    "min": {
      "colSpan": 3,
      "rowSpan": 4
    },
    "preferred": {
      "colSpan": 5,
      "rowSpan": 6
    }
  },
  "spec": {
    "elements": {
      "card": {
        "children": [
          "headerRow",
          "div0",
          "loading",
          "empty",
          "kpiGrid",
          "div1",
          "taskList"
        ],
        "props": {},
        "type": "Card",
        "watch": {
          "/asana/list_tasks/data": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/rows",
                "value": {
                  "$computed": "asana_flatten_overdue_tasks",
                  "args": {
                    "value": {
                      "$state": "/asana/list_tasks/data"
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "div0": {
        "props": {},
        "type": "Divider"
      },
      "div1": {
        "props": {},
        "type": "Divider",
        "visible": {
          "$and": [
            {
              "$state": "/_loading/asana.list_tasks",
              "not": true
            },
            {
              "$state": "/ui/rows/0"
            }
          ]
        }
      },
      "empty": {
        "props": {
          "message": "No overdue tasks. You're all caught up!"
        },
        "type": "Empty",
        "visible": {
          "$and": [
            {
              "$state": "/_loading/asana.list_tasks",
              "not": true
            },
            {
              "$state": "/ui/rows/0",
              "not": true
            }
          ]
        }
      },
      "eyebrow": {
        "props": {
          "text": "Asana"
        },
        "type": "Eyebrow"
      },
      "headerRow": {
        "children": [
          "titleGroup"
        ],
        "props": {
          "align": "center",
          "justify": "between"
        },
        "type": "Row"
      },
      "kpiGrid": {
        "children": [
          "tileOverdue",
          "tileProjects",
          "tileLongest"
        ],
        "props": {
          "cols": 3,
          "gap": "sm"
        },
        "type": "Grid",
        "visible": {
          "$and": [
            {
              "$state": "/_loading/asana.list_tasks",
              "not": true
            },
            {
              "$state": "/ui/rows/0"
            }
          ]
        }
      },
      "lblLongest": {
        "props": {
          "text": "Longest",
          "tone": "destructive"
        },
        "type": "Caption"
      },
      "lblOverdue": {
        "props": {
          "text": "Overdue",
          "tone": "destructive"
        },
        "type": "Caption"
      },
      "lblProjects": {
        "props": {
          "text": "Projects",
          "tone": "muted"
        },
        "type": "Caption"
      },
      "loading": {
        "children": [
          "sk1",
          "sk2",
          "sk3"
        ],
        "props": {
          "gap": "sm"
        },
        "type": "Stack",
        "visible": {
          "$state": "/_loading/asana.list_tasks"
        }
      },
      "sk1": {
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "sk2": {
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "sk3": {
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "stackLongest": {
        "children": [
          "valLongest",
          "lblLongest"
        ],
        "props": {
          "align": "center",
          "gap": "none"
        },
        "type": "Stack"
      },
      "stackOverdue": {
        "children": [
          "valOverdue",
          "lblOverdue"
        ],
        "props": {
          "align": "center",
          "gap": "none"
        },
        "type": "Stack"
      },
      "stackProjects": {
        "children": [
          "valProjects",
          "lblProjects"
        ],
        "props": {
          "align": "center",
          "gap": "none"
        },
        "type": "Stack"
      },
      "taskInfo": {
        "children": [
          "taskTitle",
          "taskProject"
        ],
        "props": {
          "gap": "none",
          "grow": true
        },
        "type": "Stack"
      },
      "taskList": {
        "children": [
          "taskRow"
        ],
        "props": {
          "gap": "sm"
        },
        "repeat": {
          "key": "id",
          "statePath": "/ui/rows"
        },
        "type": "Stack",
        "visible": {
          "$and": [
            {
              "$state": "/_loading/asana.list_tasks",
              "not": true
            },
            {
              "$state": "/ui/rows/0"
            }
          ]
        }
      },
      "taskOverdueBadge": {
        "props": {
          "text": {
            "$item": "overdue_label"
          },
          "tone": "destructive",
          "variant": "soft"
        },
        "type": "Badge"
      },
      "taskProject": {
        "props": {
          "text": {
            "$item": "project_label"
          },
          "tone": "muted",
          "truncate": true
        },
        "type": "Caption",
        "visible": {
          "$item": "project_label"
        }
      },
      "taskRow": {
        "children": [
          "taskInfo",
          "taskOverdueBadge"
        ],
        "props": {
          "align": "center",
          "gap": "sm"
        },
        "type": "Row"
      },
      "taskTitle": {
        "props": {
          "size": "sm",
          "text": {
            "$item": "title"
          },
          "truncate": true,
          "weight": "semibold"
        },
        "type": "Text"
      },
      "tileLongest": {
        "children": [
          "stackLongest"
        ],
        "props": {
          "variant": "muted"
        },
        "type": "Section"
      },
      "tileOverdue": {
        "children": [
          "stackOverdue"
        ],
        "props": {
          "variant": "muted"
        },
        "type": "Section"
      },
      "tileProjects": {
        "children": [
          "stackProjects"
        ],
        "props": {
          "variant": "muted"
        },
        "type": "Section"
      },
      "title": {
        "props": {
          "level": "h2",
          "text": "Overdue Tasks"
        },
        "type": "Heading"
      },
      "titleGroup": {
        "children": [
          "titleIcon",
          "titleStack"
        ],
        "props": {
          "align": "center",
          "gap": "sm"
        },
        "type": "Row"
      },
      "titleIcon": {
        "props": {
          "name": "TriangleAlert",
          "size": "sm",
          "tone": "destructive"
        },
        "type": "Icon"
      },
      "titleStack": {
        "children": [
          "title",
          "eyebrow"
        ],
        "props": {
          "gap": "none"
        },
        "type": "Stack"
      },
      "valLongest": {
        "props": {
          "size": "md",
          "value": {
            "$state": "/ui/rows/0/stat_longest"
          }
        },
        "type": "Stat"
      },
      "valOverdue": {
        "props": {
          "size": "md",
          "value": {
            "$state": "/ui/rows/0/stat_overdue"
          }
        },
        "type": "Stat"
      },
      "valProjects": {
        "props": {
          "size": "md",
          "value": {
            "$state": "/ui/rows/0/stat_projects"
          }
        },
        "type": "Stat"
      }
    },
    "root": "card"
  },
  "tags": [
    "asana",
    "tasks",
    "overdue",
    "due dates",
    "at risk"
  ],
  "title": "Overdue Tasks"
}
