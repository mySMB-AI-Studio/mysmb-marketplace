{
  "id": "asana-recent-activity",
  "title": "Recent Activity",
  "description": "Recent completions and updates on your Asana tasks. Approximation: the Asana MCP gateway has no stories/events tool yet, so comments and status-column moves aren't shown -- only real task-level fields (completed/completed_at, modified_at). Scoped to tasks assigned to you (assignee=me), not a full team-wide feed, since there's no cross-teammate activity tool to attribute other people's actions to.",
  "category": "tasks",
  "tags": ["asana", "activity", "feed", "recent", "tasks"],
  "keywords": ["recent activity", "activity feed", "asana activity", "completed tasks", "updated tasks"],
  "connectorsUsed": ["asana"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 5, "rowSpan": 7 },
    "min": { "colSpan": 3, "rowSpan": 5 },
    "max": { "colSpan": 8, "rowSpan": 12 }
  },
  "dataProvider": {
    "mcp": "asana",
    "tool": "list_tasks",
    "params": { "assignee": "me", "completed_since": "2026-01-01T00:00:00.000Z", "limit": 50 }
  },
  "spec": {
    "root": "card",
    "elements": {

      "card": {
        "type": "Card",
        "props": {},
        "children": ["headerRow", "div0", "loading", "empty", "activityList", "footerLabel"],
        "watch": {
          "/asana/list_tasks/data": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/rows",
                "value": {
                  "$computed": "asana_flatten_recent_activity",
                  "args": { "value": { "$state": "/asana/list_tasks/data" } }
                }
              }
            }
          ]
        }
      },

      "headerRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["titleGroup"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": { "type": "Icon", "props": { "name": "History", "tone": "accent", "size": "sm" } },
      "titleStack": { "type": "Stack", "props": { "gap": "none" }, "children": ["title", "eyebrow"] },
      "title": { "type": "Heading", "props": { "text": "Recent Activity", "level": "h2" } },
      "eyebrow": { "type": "Eyebrow", "props": { "text": "Asana · Your tasks" } },

      "div0": { "type": "Divider", "props": {} },

      "loading": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["sk1", "sk2", "sk3"],
        "visible": { "$state": "/_loading/asana.list_tasks" }
      },
      "sk1": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "sk2": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "sk3": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },

      "empty": {
        "type": "Empty",
        "props": { "message": "No recent activity on your tasks." },
        "visible": {
          "$and": [
            { "$state": "/_loading/asana.list_tasks", "not": true },
            { "$state": "/ui/rows/0", "not": true }
          ]
        }
      },

      "activityList": {
        "type": "Stack",
        "props": { "gap": "xs", "pt": "sm" },
        "children": ["activityRow"],
        "repeat": { "statePath": "/ui/rows", "key": "id" },
        "visible": {
          "$and": [
            { "$state": "/_loading/asana.list_tasks", "not": true },
            { "$state": "/ui/rows/0" }
          ]
        }
      },

      "activityRow": {
        "type": "ActivityItem",
        "props": {
          "iconName": { "$item": "icon_name" },
          "tone": { "$item": "tone" },
          "title": { "$item": "title" },
          "subtitle": { "$item": "subtitle" },
          "timestamp": {
            "$computed": "relative_time",
            "args": { "value": { "$item": "activity_at" } }
          }
        }
      },

      "footerLabel": {
        "type": "Caption",
        "props": {
          "text": "Shows completions and edits on tasks assigned to you — comments and status-column moves aren't available yet.",
          "tone": "muted"
        },
        "visible": {
          "$and": [
            { "$state": "/_loading/asana.list_tasks", "not": true },
            { "$state": "/ui/rows/0" }
          ]
        }
      }

    }
  },
  "status": "published"
}
