{
  "brandColor": "#F2994A",
  "category": "tasks",
  "connectorsUsed": [
    "asana"
  ],
  "dataProvider": {
    "kind": "tool",
    "mcp": "asana",
    "params": {
      "completed_since": "2026-01-01T00:00:00.000Z",
      "limit": 50,
      "project_gid": "1218344654321276"
    },
    "tool": "list_tasks"
  },
  "description": "Recent completions and updates in one Asana project, with each task's assignee shown by name and colored initials avatar -- built to match a reference mockup as closely as this platform's components allow. Approximation: the Asana MCP gateway has no stories/events tool yet, so comments, status-column moves, and bulk-add events aren't shown, only real task-level fields (completed/completed_at, modified_at, assignee). Scoped to a single hardcoded project_gid (see dataProvider.params) since this platform has no per-installation widget config mechanism to let an installer pick their own project. The assignee shown is a proxy for who performed the row's action, not a confirmed per-action actor. The header icon is an approximation too: the system Icon component has no solid-fill background, so it can't reproduce the mockup's solid orange rounded-square badge -- only a tone-colored line icon.",
  "id": "asana-recent-activity",
  "keywords": [
    "recent activity",
    "activity feed",
    "asana activity",
    "completed tasks",
    "updated tasks"
  ],
  "popularity": 0,
  "sizing": {
    "max": {
      "colSpan": 8,
      "rowSpan": 12
    },
    "min": {
      "colSpan": 3,
      "rowSpan": 4
    },
    "preferred": {
      "colSpan": 5,
      "rowSpan": 4
    }
  },
  "spec": {
    "elements": {
      "activityAvatar": {
        "props": {
          "initials": {
            "$item": "initials"
          },
          "size": "sm",
          "tone": {
            "$item": "avatar_tone"
          }
        },
        "type": "Avatar"
      },
      "activityBody": {
        "children": [
          "activityTitle",
          "activityTimestamp"
        ],
        "props": {
          "gap": "none",
          "grow": true
        },
        "type": "Stack"
      },
      "activityList": {
        "children": [
          "activityRowLink"
        ],
        "props": {
          "gap": "xs",
          "pt": "sm"
        },
        "repeat": {
          "key": "id",
          "statePath": "/ui/rows"
        },
        "type": "Stack",
        "visible": {
          "$and": [
            {
              "$state": "/_loading/asana.list_tasks",
              "not": true
            },
            {
              "$state": "/ui/rows/0"
            }
          ]
        }
      },
      "activityRowLink": {
        "children": [
          "activityAvatar",
          "activityBody"
        ],
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "target": "_blank",
              "url": {
                "$computed": "identity",
                "args": {
                  "value": {
                    "$item": "url"
                  }
                }
              }
            }
          }
        },
        "props": {
          "align": "start",
          "clickable": true,
          "gap": "sm",
          "hover": true
        },
        "type": "Row"
      },
      "activityTimestamp": {
        "props": {
          "text": {
            "$computed": "relative_time",
            "args": {
              "value": {
                "$item": "activity_at"
              }
            }
          },
          "tone": "muted"
        },
        "type": "Caption"
      },
      "activityTitle": {
        "props": {
          "size": "sm",
          "text": {
            "$item": "title"
          },
          "truncate": true,
          "weight": "medium"
        },
        "type": "Text"
      },
      "body": {
        "children": [
          "loading",
          "empty",
          "activityList",
          "footerLabel"
        ],
        "props": {},
        "type": "Body"
      },
      "card": {
        "children": [
          "headerRow",
          "div0",
          "body"
        ],
        "props": {},
        "type": "Card",
        "watch": {
          "/asana/list_tasks/data": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/rows",
                "value": {
                  "$computed": "asana_flatten_recent_activity",
                  "args": {
                    "value": {
                      "$state": "/asana/list_tasks/data"
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "div0": {
        "props": {},
        "type": "Divider"
      },
      "empty": {
        "props": {
          "message": "No recent activity in this project."
        },
        "type": "Empty",
        "visible": {
          "$and": [
            {
              "$state": "/_loading/asana.list_tasks",
              "not": true
            },
            {
              "$state": "/ui/rows/0",
              "not": true
            }
          ]
        }
      },
      "eyebrow": {
        "props": {
          "text": "Asana"
        },
        "type": "Eyebrow"
      },
      "footerLabel": {
        "props": {
          "text": "Shows completions and edits in this project, by assignee — comments and status-column moves aren't available yet.",
          "tone": "muted"
        },
        "type": "Caption",
        "visible": {
          "$and": [
            {
              "$state": "/_loading/asana.list_tasks",
              "not": true
            },
            {
              "$state": "/ui/rows/0"
            }
          ]
        }
      },
      "headerRow": {
        "children": [
          "titleGroup"
        ],
        "props": {
          "align": "center",
          "justify": "between"
        },
        "type": "Row"
      },
      "loading": {
        "children": [
          "sk1",
          "sk2",
          "sk3"
        ],
        "props": {
          "gap": "sm"
        },
        "type": "Stack",
        "visible": {
          "$state": "/_loading/asana.list_tasks"
        }
      },
      "sk1": {
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "sk2": {
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "sk3": {
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "title": {
        "props": {
          "level": "h2",
          "text": "Recent Activity"
        },
        "type": "Heading"
      },
      "titleGroup": {
        "children": [
          "titleIcon",
          "titleStack"
        ],
        "props": {
          "align": "center",
          "gap": "sm"
        },
        "type": "Row"
      },
      "titleIcon": {
        "props": {
          "name": "Clock",
          "size": "lg",
          "tone": "brand"
        },
        "type": "Icon"
      },
      "titleStack": {
        "children": [
          "title",
          "eyebrow"
        ],
        "props": {
          "gap": "none"
        },
        "type": "Stack"
      }
    },
    "root": "card"
  },
  "tags": [
    "asana",
    "activity",
    "feed",
    "recent",
    "tasks"
  ],
  "title": "Recent Activity"
}
