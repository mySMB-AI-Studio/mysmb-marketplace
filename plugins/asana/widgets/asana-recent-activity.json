{
  "id": "asana-recent-activity",
  "title": "Recent Activity",
  "description": "Recent completions and updates in one Asana project, with each task's assignee shown by name and colored initials avatar -- built to match a reference mockup as closely as this platform's components allow. Approximation: the Asana MCP gateway has no stories/events tool yet, so comments, status-column moves, and bulk-add events aren't shown, only real task-level fields (completed/completed_at, modified_at, assignee). Scoped to a single hardcoded project_gid (see dataProvider.params) since this platform has no per-installation widget config mechanism to let an installer pick their own project. The assignee shown is a proxy for who performed the row's action, not a confirmed per-action actor. The header icon is an approximation too: the system Icon component has no solid-fill background, so it can't reproduce the mockup's solid orange rounded-square badge -- only a tone-colored line icon.",
  "category": "tasks",
  "tags": ["asana", "activity", "feed", "recent", "tasks"],
  "keywords": ["recent activity", "activity feed", "asana activity", "completed tasks", "updated tasks"],
  "connectorsUsed": ["asana"],
  "popularity": 0,
  "brandColor": "#F2994A",
  "sizing": {
    "preferred": { "colSpan": 5, "rowSpan": 7 },
    "min": { "colSpan": 3, "rowSpan": 5 },
    "max": { "colSpan": 8, "rowSpan": 12 }
  },
  "dataProvider": {
    "mcp": "asana",
    "tool": "list_tasks",
    "params": { "project_gid": "1218344654321276", "completed_since": "2026-01-01T00:00:00.000Z", "limit": 50 }
  },
  "spec": {
    "root": "card",
    "elements": {

      "card": {
        "type": "Card",
        "props": {},
        "children": ["headerRow", "div0", "body"],
        "watch": {
          "/asana/list_tasks/data": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/rows",
                "value": {
                  "$computed": "asana_flatten_recent_activity",
                  "args": { "value": { "$state": "/asana/list_tasks/data" } }
                }
              }
            }
          ]
        }
      },

      "headerRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["titleGroup"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": { "type": "Icon", "props": { "name": "Clock", "tone": "brand", "size": "lg" } },
      "titleStack": { "type": "Stack", "props": { "gap": "none" }, "children": ["title", "eyebrow"] },
      "title": { "type": "Heading", "props": { "text": "Recent Activity", "level": "h2" } },
      "eyebrow": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["eyebrowDot", "eyebrowText"]
      },
      "eyebrowDot": { "type": "Dot", "props": { "tone": "brand", "size": "xs" } },
      "eyebrowText": { "type": "Caption", "props": { "text": "ASANA" } },

      "div0": { "type": "Divider", "props": {} },

      "body": {
        "type": "Body",
        "props": {},
        "children": ["loading", "empty", "activityList", "footerLabel"]
      },

      "loading": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["sk1", "sk2", "sk3"],
        "visible": { "$state": "/_loading/asana.list_tasks" }
      },
      "sk1": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "sk2": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "sk3": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },

      "empty": {
        "type": "Empty",
        "props": { "message": "No recent activity in this project." },
        "visible": {
          "$and": [
            { "$state": "/_loading/asana.list_tasks", "not": true },
            { "$state": "/ui/rows/0", "not": true }
          ]
        }
      },

      "activityList": {
        "type": "Stack",
        "props": { "gap": "xs", "pt": "sm" },
        "children": ["activityRowLink"],
        "repeat": { "statePath": "/ui/rows", "key": "id" },
        "visible": {
          "$and": [
            { "$state": "/_loading/asana.list_tasks", "not": true },
            { "$state": "/ui/rows/0" }
          ]
        }
      },

      "activityRowLink": {
        "type": "Row",
        "props": { "gap": "none", "hover": true, "clickable": true },
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "url": { "$computed": "identity", "args": { "value": { "$item": "url" } } },
              "target": "_blank"
            }
          }
        },
        "children": ["activityRow"]
      },

      "activityRow": {
        "type": "ActivityItem",
        "props": {
          "initials": { "$item": "initials" },
          "title": { "$item": "title" },
          "timestamp": {
            "$computed": "relative_time",
            "args": { "value": { "$item": "activity_at" } }
          }
        }
      },

      "footerLabel": {
        "type": "Caption",
        "props": {
          "text": "Shows completions and edits in this project, by assignee — comments and status-column moves aren't available yet.",
          "tone": "muted"
        },
        "visible": {
          "$and": [
            { "$state": "/_loading/asana.list_tasks", "not": true },
            { "$state": "/ui/rows/0" }
          ]
        }
      }

    }
  },
  "status": "published"
}
