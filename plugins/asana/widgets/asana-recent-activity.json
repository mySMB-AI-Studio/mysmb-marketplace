{
  "brandColor": "#F2994A",
  "category": "tasks",
  "connectorsUsed": [
    "asana"
  ],
  "dataProvider": {
    "kind": "tool",
    "mcp": "asana",
    "params": {
      "completed_since": "$days_ago_30",
      "limit": 50,
      "project_gid": "1218344654321276"
    },
    "tool": "list_tasks"
  },
  "description": "A grouped activity feed for one Asana project: completions and edits as dated cards, filterable by person and by action. Approximations, all re-confirmed live on 2026-11-11: the Asana MCP gateway has no stories/events tool, so comments, status-column moves and bulk-add events aren't available -- only real task fields (completed, modified_at, assignee). The person shown is the task's assignee, a proxy for the actor rather than a confirmed record of who acted, disclosed in the tile's own footnote. completed_at isn't in the response either, so modified_at stands in for the completion time. The project is a hardcoded project_gid (see dataProvider.params) because the platform has no per-installation widget config. The header icon is a tone-coloured line icon, not the reference design's solid orange badge, which the Icon component can't produce.",
  "id": "asana-recent-activity",
  "keywords": [
    "recent activity",
    "activity feed",
    "asana activity",
    "completed tasks",
    "updated tasks"
  ],
  "popularity": 0,
  "sizing": {
    "max": {
      "colSpan": 8,
      "rowSpan": 12
    },
    "min": {
      "colSpan": 3,
      "rowSpan": 4
    },
    "preferred": {
      "colSpan": 5,
      "rowSpan": 6
    }
  },
  "spec": {
    "elements": {
      "body": {
        "children": [
          "loading",
          "content"
        ],
        "props": {},
        "type": "Body"
      },
      "bubble": {
        "children": [
          "bubbleClick"
        ],
        "props": {
          "variant": "muted"
        },
        "type": "Section"
      },
      "bubbleClick": {
        "children": [
          "bubbleStack"
        ],
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "target": "_blank",
              "url": {
                "$computed": "identity",
                "args": {
                  "value": {
                    "$item": "url"
                  }
                }
              }
            }
          }
        },
        "props": {
          "align": "start",
          "clickable": {
            "$item": "has_url"
          },
          "grow": true
        },
        "type": "Row"
      },
      "bubbleStack": {
        "children": [
          "line1Row",
          "bubbleTitle"
        ],
        "props": {
          "gap": "xs",
          "grow": true
        },
        "type": "Stack"
      },
      "bubbleTitle": {
        "props": {
          "size": "sm",
          "text": {
            "$item": "title"
          },
          "truncate": true,
          "weight": "medium"
        },
        "type": "Text"
      },
      "card": {
        "children": [
          "header",
          "body",
          "footnote",
          "footerDivider",
          "footerRow"
        ],
        "props": {},
        "type": "Card",
        "watch": {
          "/asana/list_tasks/data": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/who",
                "value": ""
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/type",
                "value": "all"
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/board",
                "value": {
                  "$computed": "asana_flatten_activity_board",
                  "args": {
                    "type": {
                      "$state": "/ui/type"
                    },
                    "value": {
                      "$state": "/asana/list_tasks/data"
                    },
                    "who": {
                      "$state": "/ui/who"
                    }
                  }
                }
              }
            }
          ],
          "/ui/type": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/board",
                "value": {
                  "$computed": "asana_flatten_activity_board",
                  "args": {
                    "type": {
                      "$state": "/ui/type"
                    },
                    "value": {
                      "$state": "/asana/list_tasks/data"
                    },
                    "who": {
                      "$state": "/ui/who"
                    }
                  }
                }
              }
            }
          ],
          "/ui/who": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/board",
                "value": {
                  "$computed": "asana_flatten_activity_board",
                  "args": {
                    "type": {
                      "$state": "/ui/type"
                    },
                    "value": {
                      "$state": "/asana/list_tasks/data"
                    },
                    "who": {
                      "$state": "/ui/who"
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "chipItem": {
        "children": [
          "chipOn",
          "chipOff"
        ],
        "on": {
          "click": {
            "action": "setState",
            "params": {
              "statePath": "/ui/type",
              "value": {
                "$computed": "identity",
                "args": {
                  "value": {
                    "$item": "type"
                  }
                }
              }
            }
          }
        },
        "props": {
          "align": "center",
          "clickable": true
        },
        "type": "Row"
      },
      "chipOff": {
        "props": {
          "text": {
            "$item": "chip_text"
          },
          "tone": {
            "$item": "tone"
          },
          "variant": "outline"
        },
        "type": "Badge",
        "visible": {
          "$item": "selected",
          "not": true
        }
      },
      "chipOn": {
        "props": {
          "text": {
            "$item": "chip_text"
          },
          "tone": {
            "$item": "tone"
          },
          "variant": "soft"
        },
        "type": "Badge",
        "visible": {
          "$item": "selected"
        }
      },
      "chipsRow": {
        "children": [
          "chipItem"
        ],
        "props": {
          "align": "center",
          "gap": "xs"
        },
        "repeat": {
          "key": "id",
          "statePath": "/ui/board/chips"
        },
        "type": "Row"
      },
      "content": {
        "children": [
          "empty",
          "controlsRow",
          "feed"
        ],
        "props": {
          "gap": "md"
        },
        "type": "Stack",
        "visible": {
          "$state": "/_loading/asana.list_tasks",
          "not": true
        }
      },
      "controlsRow": {
        "children": [
          "peopleGroup",
          "chipsRow"
        ],
        "props": {
          "align": "center",
          "gap": "sm",
          "justify": "between"
        },
        "type": "Row",
        "visible": {
          "$state": "/ui/board/has_events"
        }
      },
      "empty": {
        "props": {
          "message": {
            "$state": "/ui/board/empty_message"
          }
        },
        "type": "Empty",
        "visible": {
          "$state": "/ui/board/has_events",
          "not": true
        }
      },
      "eventAvatar": {
        "props": {
          "initials": {
            "$item": "initials"
          },
          "size": "sm",
          "tone": {
            "$item": "avatar_tone"
          }
        },
        "type": "Avatar"
      },
      "eventRow": {
        "children": [
          "eventAvatar",
          "bubble"
        ],
        "props": {
          "align": "start",
          "gap": "sm",
          "template": "auto minmax(0, 1fr)"
        },
        "type": "Row"
      },
      "eyebrow": {
        "props": {
          "text": "Asana"
        },
        "type": "Eyebrow"
      },
      "eyebrowRow": {
        "children": [
          "eyebrow",
          "projectBadge"
        ],
        "props": {
          "align": "center",
          "gap": "xs"
        },
        "type": "Row"
      },
      "feed": {
        "children": [
          "groupHeader",
          "eventRow"
        ],
        "props": {
          "gap": "sm"
        },
        "repeat": {
          "key": "id",
          "statePath": "/ui/board/rows"
        },
        "type": "Stack",
        "visible": {
          "$state": "/ui/board/has_rows"
        }
      },
      "footerDivider": {
        "props": {},
        "type": "Divider"
      },
      "footerLabel": {
        "props": {
          "text": {
            "$state": "/ui/board/footer_label"
          }
        },
        "type": "Caption",
        "visible": {
          "$state": "/ui/board/has_events"
        }
      },
      "footerRow": {
        "children": [
          "footerLabel",
          "openProjectBtn"
        ],
        "props": {
          "align": "center",
          "justify": "between"
        },
        "type": "Row"
      },
      "footnote": {
        "children": [
          "footnoteRow"
        ],
        "props": {
          "variant": "muted"
        },
        "type": "Section",
        "visible": {
          "$state": "/ui/board/has_events"
        }
      },
      "footnoteIcon": {
        "props": {
          "name": "Info",
          "size": "xs",
          "tone": "muted"
        },
        "type": "Icon"
      },
      "footnoteRow": {
        "children": [
          "footnoteIcon",
          "footnoteWrap"
        ],
        "props": {
          "align": "start",
          "gap": "xs"
        },
        "type": "Row"
      },
      "footnoteText": {
        "props": {
          "text": {
            "$state": "/ui/board/footnote"
          },
          "tone": "muted"
        },
        "type": "Caption"
      },
      "footnoteWrap": {
        "children": [
          "footnoteText"
        ],
        "props": {
          "gap": "none",
          "grow": true
        },
        "type": "Stack"
      },
      "groupDot": {
        "props": {
          "size": "xs",
          "tone": {
            "$item": "group_tone"
          }
        },
        "type": "Dot"
      },
      "groupHeader": {
        "children": [
          "groupDot",
          "groupLabel"
        ],
        "props": {
          "align": "center",
          "gap": "xs"
        },
        "type": "Row",
        "visible": {
          "$item": "show_group"
        }
      },
      "groupLabel": {
        "props": {
          "text": {
            "$item": "group_label"
          },
          "tone": {
            "$item": "group_tone"
          }
        },
        "type": "Caption"
      },
      "header": {
        "children": [
          "titleGroup"
        ],
        "props": {},
        "type": "Header"
      },
      "line1Left": {
        "children": [
          "nameText",
          "verbBadge",
          "newBadge"
        ],
        "props": {
          "align": "center",
          "gap": "xs",
          "grow": true
        },
        "type": "Row"
      },
      "line1Row": {
        "children": [
          "line1Left",
          "timeCaption"
        ],
        "props": {
          "align": "center",
          "gap": "xs",
          "justify": "between"
        },
        "type": "Row"
      },
      "loading": {
        "children": [
          "sk1",
          "sk2",
          "sk3"
        ],
        "props": {
          "gap": "sm"
        },
        "type": "Stack",
        "visible": {
          "$state": "/_loading/asana.list_tasks"
        }
      },
      "nameText": {
        "props": {
          "size": "xs",
          "text": {
            "$item": "name_label"
          },
          "weight": "medium"
        },
        "type": "Text"
      },
      "newBadge": {
        "props": {
          "text": "NEW",
          "tone": "brand",
          "variant": "soft"
        },
        "type": "Badge",
        "visible": {
          "$item": "is_new"
        }
      },
      "openProjectBtn": {
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "target": "_blank",
              "url": {
                "$computed": "identity",
                "args": {
                  "value": {
                    "$state": "/ui/board/project_url"
                  }
                }
              }
            }
          }
        },
        "props": {
          "label": "Open project",
          "size": "sm",
          "tone": "brand",
          "variant": "primary"
        },
        "type": "Button"
      },
      "peopleGroup": {
        "children": [
          "peopleRow",
          "whoClear"
        ],
        "props": {
          "align": "center",
          "gap": "xs"
        },
        "type": "Row"
      },
      "peopleRow": {
        "children": [
          "personItem"
        ],
        "props": {
          "align": "center",
          "gap": "xs"
        },
        "repeat": {
          "key": "id",
          "statePath": "/ui/board/people"
        },
        "type": "Row",
        "visible": {
          "$state": "/ui/board/show_people"
        }
      },
      "personAvatar": {
        "props": {
          "initials": {
            "$item": "initials"
          },
          "size": "sm",
          "tone": {
            "$item": "tone"
          }
        },
        "type": "Avatar"
      },
      "personItem": {
        "children": [
          "personAvatar"
        ],
        "on": {
          "click": {
            "action": "setState",
            "params": {
              "statePath": "/ui/who",
              "value": {
                "$computed": "identity",
                "args": {
                  "value": {
                    "$item": "click_value"
                  }
                }
              }
            }
          }
        },
        "props": {
          "align": "center",
          "clickable": true
        },
        "type": "Row"
      },
      "projectBadge": {
        "props": {
          "text": {
            "$state": "/ui/board/project_name"
          },
          "tone": "brand",
          "variant": "soft"
        },
        "type": "Badge",
        "visible": {
          "$state": "/ui/board/show_project"
        }
      },
      "sk1": {
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "sk2": {
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "sk3": {
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "timeCaption": {
        "props": {
          "text": {
            "$item": "time_label"
          },
          "tone": "muted"
        },
        "type": "Caption"
      },
      "title": {
        "props": {
          "level": "h2",
          "text": "Recent Activity"
        },
        "type": "Heading"
      },
      "titleGroup": {
        "children": [
          "titleIcon",
          "titleStack"
        ],
        "props": {
          "align": "center",
          "gap": "sm"
        },
        "type": "Row"
      },
      "titleIcon": {
        "props": {
          "name": "Clock",
          "size": "lg",
          "tone": "brand"
        },
        "type": "Icon"
      },
      "titleStack": {
        "children": [
          "title",
          "eyebrowRow"
        ],
        "props": {
          "gap": "none"
        },
        "type": "Stack"
      },
      "verbBadge": {
        "props": {
          "text": {
            "$item": "verb_label"
          },
          "tone": {
            "$item": "verb_tone"
          },
          "variant": "soft"
        },
        "type": "Badge"
      },
      "whoClear": {
        "children": [
          "whoClearBadge"
        ],
        "on": {
          "click": {
            "action": "setState",
            "params": {
              "statePath": "/ui/who",
              "value": ""
            }
          }
        },
        "props": {
          "align": "center",
          "clickable": true
        },
        "type": "Row",
        "visible": {
          "$state": "/ui/board/show_who"
        }
      },
      "whoClearBadge": {
        "props": {
          "text": {
            "$state": "/ui/board/who_label"
          },
          "tone": "brand",
          "variant": "soft"
        },
        "type": "Badge"
      }
    },
    "root": "card"
  },
  "tags": [
    "asana",
    "activity",
    "feed",
    "recent",
    "tasks"
  ],
  "title": "Recent Activity"
}
