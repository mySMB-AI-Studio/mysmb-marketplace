{
  "brandColor": "#34DFBA",
  "category": "projects",
  "connectorsUsed": [
    "asana"
  ],
  "dataProvider": {
    "kind": "tool",
    "mcp": "asana",
    "params": {
      "limit": 20
    },
    "tool": "list_milestones"
  },
  "description": "Upcoming milestones (incomplete, due today or later) across your active Asana projects, sorted by due date. Uses list_milestones, which auto-resolves your workspace and scans up to 20 active projects server-side — no workspace_gid needed. Live-verified 2026-09-14 against a real connected account. Click a row to open that milestone in Asana; a footer button opens Asana itself in a new tab (there's no single cross-project \"milestones\" page in Asana to deep-link to instead). Row links are built client-side as https://app.asana.com/0/{project_gid}/{gid} — Asana's long-standing task deep-link convention — since list_milestones doesn't request the real permalink_url field the way this plugin's Projects tile does; NOT yet confirmed by actually clicking one against a live account.",
  "id": "asana-upcoming-milestones",
  "keywords": [
    "asana milestones",
    "upcoming milestones",
    "deadlines",
    "project milestones"
  ],
  "popularity": 0,
  "sizing": {
    "max": {
      "colSpan": 8,
      "rowSpan": 10
    },
    "min": {
      "colSpan": 3,
      "rowSpan": 4
    },
    "preferred": {
      "colSpan": 4,
      "rowSpan": 5
    }
  },
  "spec": {
    "elements": {
      "asanaLabel": {
        "props": {
          "text": "Asana"
        },
        "type": "Caption"
      },
      "body": {
        "children": [
          "loading",
          "empty",
          "list"
        ],
        "props": {},
        "type": "Body"
      },
      "card": {
        "children": [
          "header",
          "body",
          "footerDivider",
          "footerRow"
        ],
        "props": {},
        "type": "Card",
        "watch": {
          "/asana/list_milestones/data": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/rows",
                "value": {
                  "$computed": "asana_flatten_milestones",
                  "args": {
                    "value": {
                      "$state": "/asana/list_milestones/data"
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "empty": {
        "props": {
          "message": "No upcoming milestones across your active projects."
        },
        "type": "Empty",
        "visible": {
          "$and": [
            {
              "$state": "/_loading/asana.list_milestones",
              "not": true
            },
            {
              "$state": "/ui/rows/0",
              "not": true
            }
          ]
        }
      },
      "footerDivider": {
        "props": {},
        "type": "Divider"
      },
      "footerLabel": {
        "props": {
          "text": {
            "$state": "/ui/rows/0/footer_label"
          }
        },
        "type": "Caption",
        "visible": {
          "$state": "/ui/rows/0"
        }
      },
      "footerRow": {
        "children": [
          "footerLabel",
          "openInAsanaBtn"
        ],
        "props": {
          "align": "center",
          "justify": "between"
        },
        "type": "Row"
      },
      "header": {
        "children": [
          "titleGroup"
        ],
        "props": {},
        "type": "Header"
      },
      "list": {
        "children": [
          "row"
        ],
        "props": {
          "gap": "md"
        },
        "repeat": {
          "key": "id",
          "statePath": "/ui/rows"
        },
        "type": "Stack",
        "visible": {
          "$and": [
            {
              "$state": "/_loading/asana.list_milestones",
              "not": true
            },
            {
              "$state": "/ui/rows/0"
            }
          ]
        }
      },
      "loading": {
        "children": [
          "sk1",
          "sk2",
          "sk3"
        ],
        "props": {
          "gap": "sm"
        },
        "type": "Stack",
        "visible": {
          "$state": "/_loading/asana.list_milestones"
        }
      },
      "openInAsanaBtn": {
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "target": "_blank",
              "url": "https://app.asana.com/"
            }
          }
        },
        "props": {
          "label": "Open Asana",
          "size": "sm",
          "tone": "brand",
          "variant": "primary"
        },
        "type": "Button"
      },
      "row": {
        "children": [
          "rowDueBadge",
          "rowRight"
        ],
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "target": "_blank",
              "url": {
                "$computed": "identity",
                "args": {
                  "value": {
                    "$item": "url"
                  }
                }
              }
            }
          }
        },
        "props": {
          "align": "center",
          "clickable": true,
          "gap": "sm",
          "hover": true
        },
        "type": "Row"
      },
      "rowDueBadge": {
        "props": {
          "text": {
            "$item": "due_label"
          },
          "tone": {
            "$item": "due_tone"
          }
        },
        "type": "Badge"
      },
      "rowName": {
        "props": {
          "size": "sm",
          "text": {
            "$item": "name"
          },
          "truncate": true,
          "weight": "semibold"
        },
        "type": "Text"
      },
      "rowProject": {
        "props": {
          "text": {
            "$item": "project_label"
          }
        },
        "type": "Caption"
      },
      "rowRight": {
        "children": [
          "rowName",
          "rowProject"
        ],
        "props": {
          "gap": "none",
          "grow": true
        },
        "type": "Stack"
      },
      "sk1": {
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "sk2": {
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "sk3": {
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "title": {
        "props": {
          "level": "h2",
          "text": "Upcoming Milestones"
        },
        "type": "Heading"
      },
      "titleGroup": {
        "children": [
          "titleIcon",
          "titleStack"
        ],
        "props": {
          "align": "start",
          "gap": "sm"
        },
        "type": "Row"
      },
      "titleIcon": {
        "props": {
          "name": "Milestone",
          "size": "sm",
          "tone": "brand"
        },
        "type": "Icon"
      },
      "titleStack": {
        "children": [
          "title",
          "asanaLabel"
        ],
        "props": {
          "gap": "none"
        },
        "type": "Stack"
      }
    },
    "root": "card"
  },
  "tags": [
    "asana",
    "milestones",
    "projects",
    "deadlines"
  ],
  "title": "Upcoming Milestones"
}
