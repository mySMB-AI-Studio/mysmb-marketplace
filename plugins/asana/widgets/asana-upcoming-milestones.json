{
  "brandColor": "#34DFBA",
  "category": "projects",
  "connectorsUsed": [
    "asana"
  ],
  "dataProvider": {
    "kind": "tool",
    "mcp": "asana",
    "params": {
      "limit": 50
    },
    "tool": "list_milestones"
  },
  "description": "Upcoming Asana milestones on a runway: the next one due with a day countdown, a proportional timeline of everything ahead, and a date-tiled list grouped by month, filterable to the next two weeks, the next month or everything found. Uses list_milestones, which auto-resolves the workspace and scans the first 20 active projects server-side — milestones in projects past those 20 are not searched, and a task only counts as a milestone if it carries Asana’s milestone subtype and a due date. Rows open the milestone in Asana using https://app.asana.com/0/{project_gid}/{gid}; list_milestones does not request the real permalink_url field, so that link is built from ids rather than returned by the API. No assignee or project colour is available from this tool.",
  "id": "asana-upcoming-milestones",
  "keywords": [
    "asana milestones",
    "upcoming milestones",
    "deadlines",
    "project milestones",
    "milestone timeline",
    "project runway"
  ],
  "popularity": 0,
  "sizing": {
    "max": {
      "colSpan": 8,
      "rowSpan": 12
    },
    "min": {
      "colSpan": 3,
      "rowSpan": 4
    },
    "preferred": {
      "colSpan": 5,
      "rowSpan": 6
    }
  },
  "spec": {
    "elements": {
      "axisEnd": {
        "props": {
          "text": {
            "$state": "/ui/board/axis_end_label"
          },
          "tone": "muted"
        },
        "type": "Caption"
      },
      "axisRow": {
        "children": [
          "axisStart",
          "axisEnd"
        ],
        "props": {
          "align": "center",
          "justify": "between"
        },
        "type": "Row"
      },
      "axisStart": {
        "props": {
          "text": {
            "$state": "/ui/board/axis_start_label"
          },
          "tone": "brand"
        },
        "type": "Caption"
      },
      "body": {
        "children": [
          "loading",
          "content"
        ],
        "props": {},
        "type": "Body"
      },
      "card": {
        "children": [
          "header",
          "body",
          "footnote",
          "footerDivider",
          "footerRow"
        ],
        "props": {},
        "type": "Card",
        "watch": {
          "/asana/list_milestones/data": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/range",
                "value": "all"
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/board",
                "value": {
                  "$computed": "asana_flatten_milestone_runway",
                  "args": {
                    "range": {
                      "$state": "/ui/range"
                    },
                    "value": {
                      "$state": "/asana/list_milestones/data"
                    }
                  }
                }
              }
            }
          ],
          "/ui/range": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/board",
                "value": {
                  "$computed": "asana_flatten_milestone_runway",
                  "args": {
                    "range": {
                      "$state": "/ui/range"
                    },
                    "value": {
                      "$state": "/asana/list_milestones/data"
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "content": {
        "children": [
          "hero",
          "controlsRow",
          "runwayStack",
          "empty",
          "list"
        ],
        "props": {
          "gap": "md"
        },
        "type": "Stack",
        "visible": {
          "$state": "/_loading/asana.list_milestones",
          "not": true
        }
      },
      "controlsRow": {
        "children": [
          "runwayLabel",
          "rangeRow"
        ],
        "props": {
          "align": "center",
          "gap": "sm",
          "justify": "between"
        },
        "type": "Row",
        "visible": {
          "$state": "/ui/board/has_any"
        }
      },
      "dateDay": {
        "props": {
          "level": "h1",
          "text": {
            "$item": "day_label"
          }
        },
        "type": "Heading"
      },
      "dateTile": {
        "children": [
          "dateWeekday",
          "dateDay"
        ],
        "props": {
          "align": "center",
          "gap": "none"
        },
        "type": "Stack"
      },
      "dateWeekday": {
        "props": {
          "text": {
            "$item": "weekday_label"
          },
          "tone": {
            "$item": "tone"
          }
        },
        "type": "Caption"
      },
      "empty": {
        "props": {
          "message": {
            "$state": "/ui/board/empty_message"
          }
        },
        "type": "Empty",
        "visible": {
          "$state": "/ui/board/has_rows",
          "not": true
        }
      },
      "eyebrow": {
        "props": {
          "text": {
            "$state": "/ui/board/header_label"
          },
          "tone": "muted"
        },
        "type": "Caption"
      },
      "footerDivider": {
        "props": {},
        "type": "Divider"
      },
      "footerLabel": {
        "props": {
          "text": {
            "$state": "/ui/board/footer_label"
          }
        },
        "type": "Caption"
      },
      "footerRow": {
        "children": [
          "footerLabel",
          "openInAsanaBtn"
        ],
        "props": {
          "align": "center",
          "justify": "between"
        },
        "type": "Row"
      },
      "footnote": {
        "props": {
          "text": {
            "$state": "/ui/board/footnote"
          },
          "tone": "muted"
        },
        "type": "Caption",
        "visible": {
          "$state": "/_loading/asana.list_milestones",
          "not": true
        }
      },
      "groupHeader": {
        "children": [
          "groupLabel"
        ],
        "props": {
          "align": "center",
          "gap": "xs"
        },
        "type": "Row",
        "visible": {
          "$item": "show_group"
        }
      },
      "groupLabel": {
        "props": {
          "text": {
            "$item": "group_label"
          }
        },
        "type": "Eyebrow"
      },
      "header": {
        "children": [
          "titleGroup"
        ],
        "props": {},
        "type": "Header"
      },
      "hero": {
        "children": [
          "heroRow"
        ],
        "props": {
          "variant": "muted"
        },
        "type": "Section",
        "visible": {
          "$state": "/ui/board/has_next"
        }
      },
      "heroCount": {
        "children": [
          "heroCountValue",
          "heroCountCaption"
        ],
        "props": {
          "align": "center",
          "gap": "none"
        },
        "type": "Stack"
      },
      "heroCountCaption": {
        "props": {
          "text": {
            "$state": "/ui/board/next_count_caption"
          },
          "tone": {
            "$state": "/ui/board/next_tone"
          }
        },
        "type": "Caption"
      },
      "heroCountValue": {
        "props": {
          "size": "sm",
          "value": {
            "$state": "/ui/board/next_count"
          }
        },
        "type": "Stat"
      },
      "heroEyebrow": {
        "props": {
          "text": "NEXT MILESTONE"
        },
        "type": "Eyebrow"
      },
      "heroMain": {
        "children": [
          "heroEyebrow",
          "heroName",
          "heroMeta"
        ],
        "props": {
          "gap": "xs",
          "grow": true
        },
        "type": "Stack"
      },
      "heroMeta": {
        "props": {
          "text": {
            "$state": "/ui/board/next_meta"
          },
          "tone": "muted"
        },
        "type": "Caption"
      },
      "heroName": {
        "props": {
          "size": "sm",
          "text": {
            "$state": "/ui/board/next_name"
          },
          "truncate": true,
          "weight": "medium"
        },
        "type": "Text"
      },
      "heroRow": {
        "children": [
          "heroMain",
          "heroCount"
        ],
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "target": "_blank",
              "url": {
                "$state": "/ui/board/next_url"
              }
            }
          }
        },
        "props": {
          "align": "center",
          "clickable": {
            "$state": "/ui/board/next_has_url"
          },
          "gap": "sm",
          "justify": "between"
        },
        "type": "Row"
      },
      "inBadge": {
        "props": {
          "text": {
            "$item": "in_label"
          },
          "tone": {
            "$item": "tone"
          },
          "variant": "soft"
        },
        "type": "Badge"
      },
      "list": {
        "children": [
          "groupHeader",
          "milestoneRow"
        ],
        "props": {
          "gap": "xs"
        },
        "repeat": {
          "key": "id",
          "statePath": "/ui/board/rows"
        },
        "type": "Stack",
        "visible": {
          "$state": "/ui/board/has_rows"
        }
      },
      "loading": {
        "children": [
          "sk1",
          "sk2",
          "sk3"
        ],
        "props": {
          "gap": "sm"
        },
        "type": "Stack",
        "visible": {
          "$state": "/_loading/asana.list_milestones"
        }
      },
      "marker": {
        "children": [
          "markerDot"
        ],
        "props": {
          "align": "end",
          "gap": "none"
        },
        "type": "Stack"
      },
      "markerDot": {
        "props": {
          "size": "sm",
          "tone": {
            "$item": "tone"
          }
        },
        "type": "Dot"
      },
      "markerRow": {
        "children": [
          "marker"
        ],
        "props": {
          "align": "center",
          "gap": "none",
          "template": {
            "$state": "/ui/board/runway_template"
          }
        },
        "repeat": {
          "key": "id",
          "statePath": "/ui/board/markers"
        },
        "type": "Row"
      },
      "milestoneMain": {
        "children": [
          "milestoneName",
          "milestoneMeta"
        ],
        "props": {
          "gap": "none",
          "grow": true
        },
        "type": "Stack"
      },
      "milestoneMeta": {
        "props": {
          "text": {
            "$item": "meta_label"
          },
          "tone": "muted"
        },
        "type": "Caption"
      },
      "milestoneName": {
        "props": {
          "size": "sm",
          "text": {
            "$item": "name"
          },
          "truncate": true,
          "weight": "medium"
        },
        "type": "Text"
      },
      "milestoneRow": {
        "children": [
          "dateTile",
          "milestoneMain",
          "inBadge"
        ],
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "target": "_blank",
              "url": {
                "$computed": "identity",
                "args": {
                  "value": {
                    "$item": "url"
                  }
                }
              }
            }
          }
        },
        "props": {
          "align": "center",
          "clickable": {
            "$item": "has_url"
          },
          "gap": "sm",
          "hover": true,
          "template": "auto minmax(0, 1fr) auto"
        },
        "type": "Row"
      },
      "openInAsanaBtn": {
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "target": "_blank",
              "url": "https://app.asana.com/"
            }
          }
        },
        "props": {
          "label": "Open Asana",
          "size": "sm",
          "tone": "brand",
          "variant": "primary"
        },
        "type": "Button"
      },
      "range14": {
        "children": [
          "range14Badge"
        ],
        "on": {
          "click": {
            "action": "setState",
            "params": {
              "statePath": "/ui/range",
              "value": "14"
            }
          }
        },
        "props": {
          "align": "center",
          "clickable": true
        },
        "type": "Row"
      },
      "range14Badge": {
        "props": {
          "text": "2 weeks",
          "tone": {
            "$state": "/ui/board/range_14_tone"
          },
          "variant": {
            "$state": "/ui/board/range_14_variant"
          }
        },
        "type": "Badge"
      },
      "range30": {
        "children": [
          "range30Badge"
        ],
        "on": {
          "click": {
            "action": "setState",
            "params": {
              "statePath": "/ui/range",
              "value": "30"
            }
          }
        },
        "props": {
          "align": "center",
          "clickable": true
        },
        "type": "Row"
      },
      "range30Badge": {
        "props": {
          "text": "1 month",
          "tone": {
            "$state": "/ui/board/range_30_tone"
          },
          "variant": {
            "$state": "/ui/board/range_30_variant"
          }
        },
        "type": "Badge"
      },
      "rangeAll": {
        "children": [
          "rangeAllBadge"
        ],
        "on": {
          "click": {
            "action": "setState",
            "params": {
              "statePath": "/ui/range",
              "value": "all"
            }
          }
        },
        "props": {
          "align": "center",
          "clickable": true
        },
        "type": "Row"
      },
      "rangeAllBadge": {
        "props": {
          "text": "All",
          "tone": {
            "$state": "/ui/board/range_all_tone"
          },
          "variant": {
            "$state": "/ui/board/range_all_variant"
          }
        },
        "type": "Badge"
      },
      "rangeRow": {
        "children": [
          "range14",
          "range30",
          "rangeAll"
        ],
        "props": {
          "align": "center",
          "gap": "xs"
        },
        "type": "Row"
      },
      "runwayLabel": {
        "props": {
          "text": "RUNWAY"
        },
        "type": "Eyebrow"
      },
      "runwayRail": {
        "children": [
          "runwayRailBar"
        ],
        "props": {
          "align": "center"
        },
        "type": "Row"
      },
      "runwayRailBar": {
        "props": {
          "tone": "brand",
          "value": 0
        },
        "type": "ProgressBar"
      },
      "runwayStack": {
        "children": [
          "markerRow",
          "runwayRail",
          "axisRow"
        ],
        "props": {
          "gap": "xs"
        },
        "type": "Stack",
        "visible": {
          "$state": "/ui/board/show_runway"
        }
      },
      "sk1": {
        "props": {
          "height": "4rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "sk2": {
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "sk3": {
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "title": {
        "props": {
          "level": "h2",
          "text": "Upcoming Milestones"
        },
        "type": "Heading"
      },
      "titleGroup": {
        "children": [
          "titleIcon",
          "titleStack"
        ],
        "props": {
          "align": "center",
          "gap": "sm"
        },
        "type": "Row"
      },
      "titleIcon": {
        "props": {
          "name": "Milestone",
          "size": "sm",
          "tone": "brand"
        },
        "type": "Icon"
      },
      "titleStack": {
        "children": [
          "title",
          "eyebrow"
        ],
        "props": {
          "gap": "none"
        },
        "type": "Stack"
      }
    },
    "root": "card"
  },
  "tags": [
    "asana",
    "milestones",
    "projects",
    "deadlines"
  ],
  "title": "Upcoming Milestones"
}
