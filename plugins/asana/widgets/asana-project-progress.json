{
  "category": "projects",
  "connectorsUsed": [
    "asana"
  ],
  "dataProvider": {
    "kind": "tool",
    "mcp": "asana",
    "params": {
      "archived": false,
      "limit": 10
    },
    "tool": "list_projects"
  },
  "description": "Overall task completion across your active Asana projects, with a per-project card grid, status filters and sorting.",
  "id": "asana-project-progress",
  "keywords": [
    "asana projects",
    "project progress",
    "task completion",
    "at risk",
    "behind"
  ],
  "popularity": 65,
  "sizing": {
    "max": {
      "colSpan": 8,
      "rowSpan": 12
    },
    "min": {
      "colSpan": 4,
      "rowSpan": 4
    },
    "preferred": {
      "colSpan": 6,
      "rowSpan": 6
    }
  },
  "spec": {
    "elements": {
      "body": {
        "children": [
          "loading",
          "content"
        ],
        "props": {},
        "type": "Body"
      },
      "card": {
        "children": [
          "header",
          "body",
          "footerDivider",
          "footerRow"
        ],
        "props": {},
        "type": "Card",
        "watch": {
          "/asana/list_projects/data": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/filter",
                "value": "all"
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/sort",
                "value": "low"
              }
            },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/board",
                "value": {
                  "$computed": "asana_flatten_project_board",
                  "args": {
                    "filter": {
                      "$state": "/ui/filter"
                    },
                    "sort": {
                      "$state": "/ui/sort"
                    },
                    "value": {
                      "$state": "/asana/list_projects/data"
                    }
                  }
                }
              }
            }
          ],
          "/ui/filter": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/board",
                "value": {
                  "$computed": "asana_flatten_project_board",
                  "args": {
                    "filter": {
                      "$state": "/ui/filter"
                    },
                    "sort": {
                      "$state": "/ui/sort"
                    },
                    "value": {
                      "$state": "/asana/list_projects/data"
                    }
                  }
                }
              }
            }
          ],
          "/ui/sort": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/board",
                "value": {
                  "$computed": "asana_flatten_project_board",
                  "args": {
                    "filter": {
                      "$state": "/ui/filter"
                    },
                    "sort": {
                      "$state": "/ui/sort"
                    },
                    "value": {
                      "$state": "/asana/list_projects/data"
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "cardBar": {
        "props": {
          "tone": {
            "$item": "tone"
          },
          "value": {
            "$item": "pct"
          }
        },
        "type": "ProgressBar"
      },
      "cardBarRow": {
        "children": [
          "cardBar"
        ],
        "props": {},
        "type": "Row"
      },
      "cardCapRow": {
        "children": [
          "cardDone",
          "cardLeft"
        ],
        "props": {
          "align": "center",
          "gap": "xs",
          "justify": "between"
        },
        "type": "Row"
      },
      "cardClick": {
        "children": [
          "cardStack"
        ],
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "target": "_blank",
              "url": {
                "$computed": "identity",
                "args": {
                  "value": {
                    "$item": "url"
                  }
                }
              }
            }
          }
        },
        "props": {
          "align": "start",
          "clickable": {
            "$item": "has_url"
          },
          "grow": true
        },
        "type": "Row"
      },
      "cardDone": {
        "props": {
          "size": "xs",
          "text": {
            "$item": "done_label"
          },
          "tone": "muted",
          "truncate": true
        },
        "type": "Text"
      },
      "cardLeft": {
        "props": {
          "size": "xs",
          "text": {
            "$item": "left_label"
          },
          "tone": {
            "$item": "tone"
          }
        },
        "type": "Text",
        "visible": {
          "$item": "show_left"
        }
      },
      "cardName": {
        "props": {
          "size": "sm",
          "text": {
            "$item": "name"
          },
          "truncate": true,
          "weight": "medium"
        },
        "type": "Text"
      },
      "cardPct": {
        "props": {
          "size": "md",
          "value": {
            "$item": "pct_label"
          }
        },
        "type": "Stat"
      },
      "cardStack": {
        "children": [
          "cardName",
          "cardTopRow",
          "cardBarRow",
          "cardCapRow"
        ],
        "props": {
          "gap": "xs",
          "grow": true
        },
        "type": "Stack"
      },
      "cardStatus": {
        "props": {
          "text": {
            "$item": "status_label"
          },
          "tone": {
            "$item": "tone"
          },
          "variant": "soft"
        },
        "type": "Badge"
      },
      "cardTopRow": {
        "children": [
          "cardPct",
          "cardStatus"
        ],
        "props": {
          "align": "center",
          "gap": "xs",
          "justify": "between"
        },
        "type": "Row"
      },
      "chipItem": {
        "children": [
          "chipOn",
          "chipOff"
        ],
        "on": {
          "click": {
            "action": "setState",
            "params": {
              "statePath": "/ui/filter",
              "value": {
                "$computed": "identity",
                "args": {
                  "value": {
                    "$item": "filter"
                  }
                }
              }
            }
          }
        },
        "props": {
          "align": "center",
          "clickable": true
        },
        "type": "Row"
      },
      "chipOff": {
        "props": {
          "text": {
            "$item": "chip_text"
          },
          "tone": {
            "$item": "tone"
          },
          "variant": "outline"
        },
        "type": "Badge",
        "visible": {
          "$item": "selected",
          "not": true
        }
      },
      "chipOn": {
        "props": {
          "text": {
            "$item": "chip_text"
          },
          "tone": {
            "$item": "tone"
          },
          "variant": "soft"
        },
        "type": "Badge",
        "visible": {
          "$item": "selected"
        }
      },
      "chipsRow": {
        "children": [
          "chipItem"
        ],
        "props": {
          "align": "center",
          "gap": "xs"
        },
        "repeat": {
          "key": "id",
          "statePath": "/ui/board/chips"
        },
        "type": "Row"
      },
      "content": {
        "children": [
          "empty",
          "hero",
          "controlsRow",
          "grid"
        ],
        "props": {
          "gap": "md"
        },
        "type": "Stack",
        "visible": {
          "$state": "/_loading/asana.list_projects",
          "not": true
        }
      },
      "controlsRow": {
        "children": [
          "chipsRow",
          "sortToggle"
        ],
        "props": {
          "align": "center",
          "gap": "sm",
          "justify": "between"
        },
        "type": "Row",
        "visible": {
          "$state": "/ui/board/show_chips"
        }
      },
      "empty": {
        "props": {
          "message": {
            "$state": "/ui/board/empty_message"
          }
        },
        "type": "Empty",
        "visible": {
          "$state": "/ui/board/has_projects",
          "not": true
        }
      },
      "eyebrow": {
        "props": {
          "text": {
            "$state": "/ui/board/header_label"
          }
        },
        "type": "Eyebrow"
      },
      "footerDivider": {
        "props": {},
        "type": "Divider"
      },
      "footerLabel": {
        "props": {
          "text": {
            "$state": "/ui/board/footer_label"
          }
        },
        "type": "Caption",
        "visible": {
          "$state": "/ui/board/has_projects"
        }
      },
      "footerRow": {
        "children": [
          "footerLabel",
          "openInAsanaBtn"
        ],
        "props": {
          "align": "center",
          "justify": "between"
        },
        "type": "Row"
      },
      "grid": {
        "children": [
          "projectCard"
        ],
        "props": {
          "cols": 2,
          "gap": "sm"
        },
        "repeat": {
          "key": "id",
          "statePath": "/ui/board/cards"
        },
        "type": "Grid",
        "visible": {
          "$state": "/ui/board/has_cards"
        }
      },
      "header": {
        "children": [
          "titleGroup"
        ],
        "props": {},
        "type": "Header"
      },
      "hero": {
        "children": [
          "heroStack"
        ],
        "props": {
          "variant": "muted"
        },
        "type": "Section",
        "visible": {
          "$state": "/ui/board/has_projects"
        }
      },
      "heroBar": {
        "props": {
          "tone": {
            "$state": "/ui/board/overall_tone"
          },
          "value": {
            "$state": "/ui/board/overall_pct"
          }
        },
        "type": "ProgressBar"
      },
      "heroBarRow": {
        "children": [
          "heroBar"
        ],
        "props": {},
        "type": "Row"
      },
      "heroLabels": {
        "children": [
          "heroTasks",
          "heroProjects"
        ],
        "props": {
          "align": "end",
          "gap": "none"
        },
        "type": "Stack"
      },
      "heroPct": {
        "props": {
          "size": "lg",
          "value": {
            "$state": "/ui/board/overall_pct_label"
          }
        },
        "type": "Stat"
      },
      "heroProjects": {
        "props": {
          "text": {
            "$state": "/ui/board/hero_projects_label"
          },
          "tone": "muted"
        },
        "type": "Caption"
      },
      "heroStack": {
        "children": [
          "heroTop",
          "heroBarRow"
        ],
        "props": {
          "gap": "sm"
        },
        "type": "Stack"
      },
      "heroTasks": {
        "props": {
          "text": {
            "$state": "/ui/board/hero_tasks_label"
          },
          "tone": "default"
        },
        "type": "Caption"
      },
      "heroTop": {
        "children": [
          "heroPct",
          "heroLabels"
        ],
        "props": {
          "align": "end",
          "gap": "sm",
          "justify": "between"
        },
        "type": "Row"
      },
      "loading": {
        "children": [
          "sk1",
          "sk2",
          "sk3"
        ],
        "props": {
          "gap": "sm"
        },
        "type": "Stack",
        "visible": {
          "$state": "/_loading/asana.list_projects"
        }
      },
      "openInAsanaBtn": {
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "target": "_blank",
              "url": "https://app.asana.com/"
            }
          }
        },
        "props": {
          "label": "Open in Asana",
          "size": "sm",
          "tone": "brand",
          "variant": "primary"
        },
        "type": "Button"
      },
      "projectCard": {
        "children": [
          "cardClick"
        ],
        "props": {
          "variant": "muted"
        },
        "type": "Section"
      },
      "sk1": {
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "sk2": {
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "sk3": {
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "sortAz": {
        "children": [
          "sortAzBadge"
        ],
        "on": {
          "click": {
            "action": "setState",
            "params": {
              "statePath": "/ui/sort",
              "value": "low"
            }
          }
        },
        "props": {
          "align": "center",
          "clickable": true
        },
        "type": "Row",
        "visible": {
          "$state": "/ui/board/sort_az_selected"
        }
      },
      "sortAzBadge": {
        "props": {
          "text": "Sort: A–Z",
          "tone": "default",
          "variant": "outline"
        },
        "type": "Badge"
      },
      "sortHigh": {
        "children": [
          "sortHighBadge"
        ],
        "on": {
          "click": {
            "action": "setState",
            "params": {
              "statePath": "/ui/sort",
              "value": "az"
            }
          }
        },
        "props": {
          "align": "center",
          "clickable": true
        },
        "type": "Row",
        "visible": {
          "$state": "/ui/board/sort_high_selected"
        }
      },
      "sortHighBadge": {
        "props": {
          "text": "Sort: Highest %",
          "tone": "default",
          "variant": "outline"
        },
        "type": "Badge"
      },
      "sortLow": {
        "children": [
          "sortLowBadge"
        ],
        "on": {
          "click": {
            "action": "setState",
            "params": {
              "statePath": "/ui/sort",
              "value": "high"
            }
          }
        },
        "props": {
          "align": "center",
          "clickable": true
        },
        "type": "Row",
        "visible": {
          "$state": "/ui/board/sort_low_selected"
        }
      },
      "sortLowBadge": {
        "props": {
          "text": "Sort: Lowest %",
          "tone": "default",
          "variant": "outline"
        },
        "type": "Badge"
      },
      "sortToggle": {
        "children": [
          "sortLow",
          "sortHigh",
          "sortAz"
        ],
        "props": {
          "align": "center"
        },
        "type": "Row"
      },
      "title": {
        "props": {
          "level": "h2",
          "text": "Project Progress"
        },
        "type": "Heading"
      },
      "titleGroup": {
        "children": [
          "titleIcon",
          "titleStack"
        ],
        "props": {
          "align": "center",
          "gap": "sm"
        },
        "type": "Row"
      },
      "titleIcon": {
        "props": {
          "name": "TrendingUp",
          "size": "sm",
          "tone": "success"
        },
        "type": "Icon"
      },
      "titleStack": {
        "children": [
          "title",
          "eyebrow"
        ],
        "props": {
          "gap": "none"
        },
        "type": "Stack"
      }
    },
    "root": "card"
  },
  "tags": [
    "asana",
    "projects",
    "progress",
    "completion",
    "at risk"
  ],
  "title": "Project Progress"
}
