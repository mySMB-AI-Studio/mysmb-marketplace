{
  "category": "projects",
  "connectorsUsed": [
    "asana"
  ],
  "dataProvider": {
    "kind": "tool",
    "mcp": "asana",
    "params": {
      "archived": false,
      "limit": 10
    },
    "tool": "list_projects"
  },
  "description": "Task completion progress for your active Asana projects with at-risk and behind counts.",
  "id": "asana-project-progress",
  "keywords": [
    "asana projects",
    "project progress",
    "task completion",
    "at risk",
    "behind"
  ],
  "popularity": 65,
  "sizing": {
    "max": {
      "colSpan": 8,
      "rowSpan": 12
    },
    "min": {
      "colSpan": 3,
      "rowSpan": 4
    },
    "preferred": {
      "colSpan": 5,
      "rowSpan": 6
    }
  },
  "spec": {
    "elements": {
      "card": {
        "children": [
          "headerRow",
          "div0",
          "loading",
          "empty",
          "kpiGrid",
          "div1",
          "projectList",
          "projectFooter"
        ],
        "props": {},
        "type": "Card",
        "watch": {
          "/asana/list_projects/data": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/rows",
                "value": {
                  "$computed": "asana_flatten_project_progress",
                  "args": {
                    "value": {
                      "$state": "/asana/list_projects/data"
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "div0": {
        "props": {},
        "type": "Divider"
      },
      "div1": {
        "props": {},
        "type": "Divider",
        "visible": {
          "$and": [
            {
              "$state": "/_loading/asana.list_projects",
              "not": true
            },
            {
              "$state": "/ui/rows/0"
            }
          ]
        }
      },
      "empty": {
        "props": {
          "message": "No active projects found."
        },
        "type": "Empty",
        "visible": {
          "$and": [
            {
              "$state": "/_loading/asana.list_projects",
              "not": true
            },
            {
              "$state": "/ui/rows/0",
              "not": true
            }
          ]
        }
      },
      "eyebrow": {
        "props": {
          "text": "Asana"
        },
        "type": "Eyebrow"
      },
      "headerRow": {
        "children": [
          "titleGroup"
        ],
        "props": {
          "align": "center",
          "justify": "between"
        },
        "type": "Row"
      },
      "kpiGrid": {
        "children": [
          "tileActive",
          "tileAtRisk",
          "tileBehind"
        ],
        "props": {
          "cols": 3,
          "gap": "sm"
        },
        "type": "Grid",
        "visible": {
          "$and": [
            {
              "$state": "/_loading/asana.list_projects",
              "not": true
            },
            {
              "$state": "/ui/rows/0"
            }
          ]
        }
      },
      "lblActive": {
        "props": {
          "text": "Active",
          "tone": "muted"
        },
        "type": "Caption"
      },
      "lblAtRisk": {
        "props": {
          "text": "At Risk",
          "tone": "warning"
        },
        "type": "Caption"
      },
      "lblBehind": {
        "props": {
          "text": "Behind",
          "tone": "destructive"
        },
        "type": "Caption"
      },
      "loading": {
        "children": [
          "sk1",
          "sk2",
          "sk3"
        ],
        "props": {
          "gap": "sm"
        },
        "type": "Stack",
        "visible": {
          "$state": "/_loading/asana.list_projects"
        }
      },
      "projectBar": {
        "props": {
          "tone": {
            "$item": "tone"
          },
          "value": {
            "$item": "pct"
          }
        },
        "type": "ProgressBar"
      },
      "projectBarRow": {
        "children": [
          "projectBar"
        ],
        "props": {},
        "type": "Row"
      },
      "projectFooter": {
        "props": {
          "text": {
            "$state": "/ui/rows/0/footer_label"
          },
          "tone": "muted"
        },
        "type": "Caption",
        "visible": {
          "$state": "/ui/rows/0/footer_label"
        }
      },
      "projectHeader": {
        "children": [
          "projectName",
          "projectPct"
        ],
        "props": {
          "align": "center",
          "justify": "between"
        },
        "type": "Row"
      },
      "projectList": {
        "children": [
          "projectRow"
        ],
        "props": {
          "gap": "md"
        },
        "repeat": {
          "key": "id",
          "statePath": "/ui/rows"
        },
        "type": "Stack",
        "visible": {
          "$and": [
            {
              "$state": "/_loading/asana.list_projects",
              "not": true
            },
            {
              "$state": "/ui/rows/0"
            }
          ]
        }
      },
      "projectName": {
        "props": {
          "size": "sm",
          "text": {
            "$item": "name"
          },
          "weight": "semibold"
        },
        "type": "Text"
      },
      "projectPct": {
        "props": {
          "size": "sm",
          "text": {
            "$item": "pct_label"
          },
          "tone": {
            "$item": "tone"
          },
          "weight": "semibold"
        },
        "type": "Text"
      },
      "projectRow": {
        "children": [
          "projectHeader",
          "projectBarRow"
        ],
        "props": {
          "gap": "xs"
        },
        "type": "Stack"
      },
      "sk1": {
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "sk2": {
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "sk3": {
        "props": {
          "height": "2.5rem",
          "rounded": "md"
        },
        "type": "Skeleton"
      },
      "stackActive": {
        "children": [
          "valActive",
          "lblActive"
        ],
        "props": {
          "align": "center",
          "gap": "none"
        },
        "type": "Stack"
      },
      "stackAtRisk": {
        "children": [
          "valAtRisk",
          "lblAtRisk"
        ],
        "props": {
          "align": "center",
          "gap": "none"
        },
        "type": "Stack"
      },
      "stackBehind": {
        "children": [
          "valBehind",
          "lblBehind"
        ],
        "props": {
          "align": "center",
          "gap": "none"
        },
        "type": "Stack"
      },
      "tileActive": {
        "children": [
          "stackActive"
        ],
        "props": {
          "variant": "muted"
        },
        "type": "Section"
      },
      "tileAtRisk": {
        "children": [
          "stackAtRisk"
        ],
        "props": {
          "variant": "muted"
        },
        "type": "Section"
      },
      "tileBehind": {
        "children": [
          "stackBehind"
        ],
        "props": {
          "variant": "muted"
        },
        "type": "Section"
      },
      "title": {
        "props": {
          "level": "h2",
          "text": "Project Progress"
        },
        "type": "Heading"
      },
      "titleGroup": {
        "children": [
          "titleIcon",
          "titleStack"
        ],
        "props": {
          "align": "center",
          "gap": "sm"
        },
        "type": "Row"
      },
      "titleIcon": {
        "props": {
          "name": "TrendingUp",
          "size": "sm",
          "tone": "success"
        },
        "type": "Icon"
      },
      "titleStack": {
        "children": [
          "title",
          "eyebrow"
        ],
        "props": {
          "gap": "none"
        },
        "type": "Stack"
      },
      "valActive": {
        "props": {
          "size": "md",
          "value": {
            "$state": "/ui/rows/0/stat_active"
          }
        },
        "type": "Stat"
      },
      "valAtRisk": {
        "props": {
          "size": "md",
          "value": {
            "$state": "/ui/rows/0/stat_at_risk"
          }
        },
        "type": "Stat"
      },
      "valBehind": {
        "props": {
          "size": "md",
          "value": {
            "$state": "/ui/rows/0/stat_behind"
          }
        },
        "type": "Stat"
      }
    },
    "root": "card"
  },
  "tags": [
    "asana",
    "projects",
    "progress",
    "completion",
    "at risk"
  ],
  "title": "Project Progress"
}
