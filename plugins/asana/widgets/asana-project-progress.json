{
  "id": "asana-project-progress",
  "title": "Project Progress",
  "description": "Task completion progress for your active Asana projects with at-risk and behind counts.",
  "category": "projects",
  "tags": ["asana", "projects", "progress", "completion", "at risk"],
  "keywords": ["asana projects", "project progress", "task completion", "at risk", "behind"],
  "connectorsUsed": ["asana"],
  "popularity": 65,
  "sizing": {
    "preferred": { "colSpan": 5, "rowSpan": 6 },
    "min": { "colSpan": 3, "rowSpan": 4 },
    "max": { "colSpan": 8, "rowSpan": 12 }
  },
  "dataProvider": {
    "mcp": "asana",
    "tool": "list_projects",
    "params": { "archived": false, "limit": 10 }
  },
  "spec": {
    "root": "card",
    "elements": {

      "card": {
        "type": "Card",
        "props": {},
        "children": ["headerRow", "div0", "loading", "empty", "kpiGrid", "div1", "projectList", "projectFooter"],
        "watch": {
          "/asana/list_projects/data": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/rows",
                "value": {
                  "$computed": "asana_flatten_project_progress",
                  "args": { "value": { "$state": "/asana/list_projects/data" } }
                }
              }
            }
          ]
        }
      },

      "headerRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["titleGroup"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": { "type": "Icon", "props": { "name": "TrendingUp", "tone": "success", "size": "sm" } },
      "titleStack": { "type": "Stack", "props": { "gap": "none" }, "children": ["title", "eyebrow"] },
      "title": { "type": "Heading", "props": { "text": "Project Progress", "level": "h2" } },
      "eyebrow": { "type": "Eyebrow", "props": { "text": "Asana" } },

      "div0": { "type": "Divider", "props": {} },

      "loading": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["sk1", "sk2", "sk3"],
        "visible": { "$state": "/_loading/asana.list_projects" }
      },
      "sk1": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "sk2": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "sk3": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },

      "empty": {
        "type": "Empty",
        "props": { "message": "No active projects found." },
        "visible": {
          "$and": [
            { "$state": "/_loading/asana.list_projects", "not": true },
            { "$state": "/ui/rows/0", "not": true }
          ]
        }
      },

      "kpiGrid": {
        "type": "Grid",
        "props": { "cols": 3, "gap": "sm" },
        "children": ["tileActive", "tileAtRisk", "tileBehind"],
        "visible": {
          "$and": [
            { "$state": "/_loading/asana.list_projects", "not": true },
            { "$state": "/ui/rows/0" }
          ]
        }
      },

      "tileActive": { "type": "Section", "props": { "variant": "muted" }, "children": ["stackActive"] },
      "stackActive": { "type": "Stack", "props": { "gap": "none", "align": "center" }, "children": ["valActive", "lblActive"] },
      "valActive": { "type": "Stat", "props": { "value": { "$state": "/ui/rows/0/stat_active" }, "size": "md" } },
      "lblActive": { "type": "Caption", "props": { "text": "Active", "tone": "muted" } },

      "tileAtRisk": { "type": "Section", "props": { "variant": "muted" }, "children": ["stackAtRisk"] },
      "stackAtRisk": { "type": "Stack", "props": { "gap": "none", "align": "center" }, "children": ["valAtRisk", "lblAtRisk"] },
      "valAtRisk": { "type": "Stat", "props": { "value": { "$state": "/ui/rows/0/stat_at_risk" }, "size": "md" } },
      "lblAtRisk": { "type": "Caption", "props": { "text": "At Risk", "tone": "warning" } },

      "tileBehind": { "type": "Section", "props": { "variant": "muted" }, "children": ["stackBehind"] },
      "stackBehind": { "type": "Stack", "props": { "gap": "none", "align": "center" }, "children": ["valBehind", "lblBehind"] },
      "valBehind": { "type": "Stat", "props": { "value": { "$state": "/ui/rows/0/stat_behind" }, "size": "md" } },
      "lblBehind": { "type": "Caption", "props": { "text": "Behind", "tone": "destructive" } },

      "div1": {
        "type": "Divider",
        "props": {},
        "visible": {
          "$and": [
            { "$state": "/_loading/asana.list_projects", "not": true },
            { "$state": "/ui/rows/0" }
          ]
        }
      },

      "projectList": {
        "type": "Stack",
        "props": { "gap": "md" },
        "children": ["projectRow"],
        "repeat": { "statePath": "/ui/rows", "key": "id" },
        "visible": {
          "$and": [
            { "$state": "/_loading/asana.list_projects", "not": true },
            { "$state": "/ui/rows/0" }
          ]
        }
      },

      "projectRow": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["projectHeader", "projectBarRow"]
      },
      "projectBarRow": { "type": "Row", "props": {}, "children": ["projectBar"] },
      "projectHeader": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["projectName", "projectPct"]
      },
      "projectName": {
        "type": "Text",
        "props": { "text": { "$item": "name" }, "size": "sm", "weight": "semibold" }
      },
      "projectPct": {
        "type": "Text",
        "props": {
          "text": { "$item": "pct_label" },
          "size": "sm",
          "weight": "semibold",
          "tone": { "$item": "tone" }
        }
      },
      "projectBar": {
        "type": "ProgressBar",
        "props": { "value": { "$item": "pct" }, "tone": { "$item": "tone" } }
      },

      "projectFooter": {
        "type": "Caption",
        "props": { "text": { "$state": "/ui/rows/0/footer_label" }, "tone": "muted" },
        "visible": { "$state": "/ui/rows/0/footer_label" }
      }

    }
  },
  "status": "published"
}
