{
  "id": "square-customers",
  "title": "Square — Customers",
  "description": "Customer list enriched with order count, total spent, and last visit date — sorted by highest spender.",
  "category": "sales",
  "tags": ["square", "customers", "crm", "orders", "spending"],
  "keywords": ["customers", "clients", "square", "orders", "spending", "last visit", "top customers"],
  "connectorsUsed": ["square"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 6, "rowSpan": 5 },
    "min": { "colSpan": 4, "rowSpan": 4 },
    "max": { "colSpan": 12, "rowSpan": 10 }
  },
  "dataProvider": {
    "mcp": "square",
    "tool": "get_customer_orders_summary",
    "params": { "limit": 50 }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": ["header", "statsStrip", "body"]
      },

      "header": {
        "type": "Header",
        "children": ["titleGroup"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIconBox", "titleStack"]
      },
      "titleIconBox": {
        "type": "Section",
        "props": { "tone": "info" },
        "children": ["titleIcon"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "Users", "tone": "accent", "size": "md" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "eyebrow"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Customers", "level": "h2" }
      },
      "eyebrow": {
        "type": "Eyebrow",
        "props": { "text": "Square", "tone": "accent" }
      },

      "statsStrip": {
        "type": "Grid",
        "props": { "cols": 3, "gap": "sm" },
        "children": ["totalBox", "activeBox", "avgBox"]
      },

      "totalBox": {
        "type": "Section",
        "props": { "variant": "bordered" },
        "children": ["totalLabelRow", "totalValue"]
      },
      "totalLabelRow": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["totalIcon", "totalLabel"]
      },
      "totalIcon": {
        "type": "Icon",
        "props": { "name": "Users", "tone": "accent", "size": "xs" }
      },
      "totalLabel": {
        "type": "Eyebrow",
        "props": { "text": "Total" }
      },
      "totalValue": {
        "type": "Stat",
        "props": {
          "value": { "$state": "/square/get_customer_orders_summary/total_count" },
          "size": "sm",
          "tone": "accent"
        }
      },

      "activeBox": {
        "type": "Section",
        "props": { "variant": "bordered" },
        "children": ["activeLabelRow", "activeValue"]
      },
      "activeLabelRow": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["activeIcon", "activeLabel"]
      },
      "activeIcon": {
        "type": "Icon",
        "props": { "name": "UserCheck", "tone": "success", "size": "xs" }
      },
      "activeLabel": {
        "type": "Eyebrow",
        "props": { "text": "With Orders" }
      },
      "activeValue": {
        "type": "Stat",
        "props": {
          "value": { "$state": "/square/get_customer_orders_summary/active_count" },
          "size": "sm",
          "tone": "success"
        }
      },

      "avgBox": {
        "type": "Section",
        "props": { "variant": "bordered" },
        "children": ["avgLabelRow", "avgValue"]
      },
      "avgLabelRow": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["avgIcon", "avgLabel"]
      },
      "avgIcon": {
        "type": "Icon",
        "props": { "name": "TrendingUp", "tone": "info", "size": "xs" }
      },
      "avgLabel": {
        "type": "Eyebrow",
        "props": { "text": "Avg Spend" }
      },
      "avgValue": {
        "type": "Stat",
        "props": {
          "value": { "$state": "/square/get_customer_orders_summary/avg_spend_display" },
          "size": "sm",
          "tone": "info"
        }
      },

      "body": {
        "type": "Body",
        "props": {},
        "children": ["table"]
      },
      "table": {
        "type": "Table",
        "props": {
          "loading": { "$state": "/_loading/square.get_customer_orders_summary" },
          "skeletonRows": 5,
          "rows": { "$state": "/square/get_customer_orders_summary/customers" },
          "columns": [
            { "id": "name",    "header": "Customer",    "field": "name",                "priority": 1 },
            { "id": "orders",  "header": "Orders",      "field": "order_count",         "width": 90,  "priority": 1, "align": "right" },
            { "id": "spent",   "header": "Total Spent", "field": "total_spent_display", "width": 150, "priority": 1, "align": "right" },
            { "id": "visit",   "header": "Last Visit",  "field": "last_visit",          "width": 110, "priority": 2 }
          ]
        }
      }
    }
  },
  "status": "published"
}
