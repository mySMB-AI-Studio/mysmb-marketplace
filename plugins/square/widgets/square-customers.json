{
  "id": "square-customers",
  "title": "Square — Customers",
  "description": "Customer list enriched with order count, total spent, and last visit date — sorted by highest spender.",
  "category": "sales",
  "tags": ["square", "customers", "crm", "orders", "spending"],
  "keywords": ["customers", "clients", "square", "orders", "spending", "last visit", "top customers"],
  "connectorsUsed": ["square"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 6, "rowSpan": 4 },
    "min": { "colSpan": 4, "rowSpan": 3 },
    "max": { "colSpan": 12, "rowSpan": 10 }
  },
  "dataProvider": {
    "mcp": "square",
    "tool": "get_customer_orders_summary",
    "params": { "limit": 50 }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": ["header", "body"]
      },

      "header": {
        "type": "Header",
        "children": ["titleGroup"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "start" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "Users", "tone": "accent", "size": "sm" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "eyebrow"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Customers", "level": "h2" }
      },
      "eyebrow": {
        "type": "Eyebrow",
        "props": { "text": "Square" }
      },

      "body": {
        "type": "Body",
        "props": {},
        "children": ["table"]
      },
      "table": {
        "type": "Table",
        "props": {
          "loading": { "$state": "/_loading/square.get_customer_orders_summary" },
          "skeletonRows": 5,
          "rows": { "$state": "/square/get_customer_orders_summary/customers" },
          "columns": [
            { "id": "name",    "header": "Customer",    "field": "name",                "priority": 1 },
            { "id": "orders",  "header": "Orders",      "field": "order_count",         "width": 90,  "priority": 1, "align": "right" },
            { "id": "spent",   "header": "Total Spent", "field": "total_spent_display", "width": 150, "priority": 1, "align": "right" },
            { "id": "visit",   "header": "Last Visit",  "field": "last_visit",          "width": 110, "priority": 2 }
          ]
        }
      }
    }
  },
  "status": "published"
}
