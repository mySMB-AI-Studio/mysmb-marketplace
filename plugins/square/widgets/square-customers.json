{
  "id": "square-customers",
  "title": "Square — Customers",
  "description": "List of Square customers — name, email, phone, and creation date. Use to explore your customer directory.",
  "category": "sales",
  "tags": ["square", "customers", "crm", "directory"],
  "keywords": ["customers", "clients", "square", "directory", "contacts"],
  "connectorsUsed": ["square"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 5, "rowSpan": 5 },
    "min": { "colSpan": 4, "rowSpan": 4 },
    "max": { "colSpan": 10, "rowSpan": 12 }
  },
  "dataProvider": {
    "mcp": "square",
    "tool": "make_api_request",
    "params": { "service": "customers", "method": "list", "request": { "sort_field": "CREATED_AT", "sort_order": "DESC" } }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": ["titleRow", "divider", "tableBody"]
      },
      "titleRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["titleGroup"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "Users", "tone": "accent", "size": "sm" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "eyebrow"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Customers", "level": "h2" }
      },
      "eyebrow": {
        "type": "Eyebrow",
        "props": { "text": "Square" }
      },
      "divider": { "type": "Divider", "props": {} },
      "tableBody": {
        "type": "Body",
        "props": {},
        "children": ["table"]
      },
      "table": {
        "type": "Table",
        "props": {
          "loading": { "$state": "/_loading/square.make_api_request" },
          "skeletonRows": 5,
          "rows": { "$state": "/square/make_api_request/customers" },
          "columns": [
            { "id": "name", "header": "First Name", "field": "given_name", "priority": 1 },
            { "id": "surname", "header": "Last Name", "field": "family_name", "width": 140, "priority": 1 },
            { "id": "company", "header": "Company", "field": "company_name", "width": 160, "priority": 2 },
            { "id": "email", "header": "Email", "field": "email_address", "priority": 1 },
            { "id": "phone", "header": "Phone", "field": "phone_number", "width": 140, "priority": 2 },
            { "id": "created", "header": "Created", "field": "created_at", "width": 160, "priority": 3, "format": "datetime" }
          ]
        }
      }
    }
  },
  "status": "published"
}
