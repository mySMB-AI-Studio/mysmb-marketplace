{
  "id": "square-sales-summary",
  "title": "Square — Sales Summary",
  "description": "Recent gross sales, transaction count, average sale, and net sales after refunds — all in one compact card.",
  "category": "finance",
  "tags": ["square", "payments", "sales", "summary", "pos", "finance"],
  "keywords": ["sales", "revenue", "gross", "net", "refunds", "transactions", "average", "square", "today"],
  "connectorsUsed": ["square"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 4, "rowSpan": 6 },
    "min": { "colSpan": 3, "rowSpan": 5 },
    "max": { "colSpan": 8, "rowSpan": 9 }
  },
  "dataProvider": {
    "mcp": "square",
    "tool": "get_payments_summary",
    "params": {}
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": ["header", "grossSection", "statsGrid", "netSection"]
      },

      "header": {
        "type": "Header",
        "children": ["titleGroup"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIconBox", "titleStack"]
      },
      "titleIconBox": {
        "type": "Section",
        "props": { "tone": "info" },
        "children": ["titleIcon"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "TrendingUp", "tone": "accent", "size": "md" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "eyebrow"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Sales Summary", "level": "h2" }
      },
      "eyebrow": {
        "type": "Eyebrow",
        "props": { "text": "Square", "tone": "info" }
      },

      "grossSection": {
        "type": "Section",
        "props": { "variant": "bordered" },
        "children": ["grossLabelRow", "grossAmount"]
      },
      "grossLabelRow": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["grossIcon", "grossLabel"]
      },
      "grossIcon": {
        "type": "Icon",
        "props": { "name": "DollarSign", "tone": "success", "size": "xs" }
      },
      "grossLabel": {
        "type": "Eyebrow",
        "props": { "text": "Gross sales · recent" }
      },
      "grossAmount": {
        "type": "Stat",
        "props": {
          "value": { "$state": "/square/get_payments_summary/gross_display" },
          "tone": "success"
        }
      },

      "statsGrid": {
        "type": "Grid",
        "props": { "cols": 2, "gap": "sm" },
        "children": ["txBox", "avgBox"]
      },
      "txBox": {
        "type": "Section",
        "props": { "variant": "bordered" },
        "children": ["txLabelRow", "txValue"]
      },
      "txLabelRow": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["txIcon", "txLabel"]
      },
      "txIcon": {
        "type": "Icon",
        "props": { "name": "ShoppingCart", "tone": "accent", "size": "xs" }
      },
      "txLabel": {
        "type": "Eyebrow",
        "props": { "text": "Transactions" }
      },
      "txValue": {
        "type": "Stat",
        "props": {
          "value": { "$state": "/square/get_payments_summary/transaction_count" },
          "size": "sm",
          "tone": "accent"
        }
      },
      "avgBox": {
        "type": "Section",
        "props": { "variant": "bordered" },
        "children": ["avgLabelRow", "avgValue"]
      },
      "avgLabelRow": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["avgIcon", "avgLabel"]
      },
      "avgIcon": {
        "type": "Icon",
        "props": { "name": "Tag", "tone": "info", "size": "xs" }
      },
      "avgLabel": {
        "type": "Eyebrow",
        "props": { "text": "Average sale" }
      },
      "avgValue": {
        "type": "Stat",
        "props": {
          "value": { "$state": "/square/get_payments_summary/average_display" },
          "size": "sm",
          "tone": "info"
        }
      },

      "netSection": {
        "type": "Section",
        "props": { "variant": "bordered" },
        "children": ["netTop", "netValue"]
      },
      "netTop": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["netLabelRow", "refundBadge"]
      },
      "netLabelRow": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["netIcon", "netLabel"]
      },
      "netIcon": {
        "type": "Icon",
        "props": { "name": "ReceiptText", "tone": "success", "size": "xs" }
      },
      "netLabel": {
        "type": "Eyebrow",
        "props": { "text": "Net sales (after refunds)" }
      },
      "refundBadge": {
        "type": "Badge",
        "props": {
          "text": { "$state": "/square/get_payments_summary/refund_badge_label" },
          "tone": "warning",
          "variant": "soft"
        }
      },
      "netValue": {
        "type": "Stat",
        "props": {
          "value": { "$state": "/square/get_payments_summary/net_display" },
          "size": "sm",
          "tone": "success"
        }
      }
    }
  },
  "status": "published"
}
