{
  "id": "square-payments-summary",
  "title": "Latest Payments",
  "description": "The money Square has taken most recently, newest first. Three figures lead — the total across the payments shown, the average size of one, and the largest single payment — then each payment is listed with who paid, how they paid and at what time, and what it came to. A bar beside each amount compares it to the largest in the window, so an unusually big or small sale stands out without reading the numbers; the largest is badged outright. Card payments carry the brand and last four digits; cash and recorded payments simply show the time.",
  "category": "finance",
  "tags": ["square", "payments", "pos", "transactions", "finance"],
  "keywords": ["payments", "transactions", "square", "pos", "revenue", "collected", "latest", "takings", "largest payment", "average payment"],
  "connectorsUsed": ["square"],
  "popularity": 0,
  "branding": { "color": "#2ec4b6" },
  "brandColor": "#2ec4b6",
  "sizing": {
    "preferred": { "colSpan": 6, "rowSpan": 5 },
    "min": { "colSpan": 5, "rowSpan": 4 },
    "max": { "colSpan": 10, "rowSpan": 12 }
  },
  "dataProvider": {
    "mcp": "square",
    "tool": "get_latest_payments",
    "params": { "limit": 10 }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": ["header", "loading", "kpiStrip", "emptyPanel", "body", "footer"],
        "watch": {
          "/square/get_latest_payments/payments": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/board",
                "value": {
                  "$computed": "square_payment_board",
                  "args": {
                    "value": { "$state": "/square/get_latest_payments/payments" }
                  }
                }
              }
            }
          ]
        }
      },

      "header": {
        "type": "Header",
        "props": {},
        "children": ["titleGroup"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "start" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "CreditCard", "tone": "brand", "size": "sm" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["title", "eyebrow"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Latest Payments", "level": "h2" }
      },
      "eyebrow": {
        "type": "Eyebrow",
        "props": { "text": "SQUARE · PAYMENTS TAKEN" }
      },

      "loading": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["skKpi", "sk1", "sk2", "sk3", "sk4"],
        "visible": { "$state": "/_loading/square.get_latest_payments" }
      },
      "skKpi": { "type": "Skeleton", "props": { "height": "5.5rem", "rounded": "md" } },
      "sk1": { "type": "Skeleton", "props": { "height": "3rem", "rounded": "md" } },
      "sk2": { "type": "Skeleton", "props": { "height": "3rem", "rounded": "md" } },
      "sk3": { "type": "Skeleton", "props": { "height": "3rem", "rounded": "md" } },
      "sk4": { "type": "Skeleton", "props": { "height": "3rem", "rounded": "md" } },

      "kpiStrip": {
        "type": "Grid",
        "props": { "cols": 3, "gap": "sm" },
        "children": ["kpiTotal", "kpiAverage", "kpiLargest"],
        "visible": {
          "$and": [
            { "$state": "/_loading/square.get_latest_payments", "not": true },
            { "$state": "/square/get_latest_payments/payments/0" }
          ]
        }
      },

      "kpiTotal": {
        "type": "Section",
        "props": { "variant": "muted" },
        "children": ["totalStack"]
      },
      "totalStack": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["totalHead", "totalValue", "totalNote"]
      },
      "totalHead": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["totalDot", "totalLabel"]
      },
      "totalDot": { "type": "Dot", "props": { "tone": "brand", "size": "sm" } },
      "totalLabel": { "type": "Eyebrow", "props": { "text": "TOTAL RECEIVED" } },
      "totalValue": {
        "type": "Heading",
        "props": { "level": "h1", "text": { "$state": "/ui/board/total" } }
      },
      "totalNote": {
        "type": "Caption",
        "props": { "tone": "muted", "text": { "$state": "/ui/board/count_note" } }
      },

      "kpiAverage": {
        "type": "Section",
        "props": { "variant": "muted" },
        "children": ["averageStack"]
      },
      "averageStack": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["averageHead", "averageValue", "averageNote"]
      },
      "averageHead": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["averageDot", "averageLabel"]
      },
      "averageDot": { "type": "Dot", "props": { "tone": "brand", "size": "sm" } },
      "averageLabel": { "type": "Eyebrow", "props": { "text": "AVERAGE" } },
      "averageValue": {
        "type": "Heading",
        "props": { "level": "h1", "text": { "$state": "/ui/board/average" } }
      },
      "averageNote": {
        "type": "Caption",
        "props": { "tone": "muted", "text": "Per payment" }
      },

      "kpiLargest": {
        "type": "Section",
        "props": { "variant": "muted" },
        "children": ["largestStack"]
      },
      "largestStack": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["largestHead", "largestValue", "largestNote"]
      },
      "largestHead": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["largestDot", "largestLabel"]
      },
      "largestDot": { "type": "Dot", "props": { "tone": "brand", "size": "sm" } },
      "largestLabel": { "type": "Eyebrow", "props": { "text": "LARGEST" } },
      "largestValue": {
        "type": "Heading",
        "props": { "level": "h1", "text": { "$state": "/ui/board/largest" } }
      },
      "largestNote": {
        "type": "Caption",
        "props": { "tone": "muted", "text": "Single payment" }
      },

      "emptyPanel": {
        "type": "Section",
        "props": { "variant": "bordered" },
        "children": ["emptyStack"],
        "visible": {
          "$and": [
            { "$state": "/_loading/square.get_latest_payments", "not": true },
            { "$state": "/square/get_latest_payments/payments/0", "not": true }
          ]
        }
      },
      "emptyStack": {
        "type": "Stack",
        "props": { "gap": "sm", "align": "center" },
        "children": ["emptyIcon", "emptyTitle", "emptyNote"]
      },
      "emptyIcon": {
        "type": "Icon",
        "props": { "name": "CreditCard", "tone": "brand", "size": "lg" }
      },
      "emptyTitle": {
        "type": "Text",
        "props": { "text": "No payments yet", "size": "sm", "weight": "medium" }
      },
      "emptyNote": {
        "type": "Caption",
        "props": { "tone": "muted", "text": "Takings appear here as soon as a payment completes in Square." }
      },

      "body": {
        "type": "Body",
        "props": {},
        "children": ["list"],
        "visible": {
          "$and": [
            { "$state": "/_loading/square.get_latest_payments", "not": true },
            { "$state": "/square/get_latest_payments/payments/0" }
          ]
        }
      },

      "list": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["row"],
        "repeat": { "statePath": "/ui/board/rows", "key": "id" }
      },
      "row": {
        "type": "Row",
        "props": {
          "gap": "md",
          "align": "center",
          "hover": true,
          "template": "2.5rem minmax(0, 1fr) 9rem"
        },
        "children": ["iconBox", "identity", "amountCell"]
      },
      "iconBox": {
        "type": "Section",
        "props": { "variant": "muted" },
        "children": ["rowIcon"]
      },
      "rowIcon": {
        "type": "Icon",
        "props": { "name": "Receipt", "tone": "brand", "size": "md" }
      },
      "identity": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["titleRow", "subLabel"]
      },
      "titleRow": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["payerTitle", "largestBadge"]
      },
      "payerTitle": {
        "type": "Text",
        "props": { "text": { "$item": "title" }, "size": "sm", "weight": "medium", "truncate": true }
      },
      "largestBadge": {
        "type": "Badge",
        "props": { "text": "Largest", "tone": "brand", "variant": "soft" },
        "visible": { "$item": "is_largest" }
      },
      "subLabel": {
        "type": "Caption",
        "props": { "tone": "muted", "text": { "$item": "sub_label" } }
      },
      "amountCell": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["amountRow", "amountBarRow"]
      },
      "amountRow": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center", "justify": "end" },
        "children": ["amountText"]
      },
      "amountText": {
        "type": "Text",
        "props": { "text": { "$item": "amount" }, "size": "sm", "weight": "medium" }
      },
      "amountBarRow": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["amountBar"]
      },
      "amountBar": {
        "type": "ProgressBar",
        "props": { "value": { "$item": "amount_pct" }, "tone": "brand" }
      },

      "footer": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["footerDivider", "footerNote"],
        "visible": {
          "$and": [
            { "$state": "/_loading/square.get_latest_payments", "not": true },
            { "$state": "/square/get_latest_payments/payments/0" }
          ]
        }
      },
      "footerDivider": { "type": "Divider", "props": {} },
      "footerNote": {
        "type": "Caption",
        "props": { "tone": "muted", "text": "Newest first. Bars compare each payment to the largest shown." }
      }
    }
  },
  "status": "published"
}
