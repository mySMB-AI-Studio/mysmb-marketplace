{
  "id": "square-payments-summary",
  "title": "Square — Latest Payments",
  "description": "Most recent Square payments with customer name, card details, and amount — sorted newest first.",
  "category": "finance",
  "tags": ["square", "payments", "pos", "transactions", "finance"],
  "keywords": ["payments", "transactions", "square", "pos", "revenue", "collected", "latest"],
  "connectorsUsed": ["square"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 4, "rowSpan": 5 },
    "min": { "colSpan": 3, "rowSpan": 4 },
    "max": { "colSpan": 8, "rowSpan": 12 }
  },
  "dataProvider": {
    "mcp": "square",
    "tool": "get_latest_payments",
    "params": { "limit": 10 }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": ["header", "body"]
      },

      "header": {
        "type": "Header",
        "children": ["titleGroup"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIconBox", "titleStack"]
      },
      "titleIconBox": {
        "type": "Section",
        "props": { "variant": "bordered", "tone": "accent" },
        "children": ["titleIcon"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "CreditCard", "tone": "accent", "size": "md" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "eyebrow"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Latest Payments", "level": "h2" }
      },
      "eyebrow": {
        "type": "Eyebrow",
        "props": { "text": "Square", "tone": "accent" }
      },

      "body": {
        "type": "Body",
        "props": {},
        "children": ["loading", "empty", "list"]
      },
      "loading": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["sk1", "sk2", "sk3", "sk4", "sk5"],
        "visible": { "$state": "/_loading/square.get_latest_payments" }
      },
      "sk1": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "sm" } },
      "sk2": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "sm" } },
      "sk3": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "sm" } },
      "sk4": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "sm" } },
      "sk5": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "sm" } },
      "empty": {
        "type": "Empty",
        "props": { "message": "No payments found." },
        "visible": {
          "$and": [
            { "$state": "/_loading/square.get_latest_payments", "not": true },
            { "$state": "/square/get_latest_payments/payments/0", "not": true }
          ]
        }
      },

      "list": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["paymentRow"],
        "repeat": {
          "statePath": "/square/get_latest_payments/payments",
          "key": "id"
        },
        "visible": { "$state": "/_loading/square.get_latest_payments", "not": true }
      },
      "paymentRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["payerStack", "paymentAmount"]
      },
      "payerStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["payerName", "payerDetails"]
      },
      "payerName": {
        "type": "Text",
        "props": {
          "text": { "$item": "name" },
          "size": "sm",
          "weight": "medium"
        }
      },
      "payerDetails": {
        "type": "Caption",
        "props": {
          "text": { "$item": "sub_label" },
          "tone": "muted"
        }
      },
      "paymentAmount": {
        "type": "Text",
        "props": {
          "text": { "$item": "amount_display" },
          "size": "sm",
          "weight": "medium"
        }
      }
    }
  },
  "status": "published"
}
