{
  "id": "square-payments-summary",
  "title": "Square — Latest Payments",
  "description": "Most recent Square payments with customer name, card details, and amount — sorted newest first.",
  "category": "finance",
  "tags": ["square", "payments", "pos", "transactions", "finance"],
  "keywords": ["payments", "transactions", "square", "pos", "revenue", "collected", "latest"],
  "connectorsUsed": ["square"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 4, "rowSpan": 5 },
    "min": { "colSpan": 3, "rowSpan": 4 },
    "max": { "colSpan": 8, "rowSpan": 12 }
  },
  "dataProvider": {
    "mcp": "square",
    "tool": "get_latest_payments",
    "params": { "limit": 10 }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": ["header", "body"]
      },

      "header": {
        "type": "Header",
        "children": ["titleGroup"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "start" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "CreditCard", "tone": "accent", "size": "sm" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "eyebrow"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Latest Payments", "level": "h2" }
      },
      "eyebrow": {
        "type": "Eyebrow",
        "props": { "text": "Square" }
      },

      "body": {
        "type": "Body",
        "props": {},
        "children": ["table"]
      },
      "table": {
        "type": "Table",
        "props": {
          "loading": { "$state": "/_loading/square.get_latest_payments" },
          "skeletonRows": 5,
          "rows": { "$state": "/square/get_latest_payments/payments" },
          "columns": [
            { "id": "payer",  "header": "Customer", "field": "name", "subField": "sub_label", "subTone": "accent", "priority": 1 },
            { "id": "amount", "header": "Amount",   "field": "amount_display", "width": 120, "priority": 1, "align": "right" }
          ]
        }
      }
    }
  },
  "status": "published"
}
