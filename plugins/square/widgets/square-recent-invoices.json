{
  "id": "square-recent-invoices",
  "title": "Square — Recent Invoices",
  "description": "Recent Square invoices with customer name, amount, status, and due date — sorted newest first.",
  "category": "finance",
  "tags": ["square", "invoices", "billing", "finance", "payments"],
  "keywords": ["invoices", "billing", "square", "due", "paid", "overdue", "sent", "draft"],
  "connectorsUsed": ["square"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 6, "rowSpan": 5 },
    "min": { "colSpan": 5, "rowSpan": 4 },
    "max": { "colSpan": 12, "rowSpan": 10 }
  },
  "dataProvider": {
    "mcp": "square",
    "tool": "get_recent_invoices",
    "params": { "limit": 20 }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": ["header", "body"]
      },

      "header": {
        "type": "Header",
        "children": ["titleGroup"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIconBox", "titleStack"]
      },
      "titleIconBox": {
        "type": "Section",
        "props": { "tone": "info" },
        "children": ["titleIcon"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "FileText", "tone": "info", "size": "md" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "eyebrow"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Recent Invoices", "level": "h2" }
      },
      "eyebrow": {
        "type": "Eyebrow",
        "props": { "text": "Square", "tone": "info" }
      },

      "body": {
        "type": "Body",
        "props": {},
        "children": ["table"]
      },
      "table": {
        "type": "Table",
        "props": {
          "loading": { "$state": "/_loading/square.get_recent_invoices" },
          "skeletonRows": 5,
          "rows": { "$state": "/square/get_recent_invoices/invoices" },
          "columns": [
            { "id": "invoice",  "header": "Invoice",  "field": "invoice_number",  "width": 100, "priority": 1 },
            { "id": "customer", "header": "Customer", "field": "customer_name",               "priority": 1 },
            { "id": "amount",   "header": "Amount",   "field": "amount_display",  "width": 120, "priority": 1, "align": "right" },
            { "id": "status",   "header": "Status",   "field": "status_label",    "width": 110, "priority": 1, "variant": "badge", "tone": "status_tone" },
            { "id": "due",      "header": "Due",      "field": "due_display",     "width": 90,  "priority": 2 }
          ]
        }
      }
    }
  },
  "status": "published"
}
