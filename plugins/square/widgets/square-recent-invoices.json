{
  "id": "square-recent-invoices",
  "title": "Square — Recent Invoices",
  "description": "Recent Square invoices — invoice number, title, status, due date, and amount. Sorted most recent first.",
  "category": "finance",
  "tags": ["square", "invoices", "billing", "finance"],
  "keywords": ["invoices", "billing", "square", "due", "payments"],
  "connectorsUsed": ["square"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 5, "rowSpan": 5 },
    "min": { "colSpan": 4, "rowSpan": 4 },
    "max": { "colSpan": 10, "rowSpan": 12 }
  },
  "dataProvider": {
    "mcp": "square",
    "tool": "make_api_request",
    "params": { "service": "invoices", "method": "list" }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": ["titleRow", "divider", "tableBody"]
      },
      "titleRow": {
        "type": "Row",
        "props": { "justify": "between", "align": "center" },
        "children": ["titleGroup"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIcon", "titleStack"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "FileText", "tone": "warning", "size": "sm" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "eyebrow"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Recent Invoices", "level": "h2" }
      },
      "eyebrow": {
        "type": "Eyebrow",
        "props": { "text": "Square" }
      },
      "divider": { "type": "Divider", "props": {} },
      "tableBody": {
        "type": "Body",
        "props": {},
        "children": ["table"]
      },
      "table": {
        "type": "Table",
        "props": {
          "loading": { "$state": "/_loading/square.make_api_request" },
          "skeletonRows": 5,
          "rows": { "$state": "/square/make_api_request/invoices" },
          "columns": [
            { "id": "invoiceNumber", "header": "Invoice #", "field": "invoice_number", "width": 120, "priority": 1 },
            { "id": "title", "header": "Title", "field": "title", "priority": 1 },
            { "id": "status", "header": "Status", "field": "status", "width": 110, "priority": 1 },
            { "id": "dueDate", "header": "Due Date", "field": "payment_requests.0.due_date", "width": 130, "priority": 1 },
            { "id": "amount", "header": "Amount Due", "field": "payment_requests.0.computed_amount_money.amount", "width": 120, "priority": 1, "format": "currency" }
          ]
        }
      }
    }
  },
  "status": "published"
}
