{
  "id": "square-recent-invoices",
  "title": "Square — Recent Invoices",
  "description": "Recent Square invoices with customer name, amount, status, and due date — sorted newest first.",
  "category": "finance",
  "tags": ["square", "invoices", "billing", "finance", "payments"],
  "keywords": ["invoices", "billing", "square", "due", "paid", "overdue", "sent", "draft"],
  "connectorsUsed": ["square"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 6, "rowSpan": 5 },
    "min": { "colSpan": 5, "rowSpan": 5 },
    "max": { "colSpan": 12, "rowSpan": 10 }
  },
  "dataProvider": {
    "mcp": "square",
    "tool": "get_recent_invoices",
    "params": { "limit": 20 }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": ["header", "mainContent"]
      },
      "mainContent": {
        "type": "Stack",
        "props": { "gap": "lg" },
        "children": ["statsStrip", "body"]
      },

      "header": {
        "type": "Header",
        "children": ["titleGroup"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIconBox", "titleStack"]
      },
      "titleIconBox": {
        "type": "Section",
        "props": { "tone": "info" },
        "children": ["titleIcon"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "FileText", "tone": "info", "size": "md" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "eyebrow"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Recent Invoices", "level": "h2" }
      },
      "eyebrow": {
        "type": "Eyebrow",
        "props": { "text": "Square", "tone": "info" }
      },

      "statsStrip": {
        "type": "Grid",
        "props": { "cols": 3, "gap": "sm" },
        "children": ["totalBox", "outstandingBox", "overdueBox"]
      },
      "totalBox": {
        "type": "Section",
        "props": { "variant": "bordered" },
        "children": ["totalLabelRow", "totalValue"]
      },
      "totalLabelRow": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["totalIcon", "totalLabel"]
      },
      "totalIcon":  { "type": "Icon",    "props": { "name": "FileText",    "tone": "info",        "size": "xs" } },
      "totalLabel": { "type": "Eyebrow", "props": { "text": "Total" } },
      "totalValue": {
        "type": "Stat",
        "props": { "value": { "$state": "/square/get_recent_invoices/total_count" }, "size": "sm", "tone": "info" }
      },

      "outstandingBox": {
        "type": "Section",
        "props": { "variant": "bordered" },
        "children": ["outstandingLabelRow", "outstandingValue"]
      },
      "outstandingLabelRow": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["outstandingIcon", "outstandingLabel"]
      },
      "outstandingIcon":  { "type": "Icon",    "props": { "name": "Clock",        "tone": "warning",     "size": "xs" } },
      "outstandingLabel": { "type": "Eyebrow", "props": { "text": "Outstanding" } },
      "outstandingValue": {
        "type": "Stat",
        "props": { "value": { "$state": "/square/get_recent_invoices/outstanding_display" }, "size": "sm", "tone": "warning" }
      },

      "overdueBox": {
        "type": "Section",
        "props": { "variant": "bordered" },
        "children": ["overdueLabelRow", "overdueValue"]
      },
      "overdueLabelRow": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["overdueIcon", "overdueLabel"]
      },
      "overdueIcon":  { "type": "Icon",    "props": { "name": "AlertCircle", "tone": "destructive", "size": "xs" } },
      "overdueLabel": { "type": "Eyebrow", "props": { "text": "Overdue" } },
      "overdueValue": {
        "type": "Stat",
        "props": { "value": { "$state": "/square/get_recent_invoices/overdue_count" }, "size": "sm", "tone": "destructive" }
      },

      "body": {
        "type": "Body",
        "props": {},
        "children": ["loading", "invoiceEmpty", "listHeader", "list"]
      },

      "loading": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["sk1", "sk2", "sk3", "sk4"],
        "visible": { "$state": "/_loading/square.get_recent_invoices" }
      },
      "sk1": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "sk2": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "sk3": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "sk4": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },

      "invoiceEmpty": {
        "type": "Empty",
        "props": { "message": "No invoices found." },
        "visible": {
          "$and": [
            { "$state": "/_loading/square.get_recent_invoices", "not": true },
            { "$state": "/square/get_recent_invoices/invoices/0", "not": true }
          ]
        }
      },

      "listHeader": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center",
          "template": "minmax(0, 1fr) 5.5rem 7rem 6.5rem 6rem",
          "padded": true
        },
        "children": ["hdrCustomer", "hdrInvoice", "hdrAmount", "hdrStatus", "hdrDue"],
        "visible": {
          "$and": [
            { "$state": "/_loading/square.get_recent_invoices", "not": true },
            { "$state": "/square/get_recent_invoices/invoices/0" }
          ]
        }
      },
      "hdrCustomer": { "type": "Caption", "props": { "text": "Customer" } },
      "hdrInvoice":  { "type": "Caption", "props": { "text": "Invoice" } },
      "hdrAmount":   { "type": "Caption", "props": { "text": "Amount" } },
      "hdrStatus":   { "type": "Caption", "props": { "text": "Status" } },
      "hdrDue":      { "type": "Caption", "props": { "text": "Due" } },

      "list": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["invoiceRow"],
        "repeat": { "statePath": "/square/get_recent_invoices/invoices", "key": "id" },
        "visible": {
          "$and": [
            { "$state": "/_loading/square.get_recent_invoices", "not": true },
            { "$state": "/square/get_recent_invoices/invoices/0" }
          ]
        }
      },

      "invoiceRow": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "center",
          "hover": true,
          "template": "minmax(0, 1fr) 5.5rem 7rem 6rem 6rem"
        },
        "children": ["rowCustomer", "rowInvoice", "rowAmount", "rowStatus", "rowDue"]
      },
      "rowCustomer": {
        "type": "Text",
        "props": { "text": { "$item": "customer_name" }, "size": "sm", "weight": "medium", "truncate": true }
      },
      "rowInvoice": {
        "type": "Caption",
        "props": { "text": { "$item": "invoice_number" }, "truncate": true }
      },
      "rowAmount": {
        "type": "Caption",
        "props": { "text": { "$item": "amount_display" } }
      },
      "rowStatus": {
        "type": "Text",
        "props": {
          "text": { "$item": "status_label" },
          "tone": { "$item": "status_tone" },
          "size": "sm"
        }
      },
      "rowDue": {
        "type": "Caption",
        "props": { "text": { "$item": "due_display" } }
      }
    }
  },
  "status": "published"
}
