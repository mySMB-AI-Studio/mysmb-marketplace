{
  "id": "square-recent-invoices",
  "title": "Square — Recent Invoices",
  "description": "Recent Square invoices with customer name, amount, status, and due date — sorted newest first.",
  "category": "finance",
  "tags": ["square", "invoices", "billing", "finance", "payments"],
  "keywords": ["invoices", "billing", "square", "due", "paid", "overdue", "sent", "draft"],
  "connectorsUsed": ["square"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 6, "rowSpan": 6 },
    "min": { "colSpan": 5, "rowSpan": 5 },
    "max": { "colSpan": 12, "rowSpan": 10 }
  },
  "dataProvider": {
    "mcp": "square",
    "tool": "get_recent_invoices",
    "params": { "limit": 20 }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": ["header", "statsStrip", "body"]
      },

      "header": {
        "type": "Header",
        "children": ["titleGroup"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIconBox", "titleStack"]
      },
      "titleIconBox": {
        "type": "Section",
        "props": { "tone": "info" },
        "children": ["titleIcon"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "FileText", "tone": "info", "size": "md" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "eyebrow"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Recent Invoices", "level": "h2" }
      },
      "eyebrow": {
        "type": "Eyebrow",
        "props": { "text": "Square", "tone": "info" }
      },

      "statsStrip": {
        "type": "Grid",
        "props": { "cols": 3, "gap": "sm" },
        "children": ["totalBox", "outstandingBox", "overdueBox"]
      },

      "totalBox": {
        "type": "Section",
        "props": { "variant": "bordered" },
        "children": ["totalLabelRow", "totalValue"]
      },
      "totalLabelRow": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["totalIcon", "totalLabel"]
      },
      "totalIcon": {
        "type": "Icon",
        "props": { "name": "FileText", "tone": "info", "size": "xs" }
      },
      "totalLabel": {
        "type": "Eyebrow",
        "props": { "text": "Total" }
      },
      "totalValue": {
        "type": "Stat",
        "props": {
          "value": { "$state": "/square/get_recent_invoices/total_count" },
          "size": "sm",
          "tone": "info"
        }
      },

      "outstandingBox": {
        "type": "Section",
        "props": { "variant": "bordered" },
        "children": ["outstandingLabelRow", "outstandingValue"]
      },
      "outstandingLabelRow": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["outstandingIcon", "outstandingLabel"]
      },
      "outstandingIcon": {
        "type": "Icon",
        "props": { "name": "Clock", "tone": "warning", "size": "xs" }
      },
      "outstandingLabel": {
        "type": "Eyebrow",
        "props": { "text": "Outstanding" }
      },
      "outstandingValue": {
        "type": "Stat",
        "props": {
          "value": { "$state": "/square/get_recent_invoices/outstanding_display" },
          "size": "sm",
          "tone": "warning"
        }
      },

      "overdueBox": {
        "type": "Section",
        "props": { "variant": "bordered" },
        "children": ["overdueLabelRow", "overdueValue"]
      },
      "overdueLabelRow": {
        "type": "Row",
        "props": { "gap": "xs", "align": "center" },
        "children": ["overdueIcon", "overdueLabel"]
      },
      "overdueIcon": {
        "type": "Icon",
        "props": { "name": "AlertCircle", "tone": "destructive", "size": "xs" }
      },
      "overdueLabel": {
        "type": "Eyebrow",
        "props": { "text": "Overdue" }
      },
      "overdueValue": {
        "type": "Stat",
        "props": {
          "value": { "$state": "/square/get_recent_invoices/overdue_count" },
          "size": "sm",
          "tone": "destructive"
        }
      },

      "body": {
        "type": "Body",
        "props": {},
        "children": ["loading", "empty", "tableWrapper"]
      },

      "loading": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["sk1", "sk2", "sk3", "sk4", "sk5"],
        "visible": { "$state": "/_loading/square.get_recent_invoices" }
      },
      "sk1": { "type": "Skeleton", "props": { "height": "2rem", "rounded": "sm" } },
      "sk2": { "type": "Skeleton", "props": { "height": "2rem", "rounded": "sm" } },
      "sk3": { "type": "Skeleton", "props": { "height": "2rem", "rounded": "sm" } },
      "sk4": { "type": "Skeleton", "props": { "height": "2rem", "rounded": "sm" } },
      "sk5": { "type": "Skeleton", "props": { "height": "2rem", "rounded": "sm" } },

      "empty": {
        "type": "Empty",
        "props": { "message": "No invoices found." },
        "visible": {
          "$and": [
            { "$state": "/_loading/square.get_recent_invoices", "not": true },
            { "$state": "/square/get_recent_invoices/invoices/0", "not": true }
          ]
        }
      },

      "tableWrapper": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["tableHeader", "headerDivider", "invoiceList"],
        "visible": { "$state": "/_loading/square.get_recent_invoices", "not": true }
      },

      "tableHeader": {
        "type": "Grid",
        "props": { "cols": 5, "gap": "xs" },
        "children": ["hInvoice", "hCustomer", "hAmount", "hStatus", "hDue"]
      },
      "hInvoice":  { "type": "Eyebrow", "props": { "text": "Invoice"  } },
      "hCustomer": { "type": "Eyebrow", "props": { "text": "Customer" } },
      "hAmount":   { "type": "Eyebrow", "props": { "text": "Amount"   } },
      "hStatus":   { "type": "Eyebrow", "props": { "text": "Status"   } },
      "hDue":      { "type": "Eyebrow", "props": { "text": "Due"      } },

      "headerDivider": { "type": "Divider", "props": {} },

      "invoiceList": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["invoiceRow"],
        "repeat": {
          "statePath": "/square/get_recent_invoices/invoices",
          "key": "invoice_number"
        }
      },
      "invoiceRow": {
        "type": "Grid",
        "props": { "cols": 5, "gap": "xs" },
        "children": ["rowInvoice", "rowCustomer", "rowAmount", "rowStatus", "rowDue"]
      },
      "rowInvoice":  { "type": "Text",    "props": { "text": { "$item": "invoice_number" }, "size": "sm", "tone": "muted" } },
      "rowCustomer": { "type": "Text",    "props": { "text": { "$item": "customer_name"  }, "size": "sm", "weight": "medium" } },
      "rowAmount":   { "type": "Text",    "props": { "text": { "$item": "amount_display" }, "size": "sm" } },
      "rowStatus":   { "type": "Badge",   "props": { "text": { "$item": "status_label"  }, "tone": { "$item": "status_tone" } } },
      "rowDue":      { "type": "Text",    "props": { "text": { "$item": "due_display"   }, "size": "sm", "tone": "muted" } }
    }
  },
  "status": "published"
}
