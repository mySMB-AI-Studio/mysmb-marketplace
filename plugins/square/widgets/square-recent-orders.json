{
  "id": "square-recent-orders",
  "title": "Square — Recent Orders",
  "description": "Recent Square orders — order ID, total, status, and date. Sorted most recent first.",
  "category": "finance",
  "tags": ["square", "orders", "pos", "transactions", "finance"],
  "keywords": ["orders", "transactions", "square", "pos", "sales"],
  "connectorsUsed": ["square"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 5, "rowSpan": 5 },
    "min": { "colSpan": 4, "rowSpan": 4 },
    "max": { "colSpan": 10, "rowSpan": 12 }
  },
  "dataProvider": {
    "mcp": "square",
    "tool": "get_merchant",
    "params": {}
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": ["header", "body"],
        "watch": {
          "/square/get_merchant/main_location_id": [
            {
              "action": "square.search_orders",
              "params": {
                "location_ids": [{ "$state": "/square/get_merchant/main_location_id" }],
                "states": ["COMPLETED", "OPEN"],
                "sort_order": "DESC",
                "limit": 50
              }
            }
          ]
        }
      },

      "header": {
        "type": "Header",
        "children": ["titleGroup"]
      },
      "titleGroup": {
        "type": "Row",
        "props": { "gap": "sm", "align": "center" },
        "children": ["titleIconBox", "titleStack"]
      },
      "titleIconBox": {
        "type": "Section",
        "props": { "tone": "info" },
        "children": ["titleIcon"]
      },
      "titleIcon": {
        "type": "Icon",
        "props": { "name": "ShoppingBag", "tone": "info", "size": "md" }
      },
      "titleStack": {
        "type": "Stack",
        "props": { "gap": "none" },
        "children": ["title", "eyebrow"]
      },
      "title": {
        "type": "Heading",
        "props": { "text": "Recent Orders", "level": "h2" }
      },
      "eyebrow": {
        "type": "Eyebrow",
        "props": { "text": "Square", "tone": "info" }
      },

      "body": {
        "type": "Body",
        "props": {},
        "children": ["table"]
      },
      "table": {
        "type": "Table",
        "props": {
          "loading": { "$state": "/_loading/square.search_orders" },
          "skeletonRows": 5,
          "rows": { "$state": "/square/search_orders/orders" },
          "columns": [
            { "id": "id",      "header": "Order ID", "field": "id",               "priority": 2 },
            { "id": "total",   "header": "Total",    "field": "total_money.amount", "width": 120, "priority": 1, "format": "currency" },
            { "id": "status",  "header": "Status",   "field": "state",             "width": 110, "priority": 1 },
            { "id": "source",  "header": "Source",   "field": "source.name",       "width": 120, "priority": 2 },
            { "id": "created", "header": "Date",     "field": "created_at",        "width": 130, "priority": 1, "format": "relative" }
          ]
        }
      }
    }
  },
  "status": "published"
}
