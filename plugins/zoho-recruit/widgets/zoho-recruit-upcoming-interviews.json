{
  "id": "zoho-recruit-upcoming-interviews",
  "title": "Upcoming Interviews",
  "description": "Upcoming Zoho Recruit interviews for this week, next week or the next 30 days: candidate, job, date and time, and whether it's video, onsite or phone; click an interview for its details.",
  "category": "hr",
  "tags": [
    "zoho",
    "zoho-recruit",
    "recruiting",
    "interviews",
    "schedule"
  ],
  "keywords": [
    "upcoming interviews",
    "interview schedule",
    "scheduled interviews",
    "hiring calendar",
    "zoho recruit"
  ],
  "connectorsUsed": [
    "zoho-recruit"
  ],
  "popularity": 0,
  "branding": {
    "color": "#1A73E8"
  },
  "sizing": {
    "preferred": {
      "colSpan": 4,
      "rowSpan": 6
    },
    "min": {
      "colSpan": 3,
      "rowSpan": 5
    },
    "max": {
      "colSpan": 8,
      "rowSpan": 8
    }
  },
  "dataProvider": {
    "kind": "tool",
    "mcp": "zoho-recruit",
    "tool": "list_records",
    "params": {
      "module": "Interviews",
      "fields": "Interview_Name,Candidate_Name,Job_Opening_Name,Start_DateTime,End_DateTime,Venue,Interview_Status,Interview_Owner",
      "per_page": 200,
      "sort_by": "Start_DateTime",
      "sort_order": "desc"
    }
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": [
          "header",
          "body"
        ],
        "watch": {
          "/zoho-recruit/list_records": {
            "action": "setState",
            "params": {
              "statePath": "/ui/interviews",
              "value": {
                "$computed": "zoho-recruit_upcoming_interviews_dashboard",
                "args": {
                  "report": {
                    "$state": "/zoho-recruit/list_records"
                  },
                  "range": {
                    "$state": "/ui/interviewRange"
                  },
                  "selected": {
                    "$state": "/ui/interviewOpen"
                  }
                }
              }
            }
          },
          "/ui/interviewRange": {
            "action": "setState",
            "params": {
              "statePath": "/ui/interviews",
              "value": {
                "$computed": "zoho-recruit_upcoming_interviews_dashboard",
                "args": {
                  "report": {
                    "$state": "/zoho-recruit/list_records"
                  },
                  "range": {
                    "$state": "/ui/interviewRange"
                  },
                  "selected": {
                    "$state": "/ui/interviewOpen"
                  }
                }
              }
            }
          },
          "/ui/interviewOpen": {
            "action": "setState",
            "params": {
              "statePath": "/ui/interviews",
              "value": {
                "$computed": "zoho-recruit_upcoming_interviews_dashboard",
                "args": {
                  "report": {
                    "$state": "/zoho-recruit/list_records"
                  },
                  "range": {
                    "$state": "/ui/interviewRange"
                  },
                  "selected": {
                    "$state": "/ui/interviewOpen"
                  }
                }
              }
            }
          }
        }
      },
      "header": {
        "type": "Header",
        "props": {},
        "children": [
          "titleGroup"
        ]
      },
      "titleGroup": {
        "type": "Row",
        "props": {
          "gap": "sm",
          "align": "start"
        },
        "children": [
          "titleIcon",
          "titleStack"
        ]
      },
      "titleIcon": {
        "type": "Icon",
        "props": {
          "name": "CalendarDays",
          "tone": "brand",
          "size": "lg"
        }
      },
      "titleStack": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "children": [
          "title",
          "eyebrow"
        ]
      },
      "title": {
        "type": "Heading",
        "props": {
          "text": "Upcoming Interviews",
          "level": "h2"
        }
      },
      "eyebrow": {
        "type": "Eyebrow",
        "props": {
          "text": "Zoho Recruit"
        }
      },
      "body": {
        "type": "Body",
        "props": {},
        "children": [
          "loading",
          "error",
          "content"
        ]
      },
      "loading": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "skHero",
          "skRows",
          "skFooter"
        ],
        "visible": {
          "$and": [
            {
              "$state": "/ui/interviews/loaded",
              "not": true
            },
            {
              "$state": "/_errors/zoho-recruit.list_records",
              "not": true
            }
          ]
        }
      },
      "skHero": {
        "type": "Skeleton",
        "props": {
          "height": "4rem",
          "rounded": "md"
        }
      },
      "skRows": {
        "type": "Skeleton",
        "props": {
          "height": "10rem",
          "rounded": "md"
        }
      },
      "skFooter": {
        "type": "Skeleton",
        "props": {
          "height": "3rem",
          "rounded": "md"
        }
      },
      "error": {
        "type": "Empty",
        "props": {
          "message": "Couldn't load interviews from Zoho Recruit. Please try again in a few minutes."
        },
        "visible": {
          "$state": "/_errors/zoho-recruit.list_records"
        }
      },
      "content": {
        "type": "Stack",
        "props": {
          "gap": "md"
        },
        "children": [
          "scopeLabel",
          "heroRow",
          "interviewList",
          "listEmpty",
          "listNote",
          "footerBox"
        ],
        "visible": {
          "$state": "/ui/interviews/loaded"
        }
      },
      "scopeLabel": {
        "type": "Caption",
        "props": {
          "text": {
            "$state": "/ui/interviews/scopeText"
          }
        }
      },
      "heroRow": {
        "type": "Row",
        "props": {
          "template": "minmax(0, 1fr) 9rem",
          "gap": "md",
          "align": "center"
        },
        "children": [
          "heroStack",
          "rangeSelect"
        ]
      },
      "heroStack": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "children": [
          "heroStat",
          "heroLabel"
        ]
      },
      "heroStat": {
        "type": "Stat",
        "props": {
          "value": {
            "$state": "/ui/interviews/countDisplay"
          },
          "tone": "brand"
        }
      },
      "heroLabel": {
        "type": "Text",
        "props": {
          "text": {
            "$state": "/ui/interviews/countLabel"
          },
          "tone": "brand",
          "size": "sm",
          "weight": "medium"
        }
      },
      "rangeSelect": {
        "type": "Select",
        "props": {
          "value": {
            "$bindState": "/ui/interviewRange"
          },
          "options": [
            {
              "value": "week",
              "label": "This week"
            },
            {
              "value": "next",
              "label": "Next week"
            },
            {
              "value": "30d",
              "label": "Next 30 days"
            }
          ],
          "ariaLabel": "Interview date range",
          "size": "sm"
        }
      },
      "interviewList": {
        "type": "Stack",
        "props": {
          "gap": "sm"
        },
        "children": [
          "interviewItem"
        ],
        "repeat": {
          "statePath": "/ui/interviews/rows",
          "key": "id"
        }
      },
      "interviewItem": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "children": [
          "interviewRow",
          "detailBox"
        ]
      },
      "interviewRow": {
        "type": "Row",
        "props": {
          "template": "auto minmax(0, 1fr) auto",
          "gap": "sm",
          "align": "center",
          "hover": true,
          "clickable": true
        },
        "children": [
          "candidateAvatar",
          "candidateMain",
          "whenStack"
        ],
        "on": {
          "click": {
            "action": "setState",
            "params": {
              "statePath": "/ui/interviewOpen",
              "value": {
                "$computed": "identity",
                "args": {
                  "value": {
                    "$item": "toggle"
                  }
                }
              }
            }
          }
        }
      },
      "candidateAvatar": {
        "type": "Avatar",
        "props": {
          "initials": {
            "$item": "initials"
          },
          "tone": {
            "$item": "avatarTone"
          },
          "size": "md"
        }
      },
      "candidateMain": {
        "type": "Stack",
        "props": {
          "gap": "none"
        },
        "children": [
          "candidateName",
          "jobTitle"
        ]
      },
      "candidateName": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "name"
          },
          "size": "sm",
          "weight": "semibold",
          "truncate": true
        }
      },
      "jobTitle": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "job"
          },
          "tone": "muted",
          "truncate": true
        }
      },
      "whenStack": {
        "type": "Stack",
        "props": {
          "gap": "none",
          "align": "end"
        },
        "children": [
          "whenText",
          "modeRow"
        ]
      },
      "whenText": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "when"
          },
          "size": "sm",
          "weight": "medium"
        }
      },
      "modeRow": {
        "type": "Row",
        "props": {
          "template": "auto auto",
          "gap": "xs",
          "align": "center"
        },
        "children": [
          "modeIcon",
          "modeLabel"
        ]
      },
      "modeIcon": {
        "type": "Icon",
        "props": {
          "name": {
            "$item": "modeIcon"
          },
          "tone": {
            "$item": "modeTone"
          },
          "size": "sm"
        }
      },
      "modeLabel": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "modeLabel"
          },
          "tone": {
            "$item": "modeTone"
          },
          "size": "sm",
          "weight": "medium"
        }
      },
      "detailBox": {
        "type": "Section",
        "props": {
          "variant": "bordered"
        },
        "children": [
          "detailStack"
        ],
        "visible": {
          "$item": "expanded"
        }
      },
      "detailStack": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "children": [
          "detailType",
          "detailTime",
          "detailVenue",
          "detailOwner"
        ]
      },
      "detailType": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "typeText"
          },
          "size": "sm",
          "weight": "medium"
        }
      },
      "detailTime": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "timeText"
          },
          "tone": "muted"
        }
      },
      "detailVenue": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "venueText"
          },
          "tone": "muted"
        },
        "visible": {
          "$item": "venueText"
        }
      },
      "detailOwner": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "ownerText"
          },
          "tone": "muted"
        },
        "visible": {
          "$item": "ownerText"
        }
      },
      "listEmpty": {
        "type": "Empty",
        "props": {
          "message": {
            "$state": "/ui/interviews/emptyText"
          }
        },
        "visible": {
          "$state": "/ui/interviews/isEmpty"
        }
      },
      "listNote": {
        "type": "Caption",
        "props": {
          "text": {
            "$state": "/ui/interviews/listNote"
          }
        },
        "visible": {
          "$state": "/ui/interviews/listNote"
        }
      },
      "footerBox": {
        "type": "Section",
        "props": {
          "variant": "muted"
        },
        "children": [
          "viewRow"
        ]
      },
      "viewRow": {
        "type": "Row",
        "props": {
          "template": "auto minmax(0, 1fr) auto",
          "gap": "sm",
          "align": "center",
          "hover": true,
          "clickable": true
        },
        "children": [
          "viewIcon",
          "viewLabel",
          "viewArrow"
        ],
        "on": {
          "click": {
            "action": "open_url",
            "params": {
              "url": "https://recruit.zoho.com/recruit/",
              "target": "_blank"
            }
          }
        }
      },
      "viewIcon": {
        "type": "Icon",
        "props": {
          "name": "SquareArrowOutUpRight",
          "tone": "brand",
          "size": "md"
        }
      },
      "viewLabel": {
        "type": "Text",
        "props": {
          "text": "View in Recruit",
          "tone": "brand",
          "size": "sm",
          "weight": "semibold"
        }
      },
      "viewArrow": {
        "type": "Icon",
        "props": {
          "name": "ChevronRight",
          "tone": "brand",
          "size": "sm"
        }
      }
    }
  }
}
