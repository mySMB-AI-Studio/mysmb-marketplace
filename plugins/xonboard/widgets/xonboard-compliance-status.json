{
  "id": "xonboard-compliance-status",
  "title": "Compliance Status (Demo)",
  "description": "Static demo of a Xonboard (built on SuperAPI) Compliance Status tile — illustrative sample Fair Work Statement and TFN declaration delivery/signing status for a fictional accounting/payroll practice's new hires, not real practice data, pending a live connection.",
  "category": "hr",
  "tags": ["xonboard", "superapi", "compliance", "fair work statement", "tfn declaration", "demo"],
  "keywords": ["compliance status", "fair work statement", "tfn declaration", "signed", "demo"],
  "connectorsUsed": ["xonboard"],
  "sizing": {
    "preferred": { "colSpan": 4, "rowSpan": 5 },
    "min": { "colSpan": 3, "rowSpan": 4 },
    "max": { "colSpan": 6, "rowSpan": 8 }
  },
  "branding": { "color": "#3457a6" },
  "spec": {
    "root": "card",
    "elements": {
      "card": { "type": "Card", "props": {}, "children": ["headerRow", "sub", "div0", "body", "div1", "footer"] },

      "headerRow": { "type": "Row", "props": { "justify": "between", "align": "center" }, "children": ["titleGroup"] },
      "titleGroup": { "type": "Row", "props": { "gap": "sm", "align": "center" }, "children": ["titleIcon", "titleStack"] },
      "titleIcon": { "type": "Icon", "props": { "name": "ShieldCheck", "tone": "brand", "size": "sm" } },
      "titleStack": { "type": "Stack", "props": { "gap": "none" }, "children": ["title", "eyebrow"] },
      "title": { "type": "Heading", "props": { "text": "Compliance Status", "level": "h2" } },
      "eyebrow": { "type": "Eyebrow", "props": { "text": "4 shown · sample data" } },

      "sub": { "type": "Text", "props": { "text": "Fair Work Statement + TFN declaration delivery", "size": "xs", "tone": "muted" } },
      "div0": { "type": "Divider", "props": {} },

      "body": { "type": "Body", "props": {}, "children": ["rows"] },
      "rows": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["r1", "rd1", "r2", "rd2", "r3", "rd3", "r4"]
      },
      "rd1": { "type": "Divider", "props": {} },
      "rd2": { "type": "Divider", "props": {} },
      "rd3": { "type": "Divider", "props": {} },

      "r1": { "type": "Row", "props": { "gap": "sm", "align": "center" }, "children": ["r1Stack", "r1Badge"] },
      "r1Stack": { "type": "Stack", "props": { "gap": "none", "grow": true }, "children": ["r1Name", "r1Sub"] },
      "r1Name": { "type": "Text", "props": { "text": "Noah Fitzgerald", "size": "sm", "weight": "medium" } },
      "r1Sub": { "type": "Caption", "props": { "text": "Fair Work Statement: Signed · TFN Declaration: Signed" } },
      "r1Badge": { "type": "Badge", "props": { "text": "Signed", "tone": "success", "variant": "soft" } },

      "r2": { "type": "Row", "props": { "gap": "sm", "align": "center" }, "children": ["r2Stack", "r2Badge"] },
      "r2Stack": { "type": "Stack", "props": { "gap": "none", "grow": true }, "children": ["r2Name", "r2Sub"] },
      "r2Name": { "type": "Text", "props": { "text": "Isabella Nguyen", "size": "sm", "weight": "medium" } },
      "r2Sub": { "type": "Caption", "props": { "text": "Fair Work Statement: Signed · TFN Declaration: Sent — Awaiting Signature" } },
      "r2Badge": { "type": "Badge", "props": { "text": "Sent — Awaiting Signature", "tone": "warning", "variant": "soft" } },

      "r3": { "type": "Row", "props": { "gap": "sm", "align": "center" }, "children": ["r3Stack", "r3Badge"] },
      "r3Stack": { "type": "Stack", "props": { "gap": "none", "grow": true }, "children": ["r3Name", "r3Sub"] },
      "r3Name": { "type": "Text", "props": { "text": "Ethan Papadopoulos", "size": "sm", "weight": "medium" } },
      "r3Sub": { "type": "Caption", "props": { "text": "Fair Work Statement: Not Sent · TFN Declaration: Not Sent" } },
      "r3Badge": { "type": "Badge", "props": { "text": "Not Sent", "tone": "muted", "variant": "soft" } },

      "r4": { "type": "Row", "props": { "gap": "sm", "align": "center" }, "children": ["r4Stack", "r4Badge"] },
      "r4Stack": { "type": "Stack", "props": { "gap": "none", "grow": true }, "children": ["r4Name", "r4Sub"] },
      "r4Name": { "type": "Text", "props": { "text": "Chloe Bennett", "size": "sm", "weight": "medium" } },
      "r4Sub": { "type": "Caption", "props": { "text": "Fair Work Statement: Sent — Awaiting Signature · TFN Declaration: Signed" } },
      "r4Badge": { "type": "Badge", "props": { "text": "Sent — Awaiting Signature", "tone": "warning", "variant": "soft" } },

      "div1": { "type": "Divider", "props": {} },
      "footer": { "type": "Row", "props": { "gap": "xs", "align": "center" }, "children": ["footerIcon", "footerNote"] },
      "footerIcon": { "type": "Icon", "props": { "name": "Info", "tone": "muted", "size": "xs" } },
      "footerNote": { "type": "Text", "props": { "text": "Static demo data — will show live compliance status once Xonboard is connected", "size": "xs", "tone": "muted" } }
    }
  },
  "status": "published"
}
