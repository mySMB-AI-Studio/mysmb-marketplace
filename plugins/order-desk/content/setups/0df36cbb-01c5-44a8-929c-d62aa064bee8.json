    "settings": {
      "properties": {
        "care": {
          "default": "everything",
          "description": "everything: Check everything. A person approves every order. problems: Check only problems. A clean order with nothing flagged goes through on its own; anything flagged waits for a person. hands_off: Hands-off within limits. As for problems, and Order Desk also accepts a product when exactly one fits the name and assumes the selling unit when a line has none. In every choice the limits below still send an order to a person.",
          "enum": [
            "everything",
            "problems",
            "hands_off"
          ],
          "title": "How careful should Order Desk be?",
          "type": "string"
        },
        "cutoff_time": {
          "default": "",
          "description": "Orders that arrive after this time for delivery the next day are flagged. Write it as 24-hour time, for example 14:00. Leave it empty to use only each customer's own cut-off. A customer's own cut-off always wins.",
          "maxLength": 5,
          "pattern": "^$|^[0-2][0-9]:[0-5][0-9]$",
          "title": "Order cut-off time",
          "type": "string"
        },
        "delivery_days": {
          "default": "every_day",
          "description": "An order asking for delivery on any other day is flagged for a person.",
          "enum": [
            "every_day",
            "mon_sat",
            "mon_fri"
          ],
          "title": "Days you deliver",
          "type": "string"
        },
        "duplicate_window_days": {
          "default": 30,
          "description": "Flag an order when the same customer sent the same PO number within this many days. 0 turns the check off.",
          "maximum": 365,
          "minimum": 0,
          "title": "Duplicate order check (days)",
          "type": "number"
        },
        "guessed_products": {
          "default": "always_ask",
          "description": "always_ask: a person checks every line Order Desk had to guess. accept_single: accept the guess when only one product fits the name. Hands-off within limits always accepts a single fit.",
          "enum": [
            "always_ask",
            "accept_single"
          ],
          "title": "When a product is a best guess",
          "type": "string"
        },
        "missing_po": {
          "default": "customer_rule",
          "description": "customer_rule: only hold the order for customers marked as needing a PO. always_ask: hold every order without a PO and ask.",
          "enum": [
            "customer_rule",
            "always_ask"
          ],
          "title": "When an order has no PO number",
          "type": "string"
        },
        "missing_unit": {
          "default": "ask",
          "description": "ask: a person checks the line. selling_unit: assume the product's selling unit. Hands-off within limits always assumes the selling unit.",
          "enum": [
            "ask",
            "selling_unit"
          ],
          "title": "When a line has no unit",
          "type": "string"
        },
        "new_customer_orders": {
          "default": 3,
          "description": "A person approves this many orders from a customer before any of that customer's orders may go through on their own. 0 turns this off.",
          "maximum": 50,
          "minimum": 0,
          "title": "New customers: first orders a person approves",
          "type": "number"
        },
        "order_size_limit": {
          "default": 30,
          "description": "An order with more lines than this always waits for a person.",
          "maximum": 300,
          "minimum": 1,
          "title": "Order size limit (lines)",
          "type": "number"
        },
        "spot_check_every": {
          "default": 10,
          "description": "About one clean order in this many is sent to a person anyway, so someone keeps an eye on the work. 0 turns spot checks off.",
          "maximum": 1000,
          "minimum": 0,
          "title": "Spot check: one clean order in every",
          "type": "number"
        },
        "substitutions": {
          "default": "never",
          "description": "never: never swap one product for another. customer_rules: only when that customer's notes or rules allow it.",
          "enum": [
            "never",
            "customer_rules"
          ],
          "title": "Substitutions",
          "type": "string"
        },
        "time_zone": {
          "default": "Australia/Sydney",
          "description": "Used to work out whether an order arrived before the cut-off.",
          "enum": [
            "Australia/Sydney",
            "Australia/Melbourne",
            "Australia/Brisbane",
            "Australia/Adelaide",
            "Australia/Darwin",
            "Australia/Perth",
            "Australia/Hobart",
            "Pacific/Auckland",
            "Asia/Manila",
            "Asia/Singapore",
            "UTC"
          ],
          "title": "Your time zone",
          "type": "string"
        },
        "unusual_quantity_factor": {
          "default": 5,
          "description": "Flag a line when the quantity is more than this many times what the customer usually orders of that product. 0 turns the check off.",
          "maximum": 100,
          "minimum": 0,
          "title": "Unusual quantity check",
          "type": "number"
        }
      },
      "required": [
        "care"
      ],
      "type": "object"
    },
    "tasks": [],
