{
  "id": "myconnect-analytics",
  "title": "myConnect Analytics",
  "description": "A dedicated analytics dashboard for a myConnect community you administer — pick which one from the dropdown if you administer more than one. Choose a date range (Today, 7 days, 30 days, To Date, or Custom), then switch between Sign-ups, Active Members, Posts & Comments and RSVP to see that data in a table. Sign-ups (live): everyone who joined in the selected date range — member, email, role, status, tags, access groups and date joined — with a Download CSV of the same rows. Active Members (live): every current active-status member — member, email, role and last seen date, most recently seen first — independent of the date range. Posts & Comments (live): every channel's post count and comment count for the selected date range, busiest channel first. RSVP (live): every RSVP across every event for the selected date range — member, email, event, RSVP status, RSVP date and confirmed sessions.",
  "category": "productivity",
  "tags": ["myconnect", "community", "analytics", "signups"],
  "keywords": ["myconnect", "analytics", "signups", "members", "rsvp", "posts", "comments"],
  "connectorsUsed": ["myconnect-community-admin"],
  "popularity": 0,
  "sizing": {
    "preferred": { "colSpan": 8, "rowSpan": 9 },
    "min": { "colSpan": 6, "rowSpan": 6 },
    "max": { "colSpan": 12, "rowSpan": 12 }
  },
  "dataProvider": {
    "mcp": "myconnect-community-admin",
    "tool": "list_communities",
    "params": {}
  },
  "spec": {
    "root": "card",
    "elements": {
      "card": {
        "type": "Card",
        "props": {},
        "children": ["header", "divider1", "communityRow", "dateRangeRow", "tabBar", "divider2", "body", "infoOverlay"],
        "watch": {
          "/myconnect-community-admin/list_communities": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/selectedCommunity",
                "value": {
                  "$computed": "myconnect-community-admin_first_selected_community",
                  "args": {
                    "communities": { "$state": "/myconnect-community-admin/list_communities" },
                    "current": { "$state": "/ui/selectedCommunity" }
                  }
                }
              }
            }
          ]
        }
      },

      "titleIcon": { "type": "Icon", "props": { "name": "BarChart3", "tone": "accent", "size": "sm" } },
      "title": { "type": "Heading", "props": { "level": "h2", "text": "myConnect Analytics" } },
      "eyebrow": { "type": "Eyebrow", "props": { "text": "Community growth, at a glance" } },
      "titleStack": { "type": "Stack", "props": { "gap": "none" }, "children": ["title", "eyebrow"] },
      "titleGroup": { "type": "Row", "props": { "align": "center", "gap": "sm" }, "children": ["titleIcon", "titleStack"] },
      "infoBtn": {
        "type": "IconButton",
        "props": { "icon": "Info", "size": "sm", "tone": "muted", "ariaLabel": "About this tile" },
        "on": { "click": { "action": "setState", "params": { "statePath": "/ui/showInfo", "value": true } } }
      },
      "header": { "type": "Row", "props": { "align": "center", "justify": "between", "gap": "sm" }, "children": ["titleGroup", "infoBtn"] },
      "divider1": { "type": "Divider", "props": {} },

      "communitySelect": {
        "type": "Select",
        "props": {
          "value": { "$bindState": "/ui/selectedCommunity" },
          "options": {
            "$computed": "to_options",
            "args": {
              "value": { "$state": "/myconnect-community-admin/list_communities" },
              "valueField": "slug",
              "labelField": "name"
            }
          },
          "placeholder": "Select community…",
          "size": "sm"
        },
        "visible": { "$state": "/myconnect-community-admin/list_communities/1" }
      },
      "communityRow": {
        "type": "Row",
        "props": { "align": "center", "gap": "sm" },
        "children": ["communitySelect"]
      },

      "todayBtn": {
        "type": "Button",
        "props": {
          "label": "Today",
          "size": "sm",
          "variant": { "$cond": { "$state": "/ui/dateRangeMode", "eq": "today" }, "$then": "primary", "$else": "secondary" },
          "tone": { "$cond": { "$state": "/ui/dateRangeMode", "eq": "today" }, "$then": "info", "$else": "default" }
        },
        "on": {
          "click": [
            { "action": "setState", "params": { "statePath": "/ui/dateRangeMode", "value": "today" } },
            { "action": "setState", "params": { "statePath": "/ui/range", "value": { "from": { "$computed": "myconnect-community-admin_today" }, "to": { "$computed": "myconnect-community-admin_today" } } } }
          ]
        }
      },
      "last7Btn": {
        "type": "Button",
        "props": {
          "label": "7 days",
          "size": "sm",
          "variant": { "$cond": { "$state": "/ui/dateRangeMode", "eq": "7d" }, "$then": "primary", "$else": "secondary" },
          "tone": { "$cond": { "$state": "/ui/dateRangeMode", "eq": "7d" }, "$then": "info", "$else": "default" }
        },
        "on": {
          "click": [
            { "action": "setState", "params": { "statePath": "/ui/dateRangeMode", "value": "7d" } },
            { "action": "setState", "params": { "statePath": "/ui/range", "value": { "from": { "$computed": "myconnect-community-admin_days_ago", "args": { "days": 6 } }, "to": { "$computed": "myconnect-community-admin_today" } } } }
          ]
        }
      },
      "last30Btn": {
        "type": "Button",
        "props": {
          "label": "30 days",
          "size": "sm",
          "variant": { "$cond": { "$state": "/ui/dateRangeMode", "eq": "30d" }, "$then": "primary", "$else": "secondary" },
          "tone": { "$cond": { "$state": "/ui/dateRangeMode", "eq": "30d" }, "$then": "info", "$else": "default" }
        },
        "on": {
          "click": [
            { "action": "setState", "params": { "statePath": "/ui/dateRangeMode", "value": "30d" } },
            { "action": "setState", "params": { "statePath": "/ui/range", "value": { "from": { "$computed": "myconnect-community-admin_days_ago", "args": { "days": 29 } }, "to": { "$computed": "myconnect-community-admin_today" } } } }
          ]
        }
      },
      "toDateBtn": {
        "type": "Button",
        "props": {
          "label": "To Date",
          "size": "sm",
          "variant": { "$cond": { "$state": "/ui/dateRangeMode", "eq": "todate" }, "$then": "primary", "$else": "secondary" },
          "tone": { "$cond": { "$state": "/ui/dateRangeMode", "eq": "todate" }, "$then": "info", "$else": "default" }
        },
        "on": {
          "click": [
            { "action": "setState", "params": { "statePath": "/ui/dateRangeMode", "value": "todate" } },
            { "action": "setState", "params": { "statePath": "/ui/range", "value": { "from": "2000-01-01", "to": { "$computed": "myconnect-community-admin_today" } } } }
          ]
        }
      },
      "customBtn": {
        "type": "Button",
        "props": {
          "label": "Custom",
          "size": "sm",
          "variant": { "$cond": { "$state": "/ui/dateRangeMode", "eq": "custom" }, "$then": "primary", "$else": "secondary" },
          "tone": { "$cond": { "$state": "/ui/dateRangeMode", "eq": "custom" }, "$then": "info", "$else": "default" }
        },
        "on": {
          "click": [
            { "action": "setState", "params": { "statePath": "/ui/dateRangeMode", "value": "custom" } },
            { "action": "setState", "params": { "statePath": "/ui/range", "value": { "from": { "$computed": "myconnect-community-admin_year_start" }, "to": { "$computed": "myconnect-community-admin_today" } } } }
          ]
        }
      },
      "presetPills": { "type": "Row", "props": { "gap": "xs", "wrap": true }, "children": ["todayBtn", "last7Btn", "last30Btn", "toDateBtn", "customBtn"] },

      "customFromLabel": { "type": "Caption", "props": { "text": "From", "tone": "muted" } },
      "customFromInput": { "type": "DateInput", "props": { "size": "sm", "value": { "$bindState": "/ui/range/from" } } },
      "customFromStack": { "type": "Stack", "props": { "gap": "none" }, "children": ["customFromLabel", "customFromInput"] },
      "customToLabel": { "type": "Caption", "props": { "text": "To", "tone": "muted" } },
      "customToInput": { "type": "DateInput", "props": { "size": "sm", "value": { "$bindState": "/ui/range/to" } } },
      "customToStack": { "type": "Stack", "props": { "gap": "none" }, "children": ["customToLabel", "customToInput"] },
      "customDateInputs": {
        "type": "Row",
        "props": { "align": "end", "gap": "sm" },
        "children": ["customFromStack", "customToStack"],
        "visible": { "$state": "/ui/dateRangeMode", "eq": "custom" }
      },

      "dateRangeRow": {
        "type": "Row",
        "props": { "align": "center", "justify": "between", "gap": "sm", "wrap": true },
        "children": ["presetPills", "customDateInputs"],
        "watch": {
          "/ui/selectedCommunity": [
            {
              "action": "myconnect-community-admin.list_members",
              "params": { "community": { "$state": "/ui/selectedCommunity" }, "fromDate": { "$cond": { "$state": "/ui/range/from" }, "$then": { "$state": "/ui/range/from" }, "$else": { "$computed": "myconnect-community-admin_today" } }, "toDate": { "$cond": { "$state": "/ui/range/to" }, "$then": { "$state": "/ui/range/to" }, "$else": { "$computed": "myconnect-community-admin_today" } }, "limit": 100 }
            }
          ],
          "/ui/range": [
            {
              "action": "myconnect-community-admin.list_members",
              "params": { "community": { "$state": "/ui/selectedCommunity" }, "fromDate": { "$state": "/ui/range/from" }, "toDate": { "$state": "/ui/range/to" }, "limit": 100 }
            }
          ]
        }
      },

      "signupsTabBtn": {
        "type": "Button",
        "props": {
          "label": "Sign-ups",
          "leadingIcon": "UserPlus",
          "size": "sm",
          "variant": { "$cond": { "$state": "/ui/activeTab", "eq": "signups" }, "$then": "primary", "$else": { "$cond": { "$state": "/ui/activeTab", "not": true }, "$then": "primary", "$else": "secondary" } },
          "tone": { "$cond": { "$state": "/ui/activeTab", "eq": "signups" }, "$then": "chart-1", "$else": { "$cond": { "$state": "/ui/activeTab", "not": true }, "$then": "chart-1", "$else": "default" } }
        },
        "on": { "click": { "action": "setState", "params": { "statePath": "/ui/activeTab", "value": "signups" } } }
      },
      "activeMembersTabBtn": {
        "type": "Button",
        "props": {
          "label": "Active Members",
          "leadingIcon": "Users",
          "size": "sm",
          "variant": { "$cond": { "$state": "/ui/activeTab", "eq": "activeMembers" }, "$then": "primary", "$else": "secondary" },
          "tone": { "$cond": { "$state": "/ui/activeTab", "eq": "activeMembers" }, "$then": "chart-2", "$else": "default" }
        },
        "on": {
          "click": [
            { "action": "setState", "params": { "statePath": "/ui/activeTab", "value": "activeMembers" } },
            {
              "action": "myconnect-community-admin.list_members",
              "params": { "community": { "$state": "/ui/selectedCommunity" }, "status": "active", "limit": 100 }
            }
          ]
        }
      },
      "postsCommentsTabBtn": {
        "type": "Button",
        "props": {
          "label": "Posts & Comments",
          "leadingIcon": "MessageSquare",
          "size": "sm",
          "variant": { "$cond": { "$state": "/ui/activeTab", "eq": "postsComments" }, "$then": "primary", "$else": "secondary" },
          "tone": { "$cond": { "$state": "/ui/activeTab", "eq": "postsComments" }, "$then": "chart-3", "$else": "default" }
        },
        "on": {
          "click": { "action": "setState", "params": { "statePath": "/ui/activeTab", "value": "postsComments" } }
        }
      },
      "rsvpTabBtn": {
        "type": "Button",
        "props": {
          "label": "RSVP",
          "leadingIcon": "Calendar",
          "size": "sm",
          "variant": { "$cond": { "$state": "/ui/activeTab", "eq": "rsvp" }, "$then": "primary", "$else": "secondary" },
          "tone": { "$cond": { "$state": "/ui/activeTab", "eq": "rsvp" }, "$then": "chart-4", "$else": "default" }
        },
        "on": {
          "click": { "action": "setState", "params": { "statePath": "/ui/activeTab", "value": "rsvp" } }
        }
      },
      "tabBar": { "type": "Row", "props": { "gap": "xs", "wrap": true }, "children": ["signupsTabBtn", "activeMembersTabBtn", "postsCommentsTabBtn", "rsvpTabBtn"] },
      "divider2": { "type": "Divider", "props": {} },

      "signupsPickCommunityPrompt": {
        "type": "Caption",
        "props": { "text": "Pick a community above to see its sign-ups.", "tone": "muted" },
        "visible": {
          "$and": [
            { "$state": "/_errors/myconnect-community-admin.list_members" },
            { "$state": "/ui/selectedCommunity", "not": true }
          ]
        }
      },
      "signupsErrorBanner": {
        "type": "Caption",
        "props": { "text": { "$template": "Couldn't load sign-ups: ${/_errors/myconnect-community-admin.list_members}" }, "tone": "destructive" },
        "visible": {
          "$and": [
            { "$state": "/_errors/myconnect-community-admin.list_members" },
            { "$state": "/ui/selectedCommunity" }
          ]
        }
      },
      "signupsLoading1": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "signupsLoading2": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "signupsLoading": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["signupsLoading1", "signupsLoading2"],
        "visible": { "$state": "/_loading/myconnect-community-admin.list_members" }
      },
      "signupsViewTableBtn": {
        "type": "Button",
        "props": {
          "label": "Table",
          "leadingIcon": "Table",
          "size": "sm",
          "variant": { "$cond": { "$state": "/ui/signupsView", "eq": "chart" }, "$then": "secondary", "$else": "primary" },
          "tone": { "$cond": { "$state": "/ui/signupsView", "eq": "chart" }, "$then": "default", "$else": "info" }
        },
        "on": { "click": { "action": "setState", "params": { "statePath": "/ui/signupsView", "value": "table" } } }
      },
      "signupsViewChartBtn": {
        "type": "Button",
        "props": {
          "label": "Chart",
          "leadingIcon": "BarChart3",
          "size": "sm",
          "variant": { "$cond": { "$state": "/ui/signupsView", "eq": "chart" }, "$then": "primary", "$else": "secondary" },
          "tone": { "$cond": { "$state": "/ui/signupsView", "eq": "chart" }, "$then": "info", "$else": "default" }
        },
        "on": {
          "click": [
            { "action": "setState", "params": { "statePath": "/ui/signupsView", "value": "chart" } },
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/signupsBusiestDays",
                "value": {
                  "$computed": "myconnect-community-admin_signups_busiest_days",
                  "args": {
                    "items": { "$state": "/myconnect-community-admin/list_members/items" },
                    "fromDate": { "$state": "/ui/range/from" },
                    "toDate": { "$state": "/ui/range/to" }
                  }
                }
              }
            }
          ]
        }
      },
      "signupsViewToggle": { "type": "Row", "props": { "gap": "xs" }, "children": ["signupsViewTableBtn", "signupsViewChartBtn"] },
      "signupsEmpty": {
        "type": "Empty",
        "props": { "message": "No sign-ups in this date range." },
        "visible": {
          "$and": [
            { "$state": "/_loading/myconnect-community-admin.list_members", "not": true },
            { "$state": "/ui/signupsRows/0", "not": true },
            { "$state": "/_errors/myconnect-community-admin.list_members", "not": true }
          ]
        }
      },
      "signupsTable": {
        "type": "Table",
        "props": {
          "loading": { "$state": "/_loading/myconnect-community-admin.list_members" },
          "skeletonRows": 4,
          "rows": { "$state": "/ui/signupsRows" },
          "columns": [
            { "id": "member", "header": "Member", "field": "member", "priority": 1 },
            { "id": "email", "header": "Email", "field": "email", "priority": 2 },
            { "id": "role", "header": "Role", "field": "role", "width": 90, "priority": 3 },
            { "id": "status", "header": "Status", "field": "status", "width": 90, "priority": 3 },
            { "id": "tags", "header": "Tags", "field": "tags", "priority": 4 },
            { "id": "accessGroups", "header": "Access Groups", "field": "accessGroups", "priority": 4 },
            { "id": "dateJoined", "header": "Date joined", "field": "dateJoined", "width": 100, "priority": 2 }
          ]
        },
        "visible": {
          "$and": [
            { "$state": "/ui/signupsRows/0" },
            { "$state": "/ui/signupsView", "neq": "chart" }
          ]
        }
      },
      "signupsMoreCaption": {
        "type": "Caption",
        "props": { "text": "Showing the first 100 — narrow the date range or download the CSV for the complete list.", "tone": "muted" },
        "visible": {
          "$and": [
            { "$state": "/myconnect-community-admin/list_members/nextCursor" },
            { "$state": "/ui/signupsView", "neq": "chart" }
          ]
        }
      },
      "signupsCsvNotice": {
        "type": "Caption",
        "props": { "text": { "$state": "/ui/signupsCsv/notice" }, "tone": "muted" },
        "visible": { "$state": "/ui/signupsCsv/notice" }
      },
      "downloadCsvBtn": {
        "type": "Button",
        "props": {
          "label": { "$cond": { "$state": "/ui/signupsCsv/busy" }, "$then": "Preparing CSV…", "$else": "Download CSV" },
          "leadingIcon": "Download",
          "size": "sm",
          "variant": "secondary",
          "disabled": { "$state": "/ui/signupsCsv/busy" }
        },
        "on": {
          "click": {
            "action": "myconnect-community-admin_export_signups_csv",
            "params": {
              "op": "start",
              "community": { "$state": "/ui/selectedCommunity" },
              "fromDate": { "$state": "/ui/range/from" },
              "toDate": { "$state": "/ui/range/to" }
            }
          }
        }
      },
      "signupsFooterRow": {
        "type": "Row",
        "props": { "align": "center", "justify": "between", "gap": "sm" },
        "children": ["signupsCsvNotice", "downloadCsvBtn"],
        "visible": { "$state": "/ui/signupsView", "neq": "chart" }
      },
      "signupsBusiestDaysLabel": {
        "type": "Caption",
        "props": { "text": "Busiest days", "tone": "muted", "weight": "semibold" },
        "visible": { "$state": "/ui/signupsBusiestDays/0" }
      },
      "signupsBusiestDaysChart": {
        "type": "BarChart",
        "props": {
          "data": { "$state": "/ui/signupsBusiestDays" },
          "labelField": "label",
          "valueField": "value",
          "tone": "chart-1",
          "sort": "desc"
        },
        "visible": { "$state": "/ui/signupsBusiestDays/0" },
        "watch": {
          "/myconnect-community-admin/list_members/items": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/signupsBusiestDays",
                "value": {
                  "$computed": "myconnect-community-admin_signups_busiest_days",
                  "args": {
                    "items": { "$state": "/myconnect-community-admin/list_members/items" },
                    "fromDate": { "$state": "/ui/range/from" },
                    "toDate": { "$state": "/ui/range/to" }
                  }
                }
              }
            }
          ]
        }
      },
      "signupsTrendFromLabel": {
        "type": "Caption",
        "props": {
          "text": { "$computed": "format_date", "args": { "value": { "$state": "/ui/range/from" }, "format": "dd-mmm-yy" } },
          "tone": "muted"
        }
      },
      "signupsTrendToLabel": {
        "type": "Caption",
        "props": {
          "text": { "$computed": "format_date", "args": { "value": { "$state": "/ui/range/to" }, "format": "dd-mmm-yy" } },
          "tone": "muted"
        }
      },
      "signupsTrendDatesRow": {
        "type": "Row",
        "props": { "justify": "between", "gap": "sm" },
        "children": ["signupsTrendFromLabel", "signupsTrendToLabel"]
      },
      "signupsTrendGroup": {
        "type": "Stack",
        "props": { "gap": "xs" },
        "children": ["signupsTrendDatesRow", "signupsBusiestDaysLabel", "signupsBusiestDaysChart"],
        "visible": {
          "$and": [
            { "$state": "/_loading/myconnect-community-admin.list_members", "not": true },
            { "$state": "/ui/signupsView", "eq": "chart" }
          ]
        }
      },
      "signupsPanel": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["signupsPickCommunityPrompt", "signupsErrorBanner", "signupsViewToggle", "signupsTrendGroup", "signupsLoading", "signupsEmpty", "signupsTable", "signupsMoreCaption", "signupsFooterRow"],
        "visible": { "$or": [{ "$state": "/ui/activeTab", "eq": "signups" }, { "$state": "/ui/activeTab", "not": true }] },
        "watch": {
          "/myconnect-community-admin/list_members/items": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/signupsRows",
                "value": { "$computed": "myconnect-community-admin_signups_rows", "args": { "items": { "$state": "/myconnect-community-admin/list_members/items" } } }
              }
            }
          ]
        }
      },

      "activeMembersPickCommunityPrompt": {
        "type": "Caption",
        "props": { "text": "Pick a community above to see its active members.", "tone": "muted" },
        "visible": {
          "$and": [
            { "$state": "/_errors/myconnect-community-admin.list_members" },
            { "$state": "/ui/selectedCommunity", "not": true }
          ]
        }
      },
      "activeMembersErrorBanner": {
        "type": "Caption",
        "props": { "text": { "$template": "Couldn't load active members: ${/_errors/myconnect-community-admin.list_members}" }, "tone": "destructive" },
        "visible": {
          "$and": [
            { "$state": "/_errors/myconnect-community-admin.list_members" },
            { "$state": "/ui/selectedCommunity" }
          ]
        }
      },
      "activeMembersLoading1": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "activeMembersLoading2": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "activeMembersLoading": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["activeMembersLoading1", "activeMembersLoading2"],
        "visible": { "$state": "/_loading/myconnect-community-admin.list_members" }
      },
      "activeMembersEmpty": {
        "type": "Empty",
        "props": { "message": "No active members found." },
        "visible": {
          "$and": [
            { "$state": "/_loading/myconnect-community-admin.list_members", "not": true },
            { "$state": "/ui/activeMembersRows/0", "not": true },
            { "$state": "/_errors/myconnect-community-admin.list_members", "not": true }
          ]
        }
      },
      "activeMembersTable": {
        "type": "Table",
        "props": {
          "loading": { "$state": "/_loading/myconnect-community-admin.list_members" },
          "skeletonRows": 4,
          "rows": { "$state": "/ui/activeMembersRows" },
          "columns": [
            { "id": "member", "header": "Member", "field": "member", "priority": 1 },
            { "id": "email", "header": "Email", "field": "email", "priority": 2 },
            { "id": "role", "header": "Role", "field": "role", "width": 90, "priority": 3 },
            { "id": "lastSeen", "header": "Last Seen Date", "field": "lastSeen", "width": 120, "priority": 2 }
          ]
        },
        "visible": { "$state": "/ui/activeMembersRows/0" }
      },
      "activeMembersMoreCaption": {
        "type": "Caption",
        "props": { "text": "Showing the first 100 active members, most recently seen first.", "tone": "muted" },
        "visible": { "$state": "/myconnect-community-admin/list_members/nextCursor" }
      },
      "activeMembersPanel": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["activeMembersPickCommunityPrompt", "activeMembersErrorBanner", "activeMembersLoading", "activeMembersEmpty", "activeMembersTable", "activeMembersMoreCaption"],
        "visible": { "$state": "/ui/activeTab", "eq": "activeMembers" },
        "watch": {
          "/myconnect-community-admin/list_members/items": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/activeMembersRows",
                "value": { "$computed": "myconnect-community-admin_active_members_rows", "args": { "items": { "$state": "/myconnect-community-admin/list_members/items" } } }
              }
            }
          ],
          "/ui/selectedCommunity": [
            {
              "action": "myconnect-community-admin.list_members",
              "params": { "community": { "$state": "/ui/selectedCommunity" }, "status": "active", "limit": 100 }
            }
          ]
        }
      },
      "postsCommentsPickCommunityPrompt": {
        "type": "Caption",
        "props": { "text": "Pick a community above to see its posts and comments.", "tone": "muted" },
        "visible": {
          "$and": [
            { "$state": "/_errors/myconnect-community-admin.get_posts_comments_summary" },
            { "$state": "/ui/selectedCommunity", "not": true }
          ]
        }
      },
      "postsCommentsErrorBanner": {
        "type": "Caption",
        "props": { "text": { "$template": "Couldn't load posts and comments: ${/_errors/myconnect-community-admin.get_posts_comments_summary}" }, "tone": "destructive" },
        "visible": {
          "$and": [
            { "$state": "/_errors/myconnect-community-admin.get_posts_comments_summary" },
            { "$state": "/ui/range/from" },
            { "$state": "/ui/selectedCommunity" }
          ]
        }
      },
      "postsCommentsLoading1": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "postsCommentsLoading2": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "postsCommentsLoading": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["postsCommentsLoading1", "postsCommentsLoading2"],
        "visible": { "$state": "/_loading/myconnect-community-admin.get_posts_comments_summary" }
      },
      "postsCommentsPrompt": {
        "type": "Empty",
        "props": { "message": "Pick a date range above to see posts and comments per channel." },
        "visible": {
          "$and": [
            { "$state": "/_loading/myconnect-community-admin.get_posts_comments_summary", "not": true },
            { "$state": "/myconnect-community-admin/get_posts_comments_summary/0", "not": true },
            { "$state": "/_errors/myconnect-community-admin.get_posts_comments_summary", "not": true },
            { "$state": "/ui/range/from", "not": true }
          ]
        }
      },
      "postsCommentsEmpty": {
        "type": "Empty",
        "props": { "message": "No posts in this date range." },
        "visible": {
          "$and": [
            { "$state": "/_loading/myconnect-community-admin.get_posts_comments_summary", "not": true },
            { "$state": "/myconnect-community-admin/get_posts_comments_summary/0", "not": true },
            { "$state": "/_errors/myconnect-community-admin.get_posts_comments_summary", "not": true },
            { "$state": "/ui/range/from" }
          ]
        }
      },
      "postsCommentsTable": {
        "type": "Table",
        "props": {
          "loading": { "$state": "/_loading/myconnect-community-admin.get_posts_comments_summary" },
          "skeletonRows": 4,
          "rows": { "$state": "/myconnect-community-admin/get_posts_comments_summary" },
          "columns": [
            { "id": "channel", "header": "Channel", "field": "channelName", "priority": 1 },
            { "id": "posts", "header": "# of Posts", "field": "posts", "width": 100, "priority": 1 },
            { "id": "comments", "header": "# of Comments", "field": "comments", "width": 120, "priority": 2 }
          ]
        },
        "visible": { "$state": "/myconnect-community-admin/get_posts_comments_summary/0" }
      },
      "postsCommentsPanel": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["postsCommentsPickCommunityPrompt", "postsCommentsErrorBanner", "postsCommentsLoading", "postsCommentsPrompt", "postsCommentsEmpty", "postsCommentsTable"],
        "visible": { "$state": "/ui/activeTab", "eq": "postsComments" },
        "watch": {
          "/ui/selectedCommunity": [
            {
              "action": "myconnect-community-admin.get_posts_comments_summary",
              "params": { "community": { "$state": "/ui/selectedCommunity" }, "fromDate": { "$cond": { "$state": "/ui/range/from" }, "$then": { "$state": "/ui/range/from" }, "$else": { "$computed": "myconnect-community-admin_today" } }, "toDate": { "$cond": { "$state": "/ui/range/to" }, "$then": { "$state": "/ui/range/to" }, "$else": { "$computed": "myconnect-community-admin_today" } } }
            }
          ],
          "/ui/range": [
            {
              "action": "myconnect-community-admin.get_posts_comments_summary",
              "params": { "community": { "$state": "/ui/selectedCommunity" }, "fromDate": { "$state": "/ui/range/from" }, "toDate": { "$state": "/ui/range/to" } }
            }
          ]
        }
      },
      "rsvpPickCommunityPrompt": {
        "type": "Caption",
        "props": { "text": "Pick a community above to see its RSVPs.", "tone": "muted" },
        "visible": {
          "$and": [
            { "$state": "/_errors/myconnect-community-admin.list_rsvps_in_range" },
            { "$state": "/ui/selectedCommunity", "not": true }
          ]
        }
      },
      "rsvpErrorBanner": {
        "type": "Caption",
        "props": { "text": { "$template": "Couldn't load RSVPs: ${/_errors/myconnect-community-admin.list_rsvps_in_range}" }, "tone": "destructive" },
        "visible": {
          "$and": [
            { "$state": "/_errors/myconnect-community-admin.list_rsvps_in_range" },
            { "$state": "/ui/range/from" },
            { "$state": "/ui/selectedCommunity" }
          ]
        }
      },
      "rsvpLoading1": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "rsvpLoading2": { "type": "Skeleton", "props": { "height": "2.5rem", "rounded": "md" } },
      "rsvpLoading": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["rsvpLoading1", "rsvpLoading2"],
        "visible": { "$state": "/_loading/myconnect-community-admin.list_rsvps_in_range" }
      },
      "rsvpPrompt": {
        "type": "Empty",
        "props": { "message": "Pick a date range above to see RSVPs." },
        "visible": {
          "$and": [
            { "$state": "/_loading/myconnect-community-admin.list_rsvps_in_range", "not": true },
            { "$state": "/ui/rsvpRows/0", "not": true },
            { "$state": "/_errors/myconnect-community-admin.list_rsvps_in_range", "not": true },
            { "$state": "/ui/range/from", "not": true }
          ]
        }
      },
      "rsvpEmpty": {
        "type": "Empty",
        "props": { "message": "No RSVPs in this date range." },
        "visible": {
          "$and": [
            { "$state": "/_loading/myconnect-community-admin.list_rsvps_in_range", "not": true },
            { "$state": "/ui/rsvpRows/0", "not": true },
            { "$state": "/_errors/myconnect-community-admin.list_rsvps_in_range", "not": true },
            { "$state": "/ui/range/from" }
          ]
        }
      },
      "rsvpTable": {
        "type": "Table",
        "props": {
          "loading": { "$state": "/_loading/myconnect-community-admin.list_rsvps_in_range" },
          "skeletonRows": 4,
          "rows": { "$state": "/ui/rsvpRows" },
          "columns": [
            { "id": "member", "header": "Member", "field": "member", "priority": 1 },
            { "id": "email", "header": "Email", "field": "email", "priority": 2 },
            { "id": "event", "header": "Event", "field": "event", "priority": 2 },
            { "id": "rsvp", "header": "RSVP", "field": "rsvp", "width": 100, "priority": 3 },
            { "id": "rsvpDate", "header": "RSVP Date", "field": "rsvpDate", "width": 100, "priority": 2 },
            { "id": "sessions", "header": "Sessions", "field": "sessions", "priority": 4 }
          ]
        },
        "visible": { "$state": "/ui/rsvpRows/0" }
      },
      "rsvpMoreCaption": {
        "type": "Caption",
        "props": { "text": "Showing the first 100 RSVPs — narrow the date range to see more.", "tone": "muted" },
        "visible": { "$state": "/myconnect-community-admin/list_rsvps_in_range/nextCursor" }
      },
      "rsvpPanel": {
        "type": "Stack",
        "props": { "gap": "sm" },
        "children": ["rsvpPickCommunityPrompt", "rsvpErrorBanner", "rsvpLoading", "rsvpPrompt", "rsvpEmpty", "rsvpTable", "rsvpMoreCaption"],
        "visible": { "$state": "/ui/activeTab", "eq": "rsvp" },
        "watch": {
          "/myconnect-community-admin/list_rsvps_in_range/items": [
            {
              "action": "setState",
              "params": {
                "statePath": "/ui/rsvpRows",
                "value": { "$computed": "myconnect-community-admin_rsvps_rows", "args": { "items": { "$state": "/myconnect-community-admin/list_rsvps_in_range/items" } } }
              }
            }
          ],
          "/ui/selectedCommunity": [
            {
              "action": "myconnect-community-admin.list_rsvps_in_range",
              "params": { "community": { "$state": "/ui/selectedCommunity" }, "fromDate": { "$cond": { "$state": "/ui/range/from" }, "$then": { "$state": "/ui/range/from" }, "$else": { "$computed": "myconnect-community-admin_today" } }, "toDate": { "$cond": { "$state": "/ui/range/to" }, "$then": { "$state": "/ui/range/to" }, "$else": { "$computed": "myconnect-community-admin_today" } }, "limit": 100 }
            }
          ],
          "/ui/range": [
            {
              "action": "myconnect-community-admin.list_rsvps_in_range",
              "params": { "community": { "$state": "/ui/selectedCommunity" }, "fromDate": { "$state": "/ui/range/from" }, "toDate": { "$state": "/ui/range/to" }, "limit": 100 }
            }
          ]
        }
      },

      "body": { "type": "Body", "props": {}, "children": ["signupsPanel", "activeMembersPanel", "postsCommentsPanel", "rsvpPanel"] },

      "infoOverlay": {
        "type": "Overlay",
        "props": { "maxWidth": "28rem" },
        "children": ["infoCard"],
        "visible": { "$state": "/ui/showInfo" },
        "on": { "backdropClick": { "action": "setState", "params": { "statePath": "/ui/showInfo", "value": false } } }
      },
      "infoCloseBtn": {
        "type": "IconButton",
        "props": { "icon": "X", "size": "sm", "tone": "muted", "ariaLabel": "Close", "floating": true },
        "on": { "click": { "action": "setState", "params": { "statePath": "/ui/showInfo", "value": false } } }
      },
      "infoTitleIcon": { "type": "Icon", "props": { "name": "Info", "size": "sm", "tone": "info" } },
      "infoTitleText": { "type": "Heading", "props": { "text": "About myConnect Analytics", "level": "h2" } },
      "infoTitleRow": { "type": "Row", "props": { "align": "center", "gap": "sm" }, "children": ["infoTitleIcon", "infoTitleText"] },
      "infoDivider": { "type": "Divider", "props": {} },
      "infoSignupsLabel": { "type": "Caption", "props": { "text": "Sign-ups", "tone": "muted", "weight": "semibold" } },
      "infoSignupsText": {
        "type": "Text",
        "props": {
          "text": "Everyone who joined the selected community in the chosen date range — member, email, role, status, tags, access groups and date joined. Download CSV exports the same rows.",
          "size": "sm"
        }
      },
      "infoActiveLabel": { "type": "Caption", "props": { "text": "Active Members", "tone": "muted", "weight": "semibold" } },
      "infoActiveText": {
        "type": "Text",
        "props": {
          "text": "Every current active-status member, most recently seen first — independent of the date range above.",
          "size": "sm"
        }
      },
      "infoPostsLabel": { "type": "Caption", "props": { "text": "Posts & Comments", "tone": "muted", "weight": "semibold" } },
      "infoPostsText": {
        "type": "Text",
        "props": {
          "text": "Each channel's post and comment counts for the selected date range, busiest channel first.",
          "size": "sm"
        }
      },
      "infoRsvpLabel": { "type": "Caption", "props": { "text": "RSVP", "tone": "muted", "weight": "semibold" } },
      "infoRsvpText": {
        "type": "Text",
        "props": {
          "text": "Every RSVP across every event in the selected date range — member, email, event, RSVP status, RSVP date and confirmed sessions.",
          "size": "sm"
        }
      },
      "infoBody": { "type": "Stack", "props": { "gap": "md" }, "children": ["infoSignupsLabel", "infoSignupsText", "infoActiveLabel", "infoActiveText", "infoPostsLabel", "infoPostsText", "infoRsvpLabel", "infoRsvpText"] },
      "infoCard": { "type": "Card", "props": {}, "children": ["infoCloseBtn", "infoTitleRow", "infoDivider", "infoBody"] }
    }
  }
}
