{
  "contentHash": "870903a6c0c927d5f43484b0b17f5a4ce63c00c10045027030ae770936fde096",
  "definition": {
    "capabilities": [
      "records.read",
      "records.write",
      "workq.create"
    ],
    "description": "Triage, decide, then follow up, escalate or close the feedback.",
    "exceptions": [],
    "inputs": [
      {
        "key": "recordId",
        "label": "Feedback record",
        "required": false,
        "type": "string"
      },
      {
        "key": "summary",
        "label": "Summary",
        "required": true,
        "type": "string"
      },
      {
        "key": "customer",
        "label": "Customer",
        "required": true,
        "type": "string"
      },
      {
        "key": "message",
        "label": "What they said",
        "required": true,
        "type": "string"
      }
    ],
    "key": "triage-customer-feedback",
    "kind": "process",
    "originKey": "3639b213-cf8d-43fd-b1e8-07466414f820",
    "outcomes": [
      {
        "evidence": [
          "The triage",
          "The completed follow-up"
        ],
        "key": "followedUp",
        "terminal": true
      },
      {
        "evidence": [
          "The triage",
          "The team item"
        ],
        "key": "escalated",
        "terminal": true
      },
      {
        "evidence": [
          "The triage",
          "The manager's decision"
        ],
        "key": "closed",
        "terminal": true
      }
    ],
    "protectedRules": [
      {
        "description": "Nothing is changed, raised or closed without the manager's decision.",
        "key": "managerDecides"
      },
      {
        "description": "The customer's words reach the manager exactly as written.",
        "key": "verbatim"
      },
      {
        "description": "Everything happens inside Workspace; nothing is sent outside it.",
        "key": "workspaceOnly"
      }
    ],
    "rework": [],
    "roles": {
      "manager": "installation.manager",
      "reviewer": "installation.reviewer"
    },
    "schemaVersion": 1,
    "steps": [
      {
        "key": "triage",
        "kind": "agent",
        "outputs": [
          "category",
          "severity",
          "needsFollowUp",
          "reason",
          "followupRecordPayload",
          "closePayload",
          "escalatePayload"
        ],
        "skill": "triage-feedback",
        "title": "Categorise the feedback and set a severity"
      },
      {
        "eligible": [
          "manager"
        ],
        "key": "followupDecision",
        "kind": "decision",
        "materiality": [
          "steps.triage.reason",
          "steps.triage.severity",
          "steps.triage.category"
        ],
        "options": [
          {
            "effect": "The feedback is marked Follow-up raised and a follow-up task is created for you.",
            "intent": {
              "capability": "records.write",
              "payloadFrom": "steps.triage.followupRecordPayload"
            },
            "key": "followup",
            "label": "Follow up myself",
            "suggested": true,
            "transition": "followUpTask"
          },
          {
            "effect": "A WorkQ item is created for the whole team.",
            "intent": {
              "capability": "workq.create",
              "payloadFrom": "steps.triage.escalatePayload"
            },
            "key": "escalate",
            "label": "Escalate to the team",
            "transition": "escalated"
          },
          {
            "effect": "The feedback is marked Closed with its category and severity.",
            "intent": {
              "capability": "records.write",
              "payloadFrom": "steps.triage.closePayload"
            },
            "key": "close",
            "label": "Close as noted",
            "transition": "closed"
          }
        ],
        "sla": {
          "remindAfterBusinessDays": 1
        },
        "title": "What should happen with this feedback?",
        "type": "feedback_followup"
      },
      {
        "assign": "manager",
        "completion": "statusDone",
        "key": "followUpTask",
        "kind": "human",
        "template": "74353248-f232-4fa4-9e3b-8be15ee1a958",
        "title": "Follow up with the customer"
      },
      {
        "evidence": [
          "steps.followUpTask.completed"
        ],
        "key": "followedUp",
        "kind": "gate",
        "outcome": "followedUp",
        "requires": [
          "steps.followUpTask.completed"
        ],
        "title": "Follow-up done"
      },
      {
        "evidence": [
          "steps.triage.escalatePayload"
        ],
        "key": "escalated",
        "kind": "gate",
        "outcome": "escalated",
        "requires": [
          "steps.followupDecision.decision == 'escalate'"
        ],
        "title": "Escalated to the team"
      },
      {
        "evidence": [
          "steps.triage.closePayload"
        ],
        "key": "closed",
        "kind": "gate",
        "outcome": "closed",
        "requires": [
          "steps.followupDecision.decision == 'close'"
        ],
        "title": "Closed as noted"
      }
    ],
    "subject": {
      "dedupeBy": [],
      "kind": "records.customer_feedback"
    },
    "title": "Triage customer feedback",
    "transitions": [
      {
        "from": "triage",
        "to": "followupDecision"
      },
      {
        "from": "followUpTask",
        "to": "followedUp"
      }
    ],
    "triggers": [
      {
        "event": "record.created",
        "filter": {
          "type_slug": "customer_feedback"
        },
        "inputsFrom": {
          "customer": "payload.customer",
          "message": "payload.message",
          "recordId": "subject.record_id",
          "summary": "payload.name"
        },
        "kind": "event",
        "subjectFrom": "subject.record_id"
      }
    ],
    "variationPoints": [],
    "version": "0.3.1",
    "vocabulary": {
      "subject": "feedback"
    }
  },
  "kind": "process",
  "name": "Triage customer feedback",
  "originKey": "3639b213-cf8d-43fd-b1e8-07466414f820"
}
