        "evidence": [
          "The triage",
          "The manager's decision"
        ],
        "key": "closed",
        "terminal": true
      }
    ],
    "protectedRules": [
      {
        "description": "No follow-up is raised and nothing is closed without the manager's decision.",
        "key": "managerDecides"
      },
      {
        "description": "The customer's words reach the manager exactly as written.",
        "key": "verbatim"
      },
      {
        "description": "Everything happens inside Workspace; nothing is sent outside it.",
        "key": "workspaceOnly"
      }
    ],
    "rework": [],
    "roles": {
      "manager": "installation.manager",
      "reviewer": "installation.reviewer"
    },
    "schemaVersion": 1,
    "steps": [
      {
        "key": "triage",
        "kind": "agent",
        "outputs": [
          "category",
          "severity",
          "needsFollowUp",
          "reason"
        ],
        "skill": "triage-feedback",
        "title": "Categorise the feedback and set a severity"
      },
      {
        "eligible": [
          "manager"
        ],
        "key": "followupDecision",
        "kind": "decision",
        "materiality": [
          "steps.triage.reason",
          "steps.triage.severity"
        ],
        "options": [
          {
            "effect": "A WorkQ follow-up item is created for the manager.",
            "key": "followup",
            "label": "Raise a follow-up",
            "suggested": true,
            "transition": "followUpTask"
          },
          {
            "effect": "Nothing more happens; the feedback stays on record.",
            "key": "close",
            "label": "Close as noted",
            "transition": "closed"
          }
        ],
        "sla": {
          "remindAfterBusinessDays": 1
        },
        "title": "Does this feedback need a follow-up?",
        "type": "feedback_followup"
      },
      {
        "assign": "manager",
        "completion": "statusDone",
        "key": "followUpTask",
        "kind": "human",
        "template": "74353248-f232-4fa4-9e3b-8be15ee1a958",
        "title": "Follow up with the customer"
      },
      {
        "evidence": [
          "steps.followUpTask.completed"
        ],
        "key": "followedUp",
        "kind": "gate",
        "outcome": "followedUp",
        "requires": [
          "steps.followUpTask.completed"
        ],
        "title": "Follow-up done"
      },
      {
        "evidence": [
          "steps.triage.reason"
        ],
        "key": "closed",
        "kind": "gate",
        "outcome": "closed",
        "requires": [
          "steps.followupDecision.decision == 'close'"
        ],
        "title": "Closed as noted"
      }
    ],
    "subject": {
