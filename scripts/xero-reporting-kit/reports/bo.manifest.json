          "value": false
        },
        "xero_tenant_id": {
          "kind": "input",
          "input": "org"
        }
      }
    },
    {
      "id": "accounts",
      "tool": {
        "mcp": "xero-accounting",
        "name": "list_accounts"
      },
      "params": {
        "xero_tenant_id": {
          "kind": "input",
          "input": "org"
        }
      }
    },
    {
      "id": "tb",
      "tool": {
        "mcp": "xero-accounting",
        "name": "get_trial_balance"
