{
  "inputs": [
    { "name": "from_date", "label": "From", "type": "date", "default": "2026-07-01" },
    { "name": "to_date", "label": "To", "type": "date", "default": "2026-09-25" },
    { "name": "org", "label": "Organisation", "type": "string", "maxLength": 64, "default": "" },
    { "name": "project", "label": "Project (set by the report, one per call: leave empty)", "type": "string", "maxLength": 64, "default": "" },
    { "name": "after", "label": "Entries from (set by the report from the dates)", "type": "string", "maxLength": 30, "default": "2026-06-30T00:00:00Z" },
    { "name": "before", "label": "Entries to (set by the report from the dates)", "type": "string", "maxLength": 30, "default": "2026-09-27T00:00:00Z" },
    { "name": "display", "label": "Display settings", "type": "string", "maxLength": 300, "default": "{\"cents\":0,\"k\":0,\"zeros\":1,\"neg\":\"paren\",\"red\":0,\"hdr\":1,\"ftr\":1,\"style\":\"mysmb\",\"dens\":\"100\",\"p\":\"this_fy_td\",\"a\":\"custom\",\"c\":\"none\",\"v\":\"\"}" }
  ],
  "bindings": [
    {
      "id": "projects_open",
      "tool": { "mcp": "xero-projects", "name": "list_projects" },
      "params": {
        "states": { "kind": "static", "value": "INPROGRESS" },
        "pageSize": { "kind": "static", "value": 500 },
        "xero_tenant_id": { "kind": "input", "input": "org" }
      }
    },
    {
      "id": "projects_closed",
      "tool": { "mcp": "xero-projects", "name": "list_projects" },
      "params": {
        "states": { "kind": "static", "value": "CLOSED" },
        "pageSize": { "kind": "static", "value": 500 },
        "xero_tenant_id": { "kind": "input", "input": "org" }
      }
    },
    {
      "id": "users",
      "tool": { "mcp": "xero-projects", "name": "list_project_users" },
      "params": {
        "pageSize": { "kind": "static", "value": 500 },
        "xero_tenant_id": { "kind": "input", "input": "org" }
      }
    },
    {
      "id": "entries",
      "tool": { "mcp": "xero-projects", "name": "list_time_entries" },
      "params": {
        "projectId": { "kind": "input", "input": "project" },
        "dateAfterUtc": { "kind": "input", "input": "after" },
        "dateBeforeUtc": { "kind": "input", "input": "before" },
        "pageSize": { "kind": "static", "value": 500 },
        "xero_tenant_id": { "kind": "input", "input": "org" }
      }
    },
    {
      "id": "org",
      "tool": { "mcp": "xero-accounting", "name": "get_organisation" },
      "params": {
        "xero_tenant_id": { "kind": "input", "input": "org" }
      }
    },
    {
      "id": "connections",
      "tool": { "mcp": "xero-accounting", "name": "list_connections" },
      "params": {}
    }
  ]
}
