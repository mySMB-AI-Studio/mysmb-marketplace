// Pre-built default `dist/index.js`. Regenerated when you run
//   npm --prefix plugin/widget-elements run build
// after editing src/index.ts. Commit the rebuilt file so the marketplace
// runtime can load it without a build step.

const title_case = (args) => {
  const s = String(args.value ?? '');
  return s.replace(/\w\S*/g, (w) => w.charAt(0).toUpperCase() + w.slice(1).toLowerCase());
};

const elements = {
  slug: '__SLUG__',
  functions: { title_case },
};

export default elements;
