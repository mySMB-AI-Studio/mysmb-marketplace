{
  "inputs": [
    {
      "name": "from_date",
      "label": "From",
      "type": "date",
      "default": "2026-07-01"
    },
    {
      "name": "to_date",
      "label": "To",
      "type": "date",
      "default": "today"
    },
    {
      "name": "basis",
      "label": "Basis",
      "type": "enum",
      "options": [
        "Accrual",
        "Cash"
      ],
      "default": "Accrual"
    },
    {
      "name": "clients",
      "label": "Clients",
      "type": "string",
      "maxLength": 500,
      "default": ""
    },
    {
      "name": "org",
      "label": "Xero organisation (set by the report, one per call: leave empty)",
      "type": "string",
      "maxLength": 64,
      "default": ""
    }
  ],
  "bindings": [
    {
      "id": "xero_connections",
      "tool": {
        "mcp": "xero-api",
        "name": "list_connections"
      },
      "params": {}
    },
    {
      "id": "x_pl",
      "tool": {
        "mcp": "xero-api",
        "name": "get_profit_and_loss"
      },
      "params": {
        "xero_tenant_id": {
          "kind": "input",
          "input": "org"
        },
        "fromDate": {
          "kind": "input",
          "input": "from_date"
        },
        "toDate": {
          "kind": "input",
          "input": "to_date"
        }
      }
    },
    {
      "id": "x_pl_cash",
      "tool": {
        "mcp": "xero-api",
        "name": "get_profit_and_loss"
      },
      "params": {
        "xero_tenant_id": {
          "kind": "input",
          "input": "org"
        },
        "fromDate": {
          "kind": "input",
          "input": "from_date"
        },
        "toDate": {
          "kind": "input",
          "input": "to_date"
        },
        "paymentsOnly": {
          "kind": "static",
          "value": true
        }
      }
    },
    {
      "id": "x_bank",
      "tool": {
        "mcp": "xero-api",
        "name": "get_bank_summary"
      },
      "params": {
        "xero_tenant_id": {
          "kind": "input",
          "input": "org"
        },
        "fromDate": {
          "kind": "context",
          "source": "now.date"
        },
        "toDate": {
          "kind": "context",
          "source": "now.date"
        }
      }
    },
    {
      "id": "x_ar",
      "tool": {
        "mcp": "xero-api",
        "name": "list_invoices"
      },
      "params": {
        "xero_tenant_id": {
          "kind": "input",
          "input": "org"
        },
        "where": {
          "kind": "static",
          "value": "Type==\"ACCREC\" AND Status==\"AUTHORISED\""
        }
      }
    },
    {
      "id": "x_ap",
      "tool": {
        "mcp": "xero-api",
        "name": "list_invoices"
      },
      "params": {
        "xero_tenant_id": {
          "kind": "input",
          "input": "org"
        },
        "where": {
          "kind": "static",
          "value": "Type==\"ACCPAY\" AND Status==\"AUTHORISED\""
        }
      }
    },
    {
      "id": "myob",
      "tool": {
        "mcp": "myob-accounting",
        "name": "get_practice_financial_overview"
      },
      "params": {
        "from_date": {
          "kind": "input",
          "input": "from_date"
        },
        "to_date": {
          "kind": "input",
          "input": "to_date"
        },
        "basis": {
          "kind": "input",
          "input": "basis"
        },
        "clients": {
          "kind": "input",
          "input": "clients"
        }
      }
    }
  ]
}
