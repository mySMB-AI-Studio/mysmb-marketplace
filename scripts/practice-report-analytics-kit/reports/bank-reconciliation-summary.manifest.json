{
  "inputs": [
    {
      "name": "as_at",
      "label": "As at",
      "type": "date",
      "default": "today"
    },
    {
      "name": "clients",
      "label": "Clients",
      "type": "string",
      "maxLength": 500,
      "default": ""
    },
    {
      "name": "org",
      "label": "Xero organisation (set by the report, one per call: leave empty)",
      "type": "string",
      "maxLength": 64,
      "default": ""
    },
    {
      "name": "where",
      "label": "Xero filter (set by the report: leave empty)",
      "type": "string",
      "maxLength": 500,
      "default": ""
    },
    {
      "name": "page",
      "label": "Page (set by the report: leave at 1)",
      "type": "number",
      "min": 1,
      "max": 100,
      "default": 1
    }
  ],
  "bindings": [
    {
      "id": "xero_connections",
      "tool": {
        "mcp": "xero-api",
        "name": "list_connections"
      },
      "params": {}
    },
    {
      "id": "x_bank",
      "tool": {
        "mcp": "xero-api",
        "name": "get_bank_summary"
      },
      "params": {
        "xero_tenant_id": {
          "kind": "input",
          "input": "org"
        },
        "fromDate": {
          "kind": "input",
          "input": "as_at"
        },
        "toDate": {
          "kind": "input",
          "input": "as_at"
        }
      }
    },
    {
      "id": "x_unrec",
      "tool": {
        "mcp": "xero-api",
        "name": "list_bank_transactions"
      },
      "params": {
        "xero_tenant_id": {
          "kind": "input",
          "input": "org"
        },
        "where": {
          "kind": "input",
          "input": "where"
        },
        "page": {
          "kind": "input",
          "input": "page"
        }
      }
    },
    {
      "id": "myob",
      "tool": {
        "mcp": "myob-accounting",
        "name": "get_practice_bank_reconciliation_summary"
      },
      "params": {
        "as_at": {
          "kind": "input",
          "input": "as_at"
        },
        "clients": {
          "kind": "input",
          "input": "clients"
        }
      }
    }
  ]
}
